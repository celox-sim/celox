{
  "version": 4,
  "kind": "specification",
  "name": "Scoped counter arithmetic with a spending budget",
  "specs": {
    "Counter": {
      "inputs": {
        "amount": {
          "bv": 4
        }
      },
      "outputs": {
        "count": {
          "bv": 4
        }
      },
      "state": {
        "value": {
          "bv": 4
        }
      },
      "init": [
        "eq",
        "s.value",
        [
          "bv",
          4,
          0
        ]
      ],
      "invariant": [
        "eq",
        "count",
        "s.value"
      ],
      "operations": {
        "add": [
          "eq",
          "n.value",
          [
            "add",
            "s.value",
            "amount"
          ]
        ]
      },
      "examples": {
        "add_two": {
          "expect": "positive",
          "initial": {
            "count": [
              "bv",
              4,
              0
            ]
          },
          "trace": [
            {
              "inputs": {
                "amount": [
                  "bv",
                  4,
                  2
                ]
              },
              "observe": {
                "count": [
                  "bv",
                  4,
                  2
                ]
              },
              "operation": "add"
            }
          ]
        },
        "wrong_arithmetic": {
          "expect": "negative",
          "initial": {
            "count": [
              "bv",
              4,
              0
            ]
          },
          "trace": [
            {
              "inputs": {
                "amount": [
                  "bv",
                  4,
                  2
                ]
              },
              "observe": {
                "count": [
                  "bv",
                  4,
                  3
                ]
              },
              "operation": "add"
            }
          ]
        }
      }
    },
    "Budget": {
      "inputs": {
        "amount": {
          "bv": 4
        }
      },
      "outputs": {
        "remaining": {
          "bv": 4
        }
      },
      "state": {
        "credits": {
          "bv": 4
        }
      },
      "init": [
        "eq",
        "s.credits",
        [
          "bv",
          4,
          3
        ]
      ],
      "invariant": [
        "eq",
        "remaining",
        "s.credits"
      ],
      "operations": {
        "add": [
          "and",
          [
            "ule",
            "amount",
            "s.credits"
          ],
          [
            "eq",
            "n.credits",
            [
              "sub",
              "s.credits",
              "amount"
            ]
          ]
        ]
      },
      "examples": {
        "cannot_overspend": {
          "expect": "negative",
          "initial": {},
          "trace": [
            {
              "inputs": {
                "amount": [
                  "bv",
                  4,
                  4
                ]
              },
              "observe": {},
              "operation": "add"
            }
          ]
        },
        "spend_two": {
          "expect": "positive",
          "initial": {
            "remaining": [
              "bv",
              4,
              3
            ]
          },
          "trace": [
            {
              "inputs": {
                "amount": [
                  "bv",
                  4,
                  2
                ]
              },
              "observe": {
                "remaining": [
                  "bv",
                  4,
                  1
                ]
              },
              "operation": "add"
            }
          ]
        }
      }
    }
  },
  "compositions": {
    "Budgeted": {
      "inputs": {
        "amount": {
          "bv": 4
        }
      },
      "outputs": {
        "count": {
          "bv": 4
        },
        "remaining": {
          "bv": 4
        }
      },
      "instances": {
        "Counter": {
          "target": "Counter",
          "connections": {
            "amount": "amount",
            "count": "count"
          }
        },
        "Budget": {
          "target": "Budget",
          "connections": {
            "amount": "amount",
            "remaining": "remaining"
          }
        }
      },
      "examples": {
        "exclude_overspend": {
          "expect": "negative",
          "initial": {},
          "trace": [
            {
              "inputs": {
                "amount": [
                  "bv",
                  4,
                  4
                ]
              },
              "observe": {
                "count": [
                  "bv",
                  4,
                  4
                ]
              },
              "operation": "add"
            }
          ]
        },
        "spend_all": {
          "expect": "positive",
          "initial": {
            "count": [
              "bv",
              4,
              0
            ],
            "remaining": [
              "bv",
              4,
              3
            ]
          },
          "trace": [
            {
              "inputs": {
                "amount": [
                  "bv",
                  4,
                  2
                ]
              },
              "observe": {
                "count": [
                  "bv",
                  4,
                  2
                ],
                "remaining": [
                  "bv",
                  4,
                  1
                ]
              },
              "operation": "add"
            },
            {
              "inputs": {
                "amount": [
                  "bv",
                  4,
                  1
                ]
              },
              "observe": {
                "count": [
                  "bv",
                  4,
                  3
                ],
                "remaining": [
                  "bv",
                  4,
                  0
                ]
              },
              "operation": "add"
            }
          ]
        }
      }
    }
  },
  "implementation": {
    "binding": {
      "states": {
        "Budget": {
          "credits": "s.remaining"
        },
        "Counter": {
          "value": "s.count"
        }
      },
      "outputs": {
        "count": "s.count",
        "remaining": "s.remaining"
      }
    },
    "composition": "Budgeted",
    "next": {
      "count": [
        "ite",
        "w.accept",
        [
          "add",
          "s.count",
          "i.amount"
        ],
        "s.count"
      ],
      "remaining": [
        "ite",
        "w.accept",
        [
          "sub",
          "s.remaining",
          "i.amount"
        ],
        "s.remaining"
      ]
    },
    "operations": {
      "add": "w.accept"
    },
    "reset": {
      "count": [
        "bv",
        4,
        0
      ],
      "remaining": [
        "bv",
        4,
        3
      ]
    },
    "reset_input": "rst",
    "state": {
      "count": {
        "bv": 4
      },
      "remaining": {
        "bv": 4
      }
    },
    "wires": {
      "accept": [
        "and",
        "i.go",
        [
          "ule",
          "i.amount",
          "s.remaining"
        ]
      ]
    },
    "inputs": {
      "amount": {
        "bv": 4
      },
      "go": "bool",
      "rst": "bool"
    }
  }
}
