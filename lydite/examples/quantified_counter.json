              }
            },
            {
              "kind": "exists",
              "variables": {
                "b": {
                  "bv": 2
                }
              }
            }
          ],
          "trace": [
            {
              "ensure": [
                "eq",
                "count",
                [
                  "bv",
                  2,
                  0
                ]
              ],
              "inputs": {
                "amount": "q.a",
                "correction": "q.b"
              },
              "observe": {},
              "operation": "add"
            }
          ]
        }
      },
      "init": [
        "eq",
        "s.value",
        [
          "bv",
          2,
          0
        ]
      ],
      "inputs": {
        "amount": {
          "bv": 2
