{
  "version": 4,
  "kind": "specification",
  "name": "Two independently selected counter operations",
  "specs": {
    "Counter": {
      "inputs": {
        "amount": {
          "bv": 4
        }
      },
      "outputs": {
        "count": {
          "bv": 4
        }
      },
      "state": {
        "value": {
          "bv": 4
        }
      },
      "init": [
        "eq",
        "s.value",
        [
          "bv",
          4,
          0
        ]
      ],
      "invariant": [
        "eq",
        "count",
        "s.value"
      ],
      "operations": {
        "add": [
          "eq",
          "n.value",
          [
            "add",
            "s.value",
            "amount"
          ]
        ]
      },
      "examples": {
        "add_two": {
          "expect": "positive",
          "initial": {
            "count": [
              "bv",
              4,
              0
            ]
          },
          "trace": [
            {
              "inputs": {
                "amount": [
                  "bv",
                  4,
                  2
                ]
              },
              "observe": {
                "count": [
                  "bv",
                  4,
                  2
                ]
              },
              "operation": "add"
            }
          ]
        },
        "wrong_arithmetic": {
          "expect": "negative",
          "initial": {
            "count": [
              "bv",
              4,
              0
            ]
          },
          "trace": [
            {
              "inputs": {
                "amount": [
                  "bv",
                  4,
                  2
                ]
              },
              "observe": {
                "count": [
                  "bv",
                  4,
                  3
                ]
              },
              "operation": "add"
            }
          ]
        }
      }
    }
  },
  "compositions": {
    "Pair": {
      "inputs": {
        "left_amount": {
          "bv": 4
        },
        "right_amount": {
          "bv": 4
        }
      },
      "outputs": {
        "left_count": {
          "bv": 4
        },
        "right_count": {
          "bv": 4
        }
      },
      "instances": {
        "left": {
          "target": "Counter",
          "connections": {
            "amount": "left_amount",
            "count": "left_count"
          }
        },
        "right": {
          "target": "Counter",
          "connections": {
            "amount": "right_amount",
            "count": "right_count"
          }
        }
      },
      "examples": {
        "left_right_both_neither": {
          "expect": "positive",
          "initial": {
            "left_count": [
              "bv",
              4,
              0
            ],
            "right_count": [
              "bv",
              4,
              0
            ]
          },
          "trace": [
            {
              "inputs": {
                "left_amount": [
                  "bv",
                  4,
                  2
                ],
                "right_amount": [
                  "bv",
                  4,
                  7
                ]
              },
              "observe": {
                "left_count": [
                  "bv",
                  4,
                  2
                ],
                "right_count": [
                  "bv",
                  4,
                  0
                ]
              },
              "operation": "left"
            },
            {
              "actions": [
                "right"
              ],
              "inputs": {
                "left_amount": [
                  "bv",
                  4,
                  9
                ],
                "right_amount": [
                  "bv",
                  4,
                  3
                ]
              },
              "observe": {
                "left_count": [
                  "bv",
                  4,
                  2
                ],
                "right_count": [
                  "bv",
                  4,
                  3
                ]
              }
            },
            {
              "actions": [
                "left",
                "right"
              ],
              "inputs": {
                "left_amount": [
                  "bv",
                  4,
                  4
                ],
                "right_amount": [
                  "bv",
                  4,
                  5
                ]
              },
              "observe": {
                "left_count": [
                  "bv",
                  4,
                  6
                ],
                "right_count": [
                  "bv",
                  4,
                  8
                ]
              }
            },
            {
              "actions": [],
              "inputs": {
                "left_amount": [
                  "bv",
                  4,
                  1
                ],
                "right_amount": [
                  "bv",
                  4,
                  1
                ]
              },
              "observe": {
                "left_count": [
                  "bv",
                  4,
                  6
                ],
                "right_count": [
                  "bv",
                  4,
                  8
                ]
              }
            }
          ]
        },
        "modular_simultaneous_add": {
          "expect": "positive",
          "initial": {
            "left_count": [
              "bv",
              4,
              0
            ],
            "right_count": [
              "bv",
              4,
              0
            ]
          },
          "trace": [
            {
              "actions": [
                "left",
                "right"
              ],
              "inputs": {
                "left_amount": [
                  "bv",
                  4,
                  15
                ],
                "right_amount": [
                  "bv",
                  4,
                  14
                ]
              },
              "observe": {
                "left_count": [
                  "bv",
                  4,
                  15
                ],
                "right_count": [
                  "bv",
                  4,
                  14
                ]
              }
            },
            {
              "actions": [
                "left",
                "right"
              ],
              "inputs": {
                "left_amount": [
                  "bv",
                  4,
                  2
                ],
                "right_amount": [
                  "bv",
                  4,
                  3
                ]
              },
              "observe": {
                "left_count": [
                  "bv",
                  4,
                  1
                ],
                "right_count": [
                  "bv",
                  4,
                  1
                ]
              }
            }
          ]
        },
        "inactive_right_cannot_change": {
          "expect": "negative",
          "initial": {
            "left_count": [
              "bv",
              4,
              0
            ],
            "right_count": [
              "bv",
              4,
              0
            ]
          },
          "trace": [
            {
              "actions": [
                "left"
              ],
              "inputs": {
                "left_amount": [
                  "bv",
                  4,
                  2
                ],
                "right_amount": [
                  "bv",
                  4,
                  7
                ]
              },
              "observe": {
                "left_count": [
                  "bv",
                  4,
                  2
                ],
                "right_count": [
                  "bv",
                  4,
                  7
                ]
              }
            }
          ]
        },
        "idle_state_cannot_change": {
          "expect": "negative",
          "initial": {
            "left_count": [
              "bv",
              4,
              0
            ],
            "right_count": [
              "bv",
              4,
              0
            ]
          },
          "trace": [
            {
              "actions": [],
              "inputs": {
                "left_amount": [
                  "bv",
                  4,
                  2
                ],
                "right_amount": [
                  "bv",
                  4,
                  7
                ]
              },
              "observe": {
                "left_count": [
                  "bv",
                  4,
                  2
                ],
                "right_count": [
                  "bv",
                  4,
                  0
                ]
              }
            }
          ]
        },
        "both_must_obey_arithmetic": {
          "expect": "negative",
          "initial": {
            "left_count": [
              "bv",
              4,
              0
            ],
            "right_count": [
              "bv",
              4,
              0
            ]
          },
          "trace": [
            {
              "actions": [
                "left",
                "right"
              ],
              "inputs": {
                "left_amount": [
                  "bv",
                  4,
                  2
                ],
                "right_amount": [
                  "bv",
                  4,
                  7
                ]
              },
              "observe": {
                "left_count": [
                  "bv",
                  4,
                  2
                ],
                "right_count": [
                  "bv",
                  4,
                  6
                ]
              }
            }
          ]
        }
      },
      "operations": {
        "left": [
          "left.add"
        ],
        "right": [
          "right.add"
        ]
      }
    }
  },
  "implementation": {
    "composition": "Pair",
    "inputs": {
      "rst": "bool",
      "go_left": "bool",
      "go_right": "bool",
      "left_amount": {
        "bv": 4
      },
      "right_amount": {
        "bv": 4
      }
    },
    "reset_input": "rst",
    "state": {
      "left": {
        "bv": 4
      },
      "right": {
        "bv": 4
      }
    },
    "reset": {
      "left": [
        "bv",
        4,
        0
      ],
      "right": [
        "bv",
        4,
        0
      ]
    },
    "next": {
      "left": [
        "ite",
        "i.go_left",
        [
          "add",
          "s.left",
          "i.left_amount"
        ],
        "s.left"
      ],
      "right": [
        "ite",
        "i.go_right",
        [
          "add",
          "s.right",
          "i.right_amount"
        ],
        "s.right"
      ]
    },
    "operations": {
      "left": "i.go_left",
      "right": "i.go_right"
    },
    "binding": {
      "states": {
        "left": {
          "value": "s.left"
        },
        "right": {
          "value": "s.right"
        }
      },
      "outputs": {
        "left_count": "s.left",
        "right_count": "s.right"
      }
    }
  }
}
