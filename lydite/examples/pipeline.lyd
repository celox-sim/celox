design "pipeline"

input rst: bool;
input stall: bool;
input rom0: bv<8>;
input rom1: bv<8>;
input rom2: bv<8>;
input rom3: bv<8>;
input data0: bv<4>;
input data1: bv<4>;
input data2: bv<4>;
input data3: bv<4>;
reset_input rst;

spec {
  state pc: bv<2>;
  state r0: bv<4>;
  state r1: bv<4>;
  state rom0: bv<8>;
  state rom1: bv<8>;
  state rom2: bv<8>;
  state rom3: bv<8>;
  state data0: bv<4>;
  state data1: bv<4>;
  state data2: bv<4>;
  state data3: bv<4>;
  reset {
    pc = bv(2, 0);
    r0 = bv(4, 0);
    r1 = bv(4, 0);
    rom0 = i.rom0;
    rom1 = i.rom1;
    rom2 = i.rom2;
    rom3 = i.rom3;
    data0 = i.data0;
    data1 = i.data1;
    data2 = i.data2;
    data3 = i.data3;
  }
  wires {
    ir = ite(
      (s.pc == bv(2, 0)),
      s.rom0,
      ite((s.pc == bv(2, 1)), s.rom1, ite((s.pc == bv(2, 2)), s.rom2, s.rom3))
    );
    result = ite(
      (extract(7, 6, w.ir) == bv(2, 0)),
      extract(3, 0, w.ir),
      ite(
        (extract(7, 6, w.ir) == bv(2, 1)),
        (ite((extract(4, 4, w.ir) == bv(1, 0)), s.r0, s.r1) + extract(3, 0, w.ir)),
        ite(
          (extract(7, 6, w.ir) == bv(2, 2)),
          (ite((extract(4, 4, w.ir) == bv(1, 0)), s.r0, s.r1) ^ extract(3, 0, w.ir)),
          ite(
            (extract(1, 0, w.ir) == bv(2, 0)),
            s.data0,
            ite(
              (extract(1, 0, w.ir) == bv(2, 1)),
              s.data1,
              ite((extract(1, 0, w.ir) == bv(2, 2)), s.data2, s.data3)
            )
          )
        )
      )
    );
  }
  next {
    pc = (s.pc + bv(2, 1));
    r0 = ite((extract(5, 5, w.ir) == bv(1, 0)), w.result, s.r0);
    r1 = ite((extract(5, 5, w.ir) == bv(1, 1)), w.result, s.r1);
    rom0 = s.rom0;
    rom1 = s.rom1;
    rom2 = s.rom2;
    rom3 = s.rom3;
    data0 = s.data0;
    data1 = s.data1;
    data2 = s.data2;
    data3 = s.data3;
  }
  outputs {
    can_step = true;
  }
}

impl {
  state pc: bv<2>;
  state r0: bv<4>;
  state r1: bv<4>;
  state rom0: bv<8>;
  state rom1: bv<8>;
  state rom2: bv<8>;
  state rom3: bv<8>;
  state data0: bv<4>;
  state data1: bv<4>;
  state data2: bv<4>;
  state data3: bv<4>;
  state fetch_pc: bv<2>;
  state d_valid: bool;
  state d_pc: bv<2>;
  state d_ir: bv<8>;
  state x_valid: bool;
  state x_pc: bv<2>;
  state x_ir: bv<8>;
  state w_valid: bool;
  state w_pc: bv<2>;
  state w_ir: bv<8>;
  state x_operand: bv<4>;
  state w_result: bv<4>;
  reset {
    pc = bv(2, 0);
    r0 = bv(4, 0);
    r1 = bv(4, 0);
    rom0 = i.rom0;
    rom1 = i.rom1;
    rom2 = i.rom2;
    rom3 = i.rom3;
    data0 = i.data0;
    data1 = i.data1;
    data2 = i.data2;
    data3 = i.data3;
    fetch_pc = bv(2, 0);
    d_valid = false;
    d_pc = bv(2, 0);
    d_ir = bv(8, 0);
    x_valid = false;
    x_pc = bv(2, 0);
    x_ir = bv(8, 0);
    w_valid = false;
    w_pc = bv(2, 0);
    w_ir = bv(8, 0);
    x_operand = bv(4, 0);
    w_result = bv(4, 0);
  }
  wires {
    commit = ((true && (!i.stall)) && s.w_valid);
    d_uses = ((extract(7, 6, s.d_ir) == bv(2, 1)) || (extract(7, 6, s.d_ir) == bv(2, 2)));
    d_rs = extract(4, 4, s.d_ir);
    x_rd = extract(5, 5, s.x_ir);
    w_rd = extract(5, 5, s.w_ir);
    x_load = (extract(7, 6, s.x_ir) == bv(2, 3));
    x_match = ((true && s.x_valid) && (w.x_rd == w.d_rs));
    w_match = ((true && s.w_valid) && (w.w_rd == w.d_rs));
    hazard = ((((true && s.d_valid) && w.d_uses) && w.x_match) && w.x_load);
    x_forward = ((true && w.x_match) && (!w.x_load));
    reg_operand = ite((w.d_rs == bv(1, 1)), s.r1, s.r0);
    w_operand = ite(w.w_match, s.w_result, w.reg_operand);
    d_operand = ite(w.x_forward, w.x_result, w.w_operand);
    x_result = ite(
      (extract(7, 6, s.x_ir) == bv(2, 3)),
      ite(
        (extract(1, 0, s.x_ir) == bv(2, 0)),
        s.data0,
        ite(
          (extract(1, 0, s.x_ir) == bv(2, 1)),
          s.data1,
          ite((extract(1, 0, s.x_ir) == bv(2, 2)), s.data2, s.data3)
        )
      ),
      ite(
        (extract(7, 6, s.x_ir) == bv(2, 2)),
        (s.x_operand ^ extract(3, 0, s.x_ir)),
        ite(
          (extract(7, 6, s.x_ir) == bv(2, 1)),
          (s.x_operand + extract(3, 0, s.x_ir)),
          extract(3, 0, s.x_ir)
        )
      )
    );
    fetched = ite(
      (s.fetch_pc == bv(2, 0)),
      s.rom0,
      ite((s.fetch_pc == bv(2, 1)), s.rom1, ite((s.fetch_pc == bv(2, 2)), s.rom2, s.rom3))
    );
  }
  next {
    rom0 = ite(i.stall, s.rom0, s.rom0);
    rom1 = ite(i.stall, s.rom1, s.rom1);
    rom2 = ite(i.stall, s.rom2, s.rom2);
    rom3 = ite(i.stall, s.rom3, s.rom3);
    data0 = ite(i.stall, s.data0, s.data0);
    data1 = ite(i.stall, s.data1, s.data1);
    data2 = ite(i.stall, s.data2, s.data2);
    data3 = ite(i.stall, s.data3, s.data3);
    pc = ite(i.stall, s.pc, ite(s.w_valid, (s.pc + bv(2, 1)), s.pc));
    r0 = ite(i.stall, s.r0, ite(((true && s.w_valid) && (w.w_rd == bv(1, 0))), s.w_result, s.r0));
    r1 = ite(i.stall, s.r1, ite(((true && s.w_valid) && (w.w_rd == bv(1, 1))), s.w_result, s.r1));
    w_valid = ite(i.stall, s.w_valid, s.x_valid);
    w_pc = ite(i.stall, s.w_pc, s.x_pc);
    w_ir = ite(i.stall, s.w_ir, s.x_ir);
    w_result = ite(i.stall, s.w_result, w.x_result);
    x_valid = ite(i.stall, s.x_valid, ((true && s.d_valid) && (!w.hazard)));
    x_pc = ite(i.stall, s.x_pc, s.d_pc);
    x_ir = ite(i.stall, s.x_ir, s.d_ir);
    x_operand = ite(i.stall, s.x_operand, w.d_operand);
    d_valid = ite(i.stall, s.d_valid, ite(w.hazard, s.d_valid, true));
    d_pc = ite(i.stall, s.d_pc, ite(w.hazard, s.d_pc, s.fetch_pc));
    d_ir = ite(i.stall, s.d_ir, ite(w.hazard, s.d_ir, w.fetched));
    fetch_pc = ite(i.stall, s.fetch_pc, ite(w.hazard, s.fetch_pc, (s.fetch_pc + bv(2, 1))));
  }
  outputs {
    commit = w.commit;
  }
}

binding (((((((((((((((true && (spec.pc == impl.pc)) && (spec.r0 == impl.r0)) && (spec.r1 == impl.r1)) && (spec.rom0 == impl.rom0)) && (spec.rom1 == impl.rom1)) && (spec.rom2 == impl.rom2)) && (spec.rom3 == impl.rom3)) && (spec.data0 == impl.data0)) && (spec.data1 == impl.data1)) && (spec.data2 == impl.data2)) && (spec.data3 == impl.data3)) && implies(
          impl.w_valid,
          (((true && (impl.w_pc == impl.pc)) && (impl.w_ir == ite(
                  (impl.w_pc == bv(2, 0)),
                  impl.rom0,
                  ite(
                    (impl.w_pc == bv(2, 1)),
                    impl.rom1,
                    ite((impl.w_pc == bv(2, 2)), impl.rom2, impl.rom3)
                  )
                ))) && (impl.w_result == ite(
                (extract(7, 6, impl.w_ir) == bv(2, 0)),
                extract(3, 0, impl.w_ir),
                ite(
                  (extract(7, 6, impl.w_ir) == bv(2, 1)),
                  (ite((extract(4, 4, impl.w_ir) == bv(1, 0)), impl.r0, impl.r1) + extract(3, 0, impl.w_ir)),
                  ite(
                    (extract(7, 6, impl.w_ir) == bv(2, 2)),
                    (ite((extract(4, 4, impl.w_ir) == bv(1, 0)), impl.r0, impl.r1) ^ extract(3, 0, impl.w_ir)),
                    ite(
                      (extract(1, 0, impl.w_ir) == bv(2, 0)),
                      impl.data0,
                      ite(
                        (extract(1, 0, impl.w_ir) == bv(2, 1)),
                        impl.data1,
                        ite((extract(1, 0, impl.w_ir) == bv(2, 2)), impl.data2, impl.data3)
                      )
                    )
                  )
                )
              )))
        )) && implies(
        impl.x_valid,
        (((true && (impl.x_pc == (impl.pc + ite(impl.w_valid, bv(2, 1), bv(2, 0))))) && (impl.x_ir == ite(
                (impl.x_pc == bv(2, 0)),
                impl.rom0,
                ite(
                  (impl.x_pc == bv(2, 1)),
                  impl.rom1,
                  ite((impl.x_pc == bv(2, 2)), impl.rom2, impl.rom3)
                )
              ))) && implies(
            ((extract(7, 6, impl.x_ir) == bv(2, 1)) || (extract(7, 6, impl.x_ir) == bv(2, 2))),
            (impl.x_operand == ite(
                (extract(4, 4, impl.x_ir) == bv(1, 0)),
                ite(
                  ((true && impl.w_valid) && (extract(5, 5, impl.w_ir) == bv(1, 0))),
                  impl.w_result,
                  impl.r0
                ),
                ite(
                  ((true && impl.w_valid) && (extract(5, 5, impl.w_ir) == bv(1, 1))),
                  impl.w_result,
                  impl.r1
                )
              ))
          ))
      )) && implies(
      impl.d_valid,
      ((true && (impl.d_pc == ((impl.pc + ite(impl.w_valid, bv(2, 1), bv(2, 0))) + ite(impl.x_valid, bv(2, 1), bv(2, 0))))) && (impl.d_ir == ite(
            (impl.d_pc == bv(2, 0)),
            impl.rom0,
            ite(
              (impl.d_pc == bv(2, 1)),
              impl.rom1,
              ite((impl.d_pc == bv(2, 2)), impl.rom2, impl.rom3)
            )
          )))
    )) && (impl.fetch_pc == (((impl.pc + ite(impl.w_valid, bv(2, 1), bv(2, 0))) + ite(impl.x_valid, bv(2, 1), bv(2, 0))) + ite(impl.d_valid, bv(2, 1), bv(2, 0)))));
commit commit;
can_step can_step;
hold_when i.stall;
progress {
  enabled (!i.stall);
  rank ite(impl.w_valid, bv(2, 0), ite(impl.x_valid, bv(2, 1), ite(impl.d_valid, bv(2, 2), bv(2, 3))));
}
