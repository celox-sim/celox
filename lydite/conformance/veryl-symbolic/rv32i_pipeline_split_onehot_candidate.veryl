            7'h13: dec_legal = dec_f3 != 3'd1 && dec_f3 != 3'd5 || dec_f3 == 3'd1 && dec_f7 == 7'h00 || dec_f3 == 3'd5 && (dec_f7 == 7'h00 || dec_f7 == 7'h20);
            7'h33: dec_legal = dec_f7 == 7'h00 || dec_f7 == 7'h20 && (dec_f3 == 3'd0 || dec_f3 == 3'd5);
            // RV32I requires ignoring reserved FENCE rd/rs1/fm/pred/succ fields.
            7'h0f: dec_legal = dec_f3 == 3'd0;
            7'h73: dec_legal = d_ir == 32'h00000073 || d_ir == 32'h00100073;
            default: {}
        }
        dec_writes = dec_legal && (d_op == 7'h37 || d_op == 7'h17 || dec_is_jump || dec_is_load || d_op == 7'h13 || d_op == 7'h33) && d_rd != 5'd0;
    }
    always_ff (clk) {
        if !rst_n {
            pc = '0; fetch_pc = '0; halted = 0;
            r0 = '0; r1 = '0; r2 = '0; r3 = '0; r4 = '0; r5 = '0; r6 = '0; r7 = '0; r8 = '0; r9 = '0; r10 = '0; r11 = '0; r12 = '0; r13 = '0; r14 = '0; r15 = '0; r16 = '0; r17 = '0; r18 = '0; r19 = '0; r20 = '0; r21 = '0; r22 = '0; r23 = '0; r24 = '0; r25 = '0; r26 = '0; r27 = '0; r28 = '0; r29 = '0; r30 = '0; r31 = '0;
            d_valid = 0; d_pc = '0; d_ir = '0; d_fetch_fault = 0;
            d_sel1 = 32'd1; d_sel2 = 32'd1;
            x_valid = 0; x_pc = '0; x_ir = '0; x_fetch_fault = 0;
            x_operand1 = '0; x_operand2 = '0;
            w_valid = 0; w_pc = '0; w_ir = '0; w_result = '0; w_next_pc = '0; w_writes = 0;
            w_store = 0; w_address = '0; w_data = '0; w_mask = '0;
            w_fault = 0; w_cause = '0; w_tval = '0;
            x_op = '0;
            f3 = '0;
            f7 = '0;
            legal = '0;
            writes = '0;
            is_load = '0;
            is_store = '0;
            is_branch = '0;
            is_jump = '0;
            imm_i = '0;
            imm_s = '0;
            imm_b = '0;
            imm_u = '0;
            imm_j = '0;
            m_valid = '0;
            m_pc = '0;
            m_ir = '0;
            m_fetch_fault = '0;
            m_operand2 = '0;
            m_result = '0;
            m_address = '0;
            m_target = '0;
            m_taken = '0;
            m_legal = '0;
            m_writes = '0;
            m_is_load = '0;
            m_is_store = '0;
            m_f3 = '0;
            m_safe_bypass = '0;
            w_redirect = '0; is_alu_imm = 0;
        } else if !stall && !halted {
            if w_valid && w_fault {
                halted = 1; pc = w_pc;
                d_valid = 0; x_valid = 0; m_valid = 0; w_valid = 0;
            } else {
                if w_valid {
                    pc = w_next_pc;
                    if w_writes {
                        // Independent destination enables avoid a priority chain.
                        if w_rd == 5'd1 { r1 = w_result; }
                        if w_rd == 5'd2 { r2 = w_result; }
                        if w_rd == 5'd3 { r3 = w_result; }
                        if w_rd == 5'd4 { r4 = w_result; }
                        if w_rd == 5'd5 { r5 = w_result; }
                        if w_rd == 5'd6 { r6 = w_result; }
                        if w_rd == 5'd7 { r7 = w_result; }
                        if w_rd == 5'd8 { r8 = w_result; }
                        if w_rd == 5'd9 { r9 = w_result; }
                        if w_rd == 5'd10 { r10 = w_result; }
                        if w_rd == 5'd11 { r11 = w_result; }
                        if w_rd == 5'd12 { r12 = w_result; }
                        if w_rd == 5'd13 { r13 = w_result; }
                        if w_rd == 5'd14 { r14 = w_result; }
                        if w_rd == 5'd15 { r15 = w_result; }
                        if w_rd == 5'd16 { r16 = w_result; }
                        if w_rd == 5'd17 { r17 = w_result; }
                        if w_rd == 5'd18 { r18 = w_result; }
                        if w_rd == 5'd19 { r19 = w_result; }
                        if w_rd == 5'd20 { r20 = w_result; }
                        if w_rd == 5'd21 { r21 = w_result; }
                        if w_rd == 5'd22 { r22 = w_result; }
                        if w_rd == 5'd23 { r23 = w_result; }
                        if w_rd == 5'd24 { r24 = w_result; }
                        if w_rd == 5'd25 { r25 = w_result; }
                        if w_rd == 5'd26 { r26 = w_result; }
                        if w_rd == 5'd27 { r27 = w_result; }
                        if w_rd == 5'd28 { r28 = w_result; }
                        if w_rd == 5'd29 { r29 = w_result; }
                        if w_rd == 5'd30 { r30 = w_result; }
                        if w_rd == 5'd31 { r31 = w_result; }
                    }
                }
                w_valid = m_valid; w_pc = m_pc; w_ir = m_ir;
                w_result = final_result; w_next_pc = next_pc; w_writes = m_writes && !fault;
                w_store = m_is_store && m_legal && !fault; w_address = m_address; w_data = store_data; w_mask = store_mask;
                w_fault = m_valid && fault; w_cause = cause; w_tval = tval; w_redirect = m_taken && !fault;
                m_valid = x_valid; m_pc = x_pc; m_ir = x_ir; m_fetch_fault = x_fetch_fault;
                m_operand2 = x_operand2; m_result = result; m_address = address; m_target = target;
                m_taken = taken; m_legal = legal; m_writes = writes; m_is_load = is_load; m_is_store = is_store; m_f3 = f3;
                m_safe_bypass = writes && legal && x_pc[1:0] == 2'd0 && !x_fetch_fault
                    && (x_op == 7'h13 || x_op == 7'h33 || x_op == 7'h37 || x_op == 7'h17);
                x_valid = d_valid && !hazard;
                x_pc = d_pc; x_ir = d_ir; x_fetch_fault = d_fetch_fault;
                x_operand1 = operand1; x_operand2 = operand2;
                is_alu_imm = d_op == 7'h13;
                x_op = d_op; f3 = dec_f3; f7 = dec_f7; legal = dec_legal; writes = dec_writes;
                is_load = dec_is_load; is_store = dec_is_store; is_branch = dec_is_branch; is_jump = dec_is_jump;
                imm_i = dec_imm_i; imm_s = dec_imm_s; imm_b = dec_imm_b; imm_u = dec_imm_u; imm_j = dec_imm_j;
                if !hazard {
                    d_valid = 1; d_pc = fetch_pc; d_ir = imem_response; d_fetch_fault = imem_fault;
                    d_sel1 = 32'd1 << imem_response[19:15];
                    d_sel2 = 32'd1 << imem_response[24:20];
                    fetch_pc = fetch_pc + 32'd4;
                }
                if redirect {
                    fetch_pc = w_next_pc;
                    d_valid = 0; x_valid = 0; m_valid = 0; w_valid = 0;
                }
            }
        }
    }
}
