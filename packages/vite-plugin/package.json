{
  "name": "@celox-sim/vite-plugin",
  "version": "0.3.0",
  "description": "Vite plugin for importing .veryl files as typed ModuleDefinition objects",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "pnpm --dir ../playground run test:vite-components",
    "test:lsp": "pnpm --dir ../playground run test:lsp-components"
  },
  "keywords": [
    "celox",
    "veryl",
    "hdl",
    "vite",
    "vitest",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/celox-sim/celox",
    "directory": "packages/vite-plugin"
  },
  "license": "MIT",
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "dependencies": {
    "@celox-sim/celox": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "typescript": "^7.0.0",
    "vite": "^8.0.0"
  }
}
