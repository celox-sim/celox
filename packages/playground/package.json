{
  "name": "@celox-sim/playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:vite-components": "vitest run test/vite-plugin-cache.test.ts && vitest run --config test/fixtures/injected-components/vitest.config.ts && node test/fixtures/injected-components/dependency-e2e.mjs",
    "test:lsp-components": "pnpm run test:vite-components && node test/fixtures/injected-components/lsp-e2e.mjs",
    "test:e2e": "pnpm run build && playwright test",
    "test:watch": "vitest",
    "test:wasm": "vitest run --config vitest.wasm.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@celox-sim/celox": "workspace:*",
    "@celox-sim/vite-plugin": "workspace:*",
    "monaco-editor": "^0.56.0",
    "sucrase": "^3.35.1",
    "vite": "^8.0.0",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vite-plugin-monaco-editor-nls": "^3.0.1",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@vitest/expect": "^4.1.1",
    "@vitest/runner": "^4.1.1",
    "coi-serviceworker": "^0.1.7"
  }
}
