{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowArbitraryExtensions": true,
    "rootDirs": ["src", ".celox/src"],
    "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": ["src", "test", "*.config.ts"],
  "exclude": ["test/fixtures"]
}
