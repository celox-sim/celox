{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "changelog-type": "github",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "last-release-sha": "516452b051e17b5bad06e6973787ab01bbd2f505",
  "packages": {
    ".": {
      "component": "celox",
      "package-name": "celox",
      "version-file": "VERSION",
      "extra-files": [
        {
          "type": "generic",
          "path": "Cargo.toml"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.match(/^celox(?:-|$)/))].version"
        },
        {
          "type": "json",
          "path": "packages/celox/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/vite-plugin/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "crates/celox-napi/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
