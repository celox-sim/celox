specification "Intent bug: individually usable specifications disagree on an operation" {
  inputs { }
  observations { value: bv<4>; }
  operations { advance {} }
  components {
    One {
      state { x: bv<4>; }
      init s.x == 0u4;
      invariant o.value == s.x;
      steps { advance = n.x == s.x + 1u4; }
      examples {
        one_step {
          expect positive; initial { value = 0u4; }
          trace { advance { observe { value = 1u4; } } }
        }
      }
    }
    Two {
      state { x: bv<4>; }
      init s.x == 0u4;
      invariant o.value == s.x;
      steps { advance = n.x == s.x + 2u4; }
      examples {
        one_step {
          expect positive; initial { value = 0u4; }
          trace { advance { observe { value = 2u4; } } }
        }
      }
    }
  }
  compositions {
    Contradiction {
      members compose(One, Two);
      examples {
        common_initial_state { expect positive; initial { value = 0u4; } trace {} }
        no_joint_extension { expect negative; initial {} trace { advance {} } }
        intended_operation {
          expect positive; initial { value = 0u4; }
          trace { advance { observe { value = 1u4; } } }
        }
      }
    }
  }
}
