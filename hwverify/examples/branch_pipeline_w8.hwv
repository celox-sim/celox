design "branch_pipeline_w8"

input rst: bool;
input stall: bool;
input rom0: bv<13>;
input rom1: bv<13>;
input rom2: bv<13>;
input rom3: bv<13>;
input data0: bv<8>;
input data1: bv<8>;
input data2: bv<8>;
input data3: bv<8>;
reset_input rst;

spec {
  state pc: bv<2>;
  state r0: bv<8>;
  state r1: bv<8>;
  state rom0: bv<13>;
  state rom1: bv<13>;
  state rom2: bv<13>;
  state rom3: bv<13>;
  state data0: bv<8>;
  state data1: bv<8>;
  state data2: bv<8>;
  state data3: bv<8>;
  reset {
    pc = bv(2, 0);
    r0 = bv(8, 0);
    r1 = bv(8, 0);
    rom0 = i.rom0;
    rom1 = i.rom1;
    rom2 = i.rom2;
    rom3 = i.rom3;
    data0 = i.data0;
    data1 = i.data1;
    data2 = i.data2;
    data3 = i.data3;
  }
  wires {
    ir = ite(
      (s.pc == bv(2, 0)),
      s.rom0,
      ite((s.pc == bv(2, 1)), s.rom1, ite((s.pc == bv(2, 2)), s.rom2, s.rom3))
    );
    result = ite(
      (extract(12, 10, w.ir) == bv(3, 0)),
      extract(7, 0, w.ir),
      ite(
        (extract(12, 10, w.ir) == bv(3, 1)),
        (ite((extract(8, 8, w.ir) == bv(1, 0)), s.r0, s.r1) + extract(7, 0, w.ir)),
        ite(
          (extract(12, 10, w.ir) == bv(3, 2)),
          (ite((extract(8, 8, w.ir) == bv(1, 0)), s.r0, s.r1) ^ extract(7, 0, w.ir)),
          ite(
            (extract(1, 0, w.ir) == bv(2, 0)),
            s.data0,
            ite(
              (extract(1, 0, w.ir) == bv(2, 1)),
              s.data1,
              ite((extract(1, 0, w.ir) == bv(2, 2)), s.data2, s.data3)
            )
          )
        )
      )
    );
  }
  next {
    pc = ite(
      ((true && (extract(12, 10, w.ir) == bv(3, 4))) && (ite((extract(8, 8, w.ir) == bv(1, 0)), s.r0, s.r1) == bv(8, 0))),
      extract(1, 0, w.ir),
      (s.pc + bv(2, 1))
    );
    r0 = ite(
      ((true && (extract(12, 12, w.ir) == bv(1, 0))) && (extract(9, 9, w.ir) == bv(1, 0))),
      w.result,
      s.r0
    );
    r1 = ite(
      ((true && (extract(12, 12, w.ir) == bv(1, 0))) && (extract(9, 9, w.ir) == bv(1, 1))),
      w.result,
      s.r1
    );
    rom0 = s.rom0;
    rom1 = s.rom1;
    rom2 = s.rom2;
    rom3 = s.rom3;
    data0 = s.data0;
    data1 = s.data1;
    data2 = s.data2;
    data3 = s.data3;
  }
  outputs {
    can_step = true;
  }
}

impl {
  state pc: bv<2>;
  state r0: bv<8>;
  state r1: bv<8>;
  state rom0: bv<13>;
  state rom1: bv<13>;
  state rom2: bv<13>;
  state rom3: bv<13>;
  state data0: bv<8>;
  state data1: bv<8>;
  state data2: bv<8>;
  state data3: bv<8>;
  state fetch_pc: bv<2>;
  state d_valid: bool;
  state d_pc: bv<2>;
  state d_ir: bv<13>;
  state x_valid: bool;
  state x_pc: bv<2>;
  state x_ir: bv<13>;
  state w_valid: bool;
  state w_pc: bv<2>;
  state w_ir: bv<13>;
  state x_operand: bv<8>;
  state w_result: bv<8>;
  state w_next_pc: bv<2>;
  reset {
    pc = bv(2, 0);
    r0 = bv(8, 0);
    r1 = bv(8, 0);
    rom0 = i.rom0;
    rom1 = i.rom1;
    rom2 = i.rom2;
    rom3 = i.rom3;
    data0 = i.data0;
    data1 = i.data1;
    data2 = i.data2;
    data3 = i.data3;
    fetch_pc = bv(2, 0);
    d_valid = false;
    d_pc = bv(2, 0);
    d_ir = bv(13, 0);
    x_valid = false;
    x_pc = bv(2, 0);
    x_ir = bv(13, 0);
    w_valid = false;
    w_pc = bv(2, 0);
    w_ir = bv(13, 0);
    x_operand = bv(8, 0);
    w_result = bv(8, 0);
    w_next_pc = bv(2, 0);
  }
  wires {
    commit = ((true && (!i.stall)) && s.w_valid);
    d_uses = (((extract(12, 10, s.d_ir) == bv(3, 1)) || (extract(12, 10, s.d_ir) == bv(3, 2))) || (extract(12, 10, s.d_ir) == bv(3, 4)));
    d_rs = extract(8, 8, s.d_ir);
    d_branch = (extract(12, 10, s.d_ir) == bv(3, 4));
    x_rd = extract(9, 9, s.x_ir);
    w_rd = extract(9, 9, s.w_ir);
    x_load = (extract(12, 10, s.x_ir) == bv(3, 3));
    x_writes = (extract(12, 12, s.x_ir) == bv(1, 0));
    w_writes = (extract(12, 12, s.w_ir) == bv(1, 0));
    x_match = (((true && s.x_valid) && w.x_writes) && (w.x_rd == w.d_rs));
    w_match = (((true && s.w_valid) && w.w_writes) && (w.w_rd == w.d_rs));
    hazard = ((((true && s.d_valid) && w.d_uses) && w.x_match) && w.x_load);
    x_forward = ((true && w.x_match) && (!w.x_load));
    reg_operand = ite((w.d_rs == bv(1, 1)), s.r1, s.r0);
    w_operand = ite(w.w_match, s.w_result, w.reg_operand);
    d_operand = ite(w.x_forward, w.x_result, w.w_operand);
    x_result = ite(
      (extract(12, 10, s.x_ir) == bv(3, 3)),
      ite(
        (extract(1, 0, s.x_ir) == bv(2, 0)),
        s.data0,
        ite(
          (extract(1, 0, s.x_ir) == bv(2, 1)),
          s.data1,
          ite((extract(1, 0, s.x_ir) == bv(2, 2)), s.data2, s.data3)
        )
      ),
      ite(
        (extract(12, 10, s.x_ir) == bv(3, 2)),
        (s.x_operand ^ extract(7, 0, s.x_ir)),
        ite(
          (extract(12, 10, s.x_ir) == bv(3, 1)),
          (s.x_operand + extract(7, 0, s.x_ir)),
          extract(7, 0, s.x_ir)
        )
      )
    );
    x_taken = (((true && s.x_valid) && (extract(12, 10, s.x_ir) == bv(3, 4))) && (s.x_operand == bv(8, 0)));
    x_next_pc = ite(w.x_taken, extract(1, 0, s.x_ir), (s.x_pc + bv(2, 1)));
    fetched = ite(
      (s.fetch_pc == bv(2, 0)),
      s.rom0,
      ite((s.fetch_pc == bv(2, 1)), s.rom1, ite((s.fetch_pc == bv(2, 2)), s.rom2, s.rom3))
    );
  }
  next {
    rom0 = ite(i.stall, s.rom0, s.rom0);
    rom1 = ite(i.stall, s.rom1, s.rom1);
    rom2 = ite(i.stall, s.rom2, s.rom2);
    rom3 = ite(i.stall, s.rom3, s.rom3);
    data0 = ite(i.stall, s.data0, s.data0);
    data1 = ite(i.stall, s.data1, s.data1);
    data2 = ite(i.stall, s.data2, s.data2);
    data3 = ite(i.stall, s.data3, s.data3);
    pc = ite(i.stall, s.pc, ite(s.w_valid, s.w_next_pc, s.pc));
    r0 = ite(
      i.stall,
      s.r0,
      ite((((true && s.w_valid) && w.w_writes) && (w.w_rd == bv(1, 0))), s.w_result, s.r0)
    );
    r1 = ite(
      i.stall,
      s.r1,
      ite((((true && s.w_valid) && w.w_writes) && (w.w_rd == bv(1, 1))), s.w_result, s.r1)
    );
    w_valid = ite(i.stall, s.w_valid, s.x_valid);
    w_pc = ite(i.stall, s.w_pc, s.x_pc);
    w_ir = ite(i.stall, s.w_ir, s.x_ir);
    w_result = ite(i.stall, s.w_result, w.x_result);
    w_next_pc = ite(i.stall, s.w_next_pc, w.x_next_pc);
    x_valid = ite(i.stall, s.x_valid, (((true && s.d_valid) && (!w.hazard)) && (!w.x_taken)));
    x_pc = ite(i.stall, s.x_pc, s.d_pc);
    x_ir = ite(i.stall, s.x_ir, s.d_ir);
    x_operand = ite(i.stall, s.x_operand, w.d_operand);
    d_valid = ite(i.stall, s.d_valid, ite(w.x_taken, false, ite(w.hazard, s.d_valid, true)));
    d_pc = ite(i.stall, s.d_pc, ite(w.hazard, s.d_pc, s.fetch_pc));
    d_ir = ite(i.stall, s.d_ir, ite(w.hazard, s.d_ir, w.fetched));
    fetch_pc = ite(
      i.stall,
      s.fetch_pc,
      ite(w.x_taken, extract(1, 0, s.x_ir), ite(w.hazard, s.fetch_pc, (s.fetch_pc + bv(2, 1))))
    );
  }
  outputs {
    commit = w.commit;
  }
}

binding (((((((((((((((true && (spec.pc == impl.pc)) && (spec.r0 == impl.r0)) && (spec.r1 == impl.r1)) && (spec.rom0 == impl.rom0)) && (spec.rom1 == impl.rom1)) && (spec.rom2 == impl.rom2)) && (spec.rom3 == impl.rom3)) && (spec.data0 == impl.data0)) && (spec.data1 == impl.data1)) && (spec.data2 == impl.data2)) && (spec.data3 == impl.data3)) && implies(
          impl.w_valid,
          ((((true && (impl.w_pc == impl.pc)) && (impl.w_ir == ite(
                    (impl.w_pc == bv(2, 0)),
                    impl.rom0,
                    ite(
                      (impl.w_pc == bv(2, 1)),
                      impl.rom1,
                      ite((impl.w_pc == bv(2, 2)), impl.rom2, impl.rom3)
                    )
                  ))) && (impl.w_next_pc == ite(
                  ((true && (extract(12, 10, impl.w_ir) == bv(3, 4))) && (ite((extract(8, 8, impl.w_ir) == bv(1, 0)), impl.r0, impl.r1) == bv(8, 0))),
                  extract(1, 0, impl.w_ir),
                  (impl.w_pc + bv(2, 1))
                ))) && implies(
              (extract(12, 12, impl.w_ir) == bv(1, 0)),
              (impl.w_result == ite(
                  (extract(12, 10, impl.w_ir) == bv(3, 0)),
                  extract(7, 0, impl.w_ir),
                  ite(
                    (extract(12, 10, impl.w_ir) == bv(3, 1)),
                    (ite((extract(8, 8, impl.w_ir) == bv(1, 0)), impl.r0, impl.r1) + extract(7, 0, impl.w_ir)),
                    ite(
                      (extract(12, 10, impl.w_ir) == bv(3, 2)),
                      (ite((extract(8, 8, impl.w_ir) == bv(1, 0)), impl.r0, impl.r1) ^ extract(7, 0, impl.w_ir)),
                      ite(
                        (extract(1, 0, impl.w_ir) == bv(2, 0)),
                        impl.data0,
                        ite(
                          (extract(1, 0, impl.w_ir) == bv(2, 1)),
                          impl.data1,
                          ite((extract(1, 0, impl.w_ir) == bv(2, 2)), impl.data2, impl.data3)
                        )
                      )
                    )
                  )
                ))
            ))
        )) && implies(
        impl.x_valid,
        (((true && (impl.x_pc == ite(impl.w_valid, impl.w_next_pc, impl.pc))) && (impl.x_ir == ite(
                (impl.x_pc == bv(2, 0)),
                impl.rom0,
                ite(
                  (impl.x_pc == bv(2, 1)),
                  impl.rom1,
                  ite((impl.x_pc == bv(2, 2)), impl.rom2, impl.rom3)
                )
              ))) && implies(
            (((extract(12, 10, impl.x_ir) == bv(3, 1)) || (extract(12, 10, impl.x_ir) == bv(3, 2))) || (extract(12, 10, impl.x_ir) == bv(3, 4))),
            (impl.x_operand == ite(
                (extract(8, 8, impl.x_ir) == bv(1, 0)),
                ite(
                  (((true && impl.w_valid) && (extract(12, 12, impl.w_ir) == bv(1, 0))) && (extract(9, 9, impl.w_ir) == bv(1, 0))),
                  impl.w_result,
                  impl.r0
                ),
                ite(
                  (((true && impl.w_valid) && (extract(12, 12, impl.w_ir) == bv(1, 0))) && (extract(9, 9, impl.w_ir) == bv(1, 1))),
                  impl.w_result,
                  impl.r1
                )
              ))
          ))
      )) && implies(
      impl.d_valid,
      ((true && (impl.d_pc == (ite(impl.w_valid, impl.w_next_pc, impl.pc) + ite(impl.x_valid, bv(2, 1), bv(2, 0))))) && (impl.d_ir == ite(
            (impl.d_pc == bv(2, 0)),
            impl.rom0,
            ite(
              (impl.d_pc == bv(2, 1)),
              impl.rom1,
              ite((impl.d_pc == bv(2, 2)), impl.rom2, impl.rom3)
            )
          )))
    )) && (impl.fetch_pc == ((ite(impl.w_valid, impl.w_next_pc, impl.pc) + ite(impl.x_valid, bv(2, 1), bv(2, 0))) + ite(impl.d_valid, bv(2, 1), bv(2, 0)))));
commit commit;
can_step can_step;
hold_when i.stall;
progress {
  enabled (!i.stall);
  rank ite(impl.w_valid, bv(2, 0), ite(impl.x_valid, bv(2, 1), ite(impl.d_valid, bv(2, 2), bv(2, 3))));
}
