(case uses_one_width_and_sign_context_for_generate_case
  (source "generate_case_context.sv" #"
                module Top(output logic y);
                    case (4'shf)
                        8'shff: assign y = 1;
                        8'h00: assign y = 1;
                        default: assign y = 0;
                    endcase
                endmodule
            "#)
  (top Top)
  (eval)
