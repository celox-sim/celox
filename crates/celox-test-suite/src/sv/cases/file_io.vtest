(group file_io (category sequential))

(case stdout_preserves_format_and_call_order
  (four_state)
  (source "stdout_file_io.sv" #"
    module Top(output bit done);
      int fd;
      initial begin
        $display("before");
        $fwrite(32'h8000_0001, "fd:%0d,", 12);
        $fdisplayh(1, "mcd:%h", 8'bxz010101);
        $display("after");
        done = 1;
      end
    endmodule
  "#)
  (top Top)
  (run_until 0)
  (assert_eq done 1)
  (expect_output "before\nfd:12,mcd:X5\nafter\n"))

(case edge_procedures_execute_requests_in_statement_order
  (source "edge_file_io.sv" #"
    module Top(output int count);
      bit clk;
      initial begin clk = 0; #1 clk = 1; #1 clk = 0; #1 clk = 1; end
      always_ff @(posedge clk) begin
        $fwrite(1, "ff:%0d,", count);
        count = count + 1;
      end
      always @(negedge clk) $fdisplay(1, "neg:%0d", count);
    endmodule
  "#)
  (top Top)
  (run_until 3)
  (assert_eq count 2)
  (expect_output "ff:0,neg:1\nff:1,"))

(case fgets_invalid_descriptor_status_and_type
  (source "fgets_status.sv" #"
module Top(output bit ok);
  string line="keep";
  int n;
  initial begin
    n=$fgets(line,32'h8000ffff);
    ok=n==0 && $bits($fgets(line,0))==32;
    n=$fgets(line,0);
    ok &= n==0;
  end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq ok 1))

(case ferror_success_clears_description
  (source "ferror_success.sv" #"
module Top(output bit ok);
  int code;
  string text="old";
  logic [639:0] packed_text='1;
  initial begin
    code=$ferror(32'h80000001,text);
    ok=code==0 && text=="" && $bits($ferror(32'h80000001,text))==32;
    code=$ferror(32'h80000001,packed_text);
    ok &= code==0 && packed_text==0;
  end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq ok 1))

(case strobe_reads_after_nba
  (source "strobe_nba.sv" #"
module Top(output int value);
  bit clk;
  initial begin value=1; #1 clk=1; #1; end
  always @(posedge clk) begin
    $strobe("late=%0d",value);
    $display("active=%0d",value);
    value<=3;
  end
endmodule
"#)
  (top Top) (run_until 2) (assert_eq value 3)
  (expect_output "active=1\nlate=3\n"))

(case fstrobe_stdout_reads_final_value
  (source "fstrobe_stdout.sv" #"
module Top(output int value);
  initial begin
    value=4;
    $fstrobe(32'h80000001,"file=%0d",value);
    $display("active=%0d",value);
    value=7;
    #1;
  end
endmodule
"#)
  (top Top) (run_until 1) (assert_eq value 7)
  (expect_output "active=4\nfile=7\n"))

(case strobe_radix_variants
  (source "strobe_radices.sv" #"
module Top;
  logic [7:0] value;
  initial begin
    value=0;
    $strobeb(value);
    $strobeo(value);
    $strobeh(value);
    $fstrobeb(32'h80000001,value);
    $fstrobeo(32'h80000001,value);
    $fstrobeh(32'h80000001,value);
    value=8'h2a;
    #1;
  end
endmodule
"#)
  (top Top) (run_until 1)
  (expect_output "00101010\n052\n2a\n00101010\n052\n2a\n"))

(case strobe_reads_after_reactive_program
  (source "strobe_program.sv" #"
program Writer(output logic [31:0] value);
  initial begin value=9; #10 value=10; end
endprogram
module Top(output wire [31:0] value);
  Writer writer(value);
  initial begin $strobe("reactive=%0d",value); #2 $display("later"); end
endmodule
"#)
  (top Top) (run_until 1) (assert_eq value 9)
  (expect_output "reactive=9\n"))
