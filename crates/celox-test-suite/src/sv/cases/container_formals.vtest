(group container_formals (category functions))

; IEEE 1800-2023 13.5.1: a dynamic array, queue or associative array formal
; that is not a reference holds a copy. An input is copied in when the call
; is made, so the callee's changes stay its own; an output starts at its
; default and is copied to the actual when the subroutine returns; an inout
; does both. The copies follow container assignment (7.6, 7.9.9, 7.10).

(case input_container_changes_are_not_seen_by_the_caller
 (source "input_container_changes_are_not_seen_by_the_caller.sv" #"module Top(output int local_size, output int first, output int size, output int keys);
 function automatic int grow(int q[$], int m[string]);
  q.push_back(4);
  q[0] = 99;
  m["z"] = 1;
  m.delete("a");
  return q.size() * 10 + m.size();
 endfunction
 int q[$];
 int m[string];
 initial begin
  q = '{1, 2, 3};
  m["a"] = 5;
  m["b"] = 6;
  local_size = grow(q, m);
  first = q[0];
  size = q.size();
  keys = m.size() * 10 + m.exists("a");
 end
endmodule"#)
 (top Top)
 (run_until 1)
 (assert_eq local_size 42)
 (assert_eq first 1)
 (assert_eq size 3)
 (assert_eq keys 21))

(case input_container_from_container_values
 (source "input_container_from_container_values.sv" #"module Top(output int literal, output int converted, output int defaulted);
 function automatic int sum(int q[$]);
  int total = q.size() * 1000;
  foreach (q[i]) total += q[i];
  return total;
 endfunction
 function automatic int count(int q[$] = '{5, 6});
  return q.size();
 endfunction
 int d[];
 initial begin
  d = '{7, 8};
  literal = sum('{1, 2, 3});
  converted = sum(d);
  defaulted = count() * 10 + count('{1});
 end
endmodule"#)
 (top Top)
 (run_until 1)
 (assert_eq literal 3006)
 (assert_eq converted 2015)
 (assert_eq defaulted 21))

(case input_container_from_an_empty_concatenation
 (source "input_container_from_an_empty_concatenation.sv" #"module Top(output int empty);
 function automatic int size(int q[$]);
  q.push_back(1);
  return q.size();
 endfunction
 initial empty = size({}) * 10 + size({});
endmodule"#)
 (top Top)
 (run_until 1)
 (assert_eq empty 11))

(case output_container_starts_empty_and_is_copied_back
 (source "output_container_starts_empty_and_is_copied_back.sv" #"module Top(output int first, output int second, output int seen, output int last);
 function automatic int names(output string q[$], input int n);
  int start = q.size();
  for (int i = 0; i < n; i++) q.push_back(i == 0 ? "a" : "b");
  return start;
 endfunction
 string s[$];
 initial begin
  s = '{"x", "y", "z", "w"};
  seen = names(s, 2) * 100;
  first = s.size();
  seen += names(s, 3);
  second = s.size();
  last = s[2] == "b";
 end
endmodule"#)
 (top Top)
 (run_until 1)
 (assert_eq first 2)
 (assert_eq second 3)
 (assert_eq seen 0)
 (assert_eq last 1))

(case inout_container_is_copied_in_and_back
 (source "inout_container_is_copied_in_and_back.sv" #"module Top(output int size, output int total, output int keys);
 function automatic void extend(inout int q[$], inout int m[int]);
  q.push_front(q.size());
  m[q.size()] = q[0];
 endfunction
 int q[$];
 int m[int];
 initial begin
  q = '{5, 6};
  extend(q, m);
  extend(q, m);
  size = q.size();
  total = 0;
  foreach (q[i]) total = total * 10 + q[i];
  keys = 0;
  foreach (m[k]) keys = keys * 100 + k * 10 + m[k];
 end
endmodule"#)
 (top Top)
 (run_until 1)
 (assert_eq size 4)
 (assert_eq total 3256)
 (assert_eq keys 3243))

(case task_copies_containers_back_when_it_returns
 (source "task_copies_containers_back_when_it_returns.sv" #"module Top(output int during, output int after, output int local_size, output int caller);
 int q[$];
 int r[$];
 task automatic work(inout int values[$], output int fresh[$], input int seed[$]);
  values.push_back(1);
  fresh.push_back(2);
  seed.push_back(3);
  #2;
  local_size = seed.size();
 endtask
 initial begin
  q = '{9};
  r = '{8, 8};
  fork
   work(q, r, q);
   begin #1 during = q.size() * 10 + r.size(); end
  join
  after = q.size() * 10 + r.size();
  caller = q[1] * 10 + r[0];
 end
endmodule"#)
 (top Top)
 (run_until 5)
 (assert_eq during 12)
 (assert_eq after 21)
 (assert_eq local_size 2)
 (assert_eq caller 12))

(case container_formals_of_class_handles_copy_the_container
 (source "container_formals_of_class_handles_copy_the_container.sv" #"module Top(output int count, output int value, output int same);
 class Item;
  int value;
  function new(int v); value = v; endfunction
 endclass
 function automatic void bump(Item items[$]);
  Item extra = new(0);
  foreach (items[i]) items[i].value += 10;
  items.push_back(extra);
  items[0] = null;
 endfunction
 function automatic void collect(output Item items[$], input Item from[$]);
  items = from;
  items.push_back(from[0]);
 endfunction
 Item q[$];
 Item c[$];
 Item first;
 Item second;
 initial begin
  first = new(1);
  second = new(2);
  q.push_back(first);
  q.push_back(second);
  bump(q);
  collect(c, q);
  count = q.size() * 10 + c.size();
  value = q[0].value * 100 + q[1].value;
  same = (c[2] == q[0]) + (c[0] == q[0]);
 end
endmodule"#)
 (top Top)
 (run_until 1)
 (assert_eq count 23)
 (assert_eq value 1112)
 (assert_eq same 2))

(case container_formals_of_class_methods
 (source "container_formals_of_class_methods.sv" #"module Top(output int base_count, output int derived_count, output int names, output int stored);
 typedef string names_t[$];
 class Base;
  int kept[$];
  virtual function int count(int q[$]);
   q.push_back(0);
   return q.size();
  endfunction
  function void list(output names_t out);
   out.push_back("base");
  endfunction
  function void keep(int q[$]);
   kept = q;
   q.delete();
  endfunction
 endclass
 class Derived extends Base;
  virtual function int count(int q[$]);
   q.delete();
   return 100 + q.size();
  endfunction
 endclass
 Base b;
 Derived d;
 Base as_base;
 int q[$];
 names_t n;
 initial begin
  b = new;
  d = new;
  as_base = d;
  q = '{1, 2};
  base_count = b.count(q) * 10 + q.size();
  derived_count = as_base.count(q) * 10 + q.size();
  b.list(n);
  d.list(n);
  names = n.size();
  b.keep(q);
  stored = b.kept.size() * 10 + q.size();
 end
endmodule"#)
 (top Top)
 (run_until 1)
 (assert_eq base_count 32)
 (assert_eq derived_count 1002)
 (assert_eq names 1)
 (assert_eq stored 22))

(case static_subroutine_container_formals
 (source "static_subroutine_container_formals.sv" #"module Top(output int first, output int second, output int caller);
 function static int count(int q[$]);
  q.push_back(1);
  return q.size();
 endfunction
 function static void fill(output int q[$], input int n);
  q = {};
  repeat (n) q.push_back(n);
 endfunction
 int q[$];
 initial begin
  q = '{4};
  first = count(q);
  second = count(q);
  fill(q, 3);
  caller = q.size() * 10 + q[0];
 end
endmodule"#)
 (top Top)
 (run_until 1)
 (assert_eq first 2)
 (assert_eq second 2)
 (assert_eq caller 33))

(case container_formals_forwarded_and_read_from_properties
 (source "container_formals_forwarded_and_read_from_properties.sv" #"module Top(output int listed, output int forwarded, output int copied, output int read);
 class Store;
  int values[$];
 endclass
 function automatic void list(output string q[$], input int n);
  repeat (n) q.push_back("n");
 endfunction
 function automatic void grow(inout int q[$]);
  q.push_back(q.size());
 endfunction
 function automatic void relay(output string q[$], inout int v[$]);
  list(q, 2);
  grow(v);
 endfunction
 function automatic void through(ref int v[$], output int copy[$]);
  grow(v);
  copy = v;
 endfunction
 function automatic int total(int q[$]);
  int sum = q.size() * 100;
  q.push_back(1000);
  foreach (q[i]) sum += q[i];
  return sum;
 endfunction
 Store s;
 string n[$];
 int v[$];
 int q[$];
 int c[$];
 int m[string][$];
 initial begin
  s = new;
  n = '{"old"};
  list(n, 3);
  listed = n.size();
  relay(n, v);
  relay(n, v);
  forwarded = n.size() * 10 + v.size();
  q = '{4};
  through(q, c);
  copied = q.size() * 10 + c.size();
  s.values = '{1, 2};
  m["a"] = '{5};
  read = total(s.values) * 10000 + total(m["a"]) * 10 + s.values.size() + m["a"].size();
 end
endmodule"#)
 (top Top)
 (run_until 1)
 (assert_eq listed 3)
 (assert_eq forwarded 22)
 (assert_eq copied 22)
 (assert_eq read 12041053))

; IEEE 1800-2023 11.5.1, 13.5.2: a bit-select or part-select of an element
; of a dynamic array, queue or associative array, also one passed by
; reference, writes those bits of the element, with `=` or an assignment
; operator. A value with effects is evaluated before the other bits of the
; element are read, and the element read is the one written.
(case selects_of_reference_container_elements
 (source "selects_of_reference_container_elements.sv" #"module Top(output int a, output int b, output int c, output int d, output int e, output int g, output int h, output int k, output int n);
 class Packer;
  bit [63:0] m_bits;
  int iter;
  function void unpack_bytes(ref byte value[], input int size = -1);
   if (size < 0) size = value.size() * $bits(byte);
   for (int i = 0; i < size; i++)
    value[i / $bits(byte)][i % $bits(byte)] = m_bits[iter + i];
   iter += size;
  endfunction
  function void unpack_ints(ref int value[], input int size = -1);
   if (size < 0) size = value.size() * $bits(int);
   for (int i = 0; i < size; i++)
    value[i / $bits(int)][i % $bits(int)] = m_bits[iter + i];
   iter += size;
  endfunction
 endclass
 function automatic void set_nibble(ref bit [7:0] q[$]);
  q[1][7:4] = 4'ha;
 endfunction
 Packer p;
 byte bs[];
 int is[];
 bit [7:0] q[$];
 int m[string];
 bit [7:0] r[$];
 int j;
 function automatic int move();
  j = 1;
  return 1;
 endfunction
 function automatic bit [3:0] one();
  return 1;
 endfunction
 initial begin
  p = new;
  p.m_bits = 64'h0123_4567_89ab_cdef;
  bs = new[2];
  p.unpack_bytes(bs);
  a = {bs[1], bs[0]};
  is = new[1];
  p.unpack_ints(is, 16);
  b = is[0];
  q = '{8'h11, 8'h22};
  set_nibble(q);
  c = q[1];
  m["k"] = 32'h100;
  m["k"][3] = 1'b1;
  m["k"][15:12] += 4'h2;
  m["n"][0] = 1'b1;
  d = m["k"] + m["n"] * 65536;
  q[0][2+:3] = 3'b101;
  q[$][0] = 1'b1;
  e = {q[0], q[1]};
  // Either order of the index and the call reads and writes one element:
  // r[0] gives '{0, 0}, r[1] '{1, 1}.
  r = '{8'h01, 8'h00};
  j = 0;
  r[j][0] += move();
  g = {r[0], r[1]} == 16'h0000 || {r[0], r[1]} == 16'h0101;
  r = '{8'h10, 8'h20};
  r[0][0] = r.pop_front();
  h = r.size() * 256 + r[0];
  // The value is evaluated in the context of the 4-bit selection, where
  // 4'hf + 1 wraps to 0.
  r = '{8'hff, 8'h00};
  r[0][3:0] = (4'hf + one()) >> 1;
  k = {r[0], r[1]};
  j = 7;
  r[0][j -: 4] = one();
  n = r[0];
 end
endmodule"#)
 (top Top)
 (run_until 1)
 (assert_eq a 0xcdef)
 (assert_eq b 0x89ab)
 (assert_eq c 0xa2)
 (assert_eq d 0x12108)
 (assert_eq e 0x15a3)
 (assert_eq g 1)
 (assert_eq h 0x120)
 (assert_eq k 0xf000)
 (assert_eq n 0x10))

; IEEE 1800-2023 11.5.1: a select of a four-state element writes unknown bits
; and leaves the others.
(case selects_of_four_state_container_elements
 (source "selects_of_four_state_container_elements.sv" #"module Top(output bit f);
 logic [7:0] l[$];
 int i = 1;
 initial begin
  l = '{8'h0f};
  l[0][7] = 1'bx;
  l[0][i] = 1'b0;
  f = l[0] === 8'bx0001101;
 end
endmodule"#)
 (four_state)
 (top Top)
 (run_until 1)
 (assert_eq f 1))
