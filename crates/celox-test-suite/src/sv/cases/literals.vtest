(group literals (category types))

(case simulates_systemverilog_unbased_unsized_literals
  (source "unbased_unsized.sv" #"
        module Top(
            output logic [3:0] y,
            output logic [3:0] z
        );
            assign y = '1;
            assign z = '0;
        endmodule
    "#)
  (top Top)
  (eval)
  (assert_eq y 0x0f)
  (assert_eq z 0x00))

(case simulates_systemverilog_four_state_input_operator_masks
  (four_state)
  (source "four_state_input_ops.sv" #"
        module Top(
            input logic [3:0] a,
            output logic [3:0] y
        );
            assign y = a ^ 4'b1010;
        endmodule
    "#)
  (top Top)
  (modify (set a (fourstate 0b1010 0b0011)))
  (let value (payload (get y)))
  (let mask (xmask (get y)))
  (assert (== value 0b0011))
  (assert (== mask 0b0011)))

(case simulates_systemverilog_four_state_literal_operator_masks
  (four_state)
  (source "four_state_ops.sv" #"
        module Top(
            output logic [3:0] y
        );
            assign y = 4'b1010 ^ 4'b00xz;
        endmodule
    "#)
  (top Top)
  (eval)
  (let value (payload (get y)))
  (let mask (xmask (get y)))
  (assert (== value 0b1011))
  (assert (== mask 0b0011)))

(case string_literals_are_unsigned_packed_bytes
  (source "string_literals.sv" #"
        module Child #(parameter P="fallback")(output logic [63:0] y);
            assign y=P;
        endmodule
        module Top #(parameter VENDOR="XILINX")(
            output logic matched, output logic [63:0] forwarded,
            output logic [47:0] escaped, output logic [23:0] underscore,
            output logic [7:0] empty_width, output logic [15:0] extended);
            localparam TEXT="A_B";
            localparam COPY=TEXT;
            assign matched=(VENDOR == "XILINX") && (COPY == "A_B");
            Child #(.P(VENDOR)) child(forwarded);
            assign escaped={"\101", "\x42", "\n", "\t", "\\", "\""};
            assign underscore=COPY;
            assign empty_width=$bits("");
            assign extended="\200";
        endmodule
    "#)
  (top Top)
  (assert_eq matched 1)
  (assert_eq forwarded 0x58494c494e58)
  (assert_eq escaped 0x41420a095c22)
  (assert_eq underscore 0x415f42)
  (assert_eq empty_width 8)
  (assert_eq extended 0x80))

; A time literal in an expression is a realtime value scaled to the time unit
; (IEEE 1800-2023 5.8). The suite runs timed cases at 1ns/1ps.
(case time_literals_scale_to_the_time_unit
  (source "time_literals.sv" #"
module Top(output longint timeout, output logic [63:0] half, output logic [63:0] fraction,
           output longint tiny, output longint micro);
    class Root;
        time phase_timeout = 9200s;
    endclass
    Root o;
    initial begin
        o = new;
        timeout = o.phase_timeout;
        half = $realtobits(2.5ns);
        fraction = $realtobits(1.25ns);
        tiny = 2.5ps;
        micro = 1us;
    end
endmodule
"#)
  (top Top) (run_until 0)
  (assert_eq timeout 9200000000000)
  (assert_eq half 0x4004000000000000)
  (assert_eq fraction 0x3ff4000000000000)
  (assert_eq tiny 0)
  (assert_eq micro 1000))
