(group always_comb (category combinational))

(case simulates_systemverilog_always_comb_dependency
  (source "always_comb.sv" #"
        module Top(
            input logic [7:0] a,
            input logic [7:0] b,
            output logic [7:0] y,
            output logic [7:0] z
        );
            always_comb begin
                y = a ^ b;
                z = y | 8'h80;
            end
        endmodule
    "#)
  (top Top)
  (modify
    (set a 0x55)
    (set b 0x0f))
  (assert_eq y 0x5a)
  (assert_eq z 0xda))

(case preserves_intervening_reads_when_merging_conditional_writes
  (source "always_comb_order.sv" #"
        module Top(
            input logic c,
            input logic d,
            output logic x,
            output logic y
        );
            always_comb begin
                x = d;
                y = x;
                if (c) x = 1'b1;
            end
        endmodule
    "#)
  (top Top)
  (modify
    (set c 1)
    (set d 0))
  (assert_eq x 1)
  (assert_eq y 0)
  (modify
    (set c 0)
    (set d 1))
  (assert_eq x 1)
  (assert_eq y 1))

(case settles_feedback_through_disjoint_bits_of_one_variable
  (source "disjoint_bit_feedback.sv" #"
        module Top(input logic inp, output logic out);
            logic [1:0] v;
            logic lo;
            always_comb lo = v[1];
            assign v = {inp, lo};
            assign out = v[0];
        endmodule
    "#)
  (top Top)
  (for bit (list 0 1 0 1)
    (modify (set inp bit))
    (assert_eq out bit)))

(case orders_dynamic_array_read_after_its_writer
  (source "dynamic_array_read_order.sv" #"
        module Top(input logic [1:0] i, output logic [7:0] o);
            logic [7:0] a [0:3];
            assign o = a[i];
            always_comb begin
                a[0] = 8'hAA;
                a[1] = 8'hBB;
                a[2] = 8'hCC;
                a[3] = 8'hDD;
            end
        endmodule
    "#)
  (top Top)
  (for (index expected) (list (0 0xaa) (1 0xbb) (2 0xcc) (3 0xdd))
    (modify (set i index))
    (assert_eq o expected)))

; An event list naming exactly the variables the statement reads is the
; implicit event expression of that statement (IEEE 1800-2023 9.4.2.2), in
; either order and with `or` or a comma.
(case explicit_list_of_every_read_settles_like_a_wildcard
  (source "level_list.sv" #"
        module Top(
            input logic [7:0] a,
            input logic [7:0] b,
            output logic [7:0] y,
            output logic [7:0] z
        );
            always @(a or b) y = a + b;
            always @(b, a) z = a - b;
        endmodule
    "#)
  (top Top)
  (modify
    (set a 3)
    (set b 5))
  (assert_eq y 8)
  (assert_eq z 0xfe)
  (modify (set a 10))
  (assert_eq y 15)
  (assert_eq z 5))

; In two-state mode, `always @*` and a sensitivity list run once at time
; zero, after the initial blocks, as Verilator settles them: C906's memory
; enable would otherwise start as a real 0, a write enable (#2021). IEEE
; 1800-2023 9.2.2.2 has them wait for a change, which four-state mode keeps.
(case two_state_sensitivity_lists_run_at_time_zero
  (tags two_state_time_zero_settle)
  (source "time_zero.sv" #"
        module Top;
            localparam logic [1:0] READ = 2'd1;
            logic [1:0] cur_state;
            logic wvalid, wready;
            logic [15:0] wstrb;
            logic cen;
            logic [15:0] wen;
            logic [3:0] st = 4'd2;
            logic hit;
            always @(cur_state or wvalid or wready or wstrb[15:0]) begin
                if (cur_state == READ) begin
                    cen = 1'b0;
                    wen = 16'hffff;
                end else if (wvalid && wready) begin
                    cen = 1'b0;
                    wen = ~wstrb;
                end else begin
                    cen = 1'b1;
                    wen = 16'hffff;
                end
            end
            always @* hit = (st == 4'd2);
            initial begin
                #1 $display("%b %h %b", cen, wen, hit);
                $finish;
            end
        endmodule
    "#)
  (top Top)
  (run_to_finish)
  (expect_output "1 ffff 1\n"))

; Two-state mode also runs a sensitivity list that does not name exactly the
; reads of its statement once at time zero, after the initial blocks, and then
; waits at it, as Verilator settles it (#2026): `y` lists a variable it does
; not read, and `z` reads `b` without listing it.
(case two_state_other_sensitivity_lists_run_at_time_zero
  (tags two_state_time_zero_settle)
  (source "time_zero_lists.sv" #"
        module Top;
            logic [3:0] a, b;
            logic [3:0] y, z;
            always @(a or b) y = a + 4'd1;
            always @(a) z = a + b + 4'd2;
            initial begin
                b = 4'd5;
                #1 $display("%0d %0d", y, z);
                $finish;
            end
        endmodule
    "#)
  (top Top)
  (run_to_finish)
  (expect_output "1 7\n"))

; A sensitivity list that covers every bit its statement reads, through
; part-selects narrower than the variables, simulates like `always @*` when
; running the statement more often is unobservable: no side effects, no
; feedback, and each variable stored at most once per run (#2079). The
; untimed harness builds a `Simulator`, which runs no processes.
(case covering_sensitivity_lists_settle_like_a_wildcard
  (source "covering_lists.sv" #"
        module Top(input logic [7:0] x, input logic [3:0] s,
                   output logic [2:0] y, output logic [3:0] z);
            always @(x[2:0]) y = x[2:0] + 3'd1;
            always @(x[7:4] or s) begin
                case (s)
                    4'd0: z = x[7:4];
                    default: z = ~x[7:4];
                endcase
            end
        endmodule
    "#)
  (top Top)
  (modify (set x 0x15) (set s 0))
  (assert_eq y 6) (assert_eq z 1)
  (modify (set x 0x35))
  (assert_eq y 6) (assert_eq z 3)
  (modify (set x 0x36) (set s 1))
  (assert_eq y 7) (assert_eq z 0xc))

(case covering_sensitivity_lists_settle_like_a_wildcard_in_four_state
  (source "covering_lists.sv" #"
        module Top(input logic [7:0] x, input logic [3:0] s,
                   output logic [2:0] y, output logic [3:0] z);
            always @(x[2:0]) y = x[2:0] + 3'd1;
            always @(x[7:4] or s) begin
                case (s)
                    4'd0: z = x[7:4];
                    default: z = ~x[7:4];
                endcase
            end
        endmodule
    "#)
  (top Top)
  (four_state)
  (modify (set x 0x15) (set s 0))
  (assert_eq y 6) (assert_eq z 1)
  (modify (set x 0x35))
  (assert_eq y 6) (assert_eq z 3)
  (modify (set x 0x36) (set s 1))
  (assert_eq y 7) (assert_eq z 0xc))

; A block with a covering list that stores a variable twice per run stays a
; process: run on a change of an unlisted bit, it would pulse `p` and wake
; the edge waiter (4.3, 9.4.2).
(case multi_store_blocks_with_covering_lists_stay_processes
  (source "multi_store_list.sv" #"
        module Top;
            logic [7:0] x;
            logic p;
            int n;
            always @(x[0]) begin
                p = 1'b0;
                if (x[0]) p = 1'b1;
            end
            initial n = 0;
            always @(posedge p) n = n + 1;
            initial begin
                x = 8'h15;
                #1 $display("%b %0d", p, n);
                x = 8'h35;
                #1 $display("%b %0d", p, n);
                x = 8'h36;
                #1 $display("%b %0d", p, n);
                $finish;
            end
        endmodule
    "#)
  (top Top)
  (run_to_finish)
  (expect_output "1 1\n1 1\n0 1\n"))

