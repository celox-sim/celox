(group indexed_select (category arrays))

(case indexed_select_reads_and_writes_both_declaration_directions
  (source "indexed_directions.sv" #"
                module Top(input logic [15:0] data, input logic [3:0] replacement,
                           output logic [3:0] down_plus, down_minus, up_plus, up_minus,
                           output logic [15:0] down_written, output logic [0:15] up_written);
                    logic [0:15] up;
                    assign up = data;
                    assign down_plus = data[4 +: 4];
                    assign down_minus = data[7 -: 4];
                    assign up_plus = up[4 +: 4];
                    assign up_minus = up[7 -: 4];
                    always_comb begin
                        down_written = data;
                        down_written[4 +: 4] = replacement;
                        down_written[15 -: 4] = replacement;
                        up_written = data;
                        up_written[4 +: 4] = replacement;
                        up_written[15 -: 4] = replacement;
                    end
                endmodule
            "#)
  (top Top)
  (modify
    (set data 0x1234)
    (set replacement 0xa))
  (assert_eq down_plus 3)
  (assert_eq down_minus 3)
  (assert_eq up_plus 2)
  (assert_eq up_minus 2)
  (assert_eq down_written 0xa2a4)
  (assert_eq up_written 0x1a3a))

(case indexed_select_parameterized_generate_and_ff
  (source "indexed_generate.sv" #"
                module Top #(parameter int WIDTH = 4)(input logic clk,
                    input logic [4*WIDTH-1:0] data, output logic [4*WIDTH-1:0] comb, q,
                    output logic [3:0] selected_size);
                    for (genvar i = 0; i < 4; i++) begin : lanes
                        assign comb[i*WIDTH +: WIDTH] = data[(3-i)*WIDTH +: WIDTH];
                        always_ff @(posedge clk) q[i*WIDTH +: WIDTH] <= data[i*WIDTH +: WIDTH];
                    end
                    localparam SELECTED_SIZE = $size(data[WIDTH +: WIDTH]);
                    assign selected_size = SELECTED_SIZE;
                endmodule
            "#)
  (top Top)
  (modify (set data 0x1234))
  (assert_eq comb 0x4321)
  (assert_eq selected_size 4)
  (tick clk)
  (assert_eq q 0x1234)
  (modify (set data 0xabcd))
  (assert_eq q 0x1234)
  (tick clk)
  (assert_eq q 0xabcd))

(case indexed_select_preserves_selected_and_cast_bases
  (source "indexed_base_expression.sv" #"
                module Top #(parameter logic [3:0] BASE = 4'b1010)(
                    input logic [15:0] data, input logic [3:0] replacement,
                    output logic [3:0] bit_base, range_base, cast_base, minus_base,
                    output logic [15:0] continuous_written, procedural_written);
                    typedef logic [3:0] nibble;
                    assign bit_base = data[BASE[0] +: 4];
                    assign range_base = data[BASE[1:0] +: 4];
                    assign cast_base = data[(nibble'(20) + 0) +: 4];
                    assign minus_base = data[(BASE[0] + 3) -: 4];
                    assign continuous_written[nibble'(4) +: 4] = replacement;
                    assign continuous_written[15:8] = data[15:8];
                    assign continuous_written[3:0] = data[3:0];
                    always_comb begin
                        procedural_written = data;
                        procedural_written[BASE[0] +: 4] = replacement;
                    end
                endmodule
            "#)
  (top Top)
  (for value (list 0x00ff 0x1234 0xabcd)
    (modify
      (set data value)
      (set replacement 9))
    (assert_eq bit_base (& value 15))
    (assert_eq range_base (& (>> value 2) 15))
    (assert_eq cast_base (& (>> value 4) 15))
    (assert_eq minus_base (& value 15))
    (assert_eq continuous_written (| (& value 0xff0f) 0x90))
    (assert_eq procedural_written (| (& value 0xfff0) 9))))

(case indexed_widths_preserve_parameter_selections
  (source "selected_widths.sv" #"
                module Top(input logic [15:0] data, output logic [15:0] plus, minus, compound, cast_width, written);
                    localparam logic [3:0] W = 4'b1010;
                    typedef logic [3:0] nibble;
                    assign plus = data[0 +: W[1:0]];
                    assign minus = data[3 -: W[1:0]];
                    assign compound = data[0 +: (W[1:0] + 1)];
                    assign cast_width = data[0 +: nibble'(W[1:0])];
                    always_comb begin
                        written = data;
                        written[4 +: W[1:0]] = '1;
                    end
                endmodule
            "#)
  (top Top)
  (for value (list 0x1234 0xabcd 0xffff)
    (modify (set data value))
    (assert_eq plus (& value 3))
    (assert_eq minus (& (>> value 2) 3))
    (assert_eq compound (& value 7))
    (assert_eq cast_width (& value 3))
    (assert_eq written (| value 0x30))))

(case indexed_compound_bases_fold_selected_operands
  (source "compound_bases.sv" #"
                module Top(input logic [15:0] data, output logic [3:0] selected, concatenated, nested,
                    output logic [15:0] written);
                    localparam logic [3:0] BASE = 4'b1010;
                    localparam logic [3:0] IDX = 4'b0010;
                    assign nested = data[(BASE[IDX[0] +: 2] + 1) +: 4];
                    assign selected = data[(BASE[1:0] + 1) +: 4];
                    assign concatenated = data[({1'b0, BASE[1:0]} + 1) +: 4];
                    assign written[(BASE[1:0] + 1) +: 4] = 4'hf;
                    assign written[2:0] = data[2:0];
                    assign written[15:7] = data[15:7];
                endmodule
            "#)
  (top Top)
  (modify (set data 0x1234))
  (assert_eq selected 6)
  (assert_eq concatenated 6)
  (assert_eq nested 6)
  (assert_eq written 0x127c))

(case indexed_constants_respect_declared_parameter_indices
  (source "parameter_indices.sv" #"
                module Top(input logic [15:0] data, output logic [3:0] down, up,
                    output logic [15:0] selected_width, written);
                    localparam logic [7:4] BASE = 4'b0001;
                    localparam logic [4:7] UP = 4'b0001;
                    localparam logic [7:4] W = 4'b1010;
                    assign down = data[BASE[4] +: 4];
                    assign up = data[UP[7] +: 4];
                    assign selected_width = data[BASE[4] +: W[5:4]];
                    assign written[BASE[4] +: 4] = 4'hf;
                    assign written[0] = data[0];
                    assign written[15:5] = data[15:5];
                endmodule
            "#)
  (top Top)
  (modify (set data 0x1234))
  (assert_eq down 10)
  (assert_eq up 10)
  (assert_eq selected_width 2)
  (assert_eq written 0x123e))

(case indexed_functions_preserve_selected_arguments
  (source "indexed_functions.sv" #"
                module Top(input logic [15:0] data, output logic [15:0] width,
                    nested_width, offset_width, output logic [3:0] base);
                    localparam logic [3:0] W = 4'b1011;
                    localparam logic [7:4] OFFSET = 4'b1011;
                    assign width = data[0 +: $clog2(W[1:0])];
                    assign nested_width = data[0 +: $clog2($countones({W[1:0], 2'b11}))];
                    assign offset_width = data[0 +: $clog2(OFFSET[5:4])];
                    assign base = data[$clog2(W[1:0]) +: 4];
                endmodule
            "#)
  (top Top)
  (modify (set data 0x123f))
  (assert_eq width 3)
  (assert_eq nested_width 3)
  (assert_eq offset_width 3)
  (assert_eq base 15))

(case indexed_ternaries_preserve_both_arm_types
  (source "indexed_ternaries.sv" #"
                module Top(input logic [15:0] data, output logic [3:0] true_base,
                    false_base, output logic [15:0] width);
                    localparam logic [3:0] W = 4'b1011;
                    assign true_base = data[((1 ? W[1:0] : 8'b0) + 2'd1) +: 4];
                    assign false_base = data[((0 ? 8'b0 : W[1:0]) + 2'd1) +: 4];
                    assign width = data[0 +: ((1 ? W[1:0] : 8'b0) + 2'd1)];
                endmodule
            "#)
  (top Top)
  (modify (set data 0x1234))
  (assert_eq true_base 3)
  (assert_eq false_base 3)
  (assert_eq width 4))

; IEEE 1800-2023 11.5.1 and 7.4.1: use declared indices, retain
; the selected width, and make packed part-selects unsigned.
(case constant_parameter_initializers_preserve_inferred_dimensions
  ; IEEE 1800-2023 6.20.2: an implicit integral parameter inherits
  ; the value's size and has the implied packed range [size-1:0].
  (source "inferred_parameter_selections.sv" #"
    module Child #(parameter W = 18, parameter N = W[3:0])(
        output logic [3:0] y, output int width);
      assign y = N;
      assign width = $bits(N);
    endmodule
    module Top(output logic [3:0] default_y, output logic [3:0] overridden_y,
               output int width);
      int default_width, overridden_width;
      Child a(default_y, default_width);
      Child #(.W(35)) b(overridden_y, overridden_width);
      assign width = default_width + overridden_width;
    endmodule
  "#)
  (top Top)
  (assert_eq default_y 2)
  (assert_eq overridden_y 3)
  (assert_eq width 8))

(case constant_parameter_initializers_short_circuit_wide_operands
  ; IEEE 1800-2023 11.3.5: logical operands that cannot affect the
  ; result are not evaluated. Keep shared literals within external limits.
  (source "short_circuit_parameter_operands.sv" #"
    module Top(output logic [2:0] checks, output int width);
      parameter FLAG = 0;
      localparam A = 0 && 65536'd0;
      localparam B = 1 || 65536'd0;
      localparam C = FLAG && 65536'd0;
      assign checks = {A === 1'b0, B === 1'b1, C === 1'b0};
      assign width = $bits(A) + $bits(B) + $bits(C);
    endmodule
  "#)
  (top Top)
  (assert_eq checks 7)
  (assert_eq width 3))

(case constant_parameter_initializers_short_circuit_repetitions_and_selections
  ; Keep computed widths above Celox's materialization limit, but small
  ; enough for independent simulators. IEEE 1800-2023 Table 11-2: ** is left-associative.
  (source "short_circuit_repetitions_and_selections.sv" #"
    module Top(output logic [5:0] checks, output int width);
      localparam logic [3:4] UP = 2'b10;
      localparam logic [4:3] DOWN = 2'b10;
      localparam A = 0 && {65537{1'b0}};
      localparam B = 1 || {65537{1'b0}};
      localparam C = UP[3] || {65537{1'b0}};
      localparam D = DOWN[3] && {65537{1'b0}};
      localparam E = ((2 ** 3 ** 2) == 512) && {65537{1'b0}};
      localparam F = ((2 ** (3 ** 2)) == 512) || {65537{1'b0}};
      assign checks = {A === 1'b0, B === 1'b1, C === 1'b1,
                       D === 1'b0, E === 1'b0, F === 1'b1};
      assign width = $bits(A) + $bits(B) + $bits(C) + $bits(D) + $bits(E) + $bits(F);
    endmodule
  "#)
  (top Top)
  (assert_eq checks 63)
  (assert_eq width 6))

(case constant_parameter_initializers_short_circuit_four_state_bindings
  ; IEEE 1800-2023 11.3.5: X/Z combined with a deciding logical
  ; operand produces a known truth value before the wide operand.
  ; Cross Celox's 65536-bit materialization guard without evaluating it.
  (four_state)
  (source "short_circuit_four_state_bindings.sv" #"
    package flags;
      localparam IMPORTED_X = 1'bx;
      localparam IMPORTED_Z = 1'bz;
    endpackage
    module Top(output logic [5:0] checks, output int width);
      import flags::*;
      localparam FLAG = 1'bx;
      localparam ZFLAG = 1'bz;
      localparam A = FLAG && 0 && 65537'd0;
      localparam B = FLAG || 1 || 65537'd0;
      localparam C = ZFLAG && 0 && 65537'd0;
      localparam D = ZFLAG || 1 || 65537'd0;
      localparam E = IMPORTED_X && 0 && 65537'd0;
      localparam F = IMPORTED_Z || 1 || 65537'd0;
      assign checks = {A === 1'b0, B === 1'b1, C === 1'b0,
                       D === 1'b1, E === 1'b0, F === 1'b1};
      assign width = $bits(A) + $bits(B) + $bits(C) + $bits(D) + $bits(E) + $bits(F);
    endmodule
  "#)
  (top Top)
  (assert_eq checks 63)
  (assert_eq width 6))

(case constant_parameter_initializers_preserve_selections
  (source "constant_parameter_selections.sv" #"
    module Top(output int n, down, up, negative, shifted, width, cast_value,
               function_value, sum, implicit_sum, known_low);
      parameter logic [31:0] W = 18;
      parameter logic [11:4] D = 8'hab;
      parameter logic [4:11] U = 8'hab;
      parameter logic [-1:-8] NEG = 8'hab;
      parameter logic signed [7:0] S = -2;
      parameter logic [7:0] FULL = 8'hff;
      parameter logic [7:0] X = 8'hxa;
      localparam N = W[3:0] + 1;
      localparam DOWN = D[7:4];
      localparam UP = U[8:11];
      localparam NEGATIVE = NEG[-5:-8];
      localparam SHIFTED = S[7:0] >> 1;
      localparam WIDTH = $bits(DOWN);
      localparam CAST_VALUE = int'(D[7:4]) + 1;
      localparam FUNCTION_VALUE = $clog2(D[11:8]);
      localparam logic [7:0] SUM = FULL[3:0] + 4'd1;
      localparam IMPLICIT_SUM = FULL[3:0] + 4'd1;
      localparam KNOWN_LOW = X[3:0];
      assign n = N;
      assign down = DOWN;
      assign up = UP;
      assign negative = NEGATIVE;
      assign shifted = SHIFTED;
      assign width = WIDTH;
      assign cast_value = CAST_VALUE;
      assign function_value = FUNCTION_VALUE;
      assign sum = SUM;
      assign implicit_sum = IMPLICIT_SUM;
      assign known_low = KNOWN_LOW;
    endmodule
  "#)
  (top Top)
  (assert_eq n 3)
  (assert_eq down 11)
  (assert_eq up 11)
  (assert_eq negative 11)
  (assert_eq shifted 127)
  (assert_eq width 4)
  (assert_eq cast_value 12)
  (assert_eq function_value 4)
  (assert_eq sum 16)
  (assert_eq implicit_sum 0)
  (assert_eq known_low 10))

(case constant_parameter_initializers_preserve_imported_shapes
  (source "imported_parameter_selections.sv" #"
    package cfg;
      parameter logic [11:4] D = 8'hab;
      parameter logic [4:11] U = 8'hab;
      parameter logic [11:4] X = 8'hxa;
    endpackage
    package other;
      parameter logic [7:0] D = 8'hcd;
      parameter Q = 8'hxa;
      parameter P = Q;
    endpackage
    module Child #(parameter N = cfg::D[7:4])(output logic [3:0] value);
      assign value = N;
    endmodule
    module Shadow(output logic [3:0] value);
      import cfg::*;
      localparam D = 8'hab;
      localparam N = D[3:0];
      assign value = N;
    endmodule
    module Top(output int down, up, qualified, header, shadow, known_low, width,
               generated, generated_dependency);
      import cfg::*;
      localparam DOWN = D[7:4];
      localparam UP = U[8:11];
      localparam QUALIFIED = cfg::D[7:4];
      localparam KNOWN_LOW = X[7:4];
      localparam WIDTH = $bits(DOWN);
      assign down = DOWN;
      assign up = UP;
      assign qualified = QUALIFIED;
      assign known_low = KNOWN_LOW;
      assign width = WIDTH;
      Child child(.value(header));
      Shadow local_shadow(.value(shadow));
      if (1) begin : local_import
        import other::D;
        localparam N = D[7:4];
        assign generated = N;
      end
      if (1) begin : dependent_import
        import other::P;
        localparam N = P[3:0];
        assign generated_dependency = N;
      end
    endmodule
  "#)
  (top Top)
  (assert_eq down 11)
  (assert_eq up 11)
  (assert_eq qualified 11)
  (assert_eq header 11)
  (assert_eq shadow 11)
  (assert_eq known_low 10)
  (assert_eq generated 12)
  (assert_eq generated_dependency 10)
  (assert_eq width 4))

(case constant_parameter_initializers_preserve_overhanging_parts
  ; These comparisons require the X bits specified by IEEE 1800-2023
  ; 11.5.1, including overhanging indexed part-selects and X/Z bases.
  (four_state)
  (source "overhanging_parameter_selections.sv" #"
    module Top(output logic [12:0] checks, output int width);
      parameter logic [7:0] W = 8'hab;
      parameter bit [7:0] B = 8'hab;
      parameter logic [11:4] D = 8'hab;
      parameter logic [4:11] U = 8'hab;
      localparam ABOVE = W[8:5];
      localparam BELOW = W[2:-1];
      localparam PLUS = W[6 +: 4];
      localparam MINUS = W[1 -: 4];
      localparam OUTSIDE = W[12:9];
      localparam OFFSET = D[12:9];
      localparam UP = U[3:6];
      localparam BIT_ABOVE = B[8:5];
      localparam BIT_PLUS = B[6 +: 4];
      localparam X_PLUS = W[1'bx +: 2];
      localparam Z_MINUS = B[1'bz -: 3];
      localparam X_UP = U[1'bx +: 4];
      localparam KNOWN = W[(1'bx === 1'bx) +: 2];
      assign checks = {ABOVE === 4'bx101, BELOW === 4'b011x,
        PLUS === 4'bxx10, MINUS === 4'b11xx, OUTSIDE === 4'bxxxx,
        OFFSET === 4'bx101, UP === 4'bx101,
        BIT_ABOVE === 4'bx101, BIT_PLUS === 4'bxx10,
        X_PLUS === 2'bxx, Z_MINUS === 3'bxxx, X_UP === 4'bxxxx,
        KNOWN === 2'b01};
      assign width = $bits(ABOVE);
    endmodule
  "#)
  (top Top)
  (assert_eq checks 8191)
  (assert_eq width 4))

(case constant_parameter_initializers_preserve_unknown_indices
  ; IEEE 1800-2023 11.5.1: X/Z indices yield X for four-state values
  ; and zero for two-state values, with the selected element's width.
  (four_state)
  (source "unknown_parameter_indices.sv" #"
    module Top(output logic [9:0] checks, output int width, output int indexed_width);
      parameter logic [1:0][7:4] W = 8'hab;
      parameter bit [1:0][7:4] B = 8'hab;
      localparam IDX = 1'bz;
      localparam OUTER = W[1'bx][5];
      localparam INNER = W[1][1'bz];
      localparam PART = W[IDX][7:4];
      localparam MASKED = W[1'bx & 1'b0][4];
      localparam KNOWN = W[1'bx === 1'bx][4];
      localparam ZERO = B[1'bx][5];
      localparam PLUS = W[1][1'bx +: 2];
      localparam MINUS = W[0][IDX -: 2];
      localparam OUTER_PLUS = W[IDX +: 1];
      localparam MASKED_PART = W[0][(1'bx & 1'b0) + 4 +: 2];
      assign checks = {OUTER === 1'bx, INNER === 1'bx,
        PART === 4'bxxxx, MASKED === 1'b1, KNOWN === 1'b0,
        ZERO === 1'b0, PLUS === 2'bxx, MINUS === 2'bxx,
        OUTER_PLUS === 4'bxxxx, MASKED_PART === 2'b11};
      assign width = $bits(PART);
      assign indexed_width = $bits(PLUS) + $bits(MINUS) + $bits(OUTER_PLUS);
    endmodule
  "#)
  (top Top)
  (assert_eq checks 1023)
  (assert_eq width 4)
  (assert_eq indexed_width 8))

(case constant_parameter_initializers_shape_ports_and_generate
  (source "constant_parameter_widths.sv" #"
    module Child #(parameter logic [31:0] W = 18,
                   parameter N = W[3:0] + 1)(
        input logic [N-1:0] data, output logic [N-1:0] y,
        output int width);
      assign width = $bits(y);
      for (genvar i = 0; i < N; i++) begin : lanes
        assign y[i] = data[N-1-i];
      end
    endmodule
    module Top(input logic [4:0] data, output logic [2:0] default_y,
               output logic [4:0] specialized_y, output int default_width,
               specialized_width, query_width);
      localparam QUERY_WIDTH = $bits(65536'd0);
      assign query_width = QUERY_WIDTH;
      Child defaults(.data(data[2:0]), .y(default_y), .width(default_width));
      Child #(.W(20)) specialized(.data(data), .y(specialized_y),
                                 .width(specialized_width));
    endmodule
  "#)
  (top Top)
  (assert_eq default_width 3)
  (assert_eq query_width 65536)
  (assert_eq specialized_width 5)
  (for value (list 0 1 0x12 0x1f)
    (modify (set data value))
    (let reversed (| (<< (& value 1) 4) (<< (& value 2) 2)
                     (& value 4) (>> (& value 8) 2) (>> (& value 16) 4)))
    (assert_eq default_y (>> reversed 2))
    (assert_eq specialized_y reversed)))

(case indexed_parameter_initializers_preserve_selections
  (source "indexed_parameters.sv" #"
                module Top(output logic [3:0] plus, minus, compound, ascending, function_width,
                    default_q, specialized_q);
                    localparam logic [7:0] P = 8'hab;
                    localparam logic [4:11] UP = 8'hab;
                    localparam logic [3:0] Q = P[4 +: 4];
                    localparam logic [3:0] R = P[7 -: 4];
                    localparam logic [3:0] S = P[4 +: 4] + 4'd1;
                    localparam logic [3:0] T = UP[4 +: 4];
                    localparam logic [3:0] F = $clog2(P[4 +: 4]);
                    assign plus = Q;
                    assign minus = R;
                    assign compound = S;
                    assign ascending = T;
                    assign function_width = F;
                    Child default_child(.y(default_q));
                    Child #(.P(8'hcd)) specialized_child(.y(specialized_q));
                endmodule
                module Child #(parameter logic [7:0] P = 8'hab,
                    parameter logic [3:0] Q = P[4 +: 4])(output logic [3:0] y);
                    assign y = Q;
                endmodule
            "#)
  (top Top)
  (assert_eq plus 10)
  (assert_eq minus 10)
  (assert_eq compound 11)
  (assert_eq ascending 10)
  (assert_eq function_width 4)
  (assert_eq default_q 10)
  (assert_eq specialized_q 12))

(case indexed_parameter_initializers_use_assignment_width
  (source "indexed_assignment_context.sv" #"
                module Top(output logic [7:0] sum, shifted, nested, mux,
                    output logic [3:0] narrow, implicit_value);
                    localparam logic [7:0] P = 8'hff;
                    localparam logic [7:0] Q = P[0 +: 4] + 4'd1;
                    localparam logic [7:0] R = P[0 +: 4] << 1;
                    localparam logic [7:0] S = (P[0 +: 4] + 4'd1) + 4'd1;
                    localparam logic [7:0] T = 1 ? P[0 +: 4] + 4'd1 : 4'd0;
                    localparam logic [3:0] N = P[0 +: 4] + 4'd1;
                    localparam I = P[0 +: 4] + 4'd1;
                    assign sum = Q;
                    assign shifted = R;
                    assign nested = S;
                    assign mux = T;
                    assign narrow = N;
                    assign implicit_value = I;
                endmodule
            "#)
  (top Top)
  (assert_eq sum 16)
  (assert_eq shifted 30)
  (assert_eq nested 17)
  (assert_eq mux 16)
  (assert_eq narrow 0)
  (assert_eq implicit_value 0))

(case indexed_parameter_initializers_resolve_enum_constants
  (source "indexed_enum_context.sv" #"
                module Top(output logic [3:0] base, width, arithmetic, enum_dependent);
                    localparam logic [7:0] P = 8'hab;
                    typedef enum logic [2:0] { E = 3'd4 } idx_t;
                    localparam logic [3:0] Q = P[E +: 4];
                    localparam logic [3:0] R = P[4 +: E];
                    localparam logic [3:0] S = P[E +: E] + 4'd1;
                    assign base = Q;
                    assign width = R;
                    assign arithmetic = S;
                    localparam logic [11:4] OFFSET_P = 8'hab;
                    localparam logic [3:0] OFFSET_Q = OFFSET_P[(E + 4) +: 4];
                    typedef enum logic [3:0] { F = OFFSET_Q } value_t;
                    assign enum_dependent = F;
                endmodule
            "#)
  (top Top)
  (assert_eq base 10)
  (assert_eq width 10)
  (assert_eq arithmetic 11)
  (assert_eq enum_dependent 10))

(case indexed_parameter_ports_preserve_declared_ranges
  (source "indexed_port_ranges.sv" #"
                module Top(output logic [3:0] down, up, specialized, header);
                    Child default_child(.down(down), .up(up), .header(header));
                    Child #(.P(8'hcd)) specialized_child(.down(specialized), .up(), .header());
                endmodule
                module Child #(parameter logic [11:4] P = 8'hab,
                    logic [4:11] U = 8'hab, parameter logic [3:0] H = P[8 +: 4])(
                    output logic [3:0] down, up, header);
                    localparam logic [3:0] Q = P[8 +: 4];
                    localparam logic [3:0] R = U[4 +: 4];
                    assign down = Q;
                    assign up = R;
                    assign header = H;
                endmodule
            "#)
  (top Top)
  (assert_eq down 10)
  (assert_eq up 10)
  (assert_eq specialized 12)
  (assert_eq header 10))

(case indexed_bases_resolve_size_queries
  (source "indexed_size_queries.sv" #"
                module Top(input logic [15:0] data, output logic [3:0] bits_base,
                    size_base, selected_base, type_base);
                    typedef logic [7:0] octet;
                    assign bits_base = data[$bits(data)/2 +: 4];
                    assign size_base = data[$size(data)/2 +: 4];
                    assign selected_base = data[$bits(data[7:0]) +: 4];
                    assign type_base = data[$bits(octet) +: 4];
                endmodule
            "#)
  (top Top)
  (modify (set data 0xabcd))
  (expand name (bits_base size_base selected_base type_base)
    (assert_eq {name} 11)))

(case indexed_initializers_preserve_four_state_parameters
  (source "indexed_four_state_parameters.sv" #"
                module Top(output logic [3:0] low, high, port_value,
                    output logic [7:0] sum);
                    localparam logic [7:0] P = 8'hxa;
                    localparam logic [11:4] Z = 8'haz;
                    localparam logic [3:0] Q = P[0 +: 4];
                    localparam logic [3:0] R = Z[8 +: 4];
                    localparam logic [7:0] S = P[0 +: 4] + 4'd6;
                    assign low = Q;
                    assign high = R;
                    assign sum = S;
                    Child child(.y(port_value));
                endmodule
                module Child #(parameter logic [11:4] P = 8'hxa,
                    parameter logic [3:0] Q = P[4 +: 4])(output logic [3:0] y);
                    assign y = Q;
                endmodule
            "#)
  (top Top)
  (assert_eq low 10)
  (assert_eq high 10)
  (assert_eq port_value 10)
  (assert_eq sum 16))

(case indexed_initializers_accept_casts_around_selections
  (source "indexed_initializer_casts.sv" #"
                module Top(input logic [15:0] data, output int integer_value, nested_value, function_value,
                    output logic [3:0] alias_value, output logic [7:0] arithmetic,
                    output logic [15:0] cast_width);
                    typedef logic [3:0] nibble;
                    localparam logic [7:0] P = 8'hab;
                    localparam int Q = int'(P[0 +: 4]);
                    localparam nibble R = nibble'(P[4 +: 4]);
                    localparam int S = int'(nibble'(P[4 +: 4]));
                    localparam logic [7:0] T = 8'(P[0 +: 4]) + 8'd5;
                    localparam int F = $clog2(int'(P[0 +: 4]));
                    assign integer_value = Q;
                    assign alias_value = R;
                    assign nested_value = S;
                    assign arithmetic = T;
                    assign function_value = F;
                    assign cast_width = data[0 +: int'(P[4 +: 4])];
                endmodule
            "#)
  (top Top)
  (modify (set data 0x1234))
  (assert_eq integer_value 11)
  (assert_eq alias_value 10)
  (assert_eq nested_value 10)
  (assert_eq arithmetic 16)
  (assert_eq function_value 4)
  (assert_eq cast_width 0x234))

(case indexed_size_queries_preserve_parameter_dimensions
  (source "indexed_parameter_size_queries.sv" #"
                module Top #(parameter logic [1:0][3:0] P = 8'hab,
                    parameter logic [2:1][7:4] OFFSET = 8'hab,
                    parameter logic [1:2][4:7] UP = 8'hab)(input logic [15:0] data,
                    output logic [3:0] size_base, bits_base, offset_base, up_base, outer_base, whole_base,
                    output logic [7:0] size_width, bits_width,
                    output int packed_down, packed_up, outer_down, outer_up,
                        selected_bit, selected_width, invalid_width,
                        signed_value, signed_sum, unsigned_part,
                    output logic [2:0] invalid_is_x, output logic [1:0] overhang_checks);
                    typedef logic signed [3:0] nibble_t;
                    parameter nibble_t [1:0][1:0] SIGNED = '1;
                    assign size_base = data[$size(P[0]) +: 4];
                    assign bits_base = data[$bits(P[0]) +: 4];
                    assign offset_base = data[$size(OFFSET[1]) +: 4];
                    assign up_base = data[$bits(UP[2]) +: 4];
                    assign outer_base = data[$size(P) +: 4];
                    assign whole_base = data[$bits(P) +: 4];
                    assign size_width = data[0 +: $size(P[0])];
                    assign bits_width = data[0 +: $bits(OFFSET[1])];
                    // Icarus already excludes this case because its packed
                    // array parameters are unsupported. Keep those selections
                    // here so ordinary vector selections remain portable.
                    localparam PACKED_DOWN = OFFSET[1][7:4];
                    localparam PACKED_UP = UP[2][4:7];
                    localparam OUTER_DOWN = OFFSET[2:2];
                    localparam OUTER_UP = UP[1:1];
                    localparam SELECTED_BIT = OFFSET[1][5];
                    localparam SELECTED_WIDTH = $bits(PACKED_DOWN);
                    localparam INVALID_OUTER = OFFSET[3][5];
                    localparam INVALID_INNER = OFFSET[1][8];
                    localparam INVALID_ELEMENT = OFFSET[3];
                    localparam INVALID_WIDTH = $bits(INVALID_OUTER);
                    localparam SIGNED_VALUE = SIGNED[0][0];
                    localparam SIGNED_SUM = SIGNED[0][0] + 1;
                    localparam UNSIGNED_PART = SIGNED[0][0][3:0];
                    localparam INNER_OVERHANG = OFFSET[1][8:5];
                    localparam OUTER_OVERHANG = OFFSET[3:2];
                    assign packed_down = PACKED_DOWN;
                    assign packed_up = PACKED_UP;
                    assign outer_down = OUTER_DOWN;
                    assign outer_up = OUTER_UP;
                    assign selected_bit = SELECTED_BIT;
                    assign selected_width = SELECTED_WIDTH;
                    assign invalid_is_x = {INVALID_OUTER === 1'bx,
                        INVALID_INNER === 1'bx, INVALID_ELEMENT === 4'bxxxx};
                    assign invalid_width = INVALID_WIDTH;
                    assign signed_value = SIGNED_VALUE;
                    assign signed_sum = SIGNED_SUM;
                    assign unsigned_part = UNSIGNED_PART;
                    assign overhang_checks = {INNER_OVERHANG === 4'bx101,
                        OUTER_OVERHANG === 8'bxxxx1010};
                endmodule
            "#)
  (top Top)
  (modify (set data 0x1234))
  (expand name (size_base bits_base offset_base up_base)
    (assert_eq {name} 3))
  (assert_eq outer_base 13)
  (assert_eq whole_base 2)
  (assert_eq size_width 4)
  (assert_eq bits_width 4)
  (assert_eq packed_down 11)
  (assert_eq packed_up 11)
  (assert_eq outer_down 10)
  (assert_eq outer_up 10)
  (assert_eq selected_bit 1)
  (assert_eq selected_width 4)
  (assert_eq invalid_is_x 7)
  (assert_eq invalid_width 1)
  (assert_eq signed_value (trunc 32 -1))
  (assert_eq signed_sum 0)
  (assert_eq unsigned_part 15)
  (assert_eq overhang_checks 3))

(case indexed_widths_accept_replication_concatenations
  (source "indexed_replication_widths.sv" #"
                module Top(input logic [15:0] data, output logic [15:0] simple,
                    parts, nested, selected_count);
                    localparam logic [3:0] COUNT = 4'b1010;
                    assign simple = data[0 +: {2{1'b1}}];
                    assign parts = data[0 +: {2{1'b0, 1'b1}}];
                    assign nested = data[0 +: {2{{2{1'b1}}}}];
                    assign selected_count = data[0 +: {COUNT[1:0]{1'b1}}];
                endmodule
            "#)
  (top Top)
  (modify (set data 0x123f))
  (assert_eq simple 7)
  (assert_eq parts 31)
  (assert_eq nested 0x123f)
  (assert_eq selected_count 7))

(case indexed_constants_work_in_ordinary_selection_indices
  (source "indexed_ordinary_indices.sv" #"
                module Top(input logic [7:0] data, input logic replacement,
                    output logic direct_bit, compound_bit, concat_bit, repeated_bit,
                    output logic [1:0] range_value, repeated_value,
                    output logic [7:0] net_written, procedural_written);
                    localparam logic [7:4] P = 4'b1010;
                    assign direct_bit = data[P[4 +: 2]];
                    assign compound_bit = data[P[4 +: 2] + 1];
                    assign concat_bit = {4'b0, data}[P[4 +: 2]];
                    assign repeated_bit = {2{data}}[P[4 +: 2]];
                    assign range_value = data[P[4 +: 2] + 1:P[4 +: 2]];
                    assign repeated_value = {P[4 +: 2]{1'b1}};
                    assign net_written[1:0] = data[1:0];
                    assign net_written[P[4 +: 2]] = replacement;
                    assign net_written[7:3] = data[7:3];
                    always_comb begin
                        procedural_written = data;
                        procedural_written[P[4 +: 2]] = replacement;
                    end
                endmodule
            "#)
  (top Top)
  (modify
    (set data 0xa4)
    (set replacement 0))
  (expand name (direct_bit concat_bit repeated_bit)
    (assert_eq {name} 1))
  (assert_eq compound_bit 0)
  (assert_eq range_value 1)
  (assert_eq repeated_value 3)
  (expand name (net_written procedural_written)
    (assert_eq {name} 0xa0)))

(case indexed_runtime_replications_preserve_attached_selections
  (source "indexed_runtime_replication.sv" #"
                module Top(input logic [7:0] data, output logic [15:0] plus, minus,
                    output logic [7:0] ordinary, output logic bit_value);
                    assign plus = {2{data}}[4 +: 12];
                    assign minus = {2{data}}[15 -: 12];
                    assign ordinary = {2{data}}[11:4];
                    assign bit_value = {2{data}}[8];
                endmodule
            "#)
  (top Top)
  (modify (set data 0xab))
  (assert_eq plus 0xaba)
  (assert_eq minus 0xaba)
  (assert_eq ordinary 0xba)
  (assert_eq bit_value 1))

(case indexed_generate_parameters_retain_local_metadata
  (source "indexed_generate_metadata.sv" #"
                module Top #(parameter logic [3:0] BASE = 4'd2)(input logic [15:0] data,
                    output logic [3:0] down, up, masked, derived, outer,
                    output logic [7:0] loop_value);
                    if (1) begin : selected
                        localparam logic [7:4] BASE = 4'b0001;
                        localparam logic [4:7] UP = 4'b0001;
                        localparam logic [7:4] MASK = 4'bx001;
                        localparam logic [3:0] Q = MASK[4 +: 3];
                        assign down = data[BASE[4] +: 4];
                        assign up = data[UP[7] +: 4];
                        assign masked = data[MASK[4] +: 4];
                        assign derived = data[Q +: 4];
                    end
                    for (genvar i = 0; i < 2; i++) begin : lanes
                        localparam logic [7:4] LOCAL_BASE = i + 1;
                        assign loop_value[i*4 +: 4] = data[LOCAL_BASE[4 +: 4] +: 4];
                    end
                    assign outer = data[BASE +: 4];
                endmodule
            "#)
  (top Top)
  (modify (set data 0x1234))
  (expand name (down up masked derived)
    (assert_eq {name} 10))
  (assert_eq outer 13)
  (assert_eq loop_value 0xda))

(case indexed_constants_lower_selected_concatenations
  (source "indexed_selected_concatenations.sv" #"
                module Top(input logic [15:0] data, output logic [15:0] range_width,
                    indexed_width, repeated_width, repeated_indexed_width, bit_width,
                    output logic [3:0] parameter_value);
                    localparam logic [3:0] Q = {4'b0011, 4'b0000}[4 +: 4];
                    assign range_width = data[0 +: {4'b0011, 4'b0000}[7:4]];
                    assign indexed_width = data[0 +: {4'b0011, 4'b0000}[4 +: 4]];
                    assign repeated_width = data[0 +: {2{4'b0011}}[3:0]];
                    assign repeated_indexed_width = data[0 +: {2{4'b0011}}[7 -: 4]];
                    assign bit_width = data[0 +: {1'b0, 1'b1}[0]];
                    assign parameter_value = Q;
                endmodule
            "#)
  (top Top)
  (modify (set data 0x123f))
  (expand name (range_width indexed_width repeated_width repeated_indexed_width)
    (assert_eq {name} 7))
  (assert_eq bit_width 1)
  (assert_eq parameter_value 3))

(case indexed_unsigned_bases_cross_zero
  (source "indexed_unsigned.sv" #"
                module Top(input logic [3:-4] data, output logic [3:0] minus, up_minus,
                    plus, wrapped_base, output logic [3:-4] written);
                    logic [-4:3] up;
                    assign up = data;
                    assign minus = data[32'd0 -: 4];
                    assign up_minus = up[32'd0 -: 4];
                    assign plus = data[(-3) +: 4];
                    assign wrapped_base = data[(2'd3 + 2'd1) +: 4];
                    always_comb begin
                        written = data;
                        written[32'd0 -: 4] = 4'hf;
                    end
                endmodule
            "#)
  (top Top)
  (modify (set data 0xa5))
  (assert_eq minus 2)
  (assert_eq up_minus 4)
  (assert_eq plus 2)
  (assert_eq wrapped_base 10)
  (assert_eq written 0xbf))

(case runtime_index_expressions_wrap_at_their_own_width
  ; A select index is evaluated in a self-determined context (IEEE 1800-2023
  ; 11.5.1, Table 11-21): `a + b` of one-bit operands is one bit wide and
  ; `j + 2'd1` two bits wide, while `j + 1` is at least 32 bits wide (its
  ; out-of-range value is left out: the simulators read it differently).
  (source "runtime_index_width.sv" #"
                module Top(input logic clk, input logic a, input logic b, input logic [1:0] j,
                           output logic [3:0] written, output logic bit_read,
                           output logic [1:0] part, output logic [7:0] element,
                           output logic [3:0] nibble, output logic [7:0] wide,
                           output logic [3:0] registered);
                    logic [3:0] source;
                    logic [7:0] mem [4];
                    logic [3:0][3:0] packed_;
                    always_comb begin
                        source = 4'b0110;
                        for (int e = 0; e < 4; e++) mem[e] = 8'(e + 1);
                        packed_ = 16'h4321;
                    end
                    always_comb begin
                        written = 4'd0;
                        written[a + b] = 1'b1;
                    end
                    assign bit_read = source[a + b];
                    assign part = source[a + b +: 2];
                    assign element = mem[j + 2'd1];
                    assign nibble = packed_[j + 2'd1];
                    assign wide = mem[j + 1];
                    always_ff @(posedge clk) begin
                        registered <= 4'd0;
                        registered[a + b] <= 1'b1;
                    end
                endmodule
            "#)
  (top Top)
  (for (x y row) (list (0 0 0) (1 0 1) (1 1 3) (0 1 2))
    (modify (set a x) (set b y) (set j row))
    (tick clk)
    (let sum (& (+ x y) 1))
    (assert_eq written (<< 1 sum))
    (assert_eq bit_read (& (>> 6 sum) 1))
    (assert_eq part (& (>> 6 sum) 3))
    (assert_eq element (+ (& (+ row 1) 3) 1))
    (assert_eq nibble (+ (& (+ row 1) 3) 1))
    (if (< row 3)
      (assert_eq wide (+ row 2)))
    (assert_eq registered (<< 1 sum))))

(case signed_index_expressions_wrap_at_their_own_width
  ; A signed index is evaluated at its own width too: `i >> 1` shifts zeros
  ; in from bit 1, and `-2 + -1` wraps to 1. (A negative index is left out:
  ; Verilator 5.052 selects bit 3 for -1.)
  (source "signed_index_width.sv" #"
                module Top(input logic signed [1:0] i, input logic signed [1:0] k,
                           output logic [3:0] shifted, output logic [3:0] sum_shifted,
                           output logic [3:0] sum);
                    always_comb begin
                        shifted = 4'd0;
                        shifted[i >> 1] = 1'b1;
                        sum_shifted = 4'd0;
                        sum_shifted[(i + k) >> 1] = 1'b1;
                        sum = 4'd0;
                        sum[i + k] = 1'b1;
                    end
                endmodule
            "#)
  (top Top)
  (modify (set i 3) (set k 0))
  (assert_eq shifted 2)
  (assert_eq sum_shifted 2)
  (modify (set i 2) (set k 3))
  (assert_eq shifted 2)
  (assert_eq sum_shifted 1)
  (assert_eq sum 2)
  (modify (set i 1) (set k 0))
  (assert_eq shifted 1)
  (assert_eq sum_shifted 1)
  (assert_eq sum 2))

(case runtime_indexed_base_may_select_a_parameter_bit
  (source "selected_runtime_base.sv" #"
                module Top #(parameter logic [3:0] BASE = 4'b1010)(
                    input logic [15:0] data, input logic index, output logic [3:0] y);
                    assign y = data[BASE[index] +: 4];
                endmodule
            "#)
  (top Top)
  (modify
    (set data 0xabcd)
    (set index 0))
  (assert_eq y 0xd)
  (modify (set index 1))
  (assert_eq y 0x6))

(case runtime_indexed_ff_write_updates_only_the_selected_slice
  (source "runtime_indexed_ff.sv" #"
                module Top(input logic clk, input logic [1:0] i, input logic [7:0] v,
                           output logic [31:0] q);
                    always_ff @(posedge clk) q[i*8 +: 8] <= v;
                endmodule
            "#)
  (top Top)
  (for (index value) (list (0 0x11) (2 0x22) (3 0x33) (1 0x44))
    (modify
      (set i index)
      (set v value))
    (tick clk))
  (assert_eq q 0x33224411))

(case indexed_select_multidimensional_packed_reads
  (source "indexed_packed.sv" #"
                module Top(input logic [1:0][0:7] data, output logic [3:0] plus, minus,
                           output logic [7:0] concat_slice);
                    assign plus = data[1][2 +: 4];
                    assign minus = data[0][5 -: 4];
                    assign concat_slice = {data[1], data[0]}[4 +: 8];
                endmodule
            "#)
  (top Top)
  (modify (set data 0xa35c))
  (assert_eq plus 8)
  (assert_eq minus 7)
  (assert_eq concat_slice 0x35))

(case runtime_indexed_reads_follow_the_declared_direction
  (source "runtime_indexed_reads.sv" #"
                module Top(input logic [31:0] down, input logic [0:31] up, input logic [4:0] i,
                           output logic bit_down, bit_up,
                           output logic [7:0] down_plus, down_minus, up_plus, up_minus);
                    assign bit_down = down[i];
                    assign bit_up = up[i];
                    assign down_plus = down[i +: 8];
                    assign down_minus = down[i -: 8];
                    assign up_plus = up[i +: 8];
                    assign up_minus = up[i -: 8];
                endmodule
            "#)
  (top Top)
  (let value 0xaabb_ccdd)
  (modify
    (set down value)
    (set up value))
  ; An ascending range numbers its bits from the most significant end.
  (for index (range 7 25)
    (modify (set i index))
    (assert_eq bit_down (bit value index) "down[i]")
    (assert_eq bit_up (bit value (- 31 index)) "up[i]")
    (assert_eq down_plus (slice value (+ index 7) index) "down[i +: 8]")
    (assert_eq down_minus (slice value index (- index 7)) "down[i -: 8]")
    (assert_eq up_plus (slice value (- 31 index) (- 24 index)) "up[i +: 8]")
    (assert_eq up_minus (slice value (- 38 index) (- 31 index)) "up[i -: 8]"))
  (for index (list 0 31)
    (modify (set i index))
    (assert_eq bit_down (bit value index) "down[i]")))

(case runtime_indexed_writes_keep_unselected_bits_and_clip_overhang
  (source "runtime_indexed_writes.sv" #"
                module Top(input logic [2:0] i, input logic replace, input logic [7:0] base,
                           output logic [7:0] bit_write, plus_write, minus_write, filled);
                    always_comb begin
                        bit_write = base;
                        bit_write[i] = 1'b0;
                        plus_write = base;
                        plus_write[i +: 2] = 2'b10;
                        minus_write = base;
                        minus_write[i -: 2] = 2'b10;
                        filled = '0;
                        filled[i +: 2] = 2'b11;
                        if (replace) filled = '1;
                    end
                endmodule
            "#)
  (top Top)
  ; Bits written outside 7..0 are dropped.
  (let initial 0xa5)
  (modify
    (set base initial)
    (set replace 0))
  (for index (range 0 8)
    (modify (set i index))
    (assert_eq bit_write (& initial (~ (<< 1 index))) "bit_write")
    ; [i +: 2] = 2'b10: bit i is 0 and bit i+1 is 1.
    (assert_eq plus_write (trunc 8 (| (& initial (~ (<< 1 index))) (<< 2 index))) "plus_write")
    ; [i -: 2] = 2'b10: bit i is 1 and bit i-1 is 0.
    (assert_eq minus_write
      (| (? (== index 0) initial (& initial (~ (<< 1 (- index 1))))) (<< 1 index))
      "minus_write")
    ; A conditional write after a runtime-positioned one is merged by the
    ; analyzer's value tracking, which only follows selections that lie
    ; fully inside the vector.
    (if (<= index 6)
      (assert_eq filled (<< 3 index) "filled")))
  (modify (set replace 1))
  (assert_eq filled 0xff))

(case runtime_indices_select_multidimensional_packed_elements
  ; A runtime index selects an element of a multidimensional packed array.
  ; Out of range, a read gives X and a write is ignored (IEEE 1800-2023
  ; 7.4.6, 11.5.1).
  (four_state)
  (source "runtime_packed_elements.sv" #"
                module Top(input logic [1:0] k, input logic [7:0] i,
                           output logic [3:0] e, output logic [7:0] w);
                    logic [1:0][3:0] t, u;
                    assign t = i;
                    assign e = t[k];
                    always_comb begin
                        u = '0;
                        u[k] = 4'hf;
                    end
                    assign w = u;
                endmodule
            "#)
  (top Top)
  (for value (list 0xa5 0x3c)
    (for k (range 0 4)
      (modify (set i value) (set k k))
      (let element_in (< k 2))
      (assert_eq e (? element_in (slice value (+ (* k 4) 3) (* k 4)) (fourstate 0xf 0xf)) "e")
      (assert_eq w (? element_in (<< 0xf (* k 4)) 0) "w"))))

(case runtime_indices_select_within_multidimensional_packed_elements
  ; Runtime indices select an element, a bit of it or a part of it, for
  ; reading and writing.
  (source "runtime_packed_element_parts.sv" #"
                module Top(input logic k, input logic [1:0] j, input logic [7:0] i,
                           output logic [3:0] e, output logic b, output logic [1:0] p,
                           output logic [7:0] w, v, q);
                    logic [1:0][3:0] t, u, x, y;
                    assign t = i;
                    assign e = t[k];
                    assign b = t[k][j];
                    assign p = t[k][2:1];
                    always_comb begin
                        u = '0;
                        u[k] = 4'hf;
                    end
                    always_comb begin
                        x = '0;
                        x[k][j] = 1'b1;
                    end
                    always_comb begin
                        y = '0;
                        y[k][3:2] = 2'b11;
                    end
                    assign w = u;
                    assign v = x;
                    assign q = y;
                endmodule
            "#)
  (top Top)
  (for value (list 0xa5 0x3c)
    (for k (range 0 2)
      (for j (range 0 4)
        (modify (set i value) (set k k) (set j j))
        (assert_eq e (slice value (+ (* k 4) 3) (* k 4)) "e")
        (assert_eq b (bit value (+ (* k 4) j)) "b")
        (assert_eq p (slice value (+ (* k 4) 2) (+ (* k 4) 1)) "p")
        (assert_eq w (<< 0xf (* k 4)) "w")
        (assert_eq v (<< 1 (+ (* k 4) j)) "v")
        (assert_eq q (<< 0xc (* k 4)) "q")))))

(case out_of_range_inner_indices_stay_in_their_element
  ; An inner index past its dimension flattens to a position in another
  ; element; the select is still out of range: a read gives X and a write
  ; is ignored (IEEE 1800-2023 7.4.6, 11.5.1).
  (four_state)
  (source "runtime_inner_index_range.sv" #"
                module Top(input logic [2:0] j, input logic [7:0] i,
                           output logic b, output logic [7:0] v);
                    logic [1:0][3:0] t, x;
                    assign t = i;
                    assign b = t[0][j];
                    always_comb begin
                        x = '0;
                        x[0][j] = 1'b1;
                    end
                    assign v = x;
                endmodule
            "#)
  (top Top)
  (for value (list 0xa5 0x3c)
    (for j (range 0 8)
      (modify (set i value) (set j j))
      (assert_eq b (? (< j 4) (bit value j) (fourstate 1 1)) "b")
      (assert_eq v (? (< j 4) (<< 1 j) 0) "v"))))

(case out_of_range_inner_indices_stay_in_their_unpacked_element
  ; After a run-time unpacked index, an inner index past its dimension
  ; flattens to a position in the next element; the select is still out of
  ; range: a read gives X and a write is ignored (IEEE 1800-2023 7.4.6,
  ; 11.5.1).
  (four_state)
  (source "runtime_unpacked_inner_index_range.sv" #"
                module Top(input logic clk, input logic [1:0] j, input logic [3:0] i,
                           output logic b, output logic [7:0] w1,
                           output logic [7:0] w2, output logic [7:0] q1, output logic [7:0] q2);
                    logic [7:0] t [4];
                    logic [7:0] x [4];
                    logic [7:0] y [4];
                    always_comb begin
                        t[0] = 8'h00;
                        t[1] = 8'h00;
                        t[2] = 8'hff;
                        t[3] = 8'hff;
                    end
                    assign b = t[j][i];
                    always_comb begin
                        for (int e = 0; e < 4; e++) x[e] = 8'h00;
                        x[j][i] = 1'b1;
                    end
                    always_ff @(posedge clk) begin
                        for (int e = 0; e < 4; e++) y[e] <= 8'h00;
                        y[j][i] <= 1'b1;
                    end
                    assign w1 = x[1];
                    assign w2 = x[2];
                    assign q1 = y[1];
                    assign q2 = y[2];
                endmodule
            "#)
  (top Top)
  (for (row index) (list (1 0) (1 7) (1 8) (1 9) (1 15) (2 3))
    (modify (set j row) (set i index))
    (tick clk)
    (let bit_in (< index 8))
    (assert_eq b (? bit_in (? (== row 2) 1 0) (fourstate 1 1)) "b")
    (assert_eq w1 (? (&& bit_in (== row 1)) (<< 1 index) 0) "w1")
    (assert_eq w2 (? (&& bit_in (== row 2)) (<< 1 index) 0) "w2")
    (assert_eq q1 (? (&& bit_in (== row 1)) (<< 1 index) 0) "q1")
    (assert_eq q2 (? (&& bit_in (== row 2)) (<< 1 index) 0) "q2")))

(case runtime_inner_bits_of_unpacked_elements_feed_child_ports
  ; The same select as an input port connection.
  (four_state)
  (source "runtime_inner_bit_port.sv" #"
                module Child(input logic d, output logic q);
                    assign q = d;
                endmodule
                module Top(input logic [1:0] j, input logic [3:0] i, output logic y);
                    logic [7:0] a [4];
                    always_comb begin
                        a[0] = 8'h01;
                        a[1] = 8'h02;
                        a[2] = 8'h04;
                        a[3] = 8'h08;
                    end
                    Child c(.d(a[j][i]), .q(y));
                endmodule
            "#)
  (top Top)
  (for (row index) (list (1 1) (2 2) (2 1) (1 8) (1 9))
    (modify (set j row) (set i index))
    (assert_eq y (? (< index 8) (? (== index row) 1 0) (fourstate 1 1)))))

(case out_of_range_inner_indices_stay_in_their_multidimensional_unpacked_element
  ; As above, with several packed dimensions in each element.
  (four_state)
  (source "runtime_unpacked_packed_inner_index_range.sv" #"
                module Top(input logic [1:0] j, input logic [1:0] k, input logic [3:0] i,
                           output logic n);
                    logic [1:0][3:0] u [4];
                    always_comb begin
                        u[0] = 8'h00;
                        u[1] = 8'h00;
                        u[2] = 8'hff;
                        u[3] = 8'hff;
                    end
                    assign n = u[j][k][i];
                endmodule
            "#)
  (top Top)
  (for (row inner index) (list (1 1 0) (1 1 3) (1 1 4) (1 0 7) (2 1 2) (2 1 9))
    (modify (set j row) (set k inner) (set i index))
    (assert_eq n (? (< index 4) (? (== row 2) 1 0) (fourstate 1 1)) "n")))

(case runtime_index_reads_single_bit_unpacked_elements
  ; A run-time index selects one element of an unpacked array of 1-bit
  ; elements; `[32]` declares `[0:31]` (IEEE 1800-2023 7.4.2, 7.4.6).
  (source "single_bit_unpacked_index.sv" #"
                module Top(input logic clk, input logic [4:0] p, input logic [31:0] d,
                           output logic q, output logic q_ff);
                    logic v [32];
                    always_comb for (int i = 0; i < 32; i++) v[i] = d[i];
                    always_comb q = v[p];
                    always_ff @(posedge clk) q_ff <= v[p];
                endmodule
            "#)
  (top Top)
  (for value (list 0xa5c30f81 0x5a3cf07e)
    (for p (range 0 32)
      (modify (set d value) (set p p))
      (assert_eq q (bit value p) "q")
      (tick clk)
      (assert_eq q_ff (bit value p) "q_ff"))))

(case nested_array_indices_preserve_elements_and_ranges
  ; The inner selection is an entire element, including in an assignment
  ; target and in a sequential read. Use nonzero descending unpacked bounds.
  (source "nested_array_indices.sv" #"
    module Top(input logic clk, input logic [7:0] idx, data,
               output logic [7:0] nested, arithmetic, packed_index, q, w1, w3);
        logic [7:0] map [2:1];
        logic [7:0] mem [4];
        logic [7:0] written [4];
        logic [0:7] packed_value;
        assign packed_value = 8'h30;
        always_comb begin
            map[2] = data;
            map[1] = 3;
            mem[0] = 0;
            mem[1] = 11;
            mem[2] = 22;
            mem[3] = 33;
            written[0] = 0;
            written[1] = 0;
            written[2] = 0;
            written[3] = 0;
            written[map[idx]] = 8'h5a;
        end
        assign nested = mem[map[idx]];
        assign arithmetic = mem[map[idx] + 8'd1];
        assign packed_index = mem[packed_value[0:3]];
        assign w1 = written[1];
        assign w3 = written[3];
        always_ff @(posedge clk) q <= mem[map[idx]];
    endmodule
  "#)
  (top Top)
  (for (index value mapped) (list (1 1 3) (2 1 1) (2 2 2) (1 2 3))
    (modify (set idx index) (set data value))
    (assert_eq nested (* mapped 11))
    (assert_eq packed_index 33)
    (assert_eq w1 (? (== mapped 1) 0x5a 0))
    (assert_eq w3 (? (== mapped 3) 0x5a 0))
    (if (< mapped 3) (assert_eq arithmetic (* (+ mapped 1) 11)))
    (tick clk)
    (assert_eq q (* mapped 11))))

(case nested_array_indices_preserve_invalid_reads_and_writes
  ; Invalid or unknown inner and outer indices read X and write nothing
  ; (IEEE 1800-2023 7.4.5).
  (four_state)
  (source "nested_invalid_array_indices.sv" #"
    module Top(input logic clk, input logic [7:0] idx, data,
               output logic [7:0] nested, q, w1, w3);
        logic [7:0] map [2];
        logic [7:0] mem [4];
        logic [7:0] written [4];
        always_comb begin
            map[0] = data;
            map[1] = 3;
            mem[0] = 0;
            mem[1] = 11;
            mem[2] = 22;
            mem[3] = 33;
            written[0] = 0;
            written[1] = 0;
            written[2] = 0;
            written[3] = 0;
            written[map[idx]] = 8'h5a;
        end
        assign nested = mem[map[idx]];
        assign w1 = written[1];
        assign w3 = written[3];
        always_ff @(posedge clk) q <= mem[map[idx]];
    endmodule
  "#)
  (top Top)
  (for (index value) (list (0 1) (1 1) (0 4) (2 1) (255 1)
                            ((fourstate 0xff 0xff) 1)
                            (0 (fourstate 0xff 0xff))
                            (0 (fourstate 0 0xff)))
    (modify (set idx index) (set data value))
    (let valid (&& (== (xmask index) 0) (== (xmask value) 0)
                   (< index 2) (|| (== index 1) (< value 4))))
    (let mapped (? (== index 1) 3 value))
    (let expected (? valid (* mapped 11) (fourstate 0xff 0xff)))
    (assert_eq nested expected)
    (assert_eq w1 (? (&& valid (== mapped 1)) 0x5a 0))
    (assert_eq w3 (? (&& valid (== mapped 3)) 0x5a 0))
    (tick clk)
    (assert_eq q expected)))

(case nested_array_indices_freeze_concat_targets
  ; Keep the index values from the assignment when later blocking writes
  ; change the map, in both combinational and sequential processes.
  (source "nested_array_concat_targets.sv" #"
    module Top(input logic clk, input logic [7:0] data,
               output logic [7:0] w1, w2, w3, q1, q2, q3);
        logic [7:0] map [2];
        logic [7:0] written [4];
        logic [7:0] ff_map [2];
        logic [7:0] ff_written [4];
        always_comb begin
            map[0] = data;
            map[1] = 3;
            written[0] = 0;
            written[1] = 0;
            written[2] = 0;
            written[3] = 0;
            {written[map[0]], written[map[1]]} = 16'h5a3c;
            map[0] = 2;
        end
        assign w1 = written[1];
        assign w2 = written[2];
        assign w3 = written[3];
        always_ff @(posedge clk) begin
            ff_map[0] = data;
            ff_map[1] = 3;
            ff_written[0] = 0;
            ff_written[1] = 0;
            ff_written[2] = 0;
            ff_written[3] = 0;
            {ff_written[ff_map[0]], ff_written[ff_map[1]]} = 16'h5a3c;
            ff_map[0] = 2;
            q1 <= ff_written[1];
            q2 <= ff_written[2];
            q3 <= ff_written[3];
        end
    endmodule
  "#)
  (top Top)
  (for value (list 1 2 1 2)
    (modify (set data value))
    (assert_eq w1 (? (== value 1) 0x5a 0))
    (assert_eq w2 (? (== value 2) 0x5a 0))
    (assert_eq w3 0x3c)
    (tick clk)
    (assert_eq q1 (? (== value 1) 0x5a 0))
    (assert_eq q2 (? (== value 2) 0x5a 0))
    (assert_eq q3 0x3c)))

(case nested_array_indices_preserve_cast_widths
  ; Preserve signed 2-bit arithmetic and cast widths when the operand
  ; is a dynamically selected unpacked array element.
  (source "nested_array_cast_indices.sv" #"
    module Top(input logic clk, input logic idx, input logic signed [7:0] data,
               output logic [7:0] direct, wrapped, q,
               output logic [31:0] contents);
        logic signed [7:0] map [2];
        logic [7:0] mem [-2:1];
        logic [7:0] written [-2:1];
        always_comb begin
            map[0] = data;
            map[1] = ~data;
            mem[-2] = 8'h10;
            mem[-1] = 8'h20;
            mem[0] = 8'h30;
            mem[1] = 8'h40;
            written[-2] = 0;
            written[-1] = 0;
            written[0] = 0;
            written[1] = 0;
            written[signed'(map[idx][1:0])] = 8'h5a;
        end
        assign direct = mem[signed'(map[idx][1:0])];
        assign wrapped = mem[2'(map[idx]) + 2'sd1];
        assign contents = {written[1], written[0], written[-1], written[-2]};
        always_ff @(posedge clk) q <= mem[int'(signed'(map[idx][1:0]))];
    endmodule
  "#)
  (top Top)
  (let by_index 0x20104030)
  (for value (list 0 1 2 3 0x81 0xa6 0xff)
    (for index (range 0 2)
      (modify (set idx index) (set data value))
      (let bits (& (? index (~ value) value) 3))
      (let expected (& (>> by_index (* bits 8)) 255))
      (assert_eq direct expected)
      (assert_eq wrapped (& (>> by_index (* (& (+ bits 1) 3) 8)) 255))
      (assert_eq contents (<< 0x5a (* (& (+ bits 2) 3) 8)))
      (tick clk)
      (assert_eq q expected))))

(case constant_part_select_indices_read_and_write_unpacked_arrays
  ; IEEE 1800-2023 11.5.1, 11.8.1: a constant part-select is an unsigned,
  ; self-determined expression, including when the source vector is signed.
  (source "constant_part_select_indices.sv" #"
                module Top(input logic clk, input logic signed [7:0] c,
                           input logic [0:7] ascending, input logic [7:0] d,
                           output logic [7:0] direct, upper, up, wrapped,
                           output logic nested, output logic [3:0] written);
                    localparam int LOW = 0;
                    logic [7:0] mem [4];
                    always_ff @(posedge clk) mem[c[LOW+1:LOW]] <= d;
                    assign direct = mem[c[1:0]];
                    assign upper = mem[c[5:4]];
                    assign up = mem[ascending[2:3]];
                    assign wrapped = mem[c[1:0] + 2'd1];
                    assign nested = mem[c[3:2]][c[1:0]];
                    always_comb begin
                        written = '0;
                        written[c[1:0]] = 1'b1;
                    end
                endmodule
            "#)
  (top Top)
  (for (index value) (list (0 0x81) (1 0x12) (2 0x24) (3 0x48))
    (modify (set c (+ 0xf0 index)) (set d value))
    (tick clk)
    (assert_eq direct value))
  (for value (list 0 1 2 3 0x1b 0x27 0x39 0xc6 0xff)
    (modify (set c value) (set ascending value))
    (let index (& value 3))
    (let upper_index (& (>> value 4) 3))
    (let nested_index (& (>> value 2) 3))
    (let stored 0x48241281)
    (assert_eq direct (& (>> stored (* index 8)) 255))
    (assert_eq upper (& (>> stored (* upper_index 8)) 255))
    (assert_eq up (& (>> stored (* upper_index 8)) 255))
    (assert_eq wrapped (& (>> stored (* (& (+ index 1) 3) 8)) 255))
    (assert_eq nested (bit (& (>> stored (* nested_index 8)) 255) index))
    (assert_eq written (<< 1 index))))

(case constant_part_select_indices_preserve_selected_unknowns
  (four_state)
  (source "constant_part_select_unknown_indices.sv" #"
                module Top(input logic clk, input logic [7:0] c, input logic [7:0] d,
                           output logic [7:0] direct, first,
                           output logic [31:0] contents);
                    logic [7:0] mem [4];
                    always_ff @(posedge clk) mem[c[1:0]] <= d;
                    assign direct = mem[c[1:0]];
                    assign first = mem[0];
                    assign contents = {mem[3], mem[2], mem[1], mem[0]};
                endmodule
            "#)
  (top Top)
  (for (index value) (list (0 0x5a) (1 0x11) (2 0x22) (3 0x44))
    (modify (set c index) (set d value))
    (tick clk))
  (modify (set c 0))
  (assert_eq first 0x5a)
  ; Unknown bits outside the part-select have no effect on the index.
  (modify (set c (fourstate 0xfc 0xfc)) (set d 0xa5))
  (assert_eq direct 0x5a)
  (tick clk)
  (assert_eq direct 0xa5)
  (assert_eq first 0xa5)
  ; An X or Z inside the part-select makes the index invalid: reads
  ; return X, and a write leaves every element unchanged.
  (for unknown (list (fourstate 1 1) (fourstate 0 1))
    (modify (set c unknown) (set d 0x33))
    (assert_eq direct (fourstate 0xff 0xff))
    (tick clk)
    (assert_eq first 0xa5)
    (assert_eq contents 0x442211a5))
  (modify (set c 0))
  (assert_eq direct 0xa5))

(case constant_part_select_indices_in_continuous_targets
  (source "constant_part_select_net_indices.sv" #"
                module Top(input logic [7:0] d, input logic [7:0] c,
                           output logic [7:0] y, output wire [3:0] bits);
                    localparam logic [7:0] P = 8'ha2;
                    wire [7:0] mem [4];
                    assign mem[P[1:0]] = d;
                    assign mem[0] = 8'h10;
                    assign mem[1] = 8'h21;
                    assign mem[3] = 8'h43;
                    assign y = mem[c[1:0]];
                    assign bits[P[1:0]] = d[0];
                    assign bits[1:0] = 2'b01;
                    assign bits[3] = 1'b1;
                endmodule
            "#)
  (top Top)
  (for value (list 0x34 0xab)
    (modify (set d value))
    (assert_eq bits (| 9 (<< (& value 1) 2)))
    (for (index expected) (list (0 0x10) (1 0x21) (2 value) (3 0x43))
      (modify (set c (+ 0xf0 index)))
      (assert_eq y expected))))

(case constant_part_select_indices_of_concatenations
  ; IEEE 1800-2023 11.4.12: concatenation selections use [n-1:0]
  ; coordinates, independently of their operands' declared ranges.
  (source "concatenation_slice_indices.sv" #"
                module Top(input logic clk, input logic [7:0] c,
                           input logic [0:7] ascending, input logic [11:4] shifted,
                           output logic [7:0] joined, repeated, crossing, nested, up, offset, single,
                           output logic [3:0] written, registered);
                    logic [7:0] mem [4];
                    always_comb begin
                        mem[0] = 8'h12;
                        mem[1] = 8'h34;
                        mem[2] = 8'h56;
                        mem[3] = 8'h78;
                        written = '0;
                        written[{2'b00, c}[1:0]] = 1'b1;
                    end
                    always_ff @(posedge clk) begin
                        registered <= '0;
                        registered[{2{c}}[9:8]] <= 1'b1;
                    end
                    assign joined = mem[{2'b00, c}[1:0]];
                    assign repeated = mem[{2{c}}[9:8]];
                    assign crossing = mem[{c[0], c[7:1]}[7:6]];
                    assign nested = mem[{1'b0, {2{c[1:0]}}}[3:2]];
                    assign up = mem[{2'b00, ascending}[1:0]];
                    assign offset = mem[{2'b00, shifted}[1:0]];
                    assign single = mem[{c}[1:1]];
                endmodule
            "#)
  (top Top)
  (let stored 0x78563412)
  (for value (list 0 1 2 3 0x81 0x42 0xa5 0xff)
    (modify (set c value) (set ascending value) (set shifted value))
    (let index (& value 3))
    (let expected (& (>> stored (* index 8)) 255))
    (expand name (joined repeated nested up offset)
      (assert_eq {name} expected))
    (let cross (| (<< (& value 1) 1) (& (>> value 7) 1)))
    (assert_eq crossing (& (>> stored (* cross 8)) 255))
    (assert_eq single (& (>> stored (* (& (>> value 1) 1) 8)) 255))
    (assert_eq written (<< 1 index))
    (tick clk)
    (assert_eq registered (<< 1 index))))

(case signed_indices_access_clocked_negative_range_arrays
  ; IEEE 1800-2023 7.4.2: unpacked array ranges can have negative indices.
  (source "clocked_negative_array.sv" #"
    module Top(input logic clk, input logic signed [1:0] c,
               input logic [7:0] d, output logic [7:0] direct, wrapped,
               output logic [31:0] contents);
      logic [7:0] mem [-2:1];
      always_ff @(posedge clk) mem[c] <= d;
      assign direct = mem[c];
      assign wrapped = mem[c + 2'sd1];
      assign contents = {mem[1], mem[0], mem[-1], mem[-2]};
    endmodule
  "#)
  (top Top)
  (for (bits value expected)
       (list (2 0x22 0x00000022) (3 0x33 0x00003322)
             (0 0x44 0x00443322) (1 0x55 0x55443322))
    (modify (set c bits) (set d value))
    (tick clk)
    (assert_eq direct value)
    (assert_eq contents expected))
  (let by_index 0x33225544)
  (for bits (range 0 4)
    (modify (set c bits))
    (assert_eq direct (& (>> by_index (* bits 8)) 255))
    (let next (& (+ bits 1) 3))
    (assert_eq wrapped (& (>> by_index (* next 8)) 255))))

(case constant_part_select_indices_of_signed_slices
  ; IEEE 1800-2023 7.4.2: negative unpacked indices are valid when
  ; they lie inside the declared range. Preserve cast widths in arithmetic.
  (source "signed_slice_indices.sv" #"
                module Top(input logic clk, input logic [7:0] c, input logic [7:0] d,
                           output logic [7:0] direct, casted, wrapped, widened, registered,
                           output logic [31:0] contents);
                    logic [7:0] mem [-2:1];
                    always_comb begin
                        mem[-2] = 8'h10;
                        mem[-1] = 8'h20;
                        mem[0] = 8'h30;
                        mem[1] = 8'h40;
                        mem[$signed(c[1:0])] = d;
                    end
                    assign direct = mem[$signed(c[1:0])];
                    assign casted = mem[signed'(c[1:0])];
                    assign widened = mem[int'(signed'(c[1:0]))];
                    assign wrapped = mem[$signed(c[1:0]) + 2'sd1];
                    assign contents = {mem[1], mem[0], mem[-1], mem[-2]};
                    always_ff @(posedge clk) registered <= mem[$signed(c[1:0])];
                endmodule
            "#)
  (top Top)
  (let initial 0x40302010)
  (let by_index 0x20104030)
  (for (bits value) (list (2 0x22) (3 0x33) (0 0x44) (1 0x55) (2 0xab) (1 0xcd))
    (modify (set c (+ 0xc0 bits)) (set d value))
    (expand name (direct casted widened)
      (assert_eq {name} value))
    (let offset (* (& (+ bits 2) 3) 8))
    (assert_eq contents (| (& initial (~ (<< 255 offset))) (<< value offset)))
    (let next (& (+ bits 1) 3))
    (assert_eq wrapped (& (>> by_index (* next 8)) 255))
    (tick clk)
    (assert_eq registered value)))

(case procedural_loop_writes_memory_word_part_selects
  (source "memory_byte_enables.sv" #"
        module Top #(parameter BYTE_W=8)(input logic clk, rst, input logic [1:0] addr, strobe,
            input logic [15:0] data, output logic [15:0] q, ascending_q);
            logic [15:0] mem[0:3];
            logic [0:15] ascending_mem[3:0];
            always_ff @(posedge clk) begin
                if (rst) begin
                    for (integer i=0; i<4; i=i+1) begin
                        mem[i] <= 0;
                        ascending_mem[i] <= 0;
                    end
                end else begin
                    for (integer i=0; i<2; i=i+1) begin
                        if (strobe[i]) begin
                            mem[addr][BYTE_W*i +: BYTE_W] <= data[BYTE_W*i +: BYTE_W];
                            ascending_mem[addr][2*BYTE_W-1-BYTE_W*i -: BYTE_W] <= data[BYTE_W*i +: BYTE_W];
                        end
                    end
                end
            end
            assign q=mem[addr];
            assign ascending_q=ascending_mem[addr];
        endmodule
    "#)
  (top Top)
  (modify (set rst 1) (set addr 0) (set strobe 0) (set data 0))
  (tick clk)
  (assert_eq q 0)
  (assert_eq ascending_q 0)
  (modify (set rst 0) (set strobe 3) (set data 0x1234))
  (tick clk)
  (assert_eq q 0x1234)
  (assert_eq ascending_q 0x1234)
  (modify (set addr 1) (set strobe 1) (set data 0xabcd))
  (tick clk)
  (assert_eq q 0x00cd)
  (assert_eq ascending_q 0x00cd)
  (modify (set strobe 2) (set data 0x5678))
  (tick clk)
  (assert_eq q 0x56cd)
  (assert_eq ascending_q 0x56cd)
  (modify (set strobe 0) (set data 0xffff))
  (tick clk)
  (assert_eq q 0x56cd)
  (assert_eq ascending_q 0x56cd)
  (modify (set addr 0))
  (assert_eq q 0x1234)
  (assert_eq ascending_q 0x1234)
  (modify (set addr 2))
  (assert_eq q 0)
  (assert_eq ascending_q 0))

(case indexed_selections_in_constant_declaration_contexts
  (source "declaration_select.sv" #"
    module Top(output logic [3:0] enumeration, output logic [31:0] width);
      localparam logic [7:0] P=8'hab;
      logic [P[4 +: 4]-1:0] y;
      typedef enum logic [3:0] { E=P[4 +: 4] } nibble;
      nibble state;
      assign state=E;
      assign enumeration=state;
      assign width=$bits(y);
    endmodule
  "#)
  (top Top)
  (assert_eq enumeration 10)
  (assert_eq width 10))

(case runtime_indexed_bases_preserve_numeric_and_type_casts
  (source "runtime_indexed_cast.sv" #"
    module Top(input logic [63:0] data, input logic [1:0] offset,
               input logic [3:0] index,
               output logic [31:0] y, output logic [3:0] narrowed,
               output logic [3:0] typed, output logic [63:0] written);
        typedef logic [2:0] index_t;
        assign y = data[3'(4-offset)*8 +: 32];
        assign narrowed = data[2'(index) +: 4];
        assign typed = data[index_t'(index) +: 4];
        always_comb begin
            written = data;
            written[3'(4-offset)*8 +: 8] = 8'hff;
        end
    endmodule
  "#)
  (top Top)
  (modify (set data 0x0123456789abcdef))
  (for offset_value (range 0 4)
    (modify (set offset offset_value))
    (assert_eq y (& (>> 0x0123456789abcdef (* (- 4 offset_value) 8)) 0xffffffff))
    (assert_eq written (| 0x0123456789abcdef (<< 0xff (* (- 4 offset_value) 8)))))
  (for index_value (range 0 16)
    (modify (set index index_value))
    (assert_eq narrowed (& (>> 0x0123456789abcdef (& index_value 3)) 15))
    (assert_eq typed (& (>> 0x0123456789abcdef (& index_value 7)) 15))))

; IEEE 1800-2023 11.5.1: an indexed select remains valid after selecting
; a packed array element; procedural loop indices keep their own width/sign.
(case procedural_loop_selects_packed_words
  (source "loop_packed_words.sv" #"
    module Top(input logic clk, input logic [3:0] be,
      input logic [31:0] data,
      output logic [31:0] down_plus, down_minus, up_plus, up_minus);
      logic [1:0][31:0] down = '0;
      logic [2:3][0:31] up = '0;
      always_ff @(posedge clk) begin
        for (integer i = 0; i < 4; i = i + 1) begin
          if (be[i]) begin
            down[1][i*8 +: 8] <= data[i*8 +: 8];
            down[0][31-i*8 -: 8] <= data[31-i*8 -: 8];
            up[2][i*8 +: 8] <= data[i*8 +: 8];
            up[3][31-i*8 -: 8] <= data[31-i*8 -: 8];
          end
        end
      end
      assign down_plus = down[1];
      assign down_minus = down[0];
      assign up_plus = up[2];
      assign up_minus = up[3];
    endmodule
  "#)
  (top Top)
  (modify (set be 15) (set data 0x12345678))
  (tick clk)
  (assert_eq down_plus 0x12345678)
  (assert_eq down_minus 0x12345678)
  (assert_eq up_plus 0x78563412)
  (assert_eq up_minus 0x78563412)
  (modify (set be 5) (set data 0xaabbccdd))
  (tick clk)
  (assert_eq down_plus 0x12bb56dd)
  (assert_eq down_minus 0xaa34cc78)
  (assert_eq up_plus 0xdd56bb12)
  (assert_eq up_minus 0x78cc34aa))

(case procedural_loop_reads_packed_words_into_memory
  (source "loop_packed_memory.sv" #"
    module Top(input logic clk, en, input logic [1:0] addr,
      input logic [63:0] data, output logic [31:0] low_word, high_word);
      wire [1:0][31:0] words = data;
      wire [1:0][31:0] read_words;
      for (genvar n = 0; n < 2; n = n + 1) begin : bank
        logic [31:0] mem[4];
        initial for (integer k = 0; k < 4; k = k + 1) mem[k] = 0;
        always_ff @(posedge clk) begin
          for (integer i = 0; i < 4; i = i + 1) begin
            if (en) mem[addr][i*8 +: 8] <= words[n][i*8 +: 8];
          end
        end
        assign read_words[n] = mem[addr];
      end
      assign low_word = read_words[0];
      assign high_word = read_words[1];
    endmodule
  "#)
  (top Top)
  (modify (set en 1) (set addr 1) (set data 0x1234567889abcdef))
  (tick clk)
  (assert_eq low_word 0x89abcdef)
  (assert_eq high_word 0x12345678)
  (modify (set addr 2) (set data 0xfedcba9876543210))
  (tick clk)
  (assert_eq low_word 0x76543210)
  (assert_eq high_word 0xfedcba98)
  (modify (set en 0) (set addr 1))
  (assert_eq low_word 0x89abcdef)
  (assert_eq high_word 0x12345678))


(case procedural_loop_selects_constant_packed_bytes
  (source "loop_constant_packed_bytes.sv" #"
    module Top(input logic [1:0] addr, output logic [7:0] q);
      localparam ID = "ABCD";
      logic [7:0] rom[4];
      initial begin
        integer last;
        last = 3;
        for (integer i = 0; i < 4; i = i + 1) begin
          rom[i] = ID[8*(last-i) +: 8];
        end
      end
      assign q = rom[addr];
    endmodule
  "#)
  (top Top)
  (assert_eq q 0x41)
  (modify (set addr 1))
  (assert_eq q 0x42)
  (modify (set addr 2))
  (assert_eq q 0x43)
  (modify (set addr 3))
  (assert_eq q 0x44))

; IEEE 1800-2023 11.5.1: a write to a constant part-select partly outside the
; vector writes the bits inside, and one wholly outside writes nothing.
(case constant_part_selects_partly_outside_write_the_bits_inside
  (source "partly_outside.sv" #"
                module Top(input logic clk, input logic [3:0] v,
                           output logic [7:0] comb_hi, comb_out, ff_nb, ff_b);
                    always_comb begin
                        comb_hi = 8'h00;
                        comb_hi[9:6] = v;
                        comb_out = 8'h5a;
                        comb_out[11:8] = v;
                    end
                    always_ff @(posedge clk) begin
                        ff_nb <= 8'h00;
                        ff_nb[9:6] <= v;
                    end
                    always_ff @(posedge clk) begin
                        ff_b = 8'h00;
                        ff_b[9:6] = v;
                    end
                endmodule
            "#)
  (top Top)
  (modify (set clk 0) (set v 0xf))
  (assert_eq comb_hi 0xc0 "bits 7:6 take the low bits of the value")
  (assert_eq comb_out 0x5a "a select wholly outside writes nothing")
  (tick clk)
  (assert_eq ff_nb 0xc0)
  (assert_eq ff_b 0xc0)
  (modify (set v 0x6))
  (assert_eq comb_hi 0x80)
  (tick clk)
  (assert_eq ff_nb 0x80)
  (assert_eq ff_b 0x80))

; On an ascending vector the bits past the declared right end are the low
; bits of the select, so the bits inside take the high bits of the value.
(case ascending_part_selects_partly_outside_write_the_bits_inside
  (source "ascending_partly_outside.sv" #"
                module Top(input logic clk, input logic [3:0] v,
                           output logic [0:7] comb_up, ff_up);
                    always_comb begin
                        comb_up = 8'h00;
                        comb_up[6:9] = v;
                    end
                    always_ff @(posedge clk) begin
                        ff_up <= 8'h00;
                        ff_up[6:9] <= v;
                    end
                endmodule
            "#)
  (top Top)
  (modify (set clk 0) (set v 0x9))
  (assert_eq comb_up 0x02 "comb_up[6:7] take v[3:2]")
  (tick clk)
  (assert_eq ff_up 0x02))

; A run-time select within one array element stays within it even when the
; position is known while the design is compiled (IEEE 1800-2023 7.4.6,
; 11.5.1).
(case known_run_time_selects_stay_within_their_element
  (source "known_element_selects.sv" #"
                module Top(output logic [7:0] a0, a1, a2, l0, l1, l2, s0, s1, s2);
                    int k = 6, n = -2;
                    logic [7:0] a [0:2];
                    logic [7:0] l [0:2];
                    logic [7:0] s [0:2];
                    initial begin
                        for (int i = 0; i < 3; i++) begin
                            a[i] = 8'd0;
                            l[i] = 8'd0;
                            s[i] = 8'd0;
                        end
                        a[1][k +: 4] = 4'b0101;
                        a[1][n +: 4] = 4'b1010;
                        for (int j = 6; j < 7; j++) l[1][j +: 4] = 4'b0101;
                        #1;
                        s[1][k +: 4] = 4'b0101;
                        s[1][n +: 4] = 4'b1010;
                    end
                    assign a0 = a[0];
                    assign a1 = a[1];
                    assign a2 = a[2];
                    assign l0 = l[0];
                    assign l1 = l[1];
                    assign l2 = l[2];
                    assign s0 = s[0];
                    assign s1 = s[1];
                    assign s2 = s[2];
                endmodule
            "#)
  (top Top)
  (run_until 0)
  (assert_eq a0 0) (assert_eq a1 0x42) (assert_eq a2 0)
  (assert_eq l0 0) (assert_eq l1 0x40) (assert_eq l2 0)
  (run_until 1)
  (assert_eq s0 0) (assert_eq s1 0x42) (assert_eq s2 0))

(case generated_pipeline_with_unselected_invalid_array_element
  ; IEEE 1800-2023 7.4.5 and 11.4.11: an invalid element in the unused
  ; conditional arm must not prevent elaboration or change the result type.
  (source "generated_pipeline.sv" #"
    module Asc #(parameter N=0)(input logic clk, rst, input logic [7:0] d,
                                output logic [7:0] q);
      if (N>0) begin : pipe
        logic [7:0] r[3:N+2];
        for(genvar n=0;n<N;n++) begin : stage
          always_ff @(posedge clk)
            if (rst) r[n+3] <= '0;
            else r[n+3] <= n==0 ? d : r[n+2];
        end
        assign q=r[N+2];
      end else assign q=d;
    endmodule
    module Desc #(parameter N=0)(input logic clk, rst, input logic [7:0] d,
                                 output logic [7:0] q);
      if (N>0) begin : pipe
        logic [7:0] r[N+2:3];
        for(genvar n=0;n<N;n++) begin : stage
          always_ff @(posedge clk)
            if (rst) r[n+3] <= '0;
            else r[n+3] <= n==0 ? d : r[n+2];
        end
        assign q=r[N+2];
      end else assign q=d;
    endmodule
    module Top(input logic clk, rst, input logic [7:0] d,
               output logic [7:0] a1,a2,a4,b1,b2,b4);
      Asc #(.N(1)) u1(clk,rst,d,a1);
      Asc #(.N(2)) u2(clk,rst,d,a2);
      Asc #(.N(4)) u4(clk,rst,d,a4);
      Desc #(.N(1)) v1(clk,rst,d,b1);
      Desc #(.N(2)) v2(clk,rst,d,b2);
      Desc #(.N(4)) v4(clk,rst,d,b4);
    endmodule
  "#)
  (top Top)
  (modify (set rst 1))
  (tick clk)
  (modify (set rst 0))
  (for cycle (range 1 8)
    (modify (set d (* cycle 17)))
    (tick clk)
    (assert_eq a1 (* cycle 17))
    (assert_eq b1 (* cycle 17))
    (assert_eq a2 (? (> cycle 1) (* (- cycle 1) 17) 0))
    (assert_eq b2 (? (> cycle 1) (* (- cycle 1) 17) 0))
    (assert_eq a4 (? (> cycle 3) (* (- cycle 3) 17) 0))
    (assert_eq b4 (? (> cycle 3) (* (- cycle 3) 17) 0))))

(case constant_invalid_unpacked_indices_read_defaults_and_ignore_writes
  ; IEEE 1800-2023 7.4.5, Table 7-1. Invalid inner indices must never
  ; wrap into a neighboring element, in either declaration direction.
  (four_state)
  (source "constant_invalid_array_indices.sv" #"
    module Top(input logic clk, input logic [7:0] d,
               output logic [7:0] above, below, inner, row,
               output logic [7:0] written, written_ff,
               output logic [128:0] wide);
      logic [7:0] a[3:4];
      logic [7:0] b[4:3];
      logic [7:0] matrix[0:1][0:2];
      logic [7:0] w[3:4], f[3:4];
      logic [128:0] wide_array[2];
      assign wide=wide_array[2];
      always_comb begin
        a[3]=d; a[4]=~d;
        b[3]=d; b[4]=~d;
        for (int i=0;i<2;i++) for (int j=0;j<3;j++) matrix[i][j]=d;
        w[3]=d; w[4]=~d;
        w[2]=8'hff; w[5]=8'hff;
      end
      always_ff @(posedge clk) begin
        f[3]<=d; f[4]<=~d;
        f[2]<=8'hff; f[5]<=8'hff;
      end
      assign below=a[2];
      assign above=b[5];
      assign inner=matrix[0][3];
      assign row=matrix[2][0];
      assign written=w[3]^w[4];
      assign written_ff=f[3]^f[4];
    endmodule
  "#)
  (top Top)
  (for value (list 0x12 0xa5 0xff)
    (modify (set d value))
    (assert_eq below (fourstate 255 255))
    (assert_eq above (fourstate 255 255))
    (assert_eq inner (fourstate 255 255))
    (assert_eq row (fourstate 255 255))
    (let wide_mask (- (<< 1 129) 1))
    (assert_eq wide (fourstate wide_mask wide_mask))
    (assert_eq written 255)
    (tick clk)
    (assert_eq written_ff 255)))

(case generated_pipeline_with_unselected_invalid_array_element_four_state
  ; IEEE 1800-2023 7.4.5 and 11.4.11: an invalid element in the unused
  ; conditional arm must not prevent elaboration or change the result type.
  (four_state)
  (source "generated_pipeline.sv" #"
    module Asc #(parameter N=0)(input logic clk, rst, input logic [7:0] d,
                                output logic [7:0] q);
      if (N>0) begin : pipe
        logic [7:0] r[3:N+2];
        for(genvar n=0;n<N;n++) begin : stage
          always_ff @(posedge clk)
            if (rst) r[n+3] <= '0;
            else r[n+3] <= n==0 ? d : r[n+2];
        end
        assign q=r[N+2];
      end else assign q=d;
    endmodule
    module Desc #(parameter N=0)(input logic clk, rst, input logic [7:0] d,
                                 output logic [7:0] q);
      if (N>0) begin : pipe
        logic [7:0] r[N+2:3];
        for(genvar n=0;n<N;n++) begin : stage
          always_ff @(posedge clk)
            if (rst) r[n+3] <= '0;
            else r[n+3] <= n==0 ? d : r[n+2];
        end
        assign q=r[N+2];
      end else assign q=d;
    endmodule
    module Top(input logic clk, rst, input logic [7:0] d,
               output logic [7:0] a1,a2,a4,b1,b2,b4);
      Asc #(.N(1)) u1(clk,rst,d,a1);
      Asc #(.N(2)) u2(clk,rst,d,a2);
      Asc #(.N(4)) u4(clk,rst,d,a4);
      Desc #(.N(1)) v1(clk,rst,d,b1);
      Desc #(.N(2)) v2(clk,rst,d,b2);
      Desc #(.N(4)) v4(clk,rst,d,b4);
    endmodule
  "#)
  (top Top)
  (modify (set rst 1))
  (tick clk)
  (modify (set rst 0))
  (for cycle (range 1 8)
    (modify (set d (* cycle 17)))
    (tick clk)
    (assert_eq a1 (* cycle 17))
    (assert_eq b1 (* cycle 17))
    (assert_eq a2 (? (> cycle 1) (* (- cycle 1) 17) 0))
    (assert_eq b2 (? (> cycle 1) (* (- cycle 1) 17) 0))
    (assert_eq a4 (? (> cycle 3) (* (- cycle 3) 17) 0))
    (assert_eq b4 (? (> cycle 3) (* (- cycle 3) 17) 0))))

(case invalid_unpacked_elements_preserve_type_in_conditionals
  ; Both conditional operands contribute width and signedness even when
  ; a constant condition selects the other operand (11.4.11, 11.8.2).
  (four_state)
  (source "invalid_array_element_types.sv" #"
    module Top(output logic [15:0] mixed_sign, both_signed,
               output logic [31:0] width);
      logic [15:0] u[1];
      logic signed [15:0] s[1];
      assign mixed_sign=1'b1 ? 8'sh80 : u[-1];
      assign both_signed=1'b1 ? 8'sh80 : s[-1];
      assign width=$bits(1'b1 ? 8'sh80 : u[-1]);
    endmodule
  "#)
  (top Top)
  (assert_eq mixed_sign 0x0080)
  (assert_eq both_signed 0xff80)
  (assert_eq width 16))

(case generated_pipeline_with_explicit_generate_branches
  ; Separate FF producers may share one array. Removing a task's staging
  ; must preserve publication of elements computed by other tasks (10.4.2).
  (source "generated_pipeline.sv" #"
    module Asc #(parameter N=0)(input logic clk, rst, input logic [7:0] d,
                                output logic [7:0] q);
      if (N>0) begin : pipe
        logic [7:0] r[3:N+2];
        for(genvar n=0;n<N;n++) begin : stage
          if (n==0) begin
            always_ff @(posedge clk) if(rst) r[n+3]<='0; else r[n+3]<=d;
          end else begin
            always_ff @(posedge clk) if(rst) r[n+3]<='0; else r[n+3]<=r[n+2];
          end
        end
        assign q=r[N+2];
      end else assign q=d;
    endmodule
    module Desc #(parameter N=0)(input logic clk, rst, input logic [7:0] d,
                                 output logic [7:0] q);
      if (N>0) begin : pipe
        logic [7:0] r[N+2:3];
        for(genvar n=0;n<N;n++) begin : stage
          if (n==0) begin
            always_ff @(posedge clk) if(rst) r[n+3]<='0; else r[n+3]<=d;
          end else begin
            always_ff @(posedge clk) if(rst) r[n+3]<='0; else r[n+3]<=r[n+2];
          end
        end
        assign q=r[N+2];
      end else assign q=d;
    endmodule
    module Top(input logic clk, rst, input logic [7:0] d,
               output logic [7:0] a1,a2,a4,b1,b2,b4);
      Asc #(.N(1)) u1(clk,rst,d,a1);
      Asc #(.N(2)) u2(clk,rst,d,a2);
      Asc #(.N(4)) u4(clk,rst,d,a4);
      Desc #(.N(1)) v1(clk,rst,d,b1);
      Desc #(.N(2)) v2(clk,rst,d,b2);
      Desc #(.N(4)) v4(clk,rst,d,b4);
    endmodule
  "#)
  (top Top)
  (modify (set rst 1))
  (tick clk)
  (modify (set rst 0))
  (for cycle (range 1 8)
    (modify (set d (* cycle 17)))
    (tick clk)
    (assert_eq a1 (* cycle 17))
    (assert_eq b1 (* cycle 17))
    (assert_eq a2 (? (> cycle 1) (* (- cycle 1) 17) 0))
    (assert_eq b2 (? (> cycle 1) (* (- cycle 1) 17) 0))
    (assert_eq a4 (? (> cycle 3) (* (- cycle 3) 17) 0))
    (assert_eq b4 (? (> cycle 3) (* (- cycle 3) 17) 0))))
