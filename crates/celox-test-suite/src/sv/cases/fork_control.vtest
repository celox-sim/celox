(group fork_control (category sequential))

; IEEE 1800-2023 9.6.1 and 9.6.3: immediate-child waits vs descendant cancellation.
(case no_children_does_not_suspend
 (source "empty.sv" #"module Top(output int q);
 initial begin q=0; wait fork; disable fork; q=1; end
endmodule"#)
 (top Top) (run_until 0) (assert_eq q 1))

(case wait_in_task_includes_earlier_forks
 (source "wait_task.sv" #"module Top(output bit [3:0] q);
 task await_children;
  fork begin #2; q[1]=1; end join_none
  wait fork;
  q[3]=1;
 endtask
 initial begin
  fork begin #3; q[0]=1; end join_none
  fork begin #1; q[2]=1; end join_any
  await_children();
 end
endmodule"#)
 (top Top) (run_until 2) (assert_eq q 4)
 (run_until 3) (assert_eq q 15))

(case wait_excludes_descendants_of_completed_children
 (source "wait_immediate.sv" #"module Top(output bit [2:0] q);
 initial begin
  fork
   begin fork begin #4; q[0]=1; end join_none end
   begin #1; q[1]=1; end
  join_none
  wait fork; q[2]=1;
 end
endmodule"#)
 (top Top) (run_until 1) (assert_eq q 6)
 (run_until 4) (assert_eq q 7))

(case disable_before_children_start
 (source "disable_pending.sv" #"module Top(output int q);
 initial begin
  q=0;
  fork begin q=99; #1; q=100; end join_none
  disable fork;
  wait fork;
  q=1;
 end
endmodule"#)
 (top Top) (run_until 3) (assert_eq q 1))

(case disable_after_join_any_cancels_waiters_and_delays
 (source "disable_waiters.sv" #"module Top(output bit [4:0] q);
 bit trigger;
 initial begin
  fork
   begin #1; q[0]=1; end
   begin #4; q[1]=1; end
   begin @(posedge trigger); q[2]=1; end
   begin wait(trigger); q[3]=1; end
  join_any
  disable fork;
  wait fork;
  q[4]=1;
  #1; trigger=1;
 end
endmodule"#)
 (top Top) (run_until 5) (assert_eq q 17))

(case disable_reaches_through_completed_parents
 (source "disable_descendants.sv" #"module Top(output bit [1:0] q);
 initial begin
  fork begin
   fork begin #4; q[0]=1; end join_none
  end join_none
  wait fork;
  #1;
  disable fork;
  q[1]=1;
 end
endmodule"#)
 (top Top) (run_until 5) (assert_eq q 2))

(case disable_does_not_kill_siblings_or_caller
 (source "disable_scope.sv" #"module Top(output bit [2:0] q);
 initial begin
  fork
   begin
    fork begin #3; q[0]=1; end join_none
    #1; disable fork; wait fork; q[1]=1;
   end
   begin #2; q[2]=1; end
  join
 end
endmodule"#)
 (top Top) (run_until 4) (assert_eq q 6))

(case disable_removes_nested_join_waits
 (source "disable_nested_join.sv" #"module Top(output bit [3:0] q);
 initial begin
  fork begin
   fork begin #3; q[0]=1; end begin #4; q[1]=1; end join
   q[2]=1;
  end join_none
  #1; disable fork;
  wait fork; q[3]=1;
 end
endmodule"#)
 (top Top) (run_until 5) (assert_eq q 8))

(case cancelled_ids_can_be_reused_without_stale_wakeups
 (source "disable_reuse.sv" #"module Top(output int q);
 int n=20;
 initial begin
  q=0;
  for (int i=0; i<n; i++) begin
   fork begin #3; q=1000; end join_none
   #1; disable fork;
   fork begin #5; q=q+1; end join_none
   wait fork;
  end
 end
endmodule"#)
 (top Top) (run_until 130) (assert_eq q 20))

(case program_waits_then_cancels_in_reactive_region
 (source "program_fork_control.sv" #"module Top(output bit [2:0] q);
 Tb tb(q);
endmodule
program Tb(output bit [2:0] q);
 initial begin
  q=0;
  fork begin #1; q[0]=1; end join_none
  wait fork;
  fork begin #3; q[1]=1; end join_none
  disable fork; q[2]=1;
  #10;
 end
endprogram"#)
 (top Top) (run_until 5) (assert_eq q 5))

(case function_disable_uses_calling_process
 (source "function_disable.sv" #"module Top(output int q);
 function int cancel();
  disable fork;
  return 1;
 endfunction
 initial begin
  q=0;
  fork begin #3; q=99; end join_none
  #1; q=cancel();
  wait fork;
 end
endmodule"#)
 (top Top) (run_until 5) (assert_eq q 1))

(case four_state_values_survive_wait_and_cancellation
 (four_state)
 (source "four_state_control.sv" #"module Top(output logic [3:0] q);
 initial begin
  q=0;
  fork begin #1; q=4'b10xz; end join_none
  wait fork;
  fork begin #2; q=0; end join_none
  disable fork;
 end
endmodule"#)
 (top Top) (run_until 4) (assert_eq q (fourstate 10 3)))

(case wait_predicate_preserves_cancellation
 (source "wait_cancel.sv" #"module Top(output int q);
 function int cancel();
  disable fork;
  return 1;
 endfunction
 initial begin
  q=0;
  fork begin #3; q=99; end join_none
  #1; wait(cancel()); q=1;
 end
endmodule"#)
 (top Top) (run_until 5) (assert_eq q 1))

(case wait_predicate_repeats_effects_on_each_wakeup
 (source "wait_cancel_resume.sv" #"module Top(output int q, output bit [2:0] seen);
 int gate=0;
 function int cancel(input int value);
  seen=seen | (1 << value);
  disable fork;
  return value==2;
 endfunction
 initial begin
  seen=0; q=0;
  fork begin #4; q=99; end join_none
  wait(cancel(gate)); q=1;
 end
 initial begin #1; gate=1; #1; gate=2; end
endmodule"#)
 (top Top) (run_until 5) (assert_eq q 1) (assert_eq seen 7))

(case event_driven_caller_propagates_wait_fork_through_tasks
 (source "event_wait_fork.sv" #"module Top(input bit clk, output int q);
 task await_children; wait fork; endtask
 task wrapper; await_children(); endtask
 always @(posedge clk) begin wrapper(); q=q+1; end
endmodule"#)
 (top Top) (run_until 0) (assert_eq q 0)
 (modify (set clk 1)) (run_until 1) (assert_eq q 1)
 (modify (set clk 0)) (run_until 2)
 (modify (set clk 1)) (run_until 3) (assert_eq q 2))

(case event_driven_caller_spawns_untimed_children
 (source "event_spawn.sv" #"module Top(input bit clk, output int q);
 task spawn; fork q=q+1; join_none endtask
 always @(posedge clk) spawn();
endmodule"#)
 (top Top) (run_until 0) (assert_eq q 0)
 (modify (set clk 1)) (run_until 1) (assert_eq q 1)
 (modify (set clk 0)) (run_until 2)
 (modify (set clk 1)) (run_until 3) (assert_eq q 2))

; 13.4.4: detached function children retain automatic arguments/locals after return.
(case function_join_none_automatic_values_outlive_returns
 (source "function_fork.sv" #"module Top(output int total, returns, early);
 function automatic int launch(input int v);
  int copy = v;
  fork begin #2; total += copy; end join_none
  return copy + 10;
 endfunction
 initial begin
  total=0; returns=0; early=0;
  for (int i=1; i<=3; i++) returns += launch(i);
  early = total;
  #3; returns += launch(4); wait fork;
 end
endmodule"#)
 (top Top) (run_until 0) (assert_eq returns 36) (assert_eq early 0) (assert_eq total 0)
 (run_until 2) (assert_eq total 6)
 (run_until 5) (assert_eq total 10) (assert_eq returns 50))

(case function_join_none_children_can_call_timed_tasks
 (source "function_task.sv" #"module Top(output int q);
 task automatic delayed(input int x); #2; q += x; endtask
 function automatic int launch(input int x);
  fork begin fork delayed(x); begin #1; q += 4; end join end join_none
  return x;
 endfunction
 initial begin q = launch(3); #3; end
endmodule"#)
 (top Top) (run_until 0) (assert_eq q 3)
 (run_until 1) (assert_eq q 7) (run_until 3) (assert_eq q 10))

(case function_join_none_calls_in_defaults_need_process_frames
 (source "function_default.sv" #"module Top(output int q, r);
 function automatic int launch(input int x);
  fork begin #1; q += x; end join_none
  return x;
 endfunction
 function automatic int wrapper(input int x = launch(3)); return x; endfunction
 initial begin q=0; r = wrapper(); r += wrapper(4); #2; end
endmodule"#)
 (top Top) (run_until 0) (assert_eq q 0) (assert_eq r 7)
 (run_until 2) (assert_eq q 3))


(case function_join_none_event_driven_caller
 (source "function_event.sv" #"module Top(input bit clk, output int q, r);
 function automatic int launch(input int x);
  fork begin #1; q += x; end join_none
  return x;
 endfunction
 initial begin q=0; r=0; end
 always @(posedge clk) r = launch(3);
endmodule"#)
 (top Top) (run_until 0) (assert_eq q 0)
 (modify (set clk 1)) (run_until 1) (assert_eq r 3)
 (run_until 2) (assert_eq q 3)
 (modify (set clk 0)) (run_until 3)
 (modify (set clk 1)) (run_until 5) (assert_eq q 6))

(case function_join_none_preserves_expression_temporaries
 (four_state)
 (source "function_expression.sv" #"module Top(output int q, r, paired);
 int live_value;
 function automatic int launch(input int x);
  fork begin #1; q += x; end join_none
  return x + 10;
 endfunction
 initial begin
  q=0; live_value=7;
  r = live_value + launch(3);
  paired = launch(4) + launch(5);
  wait fork;
 end
endmodule"#)
 (top Top) (run_until 0) (assert_eq q 0) (assert_eq r 20) (assert_eq paired 29)
 (run_until 2) (assert_eq q 12))

(case function_join_none_retains_child_only_class_handle
 (source "function_class.sv" #"module Top(output int q, r);
 class Cell;
  int value;
  function new(int v); value=v; endfunction
 endclass
 function automatic int launch(input int x);
  Cell object = new(x);
  fork begin #1; q += object.value; end join_none
  return x;
 endfunction
 initial begin q=0; r=launch(3); r+=launch(4); #2; end
endmodule"#)
 (top Top) (run_until 0) (assert_eq q 0) (assert_eq r 7)
 (run_until 2) (assert_eq q 7))

(case process_identity_and_status
 (source "process.sv" #"
module Top(output int checks, late);
 process root, child, old_child, replacement;
 process::state state;
 initial begin late=0;
  root=process::self(); checks=(root!=null && root==process::self());
  checks += (root.status()==process::RUNNING)*2;
  fork begin child=process::self(); #4; late=1; end join_none
  #1;
  state=child.status(); checks += (state==process::WAITING)*4;
  child.kill(); old_child=child;
  checks += (child.status()==process::KILLED)*8;
  fork begin replacement=process::self(); #1; end join_none
  #2;
  checks += (old_child!=replacement && old_child.status()==process::KILLED)*16;
  checks += (replacement.status()==process::FINISHED)*32;
  #4; checks += (late==0)*64;
 end
endmodule"#)
 (top Top) (run_until 8) (assert_eq checks 127) (assert_eq late 0))

; An associative array may take process handles as indices, as UVM's
; uvm_tlm_fifo does to track its blocked getters; an entry stays after its
; process ends (IEEE 1800-2023 7.8, 9.7).
(case process_handles_index_associative_arrays
 (source "process.sv" #"
module Top(output int checks, pending, left);
 class Fifo;
  protected bit m_pending[process];
  mailbox #(int) m = new();
  task get(output int t);
   process pid;
   pid = process::self();
   m_pending[pid] = 1;
   m.get(t);
   m_pending.delete(pid);
  endtask
  function void clear_zombies();
   process zombies[$];
   foreach (m_pending[i]) begin
    int status;
    status = i.status();
    if (status == process::KILLED) zombies.push_back(i);
   end
   foreach (zombies[i]) m_pending.delete(zombies[i]);
  endfunction
  function int blocked();
   return m_pending.size();
  endfunction
 endclass
 Fifo f = new();
 process a, b, c, k;
 bit seen[process];
 int got, count, matched;
 initial begin
  checks = 0;
  fork
   begin a = process::self(); f.get(got); end
   begin b = process::self(); f.get(got); end
  join_none
  #1;
  pending = f.blocked();
  b.kill();
  f.clear_zombies();
  left = f.blocked();
  f.m.put(5);
  #1;
  checks += (got == 5 && a.status() == process::FINISHED);
  checks += (f.blocked() == 0) * 2;
  fork begin c = process::self(); seen[c] = 1; end join_none
  #1;
  seen[process::self()] = 0;
  checks += (c.status() == process::FINISHED && seen.exists(c) && seen[c] == 1) * 4;
  checks += (seen.num() == 2) * 8;
  count = 0;
  if (seen.first(k)) do count++; while (seen.next(k));
  checks += (count == 2) * 16;
  matched = 0;
  foreach (seen[p]) if (p == c || p == process::self()) matched++;
  checks += (matched == 2) * 32;
  seen.delete(c);
  checks += (!seen.exists(c) && seen.num() == 1) * 64;
 end
endmodule"#)
 (top Top) (run_until 4) (assert_eq pending 2) (assert_eq left 1) (assert_eq checks 127))

(case process_finished_parent_kills_descendants
 (source "process.sv" #"
module Top(output int checks, late);
 process parent, leaf;
 initial begin late=0;
  fork begin
   parent=process::self();
   fork begin leaf=process::self(); #10; late=1; end join_none
   #1;
  end join_none
  #2;
  checks=(parent.status()==process::FINISHED);
  parent.kill();
  checks += (parent.status()==process::FINISHED)*2;
  checks += (leaf.status()==process::KILLED)*4;
  leaf.await(); parent.await();
  #10; checks += (late==0)*8;
 end
endmodule"#)
 (top Top) (run_until 12) (assert_eq checks 15) (assert_eq late 0))

(case process_suspend_and_resume_waits
 (source "process.sv" #"
module Top(output int delayed, event_time, level_time, checks);
 process a,b,c;
 bit event_signal, flag;
 initial begin delayed=0; event_time=0; level_time=0;
  fork
   begin a=process::self(); #5; delayed=$time; end
   begin b=process::self(); @(posedge event_signal); event_time=$time; end
   begin c=process::self(); wait(flag); level_time=$time; end
  join_none
  #1; a.suspend(); b.suspend(); c.suspend();
  checks=(a.status()==process::SUSPENDED && b.status()==process::SUSPENDED && c.status()==process::SUSPENDED);
  #2; flag=1; event_signal=1;
  #4; a.resume(); b.resume(); c.resume();
  #1; checks+=(delayed==7 && level_time==7 && event_time==0)*2;
  event_signal=0;
  #1; event_signal=1;
  b.await(); checks+=(b.status()==process::FINISHED)*4;
 end
endmodule"#)
 (top Top) (run_until 10) (assert_eq checks 7) (assert_eq delayed 7) (assert_eq level_time 7) (assert_eq event_time 9))

(case process_self_suspend_and_await
 (source "process.sv" #"
module Top(output int phase, finished_at, checks);
 process worker;
 initial begin phase=0; finished_at=0;
  fork begin
   worker=process::self(); worker.suspend(); phase=1; #3; phase=2;
  end join_none
  #2; checks=(worker.status()==process::SUSPENDED && phase==0);
  worker.resume(); worker.await(); finished_at=$time;
  checks+=(worker.status()==process::FINISHED && phase==2)*2;
  worker.suspend(); worker.resume(); worker.kill();
  checks+=(worker.status()==process::FINISHED)*4;
 end
endmodule"#)
 (top Top) (run_until 6) (assert_eq checks 7) (assert_eq phase 2) (assert_eq finished_at 5))

(case process_status_wait_and_disable
 (source "process.sv" #"
module Top(output int checks, observed_at, late);
 process child, victim;
 initial begin checks=0; observed_at=0; late=0;
  fork begin child=process::self(); #3; end join_none
  #1; wait(child.status()==process::FINISHED); observed_at=$time;
  checks=(child.status()==process::FINISHED);
  fork begin victim=process::self(); #10; late=1; end join_none
  #1; disable fork;
  checks+=(victim.status()==process::KILLED)*2;
 end
endmodule"#)
 (top Top) (run_until 15) (assert_eq checks 3) (assert_eq observed_at 3) (assert_eq late 0))

(case process_random_state_and_handles
 (source "process.sv" #"
module Top(output int checks);
 class Holder; process saved; endclass
 process p, queue[$];
 Holder holder;
 string state, text;
 int unsigned a,b;
 initial begin
  holder=new(); p=process::self(); holder.saved=process::self();
  queue.push_back(process::self()); p=queue.pop_front();
  checks=(p==holder.saved && p==process::self());
  holder.saved.srandom(42); state=p.get_randstate(); text={"state:",p.get_randstate()};
  a=$urandom; p.set_randstate(state); b=$urandom;
  checks+=(a==b && state.len()>0 && text.len()>6)*2;
  p.srandom(42); b=$urandom; checks+=(a==b)*4;
 end
endmodule"#)
 (top Top) (run_until 0) (assert_eq checks 7))

; User declarations take precedence over the implicit std wildcard import (26.7).
(case process_package_constants_keep_their_scope
 (source "process_package.sv" #"
package process;
 parameter int FINISHED=8, RUNNING=9, WAITING=10, SUSPENDED=11, KILLED=12;
 function int self(); return 13; endfunction
endpackage"#)
 (source "process_names.sv" #"
module Top(output int checks);
 initial begin
  checks=(process::FINISHED==8);
  checks+=(process::RUNNING==9)*2;
  checks+=(process::WAITING==10)*4;
  checks+=(process::SUSPENDED==11)*8;
  checks+=(process::KILLED==12)*16;
  checks+=(process::self()==13)*32;
 end
endmodule"#)
 (top Top) (run_until 0) (assert_eq checks 63))

; Cancellation of the last program initial implies finish (24.3).
(case process_self_kill_finishes_program
 (source "process_program.sv" #"
module Top(output int ticks);
 Tb tb();
 initial begin ticks=0; forever #2 ticks++; end
 initial #10 $finish;
 final $display("final at %0d", $time);
endmodule
program Tb;
 initial begin
  process p;
  p=process::self(); #3; p.kill();
  $display("unreachable");
 end
endprogram"#)
 (top Top) (run_to_finish) (assert_eq ticks 1) (expect_output "final at 3\n"))

(case process_external_kill_finishes_program
 (source "process_program.sv" #"
package handles; process victim; endpackage
module Top(output int ticks);
 Tb tb();
 initial begin ticks=0; forever #2 ticks++; end
 initial #10 $finish;
 final $display("final at %0d", $time);
 import handles::victim;
 initial begin #3; victim.kill(); $display("unreachable"); end
endmodule
program Tb;
 initial begin handles::victim=process::self(); #100; end
endprogram"#)
 (top Top) (run_to_finish) (assert_eq ticks 1) (expect_output "final at 3\n"))

; $exit ends all initial procedures of its program (24.7); observers of a
; sibling must see completion even though that sibling did not execute $exit.
(case process_program_exit_wakes_sibling_observers
 (source "process_exit.sv" #"
package handles; process sibling; endpackage
module Top(output bit [1:0] checks, output int awaited_at, observed_at, late);
 Producer producer(late);
 Consumer consumer(checks, awaited_at, observed_at);
endmodule
program Producer(output int late);
 initial begin late=0; handles::sibling=process::self(); #30; late=1; end
 initial begin #3; $exit; end
endprogram
program Consumer(output bit [1:0] checks, output int awaited_at, observed_at);
 import handles::sibling;
 initial begin
  checks[0]=0; awaited_at=0;
  #1; sibling.await(); awaited_at=$time; checks[0]=1;
  #20;
 end
 initial begin
  checks[1]=0; observed_at=0;
  #1; wait(sibling.status()==process::FINISHED); observed_at=$time; checks[1]=1;
  #20;
 end
endprogram"#)
 (top Top) (run_until 5) (assert_eq checks 3) (assert_eq awaited_at 3)
 (assert_eq observed_at 3) (assert_eq late 0))

; A false status predicate stays WAITING; it must not notify its own observers
; repeatedly and prevent the cancellation scheduled at time 3 (9.7).
(case process_mutual_status_waits_advance_to_cancellation
 (source "process_cycle.sv" #"
module Top(output bit [1:0] checks, output int observed_at);
 process first, second;
 initial begin
  checks=0; observed_at=0;
  fork
   begin first=process::self(); wait(second!=null);
    wait(second.status()==process::FINISHED); checks[0]=1;
   end
   begin second=process::self(); wait(first!=null);
    wait(first.status()==process::KILLED); checks[1]=1; observed_at=$time;
   end
  join_none
  #3; first.kill();
 end
endmodule"#)
 (top Top) (run_until 5) (assert_eq checks 2) (assert_eq observed_at 3))

; Killing the last program during finalization must leave both finals intact.
; Identical writes avoid depending on final-procedure ordering (9.2.3, 24.3).
(case process_final_kill_preserves_cleanup
 (source "process_final.sv" #"
package handles; process victim; endpackage
module Top;
 import handles::victim;
 Tb tb();
 initial #3 $finish;
 final begin victim.kill(); $write("cleanup;"); end
 final $write("cleanup;");
endmodule
program Tb;
 initial begin handles::victim=process::self(); #30; end
endprogram"#)
 (top Top) (run_to_finish) (expect_output "cleanup;cleanup;"))

; User package qualifiers also win over std's implicit class in type binding.
(case process_package_qualified_types_keep_their_scope
 (source "process_types.sv" #"
package process;
 typedef bit [63:0] state;
 typedef logic [127:0] payload;
endpackage"#)
 (source "process_type_user.sv" #"
module Top(output int checks);
 process::state value;
 process::payload data;
 initial begin
  value=64'h8000000000000000;
  data=128'h80000000000000000000000000000000;
  checks=($bits(value)==64);
  checks+=($bits(data)==128)*2;
  checks+=value[63]*4;
  checks+=data[127]*8;
 end
endmodule"#)
 (top Top) (run_until 0) (assert_eq checks 15))

; All final procedures execute in one process, independent of their order (9.2.3).
(case process_final_procedures_share_identity_and_rng
 (source "final_identity.sv" #"
package phase;
 process saved;
 string last_state;
 function automatic void visit();
  process p;
  string prior_state, following_state;
  int unsigned a,b;
  bit valid;
  p=process::self(); valid=(saved==null || saved==p);
  if(saved==null) begin saved=p; p.srandom(42); end
  else valid=valid && p.get_randstate()==last_state;
  valid=valid && saved.status()==process::RUNNING;
  prior_state=p.get_randstate(); a=$urandom; following_state=p.get_randstate();
  p.set_randstate(prior_state); b=$urandom;
  valid=valid && a==b && p.get_randstate()==following_state;
  last_state=following_state;
  if(valid) $write("ok;"); else $write("bad;");
 endfunction
endpackage
module Top;
 Child child();
 initial begin phase::saved=null; phase::last_state=""; #1 $finish; end
 final phase::visit();
 final phase::visit();
endmodule
module Child;
 final phase::visit();
endmodule"#)
 (top Top) (run_to_finish) (expect_output "ok;ok;ok;"))

; Killing an ancestor also retires the running caller. Its latest RNG draw
; must be saved before that retirement (9.7, 18.13.3-18.13.5).
(case process_ancestor_kill_preserves_caller_rng
 (source "ancestor_rng.sv" #"
module Top(output int checks, late);
 process root, ancestor, child;
 int unsigned reference_first, reference_second, child_draw;
 initial begin
  checks=0; late=0; child_draw=0;
  root=process::self(); root.srandom(42);
  reference_first=$urandom; reference_second=$urandom;
  fork begin
   ancestor=process::self();
   fork begin
    child=process::self(); child.srandom(42);
    child_draw=$urandom; ancestor.kill(); late=1;
   end join_none
   #30;
  end join_none
  #1;
  checks=(child_draw==reference_first);
  checks+=(ancestor.status()==process::KILLED)*2;
  checks+=(child.status()==process::KILLED)*4;
  root.set_randstate(child.get_randstate());
  checks+=($urandom==reference_second)*8;
  checks+=(late==0)*16;
 end
endmodule"#)
 (top Top) (run_until 2) (assert_eq checks 31) (assert_eq late 0))

; Process calls later in a nested loop still classify an earlier wait as a
; level wait. On resume, a predicate made true while suspended is rechecked (9.7).
(case process_nested_calls_preserve_level_wait_resume
 (source "nested_level.sv" #"
module Top(output int count, resumed_at, checks);
 bit go;
 process worker;
 initial begin
  count=0; resumed_at=0; checks=0; go=0;
  forever begin
   wait(go);
   if(go) begin worker=process::self(); go=0; count++; resumed_at=$time; end
  end
 end
 initial begin
  #1; go=1;
  #1; worker.suspend();
  #1; go=1;
  #1; worker.resume();
  #1; checks=(count==2 && resumed_at==4); worker.kill();
 end
endmodule"#)
 (top Top) (run_until 6)
 (assert_eq count 2) (assert_eq resumed_at 4) (assert_eq checks 1))

; Automatic event operands remain shared with a sibling during suspension.
; Resume samples their current expression, discarding the suspended change (9.7).
(case process_resume_resamples_automatic_event_expression
 (source "resume_probe.sv" #"
module Top(output int hits, event_at);
 process worker;
 initial begin
  automatic bit x=0, y=0;
  hits=0; event_at=0;
  fork
   begin worker=process::self(); @(x ^ y); hits++; event_at=$time; end
   begin #2; x=1; #4; y=1; end
  join_none
  #1; worker.suspend();
  #3; worker.resume();
 end
endmodule"#)
 (top Top) (run_until 5) (assert_eq hits 0) (assert_eq event_at 0)
 (run_until 7) (assert_eq hits 1) (assert_eq event_at 6))

; $exit ends every process in its program, including suspended delay waits.
; A different live program cannot restart an ended continuation with resume (24.7, 9.7).
(case process_resume_after_program_exit_is_noop
 (source "exit_resume.sv" #"
package handles;
 process victim;
endpackage
module Top(output int late, checks, ended_state);
 Producer producer(late);
 Consumer consumer(checks, ended_state);
endmodule
program Producer(output int late);
 import handles::victim;
 initial begin late=0; victim=process::self(); #6; late=1; end
 initial begin #1; victim.suspend(); #1; $exit; end
endprogram
program Consumer(output int checks, ended_state);
 import handles::victim;
 initial begin
  checks=0; ended_state=0;
  #3; ended_state=victim.status(); checks=(ended_state==process::FINISHED);
  victim.resume();
  #5; checks+=(victim.status()==process::FINISHED)*2;
  #2;
 end
endprogram"#)
 (top Top) (run_until 9)
 (assert_eq late 0) (assert_eq checks 3) (assert_eq ended_state 0))
