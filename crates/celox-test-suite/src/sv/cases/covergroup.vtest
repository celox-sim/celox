 endgroup
 cg c1 = new, c2 = new;
 initial begin
  a = 0; b = 0; c1.sample();
  a = 2; b = 3; c2.sample();
  a = 3; b = 0; c2.sample();
  $display("%0.2f %0.2f %0.2f", c1.pa.get_inst_coverage(), cg::pb::get_coverage(), c1.pa.get_coverage());
  $display("%0.2f %0.2f", c2.x.get_inst_coverage(), cg::x::get_coverage());
 end
endmodule"#)
 (top Top) (run_until 0)
 (expect_output "50.00 75.00 50.00\n50.00 37.50\n"))

; 19.8: a stopped covergroup collects nothing until it is started again,
; and a stopped coverpoint counts no sample while the others do.
(case stop_and_start_control_collection
 (source "start_stop.sv" #"module Top;
 bit [1:0] a, b;
 covergroup cg;
  ca: coverpoint a;
  cb: coverpoint b;
 endgroup
 cg c = new;
 int covered, total;
 initial begin
  a = 0; b = 0; c.sample();
  c.stop();
  a = 1; b = 1; c.sample();
  c.start();
  c.cb.stop();
  a = 2; b = 2; c.sample();
  c.cb.start();
  a = 3; b = 3; c.sample();
  void'(c.ca.get_inst_coverage(covered, total)); $display("%0d %0d", covered, total);
  void'(c.cb.get_inst_coverage(covered, total)); $display("%0d %0d", covered, total);
 end
endmodule"#)
 (top Top) (run_until 0)
 (expect_output "3 4\n2 4\n"))

; 19.3: an instance that a declaration constructs is sampled at each
; occurrence of the clocking event of its type. A flip-flop updates `q`
; with a nonblocking assignment at the rising edge, so the rising edges see
; 0 to 3 and the falling edges 1 to 4.
(case clocking_events_sample_at_each_edge
 (source "clocking_edges.sv" #"module Top;
 bit clk = 0;
 bit [2:0] q = 0;
 always #5 clk = ~clk;
 always_ff @(posedge clk) q <= q + 3'd1;
 covergroup pos @(posedge clk);
  early: coverpoint q { bins b[] = {[0:3]}; }
  late: coverpoint q { bins b[] = {[4:7]}; }
 endgroup
 covergroup neg @(negedge clk);
  early: coverpoint q { bins b[] = {0}; }
  late: coverpoint q { bins b[] = {[1:4]}; }
 endgroup
 pos p = new;
 neg n = new;
 int covered, total;
 initial begin
  #42;
  void'(p.early.get_inst_coverage(covered, total)); $display("%0d %0d", covered, total);
  void'(p.late.get_inst_coverage(covered, total)); $display("%0d %0d", covered, total);
  void'(n.early.get_inst_coverage(covered, total)); $display("%0d %0d", covered, total);
  void'(n.late.get_inst_coverage(covered, total)); $display("%0d %0d", covered, total);
  $finish;
 end
endmodule"#)
 (top Top) (run_to_finish)
 (expect_output "4 4\n0 4\n0 1\n4 4\n"))

; 19.3, 9.4.2: a clocking event is any event control: a change, `edge`, an
; `or` list of edges, and an edge with an `iff` condition (9.4.2.3), which
; holds at the event. `n` counts the changes of `clk` with a nonblocking
; assignment, so the k-th change sees k - 1; `en` toggles the same way at
; each rising edge, so the `iff` holds at the second and fourth.
(case clocking_event_forms_sample_their_occurrences
 (source "clocking_forms.sv" #"module Top;
 bit clk = 0;
 bit en = 0;
 bit [2:0] n = 0;
 always #5 clk = ~clk;
 always @(clk) n <= n + 3'd1;
 always @(posedge clk) en <= ~en;
 covergroup change @(clk); coverpoint n { bins b[] = {[0:7]}; } endgroup
 covergroup both @(edge clk); coverpoint n { bins b[] = {[0:7]}; } endgroup
 covergroup listed @(posedge clk or negedge clk); coverpoint n { bins b[] = {[0:7]}; } endgroup
 covergroup rising @(posedge clk); coverpoint n { bins even[] = {0, 2, 4, 6}; bins odd[] = {1, 3, 5, 7}; } endgroup
 covergroup gated @(posedge clk iff en); coverpoint n { bins b[] = {[0:7]}; } endgroup
 change c = new;
 both b = new;
 listed l = new;
 rising r = new;
 gated g = new;
 int covered, total;
 initial begin
  #42;
  void'(c.get_inst_coverage(covered, total)); $display("%0d %0d", covered, total);
  void'(b.get_inst_coverage(covered, total)); $display("%0d %0d", covered, total);
  void'(l.get_inst_coverage(covered, total)); $display("%0d %0d", covered, total);
  void'(r.get_inst_coverage(covered, total)); $display("%0d %0d", covered, total);
  void'(g.get_inst_coverage(covered, total)); $display("%0d %0d", covered, total);
  $display("%0.2f", g.get_inst_coverage());
  $finish;
 end
endmodule"#)
 (top Top) (run_to_finish)
 (expect_output "8 8\n8 8\n8 8\n4 8\n2 8\n25.00\n"))

; 19.3, 15.5.2: a named event, and an `or` of two, as the clocking event:
; each trigger is a sample of the value at the trigger.
(case named_events_sample_their_triggers
 (source "clocking_named.sv" #"module Top;
 event e, f;
 bit [1:0] v = 0;
 covergroup one @e; coverpoint v { bins b[] = {[0:3]}; } endgroup
 covergroup two @(e or f); coverpoint v { bins b[] = {[0:3]}; } endgroup
 one o = new;
 two t = new;
 int covered, total;
 initial begin
  #1 v = 1; -> e;
  #1 v = 2; -> f;
  #1 v = 3; -> e;
  #1;
  void'(o.get_inst_coverage(covered, total)); $display("%0d %0d", covered, total);
  void'(t.get_inst_coverage(covered, total)); $display("%0d %0d", covered, total);
  $finish;
 end
endmodule"#)
 (top Top) (run_to_finish)
 (expect_output "2 4\n3 4\n"))

; 19.3, 27.4: each declaration in a generate loop constructs and samples an
; instance of its own, with the arguments of its iteration.
(case instances_of_a_generate_loop_sample_their_own
 (source "clocking_generate.sv" #"module Top;
 bit clk = 0;
 bit [2:0] q = 0;
 always #5 clk = ~clk;
 always_ff @(posedge clk) q <= q + 3'd1;
 covergroup cg(int k) @(posedge clk); coverpoint q { bins hit = {k}; bins other = default; } endgroup
 for (genvar i = 0; i < 3; i++) begin : g
  cg c = new(2 * i);
  initial #(42 + i) $display("%0d %0.2f", i, c.get_inst_coverage());
 end
 initial #50 $finish;
endmodule"#)
 (top Top) (run_to_finish)
 (expect_output "0 100.00\n1 100.00\n2 0.00\n"))

; 19.8: an instance sampled at its clocking event takes the predefined
; methods: `stop()` stops the sampling until `start()`, and `sample()`
; samples it once more.
(case clocked_instances_take_stop_start_and_sample
 (source "clocking_methods.sv" #"module Top;
 bit clk = 0;
 bit [2:0] q = 0;
 always #5 clk = ~clk;
 always_ff @(posedge clk) q <= q + 3'd1;
 covergroup cg @(posedge clk); coverpoint q { bins b[] = {[0:7]}; } endgroup
 cg c = new;
 int covered, total;
 initial begin
  #12 c.stop();
  #10 c.start();
  #1 c.sample();
  #19;
  void'(c.get_inst_coverage(covered, total)); $display("%0d %0d", covered, total);
  $display("%0.2f", c.q.get_inst_coverage());
  $finish;
 end
endmodule"#)
 (top Top) (run_to_finish)
 (expect_output "3 8\n37.50\n"))

; 19.3: "as if the process triggering the event were to call the built-in
; sample() method": at a rising edge of a clock that a flip-flop divides, and
; of one that a nonblocking assignment toggles, a sample sees the values
; before the nonblocking assignments of that edge, as the flip-flops of the
; edge do. `div` rises at 5 and 25, where `r` is 0 and 1; `nclk` rises at 5,
; 15, 25 and 35, where `q` is 0 to 3.
(case clocking_events_of_nba_updated_clocks_sample_before_the_updates
 (source "clocking_nba.sv" #"module Top;
 bit clk = 0, div = 0, nclk = 0;
 bit [2:0] r = 0, q = 0;
 always #5 clk = ~clk;
 always #5 nclk <= ~nclk;
 always_ff @(posedge clk) div <= ~div;
 always_ff @(posedge div) r <= r + 3'd1;
 always_ff @(posedge nclk) q <= q + 3'd1;
 covergroup on_div @(posedge div);
  early: coverpoint r { bins b[] = {[0:1]}; }
  late: coverpoint r { bins b[] = {[2:7]}; }
 endgroup
 covergroup on_nclk @(posedge nclk); coverpoint q { bins lo = {[0:3]}; bins hi = {[4:7]}; } endgroup
 on_div d = new;
 on_nclk n = new;
 initial begin
  #42;
  $display("%0.2f %0.2f %0.2f", d.early.get_inst_coverage(), d.late.get_inst_coverage(), n.get_inst_coverage());
  $finish;
 end
endmodule"#)
 (top Top) (run_to_finish)
 (expect_output "100.00 0.00 50.00\n"))

; 19.3: an instance that a procedure constructs, in an `initial` procedure,
; as an element of an array in a `foreach` and in a task, is sampled at each
; occurrence of the clocking event of its type, as one a declaration
; constructs is: here at the rising edges at 5, 15, 25 and 35, where `q` is
; 0 to 3, and from 12 on for the one constructed then.
(case procedural_constructions_sample_at_their_clocking_events
 (source "constructed_procedural.sv" #"module Top;
 bit clk = 0;
 bit [2:0] q = 0;
 always #5 clk = ~clk;
 always_ff @(posedge clk) q <= q + 3'd1;
 covergroup cg @(posedge clk); coverpoint q { bins b[] = {[0:7]}; } endgroup
 cg c, d, late;
 cg a[2];
 int covered, total;
 task automatic make(); d = new; endtask
 initial begin
  c = new;
  foreach (a[i]) a[i] = new;
  make();
  #12 late = new;
 end
 initial begin
  #42;
  void'(c.get_inst_coverage(covered, total)); $display("%0d %0d", covered, total);
  foreach (a[i]) begin void'(a[i].get_inst_coverage(covered, total)); $display("%0d %0d", covered, total); end
  void'(d.get_inst_coverage(covered, total)); $display("%0d %0d", covered, total);
  void'(late.get_inst_coverage(covered, total)); $display("%0d %0d", covered, total);
  $finish;
 end
endmodule"#)
 (top Top) (run_to_finish)
 (expect_output "4 8\n4 8\n4 8\n4 8\n3 8\n"))

; 19.4: a covergroup embedded in a class is sampled at its clocking event,
; whose names are those of the class: a change of a property, an edge of a
; one-bit property, a named event of the object, and an edge of a signal of
; the module that declares the class. Each sample sees `v` as the procedure
; set it before the event.
(case embedded_covergroups_sample_at_events_of_their_class
 (source "constructed_embedded.sv" #"module Top;
 bit sclk = 0;
 class C;
  bit clk_bit;
  bit [3:0] m_z;
  event ev;
  bit [3:0] v;
  covergroup on_change @m_z; coverpoint v { bins b[] = {[0:15]}; } endgroup
  covergroup on_edge @(posedge clk_bit); coverpoint v { bins b[] = {[0:15]}; } endgroup
  covergroup on_event @ev; coverpoint v { bins b[] = {[0:15]}; } endgroup
  covergroup on_signal @(posedge sclk); coverpoint v { bins b[] = {[0:15]}; } endgroup
  function new();
   on_change = new; on_edge = new; on_event = new; on_signal = new;
  endfunction
 endclass
 C o;
 initial begin
  o = new;
  repeat (3) begin
   #5 o.v = o.v + 4'd2;
   o.m_z++; o.clk_bit = 1; -> o.ev; sclk = 1;
   #5 o.clk_bit = 0; sclk = 0;
  end
  #1;
  $display("%0.2f %0.2f %0.2f %0.2f", o.on_change.get_inst_coverage(), o.on_edge.get_inst_coverage(),
           o.on_event.get_inst_coverage(), o.on_signal.get_inst_coverage());
  $finish;
 end
endmodule"#)
 (top Top) (run_to_finish)
 (expect_output "18.75 18.75 18.75 18.75\n"))

; 19.3, 19.4, 25.9: the verification form, a covergroup embedded in a
; monitor class of a package, sampled at an edge of the clock of the
; interface instance a virtual interface property of the object denotes.
(case embedded_covergroup_samples_through_a_virtual_interface
 (source "constructed_vif.sv" #"interface ifc(input bit clk);
 bit [3:0] data;
endinterface
package mon_pkg;
 class Monitor;
  virtual ifc vif;
  covergroup cg @(posedge vif.clk); coverpoint vif.data { bins b[] = {[0:15]}; } endgroup
  function new(virtual ifc vif);
   this.vif = vif;
   cg = new;
  endfunction
 endclass
endpackage
module Top;
 import mon_pkg::*;
 bit clk = 0;
 always #5 clk = ~clk;
 ifc i(.clk(clk));
 Monitor m;
 int covered, total;
 initial begin
  m = new(i);
  i.data = 1;
  #10 i.data = 4;
  #10 i.data = 9;
  #12;
  void'(m.cg.get_inst_coverage(covered, total)); $display("%0d %0d", covered, total);
  $finish;
 end
endmodule"#)
 (top Top) (run_to_finish)
 (expect_output "3 16\n"))

; 19.8: an instance that a procedure constructs takes the predefined methods:
; `stop()` stops the sampling at the event until `start()`, and `sample()`
; samples it once more.
(case constructed_instances_take_stop_start_and_sample
 (source "constructed_methods.sv" #"module Top;
 bit clk = 0;
 bit [2:0] q = 0;
 always #5 clk = ~clk;
 always_ff @(posedge clk) q <= q + 3'd1;
 covergroup cg @(posedge clk); coverpoint q { bins b[] = {[0:7]}; } endgroup
 cg c;
 int covered, total;
 initial begin
  c = new;
  #12 c.stop();
  #10 c.start();
  #1 c.sample();
  #19;
  void'(c.get_inst_coverage(covered, total)); $display("%0d %0d", covered, total);
  $display("%0.2f", c.q.get_inst_coverage());
  $finish;
 end
endmodule"#)
 (top Top) (run_to_finish)
 (expect_output "3 8\n37.50\n"))

; 19.3, 19.4: instances that other declaration initializers of a module
; construct are sampled at their clocking events too: the instance the `new`
; of a class embeds, and the elements of an array of instances.
(case constructions_of_declaration_initializers_sample
 (source "constructed_initializers.sv" #"module Top;
 bit clk = 0;
 bit [2:0] q = 0;
 always #5 clk = ~clk;
 always_ff @(posedge clk) q <= q + 3'd1;
 class K;
  covergroup kc @(posedge clk); coverpoint q { bins b[] = {[0:7]}; } endgroup
  function new(); kc = new; endfunction
 endclass
 covergroup cg @(posedge clk); coverpoint q { bins b[] = {[0:7]}; } endgroup
 K k = new;
 cg a[2] = '{new, new};
 int covered, total;
 initial begin
  #42;
  void'(k.kc.get_inst_coverage(covered, total)); $display("%0d %0d", covered, total);
  void'(a[0].get_inst_coverage(covered, total)); $display("%0d %0d", covered, total);
  void'(a[1].get_inst_coverage(covered, total)); $display("%0d %0d", covered, total);
  $finish;
 end
endmodule"#)
 (top Top) (run_to_finish)
 (expect_output "4 8\n4 8\n4 8\n"))

; 19.3: instances that a procedure constructs sample at a rising edge of a
; clock that a flip-flop divides as the flip-flops of the edge read: before
; the nonblocking assignments of the edge. `div` rises at 5, 25 and 45,
; where `r` is 0, 1 and 2; six instances, all sampled.
(case constructed_instances_of_a_divided_clock_sample_before_the_updates
 (source "constructed_divided.sv" #"module Top;
 bit clk = 0, div = 0;
 bit [2:0] r = 0;
 always #5 clk = ~clk;
 always_ff @(posedge clk) div <= ~div;
 always_ff @(posedge div) r <= r + 3'd1;
 covergroup cg @(posedge div); coverpoint r { bins b[] = {[0:7]}; } endgroup
 cg a[6];
 int covered, total;
 initial begin
  foreach (a[i]) a[i] = new;
  #52;
  foreach (a[i]) begin void'(a[i].get_inst_coverage(covered, total)); $write("%0d ", covered); end
  $display("%0.2f", a[5].r.get_inst_coverage());
  $finish;
 end
endmodule"#)
 (top Top) (run_to_finish)
 (expect_output "3 3 3 3 3 3 37.50\n"))

; 19.3: "A ref argument tracks the value of the actual argument as it
; changes": the instances of two declarations of one type read, at each
; rising edge, the variables their actuals name, which continuous
; assignments drive; an input argument keeps the value `new` passed.
(case reference_arguments_track_their_actuals
 (source "reference_arguments.sv" #"module Top;
 bit clk = 0;
 bit [2:0] q = 0;
 always #5 clk = ~clk;
 always_ff @(posedge clk) q <= q + 3'd1;
 logic [3:0] bus_a, bus_b;
 assign bus_a = {1'b0, q};
 assign bus_b = {1'b1, q};
 covergroup cg(ref logic [3:0] v, input bit [3:0] lo) @(posedge clk);
  cp: coverpoint v { bins b[] = {[0:15]}; }
  above: coverpoint v iff (v >= lo) { bins b[] = {[0:15]}; }
 endgroup
 cg a = new(bus_a, 4'd1), b = new(bus_b, 4'd10);
 int covered, total;
 initial begin
  #42;
  void'(a.get_inst_coverage(covered, total)); $display("%0d %0d", covered, total);
  void'(b.get_inst_coverage(covered, total)); $display("%0d %0d", covered, total);
  $display("%0.2f %0.2f", a.above.get_inst_coverage(), b.above.get_inst_coverage());
  $finish;
 end
endmodule"#)
 (top Top) (run_to_finish)
 (expect_output "7 32\n6 32\n18.75 12.50\n"))

; 19.3, 19.8: a covergroup with ref arguments and no clocking event, sampled
; by `sample()` through the variables of its declarations, also from a task:
; each sample reads the variables then, an element of an unpacked array that
; the instance takes as a whole included.
(case reference_arguments_are_read_at_each_sample
 (source "reference_samples.sv" #"module Top;
 int x, y;
 logic [3:0] ev[0:3];
 covergroup cg(ref int v, ref logic [3:0] e[0:3]);
  cv: coverpoint v { bins b[] = {[0:7]}; }
  ce: coverpoint e[1] { bins b[] = {[0:15]}; }
 endgroup
 cg a = new(x, ev), b = new(y, ev);
 int covered, total;
 task automatic both(); a.sample(); b.sample(); endtask
 initial begin
  x = 1; y = 5; ev[1] = 3; a.sample(); b.sample();
  x = 2; y = 6; ev[1] = 4; both();
  x = 3; ev[1] = 9; a.sample();
  void'(a.get_inst_coverage(covered, total)); $display("%0d %0d", covered, total);
  void'(b.get_inst_coverage(covered, total)); $display("%0d %0d", covered, total);
  $display("%0.2f %0.2f", a.cv.get_inst_coverage(), b.ce.get_inst_coverage());
  $finish;
 end
endmodule"#)
 (top Top) (run_to_finish)
 (expect_output "6 24\n4 24\n37.50 12.50\n"))

; 19.5.2: the example `cg` with its trace `4 5 7 11 8 12 2 2 3`: `sa`
; counts 7=>11 and 8=>12, `sb[]` has a bin for each of the nine sequences,
; of which those two count once, and `sc` counts 12=>2=>2=>3 once; the
; `default sequence` bin is no bin of the coverage. The same bins with
; `at_least` 2 and 3 show the hits.
(case transition_bins_of_the_example_of_19_5_2
 (source "transition_bins.sv" #"module Top;
 bit [4:1] v_a;
 covergroup cg(int least);
  option.at_least = least;
  coverpoint v_a
  {
   bins sa   = (4 => 5 => 6), ([7:9],10 => 11,12);
   bins sb[] = (4 => 5 => 6), ([7:9],10 => 11,12);
   bins sc   = (12 => 3 [-> 1]);
   bins allother = default sequence ;
  }
 endgroup
 cg a = new(1), b = new(2), c = new(3);
 bit [4:1] trace [9] = '{4, 5, 7, 11, 8, 12, 2, 2, 3};
 int covered, total;
 initial begin
  foreach (trace[i]) begin v_a = trace[i]; a.sample(); b.sample(); c.sample(); end
  void'(a.get_inst_coverage(covered, total)); $write("%0d %0d ", covered, total);
  void'(b.get_inst_coverage(covered, total)); $write("%0d %0d ", covered, total);
  void'(c.get_inst_coverage(covered, total)); $display("%0d %0d", covered, total);
  $finish;
 end
endmodule"#)
 (top Top) (run_to_finish)
 (expect_output "4 11 1 11 0 11\n"))

; 19.5.2: the example `sg` with its trace: `b2` counts twice, `b3` three
; times, `b5` four times, `b6` and `b7` once. Coverpoint `pk` has the same
; bins with `at_least` k, so it covers the bins of k hits or more.
(case overlapping_transitions_of_the_example_of_19_5_2
 (source "overlapping_transitions.sv" #"module Top;
 bit [3:0] v;
 covergroup sg;
  p1: coverpoint v { option.at_least = 1;
   bins b2 = (2 [-> 3:5]); bins b3 = (3 [-> 3:5]); bins b5 = (5 [* 3]);
   bins b6 = (1 => 3 [-> 4:6] => 1); bins b7 = (1 => 2 [= 3:6] => 5); }
  p2: coverpoint v { option.at_least = 2;
   bins b2 = (2 [-> 3:5]); bins b3 = (3 [-> 3:5]); bins b5 = (5 [* 3]);
   bins b6 = (1 => 3 [-> 4:6] => 1); bins b7 = (1 => 2 [= 3:6] => 5); }
  p3: coverpoint v { option.at_least = 3;
   bins b2 = (2 [-> 3:5]); bins b3 = (3 [-> 3:5]); bins b5 = (5 [* 3]);
   bins b6 = (1 => 3 [-> 4:6] => 1); bins b7 = (1 => 2 [= 3:6] => 5); }
  p4: coverpoint v { option.at_least = 4;
   bins b2 = (2 [-> 3:5]); bins b3 = (3 [-> 3:5]); bins b5 = (5 [* 3]);
   bins b6 = (1 => 3 [-> 4:6] => 1); bins b7 = (1 => 2 [= 3:6] => 5); }
  p5: coverpoint v { option.at_least = 5;
   bins b2 = (2 [-> 3:5]); bins b3 = (3 [-> 3:5]); bins b5 = (5 [* 3]);
   bins b6 = (1 => 3 [-> 4:6] => 1); bins b7 = (1 => 2 [= 3:6] => 5); }
 endgroup
 sg c = new;
 bit [3:0] trace [18] = '{1, 4, 3, 2, 3, 3, 2, 2, 3, 2, 3, 1, 5, 5, 5, 5, 5, 5};
 initial begin
  foreach (trace[i]) begin v = trace[i]; c.sample(); end
  $display("%0.2f %0.2f %0.2f %0.2f %0.2f", c.p1.get_inst_coverage(), c.p2.get_inst_coverage(),
   c.p3.get_inst_coverage(), c.p4.get_inst_coverage(), c.p5.get_inst_coverage());
  $finish;
 end
endmodule"#)
 (top Top) (run_to_finish)
 (expect_output "100.00 60.00 40.00 20.00 0.00\n"))

; 19.5.2: a set of transitions, consecutive repetitions with a count and a
; range, goto and nonconsecutive repetitions alone and between steps, on one
; trace. Their hits are 2, 2, 4, 9, 1, 10 and 1: the coverpoints with
; `at_least` 1, 2, 4, 9, 10 and 11 cover 7, 5, 3, 2, 1 and none of the 7.
(case repetitions_of_transitions
 (source "repetitions.sv" #"module Top;
 bit [3:0] v;
 covergroup cg(int least);
  option.at_least = least;
  coverpoint v {
   bins sets = (1, 5 => 6, 7);
   bins five = (3 [* 5]);
   bins some = (3 [* 3:5]);
   bins goto3 = (3 [-> 3]);
   bins between = (1 => 3 [-> 3] => 5);
   bins non2 = (3 [= 2]);
   bins later = (1 => 3 [= 2] => 6);
  }
 endgroup
 cg c[6];
 int least [6] = '{1, 2, 4, 9, 10, 11};
 bit [3:0] trace [24] = '{1, 6, 5, 7, 3, 3, 3, 3, 3, 3, 1, 2, 3, 4, 3, 0, 3, 5, 1, 3, 3, 2, 6, 6};
 int covered, total;
 initial begin
  foreach (c[i]) c[i] = new(least[i]);
  foreach (trace[k]) begin v = trace[k]; foreach (c[i]) c[i].sample(); end
  foreach (c[i]) begin void'(c[i].get_inst_coverage(covered, total)); $write("%0d ", covered); end
  $display("of %0d", total);
  $finish;
 end
endmodule"#)
 (top Top) (run_to_finish)
 (expect_output "7 5 3 2 1 0 of 7\n"))

; 19.5.2, 19.5.4, 19.5.5: `name[]` has a bin for each sequence of values, over
; each length of a repetition range, a sequence listed twice being one bin; a
; wildcard transition; an ignored sequence that removes the only sequence of
; a bin (`2=>3` of `1=>2=>3=>4`), which leaves the coverage, and the match of
; another bin that it is part of; ignored values advance transitions.
(case transition_arrays_and_ignored_transitions
 (source "transition_arrays.sv" #"module Top;
 bit [3:0] v, a;
 covergroup arrays;
  coverpoint v {
   bins r[] = (3 [* 3:5]);
   bins p[] = (1, 2 => 3), (2 => 3);
   wildcard bins w = (4'b11?? => 4'b00??);
  }
 endgroup
 covergroup ignored;
  option.at_least = 2;
  coverpoint a {
   ignore_bins ignore_vals = {7,8};
   ignore_bins ignore_trans = (1=>3=>5);
   bins long = (1 => 2 => 3 => 4);
   ignore_bins short = (2 => 3);
   bins t = (7 => 8 => 7 => 8);
   bins u = (0 => 1 => [3:4] => 5);
   bins v = (0 => 1);
  }
 endgroup
 arrays x = new;
 ignored y = new;
 bit [3:0] vs [15] = '{3, 3, 3, 3, 3, 3, 1, 3, 2, 3, 12, 1, 15, 3, 14};
 bit [3:0] avs [18] = '{1, 2, 3, 4, 7, 8, 7, 8, 0, 1, 3, 5, 0, 1, 4, 5, 0, 1};
 int covered, total;
 initial begin
  foreach (vs[i]) begin v = vs[i]; x.sample(); end
  foreach (avs[i]) begin a = avs[i]; y.sample(); end
  void'(x.get_inst_coverage(covered, total)); $write("%0d %0d ", covered, total);
  void'(y.get_inst_coverage(covered, total)); $display("%0d %0d", covered, total);
  $finish;
 end
endmodule"#)
 (top Top) (run_to_finish)
 (expect_output "6 6 1 3\n"))

; 19.5: the values and counts of transitions may be arguments of the
; covergroup and calls of functions of them, which `new` evaluates: two
; instances of one type count different sequences.
(case transition_operands_of_arguments
 (source "transition_arguments.sv" #"module Top;
 bit [3:0] v;
 localparam bit [3:0] P = 4;
 function automatic int twice(int x); return 2 * x; endfunction
 covergroup cg(int a, int n);
  coverpoint v { bins r = (a => P => twice(a) [* n]); }
 endgroup
 cg c1 = new(1, 2), c2 = new(1, 3), c3 = new(3, 1);
 bit [3:0] trace [7] = '{1, 4, 2, 2, 3, 4, 6};
 int covered, total;
 initial begin
  foreach (trace[i]) begin v = trace[i]; c1.sample(); c2.sample(); c3.sample(); end
  void'(c1.get_inst_coverage(covered, total)); $write("%0d ", covered);
  void'(c2.get_inst_coverage(covered, total)); $write("%0d ", covered);
  void'(c3.get_inst_coverage(covered, total)); $display("%0d", covered);
  $finish;
 end
endmodule"#)
 (top Top) (run_to_finish)
 (expect_output "1 0 1\n"))

; The shape of a real design, through a `ref` argument of a covergroup with
; a clocking event: a write, a run of 1 to 30 idle states and a read, as an
; array of 120 bins between parameters, beside an ignore bin of values,
; which leaves the transitions as they are. The states change at the
; falling edges and are sampled at the rising ones: 2=>0=>0=>3 once and
; 1=>0=>4 twice.
(case bus_transitions_through_a_reference
 (source "bus_transitions.sv" #"module Top;
 localparam bit [3:0] IDLE = 0, AHB_WR = 1, AXI_WR = 2, AHB_RD = 3, AXI_RD = 4;
 bit clk = 0;
 always #5 clk = ~clk;
 logic [3:0] state = IDLE;
 covergroup cg(ref logic [3:0] st) @(posedge clk);
  coverpoint st {
   bins wr_rd[] = (AHB_WR, AXI_WR => IDLE [*1:30] => AHB_RD, AXI_RD);
   ignore_bins dont_care = {IDLE, 4'hf, (AXI_RD | AXI_WR), (AHB_RD | AHB_WR)};
  }
 endgroup
 cg c = new(state);
 logic [3:0] trace [10] = '{AXI_WR, IDLE, IDLE, AHB_RD, AHB_WR, IDLE, AXI_RD, AHB_WR, IDLE, AXI_RD};
 int covered, total;
 initial begin
  foreach (trace[i]) @(negedge clk) state = trace[i];
  #10;
  void'(c.get_inst_coverage(covered, total)); $display("%0d %0d", covered, total);
  $finish;
 end
endmodule"#)
 (top Top) (run_to_finish)
 (expect_output "2 120\n"))

; 19.3: a covergroup declared in an interface is a type of the interface.
; The monitor interfaces of the UVM examples declare an array of its
; handles, construct them in an `initial foreach` and sample them in the
; action of a `cover property`: each instance of the interface has its own
; instances, which sample the members of that instance.
(case interface_covergroups_sample_their_instance
 (source "interface_covergroups.sv" #"interface mon(input logic clk, input logic w, input logic e, input logic [1:0] sel, input logic en);
 covergroup cg_t();
  option.per_instance = 1;
  RW: coverpoint w { bins read = {0}; bins write = {1}; }
  ERR: coverpoint e { bins err = {1}; bins ok = {0}; }
  X: cross RW, ERR;
 endgroup
 cg_t arr[2];
 initial foreach (arr[i]) arr[i] = new();
 sequence done_s; @(posedge clk) $rose(en); endsequence
 cover property (done_s) begin
  foreach (arr[i]) if (sel[i] == 1) arr[i].sample();
 end
 task automatic report();
  int covered, total;
  foreach (arr[i]) begin
   void'(arr[i].get_inst_coverage(covered, total));
   $display("%0d %0d %0.2f", covered, total, arr[i].X.get_inst_coverage());
  end
 endtask
endinterface
module Top;
 logic clk = 0, w = 0, e = 0, en = 0;
 logic [1:0] sel = 0;
 always #1 clk = ~clk;
 mon m(.clk(clk), .w(w), .e(e), .sel(sel), .en(en));
 mon n(.clk(clk), .w(e), .e(w), .sel(2'b11), .en(en));
 task automatic xfer(bit ww, bit ee, logic [1:0] s);
  @(negedge clk) begin w = ww; e = ee; sel = s; en = 1; end
  @(negedge clk) en = 0;
 endtask
 initial begin
  xfer(1, 0, 2'b01);
  xfer(0, 1, 2'b11);
  xfer(1, 1, 2'b10);
  xfer(0, 0, 2'b00);
  #4;
  m.report();
  n.report();
  $finish;
 end
endmodule"#)
 (top Top) (run_to_finish)
 (expect_output "6 8 50.00\n5 8 50.00\n8 8 100.00\n8 8 100.00\n"))

; 19.3: the clocking event of a covergroup of an interface samples, at
; each event, the instances of each instance of the interface: one that a
; procedure of the interface constructs and one of a declaration with an
; initializer.
(case interface_covergroups_sample_at_their_clocking_events
 (source "interface_clocking_events.sv" #"interface ci(input bit clk, input bit [3:0] base);
 bit [3:0] q = 0;
 always_ff @(posedge clk) q <= q + 4'd1;
 covergroup cg @(posedge clk); coverpoint q + base { bins b[] = {[0:15]}; } endgroup
 cg c;
 cg d = new;
 initial #12 c = new;
 task automatic report();
  int covered, total;
  void'(c.get_inst_coverage(covered, total)); $write("%0d ", covered);
  void'(d.get_inst_coverage(covered, total)); $display("%0d", covered);
 endtask
endinterface
module Top;
 bit clk = 0;
 always #5 clk = ~clk;
 ci a(.clk(clk), .base(4'd0));
 ci b(.clk(clk), .base(4'd8));
 initial begin
  #62;
  a.report();
  b.report();
  $finish;
 end
endmodule"#)
 (top Top) (run_to_finish)
 (expect_output "5 6\n5 6\n"))

; 23.11, 19.3: an interface attached with `bind` to a module is an instance
; in each instance of the module: its covergroups sample, for each, the
; ports it binds there and, through the name of the module, a signal of that
; instance (23.8), at their clocking events, also one with a `ref`
; argument of a variable port. u1 holds 1 (one bin of each), u2 counts 9 to
; 12 (four bins of each).
(case interface_covergroups_bound_into_each_instance
 (source "bound_covergroups.sv" #"interface cov_if #(parameter int ID = 0) (input logic clk, input var logic [3:0] x);
 covergroup cg @(posedge clk);
  X: coverpoint x { bins b[] = {[0:15]}; }
  Y: coverpoint dut.y { bins b[] = {[0:15]}; }
 endgroup
 covergroup by_ref(ref logic [3:0] v) @(posedge clk);
  V: coverpoint v { bins b[] = {[0:15]}; }
 endgroup
 cg c = new;
 by_ref r = new(x);
 initial begin
  #(40 + ID);
  $display("u%0d %0.2f %0.2f %0.2f", ID, c.X.get_inst_coverage(), c.Y.get_inst_coverage(), r.get_inst_coverage());
 end
endinterface
module dut #(parameter int ID = 0) (input logic clk, input logic [3:0] x);
 logic [3:0] y;
 assign y = x + 4'd4;
endmodule
bind dut cov_if #(.ID(ID)) inst(.clk(clk), .x(x));
module Top;
 logic clk = 0;
 logic [3:0] p = 1, q = 9;
 always #5 clk = ~clk;
 dut #(1) u1(.clk(clk), .x(p));
 dut #(2) u2(.clk(clk), .x(q));
 always @(negedge clk) q <= q + 1;
 initial #50 $finish;
endmodule"#)
 (top Top) (run_to_finish)
 (expect_output "u1 6.25 6.25 6.25\nu2 25.00 25.00 25.00\n"))

; 19.3, 14.10, 14.13: a covergroup whose clocking event is a clocking block
; event, `@(cb)`, samples after the Observed region of the block's clocking
; event, where `x` has become 1 to 4 at the events at 5, 15, 25 and 35; a
; coverpoint of the clockvar `cb.x` reads the values the block sampled, 0 to
; 3, also in a covergroup sampled by a process that waits for `@(cb)`.
(case covergroups_at_clocking_block_events
 (source "clocking_covergroups.sv" #"module Top;
 bit clk;
 logic [3:0] x = 0;
 always #5 clk = ~clk;
 always @(posedge clk) x <= x + 1;
 clocking cb @(posedge clk); input x; endclocking
 covergroup at_block @(cb);
  X: coverpoint x { bins b[] = {[1:4]}; }
  S: coverpoint cb.x { bins b[] = {[1:4]}; }
 endgroup
 covergroup by_call;
  S: coverpoint cb.x { bins b[] = {[1:4]}; }
 endgroup
 at_block a = new;
 by_call b = new;
 always @(cb) b.sample();
 initial begin
  #40;
  $display("%0.2f %0.2f %0.2f", a.X.get_inst_coverage(), a.S.get_inst_coverage(), b.S.get_inst_coverage());
  $finish;
 end
endmodule"#)
 (top Top) (run_to_finish)
 (expect_output "100.00 75.00 75.00\n"))
