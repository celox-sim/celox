; coverage: the `gt` example of the clause, where `b[1]` is a bin of both
; instances.
(case merged_instances_unite_bins_by_name
 (source "merge.sv" #"module Top;
 bit [7:0] a;
 covergroup gt (int l, h);
  type_option.merge_instances = 1;
  option.get_inst_coverage = 1;
  coverpoint a {bins b[] = { [l:h] };}
 endgroup
 gt gv1 = new (0,1);
 gt gv2 = new (1,2);
 initial begin
  a = 0; gv1.sample();
  a = 1; gv1.sample(); gv2.sample();
  $display("%0.2f %0.2f %0.2f", gt::get_coverage(), gv1.get_inst_coverage(), gv2.get_inst_coverage());
 end
endmodule"#)
 (top Top) (run_until 0)
 (expect_output "66.67 100.00 50.00\n"))

; 19.8: with two `int` variables passed by reference, `get_coverage` and
; `get_inst_coverage` give the covered bins and the bins, of a coverpoint
; or of the covergroup, of an instance or of all instances. The example of
; the clause, with the values sampled as arguments of `sample`: totals 2, 5,
; 6 and 16.
(case coverage_queries_count_bins_by_reference
 (source "counts.sv" #"module Top;
 covergroup cg (int xb, yb) with function sample(int x, int y);
  coverpoint x {bins xbins[] = { [0:xb] }; }
  coverpoint y {bins ybins[] = { [0:yb] }; }
 endgroup
 cg cv1 = new (1,2);
 cg cv2 = new (3,6);
 int covered, total;
 initial begin
  cv1.sample(0, 0);
  cv2.sample(3, 6);
  void'(cv1.x.get_inst_coverage(covered,total)); $display("%0d %0d", covered, total);
  void'(cv1.get_inst_coverage(covered,total)); $display("%0d %0d", covered, total);
  void'(cg::x::get_coverage(covered,total)); $display("%0d %0d", covered, total);
  void'(cg::get_coverage(covered,total)); $display("%0d %0d", covered, total);
 end
endmodule"#)
 (top Top) (run_until 0)
 (expect_output "1 2\n2 5\n2 6\n4 16\n"))

; Table 19-5: `get_coverage` and `get_inst_coverage` of a coverpoint and of
; a cross, through an instance and, for the type, through `::`.
(case coverpoints_and_crosses_report_their_coverage
 (source "item_methods.sv" #"module Top;
 bit [1:0] a, b;
 covergroup cg;
  pa: coverpoint a { bins lo = {[0:1]}; bins hi = {[2:3]}; }
  pb: coverpoint b { bins lo = {[0:1]}; bins hi = {[2:3]}; }
