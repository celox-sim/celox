(case zero_trip_child_dependencies_ignore_body_and_step
 (source "zero-trip-child.sv" #"
 module Child(input bit a,output bit q);
 function bit read_a();return a;endfunction
 always_comb begin q=0;repeat(0)q=a;while(1'b0)q=read_a();for(int i=0;1'b0;i=read_a())q=a;end
 endmodule
 module Top(output bit[7:0]seen);bit a;bit q;Child c(a,q);
 initial begin #1;a=1;a=0;end initial forever begin @(q);seen++;end endmodule
 "#)(top Top)(run_until 0)(assert_eq seen 0)(run_until 2)(assert_eq seen 0))

(case cross_file_package_initializers_keep_static_clock_baseline
 (source "base.sv" #"package Base;function automatic bit one();return 1;endfunction endpackage"#)
 (source "values.sv" #"package P;function automatic bit high_value();return Base::one();endfunction endpackage"#)
 (source "clocks.sv" #"
 module Qualified(output bit[7:0]q);bit clk=P::high_value();always @(posedge clk)q++;endmodule
 module Imported(output bit[7:0]q);import P::*;bit clk=high_value();always @(posedge clk)q++;endmodule
 module Top(output wire[7:0]qualified,imported);Qualified a(qualified);Imported b(imported);initial #2 $finish;endmodule
 "#)(top Top)(run_until 0)(assert_eq qualified 0)(assert_eq imported 0)(run_until 1)(assert_eq qualified 0)(assert_eq imported 0)(run_to_finish))

(case edge_waits_wake_on_rising_and_falling_edges
  (source "edge.sv" #"
                module Top(output logic [7:0] seen);
                    logic clk = 1'b0;
                    initial begin
                        #3 clk = 1'b1;
                        #3 clk = 1'b0;
                        #3 clk = 1'b1;
                    end
                    initial begin
                        seen = 8'd0;
                        forever @(edge clk) seen = seen + 8'd1;
                    end
                endmodule
            "#)
  (top Top)
  (run_until 2)
  (assert_eq seen 0)
  (run_until 3)
  (assert_eq seen 1)
  (run_until 6)
  (assert_eq seen 2 "a falling edge is an edge")
  (run_until 9)
  (assert_eq seen 3))

(case min_typ_max_delays_wait_the_typical_value
  (source "mintypmax.sv" #"
                module Top(output logic [7:0] a);
                    initial begin
                        a = 8'd1;
                        #(2:5:9) a = 8'd2;
                    end
                endmodule
            "#)
  (top Top)
  (run_until 4)
  (assert_eq a 1)
  (run_until 5)
  (assert_eq a 2))

(case long_process_loops_finish_within_one_time_slot
  (source "long_loop.sv" #"
                module Top(output logic [31:0] count);
                    initial begin
                        count = 32'd0;
                        for (int i = 0; i < 200000; i++) count = count + 32'd1;
                        #1 count = count + 32'd1;
                    end
                endmodule
            "#)
  (top Top)
  (run_until 0)
  (assert_eq count 200000)
  (run_until 1)
  (assert_eq count 200001))

(case initial_blocks_run_at_time_zero
  (source "time_zero.sv" #"
    module Top(output bit [7:0] y);
      initial begin
        y = 8'd7;
        $display("y=%0d", y);
      end
    endmodule
  "#)
  (top Top)
  (run_until 0)
  (assert_eq y 7)
  (expect_output "y=7\n")
  (run_until 10)
  (assert_eq y 7))

(case host_edges_after_time_zero_clock_flip_flops
  (source "host_edges.sv" #"
    module Top(input bit clk, output bit [7:0] q);
      always_ff @(posedge clk) q <= q + 8'd1;
    endmodule
  "#)
  (top Top)
  (run_until 0)
  (set clk 1)
  (run_until 1)
  (assert_eq q 1)
  (set clk 0)
  (run_until 2)
  (assert_eq q 1)
  (set clk 1)
  (run_until 3)
  (assert_eq q 2))
