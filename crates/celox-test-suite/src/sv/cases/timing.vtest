; Port actuals read the caller's time. $stime truncates before addition.
(case time_calls_in_child_port_actuals
  (source "time_ports.sv" #"
    module Child(input logic [63:0] x, output logic [63:0] y);
      assign y = x;
    endmodule
    module Top(input logic [63:0] a, output logic [63:0] t, s);
      Child time_child(.x($time + a), .y(t));
      Child stime_child(.x($stime + a), .y(s));
    endmodule
  "#)
  (top Top)
  (run_until 0)
  (modify (set a 1))
  (run_until 0)
  (assert_eq t 1)
  (assert_eq s 1)
  (run_until 3)
  (modify (set a 4))
  (run_until 3)
  (assert_eq t 7)
  (assert_eq s 7)
  (run_until 4294967299)
  (modify (set a 5))
  (run_until 4294967299)
  (assert_eq t 4294967304)
  (assert_eq s 8))

(case time_calls_in_child_port_subroutines
  (source "time_port_functions.sv" #"
    module Child(input logic [63:0] x, output logic [63:0] y);
      assign y = x;
    endmodule
    module Top(input logic [63:0] a, output logic [63:0] t, s);
      function automatic logic [63:0] leaf(); return $time; endfunction
      function automatic logic [63:0] now(input logic [63:0] bias); return leaf() + bias; endfunction
      function automatic logic [63:0] with_default(input logic [63:0] stamp = $stime);
        return stamp;
      endfunction
      Child time_child(.x(now(a)), .y(t));
      Child stime_child(.x(with_default() + a), .y(s));
    endmodule
  "#)
  (top Top)
  (run_until 0)
  (modify (set a 1))
  (run_until 0)
  (assert_eq t 1)
  (assert_eq s 1)
  (run_until 3)
  (modify (set a 4))
  (run_until 3)
  (assert_eq t 7)
  (assert_eq s 7)
  (run_until 4294967299)
  (modify (set a 5))
  (run_until 4294967299)
  (assert_eq t 4294967304)
  (assert_eq s 8))

(case timed_task_automatic_calls_keep_separate_storage
  (source "automatic_tasks.sv" #"
    module Top(output int a, b);
      task automatic pulse(input int delay, input logic [31:0] value, output int result);
        logic [31:0] saved = value + 1;
        int words[2];
        words[0] = value;
        words[1] = saved;
        #delay;
        result = words[1] + words[0] - value;
      endtask
      initial begin a = 0; pulse(5, 10, a); end
      initial begin b = 0; #1; pulse(2, 20, b); end
    endmodule
  "#)
  (top Top)
  (run_until 2) (assert_eq a 0) (assert_eq b 0)
  (run_until 3) (assert_eq a 0) (assert_eq b 21)
  (run_until 5) (assert_eq a 11) (assert_eq b 21))

(case timed_task_nested_copyback_wait_and_return
  (source "nested_tasks.sv" #"
    module Top(output int value, result);
      bit clk = 0;
      bit ready = 0;
      always #2 clk = ~clk;
      initial #3 ready = 1;
      task automatic leaf(inout int v, output int r);
        int saved = v;
        wait (ready);
        @(posedge clk);
        #1;
        v = saved + 1;
        r = saved + 2;
        return;
        r = 99;
      endtask
      task automatic outer(inout int v, output int r);
        leaf(v, r);
        #1;
      endtask
      initial begin value = 7; result = 0; outer(value, result); end
    endmodule
  "#)
  (top Top)
  (run_until 6) (assert_eq value 7) (assert_eq result 0)
  (run_until 7) (assert_eq value 7) (assert_eq result 0)
  (run_until 8) (assert_eq value 8) (assert_eq result 9))

(case timed_task_static_formals_remain_shared
  (source "static_tasks.sv" #"
    module Top(output int a, b);
      task pulse(input int delay, input int value, output int result);
        #delay;
        result = value;
      endtask
      initial begin a = 0; pulse(5, 10, a); end
      initial begin b = 0; #1; pulse(2, 20, b); end
    endmodule
  "#)
  (top Top)
  (run_until 3) (assert_eq a 0) (assert_eq b 20)
  (run_until 5) (assert_eq a 20) (assert_eq b 20))

(case timed_task_in_edge_always_rearms_after_return
  (source "edge_tasks.sv" #"
    module Top(output int count);
      bit clk = 0;
      always #1 clk = ~clk;
      task automatic increment(); #3; count = count + 1; endtask
      task automatic wrapper(); increment(); endtask
      initial count = 0;
      always @(posedge clk) wrapper();
    endmodule
  "#)
  (top Top)
  (run_until 3) (assert_eq count 0)
  (run_until 4) (assert_eq count 1)
  (run_until 7) (assert_eq count 1)
  (run_until 8) (assert_eq count 2))

; A plain `always @*` that calls a timed task runs as a process (IEEE
; 1800-2023 9.2.2.2.2): its event list is the variables its statement
; reads, including the task's arguments but not what the task body reads
; (9.4.2.2), and it waits for one of them to change before each run.
(case always_star_timed_task_calls_run_as_processes
  (source "star_tasks.sv" #"
    module Top(output logic [7:0] y, z, w);
      logic [7:0] a = 8'd0, b = 8'd0;
      logic [7:0] y_r = 8'd0, z_r = 8'd0, w_r = 8'd0;
      task automatic delayed(input logic [7:0] v);
        #2 y_r = v;
      endtask
      task automatic mark(input logic [7:0] v);
        #1 w_r = v;
      endtask
      always @* delayed(a);
      always @* begin z_r = b; mark(b); end
      initial begin
        #3 a = 8'd5;
        b = 8'd1;
        #3 a = 8'd7;
      end
      assign y = y_r;
      assign z = z_r;
      assign w = w_r;
    endmodule
  "#)
  (top Top)
  (run_until 3) (assert_eq y 0) (assert_eq z 1) (assert_eq w 0)
  (run_until 4) (assert_eq w 1) (assert_eq y 0)
  (run_until 5) (assert_eq y 5 "the task resumes two units after a changed")
  (run_until 7) (assert_eq y 5)
  (run_until 8) (assert_eq y 7))

; Such a process may assign nonblocking, as any `always` process may.
(case always_star_timed_task_calls_assign_nonblocking
  (source "star_task_nba.sv" #"
    module Top(output logic [7:0] q);
      logic [7:0] d = 8'd0, q_r = 8'd0;
      task automatic pause();
        #1;
      endtask
      always @* begin
        pause();
        q_r <= d;
      end
      initial #2 d = 8'd5;
      assign q = q_r;
    endmodule
  "#)
  (top Top)
  (run_until 2) (assert_eq q 0)
  (run_until 3) (assert_eq q 5 "the update follows the task's delay"))

; The event list of such a process comes from the analysis that gives a
; combinational `always @*` its sensitivity: it counts what the defaults of
; omitted arguments read, of calls nested in arguments too.
(case always_star_timed_task_calls_wait_on_nested_call_defaults
  (source "star_nested_default.sv" #"
    module Top(output logic [7:0] y);
      logic [7:0] a = 8'd0, y_r = 8'd0;
      function automatic logic [7:0] pick(input logic [7:0] v = a);
        return v;
      endfunction
      task automatic delayed(input logic [7:0] v);
        #1 y_r = v;
      endtask
      always @* delayed(pick());
      initial #2 a = 8'd5;
      assign y = y_r;
    endmodule
  "#)
  (top Top)
  (run_until 2) (assert_eq y 0)
  (run_until 3) (assert_eq y 5 "a change of what pick's default reads wakes the process"))

; It counts the reads of branches that constant folding removed, as the
; syntactic event list does (IEEE 1800-2023 9.4.2.2).
(case always_star_timed_task_calls_wait_on_folded_branch_reads
  (source "star_folded_default.sv" #"
    module Top(output logic [7:0] y);
      logic [7:0] a = 8'd0, b = 8'd1, y_r = 8'd0;
      task automatic delayed(input logic [7:0] v = a);
        #1 y_r = v;
      endtask
      always @* begin
        if (0) delayed();
        delayed(b);
      end
      initial #2 a = 8'd5;
      assign y = y_r;
    endmodule
  "#)
  (top Top)
  (run_until 2) (assert_eq y 0)
  (run_until 3) (assert_eq y 1 "a change of what a folded call's default reads wakes the process"))

; A package-scoped identifier is a delay value (IEEE 1800-2023 A.6.5,
; ps_identifier), with or without parentheses.
(case package_scoped_delay_values_wait_their_value
  (source "package_delays.sv" #"
    package delays;
      parameter int D = 3;
      localparam int E = 2;
    endpackage
    module Top(output int at_d, at_e, at_paren);
      initial begin
        at_d = 0; at_e = 0; at_paren = 0;
        #delays::D;
        at_d = 1;
        #delays::E;
        at_e = 1;
        #(delays::D) at_paren = 1;
      end
    endmodule
  "#)
  (top Top)
  (run_until 2) (assert_eq at_d 0)
  (run_until 3) (assert_eq at_d 1) (assert_eq at_e 0)
  (run_until 5) (assert_eq at_e 1) (assert_eq at_paren 0)
  (run_until 8) (assert_eq at_paren 1))


(case timed_task_four_state_storage_survives_suspension
  (four_state)
  (source "four_state_task.sv" #"
    module Top(output logic [3:0] result);
      task automatic copy(input logic [3:0] value, output logic [3:0] r);
        logic [3:0] saved = value;
        #2;
        r = saved;
      endtask
      initial begin result = 0; copy(4'b10xz, result); end
    endmodule
  "#)
  (top Top)
  (run_until 1) (assert_eq result (fourstate 0 0))
  (run_until 2) (assert_eq result (fourstate 10 3)))

(case timed_task_automatic_scalar_calls_keep_separate_storage
  (source "scalar_tasks.sv" #"
    module Top(output int a, b);
      task automatic pulse(input int delay, input int value, output int result);
        int saved = value + 1;
        #delay;
        result = saved;
      endtask
      initial begin a = 10; repeat (2) pulse(3, a, a); end
      initial begin b = 20; #1; pulse(2, b, b); end
    endmodule
  "#)
  (top Top)
  (run_until 2) (assert_eq a 10) (assert_eq b 20)
  (run_until 3) (assert_eq a 11) (assert_eq b 21)
  (run_until 6) (assert_eq a 12) (assert_eq b 21))

(case time_literal_delays_accept_all_units
  (source "time_literal_units.sv" #"
    module Top(output int count);
      initial begin
        count = 0;
        #5ns; count++;
        #(2.5ns); count++;
        #40ps; count++;
        #1fs; count++;
        #1000ps; count++;
        #2.5us; count++;
        #1ms; count++;
        #0.001s; count++;
        $finish;
      end
    endmodule
  "#)
  (top Top)
  (run_to_finish)
  (assert_eq count 8))

(case real_delays_round_at_the_scope_precision
  ; IEEE 1800-2023 3.14.1: a delay is rounded at the scope's precision, here
  ; the default 1 ps, and 6.12.1 rounds a real tie away from zero: 0.0625 ns
  ; waits 63 ps. A NaN delay counts as zero, as Icarus 13.0 and Verilator
  ; 5.052 do.
  (source "real_delays.sv" #"
    module Top(output bit a_before, a_after, b_before, b_after, c_before,
               c_after, d_after, e_before, e_after);
      real r = 2.75, tie = 0.0625, zero = 0.0, nan;
      shortreal quarter = 0.25;
      bit a, b, c, d, e;
      initial begin #r a = 1; end
      initial begin #2749ps a_before = a; #2ps a_after = a; end
      initial begin #3; #tie b = 1; end
      initial begin #3062ps b_before = b; #2ps b_after = b; end
      initial begin #5; #quarter c = 1; end
      initial begin #5249ps c_before = c; #2ps c_after = c; end
      initial begin nan = zero / zero; #6; #nan d = 1; end
      initial begin #6001ps d_after = d; end
      initial begin #7; #(r * 2) e = 1; end
      initial begin #12499ps e_before = e; #2ps e_after = e; end
      initial #20 $finish;
    endmodule
  "#)
  (top Top)
  (run_to_finish)
  (assert_eq a_before 0)
  (assert_eq a_after 1 "2.75 waits 2750 ps")
  (assert_eq b_before 0)
  (assert_eq b_after 1 "0.0625 waits 63 ps")
  (assert_eq c_before 0)
  (assert_eq c_after 1 "shortreal 0.25 waits 250 ps")
  (assert_eq d_after 1 "a NaN delay waits zero")
  (assert_eq e_before 0)
  (assert_eq e_after 1 "r * 2 waits 5.5 ns"))

(case negative_real_delays_wait_their_twos_complement
  ; IEEE 1800-2023 9.4.1: a negative delay is read as a two's-complement
  ; unsigned time, so -1.5 waits about 2^64 precision steps.
  (source "negative_real_delay.sv" #"
    module Top(output bit woke);
      real r = -1.5;
      initial begin #r woke = 1; end
      initial #10 $finish;
    endmodule
  "#)
  (top Top)
  (run_to_finish)
  (assert_eq woke 0))

(case expression_events_see_pulses_within_a_time_slot
  ; IEEE 1800-2023 9.4.2: each change of the expression's value is an
  ; event, also one the slot undoes before it ends. The waits begin after
  ; time 0, where Icarus 13.0 reports an event of a new expression.
  (source "expression_pulse.sv" #"
    module Top(output bit [7:0] count, output bit hit);
      bit a, b;
      initial begin #1; forever begin @(a ^ b); count = count + 8'd1; end end
      initial begin #1; @(a ^ b); hit = 1; end
      initial begin #2; a = 1; #0; a = 0; #1; b = 1; a = 1; end
    endmodule
  "#)
  (top Top)
  (run_until 1)
  (assert_eq count 0)
  (run_until 2)
  (assert_eq count 2 "the expression rose and fell at time 2")
  (assert_eq hit 1)
  (run_until 3)
  (assert_eq count 2 "a and b changed together, so a ^ b did not change"))

(case real_expression_events_see_fractional_changes
  ; IEEE 1800-2023 9.4.2: a change of a real expression's value is an
  ; event, also one that converting the value to an integer would lose.
  (source "real_expression_event.sv" #"
    module Top(output bit [7:0] count);
      real r;
      initial begin #1; forever begin @(r * 2.0); count = count + 8'd1; end end
      initial begin #2; r = 0.125; #1; r = 0.25; #1; r = 0.25; end
    endmodule
  "#)
  (top Top)
  (run_until 1)
  (assert_eq count 0)
  (run_until 3)
  (assert_eq count 2 "r * 2.0 went to 0.25 and then to 0.5")
  (run_until 4)
  (assert_eq count 2 "writing the same value is no change"))

(case bit_select_edges_follow_the_selected_bit
  ; Table 9-2 judges an edge on the least significant bit of the
  ; expression: of `v[3]`, not of `v`.
  (source "bit_select_edge.sv" #"
    module Top(output bit [7:0] selected, whole);
      bit [3:0] v;
      initial forever begin @(posedge v[3]); selected = selected + 8'd1; end
      initial forever begin @(posedge v); whole = whole + 8'd1; end
      initial begin #1; v = 4'b1000; #1; v = 4'b0000; #1; v = 4'b1000; end
    endmodule
  "#)
  (top Top)
  (run_until 1)
  (assert_eq selected 1)
  (assert_eq whole 0)
  (run_until 3)
  (assert_eq selected 2)
  (assert_eq whole 0))

(case part_select_events_see_pulses_of_the_selected_bits
  (source "part_select_pulse.sv" #"
    module Top(output bit [7:0] count);
      bit [3:0] v;
      initial forever begin @(v[2:1]); count = count + 8'd1; end
      initial begin #1; v[1] = 1; #0; v[1] = 0; #1; v[3] = 1; v[0] = 1; end
    endmodule
  "#)
  (top Top)
  (run_until 1)
  (assert_eq count 2 "v[2:1] went to 1 and back")
  (run_until 2)
  (assert_eq count 2 "bits outside the select are no events"))

(case variable_index_events_follow_the_index
  ; The value of `q[i]` changes when the index does, too.
  (source "variable_index_event.sv" #"
    module Top(output bit [7:0] count);
      bit [3:0] q;
      bit [1:0] i;
      initial forever begin @(q[i]); count = count + 8'd1; end
      initial begin #1; q[0] = 1; #1; i = 1; #1; q[0] = 0; #1; q[1] = 1; #1; i = 2; end
    endmodule
  "#)
  (top Top)
  (run_until 1) (assert_eq count 1)
  (run_until 2) (assert_eq count 2 "q[1] differs from q[0]")
  (run_until 3) (assert_eq count 2 "q[0] is not selected")
  (run_until 4) (assert_eq count 3)
  (run_until 5) (assert_eq count 4))

(case pure_function_events_change_with_the_result
  (source "function_event.sv" #"
    module Top(output bit [7:0] count);
      bit [3:0] v;
      function automatic bit [1:0] middle(bit [3:0] x);
        return x[2:1];
      endfunction
      initial begin #1; forever begin @(middle(v)); count = count + 8'd1; end end
      initial begin #2; v = 4'b0010; #1; v = 4'b1011; #1; v = 4'b1101; end
    endmodule
  "#)
  (top Top)
  (run_until 2) (assert_eq count 1)
  (run_until 3) (assert_eq count 1 "the result stayed 1")
  (run_until 4) (assert_eq count 2))

(case event_expressions_read_automatic_task_locals
  ; Each call waits on `q[i]` with its own `i`, sampled when the event
  ; control begins: the second call does not wake because `q[1]` differs
  ; from the `q[0]` the first one waited on.
  (source "task_local_event.sv" #"
    module Top(output int first, second);
      bit [3:0] q;
      task automatic await(input int i, output int at);
        @(q[i]);
        at = $time;
      endtask
      initial begin #2; await(0, first); await(1, second); end
      initial begin #3; q[0] = 1; #3; q[1] = 1; end
    endmodule
  "#)
  (top Top)
  (run_until 3) (assert_eq first 3) (assert_eq second 0)
  (run_until 5) (assert_eq second 0)
  (run_until 6) (assert_eq second 6))

(case event_controls_sample_the_expression_when_they_begin
  ; IEEE 1800-2023 9.4.2: the process's own write before the event
  ; control is no event of it.
  (source "event_sample.sv" #"
    module Top(output bit hit);
      bit a, b;
      initial begin #1; a = 1; @(a ^ b); hit = 1; end
      initial begin #2; b = 1; end
    endmodule
  "#)
  (top Top)
  (run_until 1)
  (assert_eq hit 0)
  (run_until 2)
  (assert_eq hit 1))

(case implicit_event_controls_in_processes_wait_on_their_reads
  ; IEEE 1800-2023 9.4.2.2: `@*` waits on the variables the statement it
  ; controls reads, not on those it writes.
  (source "implicit_event.sv" #"
    module Top(output bit [7:0] y, z, count);
      bit [7:0] a, b;
      initial forever @* begin y = a + b; count = count + 8'd1; end
      always @* begin #1; z = a; end
      initial begin #2; a = 3; #2; b = 4; end
    endmodule
  "#)
  (top Top)
  (run_until 1) (assert_eq count 0) (assert_eq y 0)
  (run_until 2) (assert_eq count 1) (assert_eq y 3)
  (run_until 3) (assert_eq z 3)
  (run_until 4) (assert_eq count 2) (assert_eq y 7) (assert_eq z 3))

; Scheduling boundaries: processes that only delay, processes woken by one
; clock edge, generated clocks feeding flip-flop domains, and the points where
; a simulator may run them differently from other processes. Each case keeps
; its result independent of the order the standard leaves open between
; processes of one region (IEEE 1800-2023 4.5, 4.7).

; A process resumed by `#0` runs in the inactive region, after the active
; region has run the flip-flop domain its edge triggered.
(case zero_delay_process_ends_a_pulse_after_its_edge_triggers
  (source "pulse.sv" #"
                module Top(output logic [7:0] count, output logic p);
                    initial p = 1'b0;
                    initial count = 8'd0;
                    always begin #10 p = 1'b1; #0 p = 1'b0; end
                    always_ff @(posedge p) count <= count + 8'd1;
                endmodule
            "#)
  (top Top)
  (run_until 5)
  (assert_eq count 0)
  (run_until 35)
  (assert_eq count 3 "every zero-width pulse is an edge")
  (assert_eq p 0))

; Edge waits count the same edges wherever the process that generates the
; clock is declared, also for an edge no flip-flop domain uses.
(case edge_waits_count_generated_clock_edges_in_any_declaration_order
  (source "order.sv" #"
                module Top(output logic [7:0] before_clock, after_clock, falls);
                    logic clk = 1'b0;
                    initial begin
                        before_clock = 8'd0;
                        forever @(posedge clk) before_clock = before_clock + 8'd1;
                    end
                    always #5 clk = ~clk;
                    initial begin
                        after_clock = 8'd0;
                        forever @(posedge clk) after_clock = after_clock + 8'd1;
                    end
                    initial begin
                        falls = 8'd0;
                        forever @(negedge clk) falls = falls + 8'd1;
                    end
                endmodule
            "#)
  (top Top)
  (run_until 4)
  (assert_eq before_clock 0)
  ; Rising edges at 5, 15, ..., 95; falling edges at 10, 20, ..., 100.
  (run_until 100)
  (assert_eq before_clock 10)
  (assert_eq after_clock 10)
  (assert_eq falls 10))

; Nonblocking assignments of a process that only delays publish in the NBA
; region of their own time, between the clock edges.
(case delay_process_nonblocking_updates_reach_later_edges
  (source "delay_nba.sv" #"
                module Top(output logic [7:0] s, q);
                    logic clk = 1'b0;
                    always #5 clk = ~clk;
                    initial begin
                        s = 8'd0;
                        #12 s <= 8'd5;
                        #10 s <= s + 8'd1;
                    end
                    always_ff @(posedge clk) q <= s;
                endmodule
            "#)
  (top Top)
  (run_until 12)
  (assert_eq s 5)
  (run_until 16)
  (assert_eq q 5)
  (run_until 26)
  (assert_eq s 6)
  (assert_eq q 6))

; A clock whose half period is a variable: each delay reads it when the
; process reaches the delay.
(case variable_delay_clock_changes_its_period
  (source "variable_period.sv" #"
                module Top(output logic [7:0] count);
                    logic clk = 1'b0;
                    logic [7:0] half = 8'd5;
                    initial count = 8'd0;
                    always #(half) clk = ~clk;
                    initial #37 half = 8'd10;
                    always_ff @(posedge clk) count <= count + 8'd1;
                endmodule
            "#)
  (top Top)
  ; Rising edges at 5, 15, 25, 35, then 50 and 70.
  (run_until 45)
  (assert_eq count 4)
  (run_until 75)
  (assert_eq count 6))

(case asynchronous_reset_driven_by_a_delay_process
  (source "async_reset.sv" #"
                module Top(output logic [7:0] q);
                    logic clk = 1'b0;
                    logic rst = 1'b0;
                    always #5 clk = ~clk;
                    initial begin
                        #2 rst = 1'b1;
                        #10 rst = 1'b0;
                        #31 rst = 1'b1;
                        #4 rst = 1'b0;
                    end
                    always_ff @(posedge clk or posedge rst)
                        if (rst) q <= 8'd0;
                        else q <= q + 8'd1;
                endmodule
            "#)
  (top Top)
  (run_until 3)
  (assert_eq q 0)
  ; Counting edges at 15, 25 and 35.
  (run_until 40)
  (assert_eq q 3)
  (run_until 44)
  (assert_eq q 0 "the reset asserts between clock edges")
  ; Held in reset at 45; counting again at 55.
  (run_until 56)
  (assert_eq q 1))

; Two generated clocks rise at the same time: each domain samples the
; other's registers from before the edge.
(case generated_clocks_with_a_common_edge_sample_each_other
  (source "two_clocks.sv" #"
                module Top(output logic [7:0] a_count, b_count, a_seen, b_seen);
                    logic a = 1'b0;
                    logic b = 1'b0;
                    always #5 a = ~a;
                    always #15 b = ~b;
                    initial begin
                        a_count = 8'd0;
                        b_count = 8'd0;
                    end
                    always_ff @(posedge a) begin
                        a_count <= a_count + 8'd1;
                        a_seen <= b_count;
                    end
                    always_ff @(posedge b) begin
                        b_count <= b_count + 8'd1;
                        b_seen <= a_count;
                    end
                endmodule
            "#)
  (top Top)
  ; a rises at 5, 15, 25, 35, 45; b at 15 and 45.
  (run_until 50)
  (assert_eq a_count 5)
  (assert_eq b_count 2)
  (assert_eq a_seen 1)
  (assert_eq b_seen 4))

; Inputs the script writes between runs reach combinational logic before the
; next generated clock edge samples it.
(case script_writes_between_runs_reach_generated_clock_domains
  (source "host_comb.sv" #"
                module Top(input logic [7:0] in, output logic [7:0] sum, q);
                    logic clk = 1'b0;
                    logic [7:0] r = 8'd0;
                    always #5 clk = ~clk;
                    assign sum = in + r;
                    assign q = r;
                    always_ff @(posedge clk) r <= sum;
                endmodule
            "#)
  (top Top)
  (run_until 0)
  (modify (set in 1))
  (run_until 6)
  (assert_eq q 1)
  (assert_eq sum 2)
  (modify (set in 3))
  (run_until 7)
  (assert_eq sum 4 "a write settles without a clock edge")
  (run_until 16)
  (assert_eq q 4)
  (assert_eq sum 7))

; An edge wait on an input the script drives, next to a generated clock.
(case edge_waits_on_script_inputs_next_to_a_generated_clock
  (source "host_wait.sv" #"
                module Top(input logic go, output logic [7:0] ticks, at_go);
                    logic clk = 1'b0;
                    logic [7:0] n = 8'd0;
                    always #5 clk = ~clk;
                    always_ff @(posedge clk) n <= n + 8'd1;
                    assign ticks = n;
                    initial begin
                        at_go = 8'd0;
                        forever begin
                            @(posedge go);
                            at_go = n;
                        end
                    end
                endmodule
            "#)
  (top Top)
  (run_until 0)
  (modify (set go 0))
  (run_until 22)
  (modify (set go 1))
  (run_until 23)
  (assert_eq at_go 2)
  (modify (set go 0))
  (run_until 37)
  (modify (set go 1))
  (run_until 38)
  (assert_eq at_go 4)
  (assert_eq ticks 4))

; `$finish` from a process that only delays ends the run between edges.
(case finish_from_a_delay_process_between_clock_edges
  (source "delay_finish.sv" #"
                module Top(output logic [7:0] count);
                    logic clk = 1'b0;
                    initial count = 8'd0;
                    always #5 clk = ~clk;
                    always_ff @(posedge clk) count <= count + 8'd1;
                    initial #27 $finish;
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (assert_eq count 3))

(case static_function_storage_is_shared_between_processes
  (source "static_processes.sv" #"
    module Top(output int first, second, third);
      function int next_value();
        static int saved = 11;
        saved++;
        return saved;
      endfunction
      initial begin
        #1 first = next_value();
        #2 third = next_value();
      end
      initial begin
        #2 second = next_value();
        #2 $finish;
      end
    endmodule
  "#)
  (top Top)
  (run_to_finish)
  (assert_eq first 12) (assert_eq second 13) (assert_eq third 14))

(case static_function_readonly_initializer_calls_execute_once
  (source "static_initializer.sv" #"
    module Top(output int cached, next, cached_again, next_again);
      function int count();
        static bit [31:0] value;
        value++;
        return value;
      endfunction
      function int remember();
        static int value = count();
        return value;
      endfunction
      initial begin
        #1 cached = remember();
        next = count();
        #1 cached_again = remember();
        next_again = count();
        #1 $finish;
      end
    endmodule
  "#)
  (top Top)
  (run_to_finish)
  (assert_eq cached 1) (assert_eq next 2)
  (assert_eq cached_again 1) (assert_eq next_again 3))

; A process waiting on a variable sees every store to it, including one a
; later store of the same evaluation overwrites (IEEE 1800-2023 4.3, 9.4.2).
(case intermediate_combinational_writes_wake_waiters
  (source "comb.sv" #"
                module Top;
                    bit a, b, c, d, y1, y2;
                    int n1, n2;
                    always_comb begin y1 = 0; if (a) y1 = 1; c = b; end
                    always @* begin y2 = 0; if (a) y2 = 1; d = b; end
                    initial forever begin @(y1); n1++; end
                    initial forever begin @(y2); n2++; end
                    initial begin
                        #1 a = 1;
                        // While a is 1, each change of b rewrites y 1 -> 0 -> 1.
                        #1 b = 1;
                        #1 b = 0;
                        #1 $display("comb=%0d star=%0d", n1, n2);
                        $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "comb=3 star=3\n"))

; The processes share one clock, so a parallel build evaluates them as
; separate parts. Nonblocking updates apply in the NBA region in issue
; order, each its own update (IEEE 1800-2023 4.5, 10.4.2); edges are judged
; on each update.
(case intermediate_edge_process_writes_wake_waiters
  (source "ff.sv" #"
                module Top;
                    bit a, clk, y3, y4, y5;
                    int n3, n4, n5, p4, f5;
                    always @(posedge clk) begin y3 = 0; if (a) y3 = 1; end
                    always_ff @(posedge clk) begin y4 <= 0; if (a) y4 <= 1; end
                    always @(posedge clk) begin y5 = 0; y5 = 1; end
                    initial forever begin @(y3); n3++; end
                    initial forever begin @(y4); n4++; end
                    initial forever begin @(y5); n5++; end
                    initial forever begin @(posedge y4); p4++; end
                    initial forever begin @(negedge y5); f5++; end
                    initial begin
                        #1 a = 1;
                        #1 clk = 1;
                        #1 clk = 0;
                        #1 clk = 1;
                        #1 clk = 0;
                        #1 clk = 1;
                        #1 $display("blk=%0d nba=%0d const=%0d rise=%0d fall=%0d", n3, n4, n5, p4, f5);
                        $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "blk=3 nba=3 const=3 rise=3 fall=2\n"))

; A variable written by blocking and nonblocking assignments of one process:
; each nonblocking update, whole or partial, is its own update in the NBA
; region. The blocking value equals the old one, so no waiter runs between
; the regions.
(case staged_nonblocking_writes_wake_waiters
  (source "staged.sv" #"
                module Top;
                    bit clk, y = 1;
                    bit [1:0] z = 2'b11;
                    int n, m;
                    always @(posedge clk) begin y = 1; y <= 0; y <= 1; end
                    always @(posedge clk) begin
                        z = 2'b11;
                        z[0] <= 0;
                        z[1] <= 0;
                        z[0] <= 1;
                        z[1] <= 1;
                    end
                    initial forever begin @(y); n++; end
                    initial forever begin @(z); m++; end
                    initial begin
                        #1 clk = 1;
                        #1 clk = 0;
                        #1 clk = 1;
                        #1 clk = 0;
                        #1 clk = 1;
                        #1 $display("y=%0d z=%0d", n, m);
                        $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "y=3 z=3\n"))

; The output port of a child is a continuous assignment to the parent's
; net (IEEE 1800-2023 23.3.3), evaluated after the child's process yields,
; so the parent may miss a pulse the child writes inside one evaluation
; (4.7). Celox, like Verilator, sees only the settled value.
(case child_port_pulses_reach_waiters_settled
  (source "child.sv" #"
                module Child(input bit a, b, output bit y, c);
                    always_comb begin y = 0; if (a) y = 1; c = b; end
                endmodule
                module Top;
                    bit a, b, y, c;
                    int n;
                    Child u(.a(a), .b(b), .y(y), .c(c));
                    initial forever begin @(y); n++; end
                    initial begin
                        #1 a = 1;
                        #1 b = 1;
                        #1 b = 0;
                        #1 $display("child=%0d", n);
                        $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "child=1\n"))

; A process whose intermediate writes are counted drives only some bits of
; its variable; the other bits keep their own drivers.
(case intermediate_combinational_writes_keep_other_drivers
  (source "drivers.sv" #"
                module Top;
                    logic a = 0, b = 0, e = 0, c, d;
                    logic [7:0] y, z;
                    int n, m;
                    assign y[7:4] = 4'hA;
                    always_comb begin y[3:0] = 0; if (a) y[3:0] = 1; c = b; end
                    always_comb begin z[3:0] = 0; if (a) z[3:0] = 1; d = b; end
                    always_comb z[7:4] = {4{e}};
                    initial #1 forever begin @(y); n++; end
                    initial #1 forever begin @(z); m++; end
                    initial begin
                        #2 a = 1;
                        // While a is 1, each change of b rewrites y and z
                        // 1 -> 0 -> 1 in their low bits.
                        #1 b = 1;
                        #1 e = 1;
                        #1 $display("y=%h z=%h n=%0d m=%0d", y, z, n, m);
                        $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "y=a1 z=f1 n=2 m=3\n"))

; One process pulses y[0] back to its value, and processes of the same clock
; write the other bits of y unchanged. A parallel build evaluates every
; process before any commits; the pulse still counts.
(case parallel_flip_flop_parts_keep_pulses
  (source "parts.sv" #"
                module Top;
                    bit clk;
                    bit [2:0] y = 3'b001;
                    bit [63:0] p, q, r, s;
                    int n, f;
                    always_ff @(posedge clk) y[2] <= y[2];
                    always_ff @(posedge clk) begin y[0] <= 0; y[0] <= 1; end
                    always_ff @(posedge clk) y[1] <= y[1];
                    // Independent work, so that a parallel build splits the
                    // processes into parts.
                    always_ff @(posedge clk) p <= p * 64'd7 + (p >> 3) + 64'd1;
                    always_ff @(posedge clk) q <= q * 64'd11 + (q >> 5) + 64'd3;
                    always_ff @(posedge clk) r <= r * 64'd13 + (r >> 7) + 64'd5;
                    always_ff @(posedge clk) s <= s * 64'd17 + (s >> 9) + 64'd9;
                    initial forever begin @(y); n++; end
                    initial forever begin @(negedge y); f++; end
                    initial begin
                        #1 clk = 1;
                        #1 clk = 0;
                        #1 clk = 1;
                        #1 $display("y=%b n=%0d f=%0d", y, n, f);
                        $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "y=001 n=2 f=2\n"))

; The nonblocking updates apply after the blocking value was published:
; y[0] <= 1 rises from the final blocking value 0, not from the 1 it held
; when the update was issued. The blocking writes only fall, so the waiter
; sees the rise in the NBA region.
(case staged_nonblocking_writes_follow_later_blocking_writes
  (source "staged_order.sv" #"
                module Top;
                    bit clk;
                    bit [1:0] y = 2'b01;
                    int r;
                    always @(posedge clk) begin y[1] <= 0; y[0] <= 1; y = 2'b00; end
                    initial forever begin @(posedge y); r++; end
                    initial begin
                        #1 clk = 1;
                        #1 clk = 0;
                        #1 clk = 1;
                        #1 $display("y=%b r=%0d", y, r);
                        $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "y=01 r=2\n"))

; A reader of some bits of the counted variable splits its symbolic
; definition at those bits; the imperative unit replaces every piece.
(case intermediate_combinational_writes_replace_split_definitions
  (source "split.sv" #"
                module Top;
                    logic [3:0] y, a = 4'b0101, b;
                    logic [1:0] w;
                    logic c = 0;
                    int n;
                    always_comb begin y = 4'b0; if (c) y = a; b = a; end
                    assign w = y[1:0];
                    initial #1 forever begin @(y); n++; end
                    initial begin
                        #2 c = 1;
                        // While c is 1, each change of a rewrites y through 0.
                        #1 a = 4'b0110;
                        #1 a = 4'b0111;
                        #1 $display("y=%b w=%b n=%0d", y, w, n);
                        $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "y=0111 w=11 n=3\n"))

; A wait on a part-select of a variable an always_comb rewrites through 0.
; The continuous assignment updates w when y changes (IEEE 1800-2023 10.3);
; a simulator may interleave it with the process (4.7), but Celox, like
; Icarus and Verilator, evaluates it after the process: one event per
; settled change of y[3:0].
(case intermediate_combinational_writes_reach_part_select_waiters_settled
  (source "part_select.sv" #"
                module Top;
                    logic [7:0] y, a = 8'h15;
                    logic [3:0] w;
                    logic c = 0;
                    int n;
                    always_comb begin y = 8'h0; if (c) y = a; end
                    assign w = y[3:0];
                    initial #1 forever begin @(w); n++; end
                    initial begin
                        #2 c = 1;
                        #1 a = 8'h16;
                        #1 a = 8'h26;
                        #1 $display("y=%h w=%h n=%0d", y, w, n);
                        $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "y=26 w=6 n=2\n"))

; The counted variable is an output port that the parent connects to a
; concatenation.
(case intermediate_combinational_writes_reach_concatenated_ports
  (source "ports.sv" #"
                module Child(input logic c, input logic [3:0] a, output logic [3:0] y);
                    int n;
                    always_comb begin y = 4'b0; if (c) y = a; end
                    initial #1 forever begin @(y); n++; end
                    initial #5 $display("y=%b n=%0d", y, n);
                endmodule
                module Top;
                    logic [3:0] a = 4'b0101;
                    logic [1:0] p, q;
                    logic c = 0;
                    Child u(.c(c), .a(a), .y({p, q}));
                    initial begin
                        #2 c = 1;
                        #1 a = 4'b0110;
                        #1 a = 4'b1001;
                        #2 $display("p=%b q=%b", p, q);
                        $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "y=1001 n=3\np=10 q=01\n"))

; A blocking write of an edge process is an update of the active region:
; the process waiting on it runs there, before the NBA region applies the
; same edge's nonblocking update (IEEE 1800-2023 4.5, 9.4.2).
(case blocking_write_waiters_run_before_nonblocking_updates
  (source "active.sv" #"
                module Top;
                    bit clk, y;
                    int q;
                    always @(posedge clk) begin y = ~y; q <= q + 1; end
                    initial forever begin @(y); $display("y=%0d q=%0d", y, q); end
                    initial begin
                        #1 clk = 1;
                        #1 clk = 0;
                        #1 clk = 1;
                        #1 $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "y=1 q=0\ny=0 q=1\n"))

; The waiter the blocking write wakes waits again before the nonblocking
; updates, so they wake it once more.
(case blocking_write_waiters_rearm_before_nonblocking_updates
  (source "rearm.sv" #"
                module Top;
                    bit clk, y;
                    int n, r;
                    always @(posedge clk) begin y = 1; y <= 0; y <= 1; end
                    initial forever begin @(y); n++; end
                    initial forever begin @(posedge y); r++; end
                    initial begin
                        #1 clk = 1;
                        #1 clk = 0;
                        #1 clk = 1;
                        #1 $display("n=%0d r=%0d", n, r);
                        $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "n=3 r=3\n"))

; Processes and edge processes woken by the blocking write read the
; variables the same edge updates nonblocking before the update.
(case blocking_write_edges_read_values_before_nonblocking_updates
  (source "derived.sv" #"
                module Top;
                    bit clk, g;
                    int q, r, s;
                    always @(posedge clk) begin g = ~g; q <= q + 1; end
                    always @(g) r <= q;
                    initial forever begin @(g); s = q; end
                    initial begin
                        #1 clk = 1;
                        #1 clk = 0;
                        #1 clk = 1;
                        #1 $display("q=%0d r=%0d s=%0d", q, r, s);
                        $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "q=2 r=1 s=1\n"))

(case plain_always_expression_edges_run_as_processes
  ; IEEE 1800-2023 9.2.2.4 restricts only always_ff to the flip-flop shape.
  ; A plain always waits on its event control like any other process: an
  ; edge of a select or an expression, or `edge` (9.4.2).
  (source "always_expression_edges.sv" #"
    module Top(output bit [7:0] selected, both, any);
      bit [3:0] v;
      bit a, b;
      always @(posedge v[1]) selected = selected + 8'd1;
      always @(posedge (a & b)) both = both + 8'd1;
      always @(edge a) any = any + 8'd1;
      initial begin
        #1; v = 4'b0010; a = 1;
        #1; b = 1;
        #1; v = 4'b0000; a = 0;
        #1; v = 4'b0010; a = 1;
      end
    endmodule
  "#)
  (top Top)
  (run_until 1)
  (assert_eq selected 1)
  (assert_eq both 0)
  (assert_eq any 1)
  (run_until 2)
  (assert_eq both 1 "a & b rose")
  (run_until 4)
  (assert_eq selected 2)
  (assert_eq both 2)
  (assert_eq any 3 "a rose, fell and rose"))

(case plain_always_multi_bit_edges_follow_the_lsb
  ; Table 9-2 judges the edge of a multi-bit expression on its least
  ; significant bit.
  (source "always_multi_bit_edge.sv" #"
    module Top(output bit [7:0] count);
      bit [3:0] bus;
      always @(posedge bus) count = count + 8'd1;
      initial begin
        #1; bus = 4'b0010;
        #1; bus = 4'b0011;
        #1; bus = 4'b0000;
        #1; bus = 4'b0001;
      end
    endmodule
  "#)
  (top Top)
  (run_until 1)
  (assert_eq count 0 "the least significant bit stayed 0")
  (run_until 2)
  (assert_eq count 1)
  (run_until 4)
  (assert_eq count 2))

(case plain_always_edges_without_a_reset_run_as_processes
  ; Neither edge is tested in the body, so neither is an asynchronous
  ; reset: the process wakes on each of them.
  (source "always_two_edges.sv" #"
    module Top(output bit [7:0] count);
      bit c, d;
      always @(posedge c or posedge d) count <= count + 8'd1;
      initial begin
        #1; c = 1;
        #1; d = 1;
        #1; c = 0; d = 0;
        #1; c = 1;
      end
    endmodule
  "#)
  (top Top)
  (run_until 1)
  (assert_eq count 1)
  (run_until 2)
  (assert_eq count 2)
  (run_until 4)
  (assert_eq count 3))

; A nonblocking assignment in a process to an element of an unpacked array
; or at a run-time position evaluates the position when it executes and
; updates those bits in the NBA region (IEEE 1800-2023 10.4.2).
(case process_nonblocking_assignments_to_array_elements
  (source "process_nba_elements.sv" #"
      module Top(output logic [7:0] m0, m1, m2, m3, e, d1, d2, output logic [3:0] lo, hi,
                 output logic [7:0] early);
        logic [7:0] m [0:3];
        logic [7:0] grid [4][2];
        logic [3:0] mem [3:0];
        int i, j;
        initial begin
          for (i = 0; i < 4; i++) begin
            m[i] = 8'd0;
            mem[i] = 4'd0;
            for (j = 0; j < 2; j++) grid[i][j] = 8'd0;
          end
          #1;
          m[1] <= 8'h11;
          i = 2;
          m[i] <= 8'h22;
          i = 3;
          #0 early = m[2];
          #1;
          for (i = 0; i < 4; i++) m[i] <= m[i] + 8'h40;
          i = 1;
          m[i][3:0] <= 4'h9;
          m[i][7:4] <= 4'hc;
          i = 2;
          j = 1;
          grid[i][j] <= 8'hab;
          grid[3][0] <= 8'hcd;
          mem[i] <= 4'h5;
          mem[0] <= 4'h7;
          #1;
          i = 0;
          m[i] <= 8'h01;
          m[i] <= 8'h02;
          {m[3], mem[i]} <= 12'hfe3;
        end
        assign m0 = m[0];
        assign m1 = m[1];
        assign m2 = m[2];
        assign m3 = m[3];
        assign e = grid[2][1];
        assign d1 = grid[3][0];
        assign d2 = grid[2][0];
        assign lo = mem[0];
        assign hi = mem[2];
      endmodule"#)
  (top Top)
  (run_until 1)
  (assert_eq early 0 "the update lands after the inactive region")
  (assert_eq m1 0x11)
  (assert_eq m2 0x22 "the index is read when the assignment executes")
  (assert_eq m3 0)
  (run_until 2)
  (assert_eq m0 0x40)
  (assert_eq m1 0xc9 "a part of a run-time element keeps its other bits")
  (assert_eq m2 0x62)
  (assert_eq m3 0x40)
  (assert_eq e 0xab)
  (assert_eq d1 0xcd)
  (assert_eq d2 0)
  (assert_eq hi 5)
  (assert_eq lo 7)
  (run_until 3)
  (assert_eq m0 0x02 "the last update of a time slot wins")
  (assert_eq m3 0xfe)
  (assert_eq lo 3))

(case process_nonblocking_assignments_at_run_time_positions
  (source "process_nba_positions.sv" #"
      module Top(output logic [7:0] q, a, output logic [15:0] staged, output logic [14:0] packed_bits);
        logic [0:7] up;
        logic [7:0] r [0:3];
        int i, n;
        initial begin
          q = 8'd0;
          up = 8'd0;
          #1;
          i = 2;
          q[i] <= 1'b1;
          up[i] <= 1'b1;
          i = 4;
          q[i +: 3] <= 3'b101;
          up[i -: 2] <= 2'b11;
          i = 7;
        end
        // The only writer of `r` and `p`: their updates are staged.
        logic [13:0] p = 14'd0;
        int j;
        initial begin
          for (n = 0; n < 2; n++) begin
            for (j = n; j < n + 6; j++) begin
              r[j % 4] <= 8'h10 * n + j;
              p[2 * j +: 3] <= j;
            end
            #1;
          end
        end
        assign a = up;
        assign staged = {r[3], r[0]};
        // Extended, so that `p` does not become a port.
        assign packed_bits = {1'b0, p};
      endmodule"#)
  (top Top)
  (run_until 0)
  (assert_eq staged 0x0304 "one site several times in a time slot: the last update wins")
  (assert_eq packed_bits 0x14e4 "bits past the top are not written")
  (run_until 1)
  (assert_eq q 0x54)
  (assert_eq a 0x38 "an ascending vector counts its bits from the left")
  (assert_eq staged 0x1314)
  (assert_eq packed_bits 0x24e4))

; Bits outside the target are not written: a nonblocking assignment wholly
; outside has no effect, and one partly outside writes the bits inside
; (IEEE 1800-2023 7.4.6, 11.5.1).
(case process_nonblocking_assignments_outside_their_target
  (source "process_nba_outside.sv" #"
      module Top(output logic [7:0] q, p, m0, m1, m2, m3);
        logic [7:0] m [0:3];
        int i, k;
        initial begin
          q = 8'd0;
          p = 8'd0;
          for (i = 0; i < 4; i++) m[i] = 8'd0;
          #1;
          q[8] <= 1'b1;
          q[9:6] <= 4'b1111;
          i = 4;
          m[i] <= 8'hff;
          i = -1;
          m[i] <= 8'hee;
          k = 6;
          p[k +: 4] <= 4'b0101;
          k = -2;
          p[k +: 4] <= 4'b1010;
        end
        assign m0 = m[0];
        assign m1 = m[1];
        assign m2 = m[2];
        assign m3 = m[3];
      endmodule"#)
  (top Top)
  (run_until 1)
  (assert_eq q 0xc0)
  (assert_eq p 0x42)
  (assert_eq m0 0)
  (assert_eq m1 0)
  (assert_eq m2 0)
  (assert_eq m3 0))

; A position with an unknown bit writes nothing (IEEE 1800-2023 7.4.6,
; 11.5.1).
(case process_nonblocking_assignments_at_unknown_positions
  (source "process_nba_unknown.sv" #"
      module Top(output logic [7:0] q, m0, m1);
        logic [7:0] m [0:1];
        logic [2:0] i = 3'bx;
        initial begin
          q = 8'd0;
          m[0] = 8'd0;
          m[1] = 8'd0;
          #1;
          m[i] <= 8'hff;
          q[i] <= 1'b1;
          q[i +: 2] <= 2'b11;
          i = 3'd1;
        end
        assign m0 = m[0];
        assign m1 = m[1];
      endmodule"#)
  (top Top)
  (four_state)
  (run_until 1)
  (assert_eq q 0)
  (assert_eq m0 0)
  (assert_eq m1 0))

(case edge_nonblocking_updates_keep_later_writes_of_other_bits
  ; An edge process evaluates, then a zero-delay resumption writes the same
  ; variables before the NBA region (IEEE 1800-2023 4.4.2.4). The
  ; nonblocking updates change only the bits they assign (10.4.2): the
  ; resumption's writes to other bits, elements and variables stay, also
  ; where no assignment executed, and an update of the same bits wins.
  (source "nba_window.sv" #"
                module Top(output logic [31:0] m0, m2, m3, m5, q, r);
                    bit clk = 1'b0;
                    bit en = 1'b0;
                    bit [3:0] i = 4'd0;
                    bit [4:0] k = 5'd3;
                    bit [31:0] mem [16];
                    bit [31:0] q_, r_;
                    always #5 clk = ~clk;
                    always @(posedge clk) begin
                        mem[i][15:8] <= 8'h44;
                        mem[i + 2] <= 32'h11;
                        if (en) q_ <= 32'h11;
                        r_[k] <= 1'b1;
                    end
                    initial begin
                        for (int j = 0; j < 16; j++) mem[j] = 0;
                        q_ = 0;
                        r_ = 0;
                        @(posedge clk);
                        #0;
                        mem[0][7:0] = 8'h22;
                        mem[2][31:24] = 8'h77;
                        mem[3] = 32'h33;
                        mem[5][7:0] = 8'h55;
                        q_ = 32'h66;
                        r_[20] = 1'b1;
                    end
                    assign m0 = mem[0];
                    assign m2 = mem[2];
                    assign m3 = mem[3];
                    assign m5 = mem[5];
                    assign q = q_;
                    assign r = r_;
                endmodule
            "#)
  (top Top)
  (run_until 6)
  (assert_eq m0 0x4422)
  (assert_eq m2 0x11)
  (assert_eq m3 0x33)
  (assert_eq m5 0x55)
  (assert_eq q 0x66 "no nonblocking assignment to q executed")
  (assert_eq r 0x100008))

(case edge_nonblocking_updates_follow_writes_their_blocking_results_wake
  ; The edge process's blocking result wakes a waiting process in the
  ; active region, before the NBA region (IEEE 1800-2023 4.5). Its write
  ; stays where no nonblocking assignment executed.
  (source "nba_active_window.sv" #"
                module Top(output logic [7:0] q, output logic [7:0] p);
                    bit clk = 1'b0;
                    bit flag = 1'b0;
                    bit en = 1'b0;
                    bit [7:0] q_ = 8'd0, p_ = 8'd0;
                    always #5 clk = ~clk;
                    always @(posedge clk) begin
                        flag = 1'b1;
                        if (en) q_ <= 8'h11;
                        p_ <= 8'h44;
                    end
                    initial begin
                        @(posedge flag);
                        q_ = 8'h22;
                        p_ = 8'h33;
                    end
                    assign q = q_;
                    assign p = p_;
                endmodule
            "#)
  (top Top)
  (run_until 6)
  (assert_eq q 0x22)
  (assert_eq p 0x44 "the nonblocking update is later"))

(case edge_blocking_results_precede_later_process_writes
  ; A blocking assignment of an edge process takes effect when it executes:
  ; a zero-delay resumption that writes the variable afterwards, without
  ; reading it, leaves its own value.
  (source "blocking_window.sv" #"
                module Top(output logic [7:0] t);
                    bit clk = 1'b0;
                    bit [7:0] t_ = 8'd0;
                    always #5 clk = ~clk;
                    always @(posedge clk) t_ = 8'h11;
                    initial begin
                        @(posedge clk);
                        #0;
                        t_ = 8'h22;
                    end
                    assign t = t_;
                endmodule
            "#)
  (top Top)
  (run_until 6)
  (assert_eq t 0x22))

; A clock computed from a clock that one of several nonblocking updates
; changes has its edge in that NBA region (IEEE 1800-2023 4.5, 10.4.2):
; `rclk = clk & ren` rises with `clk` while `ren` is 1.
(case derived_clocks_follow_several_nonblocking_updates
  (source "derived_nba.sv" #"
                module Top;
                  bit clk, clk2; bit ren = 0; bit rclk; bit [7:0] e = 0;
                  assign rclk = clk & ren;
                  always_ff @(posedge clk) ren <= ~ren;
                  always_ff @(posedge rclk) e <= e + 8'd1;
                  initial begin
                    #9 clk <= 1; #1; clk <= 0;
                    #3 clk <= 1; clk2 <= 1; #1; clk <= 0; clk2 <= 0;
                    #3 clk <= 1; #1; clk <= 0;
                  end
                  initial begin #12 $display("t12 e=%0d", e); #4 $display("t16 e=%0d", e); #4 $display("t20 e=%0d", e); $finish; end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "t12 e=1\nt16 e=2\nt20 e=3\n"))

; A clock computed from a blocking result that a domain commits in the
; active region (#1783) has its edges there.
(case derived_clocks_follow_active_region_commits
  (source "derived_active.sv" #"
                module Top;
                  bit clk, clk2, c2, en = 1;
                  wire g = c2 & en;
                  int cnt, w;
                  always @(posedge clk) c2 = ~c2;
                  initial forever begin @(c2); w++; end
                  always_ff @(posedge g) cnt <= cnt + 1;
                  initial begin
                    repeat (4) begin #1 clk <= 1; clk2 <= 1; #1 clk <= 0; clk2 <= 0; end
                    #1 $display("cnt=%0d w=%0d", cnt, w);
                    $finish;
                  end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "cnt=2 w=4\n"))

; A domain evaluated twice before one NBA region publishes both
; evaluations; the continuous assignment of the clock computed from its
; output sees the final value (IEEE 1800-2023 4.7).
(case derived_clocks_follow_superseded_publications
  (source "derived_superseded.sv" #"
                module Top;
                  bit clk, c, q, en = 1;
                  wire gq = q & en;
                  int cnt, n;
                  always_ff @(posedge clk) q <= c;
                  always_ff @(posedge gq) cnt <= cnt + 1;
                  initial forever begin @(q); n++; end
                  initial begin
                    #1 c = 1; clk = 1;
                    #0 clk = 0; c = 0;
                    #0 clk = 1;
                    #1 clk = 0;
                    #1 $display("cnt=%0d n=%0d q=%0d", cnt, n, q);
                    $finish;
                  end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "cnt=0 n=1 q=0\n"))

; An item with `iff` is an event only if the condition holds when the
; occurrence happens; changes of the condition alone are no events
; (IEEE 1800-2023 9.4.2.3).
(case iff_events_occur_only_while_the_condition_holds
  (source "iff.sv" #"
                module Top;
                  bit clk, en;
                  int n, m;
                  initial forever begin @(posedge clk iff en); n++; end
                  initial forever begin @(clk iff en); m++; end
                  initial begin
                    #1 clk = 1;
                    #1 clk = 0;
                    #1 en = 1;
                    #1 clk = 1;
                    #1 en = 0;
                    #1 en = 1;
                    #1 clk = 0;
                    #1 clk = 1;
                    #1 $display("n=%0d m=%0d", n, m);
                    $finish;
                  end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "n=2 m=3\n"))

; The process writes the condition before the clock: the edge occurs while
; the condition holds.
(case iff_conditions_see_writes_before_the_event
  (source "iff_order.sv" #"
                module Top;
                  bit clk, en;
                  int n;
                  initial forever begin @(posedge clk iff en); n++; end
                  initial begin
                    #1 en = 1; clk = 1;
                    #1 clk = 0;
                    #1 en = 0;
                    #1 clk = 1;
                    #1 $display("n=%0d", n);
                    $finish;
                  end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "n=1\n"))

; Each item has its own condition; the condition's operands are not
; events of the wait.
(case iff_conditions_apply_to_their_own_items
  (source "iff_items.sv" #"
                module Top;
                  bit a, b, c;
                  int n;
                  initial forever begin @(a iff c or b); n++; end
                  initial begin
                    #1 a = 1;
                    #1 b = 1;
                    #1 c = 1;
                    #1 a = 0;
                    #1 c = 0;
                    #1 a = 1;
                    #1 $display("n=%0d", n);
                    $finish;
                  end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "n=2\n"))

; A condition reading an automatic task argument uses the activation's
; value.
(case iff_conditions_read_automatic_task_arguments
  (source "iff_task.sv" #"
                module Top;
                  bit clk, en;
                  int n0, n1;
                  task automatic w(input bit m, output int hits);
                    hits = 0;
                    repeat (3) begin @(posedge clk iff (en & m)); hits++; end
                  endtask
                  initial w(1, n1);
                  initial w(0, n0);
                  initial begin
                    en = 1;
                    repeat (4) begin #1 clk = 1; #1 clk = 0; end
                    #1 $display("n1=%0d n0=%0d", n1, n0);
                    $finish;
                  end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "n1=3 n0=0\n"))

; An X or Z condition is false.
(case unknown_iff_conditions_are_false
  (source "iff_unknown.sv" #"
                module Top;
                  logic en;
                  bit clk;
                  int n;
                  initial forever begin @(posedge clk iff en); n++; end
                  initial begin
                    #1 clk = 1;
                    #1 clk = 0;
                    #1 en = 1'bz;
                    #1 clk = 1;
                    #1 clk = 0;
                    #1 en = 1;
                    #1 clk = 1;
                    #1 $display("n=%0d", n);
                    $finish;
                  end
                endmodule
            "#)
  (top Top)
  (four_state)
  (run_to_finish)
  (expect_output "n=1\n"))

; A plain always with an `iff` event runs as a process.
(case plain_always_iff_events_run_as_processes
  (source "iff_always.sv" #"
                module Top;
                  bit clk, en;
                  int q;
                  always @(posedge clk iff en) q <= q + 1;
                  initial begin
                    #1 clk = 1;
                    #1 clk = 0; en = 1;
                    #1 clk = 1;
                    #1 clk = 0;
                    #1 clk = 1;
                    #1 clk = 0; en = 0;
                    #1 clk = 1;
                    #1 $display("q=%0d", q);
                    $finish;
                  end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "q=2\n"))

; The condition is judged when the clock rises, before the edge process
; that the same edge triggers writes it.
(case iff_conditions_are_judged_before_edge_processes_run
  (source "iff_edge.sv" #"
                module Top;
                  bit clk, g;
                  int n;
                  always @(posedge clk) g = ~g;
                  initial forever begin @(posedge clk iff g); n++; end
                  initial begin
                    repeat (4) begin #1 clk = 1; #1 clk = 0; end
                    #1 $display("n=%0d g=%0d", n, g);
                    $finish;
                  end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "n=2 g=0\n"))

; With a variable condition, the occurrence is judged as the process
; writes the signal: `clk = 1; en = 0;` is an event, `en = 0; clk = 1;`
; is none (IEEE 1800-2023 9.4.2.3).
(case iff_conditions_are_judged_at_the_write
  (source "iff_write.sv" #"
                module Top;
                  bit clk, en;
                  int n;
                  initial forever begin @(posedge clk iff en); n++; end
                  initial begin
                    #1 en = 1;
                    #1 clk = 1; en = 0;
                    #1 clk = 0;
                    #1 en = 1;
                    #1 en = 0; clk = 1;
                    #1 clk = 0; en = 1;
                    #1 $display("n=%0d", n);
                    $finish;
                  end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "n=1\n"))

; Nonblocking updates apply in issue order (10.4.2): an update of the
; condition issued before the clock's is seen at the edge, one issued after
; it is not.
(case iff_conditions_follow_nonblocking_update_order
  (source "iff_nba.sv" #"
                module Top;
                  bit clk, en;
                  int n;
                  initial forever begin @(posedge clk iff en); n++; end
                  initial begin
                    #1 en <= 1; clk <= 1;
                    #1 clk <= 0;
                    #1 en <= 0; clk <= 1;
                    #1 clk <= 0; en <= 1;
                    #1 clk <= 1; en <= 0;
                    #1 $display("n=%0d", n);
                    $finish;
                  end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "n=2\n"))

; A pulse of a counted variable while the condition is false is consumed:
; the condition turning true later wakes no process (IEEE 1800-2023
; 9.4.2.3), with a condition judged after settling and with one judged at
; the write.
(case iff_conditions_consume_occurrences_while_false
  (source "iff_consumed.sv" #"
                module Top;
                  bit y, z, en, m = 1;
                  int n, k;
                  initial forever begin @(posedge y iff (en & m)); n++; end
                  initial forever begin @(posedge z iff en); k++; end
                  initial begin
                    #1 y = 1; y = 0; z = 1; z = 0;
                    #1 en = 1;
                    #1 $display("n=%0d k=%0d", n, k);
                    $finish;
                  end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "n=0 k=0\n"))

; A combinational process writes in procedural order: `en` is 1 when it
; writes `clk`, so the edge is an event although the process leaves `en`
; at 0 (IEEE 1800-2023 9.4.2.3).
(case iff_conditions_follow_combinational_process_order
  (source "iff_comb_order.sv" #"
                module Top;
                  bit a, clk, en;
                  int n;
                  always_comb begin en = a; clk = a; en = 0; end
                  initial forever begin @(posedge clk iff en); n++; end
                  initial begin
                    #1 a = 1;
                    #1 $display("n=%0d", n);
                    $finish;
                  end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "n=1\n"))
