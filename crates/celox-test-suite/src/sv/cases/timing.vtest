  (source "time_port_functions.sv" #"
    module Child(input logic [63:0] x, output logic [63:0] y);
      assign y = x;
    endmodule
    module Top(input logic [63:0] a, output logic [63:0] t, s);
      function automatic logic [63:0] leaf(); return $time; endfunction
      function automatic logic [63:0] now(input logic [63:0] bias); return leaf() + bias; endfunction
      function automatic logic [63:0] with_default(input logic [63:0] stamp = $stime);
        return stamp;
      endfunction
      Child time_child(.x(now(a)), .y(t));
      Child stime_child(.x(with_default() + a), .y(s));
    endmodule
  "#)
  (top Top)
  (run_until 0)
  (modify (set a 1))
  (run_until 0)
  (assert_eq t 1)
  (assert_eq s 1)
  (run_until 3)
  (modify (set a 4))
  (run_until 3)
  (assert_eq t 7)
  (assert_eq s 7)
  (run_until 4294967299)
  (modify (set a 5))
  (run_until 4294967299)
  (assert_eq t 4294967304)
  (assert_eq s 8))

(case timed_task_automatic_calls_keep_separate_storage
  (source "automatic_tasks.sv" #"
    module Top(output int a, b);
      task automatic pulse(input int delay, input logic [31:0] value, output int result);
        logic [31:0] saved = value + 1;
        int words[2];
        words[0] = value;
        words[1] = saved;
        #delay;
        result = words[1] + words[0] - value;
      endtask
      initial begin a = 0; pulse(5, 10, a); end
      initial begin b = 0; #1; pulse(2, 20, b); end
    endmodule
  "#)
  (top Top)
  (run_until 2) (assert_eq a 0) (assert_eq b 0)
  (run_until 3) (assert_eq a 0) (assert_eq b 21)
  (run_until 5) (assert_eq a 11) (assert_eq b 21))

(case timed_task_nested_copyback_wait_and_return
  (source "nested_tasks.sv" #"
    module Top(output int value, result);
      bit clk = 0;
      bit ready = 0;
      always #2 clk = ~clk;
      initial #3 ready = 1;
      task automatic leaf(inout int v, output int r);
        int saved = v;
        wait (ready);
        @(posedge clk);
        #1;
        v = saved + 1;
        r = saved + 2;
        return;
        r = 99;
      endtask
      task automatic outer(inout int v, output int r);
        leaf(v, r);
        #1;
      endtask
      initial begin value = 7; result = 0; outer(value, result); end
    endmodule
  "#)
  (top Top)
  (run_until 6) (assert_eq value 7) (assert_eq result 0)
  (run_until 7) (assert_eq value 7) (assert_eq result 0)
  (run_until 8) (assert_eq value 8) (assert_eq result 9))

