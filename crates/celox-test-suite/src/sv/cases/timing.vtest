(group timing (category sequential))

; Procedural timing controls: `#delay`, `@(event)` and `wait (condition)` in
; `initial` blocks and `always` processes. The script advances time with
; `run_until` and `run_to_finish`; the design generates its own clocks.

(case delays_resume_initial_blocks_at_later_times
  (source "delays.sv" #"
                module Top(output logic [7:0] a);
                    parameter int GAP = 4;
                    logic [7:0] pause = 8'd3;
                    initial begin
                        a = 8'd1;
                        #10 a = 8'd2;
                        #GAP a = 8'd3;
                        #(pause) a = 8'd4;
                        #0 a = 8'd5;
                        #pause;
                        $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_until 0)
  (assert_eq a 1)
  (run_until 10)
  (assert_eq a 2)
  (run_until 14)
  (assert_eq a 3)
  (run_until 17)
  (assert_eq a 5 "the zero delay resumes at the same time")
  (run_to_finish)
  (assert_eq a 5))

(case always_with_a_delay_generates_a_clock
  (source "clock.sv" #"
                module Top(output logic [7:0] count, output logic clk);
                    initial clk = 1'b0;
                    initial count = 8'd0;
                    always #5 clk = ~clk;
                    always_ff @(posedge clk) count <= count + 8'd1;
                endmodule
            "#)
  (top Top)
  (run_until 4)
  (assert_eq clk 0)
  (assert_eq count 0)
  ; Rising edges at 5, 15, ..., 95.
  (run_until 100)
  (assert_eq count 10)
  (assert_eq clk 0))

(case edge_waits_resume_before_the_registers_of_that_edge_update
  (source "edges.sv" #"
                module Top(output logic [7:0] q);
                    logic clk = 1'b0;
                    logic [7:0] d = 8'd0;
                    initial q = 8'd0;
                    always #5 clk = ~clk;
                    always_ff @(posedge clk) q <= d;
                    initial begin
                        d = 8'd1;
                        @(posedge clk);
                        $display("first q=%0d", q);
                        #1 d = 8'd2;
                        @(posedge clk);
                        $display("second q=%0d", q);
                        @(negedge clk);
                        $display("negedge q=%0d", q);
                        repeat (2) @(posedge clk);
                        $display("repeat q=%0d", q);
                        $finish;
                    end
                endmodule
            "#)
  (top Top)
  ; A process woken by an edge runs in the active region, before the
  ; nonblocking updates of that edge (IEEE 1800-2023 4.4).
  (run_to_finish)
  (expect_output "first q=0\nsecond q=1\nnegedge q=2\nrepeat q=2\n")
  (assert_eq q 2))

(case any_change_waits_wake_on_every_value_change
  (source "changes.sv" #"
                module Top(output logic [7:0] data, output logic flag);
                    logic [7:0] other = 8'd0;
                    initial begin
                        data = 8'd0;
                        flag = 1'b0;
                        #3 data = 8'd7;
                        #4 data = 8'd7;
                        #1 data = 8'd9;
                        #2 other = 8'd1;
                        #2 flag = 1'b1;
                        #1 $finish;
                    end
                    initial forever begin
                        @(data);
                        $display("data=%0d", data);
                    end
                    initial forever begin
                        @(other or flag);
                        $display("other=%0d flag=%0d", other, flag);
                    end
                    initial forever begin
                        @(flag, data);
                        $display("either");
                    end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "data=7\neither\ndata=9\neither\nother=1 flag=0\nother=1 flag=1\neither\n"))

(case wait_statements_block_until_their_condition_holds
  (source "wait.sv" #"
                module Top(output logic [7:0] y);
                    logic go = 1'b0;
                    logic [7:0] level = 8'd0;
                    initial begin
                        y = 8'd0;
                        #7 go = 1'b1;
                        #5 level = 8'd3;
                        #5 level = 8'd5;
                    end
                    initial begin
                        wait (go) $display("go");
                        wait (go);
                        $display("still go");
                        wait (level > 8'd4) y = level;
                        $display("level=%0d", level);
                        #1 $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_until 6)
  (expect_output "")
  (run_until 7)
  (expect_output "go\nstill go\n")
  (run_to_finish)
  (expect_output "level=5\n")
  (assert_eq y 5))

(case level_sensitive_always_runs_as_a_process
  (source "level.sv" #"
                module Top(output logic [7:0] y);
                    logic [7:0] a = 8'd0;
                    logic [7:0] b = 8'd0;
                    initial y = 8'd0;
                    always @(a or b) y = a + b;
                    initial begin
                        #2 a = 8'd3;
                        #2 b = 8'd4;
                        #2 a = 8'd5;
                        #2 $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_until 1)
  (assert_eq y 0)
  (run_until 3)
  (assert_eq y 3)
  (run_until 5)
  (assert_eq y 7)
  (run_to_finish)
  (assert_eq y 9))

(case processes_wake_each_other_at_the_same_time
  (source "handshake.sv" #"
                module Top(output logic [7:0] y);
                    logic start = 1'b0;
                    logic done = 1'b0;
                    initial begin
                        y = 8'd0;
                        #3 start = 1'b1;
                        @(posedge done);
                        $display("done at y=%0d", y);
                        $finish;
                    end
                    initial begin
                        @(posedge start);
                        y = 8'd1;
                        #0 y = 8'd2;
                        done = 1'b1;
                    end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "done at y=2\n"))

(case tasks_with_timing_controls_run_in_processes
  (source "tasks.sv" #"
                module Top(output logic [7:0] y);
                    logic clk = 1'b0;
                    always #5 clk = ~clk;
                    task automatic pulse(input logic [7:0] value, input int cycles);
                        y = value;
                        repeat (cycles) @(posedge clk);
                        #1 y = 8'd0;
                    endtask
                    initial begin
                        y = 8'd0;
                        pulse(8'd7, 2);
                        $display("y=%0d", y);
                        pulse(8'd9, 1);
                        $display("y=%0d", y);
                        $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_until 10)
  (assert_eq y 7)
  ; The first pulse ends at 16, when the second one starts.
  (run_until 16)
  (assert_eq y 9)
  (expect_output "y=0\n")
  (run_until 25)
  (assert_eq y 9)
  (run_to_finish)
  (expect_output "y=0\n")
  (assert_eq y 0))

(case edge_waits_see_the_signals_the_script_drives
  (source "driven.sv" #"
                module Top(input logic a, output logic [7:0] seen);
                    initial begin
                        seen = 8'd0;
                        forever begin
                            @(posedge a);
                            seen = seen + 8'd1;
                        end
                    end
                endmodule
            "#)
  (top Top)
  (modify (set a 0))
  (run_until 1)
  (for value (list 1 0 1 1 0)
    (modify (set a value))
    (run_until 2))
  (assert_eq seen 2)
  (modify (set a 1))
  (run_until 3)
  (assert_eq seen 3))

(case finish_in_an_always_process_ends_the_simulation
  (source "finish.sv" #"
                module Top(output logic [7:0] ticks);
                    initial ticks = 8'd0;
                    always begin
                        #3 ticks = ticks + 8'd1;
                        if (ticks == 8'd4) $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_until 7)
  (assert_eq ticks 2)
  (run_to_finish)
  (assert_eq ticks 4))

(case waiting_processes_do_not_keep_an_idle_simulation_running
  (source "idle.sv" #"
                module Top(output logic [7:0] y);
                    logic never = 1'b0;
                    initial begin
                        y = 8'd1;
                        @(posedge never);
                        y = 8'd2;
                    end
                    initial #5 y = 8'd3;
                endmodule
            "#)
  (top Top)
  (run_until 5)
  (assert_eq y 3)
  (run_until 100)
  (assert_eq y 3))

(case four_state_edges_count_transitions_through_unknown
  (source "four_state_edges.sv" #"
                module Top(input logic host_clk, output logic [7:0] host_count, output logic [7:0] pos, output logic [7:0] neg, output logic [7:0] any);
                    always_ff @(posedge host_clk) host_count <= host_count + 1;
                    logic s = 1'b0;
                    initial begin
                        host_count = 8'd0;
                        pos = 8'd0;
                        neg = 8'd0;
                        any = 8'd0;
                        #1 s = 1'bx; // 0 -> x: posedge
                        #1 s = 1'b1; // x -> 1: posedge
                        #1 s = 1'bz; // 1 -> z: negedge
                        #1 s = 1'bx; // z -> x: no edge, a change
                        #1 s = 1'b0; // x -> 0: negedge
                        #1 s = 1'b1; // 0 -> 1: posedge
                        #1 s = 1'b0; // 1 -> 0: negedge
                        #1 $finish;
                    end
                    initial forever begin
                        @(posedge s);
                        pos = pos + 8'd1;
                    end
                    initial forever begin
                        @(negedge s);
                        neg = neg + 8'd1;
                    end
                    initial forever begin
                        @(s);
                        any = any + 8'd1;
                    end
                endmodule
            "#)
  (top Top)
  (four_state)
  (set host_clk 0)
  (run_until 0)
  (set host_clk 1'bz)(eval)(assert_eq host_count 1)
  (set host_clk 1'bx)(eval)(assert_eq host_count 1)
  (set host_clk 1)(eval)(assert_eq host_count 2)
  (set host_clk 0)(eval)
  (set host_clk 1'bz)(eval)(assert_eq host_count 3)
  (run_to_finish)
  (assert_eq pos 3)
  (assert_eq neg 3)
  (assert_eq any 7))

(case unknown_delays_and_conditions_count_as_zero_and_false
  (source "unknown.sv" #"
                module Top(output logic [7:0] y);
                    logic [7:0] amount = 8'bx;
                    logic flag = 1'bx;
                    initial begin
                        y = 8'd1;
                        #amount y = 8'd2;
                        wait (flag) y = 8'd3;
                        $finish;
                    end
                    initial #4 flag = 1'b1;
                endmodule
            "#)
  (top Top)
  (four_state)
  (run_until 0)
  (assert_eq y 2)
  (run_to_finish)
  (assert_eq y 3))

(case host_inputs_are_staged_before_time_zero_initial_blocks
  (source "setup.sv" #"module Top(input bit a, output bit y); initial y = a; endmodule"#)
  (top Top)
  (set a 1)
  (run_until 0)
  (assert_eq y 1))

(case eval_starts_due_time_zero_processes
  (source "eval.sv" #"module Top(output bit [7:0] y); initial y = 7; endmodule"#)
  (top Top)
  (eval)
  (assert_eq y 7)
  (run_until 0))

(case direct_reads_settle_waiting_processes
  (source "read.sv" #"module Top(input bit go, output bit [7:0] seen);
    initial begin wait (go); seen = 1; #0; seen = 2; end
  endmodule"#)
  (top Top)
  (run_until 0)
  (set go 1)
  (assert_eq seen 2))

(case output_reads_settle_waiting_processes
  (source "output.sv" #"module Top(input bit go);
    initial begin wait (go); $display("woke"); end
  endmodule"#)
  (top Top)
  (run_until 0)
  (set go 1)
  (expect_output "woke\n"))

(case run_until_drains_target_time_before_later_writes
  (source "boundary.sv" #"module Top(input bit [7:0] a, output bit [7:0] y);
    initial #10 y = a;
  endmodule"#)
  (top Top)
  (set a 1)
  (run_until 10)
  (set a 2)
  (assert_eq y 1))

(case repeated_settles_do_not_advance_design_time
  (source "settles.sv" #"module Top(output bit seen); initial #1 seen = 1; endmodule"#)
  (top Top)
  (run_until 0)
  (for i (range 0 1001) (eval))
  (assert_eq seen 0)
  (run_until 1)
  (assert_eq seen 1))

(case run_to_finish_has_no_simulated_time_deadline
  (source "late.sv" #"module Top(output bit done);
    initial begin #1000001; done = 1; $finish; end
  endmodule"#)
  (top Top)
  (run_to_finish)
  (assert_eq done 1))

(case plain_always_processes_start_after_host_inputs
  (source "always.sv" #"module Top(input bit a, output bit y); always begin y=a; #1; end endmodule"#)
  (top Top)
  (set a 1)
  (run_until 0)
  (assert_eq y 1))

(case timed_control_names_do_not_collide_with_design_names
  (source "names.sv" #"package celox_suite_timed_control; localparam int N=1; endpackage
    module Top(output bit done);
      function void celox_suite_finish_design(); done=0; endfunction
      initial begin #1; done=1; $finish; end
    endmodule"#)
  (top Top)
  (run_to_finish)
  (assert_eq done 1))

(case event_always_processes_start_after_host_inputs
  (source "event_start.sv" #"module Top(input bit a, output bit y);
    bit seen=0;
    always @(a) seen=1;
    initial y=seen;
  endmodule"#)
  (top Top)
  (set a 1)
  (run_until 0)
  (assert_eq y 0))

(case ff_actions_wait_for_staged_startup
  (source "ff_start.sv" #"module Top(input bit clk, output bit y, output bit seen);
    always_ff @(posedge clk) seen<=1;
    initial y=seen;
  endmodule"#)
  (top Top)
  (set clk 1)
  (run_until 0)
  (assert_eq y 0)
  (assert_eq seen 1))

(case ff_startup_does_not_invent_an_unstaged_edge
  (source "ff_idle.sv" #"module Top(input bit clk, output bit seen);
    always_ff @(posedge clk) begin if (clk) seen<=1; end
  endmodule"#)
  (top Top)
  (set clk 0)
  (run_until 0)
  (assert_eq seen 0)
  (set clk 1)
  (run_until 0)
  (assert_eq seen 1))

(case ff_startup_preserves_nested_if_case_actions
  (source "ff_nested.sv" #"module Top(input bit clk, en, output bit [7:0] seen, output bit flag, y);
    always_ff @(posedge clk) if (en) begin : update
      seen<=seen+1;
      case(en) 1: flag<=1; default: flag<=0; endcase
    end else begin seen<=0; flag<=0; end
    initial y=flag;
  endmodule"#)
  (top Top)
  (set en 1)
  (set clk 1)
  (run_until 0)
  (assert_eq y 0)
  (assert_eq seen 1)
  (assert_eq flag 1)
  (set en 0)
  (set clk 0)
  (eval)
  (set clk 1)
  (run_until 0)
  (assert_eq seen 0)
  (assert_eq flag 0))

(case qualified_ff_startup_actions
  (source "qualified.sv" #"module Top(input bit clk, en, output bit q, y);
    always_ff @(posedge clk) priority case(en) 1: q<=1; default: q<=0; endcase
    initial y=q;
  endmodule"#)
  (top Top) (set en 1) (set clk 1) (run_until 0)
  (assert_eq y 0) (assert_eq q 1))

(case ordinary_edge_always_retains_staged_startup_edges
  (source "ordinary.sv" #"module Top(input bit clk, output bit q, y);
    always @(posedge clk) q<=1;
    initial y=q;
  endmodule"#)
  (top Top) (set clk 1) (run_until 0)
  (assert_eq y 0) (assert_eq q 1))

(case macro_ff_startup_actions
  (source "macro.sv" #"`define FF always_ff @(posedge clk) q<=1;
    module Top(input bit clk, output bit q, y);
    `FF
    initial y=q;
    endmodule"#)
  (top Top) (set clk 1) (run_until 0)
  (assert_eq y 0) (assert_eq q 1))

(case macro_argument_process_keywords_are_expanded_before_staging
  (source "macro_arg.sv" #"`define FF(kind) kind @(posedge clk) q <= d;
    module Top(input bit clk, d, output bit q, seen);
      `FF(always_ff)
      initial seen=q;
    endmodule"#)
  (top Top)
  (set d 1) (set clk 1) (run_until 0)
  (assert_eq seen 0) (assert_eq q 1))

(case do_while_ff_bodies_are_staged_in_full
  (source "do_while.sv" #"module Top(input bit clk, d, output bit q, seen);
      always_ff @(posedge clk) do q <= d; while (0);
      initial seen=q;
    endmodule"#)
  (top Top)
  (set d 1) (set clk 1) (run_until 0)
  (assert_eq seen 0) (assert_eq q 1))

(case wildcard_always_blocks_settle_staged_inputs
  (source "wildcard.sv" #"module Top(input bit a, output bit y, z);
      always @(*) y=a;
      always @* z=a;
      initial #1;
    endmodule"#)
  (top Top)
  (set a 1) (run_until 0) (assert_eq y 1) (assert_eq z 1))

(case timed_edge_always_bodies_do_not_replay_setup_edges
  (source "delayed.sv" #"module Top(input bit clk, output bit q);
      always @(posedge clk) #1 q=1;
    endmodule"#)
  (top Top)
  (set clk 1) (run_until 1) (assert_eq q 0)
  (set clk 0) (eval) (set clk 1) (run_until 2) (assert_eq q 1))

(case timed_edge_always_task_calls_do_not_replay_setup_edges
  (source "task.sv" #"module Top(input bit clk, output bit q);
      task tick; #1 q=1; endtask
      task relay; tick(); endtask
      always @(posedge clk) relay();
    endmodule"#)
  (top Top)
  (set clk 1) (run_until 1) (assert_eq q 0)
  (set clk 0) (eval) (set clk 1) (run_until 2) (assert_eq q 1))

(case imported_timed_tasks_do_not_replay_setup_edges
  (source "delays.sv" #"package delays;
      task automatic tick(output bit value); #1 value=1; endtask
    endpackage"#)
  (source "imported.sv" #"module Top(input bit clk, output bit q);
      import delays::*;
      always @(posedge clk) tick(q);
    endmodule"#)
  (top Top)
  (set clk 1) (run_until 1) (assert_eq q 0)
  (set clk 0) (eval) (set clk 1) (run_until 2) (assert_eq q 1))

(case untimed_local_tasks_shadow_timed_tasks_in_other_scopes
  (source "slow.sv" #"package slow;
      task automatic tick(output bit value); #1 value=1; endtask
    endpackage"#)
  (source "local.sv" #"module Top(input bit clk, output bit q, seen);
      task tick; q<=1; endtask
      always @(posedge clk) tick();
      initial seen=q;
    endmodule"#)
  (top Top)
  (set clk 1) (run_until 0) (assert_eq seen 0) (assert_eq q 1))

(case automatic_module_ff_staging_keeps_its_state
  (source "automatic.sv" #"module automatic Top(input bit clk, output bit q, seen);
      always_ff @(posedge clk) q<=1;
      initial seen=q;
    endmodule"#)
  (top Top)
  (set clk 1) (run_until 0) (assert_eq seen 0) (assert_eq q 1)
  (set clk 0) (eval) (set clk 1) (run_until 1) (assert_eq q 1))

(case control_members_do_not_pollute_user_package_imports
  (source "user.sv" #"package user_values; localparam bit started=1; localparam bit finished=1; endpackage"#)
  (source "top.sv" #"module Top(output bit q); import user_values::*;
      initial begin q=started & finished; #1; $finish; end
    endmodule"#)
  (top Top)
  (run_until 0) (assert_eq q 1) (run_to_finish))

(case blocking_ff_stores_are_visible_before_inactive_work
  (source "blocking.sv" #"module Top(output bit [7:0] q, observed, derived_seen);
      bit clk; wire [7:0] derived=q+1;
      always @(posedge clk) q=1;
      initial #1 clk=1;
      initial begin @(posedge clk); #0; observed=q; derived_seen=derived; q=9; end
    endmodule"#)
  (top Top) (run_until 1) (assert_eq observed 1) (assert_eq derived_seen 2) (assert_eq q 9))

(case nonblocking_ff_stores_remain_pending_during_inactive_work
  (source "nonblocking.sv" #"module Top(output bit [7:0] q, observed, derived_seen);
      bit clk; wire [7:0] derived=q+1;
      always @(posedge clk) q<=1;
      initial #1 clk=1;
      initial begin @(posedge clk); #0; observed=q; derived_seen=derived; q=9; end
    endmodule"#)
  (top Top) (run_until 1) (assert_eq observed 0) (assert_eq derived_seen 1) (assert_eq q 1))

(case mixed_ff_stores_keep_their_active_and_nba_values
  (source "mixed.sv" #"module Top(output bit [7:0] q, observed, derived_seen);
      bit clk; wire [7:0] derived=q+1;
      always @(posedge clk) begin q<=7; q=2; end
      initial #1 clk=1;
      initial begin @(posedge clk); #0; observed=q; derived_seen=derived; q=9; end
    endmodule"#)
  (top Top) (run_until 1) (assert_eq observed 2) (assert_eq derived_seen 3) (assert_eq q 7))

(case single_item_generate_ff_rewrites_keep_their_else
  (source "generate_ff.sv" #"module Top(input bit clk, output bit [1:0] q, seen);
      if (0) always_ff @(posedge clk) q<=1;
      else always_ff @(posedge clk) q<=2;
      initial seen=q;
    endmodule"#)
  (top Top) (set clk 1) (run_until 0) (assert_eq seen 0) (assert_eq q 2))

(case immediate_assertion_ff_keeps_both_actions
  (source "assert_ff.sv" #"module Top(input bit clk, en, output bit q);
      always_ff @(posedge clk) assert (en) q<=1; else q<=0;
    endmodule"#)
  (top Top) (set en 0) (set clk 1) (run_until 0) (assert_eq q 0)
  (set clk 0) (eval) (set en 1) (set clk 1) (run_until 1) (assert_eq q 1))

(case printed_finish_notice_is_design_output
  (source "printed.sv" #"module Top;
      initial begin $display("source_0.sv:17: $finish called at 0 (1ps)"); #1; $finish; end
    endmodule"#)
  (top Top) (run_until 0) (expect_output "source_0.sv:17: $finish called at 0 (1ps)\n") (run_to_finish))

(case combinational_finish_ends_timed_execution
  (source "comb_finish.sv" #"module Top(output bit done);
      initial begin #1; done=1; end
      always_comb if(done) $finish;
    endmodule"#)
  (top Top) (run_to_finish) (assert_eq done 1))

(case local_function_shadows_unrelated_timed_task
 (source "function.sv" #"package UnrelatedTasks; task tick; #1; endtask endpackage
 module Top(input bit clk,output bit q,seen);
   function bit tick(); return 1; endfunction
   always @(posedge clk) q<=tick(); initial seen=q;
 endmodule"#)
 (top Top) (set clk 1) (run_until 0) (assert_eq seen 0) (assert_eq q 1))

(case explicit_timed_import_overrides_earlier_wildcard
 (source "imports.sv" #"package A; task tick; endtask endpackage
 package B; task tick; #1; endtask endpackage
 module Top(input bit clk,output bit q); import A::*; import B::tick;
   always @(posedge clk) begin tick(); q=1; end
 endmodule"#)
 (top Top) (set clk 1) (run_until 0) (assert_eq q 0)
 (set clk 0) (eval) (set clk 1) (run_until 2) (assert_eq q 1))

(case else_prefixed_instance_is_not_an_else_action
 (source "elsewhere.sv" #"module elsewhere; endmodule
 module Top(input bit clk,en,output bit q);
   always_ff @(posedge clk) if(en) q<=1;
   elsewhere u();
 endmodule"#)
 (top Top) (set en 1) (set clk 1) (run_until 0) (assert_eq q 1))

(case nested_imports_do_not_leak_into_module_edge_processes
 (source "imports.sv" #"package A;
   task automatic tick(output bit value); value=1; endtask
 endpackage
 package B;
   task automatic tick(output bit value); #1 value=1; endtask
 endpackage
 module Top(input bit clk,output bit q);
   import A::tick;
   if(1) begin : nested import B::tick; end
   always @(posedge clk) tick(q);
 endmodule"#)
 (top Top) (set clk 1) (run_until 0) (assert_eq q 1))

(case single_item_case_generate_ff_is_staged_together
 (source "case.sv" #"module Top(input bit clk,output bit q,seen);
 localparam MODE=0;
 case(MODE) 0:always_ff @(posedge clk)q<=1;default:always_ff @(posedge clk)q<=0;endcase
 initial seen=q;
 endmodule"#)
 (top Top)(set clk 1)(run_until 0)(assert_eq seen 0)(assert_eq q 1))

(case timed_expansion_preserves_adapter_macros
 (source "macros.sv" #"module Top(output bit q);
 `ifdef CELOX_SUITE_ICARUS
 initial begin q=1;#1;$finish;end
 `else
 initial begin q=1;#1;$finish;end
 `endif
 endmodule"#)
 (top Top)(run_to_finish)(assert_eq q 1))

(case multiple_import_items_preserve_untimed_edges
 (source "imports.sv" #"package A; task other; #1; endtask endpackage
 package B; int result; task tick; result=1; endtask endpackage
 module Top(input bit clk,output int q); import A::other, B::tick;
 always @(posedge clk) tick(); assign q=B::result; endmodule"#)
 (top Top)(set clk 1)(run_until 0)(assert_eq q 1))
(case escaped_timed_tasks_do_not_replay_setup_edges
 (source "escaped.sv" #"module Top(input bit clk,output bit q);
 task \pause.task ; #1 q=1; endtask
 always @(posedge clk) \pause.task ; endmodule"#)
 (top Top)(set clk 1)(run_until 1)(assert_eq q 0)
 (set clk 0)(eval)(set clk 1)(run_until 2)(assert_eq q 1))
(case control_names_do_not_rewrite_the_dut_type
 (source "collision.sv" #"module celox_suite_timed_control(output bit q);initial q=1;endmodule"#)
 (top celox_suite_timed_control)(run_until 0)(assert_eq q 1))

(case attributes_preserve_single_generate_arms
 (source "attributes.sv" #"module Top(input bit clk,output bit q,r);
 if(0) always_ff @(posedge clk)q<=0;
 else (* keep *) always_ff @(posedge clk)q<=1;
 case(0)
 0: (* keep *) always_ff @(posedge clk)r<=1;
 default: (* keep *) always_ff @(posedge clk)r<=0;
 endcase endmodule"#)
 (top Top)(set clk 1)(run_until 0)(assert_eq q 1)(assert_eq r 1))
(case adapter_defines_preserve_line_macros
 (source "line.sv" #"module Top(output int q);
initial q=`__LINE__;
endmodule"#)
 (top Top)(run_until 0)(assert_eq q 2))
(case callable_timing_keeps_generate_scope
 (source "scopes.sv" #"module Top(input bit clk,output bit q,r);
 if(1) begin:untimed task tick;q=1;endtask always @(posedge clk)tick();end
 if(1) begin:timed task tick;#1 r=1;endtask always @(posedge clk)tick();end
 endmodule"#)
 (top Top)(set clk 1)(run_until 1)(assert_eq q 1)(assert_eq r 0)
 (set clk 0)(eval)(set clk 1)(run_until 2)(assert_eq r 1))

(case timed_file_macros_keep_each_source_path
 (source "first.sv" #"module Leaf;initial $display("%s",`__FILE__);endmodule"#)
 (source "second.sv" #"module Top;Leaf u();initial #1 $display("%s",`__FILE__);endmodule"#)
 (top Top)(run_until 1)(expect_output "first.sv\nsecond.sv\n"))
(case escaped_identifiers_do_not_collide_with_control_names
 (source "escaped-control.sv" #"package \celox_suite_timed_control ;parameter bit Q=1;endpackage
 module Top(output bit q);initial q=\celox_suite_timed_control ::Q;endmodule"#)
 (top Top)(run_until 0)(assert_eq q 1))

(case single_item_generate_imports_do_not_leak
 (source "imports.sv" #"package A; task automatic tick(output bit value); value=1; endtask endpackage
 package B; task automatic tick(output bit value); #1 value=1; endtask endpackage
 module Top(input bit clk,output bit q);
   import A::tick;
   if(1) import B::tick;
   always @(posedge clk) tick(q);
 endmodule"#)
 (top Top)(set clk 1)(run_until 0)(assert_eq q 1))

(case exported_untimed_tasks_keep_setup_edges
 (source "exports.sv" #"package A; task automatic tick(output bit value); value=1; endtask endpackage
 package B; import A::tick; export A::*; endpackage
 package C; import B::tick; export *::*; endpackage
 module Top(input bit clk,output bit q);
   import C::*;
   always @(posedge clk) tick(q);
 endmodule"#)
 (top Top)(set clk 1)(run_until 0)(assert_eq q 1))

(case qualified_unit_tasks_keep_setup_edges
 (source "unit.sv" #"task automatic tick(output bit value); value=1; endtask
 module Top(input bit clk,output bit q);
   always @(posedge clk) $unit::tick(q);
 endmodule"#)
 (top Top)(set clk 1)(run_until 0)(assert_eq q 1))

(case function_return_bounds_do_not_shadow_local_calls
 (source "bounds.sv" #"module Other; task tick(); #1; endtask endmodule
 module Top(input bit clk,output bit q); parameter N=2;
 function logic [$clog2(N)-1:0] tick(); return 1; endfunction
 always @(posedge clk) q<=tick(); endmodule"#)
 (top Top)(set clk 1)(run_until 0)(assert_eq q 1))

(case control_shaped_display_is_design_output
 (source "printed.sv" #"module Top;
 initial begin $display("timed_control.sv:3: $finish called at 5 (1ns)");
 $display("- timed_control.sv:3: Verilog $finish"); #5; $finish; end endmodule"#)
 (top Top)(run_to_finish)
 (expect_output "timed_control.sv:3: $finish called at 5 (1ns)\n- timed_control.sv:3: Verilog $finish\n"))

(case staged_ff_edge_can_finish_without_scheduled_work
 (source "host-finish.sv" #"module Top(input bit clk);always @(posedge clk)$finish;endmodule"#)
 (top Top)(set clk 1)(run_to_finish))

(case coalesced_setup_writes_do_not_invent_ff_edges
 (source "setup-pulse.sv" #"module Top(input bit clk,rst,output bit [7:0] q,r);
 always @(posedge clk) q<=q+1;always @(negedge rst)r<=r+1;endmodule"#)
 (top Top)(set clk 1)(set clk 0)(set rst 1)(set rst 0)
 (run_until 0)(assert_eq q 0)(assert_eq r 0))

(case computed_edge_always_processes_arm_after_setup
 (source "computed-always.sv" #"module Top(input bit a,b,output bit[7:0]seen);
 always @(posedge (a|b))seen=seen+1;endmodule"#)
 (top Top)(set a 1)(run_until 0)(assert_eq seen 0)
 (set a 0)(eval)(set a 1)(eval)(assert_eq seen 1))

(case non_ff_multiple_edge_always_processes_arm_after_setup
 (source "multi-always.sv" #"module Top(input bit a,b,output bit[7:0]seen);
 always @(posedge a or negedge b)seen=seen+1;endmodule"#)
 (top Top)(set a 1)(run_until 0)(assert_eq seen 0)
 (set a 0)(eval)(set a 1)(eval)(assert_eq seen 1)
 (set b 1)(eval)(set b 0)(eval)(assert_eq seen 2))

(case timed_calls_after_forever_do_not_replay_setup_edges
 (source "forever-task.sv" #"module Top(input bit clk,output bit q);
 task automatic tick();#1 q=1;endtask
 always @(posedge clk)forever tick;
 initial begin #3;$finish;end endmodule"#)
 (top Top)(set clk 1)(run_to_finish)(assert_eq q 0))

(case parenthesized_ff_event_leaves_preserve_setup_edges
 (source "parenthesized.sv" #"module Top(input bit clk,output bit q,r);
 always @((posedge clk))q<=1;always_ff @((posedge clk))r<=1;endmodule"#)
 (top Top)(set clk 1)(run_until 0)(assert_eq q 1)(assert_eq r 1))

(case named_arguments_do_not_invent_timed_calls
 (source "named-call.sv" #"module Top(input bit clk,output bit q);
 task automatic tick();#1;endtask
 function automatic bit f(input bit tick);return tick;endfunction
 always @(posedge clk)q<=f(.tick(1));endmodule"#)
 (top Top)(set clk 1)(run_until 0)(assert_eq q 1))

(case timed_calls_after_do_do_not_replay_setup_edges
 (source "do-task.sv" #"module Top(input bit clk,output bit q);
 task automatic tick();#1 q=1;endtask
 always @(posedge clk)do tick;while(0);
 initial begin #3;$finish;end endmodule"#)
 (top Top)(set clk 1)(run_to_finish)(assert_eq q 0))

(case timed_calls_after_named_blocks_do_not_replay_setup_edges
 (source "named-block-task.sv" #"module Top(input bit clk,output bit q);
 task automatic tick();#1 q=1;endtask
 always @(posedge clk)begin : work tick;end
 initial begin #3;$finish;end endmodule"#)
 (top Top)(set clk 1)(run_to_finish)(assert_eq q 0))

(case timed_calls_after_endcase_do_not_replay_setup_edges
 (source "endcase-task.sv" #"module Top(input bit clk,sel,output bit q);
 task automatic tick();#1 q=1;endtask
 always @(posedge clk)begin case(sel)0:;default:;endcase tick;end
 initial begin #3;$finish;end endmodule"#)
 (top Top)(set clk 1)(run_to_finish)(assert_eq q 0))

(case inactive_time_directives_do_not_change_scheduler_units
 (source "inactive-scale.sv" #"`ifdef NEVER_DEFINED
 `timescale 10ns/1ps
 `endif
 module Top(output bit q);initial begin #1;q=1;end endmodule"#)
 (top Top)(run_until 1)(assert_eq q 1))

(case comment_semicolons_in_function_headers_preserve_setup_edges
 (source "function-comment.sv" #"module Other;task automatic tick();#1;endtask endmodule
 module Top(input bit clk,output bit q);
 function int /* ; */ tick();return 1;endfunction
 always @(posedge clk)q<=tick();endmodule"#)
 (top Top)(set clk 1)(run_until 0)(assert_eq q 1))

(case import_comment_commas_do_not_change_visible_callables
 (source "import-comment.sv" #"package A;task automatic tick();#1;endtask task automatic other();endtask endpackage
 package B;function automatic bit tick();return 1;endfunction endpackage
 module Top(input bit clk,output bit q);import B::*, A /*,*/ :: other;
 always @(posedge clk)q<=tick();endmodule"#)
 (top Top)(set clk 1)(run_until 0)(assert_eq q 1))

(case escaped_import_commas_keep_explicit_callable_selection
 (source "escaped-import.sv" #"package \A,items ;function automatic bit tick();return 1;endfunction endpackage
 package B;task automatic tick();#1;endtask endpackage
 module Top(input bit clk,output bit q);import \A,items ::tick;
 always @(posedge clk)q<=tick();endmodule"#)
 (top Top)(set clk 1)(run_until 0)(assert_eq q 1))

(case parameterized_interface_methods_keep_setup_edges
 (source "interface-method.sv" #"
 interface Scale #(parameter int K=1);
   function automatic logic [3:0] scaled(input logic [3:0] v);
     return v*K;
   endfunction
 endinterface
 module Top(input bit clk,input logic [3:0] v,output logic [3:0] q);
   Scale #(.K(5)) s();
   always @(posedge clk) q <= s.scaled(v);
 endmodule
 "#)
 (top Top)(set v 2)(set clk 1)(run_until 0)(assert_eq q 10))


(case blocking_concatenation_publishes_one_event_update
  ; IEEE 1800-2023 4.9.3 and 10.4.1: enable events from the LHS update.
  (source "blocking_concat_events.sv" #"
    module Top(output bit [1:0] q, r, output bit seen, ff_seen);
      bit clk;
      bit [1:0] data;
      initial begin data = 3; #2; data = 2; end
      initial begin #1; {q[1], q[0]} = 2'b11; #1; q[0] = 0; end
      initial begin @(posedge (q[1] ^ q[0])); seen = 1; end
      initial begin #1; clk = 1; #1; clk = 0; #1; clk = 1; end
      always @(posedge clk) {r[1], r[0]} = data;
      initial begin @(posedge (r[1] ^ r[0])); ff_seen = 1; end
    endmodule
  "#)
  (top Top)
  (run_until 1)
  (assert_eq q 3)
  (assert_eq r 3)
  (assert_eq seen 0)
  (assert_eq ff_seen 0)
  (run_until 2)
  (assert_eq q 2)
  (assert_eq seen 1)
  (assert_eq ff_seen 0)
  (run_until 3)
  (assert_eq r 2)
  (assert_eq ff_seen 1))

(case finite_active_feedback_preserves_convergence
  (source "finite_feedback.sv" #"
    module Top(output bit [7:0] a, b);
      initial begin #1; a = 1; end
      always @(a) if (a < 4) b = a;
      always @(b) if (b < 4) a = b + 1;
    endmodule
  "#)
  (top Top)
  (run_until 1)
  (assert_eq a 4)
  (assert_eq b 3)
  (run_until 2)
  (assert_eq a 4)
  (assert_eq b 3))

(case interface_modport_methods_keep_setup_edges
 (source "modport-method.sv" #"
 interface Scale #(parameter int K=5);
 logic[3:0] base;
 function automatic logic[3:0] scaled(input logic[3:0] v);return base+v*K;endfunction
 modport user(import scaled);
 endinterface
 module User(Scale.user s,input bit clk,input logic[3:0] v,output logic[3:0] q);
 always @(posedge clk)q<=s.scaled(v);
 endmodule
 module Top(input bit clk,input logic[3:0] v,output logic[3:0] q);
 Scale #(.K(5)) s();
 assign s.base=0;
 User u(.s(s),.clk(clk),.v(v),.q(q));
 endmodule
 "#)
 (top Top)(set v 2)(set clk 1)(run_until 0)(assert_eq q 10))

(case generic_interface_methods_keep_setup_edges
 (source "generic_interface_methods_keep_setup_edges.sv" #"
 interface Scale #(parameter int K=5);
 logic[3:0] base;
 function automatic logic[3:0] scaled(input logic[3:0] v);return base+v*K;endfunction
 modport user(import scaled);
 endinterface
 module User(interface s,input bit clk,input logic[3:0] v,output logic[3:0] q);
 always @(posedge clk)q<=s.scaled(v);
 endmodule
 module Top(input bit clk,input logic[3:0] v,output logic[3:0] q);
 Scale #(.K(5)) s();
 assign s.base=0;
 User u(.s(s),.clk(clk),.v(v),.q(q));
 endmodule
 "#)
 (top Top)(set v 2)(set clk 1)(run_until 0)(assert_eq q 10))

(case inherited_interface_methods_keep_setup_edges
 (source "inherited_interface_methods_keep_setup_edges.sv" #"
 interface Scale #(parameter int K=5);
 logic[3:0] base;
 function automatic logic[3:0] scaled(input logic[3:0] v);return base+v*K;endfunction
 modport user(import scaled);
 endinterface
 module User(Scale.user unused, s,input bit clk,input logic[3:0] v,output logic[3:0] q);
 always @(posedge clk)q<=s.scaled(v);
 endmodule
 module Top(input bit clk,input logic[3:0] v,output logic[3:0] q);
 Scale #(.K(5)) s();
 assign s.base=0;
 User u(.unused(s),.s(s),.clk(clk),.v(v),.q(q));
 endmodule
 "#)
 (top Top)(set v 2)(set clk 1)(run_until 0)(assert_eq q 10))

(case pure_function_rhs_preserves_distinct_write_times
 (source "pure-timed-writes.sv" #"
 module Child(output bit[1:0]q);
 function automatic bit one();return 1;endfunction
 initial begin #1;q[0]=one();end
 initial begin #2;q[1]=one();end
 endmodule
 module Top(output bit[7:0]seen);
 wire[1:0]q;Child u(.q(q));
 initial forever begin @(q[0]^q[1]);seen=seen+1;end
 endmodule
 "#)
 (top Top)(run_until 1)(assert_eq seen 1)(run_until 2)(assert_eq seen 2))
