(group timing (category sequential))

; Procedural timing controls: `#delay`, `@(event)` and `wait (condition)` in
; `initial` blocks and `always` processes. The script advances time with
; `run_until` and `run_to_finish`; the design generates its own clocks.
; Every script begins with one of them, so the design's time-zero initial
; blocks, `always` processes and variable initializers have run before the
; script drives an input: no case depends on host values staged before them.

(case delays_resume_initial_blocks_at_later_times
  (source "delays.sv" #"
                module Top(output logic [7:0] a);
                    parameter int GAP = 4;
                    logic [7:0] pause = 8'd3;
                    initial begin
                        a = 8'd1;
                        #10 a = 8'd2;
                        #GAP a = 8'd3;
                        #(pause) a = 8'd4;
                        #0 a = 8'd5;
                        #pause;
                        $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_until 0)
  (assert_eq a 1)
  (run_until 10)
  (assert_eq a 2)
  (run_until 14)
  (assert_eq a 3)
  (run_until 17)
  (assert_eq a 5 "the zero delay resumes at the same time")
  (run_to_finish)
  (assert_eq a 5))

(case always_with_a_delay_generates_a_clock
  (source "clock.sv" #"
                module Top(output logic [7:0] count, output logic clk);
                    initial clk = 1'b0;
                    initial count = 8'd0;
                    always #5 clk = ~clk;
                    always_ff @(posedge clk) count <= count + 8'd1;
                endmodule
            "#)
  (top Top)
  (run_until 4)
  (assert_eq clk 0)
  (assert_eq count 0)
  ; Rising edges at 5, 15, ..., 95.
  (run_until 100)
  (assert_eq count 10)
  (assert_eq clk 0))

(case edge_waits_resume_before_the_registers_of_that_edge_update
  (source "edges.sv" #"
                module Top(output logic [7:0] q);
                    logic clk = 1'b0;
                    logic [7:0] d = 8'd0;
                    initial q = 8'd0;
                    always #5 clk = ~clk;
                    always_ff @(posedge clk) q <= d;
                    initial begin
                        d = 8'd1;
                        @(posedge clk);
                        $display("first q=%0d", q);
                        #1 d = 8'd2;
                        @(posedge clk);
                        $display("second q=%0d", q);
                        @(negedge clk);
                        $display("negedge q=%0d", q);
                        repeat (2) @(posedge clk);
                        $display("repeat q=%0d", q);
                        $finish;
                    end
                endmodule
            "#)
  (top Top)
  ; A process woken by an edge runs in the active region, before the
  ; nonblocking updates of that edge (IEEE 1800-2023 4.4).
  (run_to_finish)
  (expect_output "first q=0\nsecond q=1\nnegedge q=2\nrepeat q=2\n")
  (assert_eq q 2))

(case any_change_waits_wake_on_every_value_change
  (source "changes.sv" #"
                module Top(output logic [7:0] data, output logic flag);
                    logic [7:0] other = 8'd0;
                    initial begin
                        data = 8'd0;
                        flag = 1'b0;
                        #3 data = 8'd7;
                        #4 data = 8'd7;
                        #1 data = 8'd9;
                        #2 other = 8'd1;
                        #2 flag = 1'b1;
                        #1 $finish;
                    end
                    initial forever begin
                        @(data);
                        $display("data=%0d", data);
                    end
                    initial forever begin
                        @(other or flag);
                        $display("other=%0d flag=%0d", other, flag);
                    end
                    initial forever begin
                        @(flag, data);
                        $display("either");
                    end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "data=7\neither\ndata=9\neither\nother=1 flag=0\nother=1 flag=1\neither\n"))

(case wait_statements_block_until_their_condition_holds
  (source "wait.sv" #"
                module Top(output logic [7:0] y);
                    logic go = 1'b0;
                    logic [7:0] level = 8'd0;
                    initial begin
                        y = 8'd0;
                        #7 go = 1'b1;
                        #5 level = 8'd3;
                        #5 level = 8'd5;
                    end
                    initial begin
                        wait (go) $display("go");
                        wait (go);
                        $display("still go");
                        wait (level > 8'd4) y = level;
                        $display("level=%0d", level);
                        #1 $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_until 6)
  (expect_output "")
  (run_until 7)
  (expect_output "go\nstill go\n")
  (run_to_finish)
  (expect_output "level=5\n")
  (assert_eq y 5))

(case level_sensitive_always_runs_as_a_process
  (source "level.sv" #"
                module Top(output logic [7:0] y);
                    logic [7:0] a = 8'd0;
                    logic [7:0] b = 8'd0;
                    initial y = 8'd0;
                    always @(a or b) y = a + b;
                    initial begin
                        #2 a = 8'd3;
                        #2 b = 8'd4;
                        #2 a = 8'd5;
                        #2 $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_until 1)
  (assert_eq y 0)
  (run_until 3)
  (assert_eq y 3)
  (run_until 5)
  (assert_eq y 7)
  (run_to_finish)
  (assert_eq y 9))

(case processes_wake_each_other_at_the_same_time
  (source "handshake.sv" #"
                module Top(output logic [7:0] y);
                    logic start = 1'b0;
                    logic done = 1'b0;
                    initial begin
                        y = 8'd0;
                        #3 start = 1'b1;
                        @(posedge done);
                        $display("done at y=%0d", y);
                        $finish;
                    end
                    initial begin
                        @(posedge start);
                        y = 8'd1;
                        #0 y = 8'd2;
                        done = 1'b1;
                    end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "done at y=2\n"))

(case tasks_with_timing_controls_run_in_processes
  (source "tasks.sv" #"
                module Top(output logic [7:0] y);
                    logic clk = 1'b0;
                    always #5 clk = ~clk;
                    task automatic pulse(input logic [7:0] value, input int cycles);
                        y = value;
                        repeat (cycles) @(posedge clk);
                        #1 y = 8'd0;
                    endtask
                    initial begin
                        y = 8'd0;
                        pulse(8'd7, 2);
                        $display("y=%0d", y);
                        pulse(8'd9, 1);
                        $display("y=%0d", y);
                        $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_until 10)
  (assert_eq y 7)
  ; The first pulse ends at 16, when the second one starts.
  (run_until 16)
  (assert_eq y 9)
  (expect_output "y=0\n")
  (run_until 25)
  (assert_eq y 9)
  (run_to_finish)
  (expect_output "y=0\n")
  (assert_eq y 0))

(case edge_waits_see_the_signals_the_script_drives
  (source "driven.sv" #"
                module Top(input logic a, output logic [7:0] seen);
                    initial begin
                        seen = 8'd0;
                        forever begin
                            @(posedge a);
                            seen = seen + 8'd1;
                        end
                    end
                endmodule
            "#)
  (top Top)
  (run_until 0)
  (modify (set a 0))
  (run_until 1)
  (for value (list 1 0 1 1 0)
    (modify (set a value))
    (run_until 2))
  (assert_eq seen 2)
  (modify (set a 1))
  (run_until 3)
  (assert_eq seen 3))

; IEEE 1800-2023 20.3: `$time` is the simulation time in the caller's time
; unit, rounded, and `$stime` its low 32 bits. Combinational logic reads it
; when its inputs change, not when only the time does: `$time` is no
; variable of its implicit sensitivity (9.2.2.2.1).
(case time_functions_report_the_time_in_the_caller_unit
  (source "time.sv" #"
                module Top(input logic clk, input logic [7:0] a,
                           output logic [63:0] y);
                    initial $display("initial %0d", $time);
                    always_ff @(posedge clk) $display("edge %0d %0d", $time, $stime);
                    always_comb y = a + $time;
                endmodule
            "#)
  (top Top)
  (run_until 0)
  (expect_output "initial 0\n")
  (modify (set clk 0) (set a 0))
  (run_until 3)
  (assert_eq y 0)
  (modify (set clk 1))
  (run_until 3)
  (expect_output "edge 3 3\n")
  (modify (set clk 0) (set a 2))
  (run_until 3)
  (assert_eq y 5)
  (run_until 40)
  (modify (set clk 1) (set a 4))
  (run_until 40)
  (expect_output "edge 40 40\n")
  (assert_eq y 44))

(case finish_in_an_always_process_ends_the_simulation
  (source "finish.sv" #"
                module Top(output logic [7:0] ticks);
                    initial ticks = 8'd0;
                    always begin
                        #3 ticks = ticks + 8'd1;
                        if (ticks == 8'd4) $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_until 7)
  (assert_eq ticks 2)
  (run_to_finish)
  (assert_eq ticks 4))

(case waiting_processes_do_not_keep_an_idle_simulation_running
  (source "idle.sv" #"
                module Top(output logic [7:0] y);
                    logic never = 1'b0;
                    initial begin
                        y = 8'd1;
                        @(posedge never);
                        y = 8'd2;
                    end
                    initial #5 y = 8'd3;
                endmodule
            "#)
  (top Top)
  (run_until 5)
  (assert_eq y 3)
  (run_until 100)
  (assert_eq y 3))

(case four_state_edges_count_transitions_through_unknown
  (source "four_state_edges.sv" #"
                module Top(input logic host_clk, output logic [7:0] host_count, output logic [7:0] pos, output logic [7:0] neg, output logic [7:0] any);
                    always_ff @(posedge host_clk) host_count <= host_count + 1;
                    logic s = 1'b0;
                    initial begin
                        host_count = 8'd0;
                        pos = 8'd0;
                        neg = 8'd0;
                        any = 8'd0;
                        #1 s = 1'bx; // 0 -> x: posedge
                        #1 s = 1'b1; // x -> 1: posedge
                        #1 s = 1'bz; // 1 -> z: negedge
                        #1 s = 1'bx; // z -> x: no edge, a change
                        #1 s = 1'b0; // x -> 0: negedge
                        #1 s = 1'b1; // 0 -> 1: posedge
                        #1 s = 1'b0; // 1 -> 0: negedge
                        #1 $finish;
                    end
                    initial forever begin
                        @(posedge s);
                        pos = pos + 8'd1;
                    end
                    initial forever begin
                        @(negedge s);
                        neg = neg + 8'd1;
                    end
                    initial forever begin
                        @(s);
                        any = any + 8'd1;
                    end
                endmodule
            "#)
  (top Top)
  (four_state)
  (run_until 0)
  ; x -> 0 is a negedge.
  (set host_clk 0)(eval)(assert_eq host_count 0)
  (set host_clk 1'bz)(eval)(assert_eq host_count 1)
  (set host_clk 1'bx)(eval)(assert_eq host_count 1)
  (set host_clk 1)(eval)(assert_eq host_count 2)
  (set host_clk 0)(eval)
  (set host_clk 1'bz)(eval)(assert_eq host_count 3)
  (run_to_finish)
  (assert_eq pos 3)
  (assert_eq neg 3)
  (assert_eq any 7))

(case unknown_delays_and_conditions_count_as_zero_and_false
  (source "unknown.sv" #"
                module Top(output logic [7:0] y);
                    logic [7:0] amount = 8'bx;
                    logic flag = 1'bx;
                    initial begin
                        y = 8'd1;
                        #amount y = 8'd2;
                        wait (flag) y = 8'd3;
                        $finish;
                    end
                    initial #4 flag = 1'b1;
                endmodule
            "#)
  (top Top)
  (four_state)
  (run_until 0)
  (assert_eq y 2)
  (run_to_finish)
  (assert_eq y 3))

(case direct_reads_settle_waiting_processes
  (source "read.sv" #"module Top(input bit go, output bit [7:0] seen);
    initial begin wait (go); seen = 1; #0; seen = 2; end
  endmodule"#)
  (top Top)
  (run_until 0)
  (set go 1)
  (assert_eq seen 2))

(case output_reads_settle_waiting_processes
  (source "output.sv" #"module Top(input bit go);
    initial begin wait (go); $display("woke"); end
  endmodule"#)
  (top Top)
  (run_until 0)
  (set go 1)
  (expect_output "woke\n"))

(case run_until_drains_target_time_before_later_writes
  (source "boundary.sv" #"module Top(input bit [7:0] a, output bit [7:0] y);
    initial #10 y = a;
  endmodule"#)
  (top Top)
  (run_until 0)
  (set a 1)
  (run_until 10)
  (set a 2)
  (assert_eq y 1))

(case repeated_settles_do_not_advance_design_time
  (source "settles.sv" #"module Top(output bit seen); initial #1 seen = 1; endmodule"#)
  (top Top)
  (run_until 0)
  (for i (range 0 1001) (eval))
  (assert_eq seen 0)
  (run_until 1)
  (assert_eq seen 1))

(case run_to_finish_has_no_simulated_time_deadline
  (source "late.sv" #"module Top(output bit done);
    initial begin #1000001; done = 1; $finish; end
  endmodule"#)
  (top Top)
  (run_to_finish)
  (assert_eq done 1))

(case blocking_ff_stores_are_visible_before_inactive_work
  (source "blocking.sv" #"module Top(output bit [7:0] q, observed, derived_seen);
      bit clk; wire [7:0] derived=q+1;
      always @(posedge clk) q=1;
      initial #1 clk=1;
      initial begin @(posedge clk); #0; observed=q; derived_seen=derived; q=9; end
    endmodule"#)
  (top Top) (run_until 1) (assert_eq observed 1) (assert_eq derived_seen 2) (assert_eq q 9))

(case blocking_ff_clock_edges_trigger_their_domains_before_inactive_work
  (source "blocking_clocks.sv" #"
      module Top(output bit [7:0] cnt, cnt_gated, cnt_derived, seen);
        bit clk, clk2, en = 1'b1, q = 1'b1;
        wire gated = clk2 & en;
        wire derived = ~q;
        always #5 clk = ~clk;
        always @(posedge clk) begin clk2 = ~clk2; q = ~q; end
        always_ff @(posedge clk2) cnt <= cnt + 8'd1;
        always_ff @(posedge gated) cnt_gated <= cnt_gated + 8'd1;
        always_ff @(posedge derived) cnt_derived <= cnt_derived + 8'd1;
        initial forever begin @(posedge clk); #0; seen = seen + 8'd1; end
      endmodule"#)
  (top Top)
  (run_until 50)
  (assert_eq seen 5)
  (assert_eq cnt 3 "a blocking clock edge triggers its domain")
  (assert_eq cnt_gated 3 "so does a clock computed from it")
  (assert_eq cnt_derived 3 "and a falling one through an inverter"))

(case nonblocking_assignments_in_processes_update_in_the_nba_region
  (source "process_nba.sv" #"
      module Top(output logic [7:0] q, early, late, bus, hi, lo, d, sampled);
        logic clk = 1'b0;
        always #5 clk = ~clk;
        initial begin
          q = 8'd0;
          bus = 8'd0;
          #1;
          q <= 8'd1;
          q <= 8'd2;
          #0 early = q;
          bus[7:4] <= 4'ha;
          {hi, lo} <= 16'h1234;
          #1 late = q;
        end
        // A stimulus process and a register sampling it at the same edge.
        initial begin
          d = 8'd0;
          forever @(posedge clk) d <= d + 8'd1;
        end
        always_ff @(posedge clk) sampled <= d;
      endmodule"#)
  (top Top)
  (run_until 1)
  (assert_eq early 0 "a nonblocking update lands after the inactive region")
  (assert_eq q 2 "the last update of a time slot wins")
  (assert_eq bus 0xa0)
  (assert_eq hi 0x12)
  (assert_eq lo 0x34)
  (run_until 2)
  (assert_eq late 2)
  (run_until 26)
  (assert_eq d 3)
  (assert_eq sampled 2 "the register samples the value before the edge's update"))

(case nonblocking_ff_stores_remain_pending_during_inactive_work
  (source "nonblocking.sv" #"module Top(output bit [7:0] q, observed, derived_seen);
      bit clk; wire [7:0] derived=q+1;
      always @(posedge clk) q<=1;
      initial #1 clk=1;
      initial begin @(posedge clk); #0; observed=q; derived_seen=derived; q=9; end
    endmodule"#)
  (top Top) (run_until 1) (assert_eq observed 0) (assert_eq derived_seen 1) (assert_eq q 1))

(case mixed_ff_stores_keep_their_active_and_nba_values
  (source "mixed.sv" #"module Top(output bit [7:0] q, observed, derived_seen);
      bit clk; wire [7:0] derived=q+1;
      always @(posedge clk) begin q<=7; q=2; end
      initial #1 clk=1;
      initial begin @(posedge clk); #0; observed=q; derived_seen=derived; q=9; end
    endmodule"#)
  (top Top) (run_until 1) (assert_eq observed 2) (assert_eq derived_seen 3) (assert_eq q 7))

(case printed_finish_notice_is_design_output
  (source "printed.sv" #"module Top;
      initial begin $display("source_0.sv:17: $finish called at 0 (1ps)"); #1; $finish; end
    endmodule"#)
  (top Top) (run_until 0) (expect_output "source_0.sv:17: $finish called at 0 (1ps)\n") (run_to_finish))

(case combinational_finish_ends_timed_execution
  (source "comb_finish.sv" #"module Top(output bit done);
      initial begin #1; done=1; end
      always_comb if(done) $finish;
    endmodule"#)
  (top Top) (run_to_finish) (assert_eq done 1))

(case inactive_time_directives_do_not_change_scheduler_units
 (source "inactive-scale.sv" #"`ifdef NEVER_DEFINED
 `timescale 10ns/1ps
 `endif
 module Top(output bit q);initial begin #1;q=1;end endmodule"#)
 (top Top)(run_until 1)(assert_eq q 1))

(case blocking_concatenation_publishes_one_event_update
  ; IEEE 1800-2023 4.9.3 and 10.4.1: enable events from the LHS update.
  (source "blocking_concat_events.sv" #"
    module Top(output bit [1:0] q, r, output bit seen, ff_seen);
      bit clk;
      bit [1:0] data;
      initial begin data = 3; #2; data = 2; end
      initial begin #1; {q[1], q[0]} = 2'b11; #1; q[0] = 0; end
      initial begin @(posedge (q[1] ^ q[0])); seen = 1; end
      initial begin #1; clk = 1; #1; clk = 0; #1; clk = 1; end
      always @(posedge clk) {r[1], r[0]} = data;
      initial begin @(posedge (r[1] ^ r[0])); ff_seen = 1; end
    endmodule
  "#)
  (top Top)
  (run_until 1)
  (assert_eq q 3)
  (assert_eq r 3)
  (assert_eq seen 0)
  (assert_eq ff_seen 0)
  (run_until 2)
  (assert_eq q 2)
  (assert_eq seen 1)
  (assert_eq ff_seen 0)
  (run_until 3)
  (assert_eq r 2)
  (assert_eq ff_seen 1))

(case finite_active_feedback_preserves_convergence
  (source "finite_feedback.sv" #"
    module Top(output bit [7:0] a, b);
      initial begin #1; a = 1; end
      always @(a) if (a < 4) b = a;
      always @(b) if (b < 4) a = b + 1;
    endmodule
  "#)
  (top Top)
  (run_until 1)
  (assert_eq a 4)
  (assert_eq b 3)
  (run_until 2)
  (assert_eq a 4)
  (assert_eq b 3))

(case pure_function_rhs_preserves_distinct_write_times
 (source "pure-timed-writes.sv" #"
 module Child(output bit[1:0]q);
 function automatic bit one();return 1;endfunction
 initial begin #2;q[0]=one();end
 initial begin #3;q[1]=one();end
 endmodule
 module Top(output bit[7:0]seen);
 bit[1:0]q;Child u(.q(q));
 initial begin #1;forever begin @(q[0]^q[1]);seen=seen+1;end end
 endmodule
 "#)
 (top Top)(run_until 2)(assert_eq seen 1)(run_until 3)(assert_eq seen 2))

(case conditional_writes_preserve_distinct_activation_times
 (source "conditional-writes.sv" #"
 module Child(input bit sel,output bit[1:0]q);
 initial begin #2;if(sel)q[0]=1;else q[0]=0;end
 initial begin #3;q[1]=1;end
 endmodule
 module Top(input bit sel,output bit[7:0]seen);
 bit[1:0]q;Child u(.sel(sel),.q(q));
 initial begin #1;forever begin @(q[0]^q[1]);seen=seen+1;end end
 endmodule
 "#)
 (top Top)(run_until 0)(set sel 1)(run_until 2)(assert_eq seen 1)(run_until 3)(assert_eq seen 2))

(case case_writes_preserve_distinct_activation_times
 (source "case-writes.sv" #"
 module Child(input bit[1:0]sel,output bit[1:0]q);
 initial begin #2;case(sel) 0:q[0]=0;1:q[0]=1;default:q[0]=1;endcase end
 initial begin #3;q[1]=1;end
 endmodule
 module Top(input bit[1:0]sel,output bit[7:0]seen);
 bit[1:0]q;Child u(.sel(sel),.q(q));
 initial begin #1;forever begin @(q[0]^q[1]);seen=seen+1;end end
 endmodule
 "#)
 (top Top)(run_until 0)(set sel 1)(run_until 2)(assert_eq seen 1)(run_until 3)(assert_eq seen 2))

(case constant_repeat_writes_preserve_distinct_activation_times
 (source "constant_repeat_writes_preserve_distinct_activation_times.sv" #"module Child(output bit[1:0]q);initial begin #2;repeat(1)q[0]=1;end initial begin #3;q[1]=1;end endmodule module Top(output bit[7:0]seen);bit[1:0]q;Child u(.q(q));initial begin #1;forever begin @(q[0]^q[1]);seen=seen+1;end end endmodule"#)
 (top Top)(run_until 2)(assert_eq seen 1)(run_until 3)(assert_eq seen 2))

(case separate_comb_assignments_preserve_selected_dependencies
 (source "separate_comb_assignments_preserve_selected_dependencies.sv" #"module Child(input bit a,b,output bit[1:0]q);always_comb begin q[0]=a;q[1]=b;end endmodule module Top(output bit[7:0]seen);bit a,b;bit[1:0]q;Child u(.a(a),.b(b),.q(q));initial begin #1;b=1;b=0;#1;a=1;end initial forever begin @(q[0]);seen=seen+1;end endmodule"#)
 (top Top)(run_until 1)(assert_eq seen 0)(run_until 2)(assert_eq seen 1))

(case constant_for_writes_preserve_distinct_activation_times
 (source "constant-for-times.sv" #"module Child(output bit[1:0]q);initial begin #2;for(int i=0;i<1;i++)q[0]=1;end initial begin #3;q[1]=1;end endmodule module Top(output bit[7:0]seen);bit[1:0]q;Child u(.q(q));initial begin #1;forever begin @(q[0]^q[1]);seen=seen+1;end end endmodule"#)
 (top Top)(run_until 2)(assert_eq seen 1)(run_until 3)(assert_eq seen 2))

(case untimed_tasks_preserve_distinct_activation_times
 (source "untimed_tasks_preserve_distinct_activation_times.sv" #"module Child(output bit[1:0]q);task automatic noop();endtask initial begin #2;noop();q[0]=1;end initial begin #3;noop();q[1]=1;end endmodule module Top(output bit[7:0]seen);bit[1:0]q;Child u(.q(q));initial begin #1;forever begin @(q[0]^q[1]);seen=seen+1;end end endmodule"#)
 (top Top)(run_until 2)(assert_eq seen 1)(run_until 3)(assert_eq seen 2))

(case untimed_task_copyback_preserves_distinct_activation_times
