(case blocking_concatenation_publishes_one_event_update
  ; IEEE 1800-2023 4.9.3 and 10.4.1: enable events from the LHS update.
  (source "blocking_concat_events.sv" #"
    module Top(output bit [1:0] q, r, output bit seen, ff_seen);
      bit clk;
      bit [1:0] data;
      initial begin data = 3; #2; data = 2; end
      initial begin #1; {q[1], q[0]} = 2'b11; #1; q[0] = 0; end
      initial begin @(posedge (q[1] ^ q[0])); seen = 1; end
      initial begin #1; clk = 1; #1; clk = 0; #1; clk = 1; end
      always @(posedge clk) {r[1], r[0]} = data;
      initial begin @(posedge (r[1] ^ r[0])); ff_seen = 1; end
    endmodule
  "#)
  (top Top)
  (run_until 1)
  (assert_eq q 3)
  (assert_eq r 3)
  (assert_eq seen 0)
  (assert_eq ff_seen 0)
  (run_until 2)
  (assert_eq q 2)
  (assert_eq seen 1)
  (assert_eq ff_seen 0)
  (run_until 3)
  (assert_eq r 2)
  (assert_eq ff_seen 1))

(case finite_active_feedback_preserves_convergence
  (source "finite_feedback.sv" #"
    module Top(output bit [7:0] a, b);
      initial begin #1; a = 1; end
      always @(a) if (a < 4) b = a;
      always @(b) if (b < 4) a = b + 1;
    endmodule
  "#)
  (top Top)
  (run_until 1)
  (assert_eq a 4)
  (assert_eq b 3)
  (run_until 2)
  (assert_eq a 4)
  (assert_eq b 3))

(case list_in_a_loop_through_always_comb_converges
  ; As `always @*` the list would close a combinational loop with the
  ; always_comb, so it runs as a process and the loop converges.
  (source "comb_feedback.sv" #"
    module Top(output bit [7:0] a, b);
      bit [7:0] s;
      initial begin #1; s = 1; end
      always @(s or b) a = (b < 4) ? b + s : b;
      always_comb b = (a < 4) ? a : 8'd3;
    endmodule
  "#)
  (top Top)
  (run_until 1)
  (assert_eq a 4)
  (assert_eq b 3))

(case list_outside_a_loop_keeps_its_value
  (source "partial_feedback.sv" #"
    module Top(output bit [7:0] a, b, c);
      bit [7:0] s;
      initial begin #1; s = 1; end
      always @(s or b) a = (b < 4) ? b + s : b;
      assign b = (a < 4) ? a : 8'd3;
      always @(b) c = b + 8'd10;
    endmodule
  "#)
  (top Top)
  (run_until 1)
  (assert_eq a 4)
  (assert_eq b 3)
  (assert_eq c 13))

