 (source "false_wait_preserves_separate_hierarchical_write_times.sv" #"module Child(output bit[1:0]v);initial begin #2;v[0]=1;wait(0);end initial begin #3;v[1]=1;end endmodule module Top(output bit[7:0]q);bit[1:0]v;Child c(.v(v));initial begin #1;forever begin @(v[0]^v[1]);q++;end end endmodule"#)
 (top Top)(run_until 2)(assert_eq q 1)(run_until 3)(assert_eq q 2))

