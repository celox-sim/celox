(group timing (category sequential))

; Procedural timing controls: `#delay`, `@(event)` and `wait (condition)` in
; `initial` blocks and `always` processes. The script advances time with
; `run_until` and `run_to_finish`; the design generates its own clocks.
; Every script begins with one of them, so the design's time-zero initial
; blocks, `always` processes and variable initializers have run before the
; script drives an input: no case depends on host values staged before them.

(case delays_resume_initial_blocks_at_later_times
  (source "delays.sv" #"
                module Top(output logic [7:0] a);
                    parameter int GAP = 4;
                    logic [7:0] pause = 8'd3;
                    initial begin
                        a = 8'd1;
                        #10 a = 8'd2;
                        #GAP a = 8'd3;
                        #(pause) a = 8'd4;
                        #0 a = 8'd5;
                        #pause;
                        $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_until 0)
  (assert_eq a 1)
  (run_until 10)
  (assert_eq a 2)
  (run_until 14)
  (assert_eq a 3)
  (run_until 17)
  (assert_eq a 5 "the zero delay resumes at the same time")
  (run_to_finish)
  (assert_eq a 5))

(case always_with_a_delay_generates_a_clock
  (source "clock.sv" #"
                module Top(output logic [7:0] count, output logic clk);
                    initial clk = 1'b0;
                    initial count = 8'd0;
                    always #5 clk = ~clk;
                    always_ff @(posedge clk) count <= count + 8'd1;
                endmodule
            "#)
  (top Top)
  (run_until 4)
  (assert_eq clk 0)
  (assert_eq count 0)
  ; Rising edges at 5, 15, ..., 95.
  (run_until 100)
  (assert_eq count 10)
  (assert_eq clk 0))

(case edge_waits_resume_before_the_registers_of_that_edge_update
  (source "edges.sv" #"
                module Top(output logic [7:0] q);
                    logic clk = 1'b0;
                    logic [7:0] d = 8'd0;
                    initial q = 8'd0;
                    always #5 clk = ~clk;
                    always_ff @(posedge clk) q <= d;
                    initial begin
                        d = 8'd1;
                        @(posedge clk);
                        $display("first q=%0d", q);
                        #1 d = 8'd2;
                        @(posedge clk);
                        $display("second q=%0d", q);
                        @(negedge clk);
                        $display("negedge q=%0d", q);
                        repeat (2) @(posedge clk);
                        $display("repeat q=%0d", q);
                        $finish;
                    end
                endmodule
            "#)
  (top Top)
  ; A process woken by an edge runs in the active region, before the
  ; nonblocking updates of that edge (IEEE 1800-2023 4.4).
  (run_to_finish)
  (expect_output "first q=0\nsecond q=1\nnegedge q=2\nrepeat q=2\n")
  (assert_eq q 2))

(case any_change_waits_wake_on_every_value_change
  (source "changes.sv" #"
                module Top(output logic [7:0] data, output logic flag);
                    logic [7:0] other = 8'd0;
                    initial begin
                        data = 8'd0;
                        flag = 1'b0;
                        #3 data = 8'd7;
                        #4 data = 8'd7;
                        #1 data = 8'd9;
                        #2 other = 8'd1;
                        #2 flag = 1'b1;
                        #1 $finish;
                    end
                    initial forever begin
                        @(data);
                        $display("data=%0d", data);
                    end
                    initial forever begin
                        @(other or flag);
                        $display("other=%0d flag=%0d", other, flag);
                    end
                    initial forever begin
                        @(flag, data);
                        $display("either");
                    end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "data=7\neither\ndata=9\neither\nother=1 flag=0\nother=1 flag=1\neither\n"))

(case wait_statements_block_until_their_condition_holds
  (source "wait.sv" #"
                module Top(output logic [7:0] y);
                    logic go = 1'b0;
                    logic [7:0] level = 8'd0;
                    initial begin
                        y = 8'd0;
                        #7 go = 1'b1;
                        #5 level = 8'd3;
                        #5 level = 8'd5;
                    end
                    initial begin
                        wait (go) $display("go");
                        wait (go);
                        $display("still go");
                        wait (level > 8'd4) y = level;
                        $display("level=%0d", level);
                        #1 $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_until 6)
  (expect_output "")
  (run_until 7)
  (expect_output "go\nstill go\n")
  (run_to_finish)
  (expect_output "level=5\n")
  (assert_eq y 5))

(case level_sensitive_always_runs_as_a_process
  (source "level.sv" #"
                module Top(output logic [7:0] y);
                    logic [7:0] a = 8'd0;
                    logic [7:0] b = 8'd0;
                    initial y = 8'd0;
                    always @(a or b) y = a + b;
                    initial begin
                        #2 a = 8'd3;
                        #2 b = 8'd4;
                        #2 a = 8'd5;
                        #2 $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_until 1)
  (assert_eq y 0)
  (run_until 3)
  (assert_eq y 3)
  (run_until 5)
  (assert_eq y 7)
  (run_to_finish)
  (assert_eq y 9))

(case explicit_list_of_every_read_waits_for_a_change
  ; Like `always @*`, the list waits before its first run: neither the
  ; declaration initializers nor the write of `y` wake it (9.4.2).
  (source "level_list.sv" #"
                module Top(output logic [7:0] y);
                    logic [7:0] a = 8'd0;
                    logic [7:0] b = 8'd0;
                    initial y = 8'd1;
                    always @(b, a) y = a + b;
                    initial begin
                        #2 a = 8'd3;
                        #2 b = 8'd5;
                        #2 $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_until 1)
  (assert_eq y 1)
  (run_until 3)
  (assert_eq y 3)
  (run_to_finish)
  (assert_eq y 8))

(case list_missing_a_read_does_not_wake_on_it
  (source "missing_read.sv" #"
                module Top(output logic [7:0] y);
                    logic [7:0] a = 8'd0;
                    logic [7:0] b = 8'd0;
                    initial y = 8'd0;
                    always @(a) y = a + b;
                    initial begin
                        #2 a = 8'd3;
                        #2 b = 8'd4;
                        #2 a = 8'd5;
                        #2 $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_until 3)
  (assert_eq y 3)
  (run_until 5)
  (assert_eq y 3)
  (run_to_finish)
  (assert_eq y 9))

(case list_with_an_extra_signal_wakes_on_it
  (source "extra_signal.sv" #"
                module Top;
                    logic [7:0] a = 8'd0;
                    logic [7:0] b = 8'd0;
                    logic c = 1'b0;
                    always @(a or b or c) $display("sum=%0d", a + b);
                    initial begin
                        #2 a = 8'd3;
                        #2 c = 1'b1;
                        #2 $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "sum=3\nsum=3\n"))

(case list_of_every_read_with_a_nonblocking_body_runs
  (source "nonblocking_list.sv" #"
                module Top(output logic [7:0] y);
                    logic [7:0] a = 8'd0;
                    logic [7:0] b = 8'd0;
                    initial y = 8'd0;
                    always @(a or b) y <= a + b;
                    initial begin
                        #2 a = 8'd3;
                        #2 b = 8'd5;
                        #2 $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_until 3)
  (assert_eq y 3)
  (run_to_finish)
  (assert_eq y 8))

(case processes_wake_each_other_at_the_same_time
  (source "handshake.sv" #"
                module Top(output logic [7:0] y);
                    logic start = 1'b0;
                    logic done = 1'b0;
                    initial begin
                        y = 8'd0;
                        #3 start = 1'b1;
                        @(posedge done);
                        $display("done at y=%0d", y);
                        $finish;
                    end
                    initial begin
                        @(posedge start);
                        y = 8'd1;
                        #0 y = 8'd2;
                        done = 1'b1;
                    end
                endmodule
            "#)
  (top Top)
  (run_to_finish)
  (expect_output "done at y=2\n"))

(case tasks_with_timing_controls_run_in_processes
  (source "tasks.sv" #"
                module Top(output logic [7:0] y);
                    logic clk = 1'b0;
                    always #5 clk = ~clk;
                    task automatic pulse(input logic [7:0] value, input int cycles);
                        y = value;
                        repeat (cycles) @(posedge clk);
                        #1 y = 8'd0;
                    endtask
                    initial begin
                        y = 8'd0;
                        pulse(8'd7, 2);
                        $display("y=%0d", y);
                        pulse(8'd9, 1);
                        $display("y=%0d", y);
                        $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_until 10)
  (assert_eq y 7)
  ; The first pulse ends at 16, when the second one starts.
  (run_until 16)
  (assert_eq y 9)
  (expect_output "y=0\n")
  (run_until 25)
  (assert_eq y 9)
  (run_to_finish)
  (expect_output "y=0\n")
  (assert_eq y 0))

(case edge_waits_see_the_signals_the_script_drives
  (source "driven.sv" #"
                module Top(input logic a, output logic [7:0] seen);
                    initial begin
                        seen = 8'd0;
                        forever begin
                            @(posedge a);
                            seen = seen + 8'd1;
                        end
                    end
                endmodule
            "#)
  (top Top)
  (run_until 0)
  (modify (set a 0))
  (run_until 1)
  (for value (list 1 0 1 1 0)
    (modify (set a value))
    (run_until 2))
  (assert_eq seen 2)
  (modify (set a 1))
  (run_until 3)
  (assert_eq seen 3))

; IEEE 1800-2023 20.3: `$time` is the simulation time in the caller's time
; unit, rounded, and `$stime` its low 32 bits. Combinational logic reads it
; when its inputs change, not when only the time does: `$time` is no
; variable of its implicit sensitivity (9.2.2.2.1).
(case time_functions_report_the_time_in_the_caller_unit
  (source "time.sv" #"
                module Top(input logic clk, input logic [7:0] a,
                           output logic [63:0] y);
                    initial $display("initial %0d", $time);
                    always_ff @(posedge clk) $display("edge %0d %0d", $time, $stime);
                    always_comb y = a + $time;
                endmodule
            "#)
  (top Top)
  (run_until 0)
  (expect_output "initial 0\n")
  (modify (set clk 0) (set a 0))
  (run_until 3)
  (assert_eq y 0)
  (modify (set clk 1))
  (run_until 3)
  (expect_output "edge 3 3\n")
  (modify (set clk 0) (set a 2))
  (run_until 3)
  (assert_eq y 5)
  (run_until 40)
  (modify (set clk 1) (set a 4))
  (run_until 40)
  (expect_output "edge 40 40\n")
  (assert_eq y 44))

(case finish_in_an_always_process_ends_the_simulation
  (source "finish.sv" #"
                module Top(output logic [7:0] ticks);
                    initial ticks = 8'd0;
                    always begin
                        #3 ticks = ticks + 8'd1;
                        if (ticks == 8'd4) $finish;
                    end
                endmodule
            "#)
  (top Top)
  (run_until 7)
  (assert_eq ticks 2)
  (run_to_finish)
  (assert_eq ticks 4))

(case waiting_processes_do_not_keep_an_idle_simulation_running
  (source "idle.sv" #"
                module Top(output logic [7:0] y);
                    logic never = 1'b0;
                    initial begin
                        y = 8'd1;
                        @(posedge never);
                        y = 8'd2;
                    end
                    initial #5 y = 8'd3;
                endmodule
            "#)
  (top Top)
  (run_until 5)
  (assert_eq y 3)
  (run_until 100)
  (assert_eq y 3))

(case four_state_edges_count_transitions_through_unknown
  (source "four_state_edges.sv" #"
                module Top(input logic host_clk, output logic [7:0] host_count, output logic [7:0] pos, output logic [7:0] neg, output logic [7:0] any);
                    always_ff @(posedge host_clk) host_count <= host_count + 1;
                    logic s = 1'b0;
                    initial begin
                        host_count = 8'd0;
                        pos = 8'd0;
                        neg = 8'd0;
                        any = 8'd0;
                        #1 s = 1'bx; // 0 -> x: posedge
                        #1 s = 1'b1; // x -> 1: posedge
                        #1 s = 1'bz; // 1 -> z: negedge
                        #1 s = 1'bx; // z -> x: no edge, a change
                        #1 s = 1'b0; // x -> 0: negedge
                        #1 s = 1'b1; // 0 -> 1: posedge
                        #1 s = 1'b0; // 1 -> 0: negedge
                        #1 $finish;
                    end
                    initial forever begin
                        @(posedge s);
                        pos = pos + 8'd1;
                    end
                    initial forever begin
                        @(negedge s);
                        neg = neg + 8'd1;
                    end
                    initial forever begin
                        @(s);
                        any = any + 8'd1;
                    end
                endmodule
            "#)
  (top Top)
  (four_state)
  (run_until 0)
  ; x -> 0 is a negedge.
  (set host_clk 0)(eval)(assert_eq host_count 0)
  (set host_clk 1'bz)(eval)(assert_eq host_count 1)
  (set host_clk 1'bx)(eval)(assert_eq host_count 1)
  (set host_clk 1)(eval)(assert_eq host_count 2)
  (set host_clk 0)(eval)
  (set host_clk 1'bz)(eval)(assert_eq host_count 3)
  (run_to_finish)
  (assert_eq pos 3)
  (assert_eq neg 3)
  (assert_eq any 7))

(case unknown_delays_and_conditions_count_as_zero_and_false
  (source "unknown.sv" #"
                module Top(output logic [7:0] y);
                    logic [7:0] amount = 8'bx;
                    logic flag = 1'bx;
                    initial begin
                        y = 8'd1;
                        #amount y = 8'd2;
                        wait (flag) y = 8'd3;
                        $finish;
                    end
                    initial #4 flag = 1'b1;
                endmodule
            "#)
  (top Top)
  (four_state)
  (run_until 0)
  (assert_eq y 2)
  (run_to_finish)
  (assert_eq y 3))

(case direct_reads_settle_waiting_processes
  (source "read.sv" #"module Top(input bit go, output bit [7:0] seen);
    initial begin wait (go); seen = 1; #0; seen = 2; end
  endmodule"#)
  (top Top)
  (run_until 0)
  (set go 1)
  (assert_eq seen 2))

(case output_reads_settle_waiting_processes
  (source "output.sv" #"module Top(input bit go);
    initial begin wait (go); $display("woke"); end
  endmodule"#)
  (top Top)
  (run_until 0)
  (set go 1)
  (expect_output "woke\n"))

(case run_until_drains_target_time_before_later_writes
  (source "boundary.sv" #"module Top(input bit [7:0] a, output bit [7:0] y);
    initial #10 y = a;
  endmodule"#)
  (top Top)
  (run_until 0)
  (set a 1)
  (run_until 10)
  (set a 2)
  (assert_eq y 1))

(case repeated_settles_do_not_advance_design_time
  (source "settles.sv" #"module Top(output bit seen); initial #1 seen = 1; endmodule"#)
  (top Top)
  (run_until 0)
  (for i (range 0 1001) (eval))
  (assert_eq seen 0)
  (run_until 1)
  (assert_eq seen 1))

(case run_to_finish_has_no_simulated_time_deadline
  (source "late.sv" #"module Top(output bit done);
    initial begin #1000001; done = 1; $finish; end
  endmodule"#)
  (top Top)
  (run_to_finish)
  (assert_eq done 1))

(case blocking_ff_stores_are_visible_before_inactive_work
  (source "blocking.sv" #"module Top(output bit [7:0] q, observed, derived_seen);
      bit clk; wire [7:0] derived=q+1;
      always @(posedge clk) q=1;
      initial #1 clk=1;
      initial begin @(posedge clk); #0; observed=q; derived_seen=derived; q=9; end
    endmodule"#)
  (top Top) (run_until 1) (assert_eq observed 1) (assert_eq derived_seen 2) (assert_eq q 9))

(case blocking_ff_clock_edges_trigger_their_domains_before_inactive_work
  (source "blocking_clocks.sv" #"
      module Top(output bit [7:0] cnt, cnt_gated, cnt_derived, seen);
        bit clk, clk2, en = 1'b1, q = 1'b1;
        wire gated = clk2 & en;
        wire derived = ~q;
        always #5 clk = ~clk;
        always @(posedge clk) begin clk2 = ~clk2; q = ~q; end
        always_ff @(posedge clk2) cnt <= cnt + 8'd1;
        always_ff @(posedge gated) cnt_gated <= cnt_gated + 8'd1;
        always_ff @(posedge derived) cnt_derived <= cnt_derived + 8'd1;
        initial forever begin @(posedge clk); #0; seen = seen + 8'd1; end
      endmodule"#)
  (top Top)
  (run_until 50)
  (assert_eq seen 5)
  (assert_eq cnt 3 "a blocking clock edge triggers its domain")
  (assert_eq cnt_gated 3 "so does a clock computed from it")
  (assert_eq cnt_derived 3 "and a falling one through an inverter"))

(case nonblocking_assignments_in_processes_update_in_the_nba_region
  (source "process_nba.sv" #"
      module Top(output logic [7:0] q, early, late, bus, hi, lo, d, sampled);
        logic clk = 1'b0;
        always #5 clk = ~clk;
        initial begin
          q = 8'd0;
          bus = 8'd0;
          #1;
          q <= 8'd1;
          q <= 8'd2;
          #0 early = q;
          bus[7:4] <= 4'ha;
          {hi, lo} <= 16'h1234;
          #1 late = q;
        end
        // A stimulus process and a register sampling it at the same edge.
        initial begin
          d = 8'd0;
          forever @(posedge clk) d <= d + 8'd1;
        end
        always_ff @(posedge clk) sampled <= d;
      endmodule"#)
  (top Top)
  (run_until 1)
  (assert_eq early 0 "a nonblocking update lands after the inactive region")
  (assert_eq q 2 "the last update of a time slot wins")
  (assert_eq bus 0xa0)
  (assert_eq hi 0x12)
  (assert_eq lo 0x34)
  (run_until 2)
  (assert_eq late 2)
  (run_until 26)
  (assert_eq d 3)
  (assert_eq sampled 2 "the register samples the value before the edge's update"))

(case staged_nonblocking_updates_keep_their_order
  (source "staged_nba.sv" #"
      module Top(output logic [7:0] last, count, early, two_sites, stim_seen, sampled);
        logic [7:0] x = 8'd0, n = 8'd0, y = 8'd0, stim = 8'd0, r = 8'd0;
        logic clk = 1'b0;
        always #5 clk = ~clk;
        initial begin
          #1;
          for (int i = 0; i < 3; i++) x <= 8'(i + 4);
          repeat (2) n <= n + 8'd1;
          for (int i = 0; i < 2; i++)
            if (i == 1) y <= 8'd1;
            else y <= 8'd2;
          #0 early = x;
        end
        initial forever @(posedge clk) stim <= stim + 8'd3;
        always_ff @(posedge clk) r <= stim;
        assign last = x;
        assign count = n;
        assign two_sites = y;
        assign stim_seen = stim;
        assign sampled = r;
      endmodule"#)
  (top Top)
  (run_until 1)
  (assert_eq early 0 "a staged update lands after the inactive region")
  (assert_eq last 6 "the last update of one site in a time slot wins")
  (assert_eq count 1 "each update reads the value before the slot's updates")
  (assert_eq two_sites 1 "updates of two sites land in the order they were issued")
  (run_until 26)
  (assert_eq stim_seen 9)
  (assert_eq sampled 6 "the register samples the value before the edge's update"))

(case narrow_nonblocking_updates_keep_the_other_bits
  (source "narrow_nba.sv" #"
      module Top(output logic [16:0] ps, pq, output logic [64:0] ws, wq,
                 output logic [65:0] xs, xq);
        logic [15:0] p = 16'hffff, q = 16'hffff;
        logic [63:0] w = 64'd0, v = 64'd0;
        logic [64:0] x = 65'd0, y = 65'd0;
        initial begin
          #1;
          p[11:4] <= 8'ha5;
          q[11:4] <= 8'h5a;
          q[3:0] <= 4'h0;
          w <= 64'hfedc_ba98_7654_3210;
          v <= 64'h0123_4567_89ab_cdef;
          v[63:60] <= 4'h8;
          x <= {1'b1, 64'h8000_0000_0000_0001};
          y[64:1] <= 64'hffff_ffff_ffff_ffff;
          y[0] <= 1'b0;
        end
        // Extended, so that no target becomes a port.
        assign ps = {1'b0, p};
        assign pq = {1'b0, q};
        assign ws = {1'b0, w};
        assign wq = {1'b0, v};
        assign xs = {1'b0, x};
        assign xq = {1'b0, y};
      endmodule"#)
  (top Top)
  (run_until 1)
  (assert_eq ps 0xfa5f "a part select across a byte boundary keeps the other bits")
  (assert_eq pq 0xf5a0)
  (assert_eq ws 0xfedcba9876543210 "a 64-bit target takes all its bits")
  (assert_eq wq 0x8123456789abcdef)
  (assert_eq xs 0x18000000000000001 "a 65-bit target takes all its bits")
  (assert_eq xq 0x1fffffffffffffffe))

(case four_state_nonblocking_updates_keep_unknown_bits
  (source "four_state_nba.sv" #"
      module Top(output bit staged, queued, wide);
        logic [15:0] p = 16'bx, q = 16'bx;
        logic [64:0] x = 65'bx;
        initial begin
          #1;
          p[11:4] <= 8'ha5;
          q[11:4] <= 8'h5z;
          q[3:0] <= 4'h1;
          x[32:1] <= 32'h8000_0001;
        end
        assign staged = p === 16'bxxxx_1010_0101_xxxx;
        assign queued = q === 16'bxxxx_0101_zzzz_0001;
        assign wide = x === {32'bx, 32'h8000_0001, 1'bx};
      endmodule"#)
  (top Top)
  (four_state)
  (run_until 1)
  (assert_eq staged 1 "an update keeps the unknown bits around it")
  (assert_eq queued 1)
  (assert_eq wide 1))

(case nonblocking_ff_stores_remain_pending_during_inactive_work
  (source "nonblocking.sv" #"module Top(output bit [7:0] q, observed, derived_seen);
      bit clk; wire [7:0] derived=q+1;
      always @(posedge clk) q<=1;
      initial #1 clk=1;
      initial begin @(posedge clk); #0; observed=q; derived_seen=derived; q=9; end
    endmodule"#)
  (top Top) (run_until 1) (assert_eq observed 0) (assert_eq derived_seen 1) (assert_eq q 1))

(case mixed_ff_stores_keep_their_active_and_nba_values
  (source "mixed.sv" #"module Top(output bit [7:0] q, observed, derived_seen);
      bit clk; wire [7:0] derived=q+1;
      always @(posedge clk) begin q<=7; q=2; end
      initial #1 clk=1;
      initial begin @(posedge clk); #0; observed=q; derived_seen=derived; q=9; end
    endmodule"#)
  (top Top) (run_until 1) (assert_eq observed 2) (assert_eq derived_seen 3) (assert_eq q 7))

(case printed_finish_notice_is_design_output
  (source "printed.sv" #"module Top;
      initial begin $display("source_0.sv:17: $finish called at 0 (1ps)"); #1; $finish; end
    endmodule"#)
  (top Top) (run_until 0) (expect_output "source_0.sv:17: $finish called at 0 (1ps)\n") (run_to_finish))

