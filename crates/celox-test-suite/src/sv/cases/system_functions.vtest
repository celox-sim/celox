(group system_functions (category functions))

(case countones_preserves_argument_and_return_types
  (source "countones.sv" #"
                module Child(input int value, output int y);
                    assign y = value;
                endmodule
                module Top(input logic signed [7:0] a,
                           output int count, output logic [63:0] wide,
                           output logic [1:0] narrow, output int via_child,
                           output int sum_count, output int selected,
                           output int nested, output int function_count,
                           output logic negative, output logic [63:0] inverted);
                    function automatic logic [7:0] identity(input logic [7:0] v);
                        return v;
                    endfunction
                    assign count = $countones(a);
                    assign wide = $countones(a);
                    assign narrow = $countones(a);
                    assign sum_count = $countones(a + 8'd1);
                    assign selected = $countones(a[5:2]);
                    assign nested = $countones($countones(a));
                    assign function_count = $countones(identity(a));
                    assign negative = ($countones(a) - 32'sd9) < 0;
                    assign inverted = ~$countones(a);
                    Child child(.value($countones(a)), .y(via_child));
                endmodule
            "#)
  (top Top)
  (for value (range 0 (+ 255 1))
    (modify (set a value))
    (let ones (popcount value))
    (expand name (count wide via_child function_count)
      (assert_eq {name} ones "{name}"))
    (assert_eq narrow (& ones 3))
    (assert_eq sum_count (popcount (trunc 8 (+ value 1))))
    (assert_eq selected (popcount (& (>> value 2) 15)))
    (assert_eq nested (popcount ones))
    (assert_eq negative 1)
    (assert_eq inverted (trunc 64 (~ ones)))))

(case countones_ignores_unknown_bits_in_comb_and_ff
  (four_state)
  (source "countones_four_state.sv" #"
                module Top(input bit clk, input logic [255:0] a,
                           output int count, output int registered,
                           output int packed_count, output int fill_count);
                    always_comb count = $countones(a);
                    always_ff @(posedge clk) registered <= $countones(a);
                    assign packed_count = $countones({a[7:0], 4'b1xz0});
                    assign fill_count = $countones('1);
                endmodule
            "#)
  (top Top)
  (let all (- (<< 1 256) 1))
  (for (value mask expected packed) (list (all 0 256 9) (all all 0 1) (0 all 0 1) ((| (<< 1 200) 0b1011) (| (<< 1 200) 0b1100) 2 3))
    (modify (set a (fourstate value mask)))
    (tick clk)
    (expand name (count registered)
      (assert_eq {name} (fourstate expected 0)))
    (assert_eq packed_count (fourstate packed 0))
    (assert_eq fill_count (fourstate 1 0))))

(case countones_in_constant_expressions
  (four_state)
  (source "countones_constants.sv" #"
                module Top(output logic [31:0] result, output logic [31:0] literals);
                    localparam logic signed [7:0] NEG = -1;
                    localparam C = $countones(NEG);
                    localparam MIXED = $countones(8'b10xz_11xz);
                    if (C == 8 && MIXED == 3 && $bits(C) == 32) begin
                        assign result = $countones(256'hffff_ffff_ffff_ffff_ffff_ffff_ffff_ffff_ffff);
                    end else begin
                        assign result = 0;
                    end
                    assign literals = $countones('1) + $countones(-1) + $countones('x) + $countones('z);
                endmodule
            "#)
  (top Top)
  (eval)
  (assert_eq result 144)
  (assert_eq literals 33))

(case bit_vector_predicates_preserve_argument_and_return_types
  (source "bit_vector_predicates.sv" #"
                module Child(input logic [63:0] value, output logic [63:0] y);
                    assign y = value;
                endmodule
                module Top(input logic signed [7:0] a,
                           output logic [63:0] hot, hot0, unknown, via_child,
                           output logic [63:0] inverted, via_function,
                           output logic incremented, selected, nested, negative,
                           output logic [7:0] decoded);
                    function automatic logic predicate(input logic [7:0] v);
                        return $onehot(v);
                    endfunction
                    assign hot = $onehot(a);
                    assign hot0 = $onehot0(a);
                    assign unknown = $isunknown(a);
                    assign inverted = ~$onehot(a);
                    assign via_function = predicate(a);
                    assign incremented = $onehot(a + 8'd1);
                    assign selected = $onehot(a[5:2]);
                    assign nested = $onehot($onehot0(a));
                    assign negative = ($onehot(a) - 32'sd2) < 0;
                    Child child(.value($onehot(a)), .y(via_child));
                    always_comb begin
                        case ($onehot(a))
                            1'b0: decoded = 8'h35;
                            1'b1: decoded = 8'ha7;
                        endcase
                    end
                endmodule
            "#)
  (top Top)
  (for value (range 0 (+ 255 1))
    (modify (set a value))
    (let hot (== (popcount value) 1))
    (let hot0 (<= (popcount value) 1))
    (expand name (hot via_child via_function)
      (assert_eq {name} hot "{name}"))
    (assert_eq hot0 hot0)
    (assert_eq unknown 0)
    (assert_eq inverted (trunc 64 (~ hot)))
    (assert_eq incremented (== (popcount (trunc 8 (+ value 1))) 1))
    (assert_eq selected (== (popcount (& (>> value 2) 15)) 1))
    (assert_eq nested hot0)
    (assert_eq negative 0)
    (assert_eq decoded (? (== hot 1) 0xa7 0x35))))

(case bit_vector_predicates_in_constant_expressions
  (four_state)
  (source "bit_vector_predicate_constants.sv" #"
                module Top(output logic [7:0] result, output logic [3:0] literals);
                    localparam H = $onehot(8'b0x0z_0001);
                    localparam Z = $onehot0('z);
                    localparam U = $isunknown(256'hx);
                    if (H && Z && U && $bits(H) == 1 && $size(U) == 1) begin
                        assign result = 8'ha5;
                    end else begin
                        assign result = 0;
                    end
                    assign literals = {$onehot('1), $onehot0('x), $isunknown('z), $isunknown('0)};
                endmodule
            "#)
  (top Top)
  (eval)
  (assert_eq result (fourstate 0xa5 0))
  (assert_eq literals (fourstate 0b1110 0)))

(case bit_vector_predicates_handle_unknown_bits_in_comb_ff_and_ports
  (four_state)
  (source "bit_vector_predicates_four_state.sv" #"
                module Child(input logic [2:0] value, output logic [2:0] y);
                    assign y = value;
                endmodule
                module Top(input bit clk, input logic [255:0] a,
                           output logic [2:0] comb, registered, via_child,
                           output logic [63:0] unknown_wide,
                           output logic unknown_bit, unknown_partial);
                    always_comb comb = {$onehot(a), $onehot0(a), $isunknown(a)};
                    always_ff @(posedge clk)
                        registered <= {$onehot(a), $onehot0(a), $isunknown(a)};
                    Child child(.value({$onehot(a), $onehot0(a), $isunknown(a)}), .y(via_child));
                    assign unknown_wide = $isunknown(a);
                    assign unknown_bit = $isunknown(a[0]);
                    assign unknown_partial = $isunknown(a[128:0]);
                endmodule
            "#)
  (top Top)
  ; Every combination of 0/1/X/Z in the low four bits.
  (for mask (range 0 16)
    (for value (range 0 16)
      (modify (set a (fourstate value mask)))
      (tick clk)
      (let ones (popcount (& value (~ mask))))
      (let predicates (| (<< (== ones 1) 2) (<< (<= ones 1) 1) (!= mask 0)))
      (expand name (comb registered via_child)
        (assert_eq {name} predicates "{name}"))
      (assert_eq unknown_wide (!= mask 0) "unknown_wide")
      (assert_eq unknown_bit (bit mask 0) "unknown_bit")
      (assert_eq unknown_partial (!= (slice mask 128 0) 0) "unknown_partial")))
  ; Word boundaries, and unknown bits in the highest word.
  (for b (list 63 64 127 128 200 255)
    (for (value mask)
        (list ((<< 1 b) 0) ((| (<< 1 b) 1) 0) (0 (<< 1 b)) ((<< 1 b) (<< 1 b)) ((| (<< 1 b) 1) (<< 1 b)))
      (modify (set a (fourstate value mask)))
      (tick clk)
      (let ones (popcount (& value (~ mask))))
      (let predicates (| (<< (== ones 1) 2) (<< (<= ones 1) 1) (!= mask 0)))
      (expand name (comb registered via_child)
        (assert_eq {name} predicates "{name}"))
      (assert_eq unknown_wide (!= mask 0) "unknown_wide")
      (assert_eq unknown_bit (bit mask 0) "unknown_bit")
      (assert_eq unknown_partial (!= (slice mask 128 0) 0) "unknown_partial")))
  (let all (- (<< 1 256) 1))
  (for (value mask) (list (all 0) (all all) (0 all))
    (modify (set a (fourstate value mask)))
    (tick clk)
    (let ones (popcount (& value (~ mask))))
    (let predicates (| (<< (== ones 1) 2) (<< (<= ones 1) 1) (!= mask 0)))
    (expand name (comb registered via_child)
      (assert_eq {name} predicates "{name}"))
    (assert_eq unknown_wide (!= mask 0) "unknown_wide")
    (assert_eq unknown_bit (bit mask 0) "unknown_bit")
    (assert_eq unknown_partial (!= (slice mask 128 0) 0) "unknown_partial")))

(case countbits_preserves_argument_and_return_types
  (source "countbits.sv" #"
    module Child(input int a, output int y);
        assign y = a;
    endmodule
    module Top(input logic signed [7:0] a, input logic [7:0] control,
               output int ones, zeros, selected, via_child, sum_count, nested,
               output logic [63:0] inverted, output logic [1:0] narrow,
               output logic negative);
        function automatic int count(input logic [7:0] v, c);
            return $countbits(v, c);
        endfunction
        assign ones = $countbits(a, '1, '1);
        assign zeros = $countbits(a, '0);
        assign selected = count(a, control);
        assign inverted = ~$countbits(a, '1);
        assign narrow = $countbits(a, '1);
        assign sum_count = $countbits(a + 8'd1, '1);
        assign nested = $countbits($countbits(a, '1), '1);
        assign negative = ($countbits(a, '1) - 32'sd9) < 0;
        Child child(.a($countbits(a[5:2], '1)), .y(via_child));
    endmodule
  "#)
  (top Top)
  (for value (range 0 256)
    (modify (set a value) (set control value))
    (let ones (popcount value))
    (assert_eq ones ones)
    (assert_eq zeros (- 8 ones))
    (assert_eq selected (? (bit value 0) ones (- 8 ones)))
    (assert_eq inverted (trunc 64 (~ ones)))
    (assert_eq narrow (& ones 3))
    (assert_eq sum_count (popcount (trunc 8 (+ value 1))))
    (assert_eq nested (popcount ones))
    (assert_eq negative 1)
    (assert_eq via_child (popcount (& (>> value 2) 15)))))

(case countbits_in_constant_expressions
  (four_state)
  (source "countbits_constants.sv" #"
    module Top(output int result, literals);
        localparam logic signed [7:0] NEG = -1;
        localparam logic [7:0] MIXED = 8'b10xz_11xz;
        localparam logic [255:0] WIDE_X = 'x;
        localparam logic [7:0] CTRL_X = 8'b0000_000x;
        localparam logic [7:0] CTRL_Z = 8'b1111_111z;
        localparam C = $countbits(NEG, 8'hff, '1);
        localparam X = $countbits(MIXED, 'x);
        localparam Z = $countbits(MIXED, 'z);
        localparam K = $countbits(MIXED, '0, '1);
        if (C == 8 && X == 2 && Z == 2 && K == 4 &&
            $bits(C) == 32 && $size(C) == 32 &&
            $countbits(MIXED[2:0], 'x, 'z) == 2 &&
            $countbits(8'hff + 8'd1, '0) == 8 &&
            $countbits(1'bx ? 4'b1010 : 4'b1000, 'x) == 1 &&
            $countbits(8'hfe, 8'hfe) == 1 &&
            $countbits(WIDE_X, CTRL_X, CTRL_X) == 256 &&
            $countbits(MIXED, CTRL_Z) == 2 &&
            $countbits({MIXED[2:0], MIXED[7:4]}, 'x, 'z) == 4 &&
            $countbits({2{MIXED}}, 'x, 'z) == 8) begin
            assign result = $countbits(256'hx, 'x, 'x) +
                            $countbits(256'hz, 'z) +
                            $countbits(MIXED, '0, '1, 'x, 'z, '0);
        end else begin
            assign result = 0;
        end
        assign literals = $countbits('1, '1) + $countbits(-1, '1) +
                          $countbits('x, 'x) + $countbits('z, 'z);
    endmodule
  "#)
  (top Top)
  (eval)
  (assert_eq result 520)
  (assert_eq literals 35))

(case countbits_matches_four_states_and_variable_controls
  (four_state)
  (source "countbits_four_state.sv" #"
    module Child(input logic [255:0] a, input logic c, output int y);
        assign y = $countbits(a, c, c);
    endmodule
    module Top(input bit clk, input logic [255:0] a,
               input logic [7:0] c, d,
               output int zeros, ones, xs, zs, selected, registered, via_child,
               output int all_states, literal_controlled);
        assign zeros = $countbits(a, '0);
        assign ones = $countbits(a, '1);
        assign xs = $countbits(a, 'x);
        assign zs = $countbits(a, 'z);
        always_comb selected = $countbits(a, c, d, c);
        always_ff @(posedge clk) registered <= $countbits(a, c, d, c);
        Child child(.a(a), .c(c[0]), .y(via_child));
        assign all_states = $countbits(a, '0, '1, 'x, 'z);
        assign literal_controlled = $countbits(8'b10xz_11xz, c[0], d[0], c[0]);
    endmodule
  "#)
  (top Top)
  (let all (- (<< 1 256) 1))
  ; Exercise every pair of control states, with upper control bits ignored.
  (for mask (range 0 4)
    (for value (range 0 4)
      (for cm (range 0 2)
        (for cv (range 0 2)
          (for dm (range 0 2)
            (for dv (range 0 2)
              (modify (set a (fourstate value mask))
                      (set c (fourstate (| 0xa0 cv) (| 0xf0 cm)))
                      (set d (fourstate (| 0x50 dv) (| 0xf0 dm))))
              (tick clk)
              (let zeros (- 256 (popcount (| value mask))))
              (let ones (popcount (& value (~ mask))))
              (let xs (popcount (& value mask)))
              (let zs (popcount (& (~ value) mask)))
              (let cc (? cm (? cv xs zs) (? cv ones zeros)))
              (let dc (? dm (? dv xs zs) (? dv ones zeros)))
              (let expected (+ cc (? (&& (== cm dm) (== cv dv)) 0 dc)))
              (assert_eq zeros zeros)
              (assert_eq ones ones)
              (assert_eq xs xs)
              (assert_eq zs zs)
              (expand name (selected registered)
                (assert_eq {name} expected "{name}"))
              (assert_eq via_child cc)
              (assert_eq all_states 256)
              (let lc (? cm 2 (? cv 3 1)))
              (let ld (? dm 2 (? dv 3 1)))
              (assert_eq literal_controlled (+ lc (? (&& (== cm dm) (== cv dv)) 0 ld)))))))))
  ; Unknown states across machine-word boundaries, including the highest bit.
  (for b (list 63 64 127 128 200 255)
    (for value (list 0 (<< 1 b))
      (modify (set a (fourstate value (<< 1 b)))
              (set c (fourstate 1 1)) (set d (fourstate 0 1)))
      (tick clk)
      (assert_eq zeros 255)
      (assert_eq ones 0)
      (assert_eq xs (!= value 0))
      (assert_eq zs (== value 0))
      (assert_eq selected 1)
      (assert_eq registered 1)
      (assert_eq via_child (!= value 0))
      (assert_eq all_states 256)))
  (modify (set a (fourstate all all)))
  (tick clk)
  (assert_eq xs 256)
  (assert_eq zs 0)
  (assert_eq selected 256)
  (assert_eq registered 256))

(case countbits_in_parameter_specializations_and_generate_scopes
  (four_state)
  (source "countbits_parameters.sv" #"
    module Child #(parameter logic [7:0] MASK = 8'b10xz_11xz,
                   parameter int C = $countbits(MASK, 'x, 'z))
                  (output logic [C:0] y, output int count);
        localparam ALIAS = MASK;
        assign y = '1;
        assign count = $countbits(ALIAS, 'x, 'z);
    endmodule
    module Top(output logic [4:0] original, output logic [0:0] known,
               output int c_original, c_known,
               output int scoped, extended, via_function);
        localparam logic [7:0] MIXED = 8'b10xz_11xz;
        localparam logic signed [3:0] SIGNED_X = 4'bx001;
        localparam logic signed [7:0] EXTENDED_X = SIGNED_X;
        function automatic int count_parameter();
            return $countbits(MIXED, 'x, 'z);
        endfunction
        assign extended = $countbits(EXTENDED_X, 'x);
        assign via_function = count_parameter();
        Child a(.y(original), .count(c_original));
        Child #(.MASK(8'hff)) b(.y(known), .count(c_known));
        if ($countbits(MIXED, 'x, 'z) == 4) begin : g
            localparam logic [7:0] CONTROL = 8'bxxxx_xxxz;
            localparam COUNT = $countbits(MIXED, CONTROL, CONTROL);
            assign scoped = COUNT;
        end else begin
            assign scoped = -1;
        end
    endmodule
  "#)
  (top Top)
  (eval)
  (assert_eq original 31)
  (assert_eq known 1)
  (assert_eq c_original 4)
  (assert_eq c_known 0)
  (assert_eq scoped 2)
  (assert_eq extended 5)
  (assert_eq via_function 4))
