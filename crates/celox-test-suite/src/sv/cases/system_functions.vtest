(group system_functions (category functions))

(case countones_preserves_argument_and_return_types
  (source "countones.sv" #"
                module Child(input int value, output int y);
                    assign y = value;
                endmodule
                module Top(input logic signed [7:0] a,
                           output int count, output logic [63:0] wide,
                           output logic [1:0] narrow, output int via_child,
                           output int sum_count, output int selected,
                           output int nested, output int function_count,
                           output logic negative, output logic [63:0] inverted);
                    function automatic logic [7:0] identity(input logic [7:0] v);
                        return v;
                    endfunction
                    assign count = $countones(a);
                    assign wide = $countones(a);
                    assign narrow = $countones(a);
                    assign sum_count = $countones(a + 8'd1);
                    assign selected = $countones(a[5:2]);
                    assign nested = $countones($countones(a));
                    assign function_count = $countones(identity(a));
                    assign negative = ($countones(a) - 32'sd9) < 0;
                    assign inverted = ~$countones(a);
                    Child child(.value($countones(a)), .y(via_child));
                endmodule
            "#)
  (top Top)
  (for value (range 0 (+ 255 1))
    (modify (set a value))
    (let ones (popcount value))
    (expand name (count wide via_child function_count)
      (assert_eq {name} ones "{name}"))
    (assert_eq narrow (& ones 3))
    (assert_eq sum_count (popcount (trunc 8 (+ value 1))))
    (assert_eq selected (popcount (& (>> value 2) 15)))
    (assert_eq nested (popcount ones))
    (assert_eq negative 1)
    (assert_eq inverted (trunc 64 (~ ones)))))

(case countones_ignores_unknown_bits_in_comb_and_ff
  (four_state)
  (source "countones_four_state.sv" #"
                module Top(input bit clk, input logic [255:0] a,
                           output int count, output int registered,
                           output int packed_count, output int fill_count);
                    always_comb count = $countones(a);
                    always_ff @(posedge clk) registered <= $countones(a);
                    assign packed_count = $countones({a[7:0], 4'b1xz0});
                    assign fill_count = $countones('1);
                endmodule
            "#)
  (top Top)
  (let all (- (<< 1 256) 1))
  (for (value mask expected packed) (list (all 0 256 9) (all all 0 1) (0 all 0 1) ((| (<< 1 200) 0b1011) (| (<< 1 200) 0b1100) 2 3))
    (modify (set a (fourstate value mask)))
    (tick clk)
    (expand name (count registered)
      (assert_eq {name} (fourstate expected 0)))
    (assert_eq packed_count (fourstate packed 0))
    (assert_eq fill_count (fourstate 1 0))))

(case countones_in_constant_expressions
  (four_state)
  (source "countones_constants.sv" #"
                module Top(output logic [31:0] result, output logic [31:0] literals);
                    localparam logic signed [7:0] NEG = -1;
                    localparam C = $countones(NEG);
                    localparam MIXED = $countones(8'b10xz_11xz);
                    if (C == 8 && MIXED == 3 && $bits(C) == 32) begin
                        assign result = $countones(256'hffff_ffff_ffff_ffff_ffff_ffff_ffff_ffff_ffff);
                    end else begin
                        assign result = 0;
                    end
                    assign literals = $countones('1) + $countones(-1) + $countones('x) + $countones('z);
                endmodule
            "#)
  (top Top)
  (eval)
  (assert_eq result 144)
  (assert_eq literals 33))

(case bit_vector_predicates_preserve_argument_and_return_types
  (source "bit_vector_predicates.sv" #"
                module Child(input logic [63:0] value, output logic [63:0] y);
                    assign y = value;
                endmodule
                module Top(input logic signed [7:0] a,
                           output logic [63:0] hot, hot0, unknown, via_child,
                           output logic [63:0] inverted, via_function,
                           output logic incremented, selected, nested, negative,
                           output logic [7:0] decoded);
                    function automatic logic predicate(input logic [7:0] v);
                        return $onehot(v);
                    endfunction
                    assign hot = $onehot(a);
                    assign hot0 = $onehot0(a);
                    assign unknown = $isunknown(a);
                    assign inverted = ~$onehot(a);
                    assign via_function = predicate(a);
                    assign incremented = $onehot(a + 8'd1);
                    assign selected = $onehot(a[5:2]);
                    assign nested = $onehot($onehot0(a));
                    assign negative = ($onehot(a) - 32'sd2) < 0;
                    Child child(.value($onehot(a)), .y(via_child));
                    always_comb begin
                        case ($onehot(a))
                            1'b0: decoded = 8'h35;
                            1'b1: decoded = 8'ha7;
                        endcase
                    end
                endmodule
            "#)
  (top Top)
  (for value (range 0 (+ 255 1))
    (modify (set a value))
    (let hot (== (popcount value) 1))
    (let hot0 (<= (popcount value) 1))
    (expand name (hot via_child via_function)
      (assert_eq {name} hot "{name}"))
    (assert_eq hot0 hot0)
    (assert_eq unknown 0)
    (assert_eq inverted (trunc 64 (~ hot)))
    (assert_eq incremented (== (popcount (trunc 8 (+ value 1))) 1))
    (assert_eq selected (== (popcount (& (>> value 2) 15)) 1))
    (assert_eq nested hot0)
    (assert_eq negative 0)
    (assert_eq decoded (? (== hot 1) 0xa7 0x35))))

(case bit_vector_predicates_in_constant_expressions
  (four_state)
  (source "bit_vector_predicate_constants.sv" #"
                module Top(output logic [7:0] result, output logic [3:0] literals);
                    localparam H = $onehot(8'b0x0z_0001);
                    localparam Z = $onehot0('z);
                    localparam U = $isunknown(256'hx);
                    if (H && Z && U && $bits(H) == 1 && $size(U) == 1) begin
                        assign result = 8'ha5;
                    end else begin
                        assign result = 0;
                    end
                    assign literals = {$onehot('1), $onehot0('x), $isunknown('z), $isunknown('0)};
                endmodule
            "#)
  (top Top)
  (eval)
  (assert_eq result (fourstate 0xa5 0))
  (assert_eq literals (fourstate 0b1110 0)))

(case bit_vector_predicates_handle_unknown_bits_in_comb_ff_and_ports
  (four_state)
  (source "bit_vector_predicates_four_state.sv" #"
                module Child(input logic [2:0] value, output logic [2:0] y);
                    assign y = value;
                endmodule
                module Top(input bit clk, input logic [255:0] a,
                           output logic [2:0] comb, registered, via_child,
                           output logic [63:0] unknown_wide,
                           output logic unknown_bit, unknown_partial);
                    always_comb comb = {$onehot(a), $onehot0(a), $isunknown(a)};
                    always_ff @(posedge clk)
                        registered <= {$onehot(a), $onehot0(a), $isunknown(a)};
                    Child child(.value({$onehot(a), $onehot0(a), $isunknown(a)}), .y(via_child));
                    assign unknown_wide = $isunknown(a);
                    assign unknown_bit = $isunknown(a[0]);
                    assign unknown_partial = $isunknown(a[128:0]);
                endmodule
            "#)
  (top Top)
  ; Every combination of 0/1/X/Z in the low four bits.
  (for mask (range 0 16)
    (for value (range 0 16)
      (modify (set a (fourstate value mask)))
      (tick clk)
      (let ones (popcount (& value (~ mask))))
      (let predicates (| (<< (== ones 1) 2) (<< (<= ones 1) 1) (!= mask 0)))
      (expand name (comb registered via_child)
        (assert_eq {name} predicates "{name}"))
      (assert_eq unknown_wide (!= mask 0) "unknown_wide")
      (assert_eq unknown_bit (bit mask 0) "unknown_bit")
      (assert_eq unknown_partial (!= (slice mask 128 0) 0) "unknown_partial")))
  ; Word boundaries, and unknown bits in the highest word.
  (for b (list 63 64 127 128 200 255)
    (for (value mask)
        (list ((<< 1 b) 0) ((| (<< 1 b) 1) 0) (0 (<< 1 b)) ((<< 1 b) (<< 1 b)) ((| (<< 1 b) 1) (<< 1 b)))
      (modify (set a (fourstate value mask)))
      (tick clk)
      (let ones (popcount (& value (~ mask))))
      (let predicates (| (<< (== ones 1) 2) (<< (<= ones 1) 1) (!= mask 0)))
      (expand name (comb registered via_child)
        (assert_eq {name} predicates "{name}"))
      (assert_eq unknown_wide (!= mask 0) "unknown_wide")
      (assert_eq unknown_bit (bit mask 0) "unknown_bit")
      (assert_eq unknown_partial (!= (slice mask 128 0) 0) "unknown_partial")))
  (let all (- (<< 1 256) 1))
  (for (value mask) (list (all 0) (all all) (0 all))
    (modify (set a (fourstate value mask)))
    (tick clk)
    (let ones (popcount (& value (~ mask))))
    (let predicates (| (<< (== ones 1) 2) (<< (<= ones 1) 1) (!= mask 0)))
    (expand name (comb registered via_child)
      (assert_eq {name} predicates "{name}"))
    (assert_eq unknown_wide (!= mask 0) "unknown_wide")
    (assert_eq unknown_bit (bit mask 0) "unknown_bit")
    (assert_eq unknown_partial (!= (slice mask 128 0) 0) "unknown_partial")))

; IEEE 1800-2023 21.2.1.2: radices keep leading zeros up to the argument's
; largest value, decimals pad with spaces, a field width overrides both, and
; `%0` displays the minimum width. Table 21-1 gives `%H` the meaning of `%h`.
(case display_arguments_are_sized_as_ieee_specifies
  (source "sizing.sv" #"
                module Top(input logic clk, input logic [11:0] a,
                           input logic signed [7:0] s);
                    always_ff @(posedge clk) begin
                        $display(":%h:%0h:%3h:%x:", a, a, a, 32'h5);
                        $display(":%b:%0b:%o:%0o:", a, a, a, a);
                        $display(":%d:%0d:%3d:%d:", a, a, a, s);
                        $write(":%3d:%5s:", 32'd1234, "ab");
                        $write("|%H|\n", a);
                    end
                endmodule
            "#)
  (top Top)
  (modify (set a 10) (set s (trunc 8 -2)))
  (expect_output "")
  (tick clk)
  (expect_output #":00a:a:00a:00000005:
:000000001010:1010:0012:12:
:  10:10: 10:  -2:
:1234:   ab:|00a|
"#))

; IEEE 1800-2023 21.2.1.2: a value wider than its field width expands the
; field without leading zeros (`%3h` of 32'h1234 displays 1234).
(case display_field_widths_expand_to_the_value
  (source "field.sv" #"
                module Top(input logic clk, input logic [31:0] a);
                    always_ff @(posedge clk) $display(":%3h:%2o:", a, a);
                endmodule
            "#)
  (top Top)
  (modify (set a 0x1234))
  (tick clk)
  (expect_output ":1234:11064:\n"))

; IEEE 1800-2023 21.2.1.3: a digit whose bits are all X (or all Z) displays
; as x (z), one with only some unknown bits as X (Z, unless some are X), and
; a decimal value with unknown bits as one such character.
(case display_unknown_bits_as_ieee_specifies
  (four_state)
  (source "unknown.sv" #"
                module Top(input logic clk, input logic [11:0] a,
                           input logic [7:0] b, input logic [7:0] c);
                    always_ff @(posedge clk) begin
                        $display(":%h:%o:%b:%d:", a, a, a, a);
                        $display(":%h:%h:%d:%d:%0h:", b, c, b, c, c);
                    end
                endmodule
            "#)
  (top Top)
  (modify (set a 12'b001xxx101x01) (set b 8'bzzzzzzzz) (set c 8'b0000000z))
  (tick clk)
  (expect_output #":XXX:1x5X:001xxx101x01:   X:
:zz:0Z:  z:  Z:Z:
"#))

; IEEE 1800-2023 21.2.1.1: an argument without a format specification of its
; own is displayed, with automatic sizing, in the task's radix: decimal for
; $display and $write, and binary, octal or hexadecimal for their b, o and h
; variants. Consecutive arguments are not separated.
(case display_tasks_default_to_their_radix
  (source "radix.sv" #"
                module Top(input logic clk, input logic [7:0] a,
                           input logic [11:0] b);
                    always_ff @(posedge clk) begin
                        $display(a, b);
                        $displayh(a, b);
                        $displayb(a);
                        $displayo(b);
                        $displayh("a=", a, " b=", b);
                        $display("a=%h", a, b);
                        $writeh(a);
                        $write("|\n");
                    end
                endmodule
            "#)
  (top Top)
  (modify (set a 10) (set b 10))
  (tick clk)
  (expect_output #" 10  10
0a00a
00001010
0012
a=0a b=00a
a=0a  10
0a|
"#))

; IEEE 1800-2023 11.7: signing casts retain the operand width and bits.
(case signed_casts_in_parameters
  (four_state)
  (source "signed_parameters.sv" #"
    module Top(output logic [31:0] signed_value, unsigned_value, nested,
               output logic [15:0] unknown, output logic [7:0] generated);
      localparam int P = $signed(8'hff);
      localparam U = $unsigned(8'shff);
      localparam N = $signed($unsigned(8'sh80));
      localparam logic signed [15:0] X = $signed(8'bx001_0101);
      assign signed_value = P;
      assign unsigned_value = U;
      assign nested = N;
      assign unknown = X;
      if (P == -1 && U == 255 && N == -128 && $bits(U) == 8) begin
        assign generated = 8'ha5;
      end else begin
        assign generated = 0;
      end
    endmodule
  "#)
  (top Top)
  (eval)
  (assert_eq signed_value 0xffffffff)
  (assert_eq unsigned_value 255)
  (assert_eq nested 0xffffff80)
  (assert_eq unknown (fourstate 0xff95 0xff80))
  (assert_eq generated 0xa5))

; IEEE 1800-2023 20.7: unpacked dimensions precede packed dimensions,
; bounds retain declaration direction, and integer return values are signed.
(case array_queries_preserve_bounds_and_dimensions
  (source "array_queries.sv" #"
    module Top(output logic [31:0] result, selected, shadowed, parameter_value);
      typedef logic [0:3][3:0] word_t;
      word_t mem [-2:1][8:6];
      localparam logic [9:6] BOUND = 0;
      localparam int BL = $left(BOUND);
      localparam int P = $left(mem) + $right(mem, 2) + $low(word_t, 2)
                       + $high(word_t) + $dimensions(mem) + $unpacked_dimensions(mem);
      function automatic int query(input logic [11:8] mem);
        return $left(mem) + $right(mem) + $dimensions(mem);
      endfunction
      assign result = $left(mem) + $right(mem, 2) + $low(mem, 3)
                    + $high(mem, 4) + $dimensions(mem) + $unpacked_dimensions(mem)
                    + $increment(mem) + $increment(mem, 2) + $increment(word_t)
                    + $dimensions(int) + $left(int) + $unpacked_dimensions(int);
      assign selected = $left(mem[0]) + $right(mem[0][7]) + $dimensions(mem[0][7]);
      assign shadowed = query(0);
      assign parameter_value = P + BL + $left(BOUND[8:7]);
    endmodule
  "#)
  (top Top)
  (eval)
  (assert_eq result 44)
  (assert_eq selected 13)
  (assert_eq shadowed 20)
  (assert_eq parameter_value 23))

(case array_queries_handle_runtime_dimensions
  (four_state)
  (source "runtime_queries.sv" #"
    module Top(input logic [31:0] dimension, output integer l, r, lo, hi, inc);
      logic [7:4] mem [2:5];
      assign l = $left(mem, dimension);
      assign r = $right(mem, dimension);
      assign lo = $low(mem, dimension);
      assign hi = $high(mem, dimension);
      assign inc = $increment(mem, dimension);
    endmodule
  "#)
  (top Top)
  (for (d l r lo hi inc) (list (1 2 5 2 5 0xffffffff) (2 7 4 4 7 1))
    (modify (set dimension d))
    (assert_eq l l) (assert_eq r r) (assert_eq lo lo) (assert_eq hi hi) (assert_eq inc inc))
  (for d (list 0 3 0x08000001 0xffffffff (fourstate 0xffffffff 0xffffffff))
    (modify (set dimension d))
    (expand name (l r lo hi inc)
      (assert_eq {name} (fourstate 0xffffffff 0xffffffff)))))

; IEEE 1800-2023 16.3: cover executes its pass action only for true.
(case immediate_cover_executes_pass_statement
  (source "cover_action.sv" #"
    module Top(input bit clk, input logic condition, output logic [7:0] comb, registered);
      always_comb begin
        comb = 0;
        cover (condition) comb = 8'ha5;
      end
      always_ff @(posedge clk) begin
        registered <= 0;
        cover (condition) registered <= 8'h5a;
      end
    endmodule
  "#)
  (top Top)
  (for (condition c r) (list (0 0 0) (1 0xa5 0x5a) (0 0 0) (1 0xa5 0x5a))
    (modify (set condition condition))
    (tick clk)
    (assert_eq comb c)
    (assert_eq registered r)))

(case immediate_cover_handles_unknown_conditions
  (four_state)
  (source "cover_action.sv" #"
    module Top(input bit clk, input logic condition, output logic [7:0] comb, registered);
      always_comb begin
        comb = 0;
        cover (condition) comb = 8'ha5;
      end
      always_ff @(posedge clk) begin
        registered <= 0;
        cover (condition) registered <= 8'h5a;
      end
    endmodule
  "#)
  (top Top)
  (for (condition c r) (list ((fourstate 1 1) 0 0) ((fourstate 0 1) 0 0))
    (modify (set condition condition))
    (tick clk)
    (assert_eq comb c)
    (assert_eq registered r)))
