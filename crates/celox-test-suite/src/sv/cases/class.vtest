(case constrained_randomize_scalar
  (source "constraints.sv" #"
module Top(output bit done);
    class Packet;
        rand bit [3:0] x, y;
        int limit = 4;
        constraint bounds { x < limit; y < 4; x + y == 5; x >= 0; y > 0; x <= 3; }
    endclass
    Packet p;
    int old_x, old_y;
    initial begin
        p = new;
        p.srandom(17);
        repeat (8) begin
            if (!p.randomize()) $fatal(1, "sat failed");
            if (!(p.x < 4 && p.y < 4 && p.x + p.y == 5)) $fatal(1, "invalid model");
        end
        old_x = p.x; old_y = p.y;
        p.limit = 1;
        if (p.randomize()) $fatal(1, "unsat succeeded");
        if (p.x != old_x || p.y != old_y) $fatal(1, "unsat changed fields");
        p.limit = 4;
        p.x = 2; p.y = 3;
        if (!p.randomize(null)) $fatal(1, "check-only failed");
        p.y = 0;
        if (p.randomize(null)) $fatal(1, "check-only ignored constraints");
        p.x.rand_mode(0);
        if (!p.randomize() || p.x != 2 || p.y != 3) $fatal(1, "disabled rand is not state");
        p.y = 1;
        if (p.randomize(x)) $fatal(1, "selection should be unsat");
        if (p.x.rand_mode() != 0 || p.y.rand_mode() != 1) $fatal(1, "failed selection leaked modes");
        p.y = 3;
        if (!p.randomize() || p.x != 2) $fatal(1, "modes not restored");
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1))

(case constrained_randomize_width_and_inheritance
  (source "constraint_widths.sv" #"
module Top(output bit done);
    class Base;
        rand bit signed [7:0] a;
        rand bit signed [15:0] b;
        rand bit [31:0] c;
        constraint values { a == -1; b == 1; c == 256; }
        constraint sum { (a + b) == c; }
    endclass
    class Derived extends Base;
        constraint values { a == -2; b == 2; c == 256; }
    endclass
    Base p;
    Derived q;
    initial begin
        p = new;
        if (!p.randomize()) $fatal(1, "unsigned context was lost");
        if (p.a != -1 || p.b != 1 || p.c != 256) $fatal(1, "base values");
        q = new;
        p = q;
        if (!p.randomize()) $fatal(1, "derived constraints were not dispatched");
        if (q.a != -2 || q.b != 2 || q.c != 256) $fatal(1, "override values");
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1))

(case constrained_randomize_hooks
  (source "constraint_hooks.sv" #"
module Top(output bit done);
    class Packet;
        rand int x;
        int limit, before_count, after_count;
        constraint bounds { x == limit; x < 3; }
        function void pre_randomize(); before_count++; limit = before_count; endfunction
        function void post_randomize(); after_count++; endfunction
    endclass
    Packet p;
    initial begin
        p = new;
        if (!p.randomize() || p.x != 1) $fatal(1, "first pre state");
        if (!p.randomize() || p.x != 2) $fatal(1, "second pre state");
        if (p.randomize() || p.x != 2) $fatal(1, "unsat changed fields");
        if (p.before_count != 3 || p.after_count != 2) $fatal(1, "post called on failure");
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1))

(case constrained_randomize_inside
  (source "constraint_inside.sv" #"
module Top(output bit done);
    class Packet;
        rand int x, lo, hi;
        constraint bounds { lo inside {-3, -2}; hi inside {2, 3};
            x inside {[lo:hi], 9}; !(x inside {0, 9}); }
    endclass
    class Empty;
        rand int x;
        constraint c { x inside {[3:-3]}; }
    endclass
    Packet p;
    Empty e;
    initial begin
        e = new; e.x = 42;
        if (e.randomize() || e.x != 42) $fatal(1, "empty range changed fields");
        p = new;
        repeat (12) begin
            if (!p.randomize()) $fatal(1, "membership unsat");
            if (p.lo < -3 || p.lo > -2 || p.hi < 2 || p.hi > 3 ||
                p.x < p.lo || p.x > p.hi || p.x == 0) $fatal(1, "membership");
        end
        p.lo = 3; p.hi = -3;
        if (p.randomize(x)) $fatal(1, "reversed range must be empty");
        p.lo = -2; p.hi = 2; p.x = -1;
        if (!p.randomize(null)) $fatal(1, "negative check-only member");
        p.x = p.lo;
        if (!p.randomize(null)) $fatal(1, "low endpoint excluded");
        p.x = p.hi;
        if (!p.randomize(null)) $fatal(1, "high endpoint excluded");
        p.x = 0;
        if (p.randomize(null)) $fatal(1, "excluded check-only member");
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1))

(case constrained_randomize_inside_widths
  (source "constraint_inside_widths.sv" #"
module Top(output bit done);
    class Packet;
        rand bit signed [7:0] x;
        rand bit [15:0] y;
        constraint c { x inside {-2, -1}; y inside {x}; }
    endclass
    class WideSet;
        bit [3:0] a, b;
        constraint c { !((a + b) inside {4'd0, 8'd17}); }
    endclass
    class WideRange;
        bit [3:0] a, b;
        constraint c { (a + b) inside {[4'd1:8'd16]}; }
    endclass
    Packet p;
    WideSet s;
    WideRange r;
    initial begin
        p = new;
        if (!p.randomize()) $fatal(1, "mixed width membership");
        if (p.x != -2 && p.x != -1) $fatal(1, "signed membership");
        if (p.y != 254 && p.y != 255) $fatal(1, "unsigned comparison context");
        s = new; s.a = 15; s.b = 1;
        if (!s.randomize(null)) $fatal(1, "membership-wide sum width");
        r = new; r.a = 15; r.b = 1;
        if (!r.randomize(null)) $fatal(1, "range endpoint width");
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1))

(case constrained_randomize_conditionals
  (source "conditional_constraints.sv" #"
module Top(output bit done);
    class Packet;
        rand bit mode;
        rand int value;
        int required;
        constraint c {
            value == required;
            if (mode) { value inside {[1:3]}; value != 2; }
            else value == 8;
            mode -> { value > 0; if (value == 3) value != 1; }
        }
    endclass
    Packet p;
    initial begin
        p = new;
        p.required = 8;
        if (!p.randomize() || p.mode != 0 || p.value != 8) $fatal(1, "reverse else solve");
        p.required = 3;
        if (!p.randomize() || p.mode != 1 || p.value != 3) $fatal(1, "reverse then solve");
        p.required = 2;
        if (p.randomize() || p.value != 3) $fatal(1, "block constraint lost");
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1))

(case constrained_randomize_nested_guards
  (source "nested_guards.sv" #"
module Top(output bit done);
    class Packet;
        rand bit a, b;
        rand int x;
        constraint c {
            x == 7;
            if (a) if (b) x == 1; else x == 7;
            !a -> x == 2;
            a -> b -> x == 1;
            if (1'b0) x == 123;
        }
    endclass
    Packet p;
    initial begin
        p = new;
        if (!p.randomize() || p.a != 1 || p.b != 0 || p.x != 7) $fatal(1, "nested guards");
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1))

(case constrained_randomize_state_properties
  (source "class.sv" #"
module Top(output int sum, output bit done);
    class Node;
        int id;
    endclass
    class Base;
        string name = "base";
        Node next;
    endclass
    class Packet extends Base;
        int queue[$];
        bit [127:0] wide;
        int low;
        rand bit [7:0] x;
        rand bit [3:0] y;
        constraint range { x inside {[10:20]}; x > low; y == (x & 8'hf); }
    endclass
    Packet p;
    initial begin
        p = new;
        p.next = new;
        p.next.id = 5;
        p.queue = '{1, 2, 3};
        p.wide = {64'hdead_beef_0000_0001, 64'h2};
        p.low = 17;
        for (int i = 0; i < 20; i++) begin
            if (!p.randomize()) $fatal(1, "randomize");
            if (p.x < 18 || p.x > 20 || p.y != p.x[3:0]) $fatal(1, "constraint %0d %0d", p.x, p.y);
        end
        sum = p.next.id + p.queue.size() + p.queue[2] + int'(p.wide[127:96] == 32'hdeadbeef) + p.name.len();
        $display("%s %0d", p.name, sum);
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq sum 16) (assert_eq done 1)
  (expect_output "base 16\n"))

(case constrained_randomize_rand_objects
  (source "class.sv" #"
module Top(output int sum, output bit done);
    class Leaf;
        rand bit [3:0] v;
        int pre, post;
        constraint c { v inside {[3:5]}; }
        function void pre_randomize(); pre++; endfunction
        function void post_randomize(); post++; endfunction
    endclass
    class SubLeaf extends Leaf;
        constraint d { v != 4; }
    endclass
    class Stuck extends Leaf;
        constraint e { v == 9; }
    endclass
    class Node;
        rand bit [3:0] w;
        rand Leaf leaf;
        rand Leaf none;
        Leaf plain;
        constraint k { w < 3; }
    endclass
    class Holder;
        rand Leaf leaf;
    endclass
    Node n;
    SubLeaf s;
    Holder h;
    int bad;
    initial begin
        n = new;
        s = new;
        n.leaf = s;
        n.plain = new;
        for (int i = 0; i < 20; i++) begin
            if (!n.randomize()) $fatal(1, "randomize");
            if (n.w >= 3 || !(s.v inside {3, 5})) bad++;
        end
        // A non-rand handle is not randomized; the hooks ran once per call.
        sum = s.pre + s.post + n.plain.v + n.plain.pre;
        // A class without constraints of its own solves its rand objects.
        h = new;
        h.leaf = new;
        if (!h.randomize() || !(h.leaf.v inside {[3:5]}) || h.leaf.pre != 1) bad++;
        // An unsatisfiable member fails the call, changes nothing and runs
        // no post_randomize.
        begin
            Stuck stuck = new;
            n.leaf = stuck;
            n.w = 2;
            if (n.randomize() || n.w != 2 || stuck.v != 0 || stuck.pre != 1 || stuck.post != 0) bad++;
        end
        $display("%0d %0d", sum, bad);
        done = bad == 0;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq sum 40) (assert_eq done 1)
  (expect_output "40 0\n"))

(case constrained_randomize_rand_arrays
  (source "rand_arrays.sv" #"
module Top(output int bad, output bit done);
    typedef enum bit [1:0] { A = 1, B = 2 } e_t;
    class Item;
        rand bit [63:0] value[];
        constraint max_values { value.size() > 0 && value.size() < 10; }
    endclass
    class Fifo;
        rand bit [7:0] fifo[$];
        int unsigned m_size = 4;
        constraint valid_fifo_size { fifo.size() <= m_size; }
    endclass
    class Len;
        rand int len;
        rand int data[];
        rand e_t kinds[];
        rand bit [7:0] plain[];
        constraint db { len inside {[0:15]}; data.size == len; kinds.size() == 3; }
    endclass
    Item item;
    Fifo f;
    Len l;
    int nonzero;
    initial begin
        item = new;
        f = new;
        l = new;
        l.plain = new[5];
        for (int i = 0; i < 30; i++) begin
            if (item.randomize() == 0 || item.value.size() < 1 || item.value.size() > 9) bad++;
            foreach (item.value[j]) if (item.value[j] != 0) nonzero++;
            if (f.randomize() == 0 || f.fifo.size() > 4) bad++;
            if (l.randomize() == 0 || l.data.size() != l.len || l.kinds.size() != 3
                || l.plain.size() != 5) bad++;
            foreach (l.kinds[j]) if (!(l.kinds[j] inside {A, B})) bad++;
        end
        if (nonzero == 0) bad++;
        $display("%0d", bad);
        done = bad == 0;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq bad 0) (assert_eq done 1)
  (expect_output "0\n"))

(case constrained_randomize_selects
  (source "selects.sv" #"
module Top(output int bad, output bit done);
    typedef bit signed [3:0] nibble_t;
    class Selects;
        rand bit [31:0] addr;
        rand bit [0:7] up;
        rand bit [35:4] off;
        rand bit [3:0][7:0] p;
        rand int i;
        rand bit signed [7:0] g;
        rand bit [15:0] w;
        // An element of a signed named type is signed (7.4.1).
        rand nibble_t [1:0] n;
        constraint c {
            addr[1:0] == 0;
            addr[31] == 1'b1;
            up[0:3] == 4'ha;
            up[7] == 1'b1;
            off[11:4] == 8'h3c;
            off[35-:4] == 4'h9;
            off[12+:4] == 4'h6;
            p[2] == 8'h5a;
            i[31] == 1'b1;
            // A select is unsigned: a negative g reads as a positive byte.
            g[7:0] > 0 && g < 0;
            w[15:8] == w[7:0] + 8'h1;
            n[0] < 0;
            n[1] > 0;
        }
    endclass
    Selects s;
    // n[0] < 0 and n[1] > 0, read from the whole value.
    function automatic int nibbles(bit [7:0] v);
        return v[3] == 1 && v[7] == 0 && v[7:4] != 0;
    endfunction
    initial begin
        s = new;
        for (int n = 0; n < 20; n++) begin
            if (s.randomize() == 0) bad++;
            // `up` and `off` are read whole: up[0:3] are its high bits and
            // off[11:4] its low ones.
            if (s.addr[1:0] != 0 || s.addr[31] != 1 || s.up >> 4 != 4'ha || s.up % 2 != 1
                || s.off % 256 != 8'h3c || s.off >> 28 != 4'h9 || s.off / 256 % 16 != 4'h6
                || (s.p >> 16) % 256 != 8'h5a || s.i >= 0 || s.g >= 0 || s.w[15:8] != s.w[7:0] + 8'h1
                || nibbles(s.n) != 1)
                bad++;
            if (s.randomize() with { addr[3:2] == 2'b11; } == 0 || s.addr[3:0] != 4'hc) bad++;
        end
        $display("%0d", bad);
        done = bad == 0;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq bad 0) (assert_eq done 1)
  (expect_output "0\n"))

; `solve before` orders the choice of values (18.5.9): the solutions are
; the ones the other constraints allow.
(case constrained_randomize_solve_before
  (source "solve_before.sv" #"
module Top(output int bad, output bit done);
    class Fill;
        rand bit [31:0] start_addr;
        rand int block_size;
        rand byte q[$];
        constraint block_sys_limit { block_size inside {16, 32, 64, 128, 512, 1024}; }
        constraint within_range {
            start_addr < (32'h0104_0000 - block_size * 4);
            start_addr > 32'h0100_0000;
            solve block_size before start_addr;
            start_addr[1:0] == 0;
        }
        constraint sized { solve q.size() before block_size; q.size() < 4; }
    endclass
    // A member of the object a rand handle refers to orders too.
    class Item; rand bit [7:0] m; endclass
    class Outer;
        rand Item h;
        rand bit [7:0] y;
        constraint c { solve h.m before y; y == h.m + 1; h.m < 8'hff; }
        function new(); h = new; endfunction
    endclass
    // Properties qualified by `this` and `super` (8.11, 8.15), as other
    // constraints name them, also inline (18.7).
    class Base; rand bit [7:0] z; endclass
    class Named extends Base;
        rand bit [7:0] x, y;
        constraint c {
            solve this.x before y;
            solve super.z before this.x;
            y == this.x + 1;
            super.z < 8'h10;
            x > z;
            x < 8'h80;
        }
    endclass
    // A select of a rand variable (Syntax 18-8), as other constraints name
    // it.
    class Scoped;
        rand bit [1:0] a;
        rand bit b;
        constraint c {
            solve a[0] before b;
            b == a[0];
        }
    endclass
    Fill f;
    Outer o;
    Named m;
    Scoped sc;
    // The arguments of a scope randomize are random variables (18.12.1).
    bit [7:0] a, b;
    initial begin
        f = new;
        o = new;
        m = new;
        sc = new;
        for (int n = 0; n < 20; n++) begin
            if (f.randomize() == 0) bad++;
            if (!(f.block_size inside {16, 32, 64, 128, 512, 1024}) || f.start_addr[1:0] != 0
                || f.start_addr <= 32'h0100_0000 || f.start_addr >= 32'h0104_0000 - f.block_size * 4
                || f.q.size() >= 4)
                bad++;
            if (f.randomize() with { solve start_addr before block_size; block_size == 64; } == 0
                || f.block_size != 64)
                bad++;
            if (o.randomize() == 0 || o.y != o.h.m + 1) bad++;
            if (m.randomize() == 0 || m.y != m.x + 1 || m.z >= 8'h10 || m.x <= m.z
                || m.x >= 8'h80)
                bad++;
            if (m.randomize() with { solve this.y before x; this.y == 8'h20; } == 0
                || m.y != 8'h20 || m.x != 8'h1f)
                bad++;
            if (std::randomize(a, b) with { solve a before b; b == a + 1; a < 8'h10; } == 0
                || b != a + 1 || a >= 8'h10)
                bad++;
            if (sc.randomize() == 0 || sc.b != sc.a[0]) bad++;
        end
        $display("%0d", bad);
        done = bad == 0;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq bad 0) (assert_eq done 1)
  (expect_output "0\n"))

(case constrained_randomize_shifts
  (source "shifts.sv" #"
module Top(output int bad, output bit done);
    class Field;
        rand bit [63:0] value;
        int unsigned m_size;
        constraint valid { if (64 > m_size) { value < (64'h1 << m_size); } }
    endclass
    class Shifts;
        rand bit signed [7:0] s;
        rand bit [7:0] u, z, w, n;
        rand bit [63:0] m;
        rand bit [2:0] k;
        constraint c {
            s == (8'sh80 >>> 2);
            u == (8'h80 >> 3);
            z == (8'hff << 9);
            (8'h1 << k) == 8'h10;
            w == (8'h0f <<< 4);
            // A signed count shifts arithmetically in its own context.
            n == (8'h1 << (8'sh80 >>> 2));
            m == (64'h1 << (8'sh80 >>> 6));
        }
    endclass
    Field f;
    Shifts t;
    initial begin
        f = new;
        t = new;
        for (int size = 0; size <= 64; size += 4) begin
            f.m_size = size;
            for (int i = 0; i < 4; i++) begin
                if (f.randomize() == 0) bad++;
                if (size < 64 && f.value >= (64'h1 << size)) bad++;
            end
        end
        if (t.randomize() == 0 || t.s != -32 || t.u != 16 || t.z != 0 || t.k != 4 || t.w != 8'hf0
            || t.n != 0 || t.m != 0)
            bad++;
        $display("%0d", bad);
        done = bad == 0;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq bad 0) (assert_eq done 1)
  (expect_output "0\n"))

(case output_arguments_write_class_properties
  (source "outputs.sv" #"
interface clk_if; int n; endinterface
package p;
  class Db #(type T = int);
    static T saved;
    static function void set(T t); saved = t; endfunction
    static function bit read(inout T val); val = saved; return 1; endfunction
  endclass
endpackage
typedef struct packed { bit [3:0] hi; bit [3:0] lo; } pair_t;
class Holder;
  int x;
  byte b;
  bit [7:0] bits;
  pair_t pair;
  virtual clk_if v;
  Holder next;
  int q[$];
endclass
class Env;
  virtual clk_if m_if;
  function void connect();
    void'(p::Db#(virtual clk_if)::read(m_if));
  endfunction
endclass
module Top(output int bad, output bit done);
  clk_if i0();
  Holder h, other;
  Env e;
  function void f(output int o); o = 300; endfunction
  function void nib(output bit [3:0] o); o = 4'ha; endfunction
  function void one(output bit o); o = 1; endfunction
  function void inc(inout bit [3:0] io); io = io + 1; endfunction
  int mq[$] = '{0, 0, 0};
  int k;
  function void bump(output int o); k = 2; o = 7; endfunction
  function void g(inout int io); io = io + 1; endfunction
  function void getv(output virtual clk_if o); o = i0; endfunction
  function void geth(output Holder o); o = other; endfunction
  function void getq(output int o[$]); o = '{1, 2, 3}; endfunction
  function void retarget(output int o); h = other; o = 5; endfunction
  task t(output int o); #1 o = 9; endtask
  initial begin
    Holder first;
    h = new;
    other = new;
    f(h.x);
    if (h.x != 300) bad++;
    f(h.b);
    if (h.b != 44) bad++;
    g(h.x);
    if (h.x != 301) bad++;
    getv(h.v);
    h.v.n = 3;
    if (i0.n != 3) bad++;
    geth(h.next);
    if (h.next != other) bad++;
    getq(h.q);
    if (h.q.size() != 3 || h.q[2] != 3) bad++;
    // The actual is assigned when the call returns (13.5): the property of
    // the object the handle then refers to.
    first = h;
    retarget(h.x);
    if (first.x != 301 || other.x != 5) bad++;
    h = first;
    // Selects, members and elements are written as assignments write them.
    nib(h.bits[7:4]);
    one(h.bits[0]);
    if (h.bits != 8'ha1) bad++;
    nib(h.pair.lo);
    inc(h.pair.lo);
    if (h.pair != 8'h0b) bad++;
    f(h.q[1]);
    if (h.q[1] != 300 || h.q[0] != 1) bad++;
    // The index of an element is read when the call returns.
    k = 1;
    bump(mq[k]);
    if (mq[1] != 0 || mq[2] != 7) bad++;
    t(other.x);
    if (other.x != 9 || $time != 1) bad++;
    e = new;
    p::Db#(virtual clk_if)::set(i0);
    e.connect();
    e.m_if.n = 4;
    if (i0.n != 4) bad++;
    $display("%0d", bad);
    done = bad == 0;
  end
endmodule
"#)
  (top Top) (run_until 2) (assert_eq bad 0) (assert_eq done 1)
  (expect_output "0\n"))

(case virtual_interface_property_waits
  (source "waits.sv" #"
interface clk_if;
    logic clk = 0;
    logic other = 0;
endinterface
class Env;
    virtual clk_if m_if;
    int edges;
    task run();
        repeat (3) @(posedge m_if.clk);
        edges = 3;
    endtask
    task wait_on(virtual clk_if vif);
        @(posedge vif.clk or posedge vif.other);
    endtask
    task wait_local(virtual clk_if vif);
        virtual clk_if copy;
        copy = vif;
        @(posedge copy.clk);
    endtask
endclass
module Top(output int bad, output bit done);
    clk_if i0();
    clk_if i1();
    Env e;
    always #5 i0.clk = ~i0.clk;
    always #6 i1.clk = ~i1.clk;
    initial begin
        e = new;
        e.m_if = i0;
        // A class property: posedges of i0.clk at 5, 15, 25.
        e.run();
        if (e.edges != 3 || $time != 25) bad++;
        // An automatic local of a method: the next posedge of i1.clk at 30.
        e.wait_local(i1);
        if ($time != 30) bad++;
        // A task argument with two items: i0.clk at 35.
        e.wait_on(i0);
        if ($time != 35) bad++;
        $display("%0d", bad);
        done = bad == 0;
    end
endmodule
"#)
  (top Top) (run_until 100) (assert_eq bad 0) (assert_eq done 1)
  (expect_output "0\n"))

(case constrained_randomize_foreach
  (source "foreach.sv" #"
module Top(output int bad, output bit done);
    class Region;
        bit [63:0] Xstart_offsetX, Xend_offsetX;
        function new(bit [63:0] start, bit [63:0] last);
            Xstart_offsetX = start;
            Xend_offsetX = last;
        endfunction
    endclass
    class Policy;
        int unsigned len;
        rand bit [63:0] start_offset;
        bit [63:0] min_offset, max_offset;
        Region in_use[$];
        constraint valid {
            start_offset >= min_offset;
            start_offset <= max_offset - len + 1;
        }
        constraint no_overlap {
            foreach (in_use[i]) {
                !(start_offset <= in_use[i].Xend_offsetX &&
                  start_offset + len - 1 >= in_use[i].Xstart_offsetX);
            }
        }
    endclass
    class Values;
        rand bit [3:0] v, w;
        rand bit [4:0] u;
        int unsigned forbidden[$];
        bit [3:0] picks[];
        constraint c {
            v < 4;
            foreach (forbidden[i]) v != forbidden[i];
            foreach (picks[j]) (j == 1) -> w == picks[j];
            foreach (forbidden[i])
                foreach (picks[j])
                    (i == 2 && j == 2) -> u == forbidden[i] + picks[j];
        }
    endclass
    Policy p;
    Values x;
    Region r;
    initial begin
        p = new;
        p.len = 10;
        p.min_offset = 0;
        p.max_offset = 99;
        // Nothing in use: any start that fits.
        for (int i = 0; i < 5; i++)
            if (p.randomize() == 0 || p.start_offset > 90) bad++;
        r = new(0, 49);
        p.in_use.push_back(r);
        r = new(60, 99);
        p.in_use.push_back(r);
        for (int i = 0; i < 5; i++)
            if (p.randomize() == 0 || p.start_offset != 50) bad++;
        x = new;
        x.forbidden = '{0, 1, 3};
        x.picks = '{4'd7, 4'd9, 4'd11};
        for (int i = 0; i < 5; i++)
            if (x.randomize() == 0 || x.v != 2 || x.w != 9 || x.u != 14) bad++;
        $display("%0d", bad);
        done = bad == 0;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq bad 0) (assert_eq done 1)
  (expect_output "0\n"))

(case constrained_randomize_inline
  (source "inline_constraints.sv" #"
module Top(output bit done);
    class Packet;
        rand int x, y;
        int limit, pre_count, post_count;
        constraint c { x < 10; }
        function void pre_randomize(); limit=3; pre_count++; endfunction
        function void post_randomize(); post_count++; endfunction
    endclass
    Packet p;
    initial begin
        p = new;
        if (!(p.randomize() with { x inside {[1:limit]}; y == x + 1; }))
            $fatal(1, "inline success");
        if (p.x < 1 || p.x > 3 || p.y != p.x + 1) $fatal(1, "inline values");
        if (p.randomize() with { x == 12; }) $fatal(1, "lost class constraint");
        if (p.pre_count != 2 || p.post_count != 1) $fatal(1, "inline hooks");
        if (!(p.randomize() with { x == 7; if (x == 7) y == 8; })) $fatal(1, "inline leaked");
        if (!p.randomize(null)) $fatal(1, "ordinary check");
        if (p.randomize(null) with { x == 2; }) $fatal(1, "inline check");
        if (p.x != 7 || p.y != 8) $fatal(1, "check-only changed fields");
        if (!(p.randomize(x) with { x == y; })) $fatal(1, "inline selection");
        if (p.x != 8 || p.y != 8) $fatal(1, "unselected field changed");
        p.randomize() with { x == 4; y == 5; };
        if (p.x != 4 || p.y != 5) $fatal(1, "discarded call");
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1))

