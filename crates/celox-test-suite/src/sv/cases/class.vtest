(case constraint_mode_basic
  (source "constraint_mode_basic.sv" #"
module Top(output bit done);
    class C;
        rand bit [3:0] x;
        constraint low { x == 2; }
        constraint high { x == 9; }
        function void enable_low(); constraint_mode(0); low.constraint_mode(1); endfunction
    endclass
    C c, alias_c, other;
    initial begin
        c = new; other = new; alias_c = c;
        if (c.low.constraint_mode() != 1 || c.high.constraint_mode() != 1) $fatal(1, "initial modes");
        c.x = 7;
        if (c.randomize() || c.x != 7) $fatal(1, "initial contradiction");
        alias_c.high.constraint_mode(0);
        if ((c.high.constraint_mode() != 0) || (other.high.constraint_mode() == 0)) $fatal(1, "alias isolation");
        if (!c.randomize() || c.x != 2) $fatal(1, "disabled block");
        c.constraint_mode(0);
        if (!(c.randomize() with { x == 5; }) || c.x != 5) $fatal(1, "inline remains active");
        c.high.constraint_mode(1);
        if (c.randomize(null)) $fatal(1, "check only fails");
        if (!c.randomize() || c.x != 9 || !c.randomize(null)) $fatal(1, "check only succeeds");
        c.enable_low();
        if (!c.randomize() || c.x != 2) $fatal(1, "implicit receiver");
        c.low.constraint_mode(2);
        if (c.low.constraint_mode() != 0) $fatal(1, "bit conversion");
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1))

(case constraint_mode_inheritance
  (source "constraint_mode_inheritance.sv" #"
package pkg;
    class Base;
        rand bit [3:0] x, y;
        constraint first { x == 1; }
        constraint second { y == 3; }
        function void disable_first(); first.constraint_mode(0); endfunction
    endclass
endpackage
module Top(output bit done);
    class Derived extends pkg::Base;
        constraint first { x == 7; }
        constraint third { y == 5; }
    endclass
    Derived d;
    pkg::Base b;
    initial begin
        d = new; b = d;
        b.constraint_mode(0);
        if ((d.first.constraint_mode() != 0) || (d.second.constraint_mode() != 0) || (d.third.constraint_mode() != 0)) $fatal(1, "dynamic all");
        b.first.constraint_mode(1);
        d.third.constraint_mode(1);
        if ((d.first.constraint_mode() == 0) || (d.second.constraint_mode() != 0) || (d.third.constraint_mode() == 0)) $fatal(1, "override modes");
        // Package-base randomize dispatch is tracked separately in #1892.
        if (!d.randomize()) $fatal(1, "override solve");
        if (d.x != 7 || d.y != 5) $fatal(1, "override values x=%d y=%d", d.x, d.y);
        b.disable_first();
        if ((d.first.constraint_mode() != 0) || (d.third.constraint_mode() == 0)) $fatal(1, "inherited method");
        if (!(d.randomize() with { x == 2; }) || d.x != 2 || d.y != 5) $fatal(1, "disabled override");
        b.constraint_mode(1);
        if ((d.first.constraint_mode() == 0) || (d.second.constraint_mode() == 0) || (d.third.constraint_mode() == 0)) $fatal(1, "all enabled");
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1))

(case constraint_mode_hooks
  (source "constraint_mode_hooks.sv" #"
module Top(output bit done);
    class C;
        rand bit [3:0] x;
        bit disable_c;
        constraint c { x == 2; }
        function void pre_randomize(); c.constraint_mode(!disable_c); endfunction
    endclass
    C p;
    initial begin
        p = new; p.disable_c = 1;
        if (!(p.randomize(x) with { x == 7; }) || p.x != 7) $fatal(1, "pre-hook disable");
        if (p.c.constraint_mode() != 0) $fatal(1, "mode survives selected randomize");
        p.disable_c = 0;
        if (p.randomize(x) with { x == 7; }) $fatal(1, "pre-hook enable");
        if ((p.c.constraint_mode() == 0) || p.x != 7) $fatal(1, "failed solve mode");
        if (!p.randomize() || p.x != 2) $fatal(1, "subsequent solve");
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1))

(case constraint_mode_base_dispatch
  (source "constraint_mode_base_dispatch.sv" #"
module Top(output bit done);
    class Base;
        rand bit [3:0] x, y;
        constraint a { x == 1; }
        constraint b { y == 3; }
    endclass
    class Derived extends Base;
        constraint a { x == 7; }
        constraint c { y == 5; }
    endclass
    Base b;
    Derived d;
    initial begin
        d = new; b = d;
        b.b.constraint_mode(0);
        if (!b.randomize() || d.x != 7 || d.y != 5) $fatal(1, "dynamic override");
        b.a.constraint_mode(0);
        if (!(b.randomize() with { x == 2; }) || d.x != 2 || d.y != 5) $fatal(1, "inline dynamic modes");
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1))

(case constraint_mode_ordinary_struct_members
  (source "constraint_mode_struct.sv" #"
    module Top(input int data, output int direct_value, nested_value);
      struct packed { int constraint_mode; } direct_data;
      struct packed { struct packed { int constraint_mode; } child; } nested_data;
      always_comb begin
        direct_data.constraint_mode = data;
        nested_data.child.constraint_mode = data + 1;
        direct_value = direct_data.constraint_mode;
        nested_value = nested_data.child.constraint_mode;
      end
    endmodule
  "#)
  (top Top)
  (for value (list 0 37 255)
    (modify (set data value))
    (assert_eq direct_value value)
    (assert_eq nested_value (+ value 1))))

(case type_parameter_imports
  (source "type_parameter_imports.sv" #"
package p;
    class Item;
        static int value = 42;
        typedef bit [7:0] word_t;
    endclass
    class Unused #(type TYPE = Item);
        typedef TYPE::word_t element_t;
        static function int get(); return TYPE::value; endfunction
    endclass
endpackage
module Top(output bit done);
    class Local #(type TYPE = p::Item);
        extern static function int get();
    endclass
    function int Local::get(); return TYPE::value; endfunction
    initial done = Local#()::get() == 42;
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1))

(case type_parameter_shadowing
  (source "type_parameter_shadowing.sv" #"
package TYPE;
    parameter int value = 7;
endpackage
module Top(output bit [1:0] flags);
    class Item; static int value = 42; endclass
    class Local #(type TYPE = Item);
        static function int get(); return TYPE::value; endfunction
    endclass
    initial begin
        flags[0] = TYPE::value == 7;
        flags[1] = Local#()::get() == 42;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq flags 3))

(case type_alias_members
  (source "class.sv" #"
package p;
    class Item #(int N = 42);
        static int value = N;
        typedef bit [7:0] word_t;
        static function int read(); return value; endfunction
    endclass
    typedef Item#(23) Alias;
    class Reader;
        static function int read(); return Alias::read(); endfunction
    endclass
endpackage
module Top(output int sum, output bit done);
    import p::*;
    typedef Alias LocalAlias;
    class Word;
        typedef bit [7:0] word_t;
    endclass
    typedef Word WordAlias;
    WordAlias::word_t sample;
    initial begin
        sample = 8'hff;
        sum = Reader::read() + LocalAlias::value + sample;
        Alias::value = 24;
        done = Reader::read() == 24 && LocalAlias::value == 24;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq sum 301) (assert_eq done 1))

(case type_alias_lexical_scopes
  (source "class.sv" #"
package Alias;
    parameter int value = 7;
endpackage
module Top(output int sum, output bit done);
    class Item;
        static int value = 42;
    endclass
    class Reader;
        typedef Item Alias;
        extern static function int read();
    endclass
    function int Reader::read(); return Alias::value; endfunction
    initial begin
        sum = Reader::read() + Alias::value;
        done = sum == 49;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq sum 49) (assert_eq done 1))

(case imported_member_type_dimensions
  (source "classes.sv" #"
package p;
    class Box #(int N = 5);
        typedef bit [N-1:0] element_t;
    endclass
    typedef Box#() Small;
    typedef Box#(9) Wide;
endpackage
"#)
  (source "top.sv" #"
module Top(output int sum, output bit done);
    import p::*;
    localparam int N = 29;
    Small::element_t sample;
    Wide::element_t other;
    initial begin
        sample = '1;
        other = '1;
        sum = sample + other;
        done = $bits(sample) == 5 && $bits(other) == 9;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq sum 542) (assert_eq done 1))

(case imported_member_type_inheritance
  (source "classes.sv" #"
package p;
    class Base #(type T = byte);
        typedef T item_t;
    endclass
    class Derived #(int N = 9) extends Base#(bit [2:0]); endclass
    typedef Derived#() Tiny;
    typedef Base#(bit [6:0]) Other;
endpackage
"#)
  (source "exports.sv" #"
package q;
    import p::Tiny;
    import p::Other;
    export p::Tiny;
    export p::Other;
    class Sub extends Tiny;
        typedef bit [4:0] item_t;
        typedef item_t copied_t;
    endclass
endpackage
"#)
  (source "top.sv" #"
module Top(output int sum, output bit done);
    import q::*;
    Sub::copied_t a;
    Other::T b;
    Tiny::item_t c;
    initial begin
        a = '1;
        b = '1;
        c = '1;
        sum = a + b + c;
        done = $bits(a) == 5 && $bits(b) == 7 && $bits(c) == 3;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq sum 165) (assert_eq done 1))
(case package_constant_class_defaults
  (source "package.sv" #"
package p;
    parameter int WIDTH = 5;
    class Box #(int N = WIDTH, int M = N + 2);
        function int get(); return WIDTH + 10 * N + M; endfunction
    endclass
    typedef Box#() Small;
    typedef Box Implicit;
    typedef Box#(9) Wide;
    function automatic int read();
        Small defaulted = new();
        Implicit normal = new();
        Wide wide = new();
        return defaulted.get() + normal.get() + wide.get();
    endfunction
endpackage
"#)
  (source "top.sv" #"
module Top(output int sum);
    localparam int WIDTH = 29;
    initial sum = p::read();
endmodule
"#)
  (top Top) (run_until 0) (assert_eq sum 230))
(case package_constant_type_arguments
  (source "package.sv" #"
package p;
    parameter int W = 6;
    typedef bit signed [W-1:0] word_t;
    class Utils #(type T = int);
        static function int width();
            T v;
            return $bits(v);
        endfunction
        static function int negative();
            T v = '1;
            return v < 0;
        endfunction
    endclass
    typedef Utils#(word_t) word_utils;
    typedef Utils#(bit [W:0]) wide_utils;
    function automatic int read();
        return 100 * word_utils::width() + 10 * wide_utils::width()
            + 2 * word_utils::negative() + wide_utils::negative();
    endfunction
endpackage
"#)
  (source "top.sv" #"
module Top(output int sum);
    localparam int W = 29;
    initial sum = p::read();
endmodule
"#)
  (top Top) (run_until 0) (assert_eq sum 672))
