; Handles declared with a class-scoped typedef of a registry specialization,
; as `uvm_object_utils` declares `type_id`, call its methods: static
; `C::type_id::create()`, virtual ones through a base handle, and a method
; whose local has the registry's own class-scoped typedef (8.23, 8.25.1).
(case scoped_typedef_handles
 (source "scoped_typedef_handles.sv" #"
package p;
 virtual class Wrapper;
  pure virtual function string get_type_name();
 endclass
 typedef class Common;
 class Registry #(type T = int, string Tname = "<unknown>") extends Wrapper;
  typedef Registry #(T, Tname) this_type;
  typedef Common #(this_type, T, Tname) common_type;
  static this_type me;
  static function this_type get();
   if (me == null) me = new;
   return me;
  endfunction
  static function T create();
   T object = new;
   return object;
  endfunction
  virtual function string get_type_name();
   common_type common = common_type::get();
   return common.name();
  endfunction
 endclass
 class Common #(type Reg = int, type T = int, string Tname = "<unknown>");
  static Common #(Reg, T, Tname) inst;
  static function Common #(Reg, T, Tname) get();
   if (inst == null) inst = new;
   return inst;
  endfunction
  function string name();
   return Tname;
  endfunction
 endclass
 class PkgComp;
  int value = 3;
  typedef Registry #(PkgComp, "pkg") type_id;
 endclass
endpackage
import p::*;
class UnitComp;
 int value = 5;
 typedef Registry #(UnitComp, "unit") type_id;
endclass
module Top(output int sum, output int names);
 class LocalRegistry #(type T = int, string Tname = "<unknown>");
  typedef LocalRegistry #(T, Tname) this_type;
  static function T create();
   T object = new;
   return object;
  endfunction
  virtual function string get_type_name();
   this_type self = this;
   return Tname;
  endfunction
 endclass
 class LocalComp;
  int value = 7;
  typedef LocalRegistry #(LocalComp, "local") type_id;
 endclass
 initial begin
  automatic UnitComp::type_id u = new;
  automatic PkgComp::type_id k = new;
  automatic LocalComp::type_id l = new;
  automatic Wrapper w = k;
  automatic UnitComp uc = UnitComp::type_id::create();
  automatic PkgComp pc = PkgComp::type_id::create();
  automatic LocalComp lc = LocalComp::type_id::create();
  sum = uc.value + 10 * pc.value + 100 * lc.value;
  names = (u.get_type_name() == "unit") + 2 * (w.get_type_name() == "pkg")
   + 4 * (l.get_type_name() == "local")
   + 8 * (UnitComp::type_id::get() == UnitComp::type_id::get());
 end
endmodule"#)
 (top Top) (run_until 0) (assert_eq sum 735) (assert_eq names 15))

; The class scope of a typedef may itself be specialized or qualified,
; `C#(byte)::type_id` and `p::C::type_id` as the `uvm_resource_db` of UVM
; names its default implementation, also inside a specialization by the
; class parameter of the caller (8.23, 8.25.1).
(case specialized_scope_typedef_calls
 (source "specialized_scope_typedef_calls.sv" #"
package p;
 class Registry #(type T = int);
  static int count;
  static function T create();
   T object = new;
   count++;
   return object;
  endfunction
 endclass
 virtual class Base #(type T = int);
  pure virtual function int width();
 endclass
 class Impl #(type T = int) extends Base #(T);
  typedef Registry #(Impl #(T)) type_id;
  virtual function int width();
   return $bits(T);
  endfunction
 endclass
 class Db #(type T = int);
  static Base #(T) imp;
  static function void set_imp(Base #(T) i = null);
   if (i == null) i = Impl #(T)::type_id::create();
   imp = i;
  endfunction
 endclass
 class Obj;
  int value = 3;
  typedef Registry #(Obj) type_id;
 endclass
endpackage
module Top(output int sum);
 import p::*;
 initial begin
  automatic Impl #(byte) b = Impl #(byte)::type_id::create();
  automatic Base #(int) i = p::Impl #(int)::type_id::create();
  automatic Obj o = p::Obj::type_id::create();
  Db #(shortint)::set_imp();
  sum = b.width() + 100 * i.width() + 10000 * o.value
   + 100000 * Db #(shortint)::imp.width();
 end
endmodule"#)
 (top Top) (run_until 0) (assert_eq sum 1633208))

; Static properties are reached through the same scopes, each specialization
; with its own storage (8.25.1).
(case specialized_scope_typedef_properties
 (source "specialized_scope_typedef_properties.sv" #"
package p;
 class Registry #(type T = int);
  static int count;
  static function T create();
   T object = new;
   count++;
   return object;
  endfunction
 endclass
 virtual class Base #(type T = int);
  pure virtual function int width();
 endclass
 class Impl #(type T = int) extends Base #(T);
  typedef Registry #(Impl #(T)) type_id;
  virtual function int width();
   return $bits(T);
  endfunction
 endclass
 class Db #(type T = int);
  static Base #(T) imp;
  static function void set_imp(Base #(T) i = null);
   if (i == null) i = Impl #(T)::type_id::create();
   imp = i;
  endfunction
 endclass
 class Obj;
  int value = 3;
  typedef Registry #(Obj) type_id;
 endclass
endpackage
module Top(output int count);
 import p::*;
 initial begin
  automatic Impl #(byte) b = Impl #(byte)::type_id::create();
  automatic Obj o = p::Obj::type_id::create();
  Db #(shortint)::set_imp();
  count = Impl #(byte)::type_id::count + 10 * p::Obj::type_id::count
   + 100 * Impl #(shortint)::type_id::count + 1000 * Impl #(int)::type_id::count;
 end
endmodule"#)
 (top Top) (run_until 0) (assert_eq count 111))

; A string class parameter wider than 128 bits is passed on by name to the
; specializations its typedefs, property, return and local types name (8.25).
(case parameter_strings_wider_than_a_constant
 (source "parameter_strings_wider_than_a_constant.sv" #"
package p;
 class Named #(string S = "x");
  typedef Named #(S) this_type;
  static Named #(S) inst;
  static function Named #(S) get();
   if (inst == null) inst = new;
   return inst;
  endfunction
  function string name();
   this_type self = this;
   Named #(S) again = self;
   return S;
  endfunction
 endclass
 class Holder #(string S = "x");
  typedef Named #(S) named_t;
  function string name();
   named_t named = named_t::get();
   return named.name();
  endfunction
 endclass
endpackage
module Top(output int ok, output int len);
 import p::*;
 Holder #("a_name_longer_than_sixteen") holder = new;
 initial begin
  ok = holder.name() == "a_name_longer_than_sixteen";
  len = holder.name().len();
 end
endmodule"#)
 (top Top) (run_until 0) (assert_eq ok 1) (assert_eq len 26))

; `new` initializes subroutine locals whose class a package scope or a typedef
; names (8.7).
(case new_initializers_of_scoped_and_alias_types
 (source "new_initializers_of_scoped_and_alias_types.sv" #"
package items;
 class Item;
  int value = 4;
 endclass
 typedef Item item_t;
endpackage
typedef items::Item unit_item_t;
module Top(output int sum);
 function automatic int total();
  items::Item a = new;
  items::item_t b = new;
  unit_item_t c = new;
  a.value += 1;
  b.value += 2;
  return a.value + 10 * b.value + 100 * c.value;
 endfunction
 initial sum = total();
endmodule"#)
 (top Top) (run_until 0) (assert_eq sum 465))

; A class parameter without an integral value hides the module's constant of
; its name, and the class passes its value on by name (8.25).
(case parameter_literals_hide_module_constants
 (source "parameter_literals_hide_module_constants.sv" #"
module Top(output int ok);
 localparam string S = "module";
 class Name #(string S = "x"); function string s(); return S; endfunction endclass
 class Shadow #(string S = "x");
  function string s();
   Name #(S) name = new;
   return name.s();
  endfunction
 endclass
 Shadow #("a_name_longer_than_sixteen") shadow = new;
 initial ok = shadow.s() == "a_name_longer_than_sixteen";
endmodule"#)
 (top Top) (run_until 0) (assert_eq ok 1))

; A static variable's initializer runs once, before any procedure starts,
; and may call constructors and functions (6.8, 6.21): static locals of
; functions, methods and tasks, static properties and package variables.
; Their order is not specified, so no initializer reads another's variable.
(case static_initializers_run_once_before_time_zero
 (source "static_initializers_run_once_before_time_zero.sv" #"
package q;
 class Counter;
  int v;
  function new(int v = 0); this.v = v; endfunction
 endclass
 class Pool;
  static Counter shared = new(5);
  static function Counter printer();
   static Counter p = new();
   p.v++;
   return p;
  endfunction
 endclass
 function automatic int seed(); Counter c = new(5); return c.v + 1; endfunction
 int seeded = seed();
endpackage
module Top(output int a, output int b, output int c, output int d, output int e);
 int m = 20;
 function int f();
  static int k = m;
  k++;
  return k;
 endfunction
 class Item;
  function int bump();
   static q::Counter c = new(30);
   c.v++;
   return c.v;
  endfunction
 endclass
 task t(output int r);
  static q::Counter c = new(40);
  #1 c.v++;
  r = c.v;
 endtask
 initial begin
  automatic Item x = new;
  automatic Item y = new;
  q::Counter h;
  int r;
  h = q::Pool::printer();
  h = q::Pool::printer();
  a = h.v + 10 * q::Pool::shared.v;
  b = q::seeded;
  void'(f());
  c = f();
  void'(x.bump());
  d = y.bump();
  t(r);
  t(e);
 end
endmodule"#)
 (top Top) (run_until 3) (assert_eq a 52) (assert_eq b 6) (assert_eq c 22) (assert_eq d 32) (assert_eq e 42))

; IEEE 1800-2023 13.5.3: a default argument is evaluated in the scope of the
; method at each call that uses it, so it may call non-static methods,
; virtual ones through the object's class, and read non-static properties of
; the object the method is called on.
(case method_defaults_use_the_object
 (source "top.sv" #"
class Event #(type T = int);
 int count;
 virtual function T get_default_data(); return T'(count + 100); endfunction
 virtual function int trigger(T data = get_default_data(), int n = count);
  count++;
  return data + n;
 endfunction
 function int self_call(); return trigger(); endfunction
 bit [7:0] bits;
 int idx;
 function int pick(int x = bits[idx +: 4]); return x; endfunction
 task wait_and_add(output int r, input int k = get_default_data());
  #1 r = k;
 endtask
endclass
class Sub extends Event #(int);
 virtual function int get_default_data(); return 7; endfunction
endclass
class Pair;
 int n;
 static int i;
 function int bump(); i++; return 0; endfunction
 function int f(int x = bump(), int y = n); return x + y; endfunction
endclass
module Top(output int a, output int b, output int c, output int d, output int e, output int f, output int g, output int h, output int m1, output int m3);
 Event #(int) ev;
 Sub s;
 Event #(int) arr[2];
 Pair ps[2];
 int made;
 function automatic Pair make(); made++; return ps[1]; endfunction
 initial begin
  ev = new;
  s = new;
  arr[1] = s;
  a = ev.trigger();
  b = ev.trigger(5);
  c = s.trigger();
  d = arr[1].trigger();
  e = ev.self_call();
  ev.bits = 8'ha5;
  ev.idx = 4;
  s.bits = 8'h3c;
  s.idx = 2;
  g = ev.pick();
  h = arr[1].pick();
  // The method and its defaults use the object the call evaluated once,
  // also when a default changes what the receiver expression reads.
  ps[0] = new;
  ps[0].n = 1;
  ps[1] = new;
  ps[1].n = 2;
  m1 = ps[Pair::i].f();
  m3 = make().f() + made * 100;
  ev.wait_and_add(f);
 end
endmodule"#)
 (top Top) (run_until 2) (assert_eq a 100) (assert_eq b 6) (assert_eq c 7) (assert_eq d 8) (assert_eq e 104) (assert_eq f 103) (assert_eq g 10) (assert_eq h 15) (assert_eq m1 1) (assert_eq m3 102))

(case methods_called_without_parentheses
  (source "class.sv" #"
module Top(output int id, output int twice, output int added, output int peer_id,
           output int count, output bit named, output bit colored);
    typedef enum {RED, GREEN} color_t;
    class Node;
        static int made;
        int id;
        Node peer;
        function new(int id); this.id = id; made++; endfunction
        function int get_id(); return id; endfunction
        function int twice_id(); return this.get_id * 2; endfunction
        function int add(int k = 2); return id + k; endfunction
        function Node get_peer(); return peer; endfunction
        function string get_name(); return "node"; endfunction
        function color_t color(); return GREEN; endfunction
        static function int count(); return made; endfunction
    endclass
    Node n;
    initial begin
        n = new(4);
        n.peer = new(9);
        // The empty parentheses of a call may be omitted (13.5.5).
        id = n.get_id;
        twice = n.twice_id;
        added = n.add;
        peer_id = n.get_peer.get_id;
        count = Node::count;
        named = n.get_name == "node";
        colored = n.color == GREEN;
    end
endmodule
"#)
  (top Top) (run_until 0)
  (assert_eq id 4) (assert_eq twice 8) (assert_eq added 6) (assert_eq peer_id 9)
  (assert_eq count 2) (assert_eq named 1) (assert_eq colored 1))

(case prototype_formals_inherit_types
  (source "class.sv" #"
module Top(output int config_bits, output int summed, output bit indexed);
    typedef bit [3:0] nibble_t;
    virtual class Adder;
        // `b` has no type of its own: it is a formal of type int, as is
        // `y` of nibble_t (IEEE 1800-2023 13.4).
        pure virtual function int add(int a, b);
        pure virtual function int widen(nibble_t x, y);
    endclass
    class Root extends Adder;
        string nm;
        function new(string nm); this.nm = nm; endfunction
        virtual function string get_name(); return nm; endfunction
        extern function int m_process_config(string cfg, bit is_int, is_bitstream);
        virtual function int add(int a, b); return a + b; endfunction
        virtual function int widen(nibble_t x, y); return {x, y}; endfunction
    endclass
    function int Root::m_process_config(string cfg, bit is_int, is_bitstream);
        return cfg.len() * 4 + is_int * 2 + is_bitstream;
    endfunction
    Root children[string];
    Root r;
    Adder a;
    initial begin
        r = new("x");
        children[r.get_name()] = r;
        indexed = children.exists("x");
        config_bits = r.m_process_config("ab", .is_bitstream(1), .is_int(0));
        a = r;
        summed = a.add(2, 3) + a.widen(4'h1, 4'h2);
    end
endmodule
"#)
  (top Top) (run_until 0)
  (assert_eq config_bits 9) (assert_eq summed 23) (assert_eq indexed 1))

; A real value assigned to an integral property rounds to the nearest integer,
; away from zero at a tie (IEEE 1800-2023 6.12.1).
(case real_values_round_into_integral_properties
  (source "class.sv" #"
module Top(output int k, output int n, output longint t, output int f, output logic [7:0] l);
    class C;
        int k = 2.6;
        int n;
        time t = 3.5;
        int f;
        logic [7:0] l = 4.5;
        function real half(real x); return x / 2; endfunction
        function new();
            n = -2.5;
            f = half(7.0);
        endfunction
    endclass
    C o;
    initial begin
        o = new;
        k = o.k; n = o.n; t = o.t; f = o.f; l = o.l;
    end
endmodule
"#)
  (top Top) (run_until 0)
  (assert_eq k 3) (assert_eq n (trunc 32 -3)) (assert_eq t 4) (assert_eq f 4) (assert_eq l 5))

; A real or shortreal property holds a real value (IEEE 1800-2023 6.12): an
; integral value assigned to it converts to real, and it converts by rounding
; when assigned to an integral variable (6.12.1).
(case real_properties
  (source "class.sv" #"
module Top(output logic [63:0] initial_r, output logic [63:0] initial_s, output logic [63:0] sum,
           output logic [63:0] doubled, output logic [63:0] chained, output logic [63:0] copied,
           output int rounded, output bit greater, output logic [63:0] incremented_from,
           output logic [63:0] incremented, output logic [63:0] widened);
    class T;
        real r = 1.5;
        shortreal s = 0.25;
        int i;
        T peer;
        function real twice(); return r * 2; endfunction
        function void set(real v); r = v; endfunction
    endclass
    function longint big(); return 64'h100000000; endfunction
    T t, u;
    initial begin
        t = new;
        initial_r = $realtobits(t.r);
        initial_s = $realtobits(t.s * 1.0);
        t.r = 3;
        t.r += 0.25;
        t.s = t.r / 2;
        sum = $realtobits(t.r + t.s);
        t.i = t.r;
        rounded = t.i;
        greater = t.r > 3.0;
        t.set(-1.75);
        doubled = $realtobits(t.twice());
        t.peer = new;
        t.peer.r = t.r * 2;
        chained = $realtobits(t.peer.r);
        u = new t;
        copied = $realtobits(u.r);
        // A postincrement reads the real value it replaces (11.4.2).
        u.r = 1.5;
        incremented_from = $realtobits(u.r++);
        incremented = $realtobits(u.r);
        // An integral value converts at its own width (6.12.1).
        u.s = big();
        widened = $realtobits(u.s * 1.0);
    end
endmodule
"#)
  (top Top) (run_until 0)
  (assert_eq initial_r 0x3ff8000000000000)
  (assert_eq initial_s 0x3fd0000000000000)
  (assert_eq sum 0x4013800000000000)
  (assert_eq rounded 3)
  (assert_eq greater 1)
  (assert_eq doubled 0xc00c000000000000)
  (assert_eq chained 0xc00c000000000000)
  (assert_eq copied 0xbffc000000000000)
  (assert_eq incremented_from 0x3ff8000000000000)
  (assert_eq incremented 0x4004000000000000)
  (assert_eq widened 0x41f0000000000000))

; A random enumeration takes only the values of its type (IEEE 1800-2023
; 18.3), and a randc property draws each value its constraints allow once
; per cycle (18.4.2).
(case constrained_enumerations_and_randc
  (source "class.sv" #"
module Top(output int legal, output int implied, output bit both_kinds, output int cycle_ok,
           output int selected, output int mixed_cycle, output int independent,
           output int kept);
    typedef enum {READ, WRITE} kind_e;
    typedef enum bit [3:0] {A = 4'd1, B = 4'd4, C = 4'd9} gap_e;
    class Item;
        rand kind_e kind;
        rand gap_e g;
        rand bit [7:0] addr;
        constraint c { kind == WRITE -> addr > 5; g != C; }
    endclass
    class Cyc;
        randc bit [2:0] id;
        rand bit [3:0] other;
        constraint c { id < 6; other == id; }
    endclass
    typedef enum bit [3:0] {P = 4'd4, Q = 4'd9} sparse_e;
    // Selecting a property makes it random, with the values of its type.
    class Sel;
        gap_e e;
        constraint c { e == 5; }
    endclass
    class Sparse;
        randc sparse_e z;
    endclass
    // Each randc property restarts its own cycle once its legal values are
    // exhausted: a's after two draws, b's after three.
    class Two;
        randc bit [1:0] a, b;
        constraint c { a < 2; b < 3; }
    endclass
    Two two;
    bit [3:0] seen_b;
    // A call that fails leaves the cycle unfinished (18.4.2, 18.6.3).
    class One;
        randc bit k;
    endclass
    One one;
    bit drawn;
    Item it;
    Cyc cy;
    Sel sel;
    Sparse sp;
    sparse_e first, second;
    int seen_read, seen_write, ok;
    bit [7:0] mask;
    initial begin
        it = new;
        legal = 1; implied = 1;
        repeat (40) begin
            ok = it.randomize();
            if (!ok) legal = 0;
            if (!(it.g inside {A, B})) legal = 0;
            if (!(it.kind inside {READ, WRITE})) legal = 0;
            if (it.kind == WRITE && it.addr <= 5) implied = 0;
            if (it.kind == READ) seen_read++; else seen_write++;
        end
        cy = new;
        cycle_ok = 1;
        repeat (3) begin
            mask = 0;
            repeat (6) begin
                ok = cy.randomize();
                if (!ok || cy.id >= 6 || mask[cy.id] || cy.other != cy.id) cycle_ok = 0;
                mask[cy.id] = 1;
            end
            if (mask != 8'h3f) cycle_ok = 0;
        end
        both_kinds = seen_read > 0 && seen_write > 0;
        sel = new;
        selected = sel.randomize(e) == 0 && sel.e == 0;
        // Calls with and without an inline constraint share one cycle.
        sp = new;
        mixed_cycle = 1;
        repeat (4) begin
            void'(sp.randomize());
            first = sp.z;
            void'(sp.randomize() with { 1; });
            second = sp.z;
            if (first == second || !(first inside {P, Q}) || !(second inside {P, Q}))
                mixed_cycle = 0;
        end
        two = new;
        independent = 1;
        repeat (4) begin
            seen_b = 0;
            repeat (3) begin
                if (!two.randomize() || two.a >= 2 || two.b >= 3 || seen_b[two.b]) independent = 0;
                seen_b[two.b] = 1;
            end
        end
        one = new;
        kept = 1;
        repeat (4) begin
            void'(one.randomize());
            drawn = one.k;
            if (one.randomize() with { 0; }) kept = 0;
            void'(one.randomize());
            if (one.k == drawn) kept = 0;
        end
    end
endmodule
"#)
  (top Top) (run_until 0)
  (assert_eq legal 1) (assert_eq implied 1) (assert_eq both_kinds 1) (assert_eq cycle_ok 1)
  (assert_eq selected 1) (assert_eq mixed_cycle 1) (assert_eq independent 1) (assert_eq kept 1))

(case nested_value_selects
  (source "class.sv" #"
module Top(output bit [3:0] by_property, output bit [7:0] written, output bit [7:0] element,
           output bit [3:0] by_element, output bit [7:0] copied);
    class Info;
        bit [15:0] bits = 16'h1234;
        bit [7:0] low = 8'h02;
    endclass
    Info info, other;
    bit [7:0] q[$];
    initial begin
        info = new;
        other = new;
        q.push_back(8'h01);
        q.push_back(8'h00);
        // A select of a class property in the index of another select, of
        // a property or of a container element, is bound on its own (IEEE
        // 1800-2023 11.5.1).
        by_property = info.bits[4*other.low[1:0]+:4];
        info.bits[4*other.low[0]+:4] = 4'hf;
        written = info.bits[7:0];
        q[info.low[0]][7:4] = other.bits[3:0];
        element = q[0];
        // A select of a container element in the index of a select of a
        // property, and on both sides of an assignment.
        by_element = info.bits[4*q[0][1:0]+:4];
        q[1][3:0] = q[0][3:0];
        copied = q[1];
    end
endmodule
"#)
  (top Top) (run_until 0)
  (assert_eq by_property 2) (assert_eq written 0x3f) (assert_eq element 0x41)
  (assert_eq by_element 3) (assert_eq copied 1))

(case property_assignment_sites
  (source "class.sv" #"
module Top(output bit [7:0] bits, output bit [7:0] chosen);
    typedef struct packed { bit [3:0] x; bit [3:0] y; } pair_t;
    class Info;
        bit [7:0] bits;
        pair_t pair;
    endclass
    Info info;
    bit pick = 1;
    initial begin
        info = new;
        // A property and a select of one are targets of every assignment:
        // assignment operators, increments, and assignments whose value
        // takes the target's type (IEEE 1800-2023 10.9, 11.4.2).
        info.bits[3:0] = 4'h1;
        info.bits[3:0] += 4'h2;
        info.bits[7:4]++;
        bits = info.bits;
        info.pair = pick ? '{x: 4'h1, y: 4'h2} : '{x: 4'h3, y: 4'h4};
        chosen = info.pair;
    end
endmodule
"#)
  (top Top) (run_until 0)
  (assert_eq bits 0x13) (assert_eq chosen 0x12))

(case property_place_addresses
  (source "class.sv" #"
module Top(output bit [7:0] kept, output bit [7:0] rebound, output bit [7:0] swapped,
           output bit [15:0] split, output bit [7:0] first, output bit [7:0] second,
           output bit [15:0] streamed, output bit [15:0] extended);
    class Info;
        bit [7:0] bits;
        bit [7:0] a;
        bit [7:0] b;
        bit [7:0] q[$];
    endclass
    Info info;
    Info other;
    Info saved;
    logic signed [7:0] minus_one = -8'sd1;
    bit [7:0] bytes[$];
    function automatic bit [3:0] rebind();
        info = other;
        return 4'hb;
    endfunction
    initial begin
        info = new;
        other = new;
        // An assignment evaluates its value, and then the target with the
        // values it has when it is written (IEEE 1800-2023 4.9.3).
        info.bits = 8'h35;
        saved = info;
        other.bits = 8'h0a;
        info.bits[7:4] = rebind();
        kept = saved.bits;
        rebound = other.bits;
        info = saved;
        // The parts of a concatenation are written in order, each with
        // its bits of the value (10.10.1).
        info.bits = 8'h12;
        {info.bits[3:0], info.bits[7:4]} = info.bits;
        swapped = info.bits;
        {info.a, info.b} = 16'h1234;
        split = {info.a, info.b};
        // A streaming concatenation of container elements unpacks into
        // each, and a signed value is extended as its signedness gives
        // (11.4.14, 10.7).
        bytes = '{8'h00, 8'h00};
        {>>{bytes[0], bytes[1]}} = 16'h5678;
        streamed = {bytes[0], bytes[1]};
        {info.a, info.b} = minus_one;
        extended = {info.a, info.b};
        // So does an assignment to an element.
        info.q.push_back(8'h10);
        other.q.push_back(8'h20);
        info.q[0][7:4] = rebind();
        first = saved.q[0];
        second = other.q[0];
    end
endmodule
"#)
  (top Top) (run_until 0)
  (assert_eq kept 0x35) (assert_eq rebound 0xba) (assert_eq swapped 0x21)
  (assert_eq split 0x1234) (assert_eq first 0x10) (assert_eq second 0xb0)
  (assert_eq streamed 0x5678) (assert_eq extended 0xffff))

(case formatting_task_place_outputs
  (source "class.sv" #"
module Top(output bit [15:0] bits, output bit [7:0] whole, output bit [7:0] element);
    class Info;
        bit [15:0] bits;
        bit [7:0] whole;
    endclass
    Info info;
    bit [7:0] q[$];
    initial begin
        info = new;
        info.bits = 16'hffff;
        q = '{8'h00};
        // The output of `$sformat` or `$swrite` takes the string as an
        // assignment to it does, a select of a class property or a
        // container element as well (IEEE 1800-2023 21.3.3).
        $sformat(info.bits[7:0], "%s", "A");
        $swrite(info.whole, "%0d", 7);
        $swrite(q[0], "B");
        bits = info.bits;
        whole = info.whole;
        element = q[0];
    end
endmodule
"#)
  (top Top) (run_until 0)
  (assert_eq bits 0xff41) (assert_eq whole 0x37) (assert_eq element 0x42))

(case property_member_place_addresses
  (source "class.sv" #"
module Top(output bit [7:0] variable_bits, output bit [7:0] property_bits,
           output bit [7:0] aliased, output bit [7:0] swapped, output bit [15:0] nibbles,
           output bit [15:0] property_nibbles);
    typedef struct packed { bit [7:0] data; } word_t;
    typedef struct packed { logic [3:0][3:0] data; } nibbles_t;
    typedef struct packed { bit [3:0] x; bit [3:0] y; } pair_t;
    class Info;
        word_t word;
        pair_t pair;
        nibbles_t n;
    endclass
    Info info;
    word_t word;
    nibbles_t n;
    initial begin
        info = new;
        // A pattern assigned to a select of a member has the select's type
        // (IEEE 1800-2023 10.9, 11.5.1).
        word.data = 8'hff;
        word.data[3:0] = '{1'b1, 1'b0, 1'b1, 1'b0};
        variable_bits = word.data;
        info.word.data = 8'hff;
        info.word.data[3:0] = '{1'b1, 1'b0, 1'b1, 1'b0};
        property_bits = info.word.data;
        // A part-select of a member keeps the dimensions after it, so its
        // pattern has two four-bit items (7.4.6, 10.9).
        n.data = 16'h0000;
        n.data[1:0] = '{4'ha, 4'hb};
        nibbles = n.data;
        info.n.data = 16'h0000;
        info.n.data[2:1] = '{4'hc, 4'hd};
        property_nibbles = info.n.data;
        // A member written from another member of the same property, and
        // two members swapped through a concatenation (10.10.1).
        info.pair = 8'h12;
        info.pair.x = info.pair.y;
        aliased = info.pair;
        info.pair = 8'h12;
        {info.pair.x, info.pair.y} = {info.pair.y, info.pair.x};
        swapped = info.pair;
    end
endmodule
"#)
  (top Top) (run_until 0)
  (assert_eq variable_bits 0xfa) (assert_eq property_bits 0xfa)
  (assert_eq aliased 0x22) (assert_eq swapped 0x21) (assert_eq nibbles 0x00ab)
  (assert_eq property_nibbles 0x0cd0))

(case packed_structure_property_members
  (source "class.sv" #"
module Top(output int stride, output int twice, output bit [15:0] low, output bit [7:0] high,
           output bit [7:0] inner, output bit indexed);
    typedef struct packed { bit [15:0] min; bit [15:0] max; int unsigned stride; } range_t;
    typedef struct packed { bit [3:0] x; bit [3:0] y; } inner_t;
    typedef struct packed { inner_t inner; bit [7:0] z; } record_t;
    class Info;
        range_t mem_range;
        record_t record;
        bit [15:0] bits = 16'h12;
        // A member of a packed structure property is a select of its bits
        // (IEEE 1800-2023 7.2.1), read and written inside a method...
        function new(); mem_range.stride = 4; mem_range.min[7:0] = 8'h12; endfunction
        function int twice_stride(); return mem_range.stride * 2; endfunction
    endclass
    Info info, other;
    initial begin
        info = new;
        other = new;
        // ...and through a handle.
        info.mem_range.max = 16'h0304;
        info.mem_range.stride += 1;
        stride = info.mem_range.stride;
        twice = info.twice_stride();
        low = info.mem_range.min;
        high = info.mem_range.max[15:8];
        info.record.inner = '{x: 4'h1, y: 4'h2};
        inner = info.record.inner;
        // Bit 4 of 16'h12, selected by the stride of another object.
        indexed = info.bits[other.mem_range.stride];
    end
endmodule
"#)
  (top Top) (run_until 0)
  (assert_eq stride 5) (assert_eq twice 10) (assert_eq low 18) (assert_eq high 3)
  (assert_eq inner 0x12) (assert_eq indexed 1))

(case tagged_members_of_structure_properties
  (source "class.sv" #"
module Top(output bit [7:0] full, output bit [7:0] written, output bit [3:0] n);
    typedef union tagged packed { void Empty; bit [7:0] Full; } item_t;
    typedef struct packed { item_t item; bit [3:0] n; } record_t;
    class Info; record_t record; endclass
    Info info;
    record_t value;
    initial begin
        info = new;
        value.item = tagged Full 8'h12;
        value.n = 4'h5;
        info.record = value;
        // A member of the active member of a tagged union in a packed
        // structure property is read and written (IEEE 1800-2023 7.3.2).
        full = info.record.item.Full;
        info.record.item.Full = 8'h34;
        written = info.record.item.Full;
        n = info.record.n;
    end
endmodule
"#)
  (top Top) (run_until 0)
  (assert_eq full 0x12) (assert_eq written 0x34) (assert_eq n 5))

(case property_member_assignment_sites
  (source "class.sv" #"
module Top(output bit [7:0] chosen, output bit [7:0] record);
    typedef struct packed { bit [3:0] x; bit [3:0] y; } pair_t;
    typedef struct packed { pair_t inner; bit [7:0] z; } record_t;
    class Info;
        pair_t pair;
        record_t rec;
    endclass
    Info info;
    bit pick = 0;
    initial begin
        info = new;
        info.pair.x = 4'h4;
        // An assignment pattern in either branch of a conditional assigned
        // to a member of a property takes the member's type (IEEE
        // 1800-2023 10.9).
        info.rec.inner = pick ? '{x: 4'h1, y: 4'h2} : '{x: 4'h3, y: 4'h4};
        info.pair.y = 4'h7;
        chosen = info.pair;
        record = info.rec.inner;
    end
endmodule
"#)
  (top Top) (run_until 0)
  (assert_eq chosen 0x47) (assert_eq record 0x34))

; IEEE 1800-2023 18.5.1: a package scope in an external constraint name
; selects that package's class when two packages declare one of the same
; name, in either declaration order.
(case external_constraints_in_packages
  (source "external_constraints_in_packages.sv" #"
package PB;
  class C;
    rand int x;
    constraint range;
  endclass
endpackage
package PA;
  class C;
    rand int x;
    constraint range;
  endclass
endpackage
constraint PB::C::range { x < 10; }
constraint PA::C::range { x > 100; }
module Top(output bit ok);
  initial begin
    PA::C a = new();
    PB::C b = new();
    ok = 1;
    repeat (20) begin
      if (a.randomize() != 1 || a.x <= 100) ok = 0;
      if (b.randomize() != 1 || b.x >= 10) ok = 0;
    end
  end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq ok 1))

(case external_constraints
  (source "external_constraints.sv" #"
class C;
  rand int x;
  extern constraint pos;
  constraint little;
endclass
constraint C::pos { x >= 0; }
constraint C::little { x < 10; }
module Top(output bit ok);
  initial begin
    C c = new();
    ok = 1;
    repeat (20) begin
      if (c.randomize() != 1) ok = 0;
      if (c.x < 0 || c.x >= 10) ok = 0;
    end
  end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq ok 1))

; Soft constraints (IEEE 1800-2023 18.5.13): the solver keeps each one the
; hard constraints and the soft ones of higher priority allow, from the
; highest priority down, and treats the others as true. A later constraint
; of a block, one of a later block by its prototype, one of a derived class
; and an inline one are above the others (18.5.13.1); `disable soft`
; discards the lower soft constraints that name its variable (18.5.13.2); a
; guard makes a soft constraint conditional.
(case soft_constraints
  (source "soft.sv" #"
module Top(output int checks);
    class A;
        rand int b;
        constraint c1 { soft b > 4; soft b < 12; }
    endclass
    class B extends A;
        constraint c2 { soft b == 20; }
    endclass
    class C extends A;
        constraint c2 { soft b == 20; }
        constraint c3;
    endclass
    constraint C::c3 { soft b > 100; }
    class D;
        rand int b;
        constraint c1 { soft b > 4; soft b < 12; }
        constraint c2 { disable soft b; }
        constraint c3 { soft b == 20; }
    endclass
    class E;
        rand int b;
        constraint h { b inside {[1:3]}; }
        constraint s { soft b == 7; }
    endclass
    class F;
        rand bit p;
        rand int q;
        constraint c { p == 1; p -> soft q == 5; if (!p) soft q == 6; }
    endclass
    class G;
        rand int b;
        constraint s1 { soft b == 3; }
        constraint s2 { soft b == 4; }
    endclass
    initial begin
        A a = new;
        B b = new;
        C c = new;
        D d = new;
        E e = new;
        F f = new;
        G g = new;
        checks = 0;
        checks += (a.randomize() && a.b > 4 && a.b < 12) * 1;
        checks += (b.randomize() && b.b == 20) * 2;
        checks += (c.randomize() && c.b > 100) * 4;
        checks += (c.randomize() with { soft b == 90; } && c.b == 90) * 8;
        checks += (d.randomize() && d.b == 20) * 16;
        checks += (e.randomize() && e.b >= 1 && e.b <= 3) * 32;
        checks += (f.randomize() && f.p == 1 && f.q == 5) * 64;
        checks += (g.randomize() && g.b == 4) * 128;
        b.c2.constraint_mode(0);
        checks += (b.randomize() && b.b > 4 && b.b < 12) * 256;
        checks += (c.randomize() with { b < 0; } && c.b < 0) * 512;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq checks 1023))
; The priorities of soft constraints follow the whole chain of classes,
; also through a base class of a package (IEEE 1800-2023 18.5.13.1), and a
; guarded `disable soft` discards while its guard holds (18.5.13.2).
(case soft_constraint_classes_and_guarded_disables
  (source "soft_more.sv" #"
package P;
    class A;
        rand int b;
        constraint a1 { soft b == 1; }
    endclass
endpackage
module Top(output int checks);
    class B extends P::A;
        constraint p0 { b >= 0; }
        constraint p1 { b < 100; }
        constraint x1 { soft b == 2; }
    endclass
    class C extends B;
        constraint y { soft b == 3; }
    endclass
    class G;
        rand int x;
        bit off;
        constraint range { x inside {3, 4}; }
        constraint c1 { soft x == 3; }
        constraint c2 { if (off) disable soft x; }
    endclass
    initial begin
        C c = new;
        G g = new;
        int fours;
        checks = 0;
        checks += (c.randomize() && c.b == 3) * 1;
        fours = 0;
        repeat (16) if (g.randomize() && g.x == 4) fours++;
        checks += (fours == 0) * 2;
        g.off = 1;
        fours = 0;
        repeat (32) if (g.randomize() && g.x == 4) fours++;
        checks += (fours > 0) * 4;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq checks 7))

; `disable soft h.x` discards the soft constraints on the random variable
; of the object a rand handle refers to (18.5.13.2).
(case soft_constraints_disabled_through_rand_handles
  (source "soft_handles.sv" #"
module Top(output int checks);
    class Child;
        rand bit [7:0] x;
        constraint c { soft x == 1; }
    endclass
    class Kept;
        rand Child h;
        function new(); h = new; endfunction
    endclass
    class Dropped;
        rand Child h;
        constraint d { disable soft h.x; }
        function new(); h = new; endfunction
    endclass
    initial begin
        Kept k = new;
        Dropped d = new;
        int others;
        checks = 0;
        others = 0;
        repeat (16) if (!k.randomize() || k.h.x != 1) others++;
        checks += (others == 0) * 1;
        others = 0;
        repeat (16) if (d.randomize() && d.h.x != 1) others++;
        checks += (others > 0) * 2;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq checks 3))

; A guard compares class handles, such as with `null`, by their values when
; the call starts (IEEE 1800-2023 18.5.13), also a static handle; a rand
; handle is not changed.
(case constraint_handle_guards
  (source "guards.sv" #"
module Top(output int checks);
    class Node;
        int d;
    endclass
    class A;
        rand int b;
        Node next, other;
        constraint c1 { if (next == null) b == 5; else b == 6; }
        constraint c2 { (next != other) -> b > 0; }
    endclass
    class S;
        rand int b;
        static Node head;
        Node mine;
        constraint c { if (head == null) b == 1; else if (head == mine) b == 2; else b == 3; }
    endclass
    initial begin
        A a = new;
        S s = new;
        checks = 0;
        checks += (a.randomize() && a.b == 5) * 1;
        a.next = new;
        checks += (a.randomize() && a.b == 6) * 2;
        a.other = a.next;
        checks += (a.randomize() && a.b == 6 && a.next != null) * 4;
        checks += (a.randomize() with { null === next -> b == 7; } && a.b == 6) * 8;
        checks += (s.randomize() && s.b == 1) * 16;
        S::head = new;
        checks += (s.randomize() && s.b == 3) * 32;
        s.mine = S::head;
        checks += (s.randomize() && s.b == 2) * 64;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq checks 127))

; A static constraint block has one constraint mode for every object of the
; class that declares it, which constraint_mode through any of them sets and
; reads, by the object's class, also for an object a rand handle reaches
; (IEEE 1800-2023 18.5.11); a block a derived class overrides is the derived
; class's. constraint_mode() is an int.
(case static_constraint_blocks
  (source "static_blocks.sv" #"
module Top(output int checks);
    class A;
        rand int b;
        static constraint c1 { b == 5; }
        static constraint c2 { b >= 2; b <= 3; }
        constraint c3 { b != 3; }
    endclass
    class B extends A;
        constraint c1 { b > 0; }
    endclass
    class C;
        rand int x;
        extern static constraint c;
        constraint d { soft x == 8; }
    endclass
    constraint C::c { x == 7; }
    class Base;
        rand int v;
        static constraint s { v == 1; }
    endclass
    class Derived extends Base;
        static constraint s { v == 2; }
    endclass
    class Holder;
        rand C member;
        function new(); member = new; endfunction
    endclass
    initial begin
        A a1 = new, a2 = new;
        B b = new;
        C c = new, other = new;
        Derived d = new;
        Base h = d, base = new;
        Holder holder = new;
        checks = 0;
        checks += (!a1.randomize() && !a2.randomize()) * 1;
        a1.c1.constraint_mode(0);
        checks += (a1.c1.constraint_mode() == 0 && a2.c1.constraint_mode() == 0) * 2;
        checks += (a2.randomize() && a2.b == 2 && a1.randomize() && a1.b == 2) * 4;
        checks += (b.randomize() && b.b == 2 && b.c1.constraint_mode() == 1) * 8;
        a2.c2.constraint_mode(0);
        a2.c1.constraint_mode(1);
        checks += (a1.randomize() && a1.b == 5) * 16;
        checks += (c.randomize() && c.x == 7) * 32;
        // Through a rand handle: the block is off for every C, which
        // leaves its soft constraint.
        other.c.constraint_mode(0);
        checks += (holder.randomize() && holder.member.x == 8) * 64;
        // Through a Base handle, the Derived override's mode.
        h.s.constraint_mode(0);
        checks += (d.s.constraint_mode() == 0 && base.s.constraint_mode() == 1
                   && base.randomize() && base.v == 1) * 128;
        checks += ($bits(h.s.constraint_mode()) == 32 && h.s.constraint_mode() == 0) * 256;
        h.s.constraint_mode();
        // Every block of an object, its static ones for every object.
        a1.constraint_mode(0);
        checks += (a2.c1.constraint_mode() == 0 && a2.c3.constraint_mode() == 1
                   && a1.c3.constraint_mode() == 0) * 512;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq checks 1023))

; Inline constraints name the caller's variables where the object's class
; has no member of the name: a property of the class of the method that
; makes the call, and its arguments. A restricted constraint block
; resolves only the names it lists into the object's class, the others in
; the caller's scope, a dotted name by its first identifier (IEEE 1800-2023
; 18.7).
(case inline_constraint_caller_names
  (source "inline_caller.sv" #"
class C0;
    rand int x;
endclass
class Limits;
    int limit = 2;
endclass
class C1;
    rand int x;
    int y = -1;
    Limits cfg;
    function new(); cfg = new; endfunction
endclass
class C2;
    int x = 100, y = 5;
    function int doit(C0 f, int x, int z);
        return f.randomize() with { x > 0; x < y + z; };
    endfunction
endclass
function int restricted(C1 obj, int y);
    return obj.randomize() with (x) { x > 0; x < y; };
endfunction
function int listed(C1 obj, int y);
    return obj.randomize() with (x, y) { x == y; };
endfunction
function int dotted(C1 obj);
    return obj.randomize() with (x, cfg) { x == cfg.limit; };
endfunction
module Top(output int checks);
    initial begin
        C0 b = new;
        C1 c = new;
        C2 d = new;
        int ok;
        checks = 0;
        ok = 0;
        repeat (8) if (d.doit(b, 50, 2) && b.x > 0 && b.x < 7) ok++;
        checks += (ok == 8) * 1;
        ok = 0;
        repeat (8) if (restricted(c, 4) && c.x inside {[1:3]}) ok++;
        checks += (ok == 8) * 2;
        checks += (listed(c, 9) && c.x == -1) * 4;
        checks += (dotted(c) && c.x == 2) * 8;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq checks 15))

; `std::randomize(v...) with { ... }` solves the variables with the
; constraints, which also read other variables of the scope, and writes them
; only when it succeeds (IEEE 1800-2023 18.12.1).
(case scope_randomize_with
  (source "scope_with.sv" #"
module Top(output int checks);
    class A;
        function int pick(int y, output int got);
            int x, success;
            success = std::randomize(x) with { x > 0; x < y; };
            got = x;
            return success;
        endfunction
    endclass
    int a, b, limit = 10;
    bit [3:0] nibble;
    initial begin
        A obj = new;
        int got;
        checks = 0;
        checks += (obj.pick(3, got) == 1 && got > 0 && got < 3) * 1;
        checks += (std::randomize(a, b) with { a + b == limit; a > 3; b > 3; }
                   && a + b == 10 && a > 3 && b > 3) * 2;
        a = 77;
        checks += (std::randomize(a) with { a > 5; a < 5; } == 0 && a == 77) * 4;
        checks += (std::randomize(nibble) with { nibble == 4'hf; soft nibble == 1; } && nibble == 15) * 8;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq checks 15))

; A constraint calls a function of its class (IEEE 1800-2023 18.5.11): the
; random variables in the arguments are solved first, by the constraints
; that name only them; the function is then called as the object's class
; calls it, an override included, with their values, and its value is state
; to the other constraints. A random variable the function reads that is no
; argument has its value before the call, and a call that fails changes
; nothing.
(case constraint_functions
  (source "functions.sv" #"
module Top(output int checks);
    int scale = 5;
    class A;
        rand int b1, b2, b3;
        function int F(input int d);
            F = d;
        endfunction
        function int twice(int v);
            return 2 * v + 1;
        endfunction
        constraint c1 { b1 == 5; }
        constraint c2 { b2 == F(b1); }
        constraint c3 { b3 == twice(b1 + 1); }
    endclass
    class Ordered;
        rand int x, y;
        function int same(int v); return v; endfunction
        constraint d { y inside {[1:10]}; soft y == 2; }
        constraint c { x == same(y); x > 5; }
    endclass
    class Base;
        rand int a, b;
        virtual function int g(int v); return v; endfunction
        constraint c { a == 3; b == g(a); }
    endclass
    class Derived extends Base;
        virtual function int g(int v); return v * 10; endfunction
    endclass
    class Reads;
        rand int a, k, m;
        int scale = 2;
        function int h(int v); return v + k; endfunction
        function bit [3:0] low(int v); return v; endfunction
        function int narrow(bit [1:0] v); return v; endfunction
        function int scaled(int v); return v * scale; endfunction
        rand int c, n, s;
        constraint r { a == 18; k inside {[1:9]}; m == h(a); c == low(a);
                       n == narrow(a); s == scaled(a); }
    endclass
    initial begin
        A obj = new;
        Ordered o = new;
        Derived d = new;
        Base h = d;
        Reads r = new;
        checks = 0;
        checks += (obj.randomize() && obj.b1 == 5 && obj.b2 == 5 && obj.b3 == 13) * 1;
        // y is solved first, to 2, which leaves x no value.
        o.x = 77;
        checks += (!o.randomize() && o.x == 77) * 2;
        checks += (d.randomize() && d.b == 30 && h.randomize() && h.b == 30) * 4;
        r.k = 100;
        checks += (r.randomize() && r.m == 118 && r.k != 100) * 8;
        checks += (r.c == 2 && r.n == 2 && r.s == 36) * 16;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq checks 31))

; The calls of a block that is off or that a derived class overrides pin
; nothing; a guard that calls a function waits for the solve of the rest; a
; randc argument takes a value its cycle has not produced yet; an array size
; named only in an argument is solved; a static rand argument is the
; property (IEEE 1800-2023 18.5.11). A function that randomizes another
; object between the two solves leaves the arguments pinned; an inherited
; constraint calls the non-virtual method its class sees and the override
; of a virtual one (8.20).
(case constraint_function_phases
  (source "function_phases.sv" #"
module Top(output int checks);
    class M;
        rand int x, y;
        function int f(int v); return v + 1; endfunction
        constraint c1 { x == f(y); }
        constraint c2 { x == y; x == 0; }
    endclass
    class N extends M;
        constraint c1 { x >= 0; }
    endclass
    class G;
        rand int x, y;
        function int f(int v); return v; endfunction
        constraint s { soft x == 3; }
        constraint d { y == 1; if (f(y) > 0) disable soft x; x inside {3, 4}; }
    endclass
    class C;
        randc bit [1:0] r;
        rand int y;
        function int id(int v); return v; endfunction
        constraint k { y == id(r); }
    endclass
    class Q;
        rand int q[];
        rand int n;
        function int size_of(int s); return s; endfunction
        constraint k { n == size_of(q.size()); }
    endclass
    class S;
        static rand int s;
        rand int y;
        function int id(int v); return v; endfunction
        constraint k { s inside {[1:3]}; y == id(s) + 10; }
    endclass
    class In;
        rand int v, w;
        function int id(int a); return a; endfunction
        constraint k { v inside {[1:3]}; w == id(v); }
    endclass
    class Out;
        rand int a, b;
        In inner;
        function new(); inner = new; endfunction
        function int pick(int s); void'(inner.randomize()); return s + 1; endfunction
        constraint k { a inside {[0:100]}; b == pick(a); }
    endclass
    class B;
        rand int x, y;
        function int f(int v); return v + 1; endfunction
        virtual function int g(int v); return v + 10; endfunction
        constraint k { y == 5; x == f(y) + g(y); }
    endclass
    class D extends B;
        function int f(int v); return v + 100; endfunction
        virtual function int g(int v); return v + 1000; endfunction
    endclass
    initial begin
        M m = new;
        N nn = new;
        G g = new;
        C c = new;
        Q q = new;
        S st = new;
        Out o = new;
        D dd = new;
        bit [3:0] seen;
        int sized, pinned;
        checks = 0;
        m.c1.constraint_mode(0);
        checks += (m.randomize() && m.x == 0 && m.y == 0) * 1;
        checks += (nn.randomize() && nn.x == 0 && nn.y == 0) * 2;
        checks += (g.randomize() && g.y == 1) * 4;
        seen = 0;
        repeat (4) if (c.randomize()) seen[c.r] = 1;
        checks += (seen == 4'hf) * 8;
        sized = 0;
        repeat (8) if (q.randomize() && q.n == q.q.size() && q.q.size() != 0) sized++;
        checks += (sized > 0) * 16;
        checks += (st.randomize() && st.y == S::s + 10 && S::s inside {[1:3]}) * 32;
        pinned = 0;
        repeat (8) if (o.randomize() && o.b == o.a + 1 && o.inner.w == o.inner.v) pinned++;
        checks += (pinned == 8) * 64;
        checks += (dd.randomize() && dd.x == 6 + 1005) * 128;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq checks 255))

; uvm-1.2's uvm_sequence_base::pick_sequence: a function with no rand
; argument is a state value, evaluated before solving (18.5.11), here of a
; base class through a handle that may be null, in a derived object.
(case constraint_function_pick_sequence
  (source "pick_sequence.sv" #"
module Top(output int bad, output bit done);
    class Seqr;
        int sequences[$];
        function int num_sequences(); return sequences.size(); endfunction
    endclass
    class Item; endclass
    class SeqBase extends Item;
        Seqr m_sequencer;
        rand int unsigned seq_kind;
        constraint pick_sequence {
            (num_sequences() <= 2) || (seq_kind >= 2);
            (seq_kind <  num_sequences()) || (seq_kind == 0); }
        function int num_sequences();
            if (m_sequencer == null) return 0;
            return (m_sequencer.num_sequences());
        endfunction
    endclass
    class MySeq extends SeqBase; rand bit [3:0] x; endclass
    initial begin
        MySeq s = new;
        Seqr r = new;
        repeat (8) if (!s.randomize() || s.seq_kind != 0) bad++;
        s.m_sequencer = r;
        r.sequences = '{1, 2};
        repeat (8) if (!s.randomize() || s.seq_kind > 1) bad++;
        r.sequences = '{1, 2, 3, 4, 5};
        repeat (8) if (!s.randomize() || s.seq_kind < 2 || s.seq_kind > 4) bad++;
        $display("%0d", bad);
        done = bad == 0;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq bad 0) (assert_eq done 1)
  (expect_output "0\n"))
