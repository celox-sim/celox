(case waits_on_static_properties
  ; A static property is a variable of the declaring scope, so a wait in a
  ; method wakes when another process writes it (IEEE 1800-2023 8.9, 9.4.3).
  (source "class.sv" #"
class C;
    static int s_state;
    task wait_for(int s);
        wait (s_state >= s);
        $display("reached %0d at %0d", s, $time);
    endtask
endclass
module Top;
    C c;
    initial begin
        c = new;
        fork
            c.wait_for(2);
            begin #1 c.s_state = 1; #1 c.s_state = 2; end
        join
    end
endmodule
"#)
  (top Top) (run_until 5)
  (expect_output "reached 2 at 2\n"))
(case waits_on_instance_properties
  ; A level wait checks its condition again whenever a property it reads
  ; is stored, by any process and through any handle (IEEE 1800-2023 9.4.3):
  ; through `this` of a base class after a store through a derived handle,
  ; through an alias written by a task, through a queue and an associative
  ; array held in properties, through a function after `randomize`, and on
  ; a package object that another module instance writes.
  (source "class.sv" #"
package p;
    class Shared;
        int count;
    endclass
    Shared shared;
endpackage
class Base;
    int m_state;
    task wait_for(int s);
        wait ((s & m_state) != 0);
    endtask
endclass
class Derived extends Base;
    int extra;
endclass
class Holder;
    int q[$];
    int counts[int];
    bit flag;
    rand bit [3:0] r;
    constraint seven { r == 7; }
    function bit drawn();
        return r != 0;
    endfunction
endclass
module Writer;
    initial #7 p::shared.count = 3;
endmodule
module Top(output int t_this, t_alias, t_queue, t_exists, t_func, t_pkg, t_now,
           output int r);
    Writer writer();
    Holder a = new, other = new, b;
    Derived d = new;
    Base base;
    task automatic raise(Holder h);
        #1 h.flag = 1;
    endtask
    initial begin
        b = a;
        base = d;
        p::shared = new;
        a.counts[1] = 1;
        fork
            begin wait (base != null); base.wait_for(2); t_this = int'($time); end
            begin wait (b != null && b.flag); t_alias = int'($time); end
            begin wait (a.q.size() > 0); t_queue = int'($time); end
            begin wait (!a.counts.exists(1) && a.flag); t_exists = int'($time); end
            begin wait (a.drawn()); t_func = int'($time); end
            begin wait (p::shared != null && p::shared.count == 3); t_pkg = int'($time); end
            begin #8 wait (a.flag); t_now = int'($time); end
            begin
                #1 d.m_state = 1;
                other.flag = 1;
                #1 d.m_state = 3;
                raise(a);
                #1 a.q.push_back(5);
                #1 a.counts.delete(1);
                #1 void'(a.randomize());
                r = a.r;
            end
        join
    end
endmodule
"#)
  (top Top) (run_until 10)
  (assert_eq t_this 2) (assert_eq t_alias 3) (assert_eq t_queue 4)
  (assert_eq t_exists 5) (assert_eq t_func 6) (assert_eq t_pkg 7)
  (assert_eq t_now 8) (assert_eq r 7))
(case waits_on_properties_in_package_subroutines
  ; A wait in a package task wakes on a store in a module, and a wait in a
  ; module on a store in a package function (IEEE 1800-2023 9.4.3, 26.2).
  (source "class.sv" #"
package boxes;
    class Box;
        int level;
    endclass
    task automatic wait_level(Box b, int n);
        wait (b != null && b.level >= n);
    endtask
    function automatic void raise(Box b);
        b.level = b.level + 1;
    endfunction
endpackage
module Top(output int t_task, t_func);
    import boxes::*;
    Box a = new, c = new;
    initial begin
        fork
            begin wait_level(a, 2); t_task = int'($time); end
            begin wait (c.level == 1); t_func = int'($time); end
            begin #1 a.level = 1; #1 a.level = 2; #1 raise(c); end
        join
    end
endmodule
"#)
  (top Top) (run_until 5)
  (assert_eq t_task 2) (assert_eq t_func 3))
(case body_parameters_are_local
  ; IEEE 1800-2023 6.20.4: in a package, a class body, a generate block and
  ; the compilation unit, `parameter` is `localparam`, so a range that names
  ; one is a constant: a package class method's variable of a package
  ; typedef takes a variable bit select. A module without a parameter port
  ; list keeps its body parameter overridable (6.20.1).
  (source "locality.sv" #"
parameter int UNIT_W = 6;
typedef logic [UNIT_W-1:0] unit_t;
package locality;
    parameter int MAX_W = 16;
    typedef logic [MAX_W-1:0] data_t;
    class C;
        parameter int CW = 5;
        typedef logic [CW-1:0] c_t;
        extern function int fill(int n);
        function int body(int n);
            c_t v = '0;
            for (int k = 0; k < n; k++) v[k] = 1'b1;
            return v;
        endfunction
    endclass
    function int C::fill(int n);
        data_t val = '0;
        int k = 0;
        repeat (n) val[k++] = 1'b1;
        return val;
    endfunction
endpackage
module Child(output int p);
    parameter int P = 1;
    assign p = P;
endmodule
module Top(output int fill, body, u_value, g_value, child_p);
    import locality::*;
    unit_t u;
    if (1) begin : g
        parameter int GW = 3;
        logic [GW-1:0] gv;
        initial begin
            gv = '0;
            for (int k = 0; k < 2; k++) gv[k] = 1'b1;
            g_value = gv;
        end
    end
    Child #(.P(5)) c(child_p);
    initial begin
        C obj = new;
        int k = 1;
        u = '1;
        u[k] = 1'b0;
        u_value = u;
        fill = obj.fill(4);
        body = obj.body(3);
    end
endmodule
"#)
  (top Top) (run_until 1)
  (assert_eq fill 15) (assert_eq body 7) (assert_eq u_value 61)
  (assert_eq g_value 3) (assert_eq child_p 5))
; Package generic requests are bound where used and share static state across
; importing module scopes. Matching aliases select the same specialization (8.25).
(case foreign_generic_static_state_across_modules
 (source "foreign_state.sv" #"
package p;
 class Db #(type T=int);
  static T last;
  static int count=0;
  static function void set(T v); last=v; count++; endfunction
 endclass
endpackage
module Writer;
 initial begin #1; p::Db#(byte)::set(8'h35); p::Db#(int)::set(32'h12345678); end
endmodule
module Reader(output int narrow, wide, narrow_count, wide_count);
 typedef p::Db#(byte) ByteDb;
 initial begin
  #2; narrow=ByteDb::last; wide=p::Db#(int)::last;
  narrow_count=ByteDb::count; wide_count=p::Db#(int)::count;
 end
endmodule
module Top(output int narrow, wide, narrow_count, wide_count);
 Writer writer();
 Reader reader(narrow, wide, narrow_count, wide_count);
endmodule"#)
 (top Top) (run_until 3)
 (assert_eq narrow 0x35) (assert_eq wide 0x12345678)
 (assert_eq narrow_count 1) (assert_eq wide_count 1))

; A package factory receives a compilation-unit class as a type parameter and
; resolves its constructor in that class's declaration scope, including type_id.
(case foreign_generic_unit_type_constructor
 (source "foreign_factory.sv" #"
package p;
 class Registry #(type T, string NAME="User");
  static function string get_name(); return T::type_name(); endfunction
  static function string registered_name(); return NAME; endfunction
  static function int get_kind(); return T::kind; endfunction
  static function string get_label(); return T::label; endfunction
  static function T create(int n);
   T object;
   object=new(n);
   return object;
  endfunction
 endclass
endpackage
import p::*;
class User;
 static function string type_name(); return "User"; endfunction
 parameter string label="unit_label";
 static const int kind=7;
 typedef Registry#(User, "user_registry") type_id;
 int value;
 function new(int n); value=n; endfunction
 static function User make();
  if (type_id::get_name() != "User" || type_id::registered_name() != "user_registry" || type_id::get_kind() != 7 || type_id::get_label() != "unit_label") return type_id::create(-1);
  return type_id::create(23);
 endfunction
endclass
module Top(output int result);
 User object;
 initial begin object=User::make(); result=object.value; end
endmodule"#)
 (top Top) (run_until 0) (assert_eq result 23))

; The same specialized static handle is one object when accessed from multiple
; modules; another type argument has independent static storage (8.25).
(case foreign_generic_static_handle_identity
 (source "foreign_handles.sv" #"
package p;
 class Item;
  int value;
  function new(int n); value=n; endfunction
 endclass
 class Other;
  int value;
  function new(int n); value=n; endfunction
 endclass
 class Slot #(type T);
  static T saved;
  static function void put(T h); saved=h; endfunction
 endclass
endpackage
module Writer;
 p::Item item;
 p::Other other;
 initial begin
  item=new(41); other=new(99);
  #1; p::Slot#(p::Item)::put(item); p::Slot#(p::Other)::put(other);
 end
endmodule
module Reader(output int value, other_value, same);
 p::Item item;
 initial begin
  #2; item=p::Slot#(p::Item)::saved;
  same=(item==p::Slot#(p::Item)::saved);
  item.value++; value=p::Slot#(p::Item)::saved.value;
  other_value=p::Slot#(p::Other)::saved.value;
 end
endmodule
module Top(output int value, other_value, same);
 Writer writer(); Reader reader(value, other_value, same);
endmodule"#)
 (top Top) (run_until 3)
 (assert_eq value 42) (assert_eq other_value 99) (assert_eq same 1))

; Explicit actuals are evaluated in the importing module; defaults and qualified
; package references retain the declaration scope, despite local shadows (8.25).
(case foreign_generic_declaration_scope_and_equivalent_defaults
 (source "foreign_scopes.sv" #"
package p;
 parameter int W=5;
 typedef bit [W-1:0] word_t;
 class Box #(int N=W, type T=word_t);
  static int count=0;
  T value;
  function new(); count++; endfunction
  static function int width(); return $bits(T); endfunction
  static function int number(); return N; endfunction
  static function int from_pkg(); int W; W=77; return p::W; endfunction
 endclass
endpackage
module Top(output int checks);
 parameter int W=9;
 typedef bit [W-1:0] word_t;
 typedef p::Box#(.T(word_t)) Wide;
 typedef p::Box#(.T(word_t),.N(5)) Same;
 typedef Wide::T word_again;
 Wide a; Same b; p::Box#() c;
 initial begin
  a=new(); b=new(); c=new();
  checks=(Wide::number()==5);
  checks+=(Wide::width()==9)*2;
  checks+=(p::Box#()::width()==5)*4;
  checks+=(Wide::N==5)*8;
  checks+=($bits(word_again)==9)*16;
  checks+=(Wide::count==2 && Same::count==2 && p::Box#()::count==1)*32;
  checks+=(Wide::from_pkg()==5)*64;
 end
endmodule"#)
 (top Top) (run_until 0) (assert_eq checks 127))

