  (top Top) (run_until 0) (assert_eq done 1)
  (expect_output "1 8\n1 1\n0 8\n"))

(case specializations_of_parameterized_classes
  (source "class.sv" #"
module Top #(parameter int W = 6)(output bit done);
    class Box #(int N = 4, type T = bit [7:0]);
        T value;
        static int made;
        localparam int Twice = N * 2;
        function new(T v);
            value = v;
            made++;
        endfunction
        function T get();
            T copy = value;
            return copy + T'(N);
        endfunction
        function int twice();
            return Twice;
        endfunction
    endclass
    class Wide #(int M = 1) extends Box #(M + 1, int);
        function new();
            super.new(100);
        endfunction
        function int kind();
            return M * 10 + N;
        endfunction
    endclass
    Box b4;
    Box #(W) bw;
    Box #(.T(int), .N(2)) bi;
    Box #(3, bit [3:0]) bn;
    Wide #(5) w;
    Box #(6, int) base;
    initial begin
        b4 = new(8'd10);
        bw = new(8'd1);
        bi = new(-5);
        bn = new(4'd14);
        w = new;
        $display("%0d %0d %0d %0d", b4.get(), bw.get(), bi.get(), bn.get());
        $display("%0d %0d %0d %0d", b4.N, bw.twice(), Box#(.T(int), .N(2))::made, Box#()::made);
        base = w;
        $display("%0d %0d %0d %0d", base.get(), w.N, w.kind(), Box#(6, int)::made);
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1)
  (expect_output "14 7 -3 1\n4 12 1 1\n106 6 56 1\n"))

