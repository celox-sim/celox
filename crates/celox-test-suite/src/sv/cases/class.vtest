(case casts_of_class_handles
  (source "class.sv" #"
module Top(output bit done);
    class Animal;
        virtual function int legs();
            return 0;
        endfunction
    endclass
    class Dog extends Animal;
        virtual function int legs();
            return 4;
        endfunction
    endclass
    class Puppy extends Dog;
    endclass
    class Rock;
    endclass
    Animal animal;
    Dog dog;
    Rock rock;
    int ok;
    initial begin
        animal = Puppy::new;
        ok = $cast(dog, animal);
        $display("%0d %0d", ok, dog.legs());
        animal = new;
        ok = $cast(dog, animal);
        $display("%0d %0d", ok, dog.legs());
        animal = null;
        ok = $cast(dog, animal);
        $display("%0d %0d", ok, dog == null);
        dog = new;
        ok = $cast(animal, dog);
        $display("%0d %0d", ok, animal.legs());
        if (!$cast(rock, dog))
            $display("rock");
        ok = $cast(dog, null);
        $display("%0d %0d", ok, dog == null);
        animal = Dog::new;
        $cast(dog, animal);
        $display("%0d", dog.legs());
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1)
  (expect_output "1 4\n0 4\n1 1\n1 4\nrock\n1 1\n4\n"))

