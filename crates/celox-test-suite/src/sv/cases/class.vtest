        wanted = 2;
        if (p.randomize(x) with { x == wanted; x == 2; }) $fatal(1, "hook unsat");
        if (p.x != 5 || p.pre_calls != 2 || p.post_calls != 1) $fatal(1, "hook failure state");
        d = new; p = d; wanted = 2;
