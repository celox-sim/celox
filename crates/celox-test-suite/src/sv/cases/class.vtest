(case named_constructor_arguments
  (source "class.sv" #"
module Top(output bit done);
    class Base;
        int s;
        function new(int def = 3);
            s = def;
        endfunction
    endclass
    class Point #(int t = 12) extends Base;
        int x;
        int y;
        function new(int x = 1, int y = 2);
            super.new(.def(x + y));
            this.x = x;
            this.y = y - t;
        endfunction
    endclass
    Base base;
    Point p;
    initial begin
        p = new(.y(30));
        $display("%0d %0d %0d", p.x, p.y, p.s);
        base = Point#(.t(23))::new(.y(40), .x(4));
        $display("%0d", base.s);
        done = 1;
    end
endmodule
"#)
