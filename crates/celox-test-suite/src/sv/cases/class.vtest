(case unconstrained_randomize
  (source "randomize.sv" #"
module Top(output bit done, output int errors);
    class Sample;
        rand bit flag;
        rand bit signed [6:0] narrow;
        rand bit [63:0] wide;
        int untouched = 42;
        int phase;
        bit [63:0] observed;
        function void pre_randomize();
            if (phase != 0) untouched = -1;
            phase = 1;
        endfunction
        function void post_randomize();
            if (phase != 1) untouched = -2;
            observed = wide;
            phase = 0;
        endfunction
        function int again();
            return randomize();
        endfunction
    endclass
    Sample a, b, alias_a;
    bit [63:0] saved, changed;
    bit saved_flag;
    bit signed [6:0] saved_small;
    int ignored;
    initial begin
        a = new;
        b = new;
        alias_a = a;
        a.srandom(0);
        if (a.randomize() != 1) errors++;
        saved = a.wide;
        saved_flag = a.flag;
        saved_small = a.narrow;
        if (a.observed != saved || a.untouched != 42 || a.phase != 0) errors++;
        changed = 0;
        repeat (12) begin
            if (a.again() != 1) errors++;
            changed |= saved ^ a.wide;
        end
        if (changed[63:32] == 0 || changed[31:0] == 0) errors++;
        alias_a.srandom(0);
        repeat (5) begin
            ignored = $urandom;
            ignored = b.randomize();
        end
        if (a.randomize() != 1) errors++;
        if (a.wide != saved || a.flag != saved_flag || a.narrow != saved_small) errors++;
        if (a.observed != saved || a.untouched != 42 || a.phase != 0) errors++;
        b.srandom(0);
        if (b.randomize() != 1 || b.wide != saved) errors++;
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1) (assert_eq errors 0))

(case randomize_without_rand_members
  (source "randomize_empty.sv" #"
module Top(output bit done, output int errors);
    class Empty;
        int value = 5;
        function void pre_randomize(); value += 1; endfunction
        function void post_randomize(); value *= 2; endfunction
    endclass
    Empty object;
    initial begin
        object = new;
        if (object.randomize() != 1 || object.value != 12) errors++;
        if (object.randomize() != 1 || object.value != 26) errors++;
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1) (assert_eq errors 0))

(case randomization_inheritance
  (source "randomization_inheritance.sv" #"
module Top(output bit done, output int errors);
    class Base;
        rand bit [63:0] x;
        int pre, post;
        function void pre_randomize(); pre += 1; endfunction
        function void post_randomize(); post += 1; endfunction
        function bit [63:0] base_x(); return x; endfunction
        function int again(); return randomize(); endfunction
    endclass
    class Child extends Base;
        rand bit [63:0] x;
        rand bit [63:0] y;
        function void pre_randomize(); super.pre_randomize(); pre += 10; endfunction
        function void post_randomize(); super.post_randomize(); post += 10; endfunction
    endclass
    class Grandchild extends Child; endclass
    Base b;
    Grandchild c;
    bit [63:0] bx, cx, cy;
    initial begin
        c = new;
        b = c;
        c.srandom(31);
        if (!c.randomize()) errors++;
        bx = c.base_x(); cx = c.x; cy = c.y;
        b.srandom(31);
        if (!b.again()) errors++;
        if (b.x != bx || c.x != cx || c.y != cy) errors++;
        if (b.pre != 22 || b.post != 22) errors++;
        b.rand_mode(0);
        if (b.x.rand_mode() || c.x.rand_mode() || c.y.rand_mode()) errors++;
        if (!b.randomize() || b.x != bx || c.x != cx || c.y != cy) errors++;
        // Inline selection is resolved in the static receiver class.
        b.srandom(31);
        if (!b.randomize(x) || b.x != bx || c.x != cx || c.y != cy) errors++;
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1) (assert_eq errors 0))

(case randomization_modes_and_selection
  (source "randomization_modes.sv" #"
module Top(output bit done, output int errors);
    class C;
        rand bit [63:0] x, y;
        bit [63:0] plain = 19;
        int hooks;
        function void pre_randomize(); hooks++; endfunction
        function void post_randomize(); hooks++; endfunction
        function int select_plain(); return randomize(plain); endfunction
        function void disable_x(); x.rand_mode(0); endfunction
    endclass
    C c, alias_c, reference;
    int plain = 99;
    bit [63:0] x, y, p;
    initial begin
        c = new; reference = new; alias_c = c;
        if (c.x.rand_mode() != 1 || c.y.rand_mode() != 1) errors |= 1;
        c.disable_x();
        c.srandom(42); reference.srandom(42);
        if (!c.randomize() || !reference.randomize(y)) errors |= 2;
        if (c.x != 0 || c.y != reference.y || c.plain != 19) errors |= 4;
        c.rand_mode(0);
        x = c.x; y = c.y;
        if (!c.randomize() || c.x != x || c.y != y) errors |= 8;
        alias_c.x.rand_mode(1);
        if (c.x.rand_mode() != 1 || c.y.rand_mode() != 0) errors |= 16;
        c.x.rand_mode(0);
        if (c.x.rand_mode() != 0) errors |= 32;
        c.srandom(9); reference.srandom(9);
        if (!c.randomize(plain) || !reference.randomize(plain)) errors |= 64;
        if (plain != 99 || c.plain != reference.plain || c.x != x || c.y != y) errors |= 128;
        if (c.x.rand_mode() || c.y.rand_mode()) errors |= 256;
        p = c.plain;
        if (!c.randomize(null) || c.x != x || c.y != y || c.plain != p) errors |= 512;
        if (c.hooks != 8) errors |= 1024;
        c.srandom(7); reference.srandom(7);
        if (!c.select_plain() || !reference.randomize(plain)) errors |= 2048;
        if (c.plain != reference.plain) errors |= 4096;
        c.rand_mode(1);
        if (!c.x.rand_mode() || !c.y.rand_mode()) errors |= 8192;
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1) (assert_eq errors 0))

(case randomization_pre_hook_controls_modes
  (source "randomization_hook.sv" #"
module Top(output bit done, output int errors);
    class C;
        rand bit [63:0] x;
        bit disable_randomization;
        int seen;
        function void pre_randomize();
            seen = x.rand_mode();
            if (disable_randomization) rand_mode(0);
        endfunction
    endclass
    C c, reference;
    initial begin
        c = new; reference = new;
        c.disable_randomization = 1;
        if (!c.randomize() || c.x != 0 || c.x.rand_mode()) errors++;
        c.srandom(8); reference.srandom(8);
        if (!c.randomize(x) || !reference.randomize()) errors++;
        if (c.x != 0 || c.x.rand_mode() || c.seen != 1) errors++;
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1) (assert_eq errors 0))


(case randomization_mode_bit_argument
  (source "mode_bit_argument.sv" #"
module Top(output bit done, output int errors);
    class C; rand int x; endclass
    C c;
    initial begin
        c = new;
        c.x.rand_mode(2);
        if (c.x.rand_mode() != 0) errors++;
        c.x.rand_mode(3);
        if (c.x.rand_mode() != 1) errors++;
        c.rand_mode(2);
        if (c.x.rand_mode() != 0) errors++;
        c.rand_mode(3);
        if (c.x.rand_mode() != 1) errors++;
        if (c.x.rand_mode() < -1) errors++;
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1) (assert_eq errors 0))

(case randomization_enum_domain
  (source "enum_randomize.sv" #"
module Top(output bit done, output int errors);
    typedef enum bit signed [7:0] {NEG=-7, MID=2, HIGH=MID+89} sparse_t;
    typedef enum bit [63:0] {LOW=64'h100000000, TOP=64'h8000000000000000} wide_t;
    class Base;
        rand sparse_t value;
        sparse_t selected;
        rand wide_t wide_value;
        rand enum bit [2:0] {ONLY=5} single;
        rand enum {FIRST=11, SECOND=35, THIRD} extra;
    endclass
    Base a, b;
    Base base;
    int seen;
    int old_value;
    initial begin
        a = new; b = new; base = a;
        a.srandom(123); b.srandom(123);
        repeat (256) begin
            if (!base.randomize() || !b.randomize()) errors++;
            if (a.value != b.value || a.wide_value != b.wide_value || a.extra != b.extra) errors++;
            case (a.value)
                NEG: seen |= 1;
                MID: seen |= 2;
                HIGH: seen |= 4;
                default: errors++;
            endcase
            if (a.wide_value != LOW && a.wide_value != TOP) errors++;
            if (a.single != 5) errors++;
            if (a.extra != 11 && a.extra != 35 && a.extra != 36) errors++;
        end
        if (seen != 7) errors++;
        a.value.rand_mode(0);
        old_value = a.value;
        if (!a.randomize() || a.value != old_value) errors++;
        if (!a.randomize(selected)) errors++;
        if (a.selected != NEG && a.selected != MID && a.selected != HIGH) errors++;
        if (a.value != old_value || a.value.rand_mode() != 0) errors++;
        if (!base.randomize(value)) errors++;
        if (a.value != NEG && a.value != MID && a.value != HIGH) errors++;
        if (a.value.rand_mode() != 0) errors++;
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1) (assert_eq errors 0))

(case randomization_enum_inheritance
  (source "enum_inheritance.sv" #"
module Top(output bit done, output int errors);
    class Parent;
        rand enum bit [7:0] {P=7, Q=93} x;
    endclass
    class Child extends Parent;
        rand enum bit [7:0] {R=11, S=57, T=98} y;
    endclass
    Child child;
    Parent parent;
    int seen;
    initial begin
        child = new; parent = child;
        repeat (128) begin
            if (parent.randomize() != 1) errors++;
            if (child.x != 7 && child.x != 93) errors++;
            case (child.y)
                11: seen |= 1;
                57: seen |= 2;
                98: seen |= 4;
                default: errors++;
            endcase
        end
        if (seen != 7) errors++;
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1) (assert_eq errors 0))

(case randomization_enum_alias
  (source "enum_alias.sv" #"
module Top(output bit done, output int errors);
    typedef enum bit signed [7:0] {NEG=-7, MID=2, HIGH=91} original_t;
    typedef original_t alias_t;
    class Sample;
        rand alias_t value;
    endclass
    Sample object;
    int seen;
    initial begin
        object = new;
        repeat (128) begin
            if (object.randomize() != 1) errors++;
            case (object.value)
                NEG: seen |= 1;
                MID: seen |= 2;
                HIGH: seen |= 4;
                default: errors++;
            endcase
        end
        if (seen != 7) errors++;
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1) (assert_eq errors 0))

(case randomization_enum_fill_literals
  (source "enum_fill.sv" #"
module Top(output bit done, output int errors);
    typedef enum bit [63:0] {WIDE_ALL='1} wide_t;
    typedef enum bit [3:0] {SMALL_ALL='1} small_t;
    typedef enum bit signed [63:0] {SIGNED_ALL='1} signed_t;
    typedef enum bit [63:0] {ZERO='0} zero_t;
    class Sample;
        rand wide_t wide_value;
        rand small_t small_value;
        rand signed_t signed_value;
        rand zero_t zero_value;
    endclass
    Sample object;
    initial begin
        object = new;
        repeat (8) begin
            if (object.randomize() != 1) errors++;
            if (object.wide_value != 64'hffffffffffffffff) errors++;
            if (object.small_value != 4'hf) errors++;
            if (object.signed_value != -64'sd1) errors++;
            if (object.zero_value != 64'd0) errors++;
            if (object.wide_value != WIDE_ALL || object.small_value != SMALL_ALL
                || object.signed_value != SIGNED_ALL || object.zero_value != ZERO) errors++;
        end
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1) (assert_eq errors 0))
