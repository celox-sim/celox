(case classes_of_packages
  (source "class.sv" #"
package shapes;
    parameter int SCALE = 10;
    typedef bit [7:0] byte_t;
    virtual class Shape;
        byte_t id;
        static int made;
        function new(byte_t id);
            this.id = id;
            made++;
        endfunction
        pure virtual function int area();
        function int scaled();
            return area() * SCALE;
        endfunction
    endclass
    class Square extends Shape;
        int side;
        function new(int side);
            super.new(8'd1);
            this.side = side;
        endfunction
        virtual function int area();
            return side * side;
        endfunction
    endclass
    interface class Named;
        pure virtual function int name_id();
    endclass
    function automatic Shape make(int side);
        Square square = new(side);
        return square;
    endfunction
    function automatic int ask(Named named);
        return named.name_id() + 100;
    endfunction
endpackage
module Top(output bit done);
    import shapes::Shape;
    import shapes::Square;
    class Rect extends shapes::Shape implements shapes::Named;
        int w;
        int h;
        function new(int w, int h);
            super.new(8'd2);
            this.w = w;
            this.h = h;
        endfunction
        virtual function int area();
            return w * h;
        endfunction
        virtual function int name_id();
            return 7;
        endfunction
    endclass
    Shape shape;
    Square square;
    Rect rect;
    initial begin
        shape = shapes::make(3);
        rect = new(2, 5);
        $display("%0d %0d %0d %0d", shape.area(), shape.scaled(), shape.id, $cast(square, shape));
        shape = rect;
        $display("%0d %0d %0d %0d", shape.area(), rect.scaled(), shapes::ask(rect), shapes::Shape::made);
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1)
  (expect_output "9 90 1 1\n10 100 107 2\n"))

(case classes_of_the_compilation_unit
  (source "class.sv" #"
class Counter;
    static int total;
    int n;
    function void bump();
        n++;
        total++;
    endfunction
endclass
module Child(output int seen);
    Counter counter;
    initial begin
        counter = new;
        counter.bump();
        counter.bump();
        seen = counter.n;
    end
endmodule
module Top(output bit done);
    int seen;
    Child child(.seen(seen));
    initial begin
        #1 $display("%0d %0d", seen, Counter::total);
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 1) (assert_eq done 1)
  (expect_output "2 2\n"))

(case class_declarations_bind_in_their_scopes
  (source "class.sv" #"
module Top(output bit done);
    class Ordered;
        typedef bit [7:0] byte_t;
        parameter byte_t P = 8'hff;
        typedef int table_t [2];
    endclass
    class Init #(int N = 1);
        static int value = N * 10;
    endclass
    class Named #(string S = "a");
        function string s();
            return S;
        endfunction
    endclass
    class Self #(int N = 1);
        typedef Self self_t;
        function int n();
            return N;
        endfunction
    endclass
    class Base #(type T = bit [3:0]);
    endclass
    class Derived #(type T = int) extends Base;
        typedef T own_t;
    endclass
    class Wide #(logic [57:0] V = 0);
        function bit [63:0] v();
            return V;
        endfunction
    endclass
    class Plain;
        typedef int T;
    endclass
    typedef Plain::T plain_t;
    Ordered::table_t entries;
    plain_t plain;
    Self#(2)::self_t self_handle;
    Named#("bc") named;
    Wide#('1) wide;
    Derived#()::own_t own;
    initial begin
        entries[1] = 5;
        plain = -3;
        self_handle = new;
        named = new;
        wide = new;
        $display("%0d %0d %0d %0d", Ordered::P, entries[1], plain, $bits(own));
        $display("%0d %0d %0d %s %h", Init#(2)::value, Init#(3)::value, self_handle.n(), named.s(), wide.v());
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1)
  (expect_output "255 5 -3 32\n20 30 1 bc 03ffffffffffffff\n"))

