        static int made;
        function new();
            made++;
        endfunction
    endclass
    class Real #(real V = 0.0);
        static function real v();
            return V;
        endfunction
    endclass
    class Announced #(int N = 1);
        static int x = N;
    endclass
    localparam int K = 2;
    interface class I #(int N = 0);
        localparam int K = 1;
        pure virtual function int n();
    endclass
    interface class J extends I#(K);
    endclass
    class Impl implements J;
        virtual function int n();
            return 7;
        endfunction
    endclass
    Announced#(1) active;
    if (0) begin : disabled
        Announced#(2) unused;
    end
    initial begin
        Box#(Sized) sized;
        Box#(Ranged) ranged;
        Box#(Signed) signed_elements;
        Box#(Unsigned) unsigned_elements;
        Outer#(byte) outer;
        Four#(2'bxx) unknown;
        Four#(1) one;
        Derived#()::T t;
        Impl impl;
        I#(2) h;
        sized = new;
        ranged = new;
        signed_elements = new;
        unsigned_elements = new;
        outer = new;
        $display("%0d %0d %0d", Box#(Sized)::made, Box#(Signed)::made, Box#(byte)::made);
        unknown = new;
        one = new;
        $display("%0d %0d", Four#(2'bxx)::made, Four#(1)::made);
        $display("%0.1f %0.1f", Real#(1.0 + 2.0)::v(), Real#(3.0)::v());
        $display("%0d", $bits(t));
        impl = new;
        h = impl;
        $display("%0d", h.n());
        done = 1;
    end
endmodule
