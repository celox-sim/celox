(case specialization_keys_follow_the_bound_parameters
  (source "class.sv" #"
module Top(output bit done);
    localparam int N = 2;
    typedef bit signed [3:0] S;
    typedef S [1:0] Signed;
    typedef bit [1:0][3:0] Unsigned;
    typedef int Sized[2];
    typedef int Ranged[0:1];
    class Box #(type T = int);
        static int made;
        function new();
            made++;
        endfunction
    endclass
    class Outer #(type T = int);
        typedef T Inner;
        Box#(Outer::Inner) box;
        function new();
            box = new;
        endfunction
    endclass
    class Base #(int N = 1);
    endclass
    class Derived #(int N = 2) extends Base;
        typedef bit [N-1:0] T;
    endclass
    class Four #(logic [1:0] N = 0);
        static int made;
        function new();
            made++;
        endfunction
    endclass
    class Real #(real V = 0.0);
        static function real v();
            return V;
        endfunction
    endclass
    class Announced #(int N = 1);
        static int x = N;
    endclass
    localparam int K = 2;
    interface class I #(int N = 0);
        localparam int K = 1;
        pure virtual function int n();
    endclass
    interface class J extends I#(K);
    endclass
    class Impl implements J;
        virtual function int n();
            return 7;
        endfunction
    endclass
    Announced#(1) active;
    if (0) begin : disabled
        Announced#(2) unused;
    end
    initial begin
        Box#(Sized) sized;
        Box#(Ranged) ranged;
        Box#(Signed) signed_elements;
        Box#(Unsigned) unsigned_elements;
        Outer#(byte) outer;
        Four#(2'bxx) unknown;
        Four#(1) one;
        Derived#()::T t;
        Impl impl;
        I#(2) h;
        sized = new;
        ranged = new;
        signed_elements = new;
        unsigned_elements = new;
        outer = new;
        $display("%0d %0d %0d", Box#(Sized)::made, Box#(Signed)::made, Box#(byte)::made);
        unknown = new;
        one = new;
        $display("%0d %0d", Four#(2'bxx)::made, Four#(1)::made);
        $display("%0.1f %0.1f", Real#(1.0 + 2.0)::v(), Real#(3.0)::v());
        $display("%0d", $bits(t));
        impl = new;
        h = impl;
        $display("%0d", h.n());
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1)
  (expect_output "2 1 1\n1 1\n3.0 3.0\n2\n7\n"))

