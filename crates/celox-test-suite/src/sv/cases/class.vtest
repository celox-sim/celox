(case shallow_copies
  (source "class.sv" #"
module Top(output bit done);
    class Inner;
        int v;
    endclass
    class Base;
        int b = 1;
    endclass
    class Item extends Base;
        int a;
        string s;
        Inner inner;
        static int made;
        static Item last;
        function new();
            inner = new;
            made++;
        endfunction
    endclass
    Item first;
    Item second;
    Item third;
    Base base;
    Base copy;
    initial begin
        first = new;
        first.a = 12;
        first.b = 7;
        first.s = "hi";
        first.inner.v = 3;
        second = new first;
        first.a = 13;
        first.s = "bye";
        first.inner.v = 4;
        $display("%0d %0d %s %0d %0d %0d", second.a, second.b, second.s, second.inner.v, Item::made, first == second);
        base = second;
        copy = new base;
        $display("%0d %0d %0d %0d", copy.b, $cast(third, copy), third.a, third == second);
        Item::last = second;
        third = new Item::last;
        $display("%0d %0d %0d", third.a, third == second, Item::made);
        done = 1;
    end
endmodule
"#)
