        if (p.x != -2 || p.y != 7 || wanted != -2) $fatal(1, "signed readonly input");
        if (!(p.randomize() with { x == local::x; })) $fatal(1, "local qualifier");
        if (p.x != -3 || x != -3) $fatal(1, "shadowed local");
        wanted = 4;
