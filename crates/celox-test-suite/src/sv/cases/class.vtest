        virtual function int id();
            return 2;
        endfunction
    endclass
    Box box;
    Named named;
    Sized sized;
    int ok;
    initial begin
        box = new;
        named = box;
        ok = $cast(sized, named);
        $display("%0d %0d", ok, sized.size());
        box = null;
        ok = $cast(box, named);
        $display("%0d %0d", ok, box.id());
        named = Tag::new;
        ok = $cast(sized, named);
        $display("%0d %0d", ok, sized.size());
        done = 1;
    end
endmodule
