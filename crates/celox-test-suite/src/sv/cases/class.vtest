    class Box #(type T = int);
        static int made;
        function new();
            made++;
        endfunction
    endclass
    class Outer #(type T = int);
        typedef T Inner;
        Box#(Outer::Inner) box;
        function new();
            box = new;
        endfunction
    endclass
    class Base #(int N = 1);
    endclass
    class Derived #(int N = 2) extends Base;
        typedef bit [N-1:0] T;
    endclass
