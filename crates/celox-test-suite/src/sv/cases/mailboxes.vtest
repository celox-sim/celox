(group mailboxes (category sequential))

; IEEE 1800-2023 15.4: messages of a parameterized mailbox come out in the
; order they were put, num counts them, and peek copies the first one.
(case messages_come_out_in_put_order
 (source "order.sv" #"module Top(output int sum, output int first, output int count);
 mailbox #(int) m;
 initial begin
  int v;
  m = new;
  m.put(3); m.put(5); m.put(7);
  count = m.num();
  m.peek(first);
  repeat (3) begin m.get(v); sum = sum * 10 + v; end
 end
endmodule"#)
 (top Top) (run_until 0) (assert_eq sum 357) (assert_eq first 3) (assert_eq count 3))

; 15.4.3, 15.4.5: get blocks until a message is put, and put into a full
; bounded mailbox blocks until a get makes room.
(case get_and_bounded_put_block
 (source "blocking.sv" #"module Top(output int got, output int got_at, output int put_at);
 mailbox #(int) m;
 initial begin
  m = new(1);
  fork
   begin m.get(got); got_at = $time; end
   begin #1 m.put(4); end
   begin #2 m.put(5); m.put(6); put_at = $time; end
   begin #4 m.get(got); end
  join
 end
endmodule"#)
 (top Top) (run_until 1) (assert_eq got 4) (assert_eq got_at 1)
 (run_until 3) (assert_eq put_at 0)
 (run_until 4) (assert_eq got 5) (assert_eq put_at 4))

; 15.4.4, 15.4.6, 15.4.8: the try methods return 0 instead of blocking.
(case try_methods_do_not_block
 (source "try.sv" #"module Top(output bit [4:0] q, output int v);
 mailbox #(int) m;
 initial begin
  m = new(1);
  q[0] = m.try_get(v) == 0;
  q[1] = m.try_peek(v) == 0;
  q[2] = m.try_put(8) != 0;
  q[3] = m.try_put(9) == 0;
  q[4] = m.try_get(v) != 0;
 end
endmodule"#)
 (top Top) (run_until 0) (assert_eq q 31) (assert_eq v 8))

; 15.4.9: mailboxes of strings and of class handles, as uvm_tlm_fifo holds
; transactions.
(case strings_and_class_handles
 (source "handles.sv" #"module Top(output int id, output bit same);
 class Item;
  int id;
  function new(int i); id = i; endfunction
 endclass
 class Fifo #(type T = int);
  local mailbox #(T) m;
  function new(int size = 1); m = new(size); endfunction
  task put(input T t); m.put(t); endtask
  task get(output T t); m.get(t); endtask
 endclass
 Fifo #(Item) items;
 mailbox #(string) names;
 initial begin
  Item a, b;
  string s;
  items = new;
  names = new;
  a = new(5);
  names.put("abc");
  fork
   items.put(a);
   items.get(b);
  join
  names.get(s);
  id = b.id;
  same = a == b && s == "abc";
 end
endmodule"#)
 (top Top) (run_until 0) (assert_eq id 5) (assert_eq same 1))

; 15.4.3, 15.4.5, 15.4.7: processes that block in the same task, each on its
; own mailbox, and are served in the same time slot each go on with their own
; message, and only once: the peeked message is the one taken, and a later
; put waits for room of its own, also after another process's put in the
; task went through. The tasks are recursive, so they are called out of line.
(case processes_blocked_in_one_task_keep_their_own_messages
 (source "shared_task.sv" #"module Top(output int got1, output int got2, output int left1, output int left2,
           output int order3, output int order4);
 mailbox #(int) m1, m2, m3, m4, spare;
 task automatic peek_in(mailbox #(int) m, output int v, input int depth);
  if (depth > 0) peek_in(m, v, depth - 1);
  else m.peek(v);
 endtask
 task automatic put_in(mailbox #(int) m, input int v, input int depth);
  if (depth > 0) put_in(m, v, depth - 1);
  else m.put(v);
 endtask
 task automatic take(mailbox #(int) m, output int v, output int left);
  int p, t;
  peek_in(m, p, 1);
  #1;
  void'(m.try_get(t));
  v = p * 100 + t;
  left = m.num();
 endtask
 task automatic give(mailbox #(int) m, input int base);
  put_in(m, base + 1, 1);
  put_in(spare, base, 1);
  #1;
  put_in(m, base + 2, 1);
 endtask
 task automatic drain(mailbox #(int) m, output int order);
  int v;
  repeat (3) begin #2 m.get(v); order = order * 10 + v; end
 endtask
 initial begin
  m1 = new(1); m2 = new(1); m3 = new(1); m4 = new(1); spare = new;
  void'(m3.try_put(0)); void'(m4.try_put(5));
  fork
   take(m1, got1, left1);
   take(m2, got2, left2);
   begin #1 void'(m1.try_put(3)); void'(m2.try_put(4)); end
   give(m3, 0);
   give(m4, 5);
   drain(m3, order3);
   drain(m4, order4);
  join
 end
endmodule"#)
 (top Top) (run_until 10) (assert_eq got1 303) (assert_eq got2 404)
 (assert_eq left1 0) (assert_eq left2 0) (assert_eq order3 12) (assert_eq order4 567))
