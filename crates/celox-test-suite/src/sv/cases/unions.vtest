(group unions (category types))

(case packed_overlay
  (source "union.sv" #"
module Top(input bit clk, input logic [15:0] raw, input logic [3:0] nibble,
           output logic [15:0] value, saved, output logic [7:0] low,
           output logic signed [31:0] extended);
    typedef union packed signed {
        logic [15:0] bits;
        struct packed { logic [7:0] hi, lo; } parts;
    } overlay_t;
    overlay_t data, stored;
    always_comb begin
        data.bits = raw;
        data.parts.lo[3:0] = nibble;
    end
    always_ff @(posedge clk) stored <= data;
    assign value = data.bits;
    assign low = data.parts.lo;
    assign extended = data;
    assign saved = stored.parts;
endmodule
"#)
  (top Top)
  (for (r n) (list (0 15) (0xa53c 6) (0x7fff 0) (0xffff 1))
    (modify (set raw r) (set nibble n))
    (let expected (| (& r 0xfff0) n))
    (assert_eq value expected)
    (assert_eq low (& expected 255))
    (if (& expected 0x8000)
      (assert_eq extended (| expected 0xffff0000))
      (assert_eq extended expected))
    (tick clk)
    (assert_eq saved expected)))

(case soft_overlay
  (source "soft_union.sv" #"
module Top(input bit clk, input logic [15:0] raw, input logic [3:0] nibble,
           output logic [15:0] value, saved, output logic [7:0] low,
           output logic [31:0] width);
    typedef union soft packed {
        logic [15:0] bits;
        union soft { logic [7:0] byte_value; logic [3:0] nibble_value; } nested;
    } overlay_t;
    overlay_t data, stored;
    always_comb begin
        data.bits = raw;
        data.nested.nibble_value = nibble;
    end
    always_ff @(posedge clk) begin
        stored.bits <= raw;
        stored.nested.nibble_value <= nibble;
    end
    assign value = data;
    assign low = data.nested.byte_value;
    assign saved = stored;
    assign width = $bits(overlay_t);
endmodule
"#)
  (top Top)
  (assert_eq width 16)
  (for (r n) (list (0 15) (0xa53c 6) (0x7fff 0) (0xffff 1))
    (modify (set raw r) (set nibble n))
    (let expected (| (& r 0xfff0) n))
    (assert_eq value expected)
    (assert_eq low (& expected 255))
    (tick clk)
    (assert_eq saved expected)))

(case packed_mixed_state
  (four_state)
  (source "union_state.sv" #"
module Top(input logic [7:0] raw, output logic [7:0] four, two, written);
    union packed { logic [7:0] four_value; bit [7:0] two_value; } data, clean;
    assign data.four_value = raw;
    assign clean.two_value = raw;
    assign four = data.four_value;
    assign two = data.two_value;
    assign written = clean.four_value;
endmodule
"#)
  (top Top)
  (for (v m) (list (0xa5 0) (0xa5 0x0f) (0xff 0xff) (0 0xff))
    (modify (set raw (fourstate v m)))
    (assert_eq four (fourstate v m))
    (assert_eq two (& v (^ m 255)))
    (assert_eq written (& v (^ m 255)))))

(case soft_wide_four_state
  (four_state)
  (source "soft_union_wide.sv" #"
module Top(input bit clk, input logic [129:0] raw, input logic [7:0] byte_value,
           output logic [129:0] value, saved);
    union soft { logic [129:0] wide; logic [7:0] narrow_value; } data, stored;
    always_comb begin
        data.wide = raw;
        data.narrow_value = byte_value;
    end
    always_ff @(posedge clk) stored <= data;
    assign value = data.wide;
    assign saved = stored.wide;
endmodule
"#)
  (top Top)
  (for bit (list 0 7 8 63 64 127 128 129)
    (let v (| (<< 1 bit) 0x5a))
    (let m (<< 1 bit))
    (modify (set raw (fourstate v m)) (set byte_value (fourstate 0xa5 0x0f)))
    (let upper_mask (- (<< 1 130) 256))
    (let expected (fourstate (| (& v upper_mask) 0xa5) (| (& m upper_mask) 0x0f)))
    (assert_eq value expected)
    (tick clk)
    (assert_eq saved expected)))

(case soft_signed_ports
  (source "soft_union_ports.sv" #"
package Types;
    typedef union soft packed signed {
        logic signed [3:0] nibble_value;
        logic [7:0] byte_value;
    } overlay_t;
endpackage
module Update(input Types::overlay_t incoming, input logic [3:0] nibble,
              output Types::overlay_t outgoing);
    always_comb begin
        outgoing = incoming;
        outgoing.nibble_value = nibble;
    end
endmodule
module Top(input logic [7:0] raw, input logic [3:0] nibble,
           output logic [15:0] extended, member_extended,
           output logic [7:0] value);
    Types::overlay_t incoming, outgoing;
    assign incoming = raw;
    Update update_value(.incoming(incoming), .nibble(nibble), .outgoing(outgoing));
    assign value = outgoing;
    assign extended = outgoing;
    assign member_extended = outgoing.nibble_value;
endmodule
"#)
  (top Top)
  (for (r n e me) (list (0xa5 6 0xffa6 6) (0x75 15 0x7f 0xffff) (0 8 8 0xfff8))
    (modify (set raw r) (set nibble n))
    (assert_eq value (& e 255))
    (assert_eq extended e)
    (assert_eq member_extended me)))

; IEEE 1800-2023 7.3: an unpacked union is a single storage accessed
; through any of its members. Integral members share the storage aligned
; at its least significant bits, so writing one member determines the low
; bits read through another; a whole-union assignment and equality compare
; the storage, and `$bits` is the widest member.
(case unpacked_overlay
  (source "unpacked_union.sv" #"
module Top(output logic [7:0] wide, arr_wide, output logic [3:0] narrow,
           output bit same, output int unsigned bits);
    typedef union { bit [7:0] v1; bit [3:0] v2; } u_t;
    u_t un, copy_;
    u_t arr[2];
    always_comb begin
        un.v1 = 8'd140;
        narrow = un.v2;
        copy_ = un;
        same = copy_ == un;
        copy_.v2 = 4'd5;
        wide = copy_.v1;
        bits = $bits(u_t);
        arr[1].v1 = 8'h3c;
        arr[0] = arr[1];
        arr_wide = arr[0].v1;
    end
endmodule
"#)
  (top Top) (run_until 0)
  (assert_eq narrow 12) (assert_eq wide 133) (assert_eq same 1)
  (assert_eq bits 8) (assert_eq arr_wide 60))

(case unpacked_four_state
  (four_state)
  (source "unpacked_union_four_state.sv" #"
module Top(input logic [7:0] raw, output logic [3:0] narrow,
           output logic [7:0] wide);
    union { logic [7:0] v1; logic [3:0] v2; } data;
    always_comb begin
        data.v1 = raw;
        narrow = data.v2;
        wide = data.v1;
    end
endmodule
"#)
  (top Top)
  (modify (set raw (fourstate 0xa0 0x0c)))
  (assert_eq narrow (fourstate 0 12))
  (assert_eq wide (fourstate 0xa0 12)))

(case unpacked_whole_values
  ; A whole unpacked union is assigned to a place of its type, also an
  ; element of an array of them and through a function, compared for
  ; equality and chosen by a conditional (7.3); its storage is no packed
  ; dimension (20.7).
  (source "unpacked_union_whole_values.sv" #"
module Top(output logic [7:0] elem, cont, ret, pick,
           output bit same, differ, output int dims, bits);
    typedef union { bit [7:0] v1; bit [3:0] v2; } u_t;
    u_t a, b, r, p;
    u_t arr[2], held[2];
    function automatic u_t pass(u_t x);
        return x;
    endfunction
    always_comb begin
        a.v1 = 8'd140;
        b.v1 = 8'd7;
        arr[1].v1 = 8'h3c;
        arr[0] = arr[1];
        elem = arr[0].v1;
        r = pass(a);
        ret = r.v1;
        same = arr[0] == arr[1];
        differ = a != b;
        p = differ ? b : a;
        pick = p.v1;
        dims = $dimensions(a);
        bits = $bits(a);
    end
    assign held[0] = a;
    assign cont = held[0].v1;
endmodule
"#)
  (top Top) (run_until 0)
  (assert_eq elem 60) (assert_eq cont 140) (assert_eq ret 140) (assert_eq pick 7)
  (assert_eq same 1) (assert_eq differ 1) (assert_eq dims 0) (assert_eq bits 8))

(case unpacked_four_state_equality
  ; An equality of unpacked unions with four-state members is unknown
  ; where a member bit is (11.4.5).
  (four_state)
  (source "unpacked_union_four_state_equality.sv" #"
module Top(input logic [7:0] raw, output logic eq, output logic same);
    typedef union { logic [7:0] a; logic [3:0] b; } l_t;
    l_t u, v;
    always_comb begin
        u.a = raw;
        v.a = 8'h00;
        eq = u == v;
        same = v == v;
    end
endmodule
"#)
  (top Top)
  (modify (set raw (fourstate 0xf0 0xf0)))
  (assert_eq eq (fourstate 1 1)) (assert_eq same 1)
  (modify (set raw 0x01))
  (assert_eq eq 0))
