(group clocking (category sequential))

(case interface_clocking_blocks_through_virtual_interfaces
  ; The tasks of an interface instance use its own clocking block when a
  ; class calls them through a virtual interface (IEEE 1800-2023 25.9,
  ; 14.13, 14.16). Each instance's reset and first drive mature together at
  ; its first clocking event plus the `#1step` output skew, where only the
  ; last of them is driven (14.16.2).
  (source "clocking.sv" #"
interface bfm(input bit clk, output reg [7:0] q, input [7:0] d);
    clocking cb @(posedge clk);
        default input #1step output #1step;
        output q;
        input d;
    endclocking
    task automatic drive(input [7:0] v, output [7:0] sampled);
        @(cb);
        cb.q <= v;
        sampled = cb.d;
    endtask
    task reset();
        cb.q <= 0;
    endtask
endinterface
class driver;
    virtual bfm vif;
    function new(virtual bfm vif);
        this.vif = vif;
    endfunction
    task run(output bit [7:0] first, output bit [7:0] second);
        vif.reset();
        vif.drive(3, first);
        vif.drive(4, second);
    endtask
endclass
module Top(output bit [31:0] seen, output bit [7:0] q0, output bit [7:0] q1);
    bit clk;
    bit [7:0] d0, d1;
    always #5 clk = ~clk;
    bfm b0(.clk(clk), .q(q0), .d(d0));
    bfm b1(.clk(clk), .q(q1), .d(d1));
    assign d0 = q0 + 1;
    assign d1 = q1 + 10;
    initial begin
        static driver a = new(b0);
        static driver c = new(b1);
        fork
            a.run(seen[7:0], seen[15:8]);
            begin #10 c.run(seen[23:16], seen[31:24]); end
        join
    end
endmodule
"#)
  (four_state)
  (top Top) (run_until 50)
  (assert_eq seen 0x0d0a0401) (assert_eq q0 4) (assert_eq q1 4))

(case drives_before_an_event_mature_in_their_order
  ; Of the synchronous drives of a clockvar that mature together, the last
  ; executed is the one driven (IEEE 1800-2023 14.16.2), also when they were
  ; executed between clocking events: `a` by one statement three times with
  ; delays between, `b` by one statement three times without, `c` by two
  ; statements interleaved, `d` and `e` from two processes in either order,
  ; `h` with a drive through another clocking block in between, `g` at an
  ; output skew of #0 and `f` of #2 (maturing at 7), and `a` and `b` again
  ; for the next clocking event at 15.
  (source "drives.sv" #"
module Top(output bit [55:0] at6, output bit [7:0] f6, output bit [7:0] f8,
           output bit [7:0] a16, output bit [7:0] b16);
    bit clk, fclk, r;
    bit [7:0] a, b, c, d, e, f, g, h;
    always #5 clk = ~clk;
    always #1 fclk = ~fclk;
    clocking cb @(posedge clk);
        output a, b, c, d, e, h;
        output #0 g;
        output #2 f;
    endclocking
    clocking fs @(posedge fclk);
        output r;
    endclocking
    initial for (int k = 1; k <= 3; k++) begin #1; cb.a <= k; end
    initial for (int k = 1; k <= 3; k++) cb.b <= k;
    initial for (int k = 0; k < 2; k++) begin cb.c <= 10 + k; cb.c <= 20 + k; end
    initial begin #1 cb.d <= 1; end
    initial begin #2 cb.d <= 2; end
    initial begin #3 cb.e <= 1; end
    initial begin #2 cb.e <= 2; end
    initial begin #2 fs.r <= 1; cb.h <= 1; #2 cb.h <= 2; end
    initial begin #1 cb.g <= 6; #1 cb.g <= 7; end
    initial begin #1 cb.f <= 4; cb.f <= 5; end
    initial begin #6 cb.a <= 9; cb.b <= 8; #1 cb.a <= 10; end
    initial begin
        #6 at6 = {a, b, c, d, e, g, h};
        f6 = f;
        #2 f8 = f;
        #8 a16 = a;
        b16 = b;
    end
endmodule
"#)
  (four_state)
  (top Top) (run_until 30)
  (assert_eq at6 0x03031502010702) (assert_eq f6 0) (assert_eq f8 5)
  (assert_eq a16 10) (assert_eq b16 8))

(case drives_through_virtual_interfaces_mature_at_the_event
  ; Drives in an interface task called through a virtual interface between
  ; clocking events mature at the next one, the last executed driven
  ; (IEEE 1800-2023 14.16, 14.16.2, 25.9): `v` stays 0 until 5.
  (source "vif_drives.sv" #"
interface ifc(input bit clk, output bit [7:0] v);
    clocking cb @(posedge clk);
        output v;
    endclocking
    task put(input bit [7:0] x);
        cb.v <= x;
    endtask
endinterface
class user;
    virtual ifc vif;
    function new(virtual ifc vif);
        this.vif = vif;
    endfunction
    task run();
        vif.put(1);
        #1 vif.put(2);
        vif.put(3);
    endtask
endclass
module Top(output bit [7:0] v4, output bit [7:0] v6);
    bit clk;
    bit [7:0] v;
    always #5 clk = ~clk;
    ifc i(.clk(clk), .v(v));
    initial begin
        static user u = new(i);
        u.run();
    end
    initial begin
        #4 v4 = v;
        #2 v6 = v;
    end
endmodule
"#)
  (four_state)
  (top Top) (run_until 30)
  (assert_eq v4 0) (assert_eq v6 3))

(case synchronous_drives_of_recursive_functions
  ; A recursive function runs out of line, also when a task it forks drives
  ; a clocking block output (IEEE 1800-2023 13.4.2, 14.16): the drive made
  ; between clocking events matures at the event at 5, and the one made at
  ; the event at 15 at that event, both in the Re-NBA region, after the
  ; nonblocking assignment of `a` at the same edge has read `q`.
  (source "recursive_drives.sv" #"
module Top(output int n, output bit [7:0] q6, output bit [7:0] a6, output bit [7:0] a16,
           output bit [7:0] q16, output bit [7:0] a26);
    bit clk;
    bit [7:0] q, a;
    always #5 clk = ~clk;
    clocking cb @(posedge clk);
        output q;
    endclocking
    always @(posedge clk) a <= q;
    task automatic drive(input int v);
        cb.q <= v;
    endtask
    function automatic void walk(int depth, int base);
        n++;
        if (depth > 0) walk(depth - 1, base);
        if (depth == 0) fork drive(base); join_none
    endfunction
    initial begin
        walk(3, 5);
        #6 q6 = q; a6 = a;
        @(cb);
        walk(2, 10);
        #1 q16 = q; a16 = a;
        #10 a26 = a;
    end
endmodule
"#)
  (top Top) (run_until 40)
  (assert_eq n 7) (assert_eq q6 5) (assert_eq a6 0) (assert_eq a16 5)
  (assert_eq q16 10) (assert_eq a26 10))
