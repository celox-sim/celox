(group concurrent_assertions (category sequential))

; IEEE 1800-2023 16.5.1 and 16.14.1: Preponed predicate, Reactive action.
(case sampled_predicate_live_action
 (source "sampling.sv" #"module Top(output int passed, failed, action_value);
 bit clk, data;
 always @(posedge clk) data <= 1;
 p: assert property (@(posedge clk) data == 0)
    begin passed++; action_value = data; end else failed++;
 initial begin #1 clk=1; #1 clk=0; #1 clk=1; end
endmodule"#)
 (top Top) (run_until 3)
 (assert_eq passed 1) (assert_eq failed 1) (assert_eq action_value 1))

; disable iff reads the current value after NBA, not the sampled value.
(case disable_iff_after_nba
 (source "disable.sv" #"module Top(output int passed, failed);
 bit clk, reset;
 always @(posedge clk) reset <= 1;
 p: assert property (@(posedge clk) disable iff (reset) 0)
    passed++; else failed++;
 initial begin #1 clk=1; #1 clk=0; #1 clk=1; end
endmodule"#)
 (top Top) (run_until 3)
 (assert_eq passed 0) (assert_eq failed 0))

; Both Observed predicates see reset=0 before either Reactive action sets it.
(case predicates_before_all_actions
 (source "observed.sv" #"module Top(output int first, second);
 bit clk, reset;
 p: assert property (@(posedge clk) disable iff (reset) 1)
    begin first++; reset=1; end else first+=10;
 q: assert property (@(posedge clk) disable iff (reset) 1)
    second++; else second+=10;
 initial #1 clk=1;
endmodule"#)
 (top Top) (run_until 2)
 (assert_eq first 1) (assert_eq second 1))

(case assume_cover_and_generate
 (source "directives.sv" #"module Top(output int assumed, covered, generated);
 bit clk, data;
 a: assume property (@(negedge clk) data) assumed++; else assumed+=10;
 c: cover property (@(negedge clk) data) covered++;
 if (1) begin: g
   p: assert property (@(posedge clk) 1) generated++;
 end
 initial begin #1 clk=1; #1 clk=0; #1 data=1; clk=1; #1 clk=0; end
endmodule"#)
 (top Top) (run_until 4)
 (assert_eq assumed 11) (assert_eq covered 1) (assert_eq generated 2))

; An unknown predicate fails; an unknown disable condition does not disable.
(case unknown_predicates_and_disable_conditions
 (source "unknown.sv" #"module Top(output int failed, disabled_failed);
 bit clk;
 logic unknown_value;
 p: assert property (@(posedge clk) unknown_value) failed+=10; else failed++;
 q: assert property (@(posedge clk) disable iff (unknown_value) 0)
    disabled_failed+=10; else disabled_failed++;
 initial #1 clk=1;
endmodule"#)
 (top Top) (four_state) (run_until 2)
 (assert_eq failed 1) (assert_eq disabled_failed 1))


; Each function owns its history; current operands use Preponed values even
; though the producer updates data in NBA before the Observed predicate.
(case sampled_history_predicates
 (source "sampled_history_predicates.sv" #"
module Top(output int past_passed, past_failed, rose_count, fell_count,
           stable_count, changed_count, mixed_count, pure_count, nested_count,
           action_past);
 bit clk, data;
 int cycle=0;
 always @(posedge clk) begin data <= ~data; cycle<=cycle+1; end
 p: assert property (@(posedge clk) $past(data))
    begin past_passed++; action_past+=$past(data); end else past_failed++;
 r: assert property (@(posedge clk) $rose(data)) rose_count++; else;
 f: assert property (@(posedge clk) $fell(data)) fell_count++; else;
 s: assert property (@(posedge clk) $stable(data)) stable_count++; else;
 c: assert property (@(posedge clk) $changed(data)) changed_count++; else;
 m: assert property (@(posedge clk) $past(data) == !data) mixed_count++; else;
 q: assert property (@(posedge clk) $countones({data,$past(data)}) == $changed(data)) pure_count++; else;
 n: assert property (@(posedge clk) $sampled($past(data)) === $past(data)) nested_count++; else;
 initial begin
   past_passed=0; past_failed=0; rose_count=0; fell_count=0; stable_count=0;
   changed_count=0; mixed_count=0; pure_count=0; nested_count=0;
   action_past=0;
   repeat(5) begin #1 clk=1; #1 clk=0; end
 end
endmodule
"#)
 (top Top) (run_until 10)
 (assert_eq past_passed 2) (assert_eq past_failed 3)
 (assert_eq rose_count 2) (assert_eq fell_count 2)
 (assert_eq stable_count 1) (assert_eq changed_count 4)
 (assert_eq mixed_count 4) (assert_eq pure_count 5) (assert_eq nested_count 5)
 (assert_eq action_past 2))

(case sampled_history_gates_and_indices
 (source "sampled_history_gates.sv" #"
module Top(output int gate_count, depth_count, selected_count, sampled_gate_count, reactive_gate_count);
 bit clk, data, enable, index, reactive_gate;
 bit [1:0] bits_value=2'b10;
 int cycle=0;
 always @(posedge clk) begin
   data <= ~data; enable <= ~enable; index <= ~index;
   bits_value <= ~bits_value; cycle <= cycle+1;
 end
 g: assert property (@(posedge clk) $past(data,1,enable) === (cycle>=2)) gate_count++; else;
 s: assert property (@(posedge clk) $past(data,1,$sampled(enable)) === (cycle>=2)) sampled_gate_count++; else;
 r: assert property (@(posedge clk) $past(data,1,reactive_gate) === (cycle>=2))
    begin reactive_gate_count++; reactive_gate=~reactive_gate; end
    else reactive_gate=~reactive_gate;
 d: assert property (@(posedge clk) $past(data,2,enable) === (cycle>=4)) depth_count++; else;
 i: assert property (@(posedge clk) bits_value[$past(index)]) selected_count++; else;
 initial begin
   gate_count=0; depth_count=0; selected_count=0; sampled_gate_count=0; reactive_gate_count=0;
   repeat(5) begin #1 clk=1; #1 clk=0; end
 end
endmodule
"#)
 (top Top) (run_until 10)
 (assert_eq gate_count 5) (assert_eq depth_count 5) (assert_eq selected_count 4)
 (assert_eq sampled_gate_count 5) (assert_eq reactive_gate_count 5))

(case sampled_history_unknown_transitions
 (four_state)
 (source "sampled_history_unknown.sv" #"
module Top(output int rose_count, fell_count, stable_count, changed_count, nested_count);
 bit clk;
 logic value=1'bx;
 int cycle=0;
 always @(posedge clk) begin
   case(cycle)
     0: value<=1'bz;
     1: value<=1'b0;
     2: value<=1'b1;
     default: value<=1'b0;
   endcase
   cycle<=cycle+1;
 end
 r: assert property (@(posedge clk) $rose(value)) rose_count++; else;
 f: assert property (@(posedge clk) $fell(value)) fell_count++; else;
 s: assert property (@(posedge clk) $stable(value)) stable_count++; else;
 c: assert property (@(posedge clk) $changed(value)) changed_count++; else;
 n: assert property (@(posedge clk) $sampled($past(value)) === $past(value)) nested_count++; else;
 initial begin
   rose_count=0; fell_count=0; stable_count=0; changed_count=0; nested_count=0;
   repeat(5) begin #1 clk=1; #1 clk=0; end
 end
endmodule
"#)
 (top Top) (run_until 10)
 (assert_eq rose_count 1) (assert_eq fell_count 2)
 (assert_eq stable_count 1) (assert_eq changed_count 4) (assert_eq nested_count 5))

; Explicit nesting in a normal clocked procedure uses the same sampled and
; history bindings, including temporal functions inside select positions.
(case sampled_history_explicit_nesting
 (source "sampled_history_explicit.sv" #"
module Top(input bit clk, input bit [7:0] a, input bit index,
           output bit [7:0] past_value, mixed, depth, current_value,
           output bit selected);
 bit [3:0] data=4'b1010;
 always_ff @(posedge clk) begin
   past_value <= $sampled($past(a));
   mixed <= $sampled($past(a)+a);
   depth <= $sampled($sampled(a)+$past(a,2));
   current_value <= $sampled(a);
   selected <= $sampled(data[$past(index)]);
 end
endmodule
"#)
 (top Top)
 (for value (list 1 2 3 4)
   (modify (set a value) (set index (% value 2)))
   (tick clk)
   (assert_eq past_value (- value 1))
   (assert_eq mixed (- (* 2 value) 1))
   (assert_eq depth (+ value (max 0 (- value 2))))
   (assert_eq current_value value)
   (assert_eq selected (- 1 (% value 2)))))


; History advances on every clock even when disable iff suppresses evaluation.
(case sampled_history_while_disabled
 (source "sampled_history_disabled.sv" #"
module Top(output int passed, failed);
 bit clk, data;
 int cycle=0;
 always @(posedge clk) begin data<=~data; cycle<=cycle+1; end
 p: assert property (@(posedge clk) disable iff(cycle<=2) $past(data)) passed++; else failed++;
 initial begin
   passed=0; failed=0;
   repeat(5) begin #1 clk=1; #1 clk=0; end
 end
endmodule
"#)
 (top Top) (run_until 10) (assert_eq passed 2) (assert_eq failed 1))

; IEEE 1800-2023 16.12.7: a single-cycle antecedent starts its consequent
; at the same sampled tick; no antecedent match makes the implication true.
(case overlapped_boolean_implication
 (source "overlapped.sv" #"module Top(output int passed, failed);
 bit clk, request, ready;
 always @(posedge clk) begin request <= ~request; ready <= ~ready; end
 p: assert property (@(posedge clk) request |-> ready)
    passed++; else failed++;
 initial begin
   #1 clk=1; #1 clk=0;
   #1 clk=1; #1 clk=0;
   #1 clk=1; #1 clk=0;
   ready=0;
   #1 clk=1;
 end
endmodule"#)
 (top Top) (run_until 7)
 (assert_eq passed 3) (assert_eq failed 1))

(case overlapped_unknown_antecedent
 (source "overlapped_unknown.sv" #"module Top(output int passed, failed);
 bit clk;
 logic [1:0] request, ready;
 p: assert property (@(posedge clk) request |-> ready) passed++; else failed++;
 initial begin
   request=2'bx0; ready=2'bxx;
   #1 clk=1; #1 clk=0;
   request=2'b1x;
   #1 clk=1; #1 clk=0;
   ready=2'b1x;
   #1 clk=1;
 end
endmodule"#)
 (top Top) (four_state) (run_until 5)
 (assert_eq passed 2) (assert_eq failed 1))

; IEEE 1800-2023 16.14.1: an action is any statement, including calls of
; functions and untimed tasks, which run in Reactive and see the NBA update.
(case subroutine_calls_in_actions
 (source "actions.sv" #"package report;
 int count;
 function automatic bit enabled(int level); return level < 2; endfunction
 function automatic void note(int value); count += value; endfunction
endpackage
class Log;
 static int total;
 int seen;
 static function void add(int value); total += value; endfunction
 function void see(int value); seen += value; endfunction
endclass
module Top(output int passed, failed, noted, logged, seen, traced, sampled);
 bit clk, data;
 Log log = new;
 function int bump(int by); passed += by; return passed; endfunction
 task automatic inner(int value); traced = traced * 10 + value; endtask
 task automatic trace(int value); inner(value); inner(value + 1); endtask
 always @(posedge clk) data <= ~data;
 p: assert property (@(posedge clk) data == 0)
    begin void'(bump(1)); trace(1); sampled = data; end
    else begin
      if (report::enabled(1)) report::note(failed + 5);
      failed++;
      Log::add(2);
      log.see(3);
      seen = log.seen;
    end
 assign noted = report::count;
 assign logged = Log::total;
 initial begin #1 clk=1; #1 clk=0; #1 clk=1; #1 clk=0; #1 clk=1; end
endmodule"#)
 (top Top) (run_until 5)
 (assert_eq passed 2) (assert_eq failed 1) (assert_eq noted 5)
 (assert_eq logged 2) (assert_eq seen 3) (assert_eq traced 1212)
 (assert_eq sampled 1))

; IEEE 1800-2023 16.8, 16.12: instances of named sequences and properties
; take the clock and disable condition of their declaration, or the
; assertion's clock; a declaration may follow its instances.
(case named_sequences_and_properties
 (source "named.sv" #"module Top(output int passed, failed, chain_failed);
 bit clk, rst;
 int cnt;
 always @(posedge clk) cnt <= cnt + 1;
 even_check: assert property (even) passed++; else failed++;
 property even;
  @(posedge clk) disable iff (rst) cnt[0] == 0;
 endproperty : even
 sequence odd; cnt[0]; endsequence
 property big; cnt > 1; endproperty
 property chain; odd |-> big; endproperty
 assert property (@(posedge clk) chain) else chain_failed++;
 initial begin
  #1 clk = 1; #1 clk = 0; #1 clk = 1; #1 clk = 0; #1 clk = 1; #1 clk = 0;
  rst = 1; #1 clk = 1;
 end
endmodule"#)
 (top Top) (run_until 8)
 (assert_eq passed 2) (assert_eq failed 1) (assert_eq chain_failed 1))

; IEEE 1800-2023 16.16.1: the semantic leading clock of @(c) m is that of
; m when m has an explicit one, so the sequence's negedge clocks the check;
; that of m |-> p is that of m, so a clocked antecedent clocks it.
(case named_sequence_leading_clock
 (source "leading.sv" #"module Top(output int low_passed, low_failed, tick_failed);
 bit clk;
 int cnt;
 always @(posedge clk) cnt <= cnt + 1;
 sequence low;
  @(negedge clk) cnt < 2;
 endsequence
 assert property (@(posedge clk) low) low_passed++; else low_failed++;
 sequence tick; @(posedge clk) cnt == 2; endsequence
 sequence zero; cnt == 0; endsequence
 assert property (tick |-> zero) else tick_failed++;
 initial begin
  #1 clk = 1; #1 clk = 0; #1 clk = 1; #1 clk = 0; #1 clk = 1; #1 clk = 0;
  #1 clk = 1;
 end
endmodule"#)
 (top Top) (run_until 8)
 (assert_eq low_passed 1) (assert_eq low_failed 2) (assert_eq tick_failed 1))

; Sequences over cycles (IEEE 1800-2023 16.7, 16.10, 16.11): every tick
; starts an attempt, a fixed `##n` moves it to a later tick, a local
; variable keeps the value its match item sampled, and a match-item call
; sees it and the sampled values of its other arguments.
(case sequences_over_cycles
 (source "cycles.sv" #"module Top(output int s_passed, s_failed, p_failed, noted, sum, q_failed,
  output int w_failed, d_passed, d_failed, seen_sum, g_passed, g_failed,
  output int i_passed, i_failed, acc, order, c_failed);
 bit clk;
 int cnt;
 int out;
 always @(posedge clk) cnt <= cnt + 1;
 assign out = cnt == 12 ? 0 : (cnt - 3) * 10 + 7;
 function automatic void note(int value);
  noted++;
  sum += value;
 endfunction
 function automatic void seen(int value);
  seen_sum += value;
 endfunction
 function automatic void pair(input int v, ref int sink);
  sink += v;
 endfunction
 function automatic void step(int v);
  order = order * 10 + v;
 endfunction
 sequence s; @(posedge clk) cnt % 4 == 1 ##1 cnt % 4 == 2; endsequence
 assert property (s) s_passed++; else s_failed++;
 assert property (@(posedge clk) (cnt % 4 == 1 ##1 cnt % 4 == 2)) g_passed++; else g_failed++;
 assert property (@(posedge clk) cnt inside {1, 5} ##1 cnt % 4 == 2) i_passed++; else i_failed++;
 // Steps of one tick run their calls in order (`##0`).
 assert property (@(posedge clk) (cnt % 4 == 1, step(1)) ##0 (1, step(2)) |-> 1);
 // Operator assignments and increments read the local's previous value.
 property c; int y; @(posedge clk) (cnt % 4 == 1, y = cnt, y += 10, y++) |=> cnt == y - 10; endproperty
 assert property (c) else c_failed++;
 property p;
  int x;
  @(posedge clk) (cnt % 4 == 1, x = cnt * 10) |-> ##3 (out == x + 7, note(x), seen(cnt * 2), pair(.sink(acc), .v(cnt)));
 endproperty
 assert property (p) else p_failed++;
 assert property (@(posedge clk) cnt % 4 == 2 |=> cnt % 4 == 0) else q_failed++;
 // A match item converts its value to the local's type.
 property w; bit [3:0] y; @(posedge clk) (cnt % 4 == 1, y = 5'h1f) |-> y == 4'hf; endproperty
 assert property (w) else w_failed++;
 // `disable iff` reads the current value of `cnt`, one more than sampled.
 property d; int z; @(posedge clk) disable iff (cnt >= 8) (1, z = cnt) |-> z < 8; endproperty
 assert property (d) d_passed++; else d_failed++;
 initial repeat (20) begin #1 clk = 1; #1 clk = 0; end
endmodule"#)
 (top Top) (run_until 41)
 (assert_eq s_passed 5) (assert_eq s_failed 15) (assert_eq p_failed 1)
 (assert_eq noted 3) (assert_eq sum 190) (assert_eq q_failed 5)
 (assert_eq w_failed 0) (assert_eq d_passed 7) (assert_eq d_failed 0)
 (assert_eq seen_sum 56) (assert_eq g_passed 5) (assert_eq g_failed 15)
 (assert_eq i_passed 2) (assert_eq i_failed 18) (assert_eq acc 28)
 (assert_eq order 1212121212) (assert_eq c_failed 0))

(case sequence_values_over_sampled_ticks
 (source "sampled.sv" #"module Top(output int marks, n_passed, n_failed, kept, f_failed,
  output int r_failed, r_negated, r_single);
 bit clk;
 int cnt;
 bit [7:0] bus = 8'b0100_0100;
 always @(posedge clk) cnt <= cnt + 1;
 function automatic void mark();
  marks++;
 endfunction
 function automatic void keep(int value);
  kept += value;
 endfunction
 // A named sequence of one tick with a match item is an antecedent.
 sequence n; (cnt % 4 == 1, mark()); endsequence
 assert property (@(posedge clk) n |-> cnt % 8 == 1) n_passed++; else n_failed++;
 // A local takes the value over the sampled values of its tick (16.10):
 // `cnt`, there one less than its value after the clock's NBA.
 property v; int x; @(posedge clk) (cnt % 4 == 1, x = $countones(cnt) + cnt) |=> (1, keep(x)); endproperty
 assert property (v);
 // A select's bound is sampled, also beside a function call (16.6).
 assert property (@(posedge clk) cnt % 4 == 1 |=> bus[cnt % 8] && $countones(cnt) > 0) else f_failed++;
 // A sampled-value function decides its step at that step's tick.
 assert property (@(posedge clk) $rose(cnt[1]) |=> cnt[1]) else r_failed++;
 assert property (@(posedge clk) $rose(cnt[1]) |=> !cnt[1]) else r_negated++;
 assert property (@(posedge clk) $rose(cnt[1]) |-> !cnt[1]) else r_single++;
 initial repeat (20) begin #1 clk = 1; #1 clk = 0; end
endmodule"#)
 (top Top) (run_until 41)
 (assert_eq marks 5) (assert_eq n_passed 18) (assert_eq n_failed 2)
 (assert_eq kept 55) (assert_eq f_failed 0) (assert_eq r_failed 0)
 (assert_eq r_negated 5) (assert_eq r_single 5))

; IEEE 1800-2023 16.12.8: `p iff q` holds when both Booleans are true or
; both false, X counting as false; it binds tighter than `|->` (Table
; 16-3), also as the body of a named property behind an implication.
(case boolean_iff_properties
 (source "iff.sv" #"module Top(output int p1, f1, p2, f2);
 bit clk;
 logic a, b, c;
 property eq;
  a iff b;
 endproperty
 assert property (@(posedge clk) a iff b) p1++; else f1++;
 assert property (@(posedge clk) c |-> eq) p2++; else f2++;
 initial begin
  {a, b, c} = 3'b001; #1 clk = 1; #1 clk = 0;
  {a, b, c} = 3'b111; #1 clk = 1; #1 clk = 0;
  {a, b, c} = 3'b100; #1 clk = 1; #1 clk = 0;
  {a, b, c} = 3'b011; #1 clk = 1; #1 clk = 0;
  a = 1'bx; b = 0; c = 1; #1 clk = 1; #1 clk = 0;
 end
endmodule"#)
 (top Top) (four_state) (run_until 11)
 (assert_eq p1 3) (assert_eq f1 2) (assert_eq p2 4) (assert_eq f2 1))

; IEEE 1800-2023 16.17: `expect` blocks the process for one attempt that
; starts at the next clocking event, decides each step on sampled values,
; then runs its pass or fail statement and goes on: after a match, after a
; vacuous implication, in an automatic task with an argument, and failing
; on a sampled value that a nonblocking assignment changes at that edge,
; and through a named sequence.
(case expect_statements
 (source "expect.sv" #"module Top(output int r1, r2, r3, r4, t1, nb);
 bit clk;
 logic a, b, c;
 always @(posedge clk) nb <= nb + 1;
 task automatic wait_for(int value, output bit ok);
  expect (@(posedge clk) ##1 nb == value) ok = 1; else ok = 0;
 endtask
 sequence a2b;
  a ##2 b;
 endsequence
 initial begin
  a = 1; b = 0; c = 0;
  #1 expect (@(posedge clk) a ##1 b) r1 = 1; else r1 = 2;
  t1 = int'($time);
  expect (@(posedge clk) c |-> a) r2 = 1; else r2 = 2;
  begin bit ok; wait_for(5, ok); r3 = ok ? 1 : 2; end
  expect (@(posedge clk) a2b) r4 = 1; else r4 = 2;
 end
 initial begin #12 b = 1; #10 b = 0; end
 initial repeat (20) begin #5 clk = 1; #5 clk = 0; end
endmodule"#)
 (top Top) (run_until 200)
 (assert_eq r1 1) (assert_eq r2 1) (assert_eq r3 2) (assert_eq r4 2)
 (assert_eq t1 15) (assert_eq nb 20))
