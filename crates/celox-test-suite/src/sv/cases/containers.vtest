(group containers (category types))

(case dynamic_resize_and_copy
  (source "containers.sv" #"
module Top(output bit [7:0] flags);
    bit [31:0] a[], b[];
    initial begin
        flags[0] = a.size() == 0;
        a = new[3];
        a[0] = 11; a[1] = 22; a[2] = 33;
        b = a;
        a[0] = 99;
        flags[1] = b[0] == 11;
        a = new[5](a);
        flags[2] = a.size() == 5 && a[0] == 99 && a[2] == 33 && a[4] == 0;
        a = new[1](b);
        flags[3] = a.size() == 1 && a[0] == 11;
        a[-1] = 9; a[3] = 8;
        flags[4] = a[0] == 11 && a[-1] == 0 && a[3] == 0;
        a.delete();
        flags[5] = a.size() == 0 && b.size() == 3;
        a = '{4, 5, 6};
        flags[6] = a.size() == 3 && a[2] == 6;
        a = new[0];
        flags[7] = a.size() == 0;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq flags 255))

(case queue_methods
