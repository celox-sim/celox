    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq flags 15))

(case array_reduction_empty_identities
  (source "empty_reductions.sv" #"
module Top(output bit [7:0] flags);
    bit [7:0] values[], q[$], numbers[int], words[string];
    bit [63:0] wide[];
    bit single[$];
    logic [7:0] logic_values[];
    initial begin
        flags[0] = values.product() == 1 && values.and() == 8'hff;
        flags[1] = q.product() == 1 && q.and() == 8'hff;
        flags[2] = numbers.product() == 1 && numbers.and() == 8'hff;
        flags[3] = words.product() == 1 && words.and() == 8'hff;
        flags[4] = wide.product() == 64'd1 && wide.and() == 64'hffffffffffffffff;
        flags[5] = single.product() == 1'b1 && single.and() == 1'b1;
        flags[6] = values.sum() == 0 && values.or() == 0 && values.xor() == 0;
        flags[7] = logic_values.product() === 8'h01 && logic_values.and() === 8'hff;
    end
endmodule
"#)
  (four_state)
  (top Top) (run_until 0) (assert_eq flags 255))
