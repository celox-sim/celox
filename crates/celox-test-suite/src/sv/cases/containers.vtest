        flags[1] = copy_values[0] == left && copy_values[1] == right && copy_values[2] == null;
        q = values; q.reverse(); selected = q[0]; selected.value = 9;
        flags[2] = left.value == 9 && q[0] == left && q[1] == right && q[2] == null;
        values.delete(); copy_values.delete(); left = null; right = null; selected = null;
        #1 selected = q[0];
        flags[3] = selected.value == 9;
    end
endmodule
