        flags[7] = q.size == 2 && q[0] == 2 && q[1] == 1;
        q.delete;
        flags[8] = q.size == 0;
        numbers[-1] = 10; numbers[5] = 20;
        flags[9] = numbers.size == 2 && numbers.num == 2;
        words["first"] = 10; words["second"] = 20; words.delete("first");
        flags[10] = words.size == 1 && words.num == 1 && words["second"] == 20;
        numbers.delete; words.delete; q.size;
        flags[11] = numbers.num == 0 && words.size == 0;
        strings = {"first", "last"}; text = strings.pop_front;
        flags[12] = text == "first" && strings.size == 1;
        text = strings.pop_back;
        flags[13] = text == "last" && strings.size == 0;
        original = new; original.n = 9; objects.push_back(original); popped = objects.pop_front;
        flags[14] = popped == original && popped.n == 9 && objects.size == 0;
    end
endmodule
