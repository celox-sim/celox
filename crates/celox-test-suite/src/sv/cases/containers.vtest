module Top(output bit done);
    int q[$][$];
    int a[2][3];
    int n, m, c;
    initial begin
        q.push_back('{1, 2});
        q.push_back('{3});
        foreach (q[i, j]) begin
            n++;
            if (q[i][j] == 2) break;
        end
        foreach (a[i, j]) begin
            m++;
            if (j == 1) break;
        end
        foreach (q[i, j]) begin
            if (j == 0) continue;
            c++;
