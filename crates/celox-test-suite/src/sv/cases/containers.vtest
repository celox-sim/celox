(case foreach_and_control_flow
  (source "containers.sv" #"
module Top(output bit [3:0] flags);
    int a[], q[$], aa[int];
    int sum;
    initial begin
        a = '{10, 20, 30};
        sum = 0;
        foreach (a[i]) sum += a[i];
        flags[0] = sum == 60;
        q = {2, 4, 6};
        sum = 0;
        foreach (q[i]) begin
            if (i == 1) continue;
            sum += q[i];
        end
        flags[1] = sum == 8;
        aa[-3] = 30; aa[0] = 10; aa[4] = 40;
        sum = 0;
        foreach (aa[key]) begin
            sum += key + aa[key];
            if (key == 0) break;
        end
        flags[2] = sum == 37;
        a.delete(); sum = 0;
        foreach (a[i]) sum += 1;
        flags[3] = sum == 0;
    end
