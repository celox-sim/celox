(group containers (category types))

(case class_container_inheritance_static
  (source "class_containers.sv" #"
module Top(output bit [3:0] flags);
    class Base;
        protected int q[$];
        static int counts[string];
        function void push(int value); q.push_back(value); endfunction
        function int count(); return q.size(); endfunction
    endclass
    class Derived extends Base;
        function int pop(); return super.q.pop_front(); endfunction
        function void shadow();
            int q[$];
            q.push_back(99);
            this.q.push_back(7);
        endfunction
    endclass
    Derived d;
    Base alias_d;
    int value;
    initial begin
        d = new; alias_d = d; d.push(3); d.shadow();
        flags[0] = alias_d.count() == 2;
        value = d.pop();
        flags[1] = value == 3 && d.count() == 1;
        Base::counts["shared"] = 4;
        flags[2] = d.counts["shared"] == 4;
        d.counts["shared"] = 8;
        flags[3] = Base::counts.num() == 1 && alias_d.counts["shared"] == 8;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq flags 15))

