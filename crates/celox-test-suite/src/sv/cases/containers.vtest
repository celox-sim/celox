(case class_container_copy_and_gc
  (source "class_containers.sv" #"
module Top(output bit [3:0] flags);
    class Store;
        string words[$];
        int data[];
        function void append(string value); words.push_back(value); endfunction
    endclass
    Store original, copy_object, garbage;
    int i;
    initial begin
        original = new; original.append("live"); original.data = '{1, 2};
        copy_object = new original;
        copy_object.words.push_back("copy"); copy_object.data[0] = 9;
        flags[0] = original.words.size() == 1 && original.words[0] == "live";
        flags[1] = original.data[0] == 1 && copy_object.data[0] == 9;
        original = null;
        for (i = 0; i < 1100; i++) garbage = new;
        garbage = null;
        #1;
        flags[2] = copy_object.words[0] == "live" && copy_object.words[1] == "copy";
        copy_object.append("third");
        flags[3] = copy_object.words.size() == 3 && copy_object.words[2] == "third";
    end
endmodule
"#)
  (top Top) (run_until 1) (assert_eq flags 15))

(case ordering_integral
  (source "ordering.sv" #"
module Top(output bit [10:0] flags);
    byte values[], copy_values[], bounded[$:3];
    bit [63:0] unsigned_values[$];
    longint signed_values[];
    initial begin
        values = '{127, -128, 3, -1, 3}; copy_values = values;
        values.sort;
        flags[0] = values.size() == 5 && values[0] == -128 && values[1] == -1
            && values[2] == 3 && values[3] == 3 && values[4] == 127;
        flags[1] = copy_values[0] == 127 && copy_values[1] == -128;
        values.rsort();
        flags[2] = values[0] == 127 && values[1] == 3 && values[2] == 3
            && values[3] == -1 && values[4] == -128;
        void'(values.reverse());
        flags[3] = values[0] == -128 && values[4] == 127;
        bounded = {3, -1, 2, -128}; bounded.sort();
        flags[4] = bounded.size() == 4 && bounded[0] == -128 && bounded[1] == -1
            && bounded[2] == 2 && bounded[3] == 3;
        bounded.reverse; bounded.rsort;
        flags[5] = bounded[0] == 3 && bounded[3] == -128;
        unsigned_values = {64'hffffffffffffffff, 64'd1, 64'h8000000000000000, 64'd0};
        unsigned_values.sort;
        flags[6] = unsigned_values[0] == 0 && unsigned_values[1] == 1
            && unsigned_values[2] == 64'h8000000000000000 && unsigned_values[3] == 64'hffffffffffffffff;
        signed_values = '{64'sh7fffffffffffffff, -1, 64'sh8000000000000000, 0};
        signed_values.sort();
        flags[7] = signed_values[0] == 64'sh8000000000000000 && signed_values[1] == -1
            && signed_values[2] == 0 && signed_values[3] == 64'sh7fffffffffffffff;
        values.delete(); values.reverse; values.sort; values.rsort;
        flags[8] = values.size() == 0;
        values = '{-7}; values.sort; values.rsort; values.reverse;
        flags[9] = values.size() == 1 && values[0] == -7;
        begin
            automatic byte values[] = '{2, -1};
            values.sort();
            flags[10] = values[0] == -1 && values[1] == 2;
        end
        flags[10] = flags[10] && values[0] == -7;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq flags 2047))

(case ordering_strings
  (source "ordering.sv" #"
module Top(output bit [4:0] flags);
    string words[], copy_words[], q[$];
