(case class_container_properties
  (source "class_containers.sv" #"
module Top(output bit [8:0] flags);
    class Store;
        int data[] = new[2];
        int q[$], map[string];
        function void add(int value); q.push_back(value); endfunction
        function int take(); return q.pop_front(); endfunction
        function int count(); return this.q.size(); endfunction
    endclass
    Store s, alias_s;
    int copy_values[], value;
    initial begin
        s = new; alias_s = s;
        flags[0] = s.data.size() == 2 && s.q.size() == 0 && s.map.num() == 0;
        s.data[0] = 4; s.data[1] = 5; copy_values = s.data;
        s.data[0] = 9;
        flags[1] = copy_values[0] == 4 && copy_values[1] == 5 && alias_s.data[0] == 9;
        s.add(1); s.add(2); s.q.push_back(s.q.pop_front());
        flags[2] = s.count() == 2 && s.q[0] == 2 && s.q[1] == 1;
        value = alias_s.take();
        flags[3] = value == 2 && s.q.size() == 1;
        s.map["first"] = 10; alias_s.map["second"] = 20;
        flags[4] = s.map.num() == 2 && s.map.exists("second") && s.map["first"] == 10;
        s.data = '{6, 7, 8}; s.data = new[4](s.data);
        flags[5] = s.data.size() == 4 && s.data[0] == 6 && s.data[2] == 8;
        flags[6] = s.data.sum() == 21 && $size(s.data) == 4 && $bits(s.q.pop_front()) == 32 && s.q.size() == 1;
        s.q.push_back(3); s.q.reverse();
        flags[8] = s.q[0] == 3 && s.q[1] == 1;
        s.q.sort(); flags[8] = flags[8] && s.q[0] == 1 && s.q[1] == 3;
        s.q.rsort(); flags[8] = flags[8] && s.q[0] == 3 && s.q[1] == 1;
        s.data.delete(); s.q.delete(); s.map.delete("first");
        flags[7] = s.data.size() == 0 && alias_s.q.size() == 0 && s.map.size() == 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq flags 511))

(case class_container_queue_pool
  (source "class_containers.sv" #"
module Top(output bit [5:0] flags);
    class Queue #(type T = int);
        protected T queue[$];
        virtual function void push_back(T value); queue.push_back(value); endfunction
        virtual function T pop_front(); return queue.pop_front(); endfunction
        virtual function T get(int index); return queue[index]; endfunction
        virtual function int size(); return queue.size(); endfunction
    endclass
    class Pool #(type KEY = string, type T = int);
        protected T pool[KEY];
        virtual function void add(KEY key, T value); pool[key] = value; endfunction
        virtual function T get(KEY key); return pool[key]; endfunction
        virtual function int num(); return pool.num(); endfunction
        virtual function int total();
            int result = 0;
            foreach (pool[key]) result += pool[key];
            return result;
        endfunction
    endclass
    Queue #(int) numbers;
    Queue #(string) words;
    Pool #(string, int) pool;
    int value;
    initial begin
        numbers = new; words = new; pool = new;
        numbers.push_back(11); numbers.push_back(22);
        flags[0] = numbers.size() == 2 && numbers.get(1) == 22;
        value = numbers.pop_front();
        flags[1] = value == 11 && numbers.size() == 1;
        words.push_back("alpha"); words.push_back("beta");
        flags[2] = words.pop_front() == "alpha" && words.get(0) == "beta";
        pool.add("first", 30); pool.add("second", 40);
        flags[3] = pool.num() == 2 && pool.get("second") == 40;
        flags[4] = pool.total() == 70;
        pool.add("first", 50);
        flags[5] = pool.num() == 2 && pool.total() == 90;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq flags 63))

(case class_container_strings_handles
