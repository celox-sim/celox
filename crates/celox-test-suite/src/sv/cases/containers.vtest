(case equal_updates_preserve_event_waits
  (source "containers.sv" #"
module Top(output bit done);
    int q[$], a[], count, before_count;
    initial begin
        q = {1}; a = '{2};
        #1 before_count = count;
        q[0] = 1; a[0] = 2;
        #1 q = {1}; a = '{2};
        #1 done = count == before_count;
    end
    always @(q or a) count = count + 1;
endmodule
"#)
