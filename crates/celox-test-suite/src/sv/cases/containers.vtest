        text = s.words.pop_front();
        flags[0] = text == "kept" && s.words[0] == "last";
        s.cells[3] = c; selected = s.cells[3]; selected.value = 9;
        flags[1] = s.cells[3] == c && s.cells[3].value == 9;
        c = null; selected = null;
        #1;
        flags[2] = s.words.pop_back() == "last" && s.words.size() == 0;
        selected = s.cells[3];
        flags[3] = selected.value == 9;
    end
endmodule
