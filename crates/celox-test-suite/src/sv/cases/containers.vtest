        q = {1, 2};
        q.push_front(q.pop_back());
        flags[1] = q.size() == 2 && q[0] == 2 && q[1] == 1;
        q = {1, 2, 3};
        q.insert(1, q.pop_back());
        flags[2] = q.size() == 3 && q[0] == 1 && q[1] == 3 && q[2] == 2;
        q = {1, 10, 20};
        q.insert(q.pop_front(), 7);
        flags[3] = q.size() == 3 && q[0] == 10 && q[1] == 7 && q[2] == 20;
        q = {1, 10, 20};
        q.delete(q.pop_front());
        flags[4] = q.size() == 1 && q[0] == 10;
        q = {1, 10, 20};
        value = q[q.pop_front()];
        flags[5] = value == 20 && q.size() == 2 && q[0] == 10;
        bounded = {1, 2};
        bounded.push_back(bounded.pop_front());
        flags[6] = bounded.size() == 2 && bounded[0] == 2 && bounded[1] == 1;
        strings = {"first", "last"};
        strings.push_back(strings.pop_front());
