        fixed_values.sum(); dynamic_values.product;
        void'(fixed_values.xor); void'(dynamic_values.and());
        flags[0] = $bits(fixed_values.sum) == 8 && $bits(dynamic_values.sum()) == 8;
        flags[1] = $dimensions(fixed_values.sum()) == 2 && $dimensions(dynamic_values.sum) == 2;
        flags[2] = $size(fixed_values.sum) == 2 && $size(dynamic_values.sum(), 2) == 4;
