        state_e s[Obj][Obj];
        function void start(Obj l, Obj r);
            m[l][r][DEEP] = '{STARTED, 0};
        endfunction
    endclass
    initial begin
        Comparer c;
        Obj a, b, k;
        int grid[][];
        c = new;
        a = new("a");
        b = new("b");
        c.start(a, b);
        $display("%0d %0d %0d", c.m[a][b][DEEP].state, c.m[a][b][DEEP].ret_val, c.m.exists(a));
        c.m[a][b][DEEP] = '{FINISHED, 1};
        c.m[b][a][SHALLOW] = '{STARTED, 1};
        $display("%0d %0d %0d %0d", c.m[a][b][DEEP].state, c.m[a][b][DEEP].ret_val, c.m.num(),
            c.m[b][a][SHALLOW].ret_val);
        c.s[a][b] = FINISHED;
        $display("%0d %0d", c.s[a][b], c.s[b][a]);
        if (c.m.first(k)) $display("first %s", k.n);
        foreach (c.m[x]) $display("key %s", x.n);
        c.m.delete();
        grid = new[2];
        grid[1] = new[3];
        grid[1][2] = 7;
        $display("%0d %0d", c.m.num(), grid[1][2]);
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1)
  (expect_output "1 0 1\n2 1 2 1\n2 0\nfirst a\nkey a\nkey b\n0 7\n"))

