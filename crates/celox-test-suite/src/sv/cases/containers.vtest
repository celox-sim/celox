        stores[next_index()].q.push_back(5);
        flags[0] = calls == 1 && first.q.size() == 1 && second.q.size() == 0;
        flags[1] = first.q[0] == 5;
        first.q = {1, 2}; first.q.push_back(first.q.pop_front());
        flags[2] = first.q.size() == 2 && first.q[0] == 2 && first.q[1] == 1;
    end
endmodule
