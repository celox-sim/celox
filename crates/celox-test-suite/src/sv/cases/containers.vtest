        a[3] = 30; a[-2] = 20; a[8] = 80;
        flags[1] = a.num() == 3 && a.exists(-2) && a[3] == 30;
        ok = a.first(key);
        flags[2] = ok == 1 && key == -2;
        ok = a.next(key);
        flags[3] = ok == 1 && key == 3;
        ok = a.last(key);
        flags[4] = ok == 1 && key == 8;
        ok = a.prev(key);
        flags[5] = ok == 1 && key == 3;
        b = a; a.delete(3);
        flags[6] = !a.exists(3) && b[3] == 30;
        a.delete(); key = 77; ok = a.first(key);
