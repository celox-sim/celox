(case ordering_four_state
  (source "ordering.sv" #"
module Top(output bit [3:0] flags);
    logic [3:0] values[], q[$];
    logic signed [3:0] known_values[];
    int xs, zs, zeros, ones;
    initial begin
        values = '{4'bx01z, 4'bz10x, 4'b0001}; q = values;
        values.reverse;
        flags[0] = values[0] === 4'b0001 && values[1] === 4'bz10x && values[2] === 4'bx01z;
        q.reverse(); q.reverse();
        flags[1] = q[0] === 4'bx01z && q[1] === 4'bz10x && q[2] === 4'b0001;
        known_values = '{-1, 2, -8, 7}; known_values.sort;
        flags[2] = known_values[0] === -4'sd8 && known_values[1] === -4'sd1
            && known_values[2] === 4'sd2 && known_values[3] === 4'sd7;
        values = '{4'bxxxx, 4'b1111, 4'bzzzz, 4'b0000};
        values.sort(); values.rsort();
        foreach (values[i]) begin
            if (values[i] === 4'bxxxx) xs++;
            if (values[i] === 4'bzzzz) zs++;
            if (values[i] === 4'b0000) zeros++;
            if (values[i] === 4'b1111) ones++;
        end
        flags[3] = values.size() == 4 && xs == 1 && zs == 1 && zeros == 1 && ones == 1;
    end
endmodule
"#)
  (four_state)
  (top Top) (run_until 0) (assert_eq flags 15))

