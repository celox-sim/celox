(case named_array_parameters_forward_whole_values
  (source "named_array_parameter_whole_values.sv" #"
    module Child #(parameter logic [7:0] Q[2] = '{0, 0})
      (input logic sel, output logic [7:0] y);
      assign y = Q[sel];
    endmodule
    module Middle #(parameter logic [7:0] Q[2] = '{0, 0})
      (input logic sel, output logic [7:0] y);
