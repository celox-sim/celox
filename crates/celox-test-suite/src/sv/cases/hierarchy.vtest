(group hierarchy (category hierarchy))

(case input_port_defaults_use_child_scope_and_only_omitted_connections
  (source "default_input.sv" #"
        module Child #(parameter D=8'ha5)(output logic [7:0] y,
            input logic [7:0] a=D);
            assign y=a;
        endmodule
        module Fill(output logic [7:0] y, input logic [7:0] a='1);
            assign y=a;
        endmodule
        module Top #(parameter D=0)(input logic [7:0] a,
            output logic [7:0] omitted, open, connected, positional, fill);
            Child #(.D(8'h96)) c0(.y(omitted));
            Child c1(.a(),.y(open));
            Child c2(.a(a),.y(connected));
            Child c3(positional);
            Fill c4(.y(fill));
        endmodule
    "#)
  (top Top)
  (modify (set a 0))
  (assert_eq omitted 0x96)
  (assert_eq open 0xa5)
  (assert_eq connected 0)
  (assert_eq positional 0xa5)
  (assert_eq fill 0xff)
  (modify (set a 0x5a))
  (assert_eq connected 0x5a)
  (assert_eq omitted 0x96))

(case drives_omitted_and_open_child_inputs_with_z
  (four_state)
  (source "open_input.sv" #"
        module Child(input logic a, output logic y); assign y = (a === 1'bz); endmodule
        module Top(output logic omitted, output logic open);
            Child omitted_child(.y(omitted));
            Child open_child(.a(), .y(open));
        endmodule
    "#)
  (top Top)
  (eval)
  (assert_eq omitted 1)
  (assert_eq open 1))

(case treats_child_outputs_as_explicit_net_drivers
  (source "explicit_net_driver.sv" #"
        module Source(input logic a, output logic y); assign y = a; endmodule
        module Sink(input logic a, output logic y); assign y = a; endmodule
        module Top(input logic a, output logic y);
            wire w;
            Source source(.a(a), .y(w));
            Sink sink(.a(w), .y(y));
        endmodule
    "#)
  (top Top)
  (modify (set a 1))
  (assert_eq y 1))

(case simulates_systemverilog_named_port_hierarchy
  (source "hierarchy.sv" #"
        module Xor8(input logic [7:0] a, input logic [7:0] b, output logic [7:0] y);
            assign y = a ^ b;
        endmodule

        module Top(input logic [7:0] lhs, input logic [7:0] rhs, output logic [7:0] out);
            Xor8 u_xor(
                .a(lhs),
                .b(rhs),
                .y(out)
            );
        endmodule
    "#)
  (top Top)
  (modify
    (set lhs 0xa5)
    (set rhs 0x3c))
  (assert_eq out 0x99))

(case simulates_systemverilog_hierarchy_through_internal_signal
  (source "internal_hierarchy.sv" #"
        module Xor8(input logic [7:0] a, input logic [7:0] b, output logic [7:0] y);
            assign y = a ^ b;
        endmodule

        module Top(input logic [7:0] lhs, input logic [7:0] rhs, output logic [7:0] out);
            logic [7:0] rhs_tmp;
            assign rhs_tmp = rhs;
            Xor8 u_xor(
                .a(lhs),
                .b(rhs_tmp),
                .y(out)
            );
        endmodule
    "#)
  (top Top)
  (modify
    (set lhs 0xf0)
    (set rhs 0x0f))
  (assert_eq out 0xff))

(case simulates_veryl_generated_style_gray_encoder_hierarchy
  (source "generated_gray_encoder.sv" #"
        module gray_encoder #(
            parameter int unsigned WIDTH = 32
        ) (
            input var logic [WIDTH-1:0] i_bin,
            output var logic [WIDTH-1:0] o_gray
        );
            always_comb o_gray = i_bin ^ (i_bin >> 1);
        endmodule

        module Top (
            input  var logic [32-1:0] i_bin,
            output var logic [32-1:0] o_gray
        );
            gray_encoder #(
                .WIDTH (32)
            ) u_enc (
                .i_bin  (i_bin),
                .o_gray (o_gray)
            );
        endmodule
    "#)
  (top Top)
  (modify (set i_bin 0b10110000))
  (assert_eq o_gray 0b11101000))

(case simulates_parameter_specialized_systemverilog_hierarchy
  (source "parameterized_hierarchy.sv" #"
        module Pass #(
            parameter int unsigned WIDTH = 1
        ) (
            input  logic [WIDTH-1:0] i,
            output logic [WIDTH-1:0] o
        );
            assign o = i;
        endmodule

        module Top(
            input  logic [7:0] i8,
            input  logic [15:0] i16,
            output logic [7:0] o8,
            output logic [15:0] o16
        );
            Pass #(.WIDTH(8)) u8 (
                .i(i8),
                .o(o8)
            );
            Pass #(.WIDTH(16)) u16 (
                .i(i16),
                .o(o16)
            );
        endmodule
    "#)
  (top Top)
  (modify
    (set i8 0xa5)
    (set i16 0x5aa5))
  (assert_eq o8 0xa5)
  (assert_eq o16 0x5aa5))

(case simulates_systemverilog_hierarchical_always_ff
  (source "hierarchical_ff.sv" #"
        module Child(input logic clk, input logic rst, input logic d, output logic q);
            always_ff @(posedge clk, negedge rst) begin
                if (!rst) begin
                    q <= 1'b0;
                end else begin
                    q <= d;
                end
            end
        endmodule

        module Top(input logic clk, input logic rst, input logic d, output logic q);
            Child u(.clk(clk), .rst(rst), .d(d), .q(q));
        endmodule
    "#)
  (top Top)
  (modify
    (set rst 0)
    (set d 1))
  (tick clk)
  (assert_eq q 0)
  (modify (set rst 1))
  (tick clk)
  (assert_eq q 1))

(case simulates_systemverilog_hierarchical_always_ff_with_constant_clear
  (source "hierarchical_ff_constant_clear.sv" #"
        module Child(
            input logic clk,
            input logic rst,
            input logic clear,
            input logic d,
            output logic q
        );
            always_ff @(posedge clk, negedge rst) begin
                if (!rst) begin
                    q <= 1'b0;
                end else if (clear) begin
                    q <= 1'b0;
                end else begin
                    q <= d;
                end
            end
        endmodule

        module Top(input logic clk, input logic rst, input logic d, output logic q);
            Child u(.clk(clk), .rst(rst), .clear(1'b0), .d(d), .q(q));
        endmodule
    "#)
  (top Top)
  (modify
    (set rst 0)
    (set d 1))
  (tick clk)
  (assert_eq q 0)
  (modify (set rst 1))
  (tick clk)
  (assert_eq q 1))

(case settles_feedback_through_disjoint_bits_of_child_input
  (source "disjoint_input_feedback.sv" #"
        module Child(input logic [1:0] a, output logic lo);
            assign lo = a[1];
        endmodule

        module Top(input logic inp, output logic out0, output logic out1);
            logic [1:0] v;
            logic lo;
            Child c(.a(v), .lo(lo));
            assign v = {inp, lo};
            assign out0 = v[0];
            assign out1 = v[1];
        endmodule
    "#)
  (top Top)
  (for bit (list 0 1 0 1)
    (modify (set inp bit))
    (assert_eq out0 bit)
    (assert_eq out1 bit)))

(case settles_feedback_beside_dynamic_child_reader
  (source "dynamic_reader_feedback.sv" #"
        module ChildFb(input logic [2:0] a, output logic lo);
            assign lo = a[2];
        endmodule

        module ChildDyn(input logic [2:0] a, input logic idx, output logic o);
            assign o = a[idx];
        endmodule

        module Top(
            input logic i1,
            input logic i2,
            input logic sel,
            output logic out_fb,
            output logic out_dyn
        );
            logic [2:0] v;
            logic lo;
            logic d;
            ChildFb fb(.a(v), .lo(lo));
            ChildDyn dyn(.a(v), .idx(sel), .o(d));
            assign v[2:1] = {i2, i1};
            assign v[0] = lo;
            assign out_fb = lo;
            assign out_dyn = d;
        endmodule
    "#)
  (top Top)
  (modify
    (set i1 1)
    (set i2 0)
    (set sel 0))
  (assert_eq out_fb 0)
  (assert_eq out_dyn 0)
  (modify (set sel 1))
  (assert_eq out_fb 0)
  (assert_eq out_dyn 1)
  (modify
    (set i1 0)
    (set i2 1)
    (set sel 0))
  (assert_eq out_fb 1)
  (assert_eq out_dyn 1))

; IEEE 1800-2023 5.7.1 and 10.9.1: retain the element assignment context.
(case parameter_patterns_keep_fill_and_arithmetic_context
  (source "pattern_context.sv" #"
    module Child #(parameter logic [15:0] Q [2] = '{0, 0})
      (output logic [31:0] y);
      localparam bit CHOOSE = 0;
      assign y = {Q[1], Q[0]};
    endmodule
    module Scalar #(parameter logic [63:0] P = '{default: 0})
      (output logic [63:0] y);
      assign y = P;
    endmodule
    module Top(output logic [31:0] fills, expressions, repeated,
      output logic [63:0] builtin);
      localparam bit CHOOSE = 1;
      localparam logic [7:0] A = 8'hff;
      Child #(.Q('{default: '1})) a(fills);
      Child #(.Q('{A + 8'd1, CHOOSE ? '1 : '0})) b(expressions);
      Child #(.Q('{2{('1)}})) c(repeated);
      Scalar #(.P(int'{default: 0})) d(builtin);
    endmodule
  "#)
  (top Top)
  (assert_eq fills 0xffffffff)
  (assert_eq expressions 0xffff0100)
  (assert_eq repeated 0xffffffff)
  (assert_eq builtin 0))

; Explicit pattern types are self-determined in the caller, not the child.
(case parameter_patterns_bind_caller_types
  (source "typed_pattern_scope.sv" #"
    module Child #(parameter logic signed [7:0] Q [2] = '{0, 0})
      (output logic [31:0] y);
      typedef logic [3:0] pair_t [2];
      assign y = {16'(Q[1]), 16'(Q[0])};
    endmodule
    module Top(output logic [31:0] local_type, shadowed_type);
      typedef logic signed [7:0] local_pair_t [2];
      typedef logic signed [7:0] pair_t [2];
      Child #(.Q(local_pair_t'{8'shf8, '1})) a(local_type);
      Child #(.Q(pair_t'{8'shf8, '1})) b(shadowed_type);
    endmodule
  "#)
  (top Top)
  (assert_eq local_type 0xfffffff8)
  (assert_eq shadowed_type 0xfffffff8))

(case parameter_patterns_bind_nested_caller_types
  (source "nested_typed_pattern_scope.sv" #"
    module Child #(parameter logic signed [7:0] Q [2][2] = '{default: 0})
      (output logic [63:0] y);
      assign y = {16'(Q[1][1]), 16'(Q[1][0]), 16'(Q[0][1]), 16'(Q[0][0])};
    endmodule
    module Top(output logic [63:0] y);
      typedef logic signed [7:0] pair_t [2];
      Child #(.Q('{pair_t'{-3, -5}, pair_t'{-7, -9}})) a(y);
    endmodule
  "#)
  (top Top)
  (assert_eq y 0xfff7fff9fffbfffd))

(case parameter_patterns_keep_unknown_fill
  (four_state)
  (source "pattern_unknown_fill.sv" #"
    module Child #(parameter logic [7:0] Q [2] = '{0, 0})
      (output logic [15:0] y);
      assign y = {Q[1], Q[0]};
    endmodule
    module Top(output logic [15:0] xfill, zfill);
      Child #(.Q('{default: 'x})) a(xfill);
      Child #(.Q('{default: 'z})) b(zfill);
    endmodule
  "#)
  (top Top)
  (assert_eq xfill (fourstate 0xffff 0xffff))
  (assert_eq zfill (fourstate 0 0xffff)))

(case parameter_patterns_evaluate_caller_constant_functions
  (source "constant_pattern_calls.sv" #"
    module Child #(parameter byte signed Q[2] = '{1, 2})(output logic [15:0] y);
      localparam Bias = 99;
      assign y = {Q[0], Q[1]};
    endmodule
    module Top(output logic [15:0] y);
      localparam Bias = 5;
      function automatic byte signed f(input int value); return -(value + Bias); endfunction
      function automatic byte signed g(input int value); return f(.value(value)); endfunction
      Child #(.Q('{g(1), f(2)})) child(y);
    endmodule
  "#)
  (top Top)
  (eval)
  (assert_eq y 0xfaf9))

(case parameter_patterns_override_body_declarations
  (source "body_parameter_pattern.sv" #"
    module Ansi(output logic [15:0] y);
      parameter byte Q[2] = '{1, 2};
      assign y = {Q[0], Q[1]};
    endmodule
    module Top(output logic [15:0] y);
      Ansi #(.Q('{3, 4})) first(y);
    endmodule
  "#)
  (top Top)
  (eval)
  (assert_eq y 0x0304))

; Typed packed patterns are values: caller field names/layout do not escape.
(case parameter_patterns_transfer_packed_values
  (source "packed_pattern_values.sv" #"
    package ChildTypes;
      typedef struct packed {logic [7:0] a; logic [7:0] b;} child_t;
    endpackage
    module Child #(parameter ChildTypes::child_t P = '{default: 0})
      (output logic [15:0] y);
      assign y = {P.a, P.b};
    endmodule
    module Top(output logic [15:0] renamed, regrouped);
      typedef struct packed {logic [7:0] x; logic [7:0] y;} caller_t;
      typedef struct packed {logic [3:0] x; logic [11:0] y;} other_t;
      Child #(.P(caller_t'{y: 2, x: 1})) c(renamed);
      Child #(.P(other_t'{x: 10, y: 12'h123})) d(regrouped);
    endmodule
  "#)
  (top Top)
  (assert_eq renamed 0x0102)
  (assert_eq regrouped 0xa123))

(case parameter_patterns_override_scalar_defaults
  (source "scalar_pattern_values.sv" #"
    module Child #(parameter int P = 0)(output logic [31:0] y);
      assign y = P;
    endmodule
    module Wide #(parameter logic [63:0] P = 0)(output logic [63:0] y);
      assign y = P;
    endmodule
    module Top(output logic [31:0] builtin, named, output logic [63:0] extended);
      typedef logic [7:0] byte_t;
      Child #(.P(int'{default: 1})) c(builtin);
      Child #(.P(byte_t'{default: 1})) d(named);
      Wide #(.P(int'{default: 1})) w(extended);
    endmodule
  "#)
  (top Top)
  (assert_eq builtin 0xffffffff)
  (assert_eq named 0xff)
  (assert_eq extended 0xffffffffffffffff))

(case parameter_patterns_preserve_packed_member_states
  (four_state)
  (source "packed_pattern_states.sv" #"
    package ChildTypes;
      typedef struct packed {bit [3:0] a; logic [3:0] b;} child_t;
    endpackage
    module Child #(parameter ChildTypes::child_t P = '{default: 0})
      (output logic [7:0] y);
      assign y = {P.a, P.b};
    endmodule
    module Scalar #(parameter integer P=0)(output logic [31:0] y); assign y=P; endmodule
    module Top(output logic [7:0] y, output logic [31:0] xvalue, zvalue, two_state);
      typedef struct packed {bit [3:0] x; logic [3:0] y;} caller_t;
      Child #(.P(caller_t'{x: 'x, y: 'z})) c(y);
      Scalar #(.P(integer'{default: 'x})) x(xvalue);
      Scalar #(.P(integer'{default: 'z})) z(zvalue);
      Scalar #(.P(int'{default: 'x})) b(two_state);
    endmodule
  "#)
  (top Top)
  (assert_eq y (fourstate 0 0x0f))
  (assert_eq xvalue (fourstate 0xffffffff 0xffffffff))
  (assert_eq zvalue (fourstate 0 0xffffffff))
  (assert_eq two_state 0))

(case widens_small_parameters_into_child_int_outputs
  (source "small_parameter.sv" #"
    module Child #(parameter N = 4'd11)(output int value);
      assign value = N;
    endmodule
    module SignedChild #(parameter N = 4'sb1011)(output int value);
      assign value = N;
    endmodule
    module Literal(output int value);
      assign value = 4'd11;
    endmodule
    module Top(output int value, output int negative, output int literal);
      Child child(.value(value));
      SignedChild signed_child(.value(negative));
      Literal literal_child(.value(literal));
    endmodule
  "#)
  (top Top)
  (eval)
  (assert_eq value 11)
  (assert_eq negative 0xfffffffb)
  (assert_eq literal 11))

(case widens_small_parameters_preserving_four_state_bits
  (four_state)
  (source "small_parameter_states.sv" #"
    module Child #(parameter N = 4'b1xz1)(output int value, output logic [31:0] raw);
      assign value = N;
      assign raw = N;
    endmodule
    module Top(output int value, output logic [31:0] raw);
      Child child(.value(value), .raw(raw));
    endmodule
  "#)
  (top Top)
  (eval)
  (assert_eq value 9)
  (assert_eq raw (fourstate 13 6)))

(case parameter_patterns_keep_original_declarations_and_isolated_bindings
  (source "pattern_binding_isolation.sv" #"
    `define ORIGINAL_VALUES '{1, 2}
    module Child #(parameter int N = 9, parameter byte Q [2] = `ORIGINAL_VALUES)
        (output logic [15:0] y, output logic [7:0] local_y);
      assign y = {Q[0], Q[1]};
      always_comb begin
        localparam byte Q = 7;
        local_y = Q;
      end
    endmodule
    module Top(output logic [15:0] defaults, repeated, keyed,
               output logic [7:0] local_default, local_repeated, local_keyed);
      localparam N = 2;
      Child a(defaults, local_default);
      Child #(.Q('{N{-N}})) b(repeated, local_repeated);
      Child #(.Q('{N-2: -N, default: N+1})) c(keyed, local_keyed);
    endmodule
    `undef ORIGINAL_VALUES
  "#)
  (top Top)
  (assert_eq defaults 0x0102)
  (assert_eq repeated 0xfefe)
  (assert_eq keyed 0xfe03)
  (assert_eq local_default 7)
  (assert_eq local_repeated 7)
  (assert_eq local_keyed 7))

(case parameter_patterns_preserve_enclosing_expressions
  (source "pattern_expressions.sv" #"
    module Child #(parameter logic [15:0] P = 0)(output logic [15:0] y);
      assign y = P;
    endmodule
    module Top(output logic [15:0] added, negated);
      typedef logic [7:0] byte_t;
      Child #(.P(byte_t'{default: 1} + 16'd1)) a(added);
      Child #(.P(~(byte_t'{default: 0} | 16'd0))) b(negated);
    endmodule
  "#)
  (top Top)
  (assert_eq added 256)
  (assert_eq negated 65535))

(case bits_query_parameter_overrides
  ; IEEE 1800-2023 20.6.2: fixed-size type and variable queries are constants.
  (source "bits_parameter_overrides.sv" #"
    module Sub #(parameter int W = 1)(output int y); assign y = W; endmodule
    module Top(output int type_bits, variable_bits, combined_bits);
      typedef logic [3:0] nibble_t;
      logic [11:0] value;
      Sub #(.W($bits(nibble_t))) type_instance(.y(type_bits));
      Sub #($bits(value)) variable_instance(.y(variable_bits));
      Sub #(.W($bits(nibble_t) + $bits(value))) combined_instance(.y(combined_bits));
    endmodule
  "#)
  (top Top)
  (eval)
  (assert_eq type_bits 4)
  (assert_eq variable_bits 12)
  (assert_eq combined_bits 16))

(case bits_query_parameter_overrides_follow_caller_specialization
  (source "specialized_bits_parameter_overrides.sv" #"
    package Types; typedef logic [8:0] word_t; endpackage
    module Sub #(parameter int W = 1)(output int y); assign y = W; endmodule
    module Caller #(parameter int N = 2)(output int variable_bits, type_bits, array_bits);
      import Types::*;
      logic [N-1:0] value;
      logic [N-1:0] memory [3];
      typedef logic [N:0] local_t;
      Sub #(.W($bits(value))) variable_instance(.y(variable_bits));
      Sub #(.W($bits(local_t) + $bits(word_t))) type_instance(.y(type_bits));
      Sub #(.W($bits(memory))) array_instance(.y(array_bits));
    endmodule
    module Top(output int default_var, default_type, default_array,
               output int override_var, override_type, override_array);
      Caller default_instance(default_var, default_type, default_array);
      Caller #(.N(5)) override_instance(override_var, override_type, override_array);
    endmodule
  "#)
  (top Top)
  (eval)
  (assert_eq default_var 2)
  (assert_eq default_type 12)
  (assert_eq default_array 6)
  (assert_eq override_var 5)
  (assert_eq override_type 15)
  (assert_eq override_array 15))

(case concatenated_parameter_actuals_use_each_parent_specialization
  (source "concat_actual.sv" #"
        module Child #(parameter P=0)(output logic [31:0] y);
            assign y=P;
        endmodule
        module Parent #(parameter N=1, parameter logic[7:0] V=8'ha5)(
            output logic[31:0] repeated, combined);
            Child #(.P({N{V}})) c0(repeated);
            Child #(.P({V,8'(N)})) c1(combined);
        endmodule
        module Top(output logic[31:0] a, b, c, d);
            Parent #(.N(1),.V(8'h12)) p0(a,b);
            Parent #(.N(3),.V(8'hc3)) p1(c,d);
        endmodule
    "#)
  (top Top)
  (assert_eq a 0x12)
  (assert_eq b 0x1201)
  (assert_eq c 0xc3c3c3)
  (assert_eq d 0xc303))

(case conditional_parameter_actuals_follow_parent_specialization
  (source "conditional_actual.sv" #"
    module Child #(parameter P=0)(output logic [31:0] y);
      assign y=P;
    endmodule
    module Parent #(parameter N=1)(output logic [31:0] y, z);
      Child #(.P(N > 2 ? N+10 : 3)) c0(y);
      Child #(.P(N > 2 ? (N > 4 ? 8 : 7) : 6)) c1(z);
    endmodule
    module Top(output logic [31:0] a,b,c,d);
      Parent p0(a,b);
      Parent #(.N(4)) p1(c,d);
    endmodule
  "#)
  (top Top)
  (assert_eq a 3)
  (assert_eq b 6)
  (assert_eq c 14)
  (assert_eq d 7))

(case generated_parameter_part_select_actuals
  (source "selected_actual.sv" #"
    module Child #(parameter P=0)(output logic [1:0] y);
      assign y=P;
    endmodule
    module Parent #(parameter logic [7:0] P=8'he4)(output logic [7:0] y);
      for(genvar i=0;i<4;i=i+1) begin:g
        Child #(.P(P[i*2 +: 2])) c(y[i*2 +: 2]);
      end
    endmodule
    module Top(output logic [7:0] a,b);
      Parent p0(a);
      Parent #(.P(8'h1b)) p1(b);
    endmodule
  "#)
  (top Top)
  (assert_eq a 0xe4)
  (assert_eq b 0x1b))

(case sized_parameter_actuals_follow_parent_specialization
  (source "sized_actual.sv" #"
    module Child #(parameter P=0)(output logic [31:0] y);
      assign y=P;
    endmodule
    module Parent #(parameter N=8)(output logic [31:0] y);
      Child #(.P(N'(16'hfedc))) c(y);
    endmodule
