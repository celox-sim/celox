  (top Top)
  (assert_eq y 0x12)
  (modify (set sel 1))
  (assert_eq y 0xa5))

; IEEE 1800-2023 10.8 and 10.9: the input port supplies the assignment
; context, including dimensions after parameter specialization.
(case port_patterns_use_specialized_formal_shapes
  (source "port_pattern_shapes.sv" #"
    module Child #(parameter W=4, N=2)(
      input logic [W-1:0] cfg[2:N+1], output wire [W*N-1:0] y);
      for (genvar k=2; k<N+2; k=k+1) begin
        assign y[(k-2)*W +: W] = cfg[k];
      end
    endmodule
    module Top(output wire [14:0] named, output wire [13:0] ordered);
      localparam N=99;
      Child #(.W(5), .N(3)) a(.cfg('{3{'1}}), .y(named));
      Child #(7, 2) b(('{default:'1}), ordered);
    endmodule
  "#)
  (top Top)
  (assert_eq named 0x7fff)
  (assert_eq ordered 0x3fff))

(case port_patterns_keep_caller_values_and_generated_names
  (source "port_pattern_values.sv" #"
    module Child #(parameter W=8)(input logic [W-1:0] cfg[2], output wire [2*W-1:0] y);
      assign y = {cfg[1], cfg[0]};
    endmodule
    module Top(input logic signed [3:0] a, input logic [3:0] b,
      output wire [15:0] y, calls, output wire [7:0] generated);
      localparam KEY=1;
      function automatic logic signed [3:0] neg(input logic signed [3:0] x);
        return -x;
      endfunction
      Child c(.cfg('{KEY:b, default:a}), .y(y));
      Child d(.cfg('{neg(a), b}), .y(calls));
      for (genvar g=0; g<2; g=g+1) begin: bank
        wire [3:0] v = b + g;
        Child #(.W(2)) c(.cfg('{v, g+1}), .y(generated[4*g +: 4]));
      end
    endmodule
  "#)
  (top Top)
  (modify (set a 0xe) (set b 8))
  (assert_eq y 0x08fe)
  (assert_eq calls 0x0802)
  (assert_eq generated 0x94)
  (modify (set a 7) (set b 15))
  (assert_eq y 0x0f07)
  (assert_eq calls 0x0ff9)
  (assert_eq generated 0x87))

