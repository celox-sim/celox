  (assert_eq a 0xdc)
  (assert_eq b 0xedc))

; IEEE 1800-2023 6.20.2 and 7.6: array values bind in the caller and
; corresponding elements follow declaration order, independently of bounds.
(case named_array_parameters_follow_caller_specialization
  (source "named_array_parameters.sv" #"
    module Child #(parameter byte Q[3:2] = '{1, 2})
      (input logic sel, output logic [15:0] y, output byte selected);
      localparam byte TABLE[2] = '{99, 98};
      assign y = {Q[3], Q[2]};
      assign selected = Q[3-sel];
    endmodule
    module Parent #(parameter byte B = -3)
      (input logic sel, output logic [15:0] y, output byte selected);
      localparam byte TABLE[0:1] = '{B, B-2};
      Child #(.Q((TABLE))) child(sel, y, selected);
    endmodule
    module Top(input logic sel, output logic [15:0] a, b,
      output byte a_selected, b_selected);
      Parent #(.B(-3)) first(sel, a, a_selected);
      Parent #(.B(7)) second(sel, b, b_selected);
    endmodule
  "#)
  (top Top)
  (assert_eq a 0xfdfb)
  (assert_eq b 0x0705)
  (assert_eq a_selected 0xfd)
  (assert_eq b_selected 7)
  (modify (set sel 1))
  (assert_eq a_selected 0xfb)
  (assert_eq b_selected 5))

(case named_array_parameters_keep_four_state_values
  (four_state)
  (source "named_array_parameter_states.sv" #"
