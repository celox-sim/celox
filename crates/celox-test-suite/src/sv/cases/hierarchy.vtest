(case port_pattern_review_mixed_state_structs
  (four_state)
  (source "pattern_mixed_state.sv" #"
    package P;
      typedef struct packed {bit [3:0] a; logic [3:0] b;} item_t;
      typedef item_t [1:0][1:0] quad_t;
    endpackage
    module Single(input P::item_t cfg, output wire [7:0] y);
      assign y = cfg;
    endmodule
    module Array(input P::item_t cfg[2], output wire [15:0] y);
      assign y = {cfg[1], cfg[0]};
    endmodule
    module Packed(input P::quad_t cfg, output wire [31:0] y);
      assign y = cfg;
    endmodule
    module Top(input logic [3:0] a, output wire [7:0] direct, typed,
      output wire [15:0] defaults, output wire [31:0] packed_default, packed_typed);
      Single s(.cfg('{a:a, b:'x}), .y(direct));
      Single t(.cfg(P::item_t'{a:a, b:'x}), .y(typed));
      Array d(.cfg('{default:'x}), .y(defaults));
      Packed p(.cfg('{default:'x}), .y(packed_default));
      Packed pt(.cfg(P::quad_t'{default:'x}), .y(packed_typed));
    endmodule
  "#)
  (top Top)
  (modify (set a (fourstate 0xf 0xf)))
  (assert_eq direct (fourstate 0x0f 0x0f))
  (assert_eq typed (fourstate 0x0f 0x0f))
  (assert_eq defaults (fourstate 0x0f0f 0x0f0f))
  (assert_eq packed_default (fourstate 0x0f0f0f0f 0x0f0f0f0f))
  (assert_eq packed_typed (fourstate 0x0f0f0f0f 0x0f0f0f0f))
  (modify (set a (fourstate 0xa 0xc)))
  (assert_eq direct (fourstate 0x2f 0x0f))
  (assert_eq typed (fourstate 0x2f 0x0f)))

(case port_pattern_review_member_key_collisions
  (source "pattern_key_collision.sv" #"
    package P;
      typedef struct packed {logic [3:0] tag, data;} item_t;
    endpackage
    module StructChild(input P::item_t cfg, output wire [7:0] y);
      assign y = cfg;
    endmodule
    module ArrayChild(input logic [3:0] cfg[2:3], output wire [7:0] y);
      assign y = {cfg[2], cfg[3]};
    endmodule
    module Top(input logic [3:0] value, output wire [7:0] members, indices);
      localparam tag=0, data=1, KEY=2;
      StructChild s(.cfg('{tag:value, data:3}), .y(members));
      ArrayChild a(.cfg('{KEY:value, default:3}), .y(indices));
    endmodule
