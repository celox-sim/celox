(case port_pattern_constant_aggregate_defaults
  (source "pattern_constant_aggregate_defaults.sv" #"
    package P;
      typedef struct packed {logic [3:0] a,b;} item_t;
      typedef logic [1:0][3:0] pair_t;
      typedef struct packed signed {logic [3:0] a,b;} signed_item_t;
      localparam item_t PACKAGE_VALUE='{a:3,b:5};
    endpackage
    module Child #(parameter P::item_t CFG[2]='{default:'0})(output wire [15:0] y);
      assign y={CFG[1],CFG[0]};
    endmodule
    module Packed #(parameter P::pair_t CFG[2]='{default:'0})(output wire [15:0] y);
      assign y={CFG[1],CFG[0]};
    endmodule
    module Wide #(parameter logic [15:0] CFG[2]='{default:'0})(output wire [31:0] y);
      assign y={CFG[1],CFG[0]};
    endmodule
    module Top(output wire [31:0] sign_extended, output wire [15:0] packaged, named, called, conditional, typed, cast_value, packed_value, local_value);
      localparam P::item_t V='{a:3,b:5};
      localparam P::item_t W='{a:10,b:6};
      function automatic P::item_t identity(input P::item_t v); return v; endfunction
      localparam P::pair_t PAIR=8'hab;
      localparam P::signed_item_t SIGNED='{a:15,b:5};
      Wide #(.CFG('{default:SIGNED})) sw(.y(sign_extended));
      Child #(.CFG('{default:P::PACKAGE_VALUE})) pv(.y(packaged));
      Child #(.CFG('{default:V})) n(.y(named));
      Child #(.CFG('{default:identity(V)})) c(.y(called));
      Child #(.CFG('{default:(1'b1 ? V : W)})) q(.y(conditional));
      Child #(.CFG('{default:P::item_t'{a:3,b:5}})) t(.y(typed));
      Child #(.CFG('{default:P::item_t'(8'h35)})) cv(.y(cast_value));
      Child #(.CFG('{default:W})) l(.y(local_value));
      Packed #(.CFG('{default:PAIR})) p(.y(packed_value));
    endmodule
  "#)
  (top Top)
  (assert_eq sign_extended 0xfff5fff5)
  (assert_eq packaged 0x3535)
  (assert_eq named 0x3535)
  (assert_eq called 0x3535)
  (assert_eq conditional 0x3535)
  (assert_eq typed 0x3535)
  (assert_eq cast_value 0x3535)
  (assert_eq local_value 0xa6a6)
  (assert_eq packed_value 0xabab))

