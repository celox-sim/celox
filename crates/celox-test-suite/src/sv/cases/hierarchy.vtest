      Child #(.CFG('{default:VALUE})) c(.y(y));
    endmodule
  "#)
  (top Top)
  (assert_eq y 0x3535))

(case port_pattern_constant_unpacked_defaults
  (source "pattern_constant_unpacked_defaults.sv" #"
    module Rows #(parameter logic [7:0] CFG[2][0:1]='{default:'0})(output wire [31:0] y);
      assign y={CFG[1][1],CFG[1][0],CFG[0][1],CFG[0][0]};
    endmodule
    module Top(output wire [31:0] default_rows, explicit_rows);
      localparam logic [7:0] ROW[0:1]='{8'h12,8'h34};
      localparam logic [7:0] OTHER_ROW[4:5]='{8'hab,8'hcd};
      Rows #(.CFG('{default:ROW})) dr(.y(default_rows));
      Rows #(.CFG('{OTHER_ROW,OTHER_ROW})) er(.y(explicit_rows));
    endmodule
  "#)
  (top Top)
  (assert_eq default_rows 0x34123412)
  (assert_eq explicit_rows 0xcdabcdab))
