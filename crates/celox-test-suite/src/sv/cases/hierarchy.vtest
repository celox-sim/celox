    module Child(input P::item_t cfg[2], output wire [23:0] y);
      assign y = {cfg[1], cfg[0]};
    endmodule
    module Top(input logic [3:0] tag, input logic signed [3:0] data,
      output wire [23:0] y);
      Child c(.cfg('{'{tag:tag, data:data}, '{default:'1}}), .y(y));
    endmodule
  "#)
  (top Top)
