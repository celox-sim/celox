      (output logic [7:0] y);
      assign y = {Q[0], Q[1]};
    endmodule
    module Top(output logic [7:0] y);
      localparam logic [3:0] TABLE[2] = '{4'b10xz, 4'bz01x};
      Child #(.Q(TABLE)) child(y);
    endmodule
  "#)
  (top Top)
  (assert_eq y (fourstate 0xa3 0x39)))

(case named_array_parameters_forward_package_subarrays
  (source "named_array_parameter_packages.sv" #"
    package Values;
      localparam logic [7:0] TABLE[2][2] = '{'{8'h12, 8'h34}, '{8'h56, 8'h78}};
    endpackage
    module Child #(parameter logic [7:0] Q[2] = '{0, 0})
      (output logic [15:0] y);
      assign y = {Q[0], Q[1]};
    endmodule
    module Middle #(parameter logic [7:0] Q[2][2] = '{default: 0})
      (output logic [15:0] y);
      Child #(.Q(Q[1])) child(y);
    endmodule
    module Top(output logic [15:0] y);
      import Values::*;
      Middle #(.Q(TABLE)) middle(y);
    endmodule
  "#)
