(case port_pattern_review_interface_inputs
  (source "pattern_interface_ports.sv" #"
    interface Cfg #(parameter W=4, N=2)(input logic [W-1:0] cfg[N]);
    endinterface
    module Top(input logic [3:0] value,
      output wire [7:0] defaults, runtime_values, array_values, generated,
      output wire [9:0] specialized, output wire [7:0] function_values);
      function automatic logic [3:0] plus_one(input logic [3:0] x);
        return x+1;
      endfunction
      Cfg d(.cfg('{default:'1}));
      Cfg r(.cfg('{value, '1}));
      Cfg a[1:0](.cfg('{default:'1}));
      Cfg #(.W(5)) s(.cfg('{value, '1}));
      Cfg f(.cfg('{plus_one(value), '0}));
      assign specialized = {s.cfg[1], s.cfg[0]};
      assign function_values = {f.cfg[1], f.cfg[0]};
      assign defaults = {d.cfg[1], d.cfg[0]};
      assign runtime_values = {r.cfg[1], r.cfg[0]};
      assign array_values = {a[1].cfg[0], a[0].cfg[1]};
      for (genvar g=0; g<2; g=g+1) begin: bank
        wire [3:0] v = value+g;
        Cfg i(.cfg('{v, '0}));
        assign generated[4*g +: 4] = i.cfg[0];
      end
    endmodule
  "#)
  (top Top)
  (modify (set value 5))
  (assert_eq defaults 0xff)
  (assert_eq runtime_values 0xf5)
  (assert_eq array_values 0xff)
  (assert_eq generated 0x65)
  (assert_eq specialized 0x3e5)
  (assert_eq function_values 6)
  (modify (set value 0xe))
  (assert_eq runtime_values 0xfe)
  (assert_eq generated 0xfe)
  (assert_eq specialized 0x3ee)
  (assert_eq function_values 0xf))

(case port_pattern_review_aggregate_defaults
  (source "pattern_aggregate_defaults.sv" #"
    package P;
      typedef struct packed {logic [3:0] a, b;} item_t;
      typedef item_t items_t[2];
      typedef struct packed {logic [3:0] a, b;} other_t;
    endpackage
    module Child(input P::item_t cfg[2], output wire [15:0] y);
      assign y = {cfg[1], cfg[0]};
    endmodule
    module Other(input P::other_t cfg[2], output wire [15:0] y);
      assign y = {cfg[1], cfg[0]};
    endmodule
    interface Cfg(input P::item_t cfg[2]);
    endinterface
    module Top(input P::item_t value, output wire [15:0] direct, typed, called, interfaced, distinct);
      function automatic P::item_t identity(input P::item_t x);
        return x;
      endfunction
      Child d(.cfg('{default:value}), .y(direct));
      Child t(.cfg(P::items_t'{default:value}), .y(typed));
      Child c(.cfg('{default:identity(value)}), .y(called));
      Cfg i(.cfg('{default:value}));
      Other o(.cfg('{default:value}), .y(distinct));
      assign interfaced = {i.cfg[1], i.cfg[0]};
    endmodule
  "#)
  (top Top)
  (modify (set value 0x35))
  (assert_eq direct 0x3535)
  (assert_eq typed 0x3535)
  (assert_eq called 0x3535)
  (assert_eq interfaced 0x3535)
  (assert_eq distinct 0x5555)
  (modify (set value 0xa6))
  (assert_eq direct 0xa6a6)
  (assert_eq typed 0xa6a6)
  (assert_eq called 0xa6a6)
  (assert_eq interfaced 0xa6a6)
  (assert_eq distinct 0x6666))

(case port_pattern_review_packed_value_types
  (source "pattern_packed_value_types.sv" #"
    package P;
      typedef logic [1:0][3:0] pair_t;
      typedef pair_t items_t[2];
    endpackage
    module Child(input P::pair_t cfg[2], output wire [15:0] y);
      assign y = {cfg[1],cfg[0]};
    endmodule
    interface Cfg(input P::pair_t cfg[2]);
    endinterface
    module Top(input P::pair_t a,b, input logic sel,
      output wire [15:0] direct, typed, called, conditional, mixed, interfaced, selected, typed_call, cast_value, member_value, packed_select);
      function automatic P::pair_t identity(input P::pair_t x);
        return x;
      endfunction
      P::pair_t values[2];
      struct packed {P::pair_t value;} wrapper;
      logic [1:0][1:0][3:0] bank;
      assign wrapper.value=a;
      assign bank={a,b};
      Child cv(.cfg('{default:P::pair_t'(a)}), .y(cast_value));
      Child mv(.cfg('{default:wrapper.value}), .y(member_value));
      Child ps(.cfg('{default:bank[1]}), .y(packed_select));
      assign values[0]=a;
      assign values[1]=b;
      Child d(.cfg('{default:a}), .y(direct));
      Child t(.cfg(P::items_t'{default:a}), .y(typed));
      Child c(.cfg('{default:identity(a)}), .y(called));
      Child tc(.cfg(P::items_t'{default:identity(a)}), .y(typed_call));
      Child q(.cfg('{default:(sel ? a : b)}), .y(conditional));
      Child m(.cfg('{default:(sel ? identity(a) : P::pair_t'(b))}), .y(mixed));
      Child s(.cfg('{default:values[sel]}), .y(selected));
      Cfg i(.cfg('{default:a}));
      assign interfaced={i.cfg[1],i.cfg[0]};
    endmodule
  "#)
  (top Top)
  (modify (set a 0xab) (set b 0x34) (set sel 1))
  (assert_eq direct 0xabab)
  (assert_eq cast_value 0xabab)
  (assert_eq member_value 0xabab)
  (assert_eq packed_select 0xabab)
  (assert_eq typed 0xabab)
  (assert_eq called 0xabab)
  (assert_eq typed_call 0xabab)
  (assert_eq conditional 0xabab)
  (assert_eq mixed 0xabab)
  (assert_eq selected 0x3434)
  (assert_eq interfaced 0xabab)
  (modify (set a 0x56) (set sel 0))
  (assert_eq direct 0x5656)
  (assert_eq cast_value 0x5656)
  (assert_eq member_value 0x5656)
  (assert_eq packed_select 0x5656)
  (assert_eq typed 0x5656)
  (assert_eq called 0x5656)
  (assert_eq typed_call 0x5656)
  (assert_eq conditional 0x3434)
  (assert_eq mixed 0x3434)
  (assert_eq selected 0x5656)
  (assert_eq interfaced 0x5656))

