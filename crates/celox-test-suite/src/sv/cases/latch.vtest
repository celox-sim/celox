(group latch (category sequential))

(case explicit_latch
  (source "latch.sv" #"
module Top(input logic en, input logic [7:0] d, output logic [7:0] q);
    always_latch if (en) q = d;
endmodule
"#)
  (top Top)
  (modify (set en 1) (set d 7))
  (assert_eq q 7)
  (modify (set d 13))
  (assert_eq q 13)
  (modify (set en 0) (set d 99))
  (assert_eq q 13)
  (eval)
  (eval)
  (assert_eq q 13)
  (modify (set en 1))
  (assert_eq q 99))

(case classic_star_latch
  (source "latch.sv" #"
module Top(input logic en, input logic [7:0] d, output logic [7:0] q);
    always @* if (en) q = d;
endmodule
"#)
  (top Top)
  (modify (set en 1) (set d 7))
  (assert_eq q 7)
  (modify (set d 13))
  (assert_eq q 13)
  (modify (set en 0) (set d 99))
  (assert_eq q 13)
  (eval)
  (eval)
  (assert_eq q 13)
  (modify (set en 1))
  (assert_eq q 99))

(case guarded_activation
  (allow_inferred_latches)
  (source "guarded_latch.sv" #"
module Top(input logic seed, en, trigger, unrelated, output logic [7:0] q, output logic ignored);
    always_comb begin
        logic overwritten;
        overwritten = trigger;
        overwritten = 0;
        if (seed) q = 0;
        else if (en) q = q + 1;
    end
    assign ignored = unrelated;
endmodule
"#)
  (top Top)
  (modify (set seed 1) (set en 0) (set trigger 0) (set unrelated 0))
  (assert_eq q 0)
  (modify (set seed 0) (set en 1))
  (assert_eq q 1)
  (eval)
  (eval)
  (assert_eq q 1)
  (modify (set unrelated 1))
  (assert_eq q 1)
  (modify (set unrelated 0))
  (assert_eq q 1)
  (modify (set trigger 1))
  (assert_eq q 2))

(case four_state_latch
  (four_state)
  (source "four_state_latch.sv" #"
module Top(input logic en, input logic [7:0] d, output logic [7:0] q);
    always_latch if (en) q = d;
endmodule
"#)
  (top Top)
  (modify (set en 0) (set d 0))
  (assert_eq q (fourstate 0xff 0xff))
  (modify (set en 1) (set d 0xa5))
  (assert_eq q (fourstate 0xa5 0))
  (modify (set en (fourstate 1 1)) (set d 0x3c))
  (assert_eq q (fourstate 0xa5 0))
  (modify (set en (fourstate 0 1)))
  (assert_eq q (fourstate 0xa5 0)))

(case timed_initial_drives_latch
  (source "initial_latch.sv" #"
module Top;
    logic en;
    logic [7:0] d, q;
    always_latch if (en) q = d;
    initial begin
        en = 0; d = 0;
        #1; en = 1; d = 7;
        #1; if (q !== 7) $fatal(1, "latch open");
        d = 13;
        #1; if (q !== 13) $fatal(1, "transparent data");
        en = 0; d = 99;
        #1; if (q !== 13) $fatal(1, "latch hold");
        $finish;
    end
endmodule
"#)
  (top Top)
  (run_to_finish))

; `always @*` waits for a change in four-state mode only; two-state mode runs
; it at time zero (#2021).
(case classic_star_declaration_startup
  (source "declaration_startup.sv" #"
module Top;
    logic en = 1;
    logic [7:0] d = 7, q = 0;
    always @* if (en) q = d;
    initial begin
        #1; if (q !== 0) $fatal(1, "declarations do not trigger wildcard process");
        d = 13;
        #1; if (q !== 13) $fatal(1, "later data change triggers wildcard process");
        $finish;
    end
endmodule
"#)
  (top Top)
  (four_state)
  (run_to_finish))

(case classic_star_initial_startup
  (source "initial_startup.sv" #"
module Top;
    logic en;
    logic [7:0] d, q = 0;
    always @* if (en) q = d;
    initial begin en = 1; d = 7; end
    initial begin
        #1; if (q !== 7) $fatal(1, "initial writes trigger wildcard process");
        $finish;
    end
endmodule
"#)
  (top Top)
  (run_to_finish))

(case classic_star_continuous_startup
  (source "continuous_startup.sv" #"
module Top;
    wire en = 1;
    wire [7:0] d = 7;
    logic [7:0] q = 0;
    always @* if (en) q = d;
    initial begin
        #1; if (q !== 7) $fatal(1, "continuous drivers trigger wildcard process");
        $finish;
    end
endmodule
"#)
  (top Top)
  (run_to_finish))

(case classic_star_hierarchy_declaration_startup
  (source "hierarchy_startup.sv" #"
module Latch(input wire en, input wire [7:0] d, output wire [7:0] q);
    logic [7:0] held = 0;
    assign q = held;
    always @* if (en) held = d;
endmodule
module Top;
    logic en = 1;
    logic [7:0] d = 7;
    wire [7:0] q;
    Latch dut(en, d, q);
    initial begin
        #1; d = 13;
        #1; if (q !== 13) $fatal(1, "aliased data change triggers wildcard process");
        en = 0; d = 99;
        #1; if (q !== 13) $fatal(1, "aliased gate closes");
        $finish;
    end
endmodule
"#)
  (top Top)
  (run_to_finish))

; `always @*` waits for a change in four-state mode only; two-state mode runs
; it at time zero (#2021).
(case same_activation_change_return
  (source "change_return.sv" #"
module Top;
    logic [7:0] qc = 0, ql = 0, qs = 0;
    logic a = 0;
    logic [1:0] bus = 0;
    always @* if (!a) qc = qc + 1;
    always_latch if (!a) ql = ql + 1;
    always_latch if (!bus[0]) qs = qs + 1;
    initial begin
        #1;
        if (qc !== 0 || ql !== 1 || qs !== 1) $fatal(1, "startup");
        a = 1; a = 0;
        #1;
        if (qc !== 1 || ql !== 2 || qs !== 1) $fatal(1, "whole sensitivity pulse");
        bus[0] = 1; bus[0] = 0;
        #1;
        if (qc !== 1 || ql !== 2 || qs !== 2) $fatal(1, "slice sensitivity pulse or own write retrigger");
        $finish;
    end
endmodule
"#)
  (top Top)
  (four_state)
  (run_to_finish))

; `always @*` waits for a change in four-state mode only; two-state mode runs
; it at time zero (#2021).
(case hierarchy_same_activation_change_return
  (source "hierarchy_change_return.sv" #"
module Latch(input wire a, output wire [7:0] q);
    logic [7:0] held = 0;
    assign q = held;
    always @* if (!a) held = held + 1;
endmodule
module Top(output wire [7:0] q);
    logic a = 0;
    wire b;
    assign b = a;
    Latch dut(b, q);
    initial begin
        #1; if (q !== 0) $fatal(1, "wildcard startup");
        a = 1; a = 0;
        #1; if (q !== 1) $fatal(1, "hierarchical sensitivity pulse");
        $finish;
    end
endmodule
"#)
  (top Top)
  (four_state)
  (run_to_finish))

(case star_select_sensitivity
  (source "star_select_sensitivity.sv" #"
module Top;
    logic [3:0] bus = 0;
    logic q_bit = 0, q_part = 0;
    always @* if (!bus[0]) q_bit = 1;
    always @* if (bus[1:0] == 0) q_part = 1;
    initial begin
        #1; q_bit = 0; q_part = 0;
        bus[3] = 1;
        #1;
        if (q_bit !== 1 || q_part !== 1) $fatal(1, "wildcard reads the selected variable, not only selected bits");
        $finish;
    end
endmodule
"#)
  (top Top)
  (run_to_finish))

; `always @*` waits for a change in four-state mode only; two-state mode runs
; it at time zero (#2021).
(case star_complete_declaration_startup
  (source "star_complete_declaration_startup.sv" #"
module Top;
    logic a = 1, q = 0;
    always @* q = a;
    initial begin
        #1; if (q !== 0) $fatal(1, "complete wildcard process waits after declaration initialization");
        a = 0;
        #1; a = 1;
        #1; if (q !== 1) $fatal(1, "complete wildcard process observes later source changes");
        $finish;
    end
endmodule
"#)
  (top Top)
  (four_state)
  (run_to_finish))

(case task_call_sensitivity
  (source "task_call_sensitivity.sv" #"
module Top;
    logic trigger = 0, en = 0, g = 0;
    logic q_comb = 0, q_latch = 0;
    task copy_comb(input logic unused);
        q_comb = g;
    endtask
    task copy_latch(input logic unused);
        if (en) q_latch = g;
    endtask
    always_comb copy_comb(trigger);
    always_latch copy_latch(trigger);
    initial begin
        #1; en = 1; g = 1;
        #1;
        if (q_comb !== 0 || q_latch !== 0) $fatal(1, "task body globals do not add sensitivity");
        trigger = 1;
        #1;
        if (q_comb !== 1 || q_latch !== 1) $fatal(1, "task argument changes do add sensitivity");
        $finish;
    end
endmodule
"#)
  (top Top)
  (run_to_finish))

(case star_unpacked_select_sensitivity
  (source "star_unpacked_select_sensitivity.sv" #"
module Top;
    logic [7:0] mem [0:1][0:1];
    logic q = 0;
    always @* if (mem[0][0] == 0) q = 1;
    initial begin
        mem[0][0] = 0; mem[0][1] = 0;
        mem[1][0] = 0; mem[1][1] = 0;
        #1; q = 0; mem[1][1] = 1;
        #1; if (q !== 1) $fatal(1, "wildcard array read includes changes to other elements");
        $finish;
    end
endmodule
"#)
  (top Top)
  (run_to_finish))

; The latch example in IEEE 1800-2023 9.2.2.3 uses <=. Its updates belong
; to NBA; the implicit process runs at time zero and retains state while closed.
(case nonblocking_clock_gate
  (source "nonblocking_clock_gate.sv" #"
module Top;
 bit clk=0, enable=1, test_mode=0;
 logic held;
 wire gated = held & clk;
 int edges=0;
 always_latch if (!clk) held <= enable | test_mode;
 always @(posedge gated) edges++;
 initial begin
   #1; if (held !== 1) $fatal(1,"startup"); clk=1;
   #1; if (edges != 1 || gated !== 1) $fatal(1,"first edge"); enable=0;
   #1; if (gated !== 1) $fatal(1,"closed latch"); clk=0;
   #1; if (held !== 0) $fatal(1,"disabled gate"); clk=1;
   #1; if (edges != 1 || gated !== 0) $fatal(1,"disabled edge"); test_mode=1;
   #1; if (gated !== 0) $fatal(1,"test hold"); clk=0;
   #1; if (held !== 1) $fatal(1,"test open"); clk=1;
   #1; if (edges != 2) $fatal(1,"test edge");
   $finish;
 end
endmodule"#)
  (top Top) (run_to_finish))

(case nonblocking_latch_old_values
  (source "nonblocking_latch_old_values.sv" #"
module Top;
 bit enable=1;
 logic [7:0] d=3, q=0, r=0;
 always_latch if (enable) begin q <= d; r <= q; end
 initial begin
   #1; if (q !== 3 || r !== 0) $fatal(1,"NBA old value or self trigger");
   enable=0; d=5;
   #1; if (q !== 3 || r !== 0) $fatal(1,"hold"); enable=1;
   #1; if (q !== 5 || r !== 3) $fatal(1,"reopen");
   #1; if (r !== 3) $fatal(1,"self trigger"); d=8'hxx;
   #1; if (q !== 8'hxx || r !== 5) $fatal(1,"four state NBA");
   $finish;
 end
endmodule"#)
  (four_state) (top Top) (run_to_finish))

(case nonblocking_latch_function_sensitivity
  (source "nonblocking_latch_function.sv" #"
module Top;
 bit [7:0] d=1;
 logic [7:0] q;
 function automatic logic [7:0] read_data(); return d; endfunction
 always_latch q <= read_data();
 initial begin
   #1; if (q !== 1) $fatal(1,"function startup"); d=7;
   #1; if (q !== 7) $fatal(1,"function sensitivity");
   $finish;
 end
endmodule"#)
  (top Top) (run_to_finish))

(case nonblocking_latch_partial_sensitivity
  (source "nonblocking_latch_partial.sv" #"
module Top;
 logic [7:0] value=8'h21;
 int activations=0;
 always_latch begin activations++; value[3:0] <= value[7:4]; end
 initial begin
   #1; if (value !== 8'h22 || activations != 1) $fatal(1,"partial startup");
   value[7:4]=4'ha;
   #1; if (value !== 8'haa || activations != 2) $fatal(1,"partial sensitivity");
   $finish;
 end
endmodule"#)
  (top Top) (run_to_finish))

(case nonblocking_latch_function_writes
  (source "nonblocking_latch_function_writes.sv" #"
module Top;
 bit d=1;
 logic q=0, mirror=0;
 logic default_q=0, default_mirror=0, explicit_q=0;
 bit folded_d=1;
 logic folded_q=0, folded_mirror=0, nested_q=0, nested_mirror=0;
 int activations=0, default_activations=0, folded_activations=0;
 function automatic logic sample_folded();
   if (0) folded_mirror=0;
   return folded_d;
 endfunction
 function automatic logic write_nested(); nested_mirror=0; return 0; endfunction
 function automatic logic sample_nested();
   if (0) return write_nested();
   return folded_d;
 endfunction
 function automatic logic sample_data(); mirror <= d; return d; endfunction
 function automatic logic sample_default(); default_mirror <= d; return d; endfunction
 function automatic logic inner(input logic arg=sample_default()); return arg; endfunction
 function automatic logic outer(input logic arg=inner()); return arg; endfunction
 always_latch begin activations++; q <= sample_data() ^ mirror; end
 always_latch begin
   default_activations++;
   explicit_q <= outer(d);
   default_q <= outer() ^ default_mirror;
 end
 always_latch begin
   folded_activations++;
   folded_q <= sample_folded() ^ folded_mirror;
   nested_q <= sample_nested() ^ nested_mirror;
 end
 initial begin
   #1; if (q !== 1 || mirror !== 1 || activations != 1) $fatal(1,"function write self trigger");
   if (default_q !== 1 || default_mirror !== 1 || explicit_q !== 1 || default_activations != 1)
     $fatal(1,"default function write self trigger");
   if (folded_q !== 1 || nested_q !== 1 || folded_activations != 1)
     $fatal(1,"folded function startup");
   folded_mirror=1; nested_mirror=1;
   d=0;
   #1; if (q !== 1 || mirror !== 0 || activations != 2) $fatal(1,"function write sensitivity");
   if (default_q !== 1 || default_mirror !== 0 || explicit_q !== 0 || default_activations != 2)
     $fatal(1,"default function write sensitivity");
   if (folded_q !== 1 || nested_q !== 1 || folded_activations != 1)
     $fatal(1,"folded function writes remain excluded");
   folded_d=0;
   #1; if (folded_q !== 1 || nested_q !== 1 || folded_activations != 2)
     $fatal(1,"folded function reads remain sensitive");
   $finish;
 end
endmodule"#)
  (top Top) (run_to_finish))

(case nonblocking_latch_declared_index_sensitivity
  (source "nonblocking_latch_declared_indices.sv" #"
module Top;
 logic [15:8] shifted=8'h21;
 logic [0:7] ascending=8'h43;
 logic [-1:-8] negative=8'h65;
 logic [3:2][7:4] packed_array=8'h87;
 logic [3:0] a, b, c, d;
 always_latch a <= shifted[11:8];
 always_latch b <= ascending[4:7];
 always_latch c <= negative[-5:-8];
 always_latch d <= packed_array[2];
 initial begin
   #1; if ({a,b,c,d} !== 16'h1357) $fatal(1,"declared index startup");
   shifted[11:8]=4'h9; ascending[4:7]=4'ha;
   negative[-5:-8]=4'hb; packed_array[2]=4'hc;
   #1; if ({a,b,c,d} !== 16'h9abc) $fatal(1,"declared index wakeup");
   $finish;
 end
endmodule"#)
  (top Top) (run_to_finish))
