(case container_records_survive_heap_collections
  (source "unpacked_struct_container_heap.sv" #"
module Top(output int n);
    typedef struct { string name; string regex; } acs_t;
    logic clk = 0;
    always #1 clk = ~clk;
    acs_t names[$];
    acs_t byname[string];
    string number;
    always @(posedge clk) begin
        number.itoa(n);
        names.push_back('{name: number, regex: {number, "*"}});
        if (names.size() > 3) void'(names.pop_front());
        byname[number] = '{name: {"n", number}, regex: ""};
        n = n + 1;
    end
    initial #6000 $display("%0d [%s] [%s] [%s] %0d", names.size(), names[0].name, names[$].regex,
        byname["2999"].name, byname.num());
endmodule
"#)
  (top Top)
  (run_until 6000)
  (expect_output "3 [2997] [2999*] [n2999] 3000\n"))
