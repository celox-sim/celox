(case class_properties_inheritance_and_collections
  (source "unpacked_struct_property_heap.sv" #"
module Top(output int n);
    class Node;
        string text;
    endclass
    typedef struct { Node m_type; string m_type_name; } pair_t;
    class Base;
        pair_t orig;
        function pair_t get();
            return orig;
        endfunction
        function bit same(pair_t p);
            return orig == p;
        endfunction
        function void set(string s);
            orig = '{m_type: null, m_type_name: s};
        endfunction
    endclass
    class Derived extends Base;
        pair_t ovrd;
        function void swap();
            pair_t t;
            t = orig;
            orig = ovrd;
            ovrd = t;
        endfunction
    endclass
    logic clk = 0;
    always #1 clk = ~clk;
    Derived d;
    string number;
    always @(posedge clk) begin
        number.itoa(n);
        d.set({number, "!"});
        d.ovrd.m_type = new;
        d.ovrd.m_type.text = number;
        n = n + 1;
    end
    initial begin
        pair_t g;
        d = new;
        d.set("x");
        g = d.get();
        $display("%s %0d", g.m_type_name, d.same(g));
        d.ovrd.m_type_name = "o";
        d.swap();
        $display("%s %s", d.orig.m_type_name, d.ovrd.m_type_name);
        #6000 $display("[%s] [%s] %0d", d.orig.m_type_name, d.ovrd.m_type.text, n);
    end
endmodule
"#)
  (top Top)
  (run_until 6000)
  (expect_output "x 1\no x\n[2999!] [2999] 3000\n"))

(case container_elements
  (source "unpacked_struct_containers.sv" #"
module Top(output bit done);
    class Node;
        string n;
        function new(string n);
            this.n = n;
        endfunction
    endclass
    typedef struct { string name; string regex; } acs_t;
    typedef struct { Node m_type; string m_type_name; } pair_t;
    typedef struct { pair_t orig; string alias_name; } alias_t;
    typedef struct { int read_time; int write_time; int unsigned read_count; } access_t;
    typedef enum { NEVER, STARTED, FINISHED } state_e;
    typedef struct { state_e state; bit ret_val; } info_t;
    initial begin
        acs_t q[$];
        acs_t s, t;
        alias_t aliases[$];
        access_t access[string];
        access_t ar;
        info_t states[int];
        info_t da[];
        Node a;
        s.name = "foo";
        s.regex = "";
        q.push_back(s);
        q.push_back('{name: "", regex: "b.*"});
        s.name = "changed";
        $display("size %0d %s|%s %s", q.size(), q[0].name, q[1].regex, q[$].regex);
        while (q.size()) begin
            t = q.pop_front();
            $display("acs %s|%s", t.name, t.regex);
        end
        a = new("A");
        aliases.push_back('{orig: '{a, "A"}, alias_name: "al"});
        $display("alias %s %s %s", aliases[0].orig.m_type.n, aliases[0].orig.m_type_name,
            aliases[0].alias_name);
        ar = access["x"];
        $display("miss %0d %0d %0d", ar.read_time, ar.read_count, access.exists("x"));
        ar.read_count++;
        ar.read_time = 5;
        access["x"] = ar;
        ar.read_count = 99;
        $display("hit %0d %0d %0d", access["x"].read_count, access["x"].read_time, access.num());
        states[3] = '{STARTED, 1};
        $display("info %0d %0d %0d", states[3].state, states[3].ret_val, states[4].state);
        da = new[2];
        da[1] = '{FINISHED, 1};
        $display("da %0d %0d %0d", da[0].state, da[1].state, da[1] == info_t'{FINISHED, 1});
        foreach (access[k]) $display("key %s %0d", k, access[k].read_count);
        done = 1;
    end
endmodule
"#)
  (top Top) (run_until 0) (assert_eq done 1)
  (expect_output "size 2 foo|b.* b.*\nacs foo|\nacs |b.*\nalias A A al\nmiss 0 0 0\nhit 1 5 1\ninfo 1 1 0\nda 0 2 1\nkey x 1\n"))

(case container_element_member_selects
