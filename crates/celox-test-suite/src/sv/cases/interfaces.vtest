(group interfaces (category hierarchy))

(case infers_directions_of_ports_without_modport
  (source "interface_port_directions.sv" #"
        interface Pair;
            logic [7:0] a;
            logic [7:0] b;
        endinterface
        module Writer(Pair p, input logic [7:0] x);
            assign p.a = x;
        endmodule
        module Reflect(Pair p);
            assign p.b = p.a + 8'd1;
        endmodule
        module Relay(Pair p);
            Reflect u(.p(p));
        endmodule
        module Top(input logic [7:0] x, output logic [7:0] y);
            Pair pair();
            Writer w(.p(pair), .x(x));
            Relay r(.p(pair));
            assign y = pair.b;
        endmodule
    "#)
  (top Top)
  (for value (list 0 0x41 0xff)
    (modify (set x value))
    (assert_eq y (trunc 8 (+ value 1)))))

(case binds_positional_connections_and_parameter_values
  (source "interface_positional.sv" #"
        interface Bus #(parameter int W = 4);
            logic [W-1:0] data;
            modport w(output data);
            modport r(input data);
        endinterface
        module Writer(Bus.w bus, input logic [15:0] v);
            assign bus.data = v[$bits(bus.data)-1:0];
        endmodule
        module Reader(Bus.r bus, output logic [15:0] o);
            always_comb begin
                o = '0;
                o[$bits(bus.data)-1:0] = bus.data;
            end
        endmodule
        module Top(input logic [15:0] v, output logic [15:0] o12, output logic [15:0] o4);
            Bus #(12) b12();
            Bus b4();
            Writer w12(b12, v);
            Writer w4(b4, v);
            Reader r12(b12, o12);
            Reader r4(.bus(b4), .o(o4));
        endmodule
    "#)
  (top Top)
  (for value (list 0 0x1234 0xffff)
    (modify (set v value))
    (assert_eq o12 (trunc 12 value))
    (assert_eq o4 (trunc 4 value))))

(case runs_interface_processes_once_per_array_element
  (source "interface_array_processes.sv" #"
        interface Acc;
            logic [7:0] a;
            logic [7:0] b;
            logic [8:0] sum;
            assign sum = a + b;
        endinterface
        module Top(input logic [7:0] x, output logic [8:0] s0, output logic [8:0] s2,
                   output logic [8:0] t10, output logic [8:0] t11);
            Acc row [3] ();
            Acc grid [2][2] ();
            for (genvar i = 0; i < 3; i++) begin : g
                assign row[i].a = x;
                assign row[i].b = i;
            end
            for (genvar i = 0; i < 2; i++) begin : gi
                for (genvar j = 0; j < 2; j++) begin : gj
                    assign grid[i][j].a = x;
                    assign grid[i][j].b = 2 * i + j;
                end
            end
            assign s0 = row[0].sum;
            assign s2 = row[2].sum;
            assign t10 = grid[1][0].sum;
            assign t11 = grid[1][1].sum;
        endmodule
    "#)
  (top Top)
  (for value (list 0 0x80 0xff)
    (modify (set x value))
    (assert_eq s0 value)
    (assert_eq s2 (+ value 2))
    (assert_eq t10 (+ value 2))
    (assert_eq t11 (+ value 3))))

(case calls_functions_and_reads_parameters_through_instances_and_ports
  (source "interface_functions.sv" #"
        interface Scale #(parameter int K = 3);
            logic [7:0] base;
            function automatic logic [7:0] scaled(input logic [7:0] v);
                return base + v * K;
            endfunction
            modport user(import scaled);
        endinterface
        module User(Scale.user s, input logic [7:0] v, output logic [7:0] o, output logic [7:0] k);
            assign o = s.scaled(v);
            assign k = 8'(s.K);
        endmodule
        module Top(input logic [7:0] b, input logic [7:0] v,
                   output logic [7:0] direct, output logic [7:0] via_port, output logic [7:0] k);
            Scale #(.K(5)) s();
            assign s.base = b;
            assign direct = s.scaled(v);
            User u(.s(s), .v(v), .o(via_port), .k(k));
        endmodule
    "#)
  (top Top)
  (for (base value) (list (0 0) (1 2) (0x10 0x33) (0xff 0xff))
    (modify (set b base) (set v value))
    (assert_eq direct (trunc 8 (+ base (* value 5))))
    (assert_eq via_port (trunc 8 (+ base (* value 5))))
    (assert_eq k 5)))

(case elaborates_net_members_typedefs_and_localparams
  (source "interface_typedefs.sv" #"
        interface Word #(parameter int W = 8);
            localparam int MAX = (1 << W) - 1;
            typedef logic [W-1:0] word_t;
            word_t value;
            wire full;
            assign full = value == MAX;
            modport src(output value);
            modport dst(input value, input full);
        endinterface
        module Src(Word.src w, input logic [15:0] x);
            assign w.value = x[$bits(w.value)-1:0];
        endmodule
        module Dst(Word.dst w, output logic [15:0] v, output logic f);
            always_comb begin
                v = '0;
                v[$bits(w.value)-1:0] = w.value;
            end
            assign f = w.full;
        endmodule
        module Top(input logic [15:0] x, output logic [15:0] v6, output logic f6,
                   output logic [15:0] v8, output logic f8);
            Word #(.W(6)) w6();
            Word w8();
            Src s6(.w(w6), .x(x));
            Src s8(.w(w8), .x(x));
            Dst d6(.w(w6), .v(v6), .f(f6));
            Dst d8(.w(w8), .v(v8), .f(f8));
        endmodule
    "#)
  (top Top)
  (for (value narrow narrow_full wide wide_full)
       (list (0x10 0x10 0 0x10 0) (0x3f 0x3f 1 0x3f 0) (0xff 0x3f 1 0xff 1))
    (modify (set x value))
    (assert_eq v6 narrow)
    (assert_eq f6 narrow_full)
    (assert_eq v8 wide)
    (assert_eq f8 wide_full)))

(case binds_generic_interface_ports_per_interface
  (source "interface_generic_ports.sv" #"
        interface Link;
            logic [7:0] req;
            logic [7:0] resp;
            modport client(output req, input resp);
            modport server(input req, output resp);
        endinterface
        interface Wide;
            logic [15:0] req;
            logic [15:0] resp;
            modport client(output req, input resp);
            modport server(input req, output resp);
        endinterface
        module Echo(interface.server s);
            assign s.resp = s.req + 1'b1;
        endmodule
        module Pass(interface s);
            Echo e(.s(s));
        endmodule
        module Top(input logic [15:0] x, output logic [7:0] narrow, output logic [15:0] wide);
            Link l();
            Wide w();
            assign l.req = x[7:0];
            assign w.req = x;
            Pass pl(.s(l));
            Pass pw(.s(w));
            assign narrow = l.resp;
            assign wide = w.resp;
        endmodule
    "#)
  (top Top)
  (for value (list 0 0x00ff 0x1234 0xffff)
    (modify (set x value))
    (assert_eq narrow (trunc 8 (+ value 1)))
    (assert_eq wide (trunc 16 (+ value 1)))))

(case clocks_interface_processes_from_member_clocks
  (source "interface_clocking.sv" #"
        interface Counter;
            logic clk;
            logic rst_n;
            logic [3:0] count;
            always_ff @(posedge clk or negedge rst_n)
                if (!rst_n) count <= 4'd0;
                else count <= count + 4'd1;
            modport drive(output clk, output rst_n);
            modport watch(input count);
        endinterface
        module Driver(Counter.drive c, input logic clk, input logic rst_n);
            assign c.clk = clk;
            assign c.rst_n = rst_n;
        endmodule
        module Watcher(Counter.watch c, output logic [3:0] count);
            assign count = c.count;
        endmodule
        module Top(input logic clk, input logic rst_n, output logic [3:0] count);
            Counter c();
            Driver d(.c(c), .clk(clk), .rst_n(rst_n));
            Watcher w(.c(c), .count(count));
        endmodule
    "#)
  (top Top)
  (modify (set rst_n 0))
  (modify (set rst_n 1))
  (assert_eq count 0)
  (tick clk 3)
  (assert_eq count 3))

(case reads_undriven_interface_members_as_unknown
  (four_state)
  (source "interface_undriven.sv" #"
        interface Lane;
            logic [7:0] data;
            logic [3:0] spare;
            modport w(output data);
            modport r(input data, input spare);
        endinterface
        module Writer(Lane.w l, input logic [7:0] a);
            assign l.data = a;
        endmodule
        module Reader(Lane.r l, output logic [7:0] data, output logic [3:0] spare);
            assign data = l.data;
            assign spare = l.spare;
        endmodule
        module Top(input logic [7:0] a, output logic [7:0] data, output logic [3:0] spare);
            Lane lane();
            Writer w(.l(lane), .a(a));
            Reader r(.l(lane), .data(data), .spare(spare));
        endmodule
    "#)
  (top Top)
  (modify (set a 0x5a))
  (assert_eq data 0x5a)
  (assert_eq spare (fourstate 0xf 0xf)))

(case overrides_body_parameters_and_drives_members_from_imported_functions
  (source "interface_body_parameters.sv" #"
        interface Reg;
            parameter W = 4;
            logic [W-1:0] state;
            function automatic void load(input logic [W-1:0] v);
                state = v;
            endfunction
            modport loader(import load);
        endinterface
        interface Util #(parameter int K = 2);
            function automatic logic [7:0] scaled(input logic [7:0] v);
                return v * K;
            endfunction
            modport user(import scaled);
        endinterface
        module Loader(Reg.loader r, input logic [15:0] v);
            always_comb r.load(v[r.W-1:0]);
        endmodule
        module Sum(Reg a, b, output logic [15:0] o);
            assign o = a.state + b.state;
        endmodule
        module Scaler(Util.user u, input logic [7:0] v, output logic [7:0] o);
            assign o = u.scaled(v);
        endmodule
        module Top(input logic [15:0] v, output logic [15:0] sum, output logic [7:0] scaled);
            Reg #(.W(8)) named();
            Reg #(12) ordered();
            Util #(.K(3)) util();
            Loader ln(.r(named), .v(v));
            Loader lo(.r(ordered), .v(v));
            Sum add(.a(named), .b(ordered), .o(sum));
            Scaler sc(.u(util), .v(v[7:0]), .o(scaled));
        endmodule
    "#)
  (top Top)
  (for value (list 0 0x0123 0x0fff 0xffff)
    (modify (set v value))
    (assert_eq sum (trunc 16 (+ (trunc 8 value) (trunc 12 value))))
    (assert_eq scaled (trunc 8 (* (trunc 8 value) 3)))))

(case rewrites_nested_references_and_keeps_declaration_functions
  (source "interface_nested_references.sv" #"
        interface Cfg #(parameter int N = 2);
        endinterface
        interface Lane;
            function automatic logic [3:0] inc(input logic [3:0] v);
                return v + 4'd1;
            endfunction
            logic [3:0] i0;
            logic [3:0] g0;
            assign g0 = inc(i0);
            modport r(input g0);
        endinterface
        interface Sized;
            function automatic int bits();
                return 4;
            endfunction
            logic [bits()-1:0] data;
            modport r(input data);
        endinterface
        module Reader(Lane.r l, output logic [3:0] o);
            assign o = l.g0;
        endmodule
        module SizedReader(Sized.r s, output logic [3:0] o);
            assign o = s.data;
        endmodule
        module Driver(Lane l, input logic [3:0] v);
            function automatic void drive(output logic [3:0] d, input logic [3:0] s);
                d = s;
            endfunction
            always_comb drive(l.i0, v);
        endmodule
        module Top(input logic [3:0] v, output logic [3:0] last, output logic [3:0] middle,
                   output logic [3:0] driven, output logic [3:0] sized);
            Cfg #(.N(3)) cfg();
            Lane rows [cfg.N] ();
            Lane one();
            Sized s();
            for (genvar i = 0; i < cfg.N; i++) begin : g
                assign rows[i].i0 = v + i;
            end
            Reader r(.l(rows[cfg.N - 1]), .o(last));
            assign middle = rows[1].g0;
            Driver d(.l(one), .v(v));
            assign driven = one.g0;
            assign s.data = v;
            SizedReader sr(.s(s), .o(sized));
        endmodule
    "#)
  (top Top)
  (for value (list 0 5 0xf)
    (modify (set v value))
    (assert_eq last (trunc 4 (+ value 3)))
    (assert_eq middle (trunc 4 (+ value 2)))
    (assert_eq driven (trunc 4 (+ value 1)))
    (assert_eq sized value)))

(case drives_members_through_child_outputs_and_array_generate_regions
  (source "interface_child_outputs.sv" #"
        interface Pair;
            logic [7:0] a;
            logic [7:0] b;
            generate
                if (1) begin : copy
                    assign b = a + 8'd1;
                end
            endgenerate
        endinterface
        module Inc(input logic [7:0] i, output logic [7:0] o);
            assign o = i + 8'd2;
        endmodule
        module Drive(Pair p, input logic [7:0] v);
            Inc u(.i(v), .o(p.a));
        endmodule
        module Top(input logic [7:0] v, output logic [7:0] b0, output logic [7:0] b1);
            Pair pairs [2] ();
            Drive d0(.p(pairs[0]), .v(v));
            Drive d1(.p(pairs[1]), .v(v + 8'd3));
            assign b0 = pairs[0].b;
            assign b1 = pairs[1].b;
        endmodule
    "#)
  (top Top)
  (for value (list 0 0x40 0xfc)
    (modify (set v value))
    (assert_eq b0 (trunc 8 (+ value 3)))
    (assert_eq b1 (trunc 8 (+ value 6)))))

(case initializes_interface_members_from_their_declarations
  (source "interface_initializers.sv" #"
        interface Cfg #(parameter int K = 3);
            logic [7:0] scale = 8'(K * 2);
            logic [7:0] in;
            logic [7:0] out;
            assign out = in * scale;
        endinterface
        module Top(input logic [7:0] x, output logic [7:0] y, output logic [7:0] s);
            Cfg #(.K(5)) c();
            assign c.in = x;
            assign y = c.out;
            assign s = c.scale;
        endmodule
    "#)
  (top Top)
  (for value (list 0 3 0x40)
    (modify (set x value))
    (assert_eq y (trunc 8 (* value 10)))
    (assert_eq s 10)))

(case runs_interface_array_processes_at_integer_boundaries
  (source "interface_array_boundaries.sv" #"
        interface Cell;
            logic [7:0] value;
            logic [7:0] result;
            assign result = value + 8'd1;
        endinterface
        module Top(input logic [7:0] x,
                   output logic [7:0] low0, low1, high0, high1, lone_low, lone_high);
            localparam int LO = -2147483647 - 1;
            localparam int HI = 2147483647;
            Cell down[LO+1:LO]();
            Cell up[HI-1:HI]();
            Cell single_low[LO:LO]();
            Cell single_high[HI:HI]();
            assign down[LO].value = x;
            assign down[LO+1].value = x + 8'd1;
            assign up[HI-1].value = x + 8'd2;
            assign up[HI].value = x + 8'd3;
            assign single_low[LO].value = x + 8'd4;
            assign single_high[HI].value = x + 8'd5;
            assign low0 = down[LO].result;
            assign low1 = down[LO+1].result;
            assign high0 = up[HI-1].result;
            assign high1 = up[HI].result;
            assign lone_low = single_low[LO].result;
            assign lone_high = single_high[HI].result;
        endmodule
    "#)
  (top Top)
  (for value (list 0 0x40 0xff)
    (modify (set x value))
    (assert_eq low0 (trunc 8 (+ value 1)))
    (assert_eq low1 (trunc 8 (+ value 2)))
    (assert_eq high0 (trunc 8 (+ value 3)))
    (assert_eq high1 (trunc 8 (+ value 4)))
    (assert_eq lone_low (trunc 8 (+ value 5)))
    (assert_eq lone_high (trunc 8 (+ value 6)))))

(case initializes_interface_array_members_from_their_declarations
  (source "interface_array_initializers.sv" #"
        interface Lane #(parameter int K = 3);
            logic [7:0] value = 8'(K * 2);
        endinterface
        module Top(output logic [7:0] first, second);
            Lane #(.K(5)) lanes[2]();
            assign first = lanes[0].value;
            assign second = lanes[1].value;
        endmodule
    "#)
  (top Top)
  (eval)
  (assert_eq first 10)
  (assert_eq second 10))

(case binds_interface_array_ports_in_declaration_order
  (source "interface_array_ports.sv" #"
        interface Lane #(parameter int W = 3);
            logic [W-1:0] value;
            modport writer(output value);
            modport reader(input value);
        endinterface
        module Writer #(parameter int N = 1)(Lane.writer lanes[N], input logic [7:0] x);
            for (genvar i = 0; i < N; i++) begin : g
                assign lanes[i].value = x + 8'(i);
            end
        endmodule
        module Reader(Lane.reader lanes[5:4], output logic [15:0] y);
            assign y = {lanes[5].value, lanes[4].value};
        endmodule
        module Relay(Lane.reader lanes[8:9], output logic [15:0] y);
            Reader r(.lanes(lanes), .y(y));
        endmodule
        module Top(input logic [7:0] x, output logic [15:0] y);
            if (1) begin : g
                Lane #(.W(8)) lanes[3:2]();
                Writer #(.N(2)) w(.lanes(lanes), .x(x));
                Relay r(.lanes(lanes), .y(y));
            end
        endmodule
    "#)
  (top Top)
  (for value (list 0 0x41 0xff)
    (modify (set x value))
    (assert_eq y (| (<< value 8) (trunc 8 (+ value 1))))))

(case binds_local_interfaces_before_dependent_declarations
  (source "interface_dependent_declarations.sv" #"
        interface Cfg #(parameter N = 3); endinterface
        module Top(input logic [7:0] x, output logic [7:0] y, output int width);
            localparam BASE = 5;
            Cfg #(BASE) cfg();
            localparam SIZE = cfg.N;
            Cfg #(SIZE + 1) next_cfg();
            typedef logic [next_cfg.N-1:0] word_t;
            word_t data;
            assign data = x;
            assign y = data;
            assign width = $bits(data);
        endmodule
    "#)
  (top Top)
  (for value (list 0 17 255)
    (modify (set x value))
    (assert_eq y (trunc 6 value))
    (assert_eq width 6)))

(case queries_interface_packed_struct_member_dimensions
  (source "interface_member_dimensions.sv" #"
        interface Packet;
            typedef struct packed { logic [2:0][7:0] field; } payload_t;
            payload_t payload;
        endinterface
        module Top(output int dimensions, output int size, output int selected_dimensions, output int selected_size);
            Packet i();
            assign dimensions = $dimensions(i.payload.field);
            assign size = $size(i.payload.field);
            assign selected_dimensions = $dimensions(i.payload.field[1]);
            assign selected_size = $size(i.payload.field[1]);
        endmodule
    "#)
  (top Top)
  (eval)
  (assert_eq dimensions 2)
  (assert_eq size 3)
  (assert_eq selected_dimensions 1)
  (assert_eq selected_size 8))

(case binds_interfaces_without_declaration_name_dependencies
  (source "interface_declaration_names.sv" #"
        interface I #(parameter N = 1); endinterface
        module Top(output int width);
            typedef struct packed { logic [16:0] later; } T;
            I #($bits(T)) first();
            I later();
            assign width = first.N;
        endmodule
    "#)
  (top Top)
  (eval)
  (assert_eq width 17))

(case keeps_lexical_names_in_interface_scopes
  (source "interface_lexical_names.sv" #"
        interface I;
            parameter f = 7;
            typedef struct packed { logic [2:0][7:0] field; } payload_t;
            payload_t payload;
        endinterface
        module Top(output int function_shape, output int block_shape, output int local_names);
            I i();
            I h();
            typedef struct packed { logic [4:0] field; } function_payload_t;
            typedef struct packed { function_payload_t payload; } function_packet_t;
            typedef struct packed { logic [6:0] field; } block_payload_t;
            typedef struct packed { block_payload_t payload; } block_packet_t;
            function automatic int shape();
                function_packet_t i;
                return $dimensions(i.payload.field) * 100 + $size(i.payload.field);
            endfunction
            function automatic int echo(input int h$f);
                return h$f;
            endfunction
            function automatic int local_value();
                int h$f = 11;
                return h$f;
            endfunction
            assign function_shape = shape();
            assign local_names = echo(9) + local_value();
            always_comb begin
                block_packet_t i;
                block_shape = $dimensions(i.payload.field) * 100 + $size(i.payload.field);
            end
        endmodule
    "#)
  (top Top)
  (eval)
  (assert_eq function_shape 105)
  (assert_eq block_shape 107)
  (assert_eq local_names 20))

(case propagates_interface_dependent_ports
  (source "interface_dependent_ports.sv" #"
        interface Cfg #(parameter N = 5); endinterface
        module Top(output logic [base.N-1:0] x, y, output logic [$bits(y)-1:0] z, output int width);
            localparam W = $bits(z);
            Cfg base();
            Cfg #(W) next_cfg();
            assign x = '1;
            assign y = x;
            assign z = y;
            assign width = next_cfg.N;
        endmodule
    "#)
  (top Top)
  (eval)
  (assert_eq x 31)
  (assert_eq y 31)
  (assert_eq z 31)
  (assert_eq width 5))

(case distinguishes_interface_dependency_bindings
  (source "interface_dependency_bindings.sv" #"
        package pkg;
            parameter int later = 7;
            typedef logic [10:0] word_t;
        endpackage
        interface I #(parameter N = 1); endinterface
        module Top(output int width);
            localparam W = pkg::later;
            pkg::word_t data;
            typedef struct packed { logic [12:0] later; } packet_t;
            packet_t packet;
            function automatic int value(input int later);
                return later + 1;
            endfunction
            localparam F = value(4);
            localparam S = $bits(packet.later);
            I #(W + F + S + $bits(data)) first();
            I later();
            I word_t();
            assign width = first.N;
        endmodule
    "#)
  (top Top)
  (eval)
  (assert_eq width 36))

(case binds_implicit_named_interface_ports
  (source "implicit_interface_ports.sv" #"
    interface Bus;
      logic [7:0] data;
      modport writer(output data);
      modport reader(input data);
    endinterface
    module Writer(Bus.writer iface, input logic [7:0] x);
      assign iface.data = x;
    endmodule
    module Reader(Bus.reader iface, output logic [7:0] y);
      assign y = iface.data;
    endmodule
    module Relay(Bus iface, output logic [7:0] y);
      Reader r(.iface, .y);
    endmodule
    module Top(input logic [7:0] x, output logic [7:0] y);
      Bus iface();
      Writer w(.iface, .x);
      Relay r(.iface, .y);
    endmodule
  "#)
  (top Top)
  (for value (list 0 0x41 0xff)
    (modify (set x value))
    (assert_eq y value)))

(case binds_implicit_named_interface_arrays_in_generate_scopes
  (source "implicit_interface_arrays.sv" #"
    interface Bus;
      logic [7:0] data;
      modport writer(output data);
      modport reader(input data);
    endinterface
    module Writer(Bus.writer iface[2], input logic [7:0] x);
      assign iface[0].data = x;
      assign iface[1].data = x + 8'd1;
    endmodule
    module Reader(Bus.reader iface[2], output logic [7:0] y);
      assign y = iface[0].data ^ iface[1].data;
    endmodule
    module Top(input logic [7:0] x, output logic [7:0] y, z);
      Bus iface[2]();
      Writer w(.iface, .x);
      Reader r(.iface, .y);
      if (1) begin : inner
        Bus iface[2]();
        Writer w(.iface, .x(~x));
        Reader r(.iface, .y(z));
      end
    endmodule
  "#)
  (top Top)
  (for value (list 0 0x41 0xff)
    (modify (set x value))
    (assert_eq y (^ value (trunc 8 (+ value 1))))
    (assert_eq z (^ (trunc 8 (~ value)) (trunc 8 (+ (trunc 8 (~ value)) 1))))))
