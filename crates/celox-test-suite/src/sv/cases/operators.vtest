  (assert_eq signed_result 0xff80)
  (assert_eq formal_signed_shift 0))

(case negates_wide_systemverilog_values
  (source "wide_negate.sv" #"
        module Top(input logic [127:0] a, output logic [127:0] y);
            assign y = -a;
        endmodule
    "#)
  (top Top)
  (let modulus (<< 1 128))
  (let value (<< 1 64))
  (set a value)
  (assert_eq y (- modulus value))
  (set a 0)
