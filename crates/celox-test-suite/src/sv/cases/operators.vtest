(case guards_division_by_zero_nested_under_muxes
  (four_state)
  (source "nested_zero_div.sv" #"
        module Top(input logic select, input logic [7:0] a, b, output logic [7:0] y);
            assign y = select ? (a / b) : 8'h00;
        endmodule
    "#)
  (top Top)
  (modify
    (set select 1)
    (set a 5)
    (set b 0))
  (assert_eq y (fourstate 0xff 0xff)))

(case zero_extends_mixed_signed_arithmetic_operands
  (source "mixed_signed_width.sv" #"
        module Top(
            input logic clk,
            input logic signed [7:0] a,
            input logic [15:0] b,
            output logic [15:0] comb,
            output logic [15:0] q
        );
            assign comb = a + b;
            always_ff @(posedge clk) q <= a + b;
        endmodule
    "#)
  (top Top)
  (modify
    (set a 0xff)
    (set b 0))
  (assert_eq comb 0x00ff)
  (tick clk)
  (assert_eq q 0x00ff))

(case propagates_child_input_width_into_connection_expressions
  (source "connection_context.sv" #"
        module Child(input logic [15:0] value, output logic [15:0] y);
            assign y = value;
        endmodule
        module Top(input logic [7:0] a, output logic [15:0] y);
            Child child(.value(a << 8), .y(y));
        endmodule
    "#)
  (top Top)
  (modify (set a 1))
  (assert_eq y 0x0100))

(case preserves_signed_parameter_types_in_hierarchy_connections
  (source "parameter_connection_type.sv" #"
        module Child(input logic signed [63:0] value, output logic [63:0] y);
            assign y = value;
        endmodule
        module Top #(
            parameter logic signed [7:0] P = -1
        ) (output logic [63:0] y);
            Child child(.value(P), .y(y));
        endmodule
    "#)
  (top Top)
  (assert_eq y 0xffffffffffffffff))

(case converts_function_arguments_using_actual_signedness
  (source "function_argument_signedness.sv" #"
        module Top(
            input logic [7:0] unsigned_value,
            input logic signed [7:0] signed_value,
            output logic [15:0] unsigned_result,
            output logic [15:0] signed_result,
            output logic [15:0] formal_signed_shift
        );
            function automatic logic signed [15:0] pass_signed(
                input logic signed [15:0] value
            );
                return value;
            endfunction
            function automatic logic signed [15:0] shift_signed(
                input logic signed [15:0] value
            );
                return value >>> 8;
            endfunction

            assign unsigned_result = pass_signed(unsigned_value);
            assign signed_result = pass_signed(signed_value);
            assign formal_signed_shift = shift_signed(unsigned_value);
        endmodule
    "#)
  (top Top)
  (modify
    (set unsigned_value 0x80)
    (set signed_value 0x80))
  (assert_eq unsigned_result 0x0080)
  (assert_eq signed_result 0xff80)
  (assert_eq formal_signed_shift 0))

(case negates_wide_systemverilog_values
  (source "wide_negate.sv" #"
        module Top(input logic [127:0] a, output logic [127:0] y);
            assign y = -a;
        endmodule
    "#)
  (top Top)
  (let modulus (<< 1 128))
  (let value (<< 1 64))
  (set a value)
  (assert_eq y (- modulus value))
  (set a 0)
  (assert_eq y 0))

(case unknown_logical_operand_evaluates_effectful_right_operand
  ; IEEE 1800-2023 11.4.7: the second operand of && is skipped only when the
  ; first is logically false, and that of || only when it is logically true.
  ; An ambiguous (x) first operand evaluates the second in both.
  (four_state)
  (source "logical_short_circuit.sv" #"
        module Top(
            input bit clk,
            input logic u,
            output logic and_hit,
            output logic or_hit,
            output logic and_result,
            output logic or_result,
            output logic ff_and_hit,
            output logic ff_or_hit,
            output logic ff_and_result,
            output logic ff_or_result
        );
            logic ff_and_seen, ff_or_seen;

            function automatic logic mark_and();
                and_hit = 1'b1;
                return 1'b1;
            endfunction
            function automatic logic mark_or();
                or_hit = 1'b1;
                return 1'b1;
            endfunction
            function automatic logic mark_ff_and();
                ff_and_seen = 1'b1;
                return 1'b1;
            endfunction
            function automatic logic mark_ff_or();
                ff_or_seen = 1'b1;
                return 1'b1;
            endfunction

            always_comb begin
                and_hit = 1'b0;
                or_hit = 1'b0;
                and_result = u && mark_and();
                or_result = u || mark_or();
            end

            always_ff @(posedge clk) begin
                ff_and_seen = 1'b0;
                ff_or_seen = 1'b0;
                ff_and_result <= u && mark_ff_and();
                ff_or_result <= u || mark_ff_or();
                ff_and_hit <= ff_and_seen;
                ff_or_hit <= ff_or_seen;
            end
        endmodule
    "#)
  (top Top)
  (for (value and_effect or_effect and_value or_value)
       (list
         ((fourstate 1 1) 1 1 (fourstate 1 1) 1)
         (0 0 1 0 1)
         (1 1 0 1 1))
    (modify (set u value))
    (assert_eq and_hit and_effect)
    (assert_eq or_hit or_effect)
    (assert_eq and_result and_value)
    (assert_eq or_result or_value)
    (tick clk)
    (assert_eq ff_and_hit and_effect)
    (assert_eq ff_or_hit or_effect)
    (assert_eq ff_and_result and_value)
    (assert_eq ff_or_result or_value)))

; Runtime arithmetic right shifts copy an unknown sign into every fill bit,
; also for counts beyond the vector width.
(case wide_arithmetic_shift_preserves_unknown_sign
  (four_state)
  (source "unknown_sign_shift.sv" #"
    module Top(input logic signed [127:0] a128, input logic [31:0] amount,
               output logic signed [127:0] y128);
      assign y128 = a128 >>> amount;
    endmodule
  "#)
  (top Top)
  (for amount (list 0 1 32 63 64 65 127 128 255 0xffffffff)
    (for sign_value (list 0 1)
      (modify
        (set amount amount)
        (set a128 (fourstate (| (<< sign_value 127) 5) (<< 1 127))))
      (expand (width name) ((128 y128))
        (let all (- (<< 1 {width}) 1))
        (let fill (^ all (>> all (min (+ amount 1) {width}))))
        (assert_eq {name} (fourstate (| (? sign_value fill 0) (>> 5 (min amount {width}))) fill))))))

(case partial_word_shift_sign_z_65
  (four_state)
  (source "top.sv" #"
module Top(input logic signed [64:0] a, input logic [31:0] n,
           output logic signed [64:0] y);
    assign y = a >>> n;
endmodule
"#)
  (top Top)
  (modify (set a (fourstate 0x5 0x10000000000000000)) (set n 1))
  (assert_eq y (fourstate 0x2 0x18000000000000000)))

(case partial_word_shift_sign_x_65
  (four_state)
  (source "top.sv" #"
module Top(input logic signed [64:0] a, input logic [31:0] n,
           output logic signed [64:0] y);
    assign y = a >>> n;
endmodule
"#)
  (top Top)
  (modify (set a (fourstate 0x10000000000000005 0x10000000000000000)) (set n 1))
  (assert_eq y (fourstate 0x18000000000000002 0x18000000000000000)))
