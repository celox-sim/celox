(case size_casts_resolve_generated_locals_and_parameter_expressions
  (source "scoped_cast.sv" #"
        module Child #(parameter N=2, parameter signed S=-3)(input logic [7:0] bus_data,
            input logic select, input logic [7:0] data,
            output logic [15:0] y, signed_value, unsigned_value);
            if (N>1) begin : g
                logic [7:0] saved;
                assign saved=data;
                assign y=16'(select ? saved : bus_data);
                assign signed_value=16'(S+1);
                assign unsigned_value=16'(8'(8'(N)-8'd3));
            end
        endmodule
        module Top(input logic select, input logic [7:0] data,
            output logic [15:0] y, signed_value, unsigned_value);
            Child child(8'h80, select, data, y, signed_value, unsigned_value);
        endmodule
    "#)
  (top Top)
  (modify (set select 0) (set data 0xf1))
  (assert_eq y 0x80)
  (assert_eq signed_value 0xfffe)
  (assert_eq unsigned_value 0xff)
  (modify (set select 1))
  (assert_eq y 0xf1))

(case parameter_size_casts_in_generate_conditions
