(case unknown_logical_operand_evaluates_effectful_right_operand
  ; IEEE 1800-2023 11.4.7: the second operand of && is skipped only when the
  ; first is logically false, and that of || only when it is logically true.
  ; An ambiguous (x) first operand evaluates the second in both.
  (four_state)
  (source "logical_short_circuit.sv" #"
        module Top(
            input bit clk,
            input logic u,
            output logic and_hit,
            output logic or_hit,
            output logic and_result,
            output logic or_result,
            output logic ff_and_hit,
            output logic ff_or_hit,
            output logic ff_and_result,
            output logic ff_or_result
        );
            logic ff_and_seen, ff_or_seen;

            function automatic logic mark_and();
                and_hit = 1'b1;
                return 1'b1;
            endfunction
            function automatic logic mark_or();
                or_hit = 1'b1;
                return 1'b1;
            endfunction
            function automatic logic mark_ff_and();
                ff_and_seen = 1'b1;
                return 1'b1;
            endfunction
            function automatic logic mark_ff_or();
                ff_or_seen = 1'b1;
                return 1'b1;
            endfunction

            always_comb begin
                and_hit = 1'b0;
                or_hit = 1'b0;
                and_result = u && mark_and();
                or_result = u || mark_or();
            end

            always_ff @(posedge clk) begin
                ff_and_seen = 1'b0;
                ff_or_seen = 1'b0;
                ff_and_result <= u && mark_ff_and();
                ff_or_result <= u || mark_ff_or();
                ff_and_hit <= ff_and_seen;
                ff_or_hit <= ff_or_seen;
            end
        endmodule
    "#)
  (top Top)
  (for (value and_effect or_effect and_value or_value)
       (list
         ((fourstate 1 1) 1 1 (fourstate 1 1) 1)
         (0 0 1 0 1)
         (1 1 0 1 1))
    (modify (set u value))
    (assert_eq and_hit and_effect)
    (assert_eq or_hit or_effect)
    (assert_eq and_result and_value)
    (assert_eq or_result or_value)
    (tick clk)
    (assert_eq ff_and_hit and_effect)
    (assert_eq ff_or_hit or_effect)
    (assert_eq ff_and_result and_value)
    (assert_eq ff_or_result or_value)))

; Runtime arithmetic right shifts copy an unknown sign into every fill bit,
; also for counts beyond the vector width.
(case wide_arithmetic_shift_preserves_unknown_sign
  (four_state)
  (source "unknown_sign_shift.sv" #"
    module Top(input logic signed [127:0] a128, input logic [31:0] amount,
               output logic signed [127:0] y128);
      assign y128 = a128 >>> amount;
    endmodule
  "#)
  (top Top)
  (for amount (list 0 1 32 63 64 65 127 128 255 0xffffffff)
    (for sign_value (list 0 1)
      (modify
        (set amount amount)
        (set a128 (fourstate (| (<< sign_value 127) 5) (<< 1 127))))
      (expand (width name) ((128 y128))
        (let all (- (<< 1 {width}) 1))
        (let fill (^ all (>> all (min (+ amount 1) {width}))))
        (assert_eq {name} (fourstate (| (? sign_value fill 0) (>> 5 (min amount {width}))) fill))))))

(case partial_word_shift_sign_z_65
  (four_state)
  (source "top.sv" #"
module Top(input logic signed [64:0] a, input logic [31:0] n,
           output logic signed [64:0] y);
    assign y = a >>> n;
endmodule
"#)
  (top Top)
  (modify (set a (fourstate 0x5 0x10000000000000000)) (set n 1))
  (assert_eq y (fourstate 0x2 0x18000000000000000)))

(case partial_word_shift_sign_x_65
  (four_state)
  (source "top.sv" #"
module Top(input logic signed [64:0] a, input logic [31:0] n,
           output logic signed [64:0] y);
    assign y = a >>> n;
endmodule
"#)
  (top Top)
  (modify (set a (fourstate 0x10000000000000005 0x10000000000000000)) (set n 1))
  (assert_eq y (fourstate 0x18000000000000002 0x18000000000000000)))

; IEEE 1800-2023 11.8.2: widen each context-determined operand before
; evaluating its parent operation, including comparison and concat results.
(case nested_operands_extend_before_context_operations
  (source "nested_width.sv" #"
module Top(input logic clk, input logic [7:0] a, b,
           output logic [7:0] shifted, sum, ff_shifted,
           output logic [15:0] concatenated, low_concat, from_function, fill_left, fill_right, powered);
    assign powered = {a[3:0], b[3:0]} ** 8'd2;
    assign fill_left = '1 | (b >= 4'd5);
    assign fill_right = (b >= 4'd5) | '1;
    assign shifted = (b >= 4'd5) << 3'd3;
    assign sum = (b >= 4'd5) + (a >= 4'd5);
    assign concatenated = {a[7], b} << 8'd1;
    assign low_concat = {a[3:0], b[3:0]} << 4'd1;
    always_ff @(posedge clk) ff_shifted <= (b >= 4'd5) << 3'd3;
    function automatic logic [15:0] add_comparisons(input logic [7:0] x, y);
        return (x >= 4'd5) + (y >= 4'd5);
    endfunction
    assign from_function = add_comparisons(a, b);
endmodule
"#)
  (top Top)
  (modify (set a 0x9e) (set b 0x13))
  (assert_eq powered 0xc949)
  (assert_eq fill_left 0xffff)
  (assert_eq fill_right 0xffff)
  (assert_eq shifted 8)
  (assert_eq sum 2)
  (assert_eq concatenated 0x226)
  (assert_eq low_concat 0x1c6)
  (assert_eq from_function 2)
  (tick clk)
  (assert_eq ff_shifted 8))

; IEEE 1800-2023 11.4.6: `!=?` is the logical negation of `==?`. An
; indeterminate wildcard comparison is therefore X in both operators and
; equal to `!` of the other one; only a definite mismatch (or match) clears
; the mask. A result that is unknown must be encoded as payload 1 / mask 1,
; never as Z (payload 0 / mask 1).
(case wildcard_comparisons_normalize_unknown_to_x
  (four_state)
  (source "wildcard_normalize.sv" #"
module Top(input logic [3:0] x, input logic [3:0] y,
           output logic eqw, newq, not_eqw);
    assign eqw = (x ==? y);
    assign newq = (x !=? y);
    assign not_eqw = !(x ==? y);
endmodule
"#)
  (top Top)
  ; x = 4'b01zz, y = 4'b0100: the compared bits agree, the remaining z bits
  ; are unknown (not wildcards, because y has no X/Z bits), so all three
  ; results are X.
  (modify (set x (fourstate 4 3)) (set y 4))
  (assert_eq eqw (fourstate 1 1))
  (assert_eq newq (fourstate 1 1))
  (assert_eq not_eqw (fourstate 1 1))
  ; X payload bits differ from y, but no compared known bit mismatches.
  (modify (set x (fourstate 7 3)) (set y 4))
  (assert_eq eqw (fourstate 1 1))
  (assert_eq newq (fourstate 1 1))
  (assert_eq not_eqw (fourstate 1 1))
  ; x = 4'b0101, y = 4'b0100: a definite mismatch at a compared position
  ; makes both operators definite.
  (modify (set x 5) (set y 4))
  (assert_eq newq (fourstate 1 0))
  (assert_eq eqw (fourstate 0 0))
  (assert_eq not_eqw (fourstate 1 0))
  (modify (set x (fourstate 4 3)) (set y (fourstate 4 3)))
  (assert_eq eqw (fourstate 1 0))
  (assert_eq newq (fourstate 0 0))
  (assert_eq not_eqw (fourstate 0 0)))

; The same contract for operands wider than one machine word, which take the
; multi-chunk comparison path.
(case wide_wildcard_comparisons_normalize_unknown_to_x
  (four_state)
  (source "wide_wildcard_normalize.sv" #"
module Top(input logic [127:0] x, input logic [127:0] y,
           output logic eqw, newq, not_eqw);
    assign eqw = (x ==? y);
    assign newq = (x !=? y);
    assign not_eqw = !(x ==? y);
endmodule
"#)
  (top Top)
  ; x = 128'h...04 with bits 1:0 unknown (z), y = 128'h...04: the compared
  ; bits agree and the z bits are not wildcards, so all three results are X.
  (modify (set x (fourstate 4 3)) (set y 4))
  (assert_eq eqw (fourstate 1 1))
  (assert_eq newq (fourstate 1 1))
  (assert_eq not_eqw (fourstate 1 1))
  ; A definite mismatch above bit 64 clears the mask.
  (modify (set x (fourstate (| 4 (<< 1 65)) 3)) (set y 4))
  (assert_eq newq (fourstate 1 0))
  (assert_eq eqw (fourstate 0 0))
  (assert_eq not_eqw (fourstate 1 0)))

(case multidimensional_packed_declared_ranges
  (source "packed_declared_ranges.sv" #"
        module Top(input logic [1:5][1:6] value, input int row, col,
                   output logic [1:6] selected,
                   output logic bit_value,
                   output logic [11:0] slice, indexed,
                   output logic queries);
            bit [1:5][1:6] ascending;
            logic [7:3][-2:-7] descending;
            logic [-2:2][6:1] mixed;
            always_comb begin
                ascending = value;
                descending = value;
                mixed = value;
                selected = ascending[row];
                bit_value = selected[col];
                slice = descending[6:5];
                indexed = mixed[-1 +: 2];
                queries = $bits(ascending) == 30 && $dimensions(ascending) == 2
                       && $size(ascending, 1) == 5 && $size(ascending, 2) == 6
                       && $left(ascending, 1) == 1 && $right(ascending, 2) == 6
                       && $low(descending, 2) == -7 && $high(descending, 2) == -2
                       && $increment(ascending, 1) == -1
                       && $increment(descending, 2) == 1;
            end
        endmodule
    "#)
  (top Top)
  (modify (set value 0x12345678) (set row 1) (set col 1))
  (assert_eq selected 0x12)
  (assert_eq bit_value 0)
  (assert_eq slice 0x345)
  (assert_eq indexed 0x345)
  (assert_eq queries 1)
  (modify (set row 5) (set col 3))
  (assert_eq selected 0x38)
  (assert_eq bit_value 1))

(case multidimensional_packed_declared_range_writes
  (source "packed_declared_range_writes.sv" #"
        module Top(input int row, col, input logic bit_value,
                   output logic [29:0] value, output logic [11:0] slices,
                   output logic [5:0] negative);
            bit [1:5][1:6] ascending;
            bit [1:6] element;
            logic [7:3][-2:-7] descending;
            always_comb begin
                element = '0;
                element[col] = bit_value;
                ascending = '0;
                ascending[row] = element;
                ascending[2][2:4] = 3'b101;
                ascending[4][3 +: 2] = 2'b11;
                descending = '0;
                descending[6:5] = 12'habc;
                descending[4][-4 -: 3] = 3'b101;
                value = ascending;
                negative = descending[4];
                slices = {descending[6][-2:-7], descending[5][-7 +: 6]};
            end
        endmodule
    "#)
  (top Top)
  (modify (set row 1) (set col 1) (set bit_value 1))
  (assert_eq value 0x20500300)
  (assert_eq slices 0xabc)
  (assert_eq negative 0x0a)
  (modify (set row 5) (set col 6))
  (assert_eq value 0x00500301)
  (modify (set row 6) (set col 1))
  (assert_eq value 0x00500300))

(case multidimensional_packed_declared_ranges_four_state
  (four_state)
  (source "packed_declared_ranges.sv" #"
        module Top(input logic [1:5][1:6] value, input int row, col,
                   output logic [1:6] selected,
                   output logic bit_value,
                   output logic [11:0] slice, indexed,
                   output logic queries);
            bit [1:5][1:6] ascending;
            logic [7:3][-2:-7] descending;
            logic [-2:2][6:1] mixed;
            always_comb begin
                ascending = value;
                descending = value;
                mixed = value;
                selected = ascending[row];
                bit_value = selected[col];
                slice = descending[6:5];
                indexed = mixed[-1 +: 2];
                queries = $bits(ascending) == 30 && $dimensions(ascending) == 2
                       && $size(ascending, 1) == 5 && $size(ascending, 2) == 6
                       && $left(ascending, 1) == 1 && $right(ascending, 2) == 6
                       && $low(descending, 2) == -7 && $high(descending, 2) == -2
                       && $increment(ascending, 1) == -1
                       && $increment(descending, 2) == 1;
            end
        endmodule
    "#)
  (top Top)
  (modify (set value 0x12345678) (set row 1) (set col 1))
  (assert_eq selected 0x12)
  (assert_eq bit_value 0)
  (assert_eq slice 0x345)
  (assert_eq indexed 0x345)
  (assert_eq queries 1)
  (modify (set row 5) (set col 3))
  (assert_eq selected 0x38)
  (assert_eq bit_value 1))

(case wide_reduction_and_respects_partial_storage_words
  (source "partial_reduction.sv" #"
    module Top(input logic [980:0] a, output logic all_set);
      assign all_set = &a;
    endmodule
  "#)
  (top Top)
  (let ones (- (<< 1 981) 1))
  (modify (set a ones))
  (assert_eq all_set 1)
  (for bit (range 0 981)
    (modify (set a (^ ones (<< 1 bit))))
    (assert_eq all_set 0 "each declared bit contributes, including the partial last word"))
  (modify (set a ones))
  (assert_eq all_set 1))

(case preserves_power_signedness_in_arithmetic
  (source "power_signedness.sv" #"
    module Top(input logic clk, input logic [12:0] diff,
               input logic [19:0] integral, input logic [7:0] base,
               input logic [3:0] exponent,
               output logic [31:0] mul, div, signed_power, unsigned_power,
               output logic signed [31:0] signed_mul,
               output logic [21:0] sized_mul,
               output logic [19:0] comb_mul, comb_div, ff_mul, ff_div,
               output logic [1:0] ovf_mul, ovf_div);
      // IEEE 1800-2023 11.6.1 / Table 11-21: the exponent is
      // self-determined; the base determines the power's signedness.
      assign mul = $signed(diff) * 2**2;
      assign signed_mul = $signed(diff) * 2**2;
      assign div = $signed(diff) / 2**4;
      assign sized_mul = 22'($signed(diff) * 2**2);
      assign signed_power = ($signed(base) ** exponent) / 2;
      assign unsigned_power = (base ** $signed(exponent)) / 2;
      always_comb begin
        {ovf_mul, comb_mul} = $signed({1'b0, integral}) + 22'($signed(diff) * 2**2);
        {ovf_div, comb_div} = $signed({1'b0, integral}) + 22'($signed(diff) / 2**4);
      end
      always_ff @(posedge clk) begin
        ff_mul <= $signed({1'b0, integral}) + 22'($signed(diff) * 2**2);
        ff_div <= $signed({1'b0, integral}) + 22'($signed(diff) / 2**4);
      end
    endmodule
  "#)
  (top Top)
  (modify (set clk 0) (set diff 7808) (set integral 446216)
          (set base 253) (set exponent 3))
  (assert_eq mul 0xfffffa00)
  (assert_eq signed_mul 0xfffffa00)
  (assert_eq div 0xffffffe8)
  (assert_eq sized_mul 0x3ffa00)
  (assert_eq signed_power 0xfffffff3)
  (assert_eq unsigned_power 8097138)
  (assert_eq comb_mul 444680)
  (assert_eq comb_div 446192)
  (assert_eq ovf_mul 0)
  (assert_eq ovf_div 0)
  (tick clk)
  (assert_eq ff_mul 444680)
  (assert_eq ff_div 446192)
  (modify (set clk 0) (set diff 384) (set base 3))
  (assert_eq mul 1536)
  (assert_eq div 24)
  (assert_eq signed_power 13)
  (assert_eq unsigned_power 13)
  (assert_eq comb_mul 447752)
  (assert_eq comb_div 446240)
  (tick clk)
  (assert_eq ff_mul 447752)
  (assert_eq ff_div 446240))

(case preserves_power_signedness_in_four_state_arithmetic
  (four_state)
  (source "power_signedness_four_state.sv" #"
    module Top(input logic [12:0] diff, input logic [3:0] exponent,
               output logic [31:0] mul, div, dynamic_mul);
      assign mul = $signed(diff) * 2**2;
      assign div = $signed(diff) / 2**4;
      assign dynamic_mul = $signed(diff) * (2 ** exponent);
    endmodule
  "#)
  (top Top)
  (modify (set diff 7808) (set exponent 2))
  (assert_eq mul 0xfffffa00)
  (assert_eq div 0xffffffe8)
  (assert_eq dynamic_mul 0xfffffa00)
  (modify (set diff 8191) (set exponent 4))
  (assert_eq mul 0xfffffffc)
  (assert_eq div 0)
  (assert_eq dynamic_mul 0xfffffff0))

; IEEE 1800-2023 6.24.1: a size cast preserves operand signedness.
(case casts_preserve_guarded_division_signedness
  (source "guarded_division_casts.sv" #"
    module Top #(parameter DIVISOR = 2)(
      input logic signed [12:0] a,
      input logic signed [3:0] b,
      input logic [3:0] u,
      output logic [31:0] quotient, remainder, mixed, narrowed, nested,
      output logic [31:0] parameter_quotient, typed, unsigned_quotient, signed_mixed);
      assign quotient = 32'(a / b);
      assign remainder = 32'(a % b);
      assign mixed = 32'(a / u);
      assign narrowed = 4'(a / b);
      assign nested = 32'((a / b) / b);
      assign parameter_quotient = 32'(a / DIVISOR);
      assign typed = int'(a / b);
      assign unsigned_quotient = unsigned'(a / b);
      assign signed_mixed = signed'(a / u);
    endmodule
  "#)
  (top Top)
  (modify (set a 0x1ff3) (set b 2) (set u 2))
  (assert_eq quotient 0xfffffffa)
  (assert_eq remainder 0xffffffff)
  (assert_eq mixed 4089)
  (assert_eq narrowed 0xfffffffa)
  (assert_eq nested 0xfffffffd)
  (assert_eq parameter_quotient 0xfffffffa)
  (assert_eq typed 0xfffffffa)
  (assert_eq unsigned_quotient 8186)
  (assert_eq signed_mixed 4089)
  (modify (set u 1))
  (assert_eq signed_mixed 0xfffffff3)
  (modify (set u 2))
  (modify (set a 13) (set b 0xe))
  (assert_eq quotient 0xfffffffa)
  (assert_eq remainder 1)
  (assert_eq mixed 6)
  (assert_eq narrowed 0xfffffffa)
  (assert_eq nested 3)
  (assert_eq parameter_quotient 6)
  (assert_eq typed 0xfffffffa)
  (assert_eq unsigned_quotient 8186)
  (assert_eq signed_mixed 6))

(case casts_preserve_guarded_division_unknowns
  (four_state)
  (source "guarded_division_unknowns.sv" #"
    module Top(input logic signed [12:0] a, input logic signed [3:0] b,
      output logic [31:0] quotient, remainder, nested,
      output int two_state);
      assign quotient = 32'(a / b);
      assign remainder = 32'(a % b);
      assign nested = 32'((a / b) / b);
      assign two_state = int'(a / b);
    endmodule
  "#)
  (top Top)
  (modify (set a 0x1ff3) (set b 2))
  (assert_eq quotient 0xfffffffa)
  (assert_eq remainder 0xffffffff)
  (assert_eq nested 0xfffffffd)
  (assert_eq two_state 0xfffffffa)
  (modify (set b 0))
  (assert_eq quotient (fourstate 0xffffffff 0xffffffff))
  (assert_eq remainder (fourstate 0xffffffff 0xffffffff))
  (assert_eq nested (fourstate 0xffffffff 0xffffffff))
  (assert_eq two_state 0))

(case masked_shift_fields_keep_expression_width
  ; IEEE 1800-2023 11.6.1: `(a >> 4) & 15` is 32 bits wide; the extracted
  ; field is zero-extended before comparisons, subtraction and indexing.
  (source "masked_shift_fields.sv" #"
    module Top(input logic clk, input logic [31:0] a, input logic [7:0] d,
      output logic hit, output logic [31:0] field_minus_one, output logic [7:0] q);
      logic [7:0] mem [16];
      assign hit = ((a >> 4) & 15) == 32'd9;
      assign field_minus_one = ((a >> 4) & 15) - 1;
      always_ff @(posedge clk) mem[(a >> 4) & 15] <= d;
      assign q = mem[a[3:0]];
    endmodule
  "#)
  (top Top)
  (modify (set a 0x95) (set d 0xab))
  (assert_eq hit 1)
  (assert_eq field_minus_one 8)
  (tick clk)
  (modify (set a 0x09))
  (assert_eq hit 0)
  (assert_eq field_minus_one 0xffffffff)
  (assert_eq q 0xab))

(case logical_implication
  ; IEEE 1800-2023 11.4.7: implication short-circuits for a false antecedent.
  (source "logical_implication.sv" #"
        module Top(input logic [3:0] a, input logic b, output logic y,
                   output logic hit, output logic constant_result);
            localparam bit C = 2 -> 0;
            function automatic logic mark();
                hit = 1;
                return b;
            endfunction
            always_comb begin
                hit = 0;
                y = a -> mark();
            end
            assign constant_result = C;
        endmodule
    "#)
  (top Top)
  (modify (set a 2) (set b 0))
  (assert_eq y 0)
  (assert_eq hit 1)
  (assert_eq constant_result 0)
  (set a 0)
  (assert_eq y 1)
  (modify (set a 2) (set b 1))
  (assert_eq y 1))

(case logical_implication_unknown
  (four_state)
  (source "logical_implication_unknown.sv" #"
        module Top(input logic a, input logic b, output logic y, output logic hit);
            function automatic logic mark();
                hit = 1;
                return b;
            endfunction
            always_comb begin
                hit = 0;
                y = a -> mark();
            end
        endmodule
    "#)
  (top Top)
  (set a (fourstate 1 1))
  (set b 0)
  (assert_eq y (fourstate 1 1))
  (assert_eq hit 1)
  (set b 1)
  (assert_eq y 1)
  (assert_eq hit 1))

(case logical_implication_short_circuit
  (source "logical_implication_short_circuit.sv" #"
        module Top(output logic hit, output logic y);
            function automatic logic mark();
                hit = 1;
                return 0;
            endfunction
            initial begin
                hit = 0;
                y = 1'b0 -> mark();
            end
        endmodule
    "#)
  (top Top)
  (assert_eq hit 0)
  (assert_eq y 1))

(case logical_equivalence
  (source "logical_equivalence.sv" #"
    module Top(input logic [3:0] a, b, output logic y, output logic c);
      localparam bit C = 4 <-> 2;
      assign y = a <-> b;
      assign c = C;
    endmodule
  "#)
  (top Top)
  (modify (set a 0) (set b 0))
  (assert_eq y 1)
  (assert_eq c 1)
  (modify (set a 2) (set b 0))
  (assert_eq y 0)
  (modify (set a 2) (set b 4))
  (assert_eq y 1)
  (modify (set a 0) (set b 4))
  (assert_eq y 0))

(case logical_equivalence_unknown
  (four_state)
  (source "logical_equivalence_unknown.sv" #"
    module Top(input logic [1:0] a, b, output logic y);
      assign y = a <-> b;
    endmodule
  "#)
  (top Top)
  (modify (set a (fourstate 1 1)) (set b 0))
  (assert_eq y (fourstate 1 1))
  (set b 1)
  (assert_eq y (fourstate 1 1))
  (set a (fourstate 3 1))
  (assert_eq y 1))

(case logical_equivalence_evaluates_operands_once
  (source "logical_equivalence_calls.sv" #"
    module Top(output logic [7:0] a_count, b_count, output logic y);
      function automatic logic left(); a_count = a_count + 1; return 0; endfunction
      function automatic logic right(); b_count = b_count + 1; return 1; endfunction
      initial begin
        a_count = 0;
        b_count = 0;
        y = left() <-> right();
      end
    endmodule
  "#)
  (top Top)
  (assert_eq a_count 1)
  (assert_eq b_count 1)
  (assert_eq y 0))

(case two_state_case_equality_preserves_unknown_literals
  ; IEEE 1800-2023 11.4.5 and 12.5: X/Z participate in exact comparisons.
  (source "two_state_case_literals.sv" #"
    module Top(input bit clk, input bit [7:0] b,
      output logic parity_x, reversed_x, exact_z, different_x,
      output logic ordinary_case, output logic [3:0] registered,
      output logic [7:0] guarded);
      assign parity_x = ((^b) === 1'bx);
      assign reversed_x = (1'bx === (^b));
      assign exact_z = (b === 8'b1001_011z);
      assign different_x = (b !== 8'b1001_011x);
      assign guarded = ((^b) === 1'bx) ? 8'b0 : b;
      always_comb begin
        case (b)
          8'b1001_011z: ordinary_case = 1;
          default: ordinary_case = 0;
        endcase
      end
      always_ff @(posedge clk) begin
        registered[0] <= ((^b) === 1'bx);
        registered[1] <= (b === 8'b1001_011x);
        registered[2] <= (b !== 8'b1001_011z);
        case (b)
          8'b1001_011x: registered[3] <= 1;
          default: registered[3] <= 0;
        endcase
      end
    endmodule
  "#)
  (top Top)
  (set b 0x96)
  (assert_eq parity_x 0)
  (assert_eq reversed_x 0)
  (assert_eq exact_z 0)
  (assert_eq different_x 1)
  (assert_eq ordinary_case 0)
  (assert_eq guarded 0x96)
  (tick clk)
  (assert_eq registered 4)
  (set b 0x97)
  (assert_eq parity_x 0)
  (assert_eq different_x 1)
  (assert_eq guarded 0x97)
  (tick clk)
  (assert_eq registered 4)
  (set b 0)
  (assert_eq parity_x 0)
  (assert_eq guarded 0))

(case two_state_case_equality_compares_literal_structure
  (source "two_state_case_structure.sv" #"
    module Top(input bit [7:0] b, input bit [128:0] wide,
      output logic same_x, x_vs_z, mixed_equal, signed_x, signed_z,
      output logic unsigned_x, wide_x, bit_cast);
      function automatic bit to_bit(input logic value); return value; endfunction
      assign same_x = ({b,1'bx} === {b,1'bx});
      assign x_vs_z = ({b,1'bx} === {b,1'bz});
      assign mixed_equal = ({b,1'bx} === {8'h96,1'bx});
      assign signed_x = (4'sbx001 === 8'sbxxxxx001);
      assign signed_z = (4'sbz001 === 8'sbzzzzz001);
      assign unsigned_x = (4'sbx001 === 8'bxxxxx001);
      assign wide_x = (wide === {64'd0,1'bx,64'd0});
      assign bit_cast = (to_bit(1'bx) === 1'b0);
    endmodule
  "#)
  (top Top)
  (modify (set b 0x96) (set wide 0))
  (assert_eq same_x 1)
  (assert_eq x_vs_z 0)
  (assert_eq mixed_equal 1)
  (assert_eq signed_x 1)
  (assert_eq signed_z 1)
  (assert_eq unsigned_x 0)
  (assert_eq wide_x 0)
  (assert_eq bit_cast 1)
  (set b 0x97)
  (assert_eq mixed_equal 0))

(case two_state_case_equality_preserves_conditional_unknowns
  (source "two_state_case_mux.sv" #"
    module Top(input bit s, output logic x_match, z_match, same_known,
      output logic ordinary_case);
      assign x_match = ((s ? 1'bx : 1'b0) === 1'bx);
      assign z_match = ((s ? 1'bz : 1'b0) === 1'bz);
      assign same_known = ((s ? 1'bx : 1'b0) === 1'b0);
      always_comb begin
        case (s ? 1'bz : 1'b0)
          1'bz: ordinary_case = 1;
          default: ordinary_case = 0;
        endcase
      end
    endmodule
  "#)
  (top Top)
  (set s 0)
  (assert_eq x_match 0)
  (assert_eq z_match 0)
  (assert_eq same_known 1)
  (assert_eq ordinary_case 0)
  (set s 1)
  (assert_eq x_match 1)
  (assert_eq z_match 1)
  (assert_eq same_known 0)
  (assert_eq ordinary_case 1))

(case two_state_case_equality_keeps_call_effects_and_loaded_bytes
  (source "two_state_case_effects.sv" #"
    module Top(input bit [7:0] b, output int calls,
      output logic compared, selected, output logic [7:0] loaded);
      function automatic logic [7:0] mark();
        calls = calls + 1;
        return b;
      endfunction
      initial begin
        calls = 0;
        #1;
        compared = (mark() === 8'b1001_011x);
        case (mark())
          8'b1001_011z: selected = 1;
          default: selected = 0;
        endcase
        loaded = ((^b) === 1'bx) ? 8'b0 : b;
        #1 $finish;
      end
    endmodule
  "#)
  (top Top)
  (run_until 0)
  (set b 0x96)
  (run_until 1)
  (assert_eq calls 2)
  (assert_eq compared 0)
  (assert_eq selected 0)
  (assert_eq loaded 0x96)
  (run_to_finish))

(case two_state_case_equality_keeps_unknown_expression_bits
  (source "two_state_case_expression.sv" #"
    module Top(input bit b, output logic [16:0] q);
      assign q[0] = ((b & 1'bx) === 1'bx);
      assign q[1] = ((b | 1'bx) === 1'bx);
      assign q[2] = ((b ^ 1'bz) === 1'bx);
      assign q[3] = ((b && 1'bx) === 1'bx);
      assign q[4] = ((b || 1'bx) === 1'bx);
      assign q[5] = (({b,b} + 2'b0x) === 2'bxx);
      assign q[6] = (({b,b} >> 1'bx) === 2'bxx);
      assign q[7] = ((^{b,1'bx}) === 1'bx);
      assign q[8] = ((&{b,1'bx}) === 1'bx);
      assign q[9] = ((|{b,1'bz}) === 1'bx);
      assign q[10] = ((!{b,1'bz}) === 1'bx);
      assign q[11] = ((~{b,1'bz}) === {~b,1'bx});
      assign q[12] = ((b == 1'bx) === 1'bx);
      assign q[13] = (({b,1'b0} == {1'bx,1'b1}) === 1'b0);
      assign q[14] = ((1'b1 / b) === 1'bx);
      assign q[15] = ((1'bx ? {b,1'bz} : {b,1'bz}) === {b,1'bz});
      assign q[16] = ((1'bx ? b : ~b) === 1'bx);
    endmodule
  "#)
  (top Top)
  (set b 0)
  (assert_eq q 0x1fef6)
  (set b 1)
  (assert_eq q 0x1b9ed))

(case constant_function_case_context
  ; Explicit local assignments avoid an Icarus 13.0 automatic-initializer abort.
  (source "constant_case.sv" #"
    module Top(output logic [3:0] q, output logic [3:0] p);
      function automatic logic mixed();
        logic signed [7:0] x;
        x = 8'hff;
        case (x)
          16'shffff: return 0;
          16'h0000: return 0;
          default: return 1;
        endcase
      endfunction
      function automatic logic arithmetic();
        case (8'hff + 8'h01)
          8'h00: return 0;
          16'h100: return 1;
          default: return 0;
        endcase
      endfunction
      function automatic logic all_signed();
        logic signed [7:0] x;
        x = -1;
        case (x)
          16'shffff: return 1;
          16'sh0000: return 0;
          default: return 0;
        endcase
      endfunction
      function automatic logic fill();
        case ('1)
          8'hff: return 1;
          default: return 0;
        endcase
      endfunction
      localparam logic [3:0] P = {fill(), all_signed(), arithmetic(), mixed()};
      assign p = P;
      assign q = {fill(), all_signed(), arithmetic(), mixed()};
    endmodule
  "#)
  (top Top)
  (assert_eq q 15)
  (assert_eq p 15))

(case constant_function_case_unknowns
  (four_state)
  (source "constant_case_unknown.sv" #"
    module Top(output logic q, output logic p);
      function automatic logic exact_unknown();
        case (1'bx)
          1'bz: return 0;
          1'bx: return 1;
          default: return 0;
        endcase
      endfunction
      localparam logic P = exact_unknown();
      assign p = P;
      assign q = exact_unknown();
    endmodule
  "#)
  (top Top)
  (assert_eq q 1)
  (assert_eq p 1))
