        module Top #(parameter W=3, parameter MASK=3'b100)(
            output logic [7:0] y, output logic signed_test, output logic guard);
            if ((W'(MASK) & {W{1'b1}}) == 0) assign y=8'h11;
            else assign y=8'hab;
            if (W'(-1) < 0) assign signed_test=1'b1;
            else assign signed_test=1'b0;
            if ((0 || 0) && (W'(MASK) & {W{1'b1}}) == 0) assign guard=1'b0;
            else assign guard=1'b1;
