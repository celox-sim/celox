(group types (category types))

(case simulates_systemverilog_parameterized_port_widths
  (source "parameter_width.sv" #"
        module Top #(
            parameter WIDTH = (4 * 2)
        ) (
            input logic [WIDTH - 1:0] a,
            output logic [WIDTH - 1:0] y
        );
            assign y = a + 8'd1;
        endmodule
    "#)
  (top Top)
  (modify (set a 0x7f))
  (assert_eq y 0x80))

(case simulates_systemverilog_bit_ports_as_two_state
  (four_state)
  (source "bit_port.sv" #"
        module Top(
            output bit [3:0] y
        );
            assign y = 4'b10xz;
        endmodule
    "#)
  (top Top)
  (eval)
  (assert_eq y 0b1000)
  (let _value (payload (get y)))
  (let mask (xmask (get y)))
  (assert (== mask 0)))

(case preserves_integer_atom_state_kinds
  (four_state)
  (source "integer_atoms.sv" #"
        module Top(input logic a, output int two_state, output integer four_state);
            assign two_state = a;
            assign four_state = a;
        endmodule
    "#)
  (top Top)
  (modify (set a (fourstate 1 1)))
  (assert_eq two_state (fourstate 0 0))
  (assert (!= (xmask (get four_state)) 0)))

(case packed_arrays_of_signed_named_types_have_signed_elements
  ; IEEE 1800-2023 7.4.1: a packed array is unsigned as a whole, but an
  ; element of a signed named type is signed.
  (source "signed_named_elements.sv" #"
                module Top(input logic [7:0] i,
                           output logic [15:0] y0, y1, y2, y3, y4, y5, y6, y7, y8, y9, y10, y11);
                    typedef logic signed [3:0] sn_t;
                    typedef sn_t [1:0] pair_t;
                    typedef logic signed one_t;
                    typedef struct packed signed { logic [1:0] h, l; } ss_t;
                    typedef struct packed { sn_t [1:0] m; } holder_t;
                    pair_t t;
                    pair_t [1:0] tr;
                    sn_t [1:0] a [2];
                    one_t [3:0] o;
                    ss_t [1:0] sp;
                    holder_t hv;
                    function automatic logic [15:0] pick(input sn_t [1:0] x);
                        sn_t [1:0] loc;
                        loc = x;
                        return loc[1] + x[0];
                    endfunction
                    assign t = i;
                    assign tr = {i, i};
                    assign a[0] = i;
                    assign a[1] = ~i;
                    assign o = i[3:0];
                    assign sp = i;
                    assign hv = i;
                    assign y0 = t[1];
                    assign y1 = tr[1][1];
                    assign y2 = a[0][1];
                    assign y3 = o[3];
                    assign y4 = sp[1];
                    assign y5 = hv.m[1];
                    assign y6 = pick(i);
                    assign y7 = t[1][3:2];
                    assign y8 = tr[1];
                    assign y9 = t[1] * t[0];
                    always_comb begin
                        y10 = t[0];
                        // An unsigned label makes the comparison unsigned.
                        case (t[1]) 16'hfffa: y11 = 16'd1; default: y11 = 16'd0; endcase
                    end
                endmodule
            "#)
  (top Top)
  (for value (list 0xab 0x5a 0x80 0x7f 0)
    (modify (set i value))
    (let high (trunc 16 (sext 4 (slice value 7 4))))
    (let low (trunc 16 (sext 4 (slice value 3 0))))
    (assert_eq y0 high)
    (assert_eq y1 high)
    (assert_eq y2 high)
    (assert_eq y3 (trunc 16 (sext 1 (slice value 3 3))))
    (assert_eq y4 high)
    (assert_eq y5 high)
    (assert_eq y6 (trunc 16 (+ high low)))
    (assert_eq y7 (slice value 7 6))
    (assert_eq y8 value)
    (assert_eq y9 (trunc 16 (* high low)))
    (assert_eq y10 low)
    (assert_eq y11 0)))

(case packed_parameters_of_signed_named_types_have_signed_elements
  ; Elements of a packed parameter keep its dimensions in constant
  ; expressions too (IEEE 1800-2023 7.4.1, 11.5.1).
  (source "signed_named_parameter_elements.sv" #"
                module Top(output logic [15:0] y0, y1, y2, y3, y4, y5);
                    typedef logic signed [3:0] sn_t;
                    localparam sn_t [1:0] L = 8'hab;
                    localparam logic [15:0] C = L[1];
                    localparam logic [15:0] B = L[1][3];
                    localparam logic [7:0] [3:0] W = 32'h12345678;
                    assign y0 = C;
                    if (L[1] < 0) begin : negative
                        assign y1 = 16'd1;
                    end else begin : positive
                        assign y1 = 16'd2;
                    end
                    assign y2 = L[0];
                    assign y3 = B;
                    assign y4 = W[6];
                    assign y5 = W[1][2:0];
                endmodule
            "#)
  (top Top)
  (eval)
  (expand (name expected) ((y0 0xfffa) (y1 1) (y2 0xfffb) (y3 1) (y4 2) (y5 7))
    (assert_eq {name} {expected} "{name}")))

(case passes_unpacked_arrays_of_equivalent_element_types
  ; An unpacked array assignment or port connection needs equivalent
  ; element types and equal element counts, not equal bounds; elements
  ; correspond left to right (IEEE 1800-2023 6.22.2, 7.6, 23.3.3).
  ; `logic [0:7]` and the packed structure are equivalent to `logic [7:0]`.
  (source "equivalent_unpacked_arrays.sv" #"
                module Child(input logic [7:0] x [1:0], output logic [7:0] left, right);
                    assign left = x[1];
                    assign right = x[0];
                endmodule
                module Top(input logic [15:0] d, output logic [7:0] left, right,
                           output logic [7:0] s_left, s_right, c_left);
                    typedef struct packed { logic [3:0] hi; logic [3:0] lo; } pair_t;
                    logic [0:7] v [2:3];
                    pair_t s [2];
                    logic [7:0] c [2];
                    assign v[2] = d[15:8];
                    assign v[3] = d[7:0];
                    assign s[0] = d[7:0];
                    assign s[1] = d[15:8];
                    assign c = v;
                    assign c_left = c[0];
                    Child uv(.x(v), .left(left), .right(right));
                    Child us(.x(s), .left(s_left), .right(s_right));
                endmodule
            "#)
  (top Top)
  (modify (set d 0x12c4))
  (assert_eq left 0x12)
  (assert_eq right 0xc4)
  (assert_eq s_left 0xc4)
  (assert_eq s_right 0x12)
  (assert_eq c_left 0x12))

(case passes_unpacked_arguments_of_equivalent_element_types
  ; Passing an argument is an assignment-like context (IEEE 1800-2023
  ; 10.8): bounds and the packed range direction of the elements do not
  ; matter (6.22.2, 7.6).
  (source "equivalent_unpacked_arguments.sv" #"
                module Top(input logic [15:0] d, output logic [7:0] left, right);
                    function automatic logic [7:0] pick(input logic [7:0] x [1:0], input logic first);
                        return first ? x[1] : x[0];
                    endfunction
                    logic [0:7] v [2:3];
                    always_comb begin
                        v[2] = d[15:8];
                        v[3] = d[7:0];
                        left = pick(v, 1'b1);
                        right = pick(v, 1'b0);
                    end
                endmodule
            "#)
  (top Top)
  (modify (set d 0x12c4))
  (assert_eq left 0x12)
  (assert_eq right 0xc4))

(case rejects_unpacked_argument_of_a_wider_element_type
  ; Passing an argument is an assignment-like context, and an unpacked
  ; array needs an equivalent element type (IEEE 1800-2023 7.6, 10.8).
  (source "wider_unpacked_argument.sv" #"
                module Top(output logic signed [7:0] q);
                    function automatic logic signed [7:0] pick(input logic signed [7:0] x [2]);
                        return x[0];
                    endfunction
                    logic signed [3:0] narrow [2];
                    always_comb begin
                        narrow[0] = 4'sh8;
                        narrow[1] = 4'sh1;
                        q = pick(narrow);
                    end
                endmodule
            "#)
  (top Top)
  (expect reject))

(case rejects_unpacked_assignment_of_a_different_state_count
  ; `bit [7:0]` and `logic [7:0]` are not equivalent (IEEE 1800-2023
  ; 6.22.2, 7.6).
  (source "two_state_unpacked_assignment.sv" #"
                module Top(input logic [7:0] a, output logic [7:0] q);
                    bit [7:0] two [2];
                    logic [7:0] four [2];
                    assign two[0] = a;
                    assign two[1] = a;
                    assign four = two;
                    assign q = four[0];
                endmodule
            "#)
  (top Top)
  (expect reject))

(case rejects_unpacked_assignment_of_a_different_element_count
  ; A fixed-size target needs as many elements as the source (IEEE
  ; 1800-2023 7.6).
  (source "unpacked_assignment_count.sv" #"
                module Top(input logic [7:0] a, output logic [7:0] q);
                    logic [7:0] three [3];
                    logic [7:0] two [2];
                    assign three[0] = a;
                    assign three[1] = a;
                    assign three[2] = a;
                    assign two = three;
                    assign q = two[0];
                endmodule
            "#)
  (top Top)
  (expect reject))

(case rejects_unpacked_port_connection_of_a_narrower_element_type
  ; A port connection is an assignment-like context (IEEE 1800-2023 7.6,
  ; 10.8, 23.3.3).
  (source "narrow_unpacked_port.sv" #"
                module Child(input logic [7:0] x [2], output logic [7:0] y);
                    assign y = x[0];
                endmodule
                module Top(input logic [3:0] a, output logic [7:0] q);
                    logic [3:0] narrow [2];
                    assign narrow[0] = a;
                    assign narrow[1] = a;
                    Child u(.x(narrow), .y(q));
                endmodule
            "#)
  (top Top)
  (expect reject))

(case rejects_assignment_pattern_item_of_a_narrower_array_type
  ; Each nondefault item of an assignment pattern is in an assignment-like
  ; context with its element, here an unpacked array (IEEE 1800-2023 7.6,
  ; 10.8).
  (source "narrow_pattern_item.sv" #"
                module Top(input logic [3:0] a, output logic [7:0] q);
                    logic [3:0] row [2];
                    logic [7:0] grid [2][2];
                    assign row[0] = a;
                    assign row[1] = a;
                    assign grid = '{row, row};
                    assign q = grid[0][0];
                endmodule
            "#)
  (top Top)
  (expect reject))
