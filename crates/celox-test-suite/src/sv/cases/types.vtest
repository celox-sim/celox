(group types (category types))

(case simulates_systemverilog_parameterized_port_widths
  (source "parameter_width.sv" #"
        module Top #(
            parameter WIDTH = (4 * 2)
        ) (
            input logic [WIDTH - 1:0] a,
            output logic [WIDTH - 1:0] y
        );
            assign y = a + 8'd1;
        endmodule
    "#)
  (top Top)
  (modify (set a 0x7f))
  (assert_eq y 0x80))

(case simulates_systemverilog_bit_ports_as_two_state
  (four_state)
  (source "bit_port.sv" #"
        module Top(
            output bit [3:0] y
        );
            assign y = 4'b10xz;
        endmodule
    "#)
  (top Top)
  (eval)
  (assert_eq y 0b1000)
  (let _value (payload (get y)))
  (let mask (xmask (get y)))
  (assert (== mask 0)))

(case preserves_integer_atom_state_kinds
  (four_state)
  (source "integer_atoms.sv" #"
        module Top(input logic a, output int two_state, output integer four_state);
            assign two_state = a;
            assign four_state = a;
        endmodule
    "#)
  (top Top)
  (modify (set a (fourstate 1 1)))
  (assert_eq two_state (fourstate 0 0))
  (assert (!= (xmask (get four_state)) 0)))

(case packed_arrays_of_signed_named_types_have_signed_elements
  ; IEEE 1800-2023 7.4.1: a packed array is unsigned as a whole, but an
  ; element of a signed named type is signed.
  (source "signed_named_elements.sv" #"
                module Top(input logic [7:0] i,
                           output logic [15:0] y0, y1, y2, y3, y4, y5, y6, y7, y8, y9, y10, y11);
                    typedef logic signed [3:0] sn_t;
                    typedef sn_t [1:0] pair_t;
                    typedef logic signed one_t;
                    typedef struct packed signed { logic [1:0] h, l; } ss_t;
                    typedef struct packed { sn_t [1:0] m; } holder_t;
                    pair_t t;
                    pair_t [1:0] tr;
                    sn_t [1:0] a [2];
                    one_t [3:0] o;
                    ss_t [1:0] sp;
                    holder_t hv;
                    function automatic logic [15:0] pick(input sn_t [1:0] x);
                        sn_t [1:0] loc;
                        loc = x;
                        return loc[1] + x[0];
                    endfunction
                    assign t = i;
                    assign tr = {i, i};
                    assign a[0] = i;
                    assign a[1] = ~i;
                    assign o = i[3:0];
                    assign sp = i;
                    assign hv = i;
                    assign y0 = t[1];
                    assign y1 = tr[1][1];
                    assign y2 = a[0][1];
                    assign y3 = o[3];
                    assign y4 = sp[1];
                    assign y5 = hv.m[1];
                    assign y6 = pick(i);
                    assign y7 = t[1][3:2];
                    assign y8 = tr[1];
                    assign y9 = t[1] * t[0];
                    always_comb begin
                        y10 = t[0];
                        // An unsigned label makes the comparison unsigned.
                        case (t[1]) 16'hfffa: y11 = 16'd1; default: y11 = 16'd0; endcase
                    end
                endmodule
            "#)
  (top Top)
  (for value (list 0xab 0x5a 0x80 0x7f 0)
    (modify (set i value))
    (let high (trunc 16 (sext 4 (slice value 7 4))))
    (let low (trunc 16 (sext 4 (slice value 3 0))))
    (assert_eq y0 high)
    (assert_eq y1 high)
    (assert_eq y2 high)
    (assert_eq y3 (trunc 16 (sext 1 (slice value 3 3))))
    (assert_eq y4 high)
    (assert_eq y5 high)
    (assert_eq y6 (trunc 16 (+ high low)))
    (assert_eq y7 (slice value 7 6))
    (assert_eq y8 value)
    (assert_eq y9 (trunc 16 (* high low)))
    (assert_eq y10 low)
    (assert_eq y11 0)))

(case packed_parameters_of_signed_named_types_have_signed_elements
  ; Elements of a packed parameter keep its dimensions in constant
  ; expressions too (IEEE 1800-2023 7.4.1, 11.5.1).
  (source "signed_named_parameter_elements.sv" #"
                module Top(output logic [15:0] y0, y1, y2, y3, y4, y5);
                    typedef logic signed [3:0] sn_t;
                    localparam sn_t [1:0] L = 8'hab;
                    localparam logic [15:0] C = L[1];
                    localparam logic [15:0] B = L[1][3];
                    localparam logic [7:0] [3:0] W = 32'h12345678;
                    assign y0 = C;
                    if (L[1] < 0) begin : negative
                        assign y1 = 16'd1;
                    end else begin : positive
                        assign y1 = 16'd2;
                    end
                    assign y2 = L[0];
                    assign y3 = B;
                    assign y4 = W[6];
                    assign y5 = W[1][2:0];
                endmodule
            "#)
  (top Top)
  (eval)
  (expand (name expected) ((y0 0xfffa) (y1 1) (y2 0xfffb) (y3 1) (y4 2) (y5 7))
    (assert_eq {name} {expected} "{name}")))
