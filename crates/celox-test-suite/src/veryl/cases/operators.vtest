(group operators (category operators))

(case test_ternary_operator
  (source "test.veryl" #"
module Top (sel: input logic, a: input logic<8>, b: input logic<8>, o: output logic<8>) {
assign o = if sel ? a : b ;
}
"#)
  (top Top)
  (modify
    (set a 0xAA)
    (set b 0xBB))
  ; sel = 1 -> o = a
  (modify (set sel 1))
  (assert_eq o 0xAA)
  ; sel = 0 -> o = b
  (modify (set sel 0))
  (assert_eq o 0xBB))

(case test_nested_ternary
  (source "test.veryl" #"
module Top (s1: input logic, s2: input logic, a: input logic<8>, b: input logic<8>, c: input logic<8>, o: output logic<8>) {
assign o = if s1 ? (if s2 ? a : b) : c;
}
"#)
  (top Top)
  (modify
    (set a 0xAA)
    (set b 0xBB))
  ; s1=1, s2=0 -> b (0xBB)
  (modify
    (set s1 1)
    (set s2 0))
  (assert_eq o 0xBB))

(case test_bitwise_operations
  (source "test.veryl" #"
module Top (a: input logic<8>, b: input logic<8>, o_and: output logic<8>, o_or: output logic<8>, o_xor: output logic<8>) {
always_comb {
o_and = a & b;
o_or  = a | b;
o_xor = a ^ b;
}
}
"#)
  (top Top)
  (modify
    (set a 0xA5)
    (set b 0x5A))
  (assert_eq o_and 0x00)
  (assert_eq o_or 0xFF)
  (assert_eq o_xor 0xFF))

(case test_shift_logical_vs_arithmetic
  (source "test.veryl" #"
module Top (a: input logic<8>, o_shr: output logic<8>, o_sar: output logic<8>) {
always_comb {
o_shr = a >> 2;
o_sar = a >>> 2;
}
}
"#)
  (top Top)
  (modify (set a 0x80))
  (assert_eq o_shr 0x20)
  ; `a` is unsigned logic<8>, so arithmetic-right shift should behave like logical shift.
  (assert_eq o_sar 0x20))

(case test_signed_arithmetic_shift_right
  (source "test.veryl" #"
module Top (a: input i8, o_sar: output i8) {
always_comb {
o_sar = a >>> 2;
}
}
"#)
  (top Top)
  (modify (set a 0x80))
  ; -128
  (assert_eq o_sar 0xE0))
  ; -32

(case test_subtraction_underflow
  (source "test.veryl" #"
