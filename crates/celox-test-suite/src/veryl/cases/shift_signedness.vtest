(group shift_signedness (category operators))

(case test_shift_right_arithmetic_native
  (source "test.veryl" #"
module Top (
clk: input  clock,
i:   input  i64,
o_comb: output i64,
o_ff:   output i64
) {
assign o_comb = i >>> 1;
always_ff (clk) {
o_ff = i >>> 1;
}
}
"#)
  (top Top)
  ; Negative value: 64'h8000_0000_0000_0000 (-2^63)
  ; Shifted right: 64'hc000_0000_0000_0000
  (modify (set i 0x8000000000000000))
  (assert_eq o_comb 0xc000000000000000 "Comb arithmetic shift failed")
  (tick clk)
  (assert_eq o_ff 0xc000000000000000 "FF arithmetic shift failed"))

(case test_shift_right_logical_signed_native
  (source "test.veryl" #"
module Top (
clk: input  clock,
i:   input  i64,
o_comb: output i64,
o_ff:   output i64
) {
assign o_comb = i >> 1;
always_ff (clk) {
o_ff = i >> 1;
}
}
"#)
  (top Top)
  ; Negative value: 64'h8000_0000_0000_0000
  ; Logical shift: 64'h4000_0000_0000_0000 (zero-filled)
  (modify (set i 0x8000000000000000))
  (assert_eq o_comb 0x4000000000000000 "Comb logical shift (signed) failed")
  (tick clk)
  (assert_eq o_ff 0x4000000000000000 "FF logical shift (signed) failed"))

(case test_shift_constant_folding_wide
  (source "test.veryl" #"
module Top (
o: output signed logic<128>,
o2: output signed logic<128>,
o3: output logic<128>
) {
assign o = 128'shc000_0000_0000_0000_0000_0000_0000_0000 >>> 1;
assign o2 = 128'hc000_0000_0000_0000_0000_0000_0000_0000 >>> 1;
assign o3 = 128'shc000_0000_0000_0000_0000_0000_0000_0000 >>> 1;
}
"#)
  (top Top)
  (let expected 0xe0000000000000000000000000000000)
  ; 128'she000...
  (assert_eq o expected "Wide arithmetic constant folding failed")
  (let expected2 0x60000000000000000000000000000000)
  ; 128'sha000...
  (assert_eq o2 expected2 "Wide arithmetic constant folding failed")
  (let expected3 0xe0000000000000000000000000000000)
  ; 128'she000...
  (assert_eq o3 expected3 "Wide arithmetic constant folding failed"))

(case test_shift_constant_folding_native
  (source "test.veryl" #"
        module Top (
            o: output signed logic<64>,
            o2: output signed logic<64>,
            o3: output logic<64>
        ) {
            assign o = 64'shc000_0000_0000_0000 >>> 1;
            assign o2 = 64'hc000_0000_0000_0000 >>> 1;
            assign o3 = 64'shc000_0000_0000_0000 >>> 1;
        }
    "#)
  (top Top)
  (let expected 0xe000000000000000)
  (assert_eq o expected "Native arithmetic constant folding failed")
  (let expected2 0x6000000000000000)
  (assert_eq o2 expected2 "Native arithmetic constant folding failed")
  (let expected3 0xe000000000000000)
  (assert_eq o3 expected3 "Native arithmetic constant folding failed"))

(case test_shift_right_arithmetic_wide
  (source "test.veryl" #"
module Top (
clk: input  clock,
i:   input  signed logic<128>,
o_comb: output signed logic<128>,
o_ff:   output signed logic<128>
) {
assign o_comb = i >>> 1;
always_ff (clk) {
o_ff = i >>> 1;
}
}
"#)
  (top Top)
  ; MSB set: 128'h8000...0000
  (modify (set i (<< 1 127)))
  ; Expected: 128'hc000...0000
  (assert_eq o_comb (<< 3 126) "Comb wide arithmetic shift failed")
  (tick clk)
  (assert_eq o_ff (<< 3 126) "FF wide arithmetic shift failed"))

(case test_shift_right_logical_wide
  (source "test.veryl" #"
module Top (
i:   input  signed logic<128>,
o:   output signed logic<128>
) {
assign o = i >> 1;
}
"#)
  (top Top)
  ; MSB set: 128'h8000...0000
  (modify (set i (<< 1 127)))
  ; Expected: 128'h4000...0000
  (assert_eq o (<< 1 126) "Wide logical shift failed"))
