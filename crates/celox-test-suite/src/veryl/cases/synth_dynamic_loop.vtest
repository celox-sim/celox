(case test_runtime_break_after_assign_in_synth_comb_loop
  (source "test.veryl" #"
        module Top (
            count: input logic<32>,
            sum: output logic<32>
        ) {
            always_comb {
                sum = 0;
                for i in 0..count {
                    if i == 2 {
                        sum += 10;
                        break;
                    }
                    sum += 1;
                }
            }
        }
    "#)
  (top Top)
  (set count 8)
  (eval)
  (assert_eq sum 12))

(case test_runtime_if_without_break_in_synth_comb_loop
  (source "test.veryl" #"
        module Top (
            count: input logic<32>,
            sel: input logic,
            o: output logic<32>
        ) {
            always_comb {
                o = 0;
                for i in 0..count {
                    if sel {
                        o += 1;
                    }
                }
            }
        }
    "#)
  (top Top)
  (set count 5)
  (set sel 1)
  (eval)
  (assert_eq o 5))

(case test_runtime_bounds_stalled_step_with_break_exits_cleanly
  (source "test.veryl" #"
        module Top (
            start: input logic<32>,
            count: input logic<32>,
            sel: input logic,
            out: output logic<32>
        ) {
            always_comb {
                out = 0;
                for i in start..count step *= 2 {
                    out += 1;
                    if sel {
                        break;
                    }
                }
            }
        }
    "#)
  (top Top)
  (set start 0)
  (set count 4)
  (set sel 1)
  (eval)
  (assert_eq out 1))

(case test_runtime_bounds_signed_inclusive_range_preserves_negative_bounds
  (source "test.veryl" #"
        module Top (
            start: input signed logic<32>,
            count: input signed logic<32>,
            hits: output logic<32>,
            sum: output logic<32>
        ) {
            always_comb {
                hits = 0;
                sum = 0;
                for i in start..=count {
                    hits += 1;
                    sum += i as 32;
                }
            }
        }
    "#)
  (top Top)
  (set start 0xffffffff)
  (set count 1)
  (eval)
  (assert_eq hits 3)
  (assert_eq sum 0))

(case test_runtime_bounds_truncate_loop_var_to_declared_width
  (source "test.veryl" #"
        module Top (
            count: input logic<32>,
            wrapped_hits: output logic<32>
        ) {
            always_comb {
                wrapped_hits = 0;
                for i in 254..count {
                    if (i as u8) <: 8'd4 {
                        wrapped_hits += 1;
                    }
                }
            }
        }
    "#)
  (top Top)
  (set count 260)
  (eval)
  (assert_eq wrapped_hits 4))

(case test_constant_bounds_preserve_wide_limit_above_loop_width
  (source "test.veryl" #"
        module Top (
            start: input logic<32>,
            wrapped_hits: output logic<32>
        ) {
            always_comb {
                wrapped_hits = 0;
                for i in start..260 {
                    if (i as u8) <: 8'd4 {
                        wrapped_hits += 1;
                    }
                }
            }
        }
    "#)
  (top Top)
  (set start 254)
  (eval)
  (assert_eq wrapped_hits 4))

(case test_runtime_bounds_track_initial_seed_dependency
  (source "test.veryl" #"
        module Top (
            seed: input logic<32>,
            count: input logic<32>,
            out: output logic<32>
        ) {
            var acc: logic<32>;
            always_comb {
                acc = seed;
                for i in 0..count {
                    acc += 1;
                }
                out = acc;
            }
        }
    "#)
  (top Top)
  (set seed 10)
  (set count 3)
  (eval)
  (assert_eq out 13)
  (set seed 20)
  (eval)
  (assert_eq out 23))

(case test_runtime_bounds_preserve_pre_loop_bits_for_partial_updates
  (source "test.veryl" #"
        module Top (
            seed: input logic<2>,
            count: input logic<32>,
            out: output logic<2>
        ) {
            var x: logic<2>;
            always_comb {
                x = seed;
                for i in 0..count {
                    x[0] = x[1];
                }
                out = x;
            }
        }
    "#)
  (top Top)
  (set seed 2)
  (set count 1)
  (eval)
  (assert_eq out 3))

(case test_runtime_bounds_reconstruct_wide_loop_carried_reads_from_partial_state
  (source "test.veryl" #"
        module Top (
            seed: input logic<2>,
            count: input logic<32>,
            out: output logic<2>
        ) {
            var x: logic<2>;
            always_comb {
                x = seed;
                for i in 0..count {
                    x[0] = x == 2'b10;
                }
                out = x;
            }
        }
    "#)
  (top Top)
  (set seed 2)
  (set count 2)
  (eval)
  (assert_eq out 2))

(case test_runtime_bounds_preserve_untouched_high_bits_for_dynamic_index_reads
  (source "test.veryl" #"
        module Top (
            seed: input logic<2>,
            idx: input logic<32>,
            count: input logic<32>,
            out: output logic
        ) {
            var x: logic<2>;
            var y: logic;
            always_comb {
                x = seed;
                y = 0;
                for i in 0..count {
                    x[0] = 0;
                    y = x[idx];
                }
                out = y;
            }
        }
    "#)
  (top Top)
  (set seed 2)
  (set idx 1)
  (set count 1)
  (eval)
  (assert_eq out 1))

(case test_runtime_bounds_reverse_singleton_exits_cleanly
  (source "test.veryl" #"
        module Top (
            start: input logic<32>,
            count: input logic<32>,
            out: output logic<32>
        ) {
            always_comb {
                out = 0;
                for i in rev start..=count {
                    out = i;
                }
            }
        }
    "#)
  (top Top)
  (set start 4)
  (set count 4)
  (eval)
  (assert_eq out 4))

(case test_runtime_bounds_track_initial_seed_dependency_across_module_boundary
  (source "test.veryl" #"
        module Child (
            seed: input logic<32>,
            count: input logic<32>,
            out: output logic<32>
        ) {
            var acc: logic<32>;
            always_comb {
                acc = seed;
                for i in 0..count {
                    acc += 1;
                }
                out = acc;
            }
        }

        module Top (
            seed: input logic<32>,
            count: input logic<32>,
            out: output logic<32>
        ) {
            var child_out: logic<32>;
            inst u_child: Child (
                seed: seed,
                count: count,
                out: child_out
            );
            assign out = child_out;
        }
    "#)
  (top Top)
  (set seed 10)
  (set count 3)
  (eval)
  (assert_eq out 13)
  (set seed 20)
  (eval)
  (assert_eq out 23))

(case test_runtime_break_condition_dependency_across_module_boundary
  (source "test.veryl" #"
        module Child (
            sel: input logic,
            count: input logic<32>,
            out: output logic<32>
        ) {
            var acc: logic<32>;
            always_comb {
                acc = 0;
                for i in 0..count {
                    acc += 1;
                    if sel {
                        break;
                    }
                }
                out = acc;
            }
        }

        module Top (
            sel: input logic,
            count: input logic<32>,
            out: output logic<32>
        ) {
            var child_out: logic<32>;
            inst u_child: Child (
                sel: sel,
                count: count,
                out: child_out
            );
            assign out = child_out;
        }
    "#)
  (top Top)
  (set sel 0)
  (set count 4)
  (eval)
  (assert_eq out 4)
  (set sel 1)
  (eval)
  (assert_eq out 1))

(case test_runtime_bounds_preserve_loop_carried_state_for_indexed_reads
  (source "test.veryl" #"
        module Top (
            count: input logic<32>,
            out: output logic<3>
        ) {
            var x: logic<3>;
            always_comb {
                x = 3'b100;
                for i in 0..count {
                    x[i + 1] = x[i];
                }
                out = x;
            }
        }
    "#)
  (top Top)
  (set count 2)
  (eval)
  (assert_eq out 0))

(case test_static_nested_loop_local_bindings_are_distinct
  (source "test.veryl" #"
module Top (
    inputs: input logic<16>,
    result: output logic<8>,
) {
    var total: logic<8>;
    always_comb {
        total = 0;
        for i in 0..2 {
            let outer: logic<8> = inputs[i * 8+:8];
            for j in 0..2 {
                let lane: logic<8> = outer + (j as 8);
                total += lane;
            }
        }
        result = total;
    }
}
"#)
  (top Top)
  (modify (set inputs 0x0401))
  (assert_eq result 12)
  (modify (set inputs 0x0409))
  (assert_eq result 28)
  (modify (set inputs 0xffff))
  (assert_eq result 254))

(case test_runtime_bounds_forward_overshoot_exits_without_wraparound
  (source "test.veryl" #"
        module Top (
            start: input logic<32>,
            hits: output logic<32>,
            last: output logic<8>
        ) {
            always_comb {
                hits = 0;
                last = 8'hee;
                for i in start..255 step += 10 {
                    hits += 1;
                    last = i;
                }
            }
        }
    "#)
  (top Top)
  (set start 250)
  (eval)
  (assert_eq hits 1)
  (assert_eq last 250))

(case test_runtime_bounds_large_additive_step_exits_without_wraparound
  (source "test.veryl" #"
        module Top (
            start: input logic<32>,
            hits: output logic<32>,
            last: output logic<8>
        ) {
            always_comb {
                hits = 0;
                last = 8'hee;
                for i in start..255 step += 300 {
                    hits += 1;
                    last = i;
                }
            }
        }
    "#)
  (top Top)
  (set start 250)
  (eval)
  (assert_eq hits 1)
  (assert_eq last 250))

(case test_runtime_bounds_inclusive_max_bound_runs_full_range
  (source "test.veryl" #"
        module Top (
            count: input logic<8>,
            hits: output logic<32>
        ) {
            always_comb {
                hits = 0;
                for i in 0..=count {
                    hits += 1;
                }
            }
        }
    "#)
  (top Top)
  (set count 255)
  (eval)
  (assert_eq hits 256))
