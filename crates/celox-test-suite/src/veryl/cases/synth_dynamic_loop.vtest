(group synth_dynamic_loop (category control_flow))

(case test_expression_bounds_in_synth_for_loops
  (source "test.veryl" #"
        module Top #(
            param LIMIT: u32 = 4,
        ) (
            sum_fwd: output logic<32>,
            sum_rev: output logic<32>,
            sum_inc: output logic<32>,
            sum_step: output logic<32>,
        ) {
            always_comb {
                sum_fwd = 0;
                for i in 0..(LIMIT + 1) {
                    sum_fwd += i;
                }

                sum_rev = 0;
                for i in rev 0..LIMIT {
                    sum_rev = sum_rev * 10 + i as 32;
                }

                sum_inc = 0;
                for i in 0..=LIMIT {
                    sum_inc += i;
                }

                sum_step = 0;
                for i in 1..(LIMIT + 4) step *= 2 {
                    sum_step += i;
                }
            }
        }
    "#)
  (top Top)
  (eval)
  (assert_eq sum_fwd 10)
  (assert_eq sum_rev 3210)
  (assert_eq sum_inc 10)
  (assert_eq sum_step 7))

(case test_constant_break_in_synth_comb_loop
  (source "test.veryl" #"
        module Top (
            sum: output logic<32>,
        ) {
            always_comb {
                sum = 0;
                for i in 0..8 {
                    if i == 3 {
                        break;
                    }
                    sum += i;
                }
            }
        }
    "#)
  (top Top)
  (eval)
  (assert_eq sum 3))

(case test_constant_signed_bounds_in_unrolled_synth_loops
  ; Constant signed reverse bounds are currently broken in the upstream
  ; Veryl analyzer unroller, so this regression is parked until upstream
  ; Veryl is fixed.
  (source "test.veryl" #"
        module Top (
            sum_fwd: output logic<32>,
            sum_rev: output logic<32>
        ) {
            always_comb {
                sum_fwd = 0;
                for i in (0 - 1)..=1 {
                    sum_fwd += i as 32;
                }

                sum_rev = 0;
                for i in rev (0 - 1)..=1 {
                    sum_rev = sum_rev * 10 + (i + 1) as 32;
                }
            }
        }
    "#)
  (top Top)
  (eval)
  (assert_eq sum_fwd 0)
  (assert_eq sum_rev 210))

(case test_runtime_bounds_in_synth_for_loops
  (source "test.veryl" #"
        module Top (
            count: input logic<32>,
            step_start: input logic<32>,
            sum_fwd: output logic<32>,
            sum_rev: output logic<32>,
            sum_inc: output logic<32>,
            sum_step: output logic<32>,
        ) {
            always_comb {
                sum_fwd = 0;
                for i in 0..count {
                    sum_fwd += i;
                }

                sum_rev = 0;
                for i in rev 0..count {
                    sum_rev = sum_rev * 10 + i as 32;
                }

                sum_inc = 0;
                for i in 0..=count {
                    sum_inc += i;
                }

                sum_step = 0;
                for i in step_start..(count + 4) step *= 2 {
                    sum_step += i;
                }
            }
        }
    "#)
  (top Top)
  (set count 4)
  (set step_start 1)
  (eval)
  (assert_eq sum_fwd 6)
  (assert_eq sum_rev 3210)
  (assert_eq sum_inc 10)
  (assert_eq sum_step 7)
  (set count 5)
  (eval)
  (assert_eq sum_fwd 10)
  (assert_eq sum_rev 43210)
  (assert_eq sum_inc 15)
  (assert_eq sum_step 15))

(case test_runtime_bitwise_steps_in_synth_for_loops
  (source "test.veryl" #"
        module Top (
            or_end: input logic<32>,
            xor_end: input logic<32>,
            or_last: output logic<32>,
            xor_last: output logic<32>
        ) {
            always_comb {
                or_last = 0;
                for i in 3..=or_end step |= 6 {
                    or_last = i;
                    if i == or_end {
                        break;
                    }
                }

                xor_last = 0;
                for i in 3..=xor_end step ^= 6 {
                    xor_last = i;
                    if i == xor_end {
                        break;
                    }
                }
            }
        }
    "#)
  (top Top)
  (set or_end 7)
  (set xor_end 5)
  (eval)
  (assert_eq or_last 7)
  (assert_eq xor_last 5))

(case test_signed_xor_step_uses_loop_counter_width
  ; The Veryl simulator currently converts the signed dynamic start bound to an
  ; unsigned runtime counter and executes zero iterations.
  (source "test.veryl" #"
        module Top (
            wide_end: input signed logic<128>,
            last: output signed logic<32>
        ) {
            var start: signed logic<32>;
            always_comb {
                start = (0 - 8) as 32;
                last = 0;
                for i in start..=wide_end step ^= 2147483648 {
                    last = i;
                    if i == 2147483640 {
                        break;
                    }
                }
            }
        }
    "#)
  (top Top)
  (modify (set wide_end 2147483640))
  (eval)
  (assert_eq last 0x7ffffff8))

(case test_i32_bitwise_steps_discard_bits_above_the_counter_width
  (source "test.veryl" #"
        module Top (
            start: input signed logic<32>,
            or_end: input signed logic<128>,
            xor_end: input signed logic<128>,
            or_last: output signed logic<32>,
            xor_last: output signed logic<32>
        ) {
            always_comb {
                or_last = 0;
                for i in start..=or_end step |= 4294967302 {
                    or_last = i;
                    if i == 7 {
                        break;
                    }
                }

                xor_last = 0;
                for i in start..=xor_end step ^= 4294967302 {
                    xor_last = i;
                    if i == 5 {
                        break;
                    }
                }
            }
        }
    "#)
  (top Top)
  (modify
    (set start (trunc 32 3))
    (set or_end 7)
    (set xor_end 5))
  (eval)
  (assert_eq or_last 7)
  (assert_eq xor_last 5))

(case test_runtime_reverse_step_matches_emitted_sv_order
  (source "test.veryl" #"
        module Top (
            start: input signed logic<64>,
            end_bound: input signed logic<64>,
            digits: output logic<32>
        ) {
            always_comb {
                digits = 0;
                for i in rev start..end_bound step += 2 {
                    digits = digits * 10 + i as 32;
                }
            }
        }
    "#)
  (top Top)
  (set start 0)
  (set end_bound 10)
  (eval)
  (assert_eq digits 97531))

(case test_runtime_break_in_synth_comb_loop
  (source "test.veryl" #"
        module Top (
            count: input logic<32>,
            sum: output logic<32>
        ) {
            always_comb {
                sum = 0;
                for i in 0..count {
                    if i == 3 {
                        break;
                    }
