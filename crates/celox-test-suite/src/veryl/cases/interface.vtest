(group interface (category hierarchy))

(case test_interface_connection
  (source "test.veryl" #"
    interface Bus {
        var data: logic<8>;
        var valid: logic;
        modport producer {
            ..output
        }
        modport consumer {
            ..input
        }
    }

    module Producer (
        bus: modport Bus::producer
    ) {
        assign bus.data = 8'hAA;
        assign bus.valid = 1'b1;
    }

    module Consumer (
        bus: modport Bus::consumer,
        out_data: output logic<8>
    ) {
        assign out_data = bus.data;
    }

    module Top (
        out: output logic<8>
    ) {
        inst bus: Bus;
        inst p: Producer (
            bus: bus
        );
        inst c: Consumer (
            bus: bus,
            out_data: out
        );
    }
    "#)
  (top Top)
  ; Run simulation
  ; Verify output
  (let out_val (get out))
  ; 0xAA = 170
  (assert (== out_val 170)))

(case test_interface_continuous_assign_logic
  (source "test.veryl" #"
interface Alu {
    var a    : logic<8>;
    var b    : logic<8>;
    var total: logic<9>;
    assign total = {1'b0, a} + {1'b0, b};
    modport driver {
        a: output,
        b: output,
    }
    modport monitor {
        total: input,
    }
}
module Driver (
    bus: modport Alu::driver,
    x  : input logic<8>,
    y  : input logic<8>,
) {
    assign bus.a = x;
    assign bus.b = y;
}
module Monitor (
    bus  : modport Alu::monitor,
    total: output logic<9>,
) {
    assign total = bus.total;
}
module Top (
    x    : input  logic<8>,
    y    : input  logic<8>,
    total: output logic<9>,
) {
    inst alu: Alu;
    inst d  : Driver (bus: alu, x, y);
    inst m  : Monitor (bus: alu, total);
}
"#)
  (top Top)
  ; The interface's own continuous assignment computes the 9-bit sum.
  (modify (set x 200) (set y 100))
  (assert_eq total 300)
  (modify (set x 0x0F) (set y 0x01))
  (assert_eq total 0x10)
  (modify (set x 0xFF) (set y 0xFF))
  (assert_eq total 0x1FE))

(case test_interface_always_comb_packed_array_member
  (source "test.veryl" #"
interface Sel {
    var sel: logic<2>;
    var d  : logic<4, 8>;
    var q  : logic<8>;
    always_comb {
        q = d[sel];
    }
    modport src {
        sel: output,
        d  : output,
    }
    modport dst {
        q: input,
    }
}
module Src (
    bus : modport Sel::src,
    sel : input logic<2>,
    data: input logic<32>,
) {
    assign bus.sel = sel;
    assign bus.d   = data;
}
module Dst (
    bus: modport Sel::dst,
    q  : output logic<8>,
) {
    assign q = bus.q;
}
module Top (
    sel : input  logic<2>,
    data: input  logic<32>,
    q   : output logic<8>,
) {
    inst s : Sel;
    inst u0: Src (bus: s, sel, data);
    inst u1: Dst (bus: s, q);
}
"#)
  (top Top)
  ; Element 0 of the packed array occupies the least-significant byte.
  (modify (set data 0x44332211) (set sel 0))
  (assert_eq q 0x11)
  (modify (set sel 2))
  (assert_eq q 0x33)
  (modify (set sel 3))
  (assert_eq q 0x44)
  (modify (set data 0xA0B0C0D0) (set sel 1))
  (assert_eq q 0xC0))

(case test_interface_always_ff_on_member_clock
  (source "test.veryl" #"
interface CounterIf {
    var clk  : clock;
    var rst  : reset;
    var en   : logic;
    var count: logic<8>;
    always_ff (clk, rst) {
        if_reset {
            count = 0;
        } else if en {
            count += 1;
        }
    }
    modport ctrl {
        clk  : output,
        rst  : output,
        en   : output,
        count: input,
    }
}
module Ctrl (
    bus  : modport CounterIf::ctrl,
    clk  : input  clock,
    rst  : input  reset,
    en   : input  logic,
    count: output logic<8>,
) {
    assign bus.clk = clk;
    assign bus.rst = rst;
    assign bus.en  = en;
    assign count   = bus.count;
}
module Top (
    clk  : input  clock,
    rst  : input  reset,
    en   : input  logic,
    count: output logic<8>,
) {
    inst cif: CounterIf;
    inst c  : Ctrl (bus: cif, clk, rst, en, count);
}
"#)
  (top Top)
  ; The flip-flop lives in the interface and is clocked through its members.
  (modify (set rst 0) (set en 0))
  (tick clk)
  (assert_eq count 0)
  (modify (set rst 1) (set en 1))
  (tick clk 3)
  (assert_eq count 3)
  (modify (set en 0))
  (tick clk 2)
  (assert_eq count 3)
  (modify (set en 1))
  (tick clk 255)
  (assert_eq count 2 "an 8-bit counter wraps: 3 + 255 = 258 mod 256")
  (modify (set rst 0))
  (tick clk)
  (assert_eq count 0))

(case test_modport_clock_reset_drive_module_ff
  (source "test.veryl" #"
interface SyncIf {
    var clk: clock;
    var rst: reset;
    var d  : logic<8>;
    modport sink {
        clk: input,
        rst: input,
        d  : input,
    }
    modport source {
        ..converse(sink)
    }
}
module Source (
    bus: modport SyncIf::source,
    clk: input clock,
    rst: input reset,
    d  : input logic<8>,
) {
    assign bus.clk = clk;
    assign bus.rst = rst;
    assign bus.d   = d;
}
module Sink (
    bus: modport SyncIf::sink,
    q  : output logic<8>,
) {
    var acc: logic<8>;
    always_ff (bus.clk, bus.rst) {
        if_reset {
            acc = 0;
        } else {
            acc += bus.d;
        }
    }
    assign q = acc;
}
module Top (
    clk: input  clock,
    rst: input  reset,
    d  : input  logic<8>,
    q  : output logic<8>,
) {
    inst sif: SyncIf;
    inst src: Source (bus: sif, clk, rst, d);
    inst snk: Sink (bus: sif, q);
}
"#)
  (top Top)
  ; The sink's always_ff uses the clock and reset received through a modport.
  (modify (set rst 0) (set d 5))
  (tick clk)
  (assert_eq q 0)
  (modify (set rst 1))
  (tick clk 3)
  (assert_eq q 15)
  (modify (set d 250))
  (tick clk)
  (assert_eq q 9 "15 + 250 = 265 mod 256"))

(case test_modport_import_function
  (source "test.veryl" #"
interface RegIf {
    var value: logic<8>;
    function get_value () -> logic<8> {
        return value;
    }
    function add_offset (
        k: input logic<8>,
    ) -> logic<8> {
        return value + k;
    }
    modport writer {
        value: output,
    }
    modport reader {
        get_value : import,
        add_offset: import,
    }
}
module Writer (
    bus: modport RegIf::writer,
    v  : input logic<8>,
) {
    assign bus.value = v;
}
module Reader (
    bus: modport RegIf::reader,
    k  : input  logic<8>,
    o1 : output logic<8>,
    o2 : output logic<8>,
) {
    assign o1 = bus.get_value();
    assign o2 = bus.add_offset(k);
}
module Top (
    v : input  logic<8>,
    k : input  logic<8>,
    o1: output logic<8>,
    o2: output logic<8>,
) {
    inst r: RegIf;
    inst w: Writer (bus: r, v);
    inst u: Reader (bus: r, k, o1, o2);
}
"#)
  (top Top)
  ; Imported functions read the interface member they are declared beside.
  (modify (set v 0x10) (set k 5))
  (assert_eq o1 0x10)
  (assert_eq o2 0x15)
  (modify (set v 0xFF) (set k 2))
  (assert_eq o1 0xFF)
  (assert_eq o2 0x01 "0xFF + 2 wraps at 8 bits"))

(case test_modport_import_function_in_always_ff
  (source "test.veryl" #"
interface IncIf {
    var inc: logic<8>;
    function next (
        x: input logic<8>,
    ) -> logic<8> {
        return x + inc;
    }
    modport cfg {
        inc: output,
    }
    modport user {
        next: import,
    }
}
module Cfg (
    bus : modport IncIf::cfg,
    inc: input logic<8>,
) {
    assign bus.inc = inc;
}
module Acc (
    bus: modport IncIf::user,
    clk: input  clock,
    rst: input  reset,
    q  : output logic<8>,
) {
    var acc: logic<8>;
    always_ff (clk, rst) {
        if_reset {
            acc = 0;
        } else {
            acc = bus.next(acc);
        }
    }
    assign q = acc;
}
module Top (
    clk : input  clock,
    rst : input  reset,
    inc: input  logic<8>,
    q   : output logic<8>,
) {
    inst s: IncIf;
    inst c: Cfg (bus: s, inc);
    inst a: Acc (bus: s, clk, rst, q);
}
"#)
  (top Top)
  (modify (set rst 0) (set inc 3))
  (tick clk)
  (assert_eq q 0)
  (modify (set rst 1))
  (tick clk 3)
  (assert_eq q 9)
  (modify (set inc 10))
  (tick clk 2)
  (assert_eq q 29))

(case test_modport_import_function_forwarded_from_instance_array
  (source "test.veryl" #"
interface ScaleIf {
    var base: logic<8>;
    function scaled (
        k: input logic<8>,
    ) -> logic<8> {
        return base * k;
    }
    modport writer {
        base: output,
    }
    modport reader {
        scaled: import,
    }
}
module Leaf (
    bus: modport ScaleIf::reader,
    k  : input  logic<8>,
    o  : output logic<8>,
) {
    assign o = bus.scaled(k);
}
module Mid (
    bus: modport ScaleIf::reader,
    k  : input  logic<8>,
    o  : output logic<8>,
) {
    inst u: Leaf (bus, k, o);
}
module Top (
    b0: input  logic<8>,
    b1: input  logic<8>,
    k : input  logic<8>,
    o0: output logic<8>,
    o1: output logic<8>,
) {
    inst s: ScaleIf [2];
    assign s[0].base = b0;
    assign s[1].base = b1;
    inst m0: Mid (bus: s[0], k, o: o0);
    inst m1: Mid (bus: s[1], k, o: o1);
}
"#)
  (top Top)
  ; Each forwarded modport reads the member of the array element it was bound to.
  (modify (set b0 3) (set b1 7) (set k 2))
  (assert_eq o0 6)
  (assert_eq o1 14)
  (modify (set b1 0x80))
  (assert_eq o0 6)
  (assert_eq o1 0 "0x80 * 2 wraps at 8 bits"))

(case test_modport_converse_same_and_partial_defaults
  (source "test.veryl" #"
interface Pair {
    var a: logic<8>;
    var b: logic<8>;
    modport left {
        a: output,
        ..input
    }
    modport right {
        ..converse(left)
    }
    modport left_relay {
        ..same(left)
    }
}
module Left (
    bus: modport Pair::left,
    x  : input  logic<8>,
    y  : output logic<8>,
) {
    assign bus.a = x;
    assign y     = bus.b;
}
module LeftSame (
    bus: modport Pair::left_relay,
    x  : input  logic<8>,
    y  : output logic<8>,
) {
    assign bus.a = x + 1;
    assign y     = bus.b;
}
module Right (
    bus: modport Pair::right,
) {
    assign bus.b = bus.a ^ 8'hFF;
}
module Top (
    x: input  logic<8>,
    y: output logic<8>,
    z: output logic<8>,
) {
    inst p : Pair;
    inst q : Pair;
    inst l : Left (bus: p, x, y);
    inst r0: Right (bus: p);
    inst s : LeftSame (bus: q, x, y: z);
    inst r1: Right (bus: q);
}
"#)
  (top Top)
  ; left drives a and receives b (`..input`); right is its converse; the
  ; left_relay modport (`..same(left)`) has the same directions as left.
  (modify (set x 0x0F))
  (assert_eq y 0xF0)
  (assert_eq z 0xEF)
  (modify (set x 0xA5))
  (assert_eq y 0x5A)
  (assert_eq z 0x59)
  (modify (set x 0xFF))
  (assert_eq y 0x00)
  (assert_eq z 0xFF "x + 1 wraps to 0 before the inversion"))

(case test_modport_all_input_and_all_output_defaults
  (source "test.veryl" #"
interface Trio {
    var a: logic<8>;
    var b: logic<8>;
    var c: logic<8>;
    modport drive {
        ..output
    }
    modport watch {
        ..input
    }
}
module Drive (
    bus: modport Trio::drive,
    x  : input logic<8>,
) {
    assign bus.a = x;
    assign bus.b = x + 1;
    assign bus.c = x + 2;
}
module Watch (
    bus: modport Trio::watch,
    o  : output logic<24>,
) {
    assign o = {bus.c, bus.b, bus.a};
}
module Top (
    x : input  logic<8>,
    o0: output logic<24>,
    o1: output logic<24>,
) {
    inst t : Trio;
    inst d : Drive (bus: t, x);
    inst w0: Watch (bus: t, o: o0);
    inst w1: Watch (bus: t, o: o1);
}
"#)
  (top Top)
  (modify (set x 0x10))
  (assert_eq o0 0x121110)
  (assert_eq o1 0x121110)
  (modify (set x 0xFE))
  (assert_eq o0 0x00FFFE "x + 2 wraps at 8 bits")
  (assert_eq o1 0x00FFFE))

(case test_interface_connect_operator
  (source "test.veryl" #"
interface Stream {
    var valid: logic;
    var ready: logic;
    var data : logic<8>;
    modport master {
        valid: output,
        ready: input,
        data : output,
    }
    modport slave {
        ..converse(master)
    }
}
module Producer (
    bus  : modport Stream::master,
    valid: input  logic,
    data : input  logic<8>,
    ready: output logic,
) {
    assign bus.valid = valid;
    assign bus.data  = data;
    assign ready     = bus.ready;
}
module ConnectBridge (
    up  : modport Stream::slave,
    down: modport Stream::master,
) {
    connect up <> down;
}
module CombBridge (
    up  : modport Stream::slave,
    down: modport Stream::master,
) {
    always_comb {
        down <> up;
    }
}
module Consumer (
    bus  : modport Stream::slave,
    ready: input  logic,
    valid: output logic,
    data : output logic<8>,
) {
    assign bus.ready = ready;
    assign valid     = bus.valid;
    assign data      = bus.data;
}
module Top (
    i_valid: input  logic,
    i_data : input  logic<8>,
    i_ready: input  logic,
    o_valid: output logic,
    o_data : output logic<8>,
    o_ready: output logic,
) {
    inst s0: Stream;
    inst s1: Stream;
    inst s2: Stream;
    inst p : Producer (bus: s0, valid: i_valid, data: i_data, ready: o_ready);
    inst b0: ConnectBridge (up: s0, down: s1);
    inst b1: CombBridge (up: s1, down: s2);
    inst c : Consumer (bus: s2, ready: i_ready, valid: o_valid, data: o_data);
}
"#)
  (top Top)
  ; `<>` drives each input member from the opposite side's output member:
  ; valid and data flow downstream, ready flows upstream.
  (modify (set i_valid 1) (set i_data 0x5C) (set i_ready 0))
  (assert_eq o_valid 1)
  (assert_eq o_data 0x5C)
  (assert_eq o_ready 0)
  (modify (set i_valid 0) (set i_data 0xE1) (set i_ready 1))
  (assert_eq o_valid 0)
  (assert_eq o_data 0xE1)
  (assert_eq o_ready 1))

(case test_interface_connect_modport_to_constant
  (source "test.veryl" #"
interface Stream {
    var valid: logic;
    var ready: logic;
    var data : logic<8>;
    modport master {
        valid: output,
        ready: input,
        data : output,
    }
    modport slave {
        ..converse(master)
    }
    modport monitor {
        ..input
    }
}
module Probe (
    bus  : modport Stream::monitor,
    ready: output logic,
) {
    assign ready = bus.ready;
}
module Top (
    valid: output logic,
    data : output logic<8>,
    ready: output logic,
) {
    inst s: Stream;
    connect s.master <> 1;
    connect s.slave <> 1;
    inst p: Probe (bus: s, ready);
    assign valid = s.valid;
    assign data  = s.data;
}
"#)
  (top Top)
  ; Connecting a modport to a constant drives every output member of that modport.
  (assert_eq valid 1)
  (assert_eq data 1)
  (assert_eq ready 1))

(case test_interface_instance_array_in_generate
  (source "test.veryl" #"
interface Lane {
    var data: logic<8>;
    modport w {
        data: output,
    }
    modport r {
        data: input,
    }
}
module Writer (
    bus: modport Lane::w,
    v  : input logic<8>,
) {
    assign bus.data = v + 1;
}
module Reader (
    bus: modport Lane::r,
    o  : output logic<8>,
) {
    assign o = bus.data;
}
module Top (
    i: input  logic<4, 8>,
    o: output logic<4, 8>,
) {
    inst lanes: Lane [4];
    for k in 0..4 :g {
        inst w: Writer (bus: lanes[k], v: i[k]);
        inst r: Reader (bus: lanes[k], o: o[k]);
    }
}
"#)
  (top Top)
  (modify (set i 0x40302010))
  (assert_eq o 0x41312111)
  (modify (set i 0xFF00FE01))
  (assert_eq o 0x0001FF02 "each lane adds 1 independently"))

(case test_modport_array_port
  (source "test.veryl" #"
interface Lane {
    var data: logic<8>;
    modport w {
        data: output,
    }
    modport r {
        data: input,
    }
}
module Distributor (
    buses: modport Lane::w [4],
    lanes: input logic<4, 8>,
) {
    for k in 0..4 :g {
        assign buses[k].data = lanes[k];
    }
}
module Summer (
    buses: modport Lane::r [4],
    total: output logic<10>,
    third: output logic<8>,
) {
    assign total = {2'b0, buses[0].data} + {2'b0, buses[1].data} + {2'b0, buses[2].data} + {2'b0, buses[3].data};
    assign third = buses[2].data;
}
module Top (
    i    : input  logic<4, 8>,
    total: output logic<10>,
    third: output logic<8>,
) {
    inst lanes: Lane [4];
    inst d    : Distributor (buses: lanes, lanes: i);
    inst s    : Summer (buses: lanes, total, third);
}
"#)
  (top Top)
  (modify (set i 0x04030201))
  (assert_eq total 10)
  (assert_eq third 3)
  (modify (set i 0xFFFEFDFC))
  (assert_eq total 1014 "252 + 253 + 254 + 255")
  (assert_eq third 0xFE))

(case test_interface_instance_inside_generate_for
  (source "test.veryl" #"
interface Lane {
    var data: logic<8>;
    modport w {
        data: output,
    }
    modport r {
        data: input,
    }
}
module Writer #(
    param OFFSET: u32 = 0,
) (
    bus: modport Lane::w,
    v  : input logic<8>,
) {
    assign bus.data = v + OFFSET;
}
module Reader (
    bus: modport Lane::r,
    o  : output logic<8>,
) {
    assign o = bus.data;
}
module Top (
    i: input  logic<3, 8>,
    o: output logic<3, 8>,
) {
    for k in 0..3 :g {
        inst bus: Lane;
        inst w  : Writer #(OFFSET: k * 16) (bus, v: i[k]);
        inst r  : Reader (bus, o: o[k]);
    }
}
"#)
  (top Top)
  ; Each generate iteration owns a separate interface instance.
  (modify (set i 0x030201))
  (assert_eq o 0x231201)
  (modify (set i 0xF0F0F0))
  (assert_eq o 0x1000F0 "lanes 1 and 2 wrap at 8 bits"))

(case test_interface_instance_inside_generate_if
  (source "test.veryl" #"
interface Lane {
    var data: logic<8>;
    modport w {
        data: output,
    }
    modport r {
        data: input,
    }
}
module Writer (
    bus: modport Lane::w,
    v  : input logic<8>,
) {
    assign bus.data = v;
}
module Reader (
    bus: modport Lane::r,
    o  : output logic<8>,
) {
    assign o = bus.data;
}
module Top (
    x  : input  logic<8>,
    o_a: output logic<8>,
    o_b: output logic<8>,
) {
    const MODE: u32 = 1;
    if MODE == 1 :ga {
        inst bus: Lane;
        inst w  : Writer (bus, v: x);
        inst r  : Reader (bus, o: o_a);
    } else {
        assign o_a = 0;
    }
    if MODE == 2 :gb {
        assign o_b = 0;
    } else {
        inst bus: Lane;
        inst w  : Writer (bus, v: ~x);
        inst r  : Reader (bus, o: o_b);
    }
}
"#)
  (top Top)
  (modify (set x 0x3C))
  (assert_eq o_a 0x3C)
  (assert_eq o_b 0xC3)
  (modify (set x 0x01))
  (assert_eq o_a 0x01)
  (assert_eq o_b 0xFE))

(case test_modport_forwarded_through_hierarchy
  (source "test.veryl" #"
interface Link {
    var req : logic<8>;
    var resp: logic<8>;
    modport client {
        req : output,
        resp: input,
    }
    modport server {
        ..converse(client)
    }
}
module ClientLeaf (
    bus : modport Link::client,
    x   : input  logic<8>,
    resp: output logic<8>,
) {
    assign bus.req = x;
    assign resp    = bus.resp;
}
module ClientMid (
    bus : modport Link::client,
    x   : input  logic<8>,
    resp: output logic<8>,
) {
    inst u: ClientLeaf (bus, x, resp);
}
module ClientOuter (
    bus : modport Link::client,
    x   : input  logic<8>,
    resp: output logic<8>,
) {
    inst u: ClientMid (bus, x, resp);
}
module ServerLeaf (
    bus: modport Link::server,
) {
    assign bus.resp = bus.req + 8'h11;
}
module ServerMid (
    bus: modport Link::server,
) {
    inst u: ServerLeaf (bus);
}
module Top (
    x   : input  logic<8>,
    resp: output logic<8>,
) {
    inst l: Link;
    inst c: ClientOuter (bus: l, x, resp);
    inst s: ServerMid (bus: l);
}
"#)
  (top Top)
  (modify (set x 0x20))
  (assert_eq resp 0x31)
  (modify (set x 0xF0))
  (assert_eq resp 0x01))

(case test_generic_interface_port
  (source "test.veryl" #"
interface Link {
    var req : logic<8>;
    var resp: logic<8>;
    modport client {
        req : output,
        resp: input,
    }
    modport server {
        ..converse(client)
    }
}
module Client (
    bus : modport Link::client,
    x   : input  logic<8>,
    resp: output logic<8>,
) {
    assign bus.req = x;
    assign resp    = bus.resp;
}
module ClientPass (
    bus : interface::client,
    x   : input  logic<8>,
    resp: output logic<8>,
) {
    inst u: Client (bus, x, resp);
}
module Server (
    bus: modport Link::server,
) {
    assign bus.resp = ~bus.req;
}
module ServerPass (
    bus: interface,
) {
    inst u: Server (bus);
}
module Top (
    x   : input  logic<8>,
    resp: output logic<8>,
) {
    inst l: Link;
    inst c: ClientPass (bus: l, x, resp);
    inst s: ServerPass (bus: l);
}
"#)
  (top Top)
  ; Generic `interface` / `interface::modport` ports forward a concrete interface.
  (modify (set x 0x0F))
  (assert_eq resp 0xF0)
  (modify (set x 0x81))
  (assert_eq resp 0x7E))

(case test_interface_struct_and_packed_array_members
  (source "test.veryl" #"
package PktPkg {
    struct Header {
        kind: logic<4> ,
        len : logic<12>,
    }
}
interface PktIf {
    var hdr    : PktPkg::Header;
    var payload: logic<2, 16>;
    modport tx {
        ..output
    }
    modport rx {
        ..input
    }
}
module Tx (
    bus : modport PktIf::tx,
    kind: input logic<4> ,
    len : input logic<12>,
    p0  : input logic<16>,
    p1  : input logic<16>,
) {
    assign bus.hdr.kind   = kind;
    assign bus.hdr.len    = len;
    assign bus.payload[0] = p0;
    assign bus.payload[1] = p1;
}
module Rx (
    bus : modport PktIf::rx,
    kind: output logic<4> ,
    sum : output logic<16>,
    raw : output logic<32>,
) {
    assign kind = bus.hdr.kind;
    assign sum  = bus.payload[0] + bus.payload[1] + {4'b0, bus.hdr.len};
    assign raw  = bus.payload;
}
module Top (
    kind  : input  logic<4> ,
    len   : input  logic<12>,
    p0    : input  logic<16>,
    p1    : input  logic<16>,
    o_kind: output logic<4> ,
    o_sum : output logic<16>,
    o_raw : output logic<32>,
) {
    inst pk: PktIf;
    inst t : Tx (bus: pk, kind, len, p0, p1);
    inst r : Rx (bus: pk, kind: o_kind, sum: o_sum, raw: o_raw);
}
"#)
  (top Top)
  (modify (set kind 0xA) (set len 0x123) (set p0 0x1000) (set p1 0x0200))
  (assert_eq o_kind 0xA)
  (assert_eq o_sum 0x1323)
  (assert_eq o_raw 0x02001000 "payload[0] is the low half")
  (modify (set kind 0x5) (set len 0xFFF) (set p0 0xF000) (set p1 0x1000))
  (assert_eq o_kind 0x5)
  (assert_eq o_sum 0x0FFF "0xF000 + 0x1000 + 0x0FFF wraps at 16 bits")
  (assert_eq o_raw 0x1000F000))

(case test_interface_param_sized_members
  (source "test.veryl" #"
interface Bus #(
    param WIDTH: u32 = 8,
) {
    var data: logic<WIDTH>;
    modport w {
        data: output,
    }
    modport r {
        data: input,
    }
}
module Writer (
    bus: modport Bus::w,
    v  : input logic<16>,
) {
    assign bus.data = v;
}
module Reader (
    bus: modport Bus::r,
    o  : output logic<16>,
) {
    assign o = bus.data;
}
module Top (
    v  : input  logic<16>,
    o12: output logic<16>,
    o8 : output logic<16>,
) {
    inst b12: Bus #(WIDTH: 12);
    inst b8 : Bus;
    inst w12: Writer (bus: b12, v);
    inst w8 : Writer (bus: b8, v);
    inst r12: Reader (bus: b12, o: o12);
    inst r8 : Reader (bus: b8, o: o8);
}
"#)
  (top Top)
  ; The same modules see the member width of each interface instance:
  ; writes truncate to it and reads zero-extend from it.
  (modify (set v 0xABCD))
  (assert_eq o12 0x0BCD)
  (assert_eq o8 0x00CD)
  (modify (set v 0x1FFF))
  (assert_eq o12 0x0FFF)
  (assert_eq o8 0x00FF))

(case test_interface_param_and_const
  (source "test.veryl" #"
interface Cfg #(
    param WIDTH: u32 = 8,
) {
    const MAX: u32 = (1 << WIDTH) - 1;
    var data: logic<WIDTH>;
    var full: logic;
    assign full = data == MAX;
    modport w {
        data: output,
    }
    modport r {
        data: input,
        full: input,
    }
}
module Reader12 (
    bus : modport Cfg::r,
    o   : output logic<12>,
    full: output logic,
) {
    assign o    = bus.data;
    assign full = bus.full;
}
module Top (
    x  : input  logic<12>,
    y  : input  logic<8>,
    o12: output logic<12>,
    f12: output logic,
    o8 : output logic<8>,
    f8 : output logic,
) {
    inst b12: Cfg #(WIDTH: 12);
    inst b8 : Cfg;
    assign b12.data = x;
    assign b8.data  = y;
    inst r: Reader12 (bus: b12, o: o12, full: f12);
    assign o8 = b8.data;
    assign f8 = b8.full;
}
"#)
  (top Top)
  ; Overridden and default parameters size the members and the constant.
  (modify (set x 0xFFF) (set y 0xFF))
  (assert_eq o12 0xFFF)
  (assert_eq f12 1)
  (assert_eq o8 0xFF)
  (assert_eq f8 1)
  (modify (set x 0x0FF) (set y 0x7F))
  (assert_eq o12 0x0FF)
  (assert_eq f12 0 "0xFF is not the 12-bit maximum")
  (assert_eq o8 0x7F)
  (assert_eq f8 0))

(case test_interface_member_access_in_comb_and_ff
  (source "test.veryl" #"
interface Pipe {
    var stage0: logic<8>;
    var stage1: logic<8>;
}
module Top (
    clk: input  clock,
    rst: input  reset,
    a  : input  logic<8>,
    s0 : output logic<8>,
    s1 : output logic<8>,
) {
    inst p: Pipe;
    always_comb {
        p.stage0 = a + 1;
    }
    always_ff (clk, rst) {
        if_reset {
            p.stage1 = 0;
        } else {
            p.stage1 = p.stage0 + p.stage1;
        }
    }
    assign s0 = p.stage0;
    assign s1 = p.stage1;
}
"#)
  (top Top)
  (modify (set rst 0) (set a 4))
  (tick clk)
  (assert_eq s0 5)
  (assert_eq s1 0)
  (modify (set rst 1))
  (tick clk)
  (assert_eq s1 5)
  (tick clk)
  (assert_eq s1 10)
  (modify (set a 9))
  (assert_eq s0 10)
  (assert_eq s1 10 "the flip-flop holds until the next edge")
  (tick clk)
  (assert_eq s1 20))

(case test_interface_valid_ready_handshake
  (source "test.veryl" #"
interface Stream {
    var valid: logic;
    var ready: logic;
    var data : logic<8>;
    modport master {
        valid: output,
        ready: input,
        data : output,
    }
    modport slave {
        ..converse(master)
    }
}
module Producer (
    bus: modport Stream::master,
    clk: input clock,
    rst: input reset,
) {
    var next: logic<8>;
    always_ff (clk, rst) {
        if_reset {
            next = 1;
        } else if bus.valid && bus.ready {
            next += 1;
        }
    }
    assign bus.valid = next <: 5;
    assign bus.data  = next;
}
module Consumer (
    bus  : modport Stream::slave,
    clk  : input  clock,
    rst  : input  reset,
    stall: input  logic,
    sum  : output logic<8>,
    cnt  : output logic<4>,
) {
    assign bus.ready = ~stall;
    always_ff (clk, rst) {
        if_reset {
            sum = 0;
            cnt = 0;
        } else if bus.valid && bus.ready {
            sum += bus.data;
            cnt += 1;
        }
    }
}
module Top (
    clk  : input  clock,
    rst  : input  reset,
    stall: input  logic,
    valid: output logic,
    sum  : output logic<8>,
    cnt  : output logic<4>,
) {
    inst s: Stream;
    inst p: Producer (bus: s, clk, rst);
    inst c: Consumer (bus: s, clk, rst, stall, sum, cnt);
    assign valid = s.valid;
}
"#)
  (top Top)
  ; Four items 1..4 are transferred, one per cycle with valid && ready.
  (modify (set rst 0) (set stall 0))
  (tick clk)
  (assert_eq valid 1)
  (assert_eq sum 0)
  (assert_eq cnt 0)
  (modify (set rst 1))
  (tick clk)
  (assert_eq sum 1)
  (assert_eq cnt 1)
  (modify (set stall 1))
  (tick clk 2)
  (assert_eq sum 1 "no transfer while stalled")
  (assert_eq cnt 1)
  (assert_eq valid 1)
  (modify (set stall 0))
  (tick clk 2)
  (assert_eq sum 6)
  (assert_eq cnt 3)
  (tick clk)
  (assert_eq sum 10)
  (assert_eq cnt 4)
  (assert_eq valid 0 "all four items were sent")
  (tick clk 3)
  (assert_eq sum 10)
  (assert_eq cnt 4))

(case test_interface_four_state_x_propagation
  (four_state)
  (source "test.veryl" #"
interface Lane {
    var data  : logic<8>;
    var unused: logic<4>;
    modport w {
        data: output,
    }
    modport r {
        data  : input,
        unused: input,
    }
}
module Writer (
    bus : modport Lane::w,
    a   : input logic<8>,
    mask: input logic<8>,
) {
    assign bus.data = a & mask;
}
module Reader (
    bus   : modport Lane::r,
    o     : output logic<8>,
    any   : output logic,
    unused: output logic<4>,
) {
    assign o      = bus.data;
    assign any    = |bus.data;
    assign unused = bus.unused;
}
module Top (
    a     : input  logic<8>,
    mask  : input  logic<8>,
    o     : output logic<8>,
    any   : output logic,
    unused: output logic<4>,
) {
    inst l: Lane;
    inst w: Writer (bus: l, a, mask);
    inst r: Reader (bus: l, o, any, unused);
}
"#)
  (top Top)
  ; An undriven interface member stays X.
  (assert_eq unused (fourstate 0xF 0xF))
  ; X & 0 = 0 and X & 1 = X per bit through the interface.
  (modify (set a (fourstate 0xFF 0xFF)) (set mask 0x0F))
  (assert_eq o (fourstate 0x0F 0x0F))
  (assert_eq any (fourstate 1 1))
  (modify (set mask 0x00))
  (assert_eq o 0)
  (assert_eq any 0)
  ; Known 1 bits make the reduction OR known even with X elsewhere.
  (modify (set a (fourstate 0xF1 0xF0)) (set mask 0xFF))
  (assert_eq o (fourstate 0xF1 0xF0))
  (assert_eq any 1))

(case test_proto_interface_generic_module
  (source "test.veryl" #"
proto interface ProtoReg {
    var data: logic<8>;
}
interface RegImpl for ProtoReg {
    var data: logic<8>;
}
module Holder::<IF: ProtoReg> (
    x: input  logic<8>,
    o: output logic<8>,
) {
    inst u: IF;
    assign u.data = x;
    assign o      = u.data + 1;
}
module Top (
    x: input  logic<8>,
    o: output logic<8>,
) {
    inst h: Holder::<RegImpl> (x, o);
}
"#)
  (top Top)
  (modify (set x 0x41))
  (assert_eq o 0x42)
  (modify (set x 0xFF))
  (assert_eq o 0x00))

(case test_mixin_interface
  (source "test.veryl" #"
interface BaseIf {
    var a: logic<8>;
    modport mp_a {
        a: input,
    }
}
interface ExtIf {
    mixin BaseIf;
    var b: logic<8>;
    modport mp_ab {
        b: input,
        ..same(mp_a)
    }
}
module Reader (
    bus: modport ExtIf::mp_ab,
    o  : output logic<8>,
) {
    assign o = bus.a - bus.b;
}
module Top (
    x: input  logic<8>,
    y: input  logic<8>,
    o: output logic<8>,
) {
    inst e: ExtIf;
    assign e.a = x;
    assign e.b = y;
    inst r: Reader (bus: e, o);
}
"#)
  (top Top)
  ; Members and modports from the mixed-in interface are part of ExtIf.
  (modify (set x 50) (set y 8))
  (assert_eq o 42)
  (modify (set x 3) (set y 5))
  (assert_eq o 0xFE))
