    assign y65 = a65 >>> n;
    assign c65_1 = a65 >>> 32'd1;
    assign c65_64 = a65 >>> 32'd64;
    assign c65_65 = a65 >>> 32'd65;
    assign c65_4294967295 = a65 >>> 32'd4294967295;
    assign y95 = a95 >>> n;
    assign c95_1 = a95 >>> 32'd1;
    assign c95_64 = a95 >>> 32'd64;
    assign c95_95 = a95 >>> 32'd95;
    assign c95_4294967295 = a95 >>> 32'd4294967295;
    assign y127 = a127 >>> n;
    assign c127_1 = a127 >>> 32'd1;
    assign c127_64 = a127 >>> 32'd64;
    assign c127_127 = a127 >>> 32'd127;
    assign c127_4294967295 = a127 >>> 32'd4294967295;
    assign y128 = a128 >>> n;
    assign c128_1 = a128 >>> 32'd1;
    assign c128_64 = a128 >>> 32'd64;
    assign c128_128 = a128 >>> 32'd128;
    assign c128_4294967295 = a128 >>> 32'd4294967295;
    assign y129 = a129 >>> n;
    assign c129_1 = a129 >>> 32'd1;
    assign c129_64 = a129 >>> 32'd64;
