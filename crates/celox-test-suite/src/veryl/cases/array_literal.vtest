(group array_literal (category arrays))

(case test_array_literal_comb_assignment
  (source "test.veryl" #"
module Top (o0: output logic<8>, o1: output logic<8>) {
var a: logic<8> [2];
always_comb {
a = '{8'h12, 8'h34};
}
assign o0 = a[0];
assign o1 = a[1];
}
"#)
  (top Top)
  ; Trigger combinational evaluation once.
  (eval)
  (assert_eq o0 0x12)
  (assert_eq o1 0x34))

(case test_array_literal_default_comb_assignment
  (source "test.veryl" #"
module Top (
o0: output logic<8>,
o1: output logic<8>,
o2: output logic<8>,
o3: output logic<8>
) {
var a: logic<8> [4];
always_comb {
a = '{8'h12, default: 8'hAA};
}
assign o0 = a[0];
assign o1 = a[1];
assign o2 = a[2];
assign o3 = a[3];
}
"#)
  (top Top)
  (eval)
  (assert_eq o0 0x12)
  (assert_eq o1 0xAA)
  (assert_eq o2 0xAA)
  (assert_eq o3 0xAA))

(case test_array_literal_nested_default_multidim_assignment
  (source "test.veryl" #"
module Top (
o00: output logic<8>,
o01: output logic<8>,
o10: output logic<8>,
o11: output logic<8>
) {
var a: logic<8> [2, 2];
always_comb {
a = '{
'{8'h11, default: 8'h22},
default: '{default: 8'hAA}
};
}
assign o00 = a[0][0];
assign o01 = a[0][1];
assign o10 = a[1][0];
assign o11 = a[1][1];
}
"#)
  (top Top)
  (eval)
  (assert_eq o00 0x11)
  (assert_eq o01 0x22)
  (assert_eq o10 0xAA)
  (assert_eq o11 0xAA))

(case test_array_literal_default_fills_param_sized_array
  ; The SV frontend does not yet lower array assignment patterns in always_ff.
  (source "test.veryl" #"
module Top #(param N: u32 = 3) (
i_clk: input clock,
i_rst: input reset,
o0: output logic<8>,
o1: output logic<8>,
o2: output logic<8>,
) {
var arr: logic<8> [N];
assign o0 = arr[0];
assign o1 = arr[1];
assign o2 = arr[2];
always_ff (i_clk, i_rst) {
if_reset {
arr = '{default: 0};
} else {
arr[0] = 8'hAB;
}
}
}
"#)
  (top Top)
  ; Reset: all elements should be 0
  (modify (set i_rst 0))
  (tick i_clk)
  (assert_eq o0 0)
  (assert_eq o1 0)
  (assert_eq o2 0)
  (modify (set i_rst 1))
  (tick i_clk)
  (assert_eq o0 0xAB)
  (modify (set i_rst 0))
  (tick i_clk)
  (assert_eq o0 0)
  (assert_eq o1 0)
  (assert_eq o2 0))

(case test_array_literal_single_element_size_one_array
  (source "test.veryl" #"
module Top (
i_clk: input clock,
i_rst: input reset,
o0: output logic<8>,
) {
var arr: logic<8> [1];
assign o0 = arr[0];
always_ff (i_clk, i_rst) {
if_reset {
arr = '{0};
} else {
arr[0] = 8'hAB;
}
}
}
"#)
  (top Top)
  (modify (set i_rst 0))
  (tick i_clk)
  (assert_eq o0 0)
  (modify (set i_rst 1))
  (tick i_clk)
  (assert_eq o0 0xAB))

(case test_array_literal_default_fills_2d_array
  ; The SV frontend does not yet lower array assignment patterns in always_ff.
  (source "test.veryl" #"
module Top #(param N: u32 = 2, param M: u32 = 3) (
i_clk: input clock,
i_rst: input reset,
o: output logic<8>,
) {
var arr: logic<8> [N, M];
assign o = arr[1][2];
always_ff (i_clk, i_rst) {
if_reset {
arr = '{default: '{default: 0}};
} else {
arr[1][2] = 8'hAB;
}
}
}
"#)
  (top Top)
  (modify (set i_rst 0))
  (tick i_clk)
  (assert_eq o 0)
  (modify (set i_rst 1))
  (tick i_clk)
  (assert_eq o 0xAB)
  (modify (set i_rst 0))
  (tick i_clk)
  (assert_eq o 0))

(case test_array_literal_default_only
  (source "test.veryl" #"
module Top (
o0: output logic<8>,
o1: output logic<8>,
o2: output logic<8>,
o3: output logic<8>,
) {
var a: logic<8> [4];
always_comb {
a = '{default: 8'hBB};
}
assign o0 = a[0];
assign o1 = a[1];
assign o2 = a[2];
assign o3 = a[3];
}
"#)
  (top Top)
  (eval)
  (assert_eq o0 0xBB)
  (assert_eq o1 0xBB)
  (assert_eq o2 0xBB)
  (assert_eq o3 0xBB))

(case test_array_literal_two_explicit_plus_default
  (source "test.veryl" #"
module Top (
o0: output logic<8>,
o1: output logic<8>,
o2: output logic<8>,
o3: output logic<8>,
) {
var a: logic<8> [4];
always_comb {
a = '{8'h11, 8'h22, default: 8'hFF};
}
assign o0 = a[0];
assign o1 = a[1];
assign o2 = a[2];
assign o3 = a[3];
}
"#)
  (top Top)
  (eval)
  (assert_eq o0 0x11)
  (assert_eq o1 0x22)
  (assert_eq o2 0xFF)
  (assert_eq o3 0xFF))

(case test_array_literal_repeat_plus_default
  (source "test.veryl" #"
module Top (
o0: output logic<8>,
o1: output logic<8>,
o2: output logic<8>,
o3: output logic<8>,
) {
var a: logic<8> [4];
always_comb {
a = '{8'hCC repeat 2, default: 8'hDD};
}
assign o0 = a[0];
assign o1 = a[1];
assign o2 = a[2];
assign o3 = a[3];
}
"#)
  (top Top)
  (eval)
  (assert_eq o0 0xCC)
  (assert_eq o1 0xCC)
  (assert_eq o2 0xDD)
  (assert_eq o3 0xDD))

(case test_array_literal_default_in_ff_reset
  (source "test.veryl" #"
module Top (
clk: input clock,
rst: input reset,
o0: output logic<8>,
o1: output logic<8>,
o2: output logic<8>,
) {
var arr: logic<8> [3];
assign o0 = arr[0];
assign o1 = arr[1];
assign o2 = arr[2];
always_ff (clk, rst) {
if_reset {
arr = '{default: 0};
} else {
arr[0] += 1;
arr[1] += 2;
arr[2] += 3;
}
}
}
"#)
  (top Top)
  ; Reset
  (modify (set rst 0))
  (tick clk)
  (assert_eq o0 0 "arr[0] should be 0 after reset")
  (assert_eq o1 0 "arr[1] should be 0 after reset")
  (assert_eq o2 0 "arr[2] should be 0 after reset")
  ; One tick
  (modify (set rst 1))
  (tick clk)
  (assert_eq o0 1)
  (assert_eq o1 2)
  (assert_eq o2 3))
