(group struct_constructor (category types))

(case test_struct_constructor_comb_assignment
  (source "test.veryl" #"
module Top (
a: input logic<4>,
b: input logic<4>,
o: output logic<8>
) {
struct S {
x: logic<4>,
y: logic<4>,
}
always_comb {
o = S'{x: a, y: b};
}
}
"#)
  (top Top)
  (modify
    (set a 0xA)
    (set b 0x5))
  (assert_eq o 0xA5))

(case test_struct_constructor_member_width_adjustment
  ; Veryl 0.22.0's reference simulator debug-asserts when a struct member
  ; expression is wider than the member (veryl-lang/veryl#3215 fixed the
  ; narrower case).
  (source "test.veryl" #"
module Top (
narrow: input logic<4>,
wide  : input logic<8>,
o_pad : output logic<8>,
o_cut : output logic<4>
) {
struct Padded {
x: logic<8>,
}
struct Cut {
y: logic<4>,
}
always_comb {
o_pad = Padded'{x: narrow};
o_cut = Cut'{y: wide};
}
}
"#)
  (top Top)
  (modify
    (set narrow 0xB)
    (set wide 0xAB))
  ; narrow(4bit) -> member logic<8> should be zero-extended.
  (assert_eq o_pad 0x0B)
  ; wide(8bit) -> member logic<4> should keep lower 4 bits.
  (assert_eq o_cut 0xB))

(case test_single_bit_aggregate_members
  (source "test.veryl" #"
module Top (
    i: input logic,
    rst: input reset_sync_low,
    members: output logic<3>,
    reset_member: output logic,
) {
    struct Single { value: logic, }
    struct Nested { inner: Single, }
    struct Reset { value: reset_sync_low, }
    union Overlay { value: logic, other: logic, }
    var single: Single;
    var nested: Nested;
    var reset_pair: Reset;
    var overlay: Overlay;
    assign single.value = i;
    assign nested.inner.value = i;
    assign reset_pair.value = rst;
    assign overlay.value = i;
    assign members = {single.value, nested.inner.value, overlay.other};
    assign reset_member = reset_pair.value;
}
"#)
  (top Top)
  (modify (set i 0) (set rst 1))
  (assert_eq members 0)
  (assert_eq reset_member 1)
  (modify (set i 1) (set rst 0))
  (assert_eq members 7)
  (assert_eq reset_member 0))

(case test_single_bit_struct_ff
  (source "test.veryl" #"
module Top (
    clk: input clock,
    rst: input reset,
    i: input logic,
    o: output logic,
) {
    struct Single { value: logic, }
    var registered: Single;
    always_ff (clk, rst) {
        if_reset { registered.value = 1'b0; }
        else { registered.value = i; }
    }
    assign o = registered.value;
}
"#)
  (top Top)
  (modify (set rst 0) (set i 1))
  (tick clk)
  (assert_eq o 0)
  (modify (set rst 1))
  (tick clk)
  (assert_eq o 1)
  (modify (set i 0))
  (tick clk)
  (assert_eq o 0))
