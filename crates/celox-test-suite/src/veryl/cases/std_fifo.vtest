(group std_fifo (category standard_library))

(case test_fifo_initial_empty
  (source "test.veryl"
    (std "ram/ram.veryl")
    (std "fifo/fifo_controller.veryl")
    (std "fifo/fifo.veryl")
    #"
module Top (
    clk        : input  clock,
    rst        : input  reset,
    i_clear    : input  logic,
    i_push     : input  logic,
    i_data     : input  logic<8>,
    i_pop      : input  logic,
    o_data     : output logic<8>,
    o_empty    : output logic,
    o_almost_full: output logic,
    o_full     : output logic,
    o_word_count: output logic<3>,
) {
    inst u_fifo: fifo #(
        WIDTH: 8,
        DEPTH: 4,
    ) (
        i_clk: clk,
        i_rst: rst,
        i_clear,
        o_empty,
        o_almost_full,
        o_full,
        o_word_count,
        i_push,
        i_data,
        i_pop,
        o_data,
    );
}
"#)
  (top Top)
  ; Reset, then one more tick to settle flags.
  (modify
    (set rst 0)
    (set i_clear 0)
    (set i_push 0)
    (set i_pop 0))
  (tick clk)
  (modify (set rst 1))
  (tick clk)
  (assert_eq (trunc 8 (get o_empty)) 1 "should be empty after reset")
  (assert_eq (trunc 8 (get o_full)) 0 "should not be full after reset")
  (assert_eq (trunc 8 (get o_word_count)) 0 "word_count should be 0"))

(case test_fifo_push_pop_single
  (source "test.veryl"
    (std "ram/ram.veryl")
    (std "fifo/fifo_controller.veryl")
    (std "fifo/fifo.veryl")
    #"
module Top (
    clk        : input  clock,
    rst        : input  reset,
    i_clear    : input  logic,
    i_push     : input  logic,
    i_data     : input  logic<8>,
    i_pop      : input  logic,
    o_data     : output logic<8>,
    o_empty    : output logic,
    o_almost_full: output logic,
    o_full     : output logic,
    o_word_count: output logic<3>,
) {
    inst u_fifo: fifo #(
        WIDTH: 8,
        DEPTH: 4,
    ) (
        i_clk: clk,
        i_rst: rst,
        i_clear,
        o_empty,
        o_almost_full,
        o_full,
        o_word_count,
        i_push,
        i_data,
        i_pop,
        o_data,
    );
}
"#)
  (top Top)
  ; Reset, then one more tick to settle flags.
  (modify
    (set rst 0)
    (set i_clear 0)
    (set i_push 0)
    (set i_pop 0))
  (tick clk)
  (modify (set rst 1))
  (tick clk)
  ; Push 0xAA
  (modify
    (set i_push 1)
    (set i_data 0xAA))
  (tick clk)
  (modify (set i_push 0))
  (tick clk)
  (assert_eq (trunc 8 (get o_empty)) 0 "should not be empty after push")
  (assert_eq (trunc 8 (get o_word_count)) 1 "word_count should be 1")
  ; DATA_FF_OUT=true: data should already be on output register
  (assert_eq (trunc 8 (get o_data)) 0xAA "output should be 0xAA")
  ; Pop
  (modify (set i_pop 1))
  (tick clk)
  (modify (set i_pop 0))
  (tick clk)
  (assert_eq (trunc 8 (get o_empty)) 1 "should be empty after pop")
  (assert_eq (trunc 8 (get o_word_count)) 0 "word_count should be 0"))

(case test_fifo_full
  (source "test.veryl"
    (std "ram/ram.veryl")
    (std "fifo/fifo_controller.veryl")
    (std "fifo/fifo.veryl")
    #"
module Top (
    clk        : input  clock,
    rst        : input  reset,
    i_clear    : input  logic,
    i_push     : input  logic,
    i_data     : input  logic<8>,
    i_pop      : input  logic,
    o_data     : output logic<8>,
    o_empty    : output logic,
    o_almost_full: output logic,
    o_full     : output logic,
    o_word_count: output logic<3>,
) {
    inst u_fifo: fifo #(
        WIDTH: 8,
        DEPTH: 4,
    ) (
        i_clk: clk,
        i_rst: rst,
        i_clear,
        o_empty,
        o_almost_full,
        o_full,
        o_word_count,
        i_push,
        i_data,
        i_pop,
        o_data,
    );
}
"#)
  (top Top)
  ; Reset, then one more tick to settle flags.
  (modify
    (set rst 0)
    (set i_clear 0)
    (set i_push 0)
    (set i_pop 0))
  (tick clk)
  (modify (set rst 1))
  (tick clk)
  ; Push 4 items
  (for i (range 0 4)
    (modify
      (set i_push 1)
      (set i_data (+ i 1)))
    (tick clk))
  (modify (set i_push 0))
  (tick clk)
  (assert_eq (trunc 8 (get o_full)) 1 "should be full after 4 pushes")
  (assert_eq (trunc 8 (get o_word_count)) 4))

(case test_fifo_ordering
  (source "test.veryl"
    (std "ram/ram.veryl")
    (std "fifo/fifo_controller.veryl")
    (std "fifo/fifo.veryl")
    #"
module Top (
    clk        : input  clock,
    rst        : input  reset,
    i_clear    : input  logic,
    i_push     : input  logic,
    i_data     : input  logic<8>,
    i_pop      : input  logic,
    o_data     : output logic<8>,
    o_empty    : output logic,
    o_almost_full: output logic,
    o_full     : output logic,
    o_word_count: output logic<3>,
) {
    inst u_fifo: fifo #(
        WIDTH: 8,
        DEPTH: 4,
    ) (
        i_clk: clk,
        i_rst: rst,
        i_clear,
        o_empty,
        o_almost_full,
        o_full,
        o_word_count,
        i_push,
        i_data,
        i_pop,
        o_data,
    );
}
"#)
  (top Top)
  ; Reset, then one more tick to settle flags.
  (modify
    (set rst 0)
    (set i_clear 0)
    (set i_push 0)
    (set i_pop 0))
  (tick clk)
  (modify (set rst 1))
  (tick clk)
  ; Push 4 items: 0x10, 0x20, 0x30, 0x40
  (for val (list 0x10 0x20 0x30 0x40)
    (modify
      (set i_push 1)
      (set i_data val))
    (tick clk))
  (modify (set i_push 0))
  ; Pop and verify FIFO order
  ; First item (0x10) should already be on output (DATA_FF_OUT)
  (assert_eq (trunc 8 (get o_data)) 0x10 "first out should be 0x10")
  (modify (set i_pop 1))
  (tick clk)
  (assert_eq (trunc 8 (get o_data)) 0x20 "second out should be 0x20")
  (tick clk)
  (assert_eq (trunc 8 (get o_data)) 0x30 "third out should be 0x30")
  (tick clk)
  (assert_eq (trunc 8 (get o_data)) 0x40 "fourth out should be 0x40"))

(case test_fifo_clear
  (source "test.veryl"
    (std "ram/ram.veryl")
    (std "fifo/fifo_controller.veryl")
    (std "fifo/fifo.veryl")
    #"
module Top (
    clk        : input  clock,
    rst        : input  reset,
    i_clear    : input  logic,
    i_push     : input  logic,
    i_data     : input  logic<8>,
    i_pop      : input  logic,
    o_data     : output logic<8>,
    o_empty    : output logic,
    o_almost_full: output logic,
    o_full     : output logic,
    o_word_count: output logic<3>,
) {
    inst u_fifo: fifo #(
        WIDTH: 8,
        DEPTH: 4,
    ) (
        i_clk: clk,
        i_rst: rst,
        i_clear,
        o_empty,
        o_almost_full,
        o_full,
        o_word_count,
        i_push,
        i_data,
        i_pop,
        o_data,
    );
}
"#)
  (top Top)
  ; Reset, then one more tick to settle flags.
  (modify
    (set rst 0)
    (set i_clear 0)
    (set i_push 0)
    (set i_pop 0))
  (tick clk)
  (modify (set rst 1))
  (tick clk)
  ; Push 2 items
  (for val (list 0x11 0x22)
    (modify
      (set i_push 1)
      (set i_data val))
    (tick clk))
  (modify (set i_push 0))
  (tick clk)
  (assert_eq (trunc 8 (get o_word_count)) 2)
  ; Clear
  (modify (set i_clear 1))
  (tick clk)
  (modify (set i_clear 0))
  (tick clk)
  (assert_eq (trunc 8 (get o_empty)) 1 "should be empty after clear")
  (assert_eq (trunc 8 (get o_word_count)) 0))
