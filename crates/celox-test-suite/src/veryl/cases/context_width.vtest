(group context_width (category types))

(case test_context_determined_width_subtraction
  (source "test.veryl" #"
        module Top (
            o1: output logic<1>,
            o2: output logic<1>
        ) {
            always_comb {
                o1 = (2'd0 - 2'd1) == 3'd7;
                o2 = (2'd0 - 2'd1) == 2'd3;
            }
        }
    "#)
  (top Top)
  (assert_eq o1 1 "(2'd0 - 2'd1) == 3'd7 should be true")
  (assert_eq o2 1 "(2'd0 - 2'd1) == 2'd3 should be true"))

(case test_unsized_constant_width_subtraction
  (source "test.veryl" #"
        module Top (
            o: output logic<1>
        ) {
            always_comb {
                o = 2'd0 - 2'd1 == 3;
            }
        }
    "#)
  (top Top)
  (assert_eq o 0 "2'd0 - 2'd1 == 3 should be false because unsized value is extended to 32 bits"))

(case test_runtime_variable_width3_subtraction
  (source "test.veryl" #"
        module Top (
            i: input logic<2>,
            o: output logic<3>,
            c: output logic<1>
        ) {
            always_comb {
                o = i - 2'd1;
                c = (i - 2'd1) == 3'd7;
            }
        }
    "#)
  (top Top)
  ; Case 1: i = 0 -> o = (0 - 1) & 0x7 = 7
  (modify (set i 0))
  (assert_eq o 7 "0 - 1 with 3-bit output should be 7")
  (assert_eq c 1 "(0 - 1) == 3'd7 should be true")
  ; Case 2: i = 1 -> o = (1 - 1) & 0x7 = 0
  (modify (set i 1))
  (assert_eq o 0 "1 - 1 with 3-bit output should be 0")
  (assert_eq c 0 "(1 - 1) == 3'd7 should be true"))

(case test_runtime_variable_width2_subtraction
  (source "test.veryl" #"
        module Top (
            i: input logic<2>,
            o: output logic<2>
        ) {
            always_comb {
                o = i - 2'd1;
            }
        }
    "#)
  (top Top)
  ; Case 1: i = 0 -> o = (0 - 1) & 0x7 = 7
  (modify (set i 0))
  (assert_eq o 3 "0 - 1 with 2-bit output should be 3")
  ; Case 2: i = 1 -> o = (1 - 1) & 0x7 = 0
  (modify (set i 1))
  (assert_eq o 0 "1 - 1 with 2-bit output should be 0"))

(case test_comparison_different_widths
  (source "test.veryl" #"
        module Top (
            o: output logic<1>
        ) {
            always_comb {
                o = 2'd3 == 3'd3;
            }
        }
    "#)
  (top Top)
  (assert_eq o 1 "2'd3 == 3'd3 should be true"))

(case test_addition_different_widths
  (source "test.veryl" #"
        module Top (
            o: output logic<4>
        ) {
            always_comb {
                o = 2'd2 + 3'd5;
            }
        }
    "#)
  (top Top)
  (assert_eq o 7 "2'd2 + 3'd5 should be 7"))

(case test_ff_width_propagation
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            rst: input reset,
            i: input logic<2>,
            o: output logic<3>,
        ) {
            always_ff {
                if_reset {
                    o = 3'd0;
                } else {
                    o = i + 2'd2;
                }
            }
        }
    "#)
  (top Top)
  (modify (set rst 0))
  ; AsyncLow: active-low reset
  (tick clk)
  (assert_eq o 0 "Reset should set o to 0")
  (modify (set rst 1))
  ; Deactivate reset
  (modify (set i 2))
  (tick clk)
  (assert_eq o 4 "i=2, o=2+2=4"))

(case test_zero_extend
  (source "test.veryl" #"
        module Top (
            o: output logic<4>
        ) {
            always_comb {
                o = 2'd1;
            }
        }
    "#)
  (top Top)
  (assert_eq o 1 "2'd1 zero-extended to 4 bits"))

(case test_nested_width_propagation
  (source "test.veryl" #"
        module Top (
            o: output logic<5>
        ) {
            always_comb {
                o = (2'd1 + 3'd2) * 2'd2;
            }
        }
    "#)
  (top Top)
  (assert_eq o 6 "(1+2)*2 = 6, width propagation"))

(case test_runtime_shift_width_behavior
  (source "test.veryl" #"
        module Top (
            i: input  logic<4>,
            s: input  logic<2>,
            o1: output logic<8>,
        ) {
            always_comb {
                // context width assumed to be 8 because o1 is logic<8>.
                o1 = i << s;
            }
        }
    "#)
  (top Top)
  (modify
    (set i 12)
    (set s 1))
  (assert_eq o1 24 "Upper bit should be preserved because context width is 8")
  (modify
    (set i 8)
    (set s 2))
  (assert_eq o1 32))

(case test_runtime_arithmetic_shift_behavior
  (source "test.veryl" #"
        module Top (
            i_u: input  logic<4>,
            i_s: input  signed logic<4>,
            s:   input  logic<2>,
            o_l: output logic<4>,
            o_a: output logic<4>
        ) {
            always_comb {
                // Logical right shift (zero-filling)
                o_l = i_u >> s;
                // Arithmetic right shift (sign-filling)
                o_a = i_s >>> s;
            }
        }
    "#)
  (top Top)
  ; Input: 4'b1000 (unsigned 8, signed -8), Shift: 2
  (modify
    (set i_u 8)
    (set i_s 8)
    ; 8u8 as bit pattern 1000
    (set s 2))
  ; Logical: 4'b1000 >> 2 = 4'b0010 (2)
  (assert_eq o_l 2)
  ; Arithmetic: 4'sb1000 >>> 2 = 4'sb1110 (14 or -2)
  (assert_eq o_a 14))
