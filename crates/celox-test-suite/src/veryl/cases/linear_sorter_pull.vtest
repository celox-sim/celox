(group linear_sorter_pull (category regression))

(case test_sorter_push_pop_empty
  (source "test.veryl" #"
proto package SorterItemProto {
    type Item;
}

package SorterItemPlain::<W: u32> for SorterItemProto {
    type Item = logic<W>;
}

module SorterCellPull::<PKG: SorterItemProto> (
    clk     : input  clock    ,
    rst     : input  reset    ,
    push    : input  logic    ,
    pop     : input  logic    ,
    d_in    : input  PKG::Item,
    prev_val: input  PKG::Item,
    next_val: input  PKG::Item,
    lt_prev : input  logic    ,
    lt_next : input  logic    ,
    pp_lt   : input  logic    ,
    o_reg   : output PKG::Item,
    lt      : output logic    ,
) {
    var r_val: PKG::Item;

    assign lt    = d_in <: r_val;
    assign o_reg = r_val;

    always_ff {
        if_reset {
            r_val = -1;
        } else if push && !pop {
            if lt && !lt_prev {
                r_val = d_in;
            } else if lt {
                r_val = prev_val;
            }
        } else if pop && !push {
            r_val = next_val;
        } else if push && pop {
            if lt_next && !pp_lt {
                r_val = d_in;
            } else if !lt_next {
                r_val = next_val;
            }
        }
    }
}

module LinearSorterPull::<PKG: SorterItemProto> #(
    param DEPTH: u32 = 8,
) (
    clk  : input  clock    ,
    rst  : input  reset    ,
    push : input  logic    ,
    pop  : input  logic    ,
    d_in : input  PKG::Item,
    d_out: output PKG::Item,
    empty: output logic    ,
) {
    var cell_lt  : logic         [DEPTH + 2];
    var cell_reg : PKG::Item     [DEPTH + 2];
    var pp_lt_sig: logic         [DEPTH]    ;
    var count    : logic    <32>            ;

    assign cell_lt[0]          = 0;
    assign cell_reg[0]         = 0;
    assign cell_lt[DEPTH + 1]  = 1;
    assign cell_reg[DEPTH + 1] = -1;

    assign pp_lt_sig[0] = 0;
    for i in 1..DEPTH :g_pp {
        assign pp_lt_sig[i] = cell_lt[i + 1];
    }

    for i in 0..DEPTH :g_cel {
        inst s: SorterCellPull::<PKG> (
            clk                      ,
            rst                      ,
            push                     ,
            pop                      ,
            d_in                     ,
            prev_val: cell_reg[i]    ,
            next_val: cell_reg[i + 2],
            lt_prev : cell_lt[i]     ,
            lt_next : cell_lt[i + 2] ,
            pp_lt   : pp_lt_sig[i]   ,
            o_reg   : cell_reg[i + 1],
            lt      : cell_lt[i + 1] ,
        );
    }

    assign d_out = cell_reg[1];

    always_ff {
        if_reset {
            count = 0;
        } else if push && !pop {
            count = count + 1;
        } else if pop && !push {
            if count != 0 {
                count = count - 1;
            }
        }
    }

    assign empty = count == 0;
}

pub module Top #(
    param DEPTH: u32 = 4,
) (
    clk  : input  clock    ,
    rst  : input  reset    ,
    push : input  logic    ,
    pop  : input  logic    ,
    d_in : input  logic<16>,
    d_out: output logic<16>,
    empty: output logic    ,
) {
    inst s: LinearSorterPull::<SorterItemPlain::<16>> #(
        DEPTH: DEPTH,
    ) (
        clk  ,
        rst  ,
        push ,
        pop  ,
        d_in ,
        d_out,
        empty,
    );
}
"#)
  (top Top)
  ; Reset (AsyncLow: active when rst=0)
  (modify
    (set rst 0)
    (set push 0)
    (set pop 0)
    (set d_in 0))
  (tick clk)
  (assert_eq empty 1 "Should be empty after reset")
  ; Deactivate reset
  (modify (set rst 1))
  (tick clk)
  (assert_eq empty 1 "Still empty, no push")
  ; Push value 100
  (modify
    (set push 1)
    (set d_in 100))
  (tick clk)
  (modify (set push 0))
  (tick clk)
  ; settle
  (assert_eq empty 0 "Not empty after push")
  (assert_eq d_out 100 "d_out should be 100 (minimum)")
  ; Push value 50 (smaller, becomes new min)
  (modify
    (set push 1)
    (set d_in 50))
  (tick clk)
  (modify (set push 0))
  (tick clk)
  ; settle
  (assert_eq d_out 50 "d_out should be 50 (new minimum)")
  ; Pop (removes minimum = 50)
  (modify (set pop 1))
  (tick clk)
  (modify (set pop 0))
  (tick clk)
  ; settle
  (assert_eq d_out 100 "d_out should be 100 after popping 50")
  (assert_eq empty 0 "Not empty, still has 100")
  ; Pop again (removes 100, now empty)
  (modify (set pop 1))
  (tick clk)
  (modify (set pop 0))
  (tick clk)
  ; settle
  (assert_eq empty 1 "Should be empty after popping all elements"))

(case test_sorter_empty_flag_single_push_pop
  (source "test.veryl" #"
proto package SorterItemProto {
    type Item;
}

package SorterItemPlain::<W: u32> for SorterItemProto {
    type Item = logic<W>;
}

module SorterCellPull::<PKG: SorterItemProto> (
    clk     : input  clock    ,
    rst     : input  reset    ,
    push    : input  logic    ,
    pop     : input  logic    ,
    d_in    : input  PKG::Item,
    prev_val: input  PKG::Item,
    next_val: input  PKG::Item,
    lt_prev : input  logic    ,
    lt_next : input  logic    ,
    pp_lt   : input  logic    ,
    o_reg   : output PKG::Item,
    lt      : output logic    ,
) {
    var r_val: PKG::Item;

    assign lt    = d_in <: r_val;
    assign o_reg = r_val;

    always_ff {
        if_reset {
            r_val = -1;
        } else if push && !pop {
            if lt && !lt_prev {
                r_val = d_in;
            } else if lt {
                r_val = prev_val;
            }
        } else if pop && !push {
            r_val = next_val;
        } else if push && pop {
            if lt_next && !pp_lt {
                r_val = d_in;
            } else if !lt_next {
                r_val = next_val;
            }
        }
    }
}

module LinearSorterPull::<PKG: SorterItemProto> #(
    param DEPTH: u32 = 8,
) (
    clk  : input  clock    ,
    rst  : input  reset    ,
    push : input  logic    ,
    pop  : input  logic    ,
    d_in : input  PKG::Item,
    d_out: output PKG::Item,
    empty: output logic    ,
) {
    var cell_lt  : logic         [DEPTH + 2];
    var cell_reg : PKG::Item     [DEPTH + 2];
    var pp_lt_sig: logic         [DEPTH]    ;
    var count    : logic    <32>            ;

    assign cell_lt[0]          = 0;
    assign cell_reg[0]         = 0;
    assign cell_lt[DEPTH + 1]  = 1;
    assign cell_reg[DEPTH + 1] = -1;

    assign pp_lt_sig[0] = 0;
    for i in 1..DEPTH :g_pp {
        assign pp_lt_sig[i] = cell_lt[i + 1];
    }

    for i in 0..DEPTH :g_cel {
        inst s: SorterCellPull::<PKG> (
            clk                      ,
            rst                      ,
            push                     ,
            pop                      ,
            d_in                     ,
            prev_val: cell_reg[i]    ,
            next_val: cell_reg[i + 2],
            lt_prev : cell_lt[i]     ,
            lt_next : cell_lt[i + 2] ,
            pp_lt   : pp_lt_sig[i]   ,
            o_reg   : cell_reg[i + 1],
            lt      : cell_lt[i + 1] ,
        );
    }

    assign d_out = cell_reg[1];

    always_ff {
        if_reset {
            count = 0;
        } else if push && !pop {
            count = count + 1;
        } else if pop && !push {
            if count != 0 {
                count = count - 1;
            }
        }
    }

    assign empty = count == 0;
}

pub module Top #(
    param DEPTH: u32 = 4,
) (
    clk  : input  clock    ,
    rst  : input  reset    ,
    push : input  logic    ,
    pop  : input  logic    ,
    d_in : input  logic<16>,
    d_out: output logic<16>,
    empty: output logic    ,
) {
    inst s: LinearSorterPull::<SorterItemPlain::<16>> #(
        DEPTH: DEPTH,
    ) (
        clk  ,
        rst  ,
        push ,
        pop  ,
        d_in ,
        d_out,
        empty,
    );
}
"#)
  (top Top)
  ; Reset
  (modify
    (set rst 0)
    (set push 0)
    (set pop 0)
    (set d_in 0))
  (tick clk)
  (assert_eq empty 1 "empty=1 after reset")
  ; Deactivate reset
  (modify (set rst 1))
  ; Push one value
  (modify
    (set push 1)
    (set d_in 42))
  (tick clk)
  ; count: 0 → 1, empty should become 0
  (assert_eq empty 0 "empty should be 0 after pushing (count=1)")
  ; Deassert push
  (modify (set push 0))
  (tick clk)
  (assert_eq empty 0 "still not empty")
  ; Pop
  (modify (set pop 1))
  (tick clk)
  ; count: 1 → 0, empty should become 1
  (assert_eq empty 1 "empty should be 1 after popping last element (count=0)")
  ; Deassert pop
  (modify (set pop 0))
  (tick clk)
  (assert_eq empty 1 "still empty"))

(case test_sorter_simultaneous_push_pop
  (source "test.veryl" #"
proto package SorterItemProto {
    type Item;
}

package SorterItemPlain::<W: u32> for SorterItemProto {
    type Item = logic<W>;
}

module SorterCellPull::<PKG: SorterItemProto> (
    clk     : input  clock    ,
    rst     : input  reset    ,
    push    : input  logic    ,
    pop     : input  logic    ,
    d_in    : input  PKG::Item,
    prev_val: input  PKG::Item,
    next_val: input  PKG::Item,
    lt_prev : input  logic    ,
    lt_next : input  logic    ,
    pp_lt   : input  logic    ,
    o_reg   : output PKG::Item,
    lt      : output logic    ,
) {
    var r_val: PKG::Item;

    assign lt    = d_in <: r_val;
    assign o_reg = r_val;

    always_ff {
        if_reset {
            r_val = -1;
        } else if push && !pop {
            if lt && !lt_prev {
                r_val = d_in;
            } else if lt {
                r_val = prev_val;
            }
        } else if pop && !push {
            r_val = next_val;
        } else if push && pop {
            if lt_next && !pp_lt {
                r_val = d_in;
            } else if !lt_next {
                r_val = next_val;
            }
        }
    }
}

module LinearSorterPull::<PKG: SorterItemProto> #(
    param DEPTH: u32 = 8,
) (
    clk  : input  clock    ,
    rst  : input  reset    ,
    push : input  logic    ,
    pop  : input  logic    ,
    d_in : input  PKG::Item,
    d_out: output PKG::Item,
    empty: output logic    ,
) {
    var cell_lt  : logic         [DEPTH + 2];
    var cell_reg : PKG::Item     [DEPTH + 2];
    var pp_lt_sig: logic         [DEPTH]    ;
    var count    : logic    <32>            ;

    assign cell_lt[0]          = 0;
    assign cell_reg[0]         = 0;
    assign cell_lt[DEPTH + 1]  = 1;
    assign cell_reg[DEPTH + 1] = -1;

    assign pp_lt_sig[0] = 0;
    for i in 1..DEPTH :g_pp {
        assign pp_lt_sig[i] = cell_lt[i + 1];
    }

    for i in 0..DEPTH :g_cel {
        inst s: SorterCellPull::<PKG> (
            clk                      ,
            rst                      ,
            push                     ,
            pop                      ,
            d_in                     ,
            prev_val: cell_reg[i]    ,
            next_val: cell_reg[i + 2],
            lt_prev : cell_lt[i]     ,
            lt_next : cell_lt[i + 2] ,
            pp_lt   : pp_lt_sig[i]   ,
            o_reg   : cell_reg[i + 1],
            lt      : cell_lt[i + 1] ,
        );
    }

    assign d_out = cell_reg[1];

    always_ff {
        if_reset {
            count = 0;
        } else if push && !pop {
            count = count + 1;
        } else if pop && !push {
            if count != 0 {
                count = count - 1;
            }
        }
    }

    assign empty = count == 0;
}

pub module Top #(
    param DEPTH: u32 = 4,
) (
    clk  : input  clock    ,
    rst  : input  reset    ,
    push : input  logic    ,
    pop  : input  logic    ,
    d_in : input  logic<16>,
    d_out: output logic<16>,
    empty: output logic    ,
) {
    inst s: LinearSorterPull::<SorterItemPlain::<16>> #(
        DEPTH: DEPTH,
    ) (
        clk  ,
        rst  ,
        push ,
        pop  ,
        d_in ,
        d_out,
        empty,
    );
}
"#)
  (top Top)
  ; Reset
  (modify
    (set rst 0)
    (set push 0)
    (set pop 0))
  (tick clk)
  ; Deactivate reset, push first element
  (modify
    (set rst 1)
    (set push 1)
    (set d_in 200))
  (tick clk)
  (modify (set push 0))
  (tick clk)
  (assert_eq empty 0)
  ; Push second element
  (modify
    (set push 1)
    (set d_in 300))
  (tick clk)
  (modify (set push 0))
  (tick clk)
  (assert_eq d_out 200 "min should be 200")
  ; Simultaneous push+pop: pop 200, push 150
  (modify
    (set push 1)
    (set pop 1)
    (set d_in 150))
  (tick clk)
  (modify
    (set push 0)
    (set pop 0))
  (tick clk)
  ; count should still be 2 (push+pop doesn't change count)
  (assert_eq empty 0 "count unchanged by push+pop")
  (assert_eq d_out 150 "min should be 150 after replacing 200 with 150"))
