%start Document
%title "hwverify language"
%line_comment "//"
%block_comment "/\*" "\*/"
%%
Document: DocKind String "\{"^ { Entry } "\}"^;
DocKind: "design|specification";
Entry: Block | Declaration | Assignment | Property;
Block: Id "\{"^ { Entry } "\}"^;
Declaration: Id ":"^ Type ";"^;
Assignment: Id "="^ Expr ";"^;
Property: Id Expr ";"^;
Type: "bool" | "bv" Lt^ UInt Gt^ | "mem" Lt^ UInt ","^ UInt Gt^;
Expr: Or;
Or: And { OrOp And };
OrOp: "\|\|";
And: BitOr { AndOp BitOr };
AndOp: "&&";
BitOr: BitXor { BitOrOp BitXor };
BitOrOp: "\|";
BitXor: BitAnd { BitXorOp BitAnd };
BitXorOp: "\^";
BitAnd: Compare { BitAndOp Compare };
BitAndOp: "&";
Compare: Shift { CompareOp Shift };
CompareOp: Equal | Unequal | Le | Ge | Lt | Gt;
Equal: "==";
Unequal: "!=";
Le: "<=";
Ge: ">=";
Lt: "<";
Gt: ">";
Shift: Sum { ShiftOp Sum };
ShiftOp: "<<|>>";
Sum: Product { SumOp Product };
SumOp: Plus | Minus;
Plus: "\+";
Minus: "-";
Product: Unary { ProductOp Unary };
ProductOp: "\*";
Unary: PrefixOp Unary | Postfix;
PrefixOp: Bang | Tilde | Minus;
Bang: "!";
Tilde: "~";
Postfix: Primary { "\["^ Expr "\]"^ };
Primary: Word | UInt | Boolean | IfExpr | Named | "\("^ Expr "\)"^;
Boolean: "true|false";
IfExpr: "if"^ Expr "\{"^ Expr "\}"^ "else"^ "\{"^ Expr "\}"^;
Named: Id [ "\("^ [ Args ] "\)"^ ];
Args: Expr { ","^ Expr };
Word: "[0-9]+u[0-9]+";
UInt: "[0-9]+";
String: /"([^"\\]|\\.)*"/;
Id: Ident | "bv" | "mem" | "bool" | DocKind;
Ident: "[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)*";
