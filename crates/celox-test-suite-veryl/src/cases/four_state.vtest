(case test_four_state_wide_ne_with_x
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<128>,
            b: input logic<128>,
            y_ne: output logic
        ) {
            assign y_ne = a != b;
        }
    "#)
  (top Top)
  ; Both defined: different values → NE=1
  (let val_a (| (<< 0xAA 64) 0x55))
  (let val_b (| (<< 0xBB 64) 0x55))
  (modify
    (set a (fourstate val_a 0))
    (set b (fourstate val_b 0)))
  (let v (payload (get y_ne)))
  (let m (xmask (get y_ne)))
  (assert (== v 1) "Different wide values → NE=1")
  (assert (== m 0))
  ; Same values → NE=0
  (modify (set b (fourstate val_a 0)))
  (let v (payload (get y_ne)))
  (let m (xmask (get y_ne)))
  (assert (== v 0) "Same wide values → NE=0")
  (assert (== m 0))
  ; One has X → result X
  (let mask_a (<< 0xFF 64))
  (modify (set a (fourstate val_a mask_a)))
  (let m (xmask (get y_ne)))
  (assert (== m 1) "Wide NE with X should yield X result"))

(case test_four_state_wide_gt_with_x
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<128>,
            b: input logic<128>,
            y_gt: output logic
        ) {
            assign y_gt = a >: b;
        }
    "#)
  (top Top)
  ; Both defined: a > b → 1
  (let val_a (| (<< 0xFF 64) 0))
  (let val_b 0xFF)
  (modify
    (set a (fourstate val_a 0))
    (set b (fourstate val_b 0)))
  (let v (payload (get y_gt)))
  (let m (xmask (get y_gt)))
  (assert (== v 1) "Wide a > b should be true")
  (assert (== m 0))
  ; One has X → result X
  (let mask_a (<< 1 64))
  (modify (set a (fourstate val_a mask_a)))
  (let m (xmask (get y_gt)))
  (assert (== m 1) "Wide GT with X should yield X result"))

(case test_four_state_wide_ge_le_with_x
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<128>,
            b: input logic<128>,
            y_ge: output logic,
            y_le: output logic
        ) {
            assign y_ge = a >= b;
            assign y_le = a <= b;
        }
    "#)
  (top Top)
  ; Both defined and equal: GE=1, LE=1
  (let val (| (<< 0xAA 64) 0x55))
  (modify
    (set a (fourstate val 0))
    (set b (fourstate val 0)))
  (let v_ge (payload (get y_ge)))
  (let m_ge (xmask (get y_ge)))
  (let v_le (payload (get y_le)))
  (let m_le (xmask (get y_le)))
  (assert (== v_ge 1) "Wide equal values → GE=1")
  (assert (== m_ge 0))
  (assert (== v_le 1) "Wide equal values → LE=1")
  (assert (== m_le 0))
  ; One has X → both results X
  (let mask_a (<< 0xFF 64))
  (modify (set a (fourstate val mask_a)))
  (let m_ge (xmask (get y_ge)))
  (let m_le (xmask (get y_le)))
  (assert (== m_ge 1) "Wide GE with X should yield X")
  (assert (== m_le 1) "Wide LE with X should yield X"))

(case test_four_state_wide_signed_comparison_with_x
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input signed logic<128>,
            b: input signed logic<128>,
            y_lt_s: output logic,
            y_gt_s: output logic,
            y_le_s: output logic,
            y_ge_s: output logic
        ) {
            assign y_lt_s = a <: b;
            assign y_gt_s = a >: b;
            assign y_le_s = a <= b;
            assign y_ge_s = a >= b;
        }
    "#)
  (top Top)
  ; Both defined: a = -1 (all bits set in 128-bit), b = 1 → signed: -1 < 1
  (let all_ones_128 (| (<< 0xffffffffffffffff 64) 0xffffffffffffffff))
  (modify
    (set a (fourstate all_ones_128 0))
    ; -1 in signed 128-bit
    (set b (fourstate 1 0)))
  (let v_lt (payload (get y_lt_s)))
  (let m_lt (xmask (get y_lt_s)))
  (let v_gt (payload (get y_gt_s)))
  (let m_gt (xmask (get y_gt_s)))
  (assert (== v_lt 1) "Wide signed: -1 < 1 should be true")
  (assert (== m_lt 0))
  (assert (== v_gt 0) "Wide signed: -1 > 1 should be false")
  (assert (== m_gt 0))
  ; One has X → all comparisons yield X
  (let mask_a (<< 1 64))
  (modify (set a (fourstate 0 mask_a)))
  (let m_lt (xmask (get y_lt_s)))
  (let m_gt (xmask (get y_gt_s)))
  (let m_le (xmask (get y_le_s)))
  (let m_ge (xmask (get y_ge_s)))
  (assert (== m_lt 1) "Wide signed LT with X should yield X")
  (assert (== m_gt 1) "Wide signed GT with X should yield X")
  (assert (== m_le 1) "Wide signed LE with X should yield X")
  (assert (== m_ge 1) "Wide signed GE with X should yield X"))

(case test_four_state_wide_logical_not_with_x
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<128>,
            y_lnot: output logic
        ) {
            assign y_lnot = !(|a);
        }
    "#)
  (top Top)
  ; Defined nonzero: !nonzero = 0
  (let val (<< 1 64))
  (modify (set a (fourstate val 0)))
  (let v (payload (get y_lnot)))
  (let m (xmask (get y_lnot)))
  (assert (== v 0) "Wide !nonzero = 0")
  (assert (== m 0))
  ; Defined zero: !0 = 1
  (modify (set a (fourstate 0 0)))
  (let v (payload (get y_lnot)))
  (let m (xmask (get y_lnot)))
  (assert (== v 1) "Wide !0 = 1")
  (assert (== m 0))
  ; X input (upper word only) → result X
  (let mask_a (<< 1 64))
  (modify (set a (fourstate 0 mask_a)))
  (let m (xmask (get y_lnot)))
  (assert (== m 1) "Wide logical NOT with X should yield X"))

(case test_four_state_concat_chunk_boundary_x
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<48>,
            b: input logic<32>,
            c: input logic<48>,
            y: output logic<128>
        ) {
            assign y = {a, b, c};
        }
    "#)
  (top Top)
  ; a = defined 48-bit value, b = all X (32-bit), c = defined 48-bit value
  (modify
    (set a (fourstate 0x123456789ABC 0))
    (set b (fourstate 0 0xFFFFFFFF))
    ; all X
    (set c (fourstate 0xABCDEF012345 0)))
  (let v (payload (get y)))
  (let m (xmask (get y)))
  ; b occupies bits [79:48], crossing the 64-bit chunk boundary
  ; Expected mask: bits [79:48] = 1, rest = 0
  (let expected_mask (<< 0xFFFFFFFF 48))
  (assert (== m expected_mask) "X in b should span bits [79:48] crossing chunk boundary")
  ; c at bits [47:0] should be preserved
  (let lower_48_mask (- (<< 1 48) 1))
  (let v_c (& v lower_48_mask))
  (assert (== v_c 0xABCDEF012345) "Lower 48 bits from c should be intact")
  ; a at bits [127:80] should be preserved (after normalization, b's value bits are 0)
  (let v_a (>> v 80))
  (assert (== v_a 0x123456789ABC) "Upper 48 bits from a should be intact"))

(case test_four_state_ff_sync_reset_with_x
  (four_state)
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            rst: input reset,
            sync_rst: input logic,
            d: input logic<8>,
            q: output logic<8>
        ) {
            always_ff {
                if_reset {
                    q = 8'd0;
                } else {
                    if sync_rst {
                        q = 8'd0;
                    } else {
                        q = d;
                    }
                }
            }
        }
    "#)
  (top Top)
  ; 1. Async reset to clear state (AsyncLow: rst=0 means active)
  (modify
    (set rst (fourstate 0 0))
    (set sync_rst (fourstate 0 0))
    (set d (fourstate 0 0))
    (set q (fourstate 0 0)))
  (tick clk)
  (let v_q (payload (get q)))
  (let m_q (xmask (get q)))
  (assert (== v_q 0))
  (assert (== m_q 0) "Async reset should clear X")
  ; 2. Load data with X into q (deactivate reset: rst=1)
  (modify
    (set rst (fourstate 1 0))
    (set sync_rst (fourstate 0 0))
    (set d (fourstate 0xAB 0x0F)))
    ; lower nibble X
  (tick clk)
  (let m_q (xmask (get q)))
  (assert (== m_q 0x0F) "q should capture X from d")
  ; 3. Sync reset should clear q (and X) to 0
  (modify (set sync_rst (fourstate 1 0)))
  (tick clk)
  (let v_q (payload (get q)))
  (let m_q (xmask (get q)))
  (assert (== v_q 0) "Sync reset should set q to 0")
  (assert (== m_q 0) "Sync reset should clear X in q")
  ; 4. Load X again, then verify sync reset clears it again
  (modify
    (set sync_rst (fourstate 0 0))
    (set d (fourstate 0 0xFF)))
    ; all X
  (tick clk)
  (let m_q (xmask (get q)))
  (assert (== m_q 0xFF) "q should capture all-X from d")
  (modify (set sync_rst (fourstate 1 0)))
  (tick clk)
  (let v_q (payload (get q)))
  (let m_q (xmask (get q)))
  (assert (== v_q 0) "Second sync reset should set q to 0")
  (assert (== m_q 0) "Second sync reset should clear all X"))

(case test_four_state_explicit_cast_with_x
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input signed logic<8>,
            y_to_unsigned: output logic<8>
        ) {
            assign y_to_unsigned = a;
        }
    "#)
  (top Top)
  ; a = 0x80 (-128 signed), no X: unsigned view should be 0x80
  (modify (set a (fourstate 0x80 0)))
  (let v (payload (get y_to_unsigned)))
  (let m (xmask (get y_to_unsigned)))
  (assert (== v 0x80) "Signed→unsigned: value preserved")
  (assert (== m 0) "Signed→unsigned: no X")
  ; a = 0x7F (+127 signed), no X
  (modify (set a (fourstate 0x7F 0)))
  (let v (payload (get y_to_unsigned)))
  (let m (xmask (get y_to_unsigned)))
  (assert (== v 0x7F) "Signed→unsigned: positive value preserved")
  (assert (== m 0))
  ; a has X in sign bit (bit 7): X should propagate to output
  (modify
    (set a (fourstate 0x40 0x80)))
    ; bit 7 is X
  (let m (xmask (get y_to_unsigned)))
  (assert (== m 0x80) "Signed→unsigned: X in sign bit preserved")
  ; a has X in lower bits: X should propagate
  (modify
    (set a (fourstate 0xA0 0x0F)))
    ; lower nibble X
  (let v (payload (get y_to_unsigned)))
  (let m (xmask (get y_to_unsigned)))
  (assert (== m 0x0F) "Signed→unsigned: X in lower bits preserved")
  (assert (== v 0xA0) "Signed→unsigned: value normalized (v &= ~m)")
  ; All bits Z (v=0, m=1 in new encoding)
  (modify (set a (fourstate 0 0xFF)))
  (let v (payload (get y_to_unsigned)))
  (let m (xmask (get y_to_unsigned)))
  (assert (== m 0xFF) "Signed→unsigned: all Z/X propagated")
  (assert (== v 0) "Signed→unsigned: value preserved"))

(case test_z_literal_passthrough
  (four_state)
  (source "test.veryl" #"
        module Top (a: input logic<8>, y: output logic<8>) {
            assign y = 8'hzz;
        }
    "#)
  (top Top)
  (let v (payload (get y)))
  (let m (xmask (get y)))
  (assert (== m 0xFF) "Z literal: all bits should have mask=1")
  (assert (== v 0x00) "Z literal: Z encoding has v=0"))

(case test_z_mux_tristate_pattern
  (four_state)
  (source "test.veryl" #"
        module Top (en: input logic, d: input logic<8>, y: output logic<8>) {
            assign y = if en ? d : 8'hzz;
        }
    "#)
  (top Top)
  ; en=1 → y=d (definite)
  (modify
    (set en (fourstate 1 0))
    (set d (fourstate 0xA5 0)))
  (let v (payload (get y)))
  (let m (xmask (get y)))
  (assert (== v 0xA5) "en=1: y should be d")
  (assert (== m 0) "en=1: no X/Z bits")
  ; en=0 → y=Z
  (modify (set en (fourstate 0 0)))
  (let v (payload (get y)))
  (let m (xmask (get y)))
  (assert (== m 0xFF) "en=0: y should be all Z (mask=0xFF)")
  ; Z = (v=0, m=1)
  (assert (== v 0) "en=0: Z encoding (v=0, m=1)"))

(case test_x_literal_encoding
  (four_state)
  (source "test.veryl" #"
        module Top (y: output logic<8>) {
            assign y = 8'hxx;
        }
    "#)
  (top Top)
  (let v (payload (get y)))
  (let m (xmask (get y)))
  (assert (== m 0xFF) "X literal: all bits should have mask=1")
  (assert (== v 0xFF) "X literal: X encoding has v=1"))

(case test_four_state_shifts_preserve_xz
  (four_state)
  (source "test.veryl" #"module Top (sh: input logic<16>,
a_8: input logic<8>,
shr_8: output logic<8>,
shl_8: output logic<8>,
constant_8: output logic<8>,
narrow_8: output logic<4>,
a_64: input logic<64>,
shr_64: output logic<64>,
shl_64: output logic<64>,
constant_64: output logic<64>,
narrow_64: output logic<4>,
a_65: input logic<65>,
shr_65: output logic<65>,
shl_65: output logic<65>,
constant_65: output logic<65>,
narrow_65: output logic<4>,
a_128: input logic<128>,
shr_128: output logic<128>,
shl_128: output logic<128>,
constant_128: output logic<128>,
narrow_128: output logic<4>,
a_256: input logic<256>,
shr_256: output logic<256>,
shl_256: output logic<256>,
constant_256: output logic<256>,
narrow_256: output logic<4>) {assign shr_8 = a_8 >> sh;
assign shl_8 = a_8 << sh;
assign constant_8 = a_8 >> 1;
assign narrow_8 = a_8 >> sh;
assign shr_64 = a_64 >> sh;
assign shl_64 = a_64 << sh;
assign constant_64 = a_64 >> 1;
assign narrow_64 = a_64 >> sh;
assign shr_65 = a_65 >> sh;
assign shl_65 = a_65 << sh;
assign constant_65 = a_65 >> 1;
assign narrow_65 = a_65 >> sh;
assign shr_128 = a_128 >> sh;
assign shl_128 = a_128 << sh;
assign constant_128 = a_128 >> 1;
assign narrow_128 = a_128 >> sh;
assign shr_256 = a_256 >> sh;
assign shl_256 = a_256 << sh;
assign constant_256 = a_256 >> 1;
assign narrow_256 = a_256 >> sh;
}"#)
  (top Top)
  (expand width (8 64 65 128 256)
    (do
      (let limit (- (<< 1 {width}) 1))
      (let payload (| (<< 0xaa (- {width} 8)) (? (== {width} 8) 0 0x55)))
      (let mask (<< 0xff (- {width} 8)))
      (for amount (list 0 1 (/ {width} 2) (- {width} 1))
        (modify
          (set a_{width} (fourstate payload mask))
          (set sh amount))
        (assert_eq shr_{width} (fourstate (>> payload amount) (>> mask amount)) "shr width={width}")
        (assert_eq shl_{width} (fourstate (& (<< payload amount) limit) (& (<< mask amount) limit)) "shl width={width}")
        (assert_eq constant_{width} (fourstate (>> payload 1) (>> mask 1)) "constant width={width}")
        (assert_eq narrow_{width} (fourstate (& (>> payload amount) 15) (& (>> mask amount) 15)) "narrow width={width}"))
      ; Both 1z and 1x must produce all X, despite the definite one bit.
      (for count (list 2 3)
        (modify (set sh (fourstate count 1)))
        (assert_eq shr_{width} (fourstate limit limit) "unknown count width={width}")
        (assert_eq shl_{width} (fourstate limit limit) "unknown count width={width}")
        (assert_eq narrow_{width} (fourstate 15 15))))))
