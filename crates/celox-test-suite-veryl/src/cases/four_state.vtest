(case test_four_state_ge_le_with_x
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<8>,
            b: input logic<8>,
            y_ge: output logic,
            y_le: output logic
        ) {
            assign y_ge = a >= b;
            assign y_le = a <= b;
        }
    "#)
  (top Top)
  ; Both defined and equal: GE=1, LE=1
  (modify
    (set a (fourstate 10 0))
    (set b (fourstate 10 0)))
  (let v_ge (payload (get y_ge)))
  (let m_ge (xmask (get y_ge)))
  (let v_le (payload (get y_le)))
  (let m_le (xmask (get y_le)))
  (assert (== v_ge 1) "10 >= 10")
  (assert (== m_ge 0))
  (assert (== v_le 1) "10 <= 10")
  (assert (== m_le 0))
  ; One has X → both results X
  (modify (set a (fourstate 0 1)))
  (let m_ge (xmask (get y_ge)))
  (let m_le (xmask (get y_le)))
  (assert (== m_ge 1) "GE with X should yield X")
  (assert (== m_le 1) "LE with X should yield X"))

(case test_four_state_signed_comparison_with_x
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input signed logic<8>,
            b: input signed logic<8>,
            y_lt_s: output logic,
            y_gt_s: output logic,
            y_le_s: output logic,
            y_ge_s: output logic
        ) {
            assign y_lt_s = a <: b;
            assign y_gt_s = a >: b;
            assign y_le_s = a <= b;
            assign y_ge_s = a >= b;
        }
    "#)
  (top Top)
  ; Both defined: a=-1 (0xFF), b=1 → signed: -1 < 1
  (modify
    (set a (fourstate 0xFF 0))
    (set b (fourstate 1 0)))
  (let v_lt (payload (get y_lt_s)))
  (let m_lt (xmask (get y_lt_s)))
  (let v_gt (payload (get y_gt_s)))
  (let m_gt (xmask (get y_gt_s)))
  (assert (== v_lt 1) "signed: -1 < 1 should be true")
  (assert (== m_lt 0))
  (assert (== v_gt 0) "signed: -1 > 1 should be false")
  (assert (== m_gt 0))
  ; One has X → all comparisons yield X
  (modify (set a (fourstate 0 1)))
  (let m_lt (xmask (get y_lt_s)))
  (let m_gt (xmask (get y_gt_s)))
  (let m_le (xmask (get y_le_s)))
  (let m_ge (xmask (get y_ge_s)))
  (assert (== m_lt 1) "Signed LT with X should yield X")
  (assert (== m_gt 1) "Signed GT with X should yield X")
  (assert (== m_le 1) "Signed LE with X should yield X")
  (assert (== m_ge 1) "Signed GE with X should yield X"))

(case test_four_state_reduction_xor_with_x
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<8>,
            y_rxor: output logic
        ) {
            assign y_rxor = ^a;
        }
    "#)
  (top Top)
  ; All defined: ^0xA5 = ^10100101 = 0 (even number of 1s)
  (modify (set a (fourstate 0xA5 0)))
  (let v (payload (get y_rxor)))
  (let m (xmask (get y_rxor)))
  (assert (== m 0) "No X when all bits defined")
  (assert (== v 0) "^0xA5 = 0 (even parity)")
  ; Any bit X → result X
  (modify (set a (fourstate 0xA5 1)))
  (let m (xmask (get y_rxor)))
  (assert (== m 1) "Reduction XOR with any X bit should yield X"))

(case test_four_state_65bit_boundary
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<65>,
            b: input logic<65>,
            y_and: output logic<65>,
            y_add: output logic<65>
        ) {
            assign y_and = a & b;
            assign y_add = a + b;
        }
    "#)
  (top Top)
  ; Set a = value with bit 64 set, b = all defined
  (let val_a (| (<< 1 64) 0xFF))
  (let mask_a (<< 1 64))
  ; only bit 64 is X
  (let val_b (| (<< 1 64) 0x0F))
  (modify
    (set a (fourstate val_a mask_a))
    (set b (fourstate val_b 0)))
  ; AND: bit 64 of a is X, bit 64 of b is 1 → result bit 64 is X
  ; Lower bits: 0xFF & 0x0F = 0x0F (no X); bit 64: 1 & 1 = 1 (but masked as X)
  (let v_and (payload (get y_and)))
  (let m_and (xmask (get y_and)))
  (assert (== m_and (<< 1 64)) "AND: X bit should propagate at bit 64")
  ; bit 64 value = 1 & 1 = 1 (X position value preserved), lower = 0x0F
  (assert (== v_and (| (<< 1 64) 0x0F)))
  ; ADD: any X → all-X (conservative), value is actual computation result
  (let v_add (payload (get y_add)))
  (let m_add (xmask (get y_add)))
  (let all_x_65 (- (<< 1 65) 1))
  (assert (== m_add all_x_65) "ADD with X should yield all-X mask for 65 bits")
  ; Without normalization, v contains Cranelift's actual addition result on the
  ; X-encoded value bits (v=1 for X). The mask marks all bits as unknown, so the
  ; Operations produce X (v=1,m=1): v |= m for 65-bit all-X
  (assert (== v_add m_add)))

(case test_four_state_negation_with_x
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<8>,
            y_neg: output logic<8>
        ) {
            assign y_neg = -a;
        }
    "#)
  (top Top)
  ; Defined: -5 = 0xFB (8-bit two's complement)
  (modify (set a (fourstate 5 0)))
  (let v (payload (get y_neg)))
  (let m (xmask (get y_neg)))
  (assert (== v 0xFB) "-5 = 0xFB in 8-bit")
  (assert (== m 0))
  ; Any X → all-X (conservative for arithmetic)
  (modify (set a (fourstate 0 1)))
  (let v (payload (get y_neg)))
  (let m (xmask (get y_neg)))
  (assert (== m 0xFF) "Negation with X should yield all-X")
  ; Operations produce X (v=1,m=1), never Z
  (assert (== v 0xFF)))

(case test_four_state_logical_not_with_x
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<8>,
            y_lnot: output logic
        ) {
            assign y_lnot = !(|a);
        }
    "#)
  (top Top)
  ; Defined nonzero: !0x0A = 0
  (modify (set a (fourstate 0x0A 0)))
  (let v (payload (get y_lnot)))
  (let m (xmask (get y_lnot)))
  (assert (== v 0) "!nonzero = 0")
  (assert (== m 0))
  ; Defined zero: !0 = 1
  (modify (set a (fourstate 0 0)))
  (let v (payload (get y_lnot)))
  (let m (xmask (get y_lnot)))
  (assert (== v 1) "!0 = 1")
  (assert (== m 0))
  ; X input → result X
  (modify (set a (fourstate 0 1)))
  (let m (xmask (get y_lnot)))
  (assert (== m 1) "Logical NOT with X should yield X"))

(case test_four_state_sar_x_shift_amount
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input signed logic<8>,
            sh: input logic<8>,
            y_sar: output signed logic<8>
        ) {
            assign y_sar = a >>> sh;
        }
    "#)
  (top Top)
  ; Defined: 0x80 (signed = -128) >>> 2 = 0xE0 (sign-extended)
  (modify
    (set a (fourstate 0x80 0))
    (set sh (fourstate 2 0)))
  (let v (payload (get y_sar)))
  (let m (xmask (get y_sar)))
  (assert (== v 0xE0) "0x80 >>> 2 = 0xE0 (sign extend)")
  (assert (== m 0))
  ; Shift amount has X → all-X
  (modify (set sh (fourstate 1 1)))
  (let v (payload (get y_sar)))
  (let m (xmask (get y_sar)))
  (assert (== m 0xFF) "SAR by X amount should yield all-X")
  ; Value is normalized at X positions: v |= m → 0xFF
  (assert (== v 0xFF)))

(case test_four_state_concat_three_elements
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<4>,
            b: input logic<4>,
            c: input logic<4>,
            y: output logic<12>
        ) {
            assign y = {a, b, c};
        }
    "#)
  (top Top)
  ; a=0xA (X on all bits), b=0x5 (defined), c=0x3 (defined)
  (modify
    (set a (fourstate 0xA 0xF))
    ; a: all X
    (set b (fourstate 0x5 0))
    ; b: defined
    (set c (fourstate 0x3 0)))
    ; c: defined
  (let v (payload (get y)))
  (let m (xmask (get y)))
  ; y = {a, b, c} = {XXXX, 0101, 0011} → mask = 0xF00
  ; Concat preserves input value bits at X positions (a was set with v=0xA)
  (assert (== m 0xF00) "Only high nibble should be X")
  (assert (== v 0xA53) "Defined parts: b=5, c=3; X positions preserve input value"))

(case test_four_state_wide_comparison_with_x
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<128>,
            b: input logic<128>,
            y_eq: output logic,
            y_lt: output logic
        ) {
            assign y_eq = a == b;
            assign y_lt = a <: b;
        }
    "#)
  (top Top)
  ; Both defined
  (let val (| (<< 0xAA 64) 0x55))
  (modify
    (set a (fourstate val 0))
    (set b (fourstate val 0)))
  (let v_eq (payload (get y_eq)))
  (let m_eq (xmask (get y_eq)))
  (assert (== v_eq 1) "Equal values should be EQ=1")
  (assert (== m_eq 0))
  ; Upper word of a has X → both comparisons X
  (let mask_a (<< 0xFF 64))
  (modify (set a (fourstate val mask_a)))
  (let m_eq (xmask (get y_eq)))
  (let m_lt (xmask (get y_lt)))
  (assert (== m_eq 1) "Wide EQ with X should yield X")
  (assert (== m_lt 1) "Wide LT with X should yield X"))

(case test_four_state_multibit_mux_with_x
  (four_state)
  (source "test.veryl" #"
        module Top (
            sel: input logic<2>,
            a: input logic<8>,
            b: input logic<8>,
            c: input logic<8>,
            y: output logic<8>
        ) {
            always_comb {
                if sel == 2'd0 {
                    y = a;
                } else if sel == 2'd1 {
                    y = b;
                } else {
                    y = c;
                }
            }
        }
    "#)
  (top Top)
  ; Setup branch values
  (modify
    (set a (fourstate 0xAA 0))
    (set b (fourstate 0xBB 0))
    (set c (fourstate 0xCC 0)))
  ; A procedural condition takes its true branch only for a definite one.
  ; Both equality tests are unknown here, so control reaches the final else.
  (modify
    (set sel (fourstate 0 1)))
    ; bit 0 is X
  (let v (payload (get y)))
  (let m (xmask (get y)))
  (assert (== m 0))
  (assert (== v 0xCC)))

(case test_four_state_procedural_case_x_uses_default
  (four_state)
  (source "test.veryl" #"
        module Top (
            sel: input logic<2>,
            y: output logic<8>
        ) {
            always_comb {
                case sel {
                    2'd0: y = 8'd10;
                    2'd1: y = 8'd20;
                    default: y = 8'd99;
                }
            }
        }
    "#)
  (top Top)
  (modify (set sel (fourstate 1 1)))
  (let value (payload (get y)))
  (let mask (xmask (get y)))
  (assert (== mask 0))
  (assert (== value 99)))

(case test_four_state_procedural_if_known_nonzero_with_x_is_true
  (four_state)
  (source "test.veryl" #"
        module Top (
            cond: input logic<2>,
            y: output logic<8>
        ) {
            always_comb {
                if cond {
                    y = 8'hA5;
                } else {
                    y = 8'h5A;
                }
            }
        }
    "#)
  (top Top)
  (modify
    ; 2'b1x has a known nonzero bit, so it is a true procedural condition.
    (set cond (fourstate 2 1)))
  (let value (payload (get y)))
  (let mask (xmask (get y)))
  (assert (== mask 0))
  (assert (== value 0xA5)))

(case test_four_state_width_narrowing_with_x
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<16>,
            y: output logic<8>
        ) {
            assign y = a[7:0];
        }
    "#)
  (top Top)
  ; X in upper byte only → narrow to lower byte should have no X
  (modify (set a (fourstate 0x12AB 0xFF00)))
  (let v (payload (get y)))
  (let m (xmask (get y)))
  (assert (== v 0xAB) "Lower byte should be 0xAB")
  (assert (== m 0) "Lower byte should have no X")
  ; X in lower byte → narrow should propagate X
  (modify (set a (fourstate 0x1200 0x000F)))
  (let v (payload (get y)))
  (let m (xmask (get y)))
  (assert (== m 0x0F) "Lower nibble X should propagate")
  (assert (== v 0) "X bits normalized to 0"))

(case test_four_state_width_widening_with_x
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<8>,
            y: output logic<16>
        ) {
            assign y = a;
        }
    "#)
  (top Top)
  ; a has partial X → upper byte of y should be 0 (zero-extended), no X
  (modify (set a (fourstate 0xA5 0x0F)))
  (let v (payload (get y)))
  (let m (xmask (get y)))
  ; Upper byte: zero-extended → 0x00, mask 0x00
  ; Lower byte: value 0xA5 (preserved, no normalization), mask 0x0F
  (assert (== m 0x0F) "Only lower nibble X should propagate")
  (assert (== v 0xA5) "Widening preserves input value at X positions"))

(case test_four_state_ff_conditional_with_x
  (four_state)
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            rst: input reset,
            en: input logic,
            d: input logic<8>,
            q: output logic<8>
        ) {
            always_ff {
                if_reset {
                    q = 8'd0;
                } else if en {
                    q = d;
                }
            }
        }
    "#)
  (top Top)
  ; Reset first (AsyncLow: rst=0 means active)
  (modify
    (set rst (fourstate 0 0))
    (set en (fourstate 0 0))
    (set d (fourstate 0 0))
    (set q (fourstate 0 0)))
  (tick clk)
  (let v_q (payload (get q)))
  (let m_q (xmask (get q)))
  (assert (== v_q 0))
  (assert (== m_q 0) "Reset should clear X")
  ; en=1, d has X → q captures X (deactivate reset: rst=1)
  (modify
    (set rst (fourstate 1 0))
    (set en (fourstate 1 0))
    (set d (fourstate 0xAB 0x0F)))
  (tick clk)
  (let m_q (xmask (get q)))
  (assert (== m_q 0x0F) "en=1: X from d should propagate to q")
  ; en=0, d changes → q should hold previous value (with X)
  (modify
    (set en (fourstate 0 0))
    (set d (fourstate 0xFF 0)))
  (tick clk)
  (let m_q (xmask (get q)))
  (assert (== m_q 0x0F) "en=0: q should hold previous X mask"))

(case test_four_state_concat_odd_width
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<3>,
            b: input logic<5>,
            y: output logic<8>
        ) {
            assign y = {a, b};
        }
    "#)
  (top Top)
  ; a = 3'b101 (0x5), mask=0b010 (bit 1 is X); b = 5'b10011 (0x13), mask=0
  (modify
    (set a (fourstate 0x5 0b010))
    (set b (fourstate 0x13 0)))
  (let v (payload (get y)))
  (let m (xmask (get y)))
  ; y = {a, b} = {101, 10011} → 8'b101_10011
  ; mask: a's bit 1 X → in y that's bit 6 → mask = 0b0100_0000 = 0x40
  (assert (== m 0x40) "X in a[1] should appear at y[6]")
  ; value: a = 0b101 (bit 1 is X), b = 0x13
  ; y_val = (0b101 << 5) | 0b10011 = 0b10110011 = 0xB3
  ; Normalization: v |= m → 0xB3 | 0x40 = 0xF3
  (assert (== v 0xB3) "Concat preserves input value at X positions"))

(case test_four_state_127bit
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<127>,
            b: input logic<127>,
            y_and: output logic<127>
        ) {
            assign y_and = a & b;
        }
    "#)
  (top Top)
  ; Set bit 126 (MSB of 127-bit) as X in a, b all ones
  (let val_a (| (<< 1 126) 0xFF))
  (let mask_a (<< 1 126))
  (let val_b (| (<< 0xffffffffffffffff 63) 0xffffffffffffffff))
  (modify
    (set a (fourstate val_a mask_a))
    (set b (fourstate val_b 0)))
  (let m (xmask (get y_and)))
  ; AND: a[126]=X, b[126]=1 → result[126]=X
  (assert (== m mask_a) "127-bit AND: X at MSB should propagate"))

(case test_four_state_wide_unary_not_with_x
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<128>,
            y: output logic<128>
        ) {
            assign y = ~a;
        }
    "#)
  (top Top)
  ; Upper word has X, lower word is 0xFF..FF
  (let val_a (| (<< 0xAA 64) 0xffffffffffffffff))
  (let mask_a (<< 0xFF 64))
  (modify (set a (fourstate val_a mask_a)))
  (let v (payload (get y)))
  (let m (xmask (get y)))
  ; NOT: mask preserved, defined bits inverted
  (assert (== m mask_a) "Wide NOT should preserve mask")
  ; Lower word: ~0xFF..FF = 0x00..00
  (assert_eq (& v 0xffffffffffffffff) 0 "Lower word: ~0xFFFFFFFFFFFFFFFF = 0"))

(case test_four_state_wide_negation_with_x
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<128>,
            y: output logic<128>
        ) {
            assign y = -a;
        }
    "#)
  (top Top)
  ; Any X → all-X (conservative for arithmetic)
  (let mask_a (<< 1 64))
  (modify (set a (fourstate 5 mask_a)))
  (let v (payload (get y)))
  (let m (xmask (get y)))
  (let all_x (| (<< 0xffffffffffffffff 64) 0xffffffffffffffff))
  (assert (== m all_x) "Wide negation with X should yield all-X")
  ; Without normalization, v contains the actual negation of the raw value bits.
  ; Operations produce X (v=1,m=1): all-X means v = all ones
  (assert (== v all_x)))

(case test_four_state_wide_reduction_with_x
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<128>,
            y_rand: output logic,
            y_ror:  output logic,
            y_rxor: output logic
        ) {
            assign y_rand = &a;
            assign y_ror  = |a;
            assign y_rxor = ^a;
        }
    "#)
  (top Top)
  ; a: upper word has X, lower word is all-1s
  (let val_a (| (<< 0xAA 64) 0xffffffffffffffff))
  (let mask_a (<< 0xFF 64))
  (modify (set a (fourstate val_a mask_a)))
  ; Reduction AND: upper word bits 72-127 are definite 0 → dominant-value = definite 0
  (let m_rand (xmask (get y_rand)))
  (assert (== m_rand 0) "Wide &a with definite 0 bits should be defined (dominant-value)")
  ; Reduction OR: lower word has definite 1s → dominant-value = definite 1
  ; IEEE 1800: |a = 1 if any bit is definite 1 (even if other bits are X)
  (let m_ror (xmask (get y_ror)))
  (assert (== m_ror 0) "Wide |a with definite 1 bits should be defined (dominant-value)")
  ; Reduction XOR: any X bit → result X
  (let m_rxor (xmask (get y_rxor)))
  (assert (== m_rxor 1) "Wide ^a with any X should be X"))

(case test_four_state_mux_both_branches_x
  (four_state)
  (source "test.veryl" #"
        module Top (
            sel: input logic,
            a: input logic<8>,
            b: input logic<8>,
            y: output logic<8>
        ) {
            assign y = if sel ? a : b;
        }
    "#)
  (top Top)
  ; sel=1 (defined), a=all-X (v=1,m=1), b=all-X → selects a, result all-X
  (modify
    (set sel (fourstate 1 0))
    (set a (fourstate 0xFF 0xFF))
    (set b (fourstate 0xFF 0xFF)))
  (let v (payload (get y)))
  (let m (xmask (get y)))
  (assert (== m 0xFF) "sel=1 selecting X branch → all-X")
  (assert (== v 0xFF) "X encoding: v=1, m=1")
  ; sel=0 (defined), still selects b which is X
  (modify (set sel (fourstate 0 0)))
  (let m (xmask (get y)))
  (assert (== m 0xFF) "sel=0 selecting X branch → all-X")
  ; sel=X, both branches X → definitely all-X
  (modify (set sel (fourstate 0 1)))
  (let m (xmask (get y)))
  (assert (== m 0xFF) "sel=X, both branches X → all-X"))

(case test_four_state_cascaded_mux_with_x
  (four_state)
  (source "test.veryl" #"
        module Top (
            sel1: input logic,
            sel2: input logic,
            a: input logic<8>,
            b: input logic<8>,
            c: input logic<8>,
            y: output logic<8>
        ) {
            assign y = if sel1 ? (if sel2 ? a : b) : c;
        }
    "#)
  (top Top)
  (modify
    (set a (fourstate 0xAA 0))
    (set b (fourstate 0xBB 0))
    (set c (fourstate 0xCC 0)))
  ; sel1=1, sel2=1 → a (defined)
  (modify
    (set sel1 (fourstate 1 0))
    (set sel2 (fourstate 1 0)))
  (let v (payload (get y)))
  (let m (xmask (get y)))
  (assert (== v 0xAA) "sel1=1,sel2=1 → a")
  (assert (== m 0))
  ; sel1=1, sel2=X → inner mux uncertain, result has X
  (modify (set sel2 (fourstate 0 1)))
  (let m (xmask (get y)))
  (assert (!= m 0) "sel1=1,sel2=X → inner mux X propagates")
  ; sel1=0 → c regardless of sel2
  (modify (set sel1 (fourstate 0 0)))
  (let v (payload (get y)))
  (let m (xmask (get y)))
  (assert (== v 0xCC) "sel1=0 → c regardless of sel2")
  (assert (== m 0)))

(case test_four_state_shift_both_x
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<8>,
            sh: input logic<8>,
            y: output logic<8>
        ) {
            assign y = a >> sh;
        }
    "#)
  (top Top)
  ; Both data and shift amount have X → all-X
  (modify
    (set a (fourstate 0xFF 0x0F))
    (set sh (fourstate 3 1)))
  (let v (payload (get y)))
  (let m (xmask (get y)))
  (assert (== m 0xFF) "Shift with X in both data and amount → all-X")
  ; Value is normalized at X positions: v |= m → 0xFF
  (assert (== v 0xFF)))

(case test_four_state_case_defined_selector
  (four_state)
  (source "test.veryl" #"
        module Top (
            sel: input logic<2>,
            y: output logic<8>
        ) {
            assign y = case sel {
                2'd0: 8'd10,
                2'd1: 8'd20,
                2'd2: 8'd30,
                default: 8'd99,
            };
        }
    "#)
  (top Top)
  ; sel = 1 (defined) → should match arm 1 and return 20
  (modify (set sel (fourstate 1 0)))
  (let v (payload (get y)))
  (let m (xmask (get y)))
  (assert (== m 0) "Defined selector should produce defined result")
  (assert (== v 20) "sel=1 should select value 20"))

(case test_four_state_case_x_in_selector
  (four_state)
  (source "test.veryl" #"
        module Top (
            sel: input logic<2>,
            y: output logic<8>
        ) {
            assign y = case sel {
                2'd0: 8'd10,
                2'd1: 8'd20,
                default: 8'd99,
            };
        }
    "#)
  (top Top)
  ; sel has X → EqWildcard comparison yields X → should hit default
  (modify
    (set sel (fourstate 1 1)))
    ; bit 0 is X
  (let m (xmask (get y)))
  ; With X selector, the comparison results are X, so the mux selects conservatively
  (assert (!= m 0) "Case with X selector should produce X in output (conservative mux)"))

(case test_four_state_reduction_or_dominant_one
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<8>,
            y: output logic
        ) {
            assign y = |a;
        }
    "#)
  (top Top)
  ; Value = 0x01, Mask = 0xF0 (upper nibble X, but bit 0 is definite 1)
  ; IEEE 1800: |a should be definite 1 when any bit is definite 1
  (modify (set a (fourstate 0x01 0xF0)))
  (let v (payload (get y)))
  (let m (xmask (get y)))
  (assert (== m 0) "Reduction OR with definite 1 should yield defined result")
  (assert (== v 1) "Reduction OR with definite 1 should yield 1")
  ; Value = 0x00, Mask = 0x0F (lower nibble X, upper nibble all 0)
  ; No definite 1 exists → result should be X
  (modify (set a (fourstate 0x00 0x0F)))
  (let m (xmask (get y)))
  (assert (== m 1) "Reduction OR with no definite 1 but X bits should yield X"))

(case test_four_state_reduction_and_dominant_zero
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<8>,
            y: output logic
        ) {
            assign y = &a;
        }
    "#)
  (top Top)
  ; Value = 0xFE, Mask = 0xF0 (upper nibble X, but bit 0 is definite 0)
  ; IEEE 1800: &a should be definite 0 when any bit is definite 0
  (modify (set a (fourstate 0x0E 0xF0)))
  (let v (payload (get y)))
  (let m (xmask (get y)))
  (assert (== m 0) "Reduction AND with definite 0 should yield defined result")
  (assert (== v 0) "Reduction AND with definite 0 should yield 0")
  ; Value = 0xF0, Mask = 0x0F (lower nibble X, upper nibble all 1)
  ; All defined bits are 1, but X bits exist → result should be X
  (modify (set a (fourstate 0xF0 0x0F)))
  (let m (xmask (get y)))
  (assert (== m 1) "Reduction AND with no definite 0 but X bits should yield X"))

(case test_four_state_wide_reduction_or_dominant
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<128>,
            y: output logic
        ) {
            assign y = |a;
        }
    "#)
  (top Top)
  ; Lower 64-bit chunk has definite 1 (bit 0), upper chunk is all X
  ; |a should be definite 1 due to dominant-value
  (let val 1)
  ; bit 0 = 1
  (let mask (| 0 (<< 0xffffffffffffffff 64)))
  ; upper chunk all X
  (modify (set a (fourstate val mask)))
  (let v (payload (get y)))
  (let m (xmask (get y)))
  (assert (== m 0) "Wide reduction OR: definite 1 in any chunk → defined result")
  (assert (== v 1) "Wide reduction OR: definite 1 in any chunk → 1"))

(case test_four_state_wide_reduction_and_dominant
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<128>,
            y: output logic
        ) {
            assign y = &a;
        }
    "#)
  (top Top)
  ; Lower 64-bit chunk has definite 0 (bit 0), upper chunk is all X
  ; &a should be definite 0 due to dominant-value
  (let val 0xFFFFFFFFFFFFFFFE)
  ; bit 0 = 0
  (let mask (| 0 (<< 0xffffffffffffffff 64)))
  ; upper chunk all X
  (modify (set a (fourstate val mask)))
  (let v (payload (get y)))
  (let m (xmask (get y)))
  (assert (== m 0) "Wide reduction AND: definite 0 in any chunk → defined result")
  (assert (== v 0) "Wide reduction AND: definite 0 in any chunk → 0"))

(case test_four_state_logic_and_dominant_zero
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<8>,
            b: input logic<8>,
            y: output logic
        ) {
            assign y = (|a) && (|b);
        }
    "#)
  (top Top)
  ; 0 && X = 0 (definite)
  (modify
    (set a (fourstate 0 0))
    ; definite 0
    (set b (fourstate 0 0xFF)))
    ; all X
  (let v (payload (get y)))
  (let m (xmask (get y)))
  (assert (== m 0) "0 && X should be definite (mask=0)")
  (assert (== v 0) "0 && X = 0")
  ; X && 0 = 0 (definite)
  (modify
    (set a (fourstate 0 0xFF))
    ; all X
    (set b (fourstate 0 0)))
    ; definite 0
  (let v (payload (get y)))
  (let m (xmask (get y)))
  (assert (== m 0) "X && 0 should be definite (mask=0)")
  (assert (== v 0) "X && 0 = 0")
  ; 1 && X = X
  (modify
    (set a (fourstate 1 0))
    ; definite 1
    (set b (fourstate 0 0xFF)))
    ; all X
  (let m (xmask (get y)))
  (assert (!= m 0) "1 && X should be X (mask!=0)")
  ; X && 1 = X
  (modify
    (set a (fourstate 0 0xFF))
    ; all X
    (set b (fourstate 1 0)))
    ; definite 1
  (let m (xmask (get y)))
  (assert (!= m 0) "X && 1 should be X (mask!=0)")
  ; 1 && 1 = 1 (definite)
  (modify
    (set a (fourstate 1 0))
    (set b (fourstate 1 0)))
  (let v (payload (get y)))
  (let m (xmask (get y)))
  (assert (== m 0) "1 && 1 should be definite")
  (assert (== v 1) "1 && 1 = 1"))

(case test_four_state_logic_or_dominant_one
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<8>,
            b: input logic<8>,
            y: output logic
        ) {
            assign y = (|a) || (|b);
        }
    "#)
  (top Top)
  ; 1 || X = 1 (definite)
  (modify
    (set a (fourstate 1 0))
    ; definite 1
    (set b (fourstate 0 0xFF)))
    ; all X
  (let v (payload (get y)))
  (let m (xmask (get y)))
  (assert (== m 0) "1 || X should be definite (mask=0)")
  (assert (== v 1) "1 || X = 1")
  ; X || 1 = 1 (definite)
  (modify
    (set a (fourstate 0 0xFF))
    ; all X
    (set b (fourstate 1 0)))
    ; definite 1
  (let v (payload (get y)))
  (let m (xmask (get y)))
  (assert (== m 0) "X || 1 should be definite (mask=0)")
  (assert (== v 1) "X || 1 = 1")
  ; 0 || X = X
  (modify
    (set a (fourstate 0 0))
    ; definite 0
    (set b (fourstate 0 0xFF)))
    ; all X
  (let m (xmask (get y)))
  (assert (!= m 0) "0 || X should be X (mask!=0)")
  ; X || 0 = X
  (modify
    (set a (fourstate 0 0xFF))
    ; all X
    (set b (fourstate 0 0)))
    ; definite 0
  (let m (xmask (get y)))
  (assert (!= m 0) "X || 0 should be X (mask!=0)")
  ; 0 || 0 = 0 (definite)
  (modify
    (set a (fourstate 0 0))
    (set b (fourstate 0 0)))
  (let v (payload (get y)))
  (let m (xmask (get y)))
  (assert (== m 0) "0 || 0 should be definite")
  (assert (== v 0) "0 || 0 = 0"))

(case test_four_state_eq_wildcard_value_at_wildcard_pos
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<4>,
            b: input logic<4>,
            y: output logic
        ) {
            assign y = a ==? b;
        }
    "#)
  (top Top)
  ; LHS = 4'b1110 (definite), RHS = 4'b1x1x (mask=0b0101)
  ; Non-wildcard positions (bits 1,3): LHS[1]=1=RHS[1], LHS[3]=1=RHS[3] → match
  ; IEEE 1800: ==? should return 1 (definite true)
  (modify
    (set a (fourstate 0b1110 0))
    ; definite
    (set b (fourstate 0b1010 0b0101)))
    ; bits 0,2 are X
  (let v (payload (get y)))
  (let m (xmask (get y)))
  (assert (== m 0) "==? with matching non-wildcard bits should be definite")
  (assert (== v 1) "==? with matching non-wildcard bits should be 1")
  ; LHS = 4'b1100 (definite), RHS = 4'b1x1x (mask=0b0101)
  ; Non-wildcard positions: bit 1: LHS[1]=0, RHS[1]=1 → mismatch
  ; IEEE 1800: ==? should return 0 (definite false)
  (modify
    (set a (fourstate 0b1100 0))
    (set b (fourstate 0b1010 0b0101)))
  (let v (payload (get y)))
  (let m (xmask (get y)))
  (assert (== m 0) "==? with definite mismatch should be definite")
  (assert (== v 0) "==? with mismatch at non-wildcard should be 0")
  ; LHS has X at non-wildcard position, no definite mismatch
  ; LHS = 4'bxx10, RHS = 4'b1x1x → compare at bits 1,3
  ; bit 1: LHS[1]=1 (definite), RHS[1]=1 → match
  ; bit 3: LHS[3]=X → unknown
  ; IEEE 1800: ==? should return X
  (modify
    (set a (fourstate 0b0010 0b1100))
    ; bits 2,3 = X
    (set b (fourstate 0b1010 0b0101)))
    ; bits 0,2 = X
  (let m (xmask (get y)))
  (assert (!= m 0) "==? with LHS X at non-wildcard should be X")
  ; Definite mismatch takes priority over LHS X elsewhere
  ; LHS = 4'bxx00, RHS = 4'b1x1x → compare at bits 1,3
  ; bit 1: LHS[1]=0, RHS[1]=1 → definite mismatch
  ; bit 3: LHS[3]=X → unknown, but mismatch already found
  ; IEEE 1800: ==? should return 0 (definite false)
  (modify
    (set a (fourstate 0b0000 0b1100))
    ; bits 2,3 = X
    (set b (fourstate 0b1010 0b0101)))
    ; bits 0,2 = X
  (let v (payload (get y)))
  (let m (xmask (get y)))
  (assert (== m 0) "==? with definite mismatch should be definite even with X elsewhere")
  (assert (== v 0) "==? with definite mismatch = 0"))

(case test_four_state_ne_wildcard_value_at_wildcard_pos
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<4>,
            b: input logic<4>,
            y: output logic
        ) {
            assign y = a !=? b;
        }
    "#)
  (top Top)
  ; LHS = 4'b1110 (definite), RHS = 4'b1x1x (mask=0b0101)
  ; All non-wildcard positions match → !=? should return 0 (definite false)
  (modify
    (set a (fourstate 0b1110 0))
    (set b (fourstate 0b1010 0b0101)))
  (let v (payload (get y)))
  (let m (xmask (get y)))
  (assert (== m 0) "!=? with all matching should be definite")
  (assert (== v 0) "!=? with all matching = 0")
  ; LHS = 4'b1100, RHS = 4'b1x1x → mismatch at bit 1
  ; !=? should return 1 (definite true)
  (modify
    (set a (fourstate 0b1100 0))
    (set b (fourstate 0b1010 0b0101)))
  (let v (payload (get y)))
  (let m (xmask (get y)))
  (assert (== m 0) "!=? with definite mismatch should be definite")
  (assert (== v 1) "!=? with mismatch = 1"))

(case test_four_state_wide_wildcard_equality
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<130>,
            b: input logic<130>,
            y_eq: output logic,
            y_ne: output logic
        ) {
            assign y_eq = a ==? b;
            assign y_ne = a !=? b;
        }
    "#)
  (top Top)
  (let bit_64 (<< 1 64))
  (let bit_65 (<< 1 65))
  (let bit_129 (<< 1 129))
  (let rhs_value (| bit_64 bit_129))
  ; A difference at an RHS wildcard in the second chunk is ignored.
  (modify
    (set a (fourstate (| rhs_value bit_65) 0))
    (set b (fourstate rhs_value bit_65)))
  (assert_eq y_eq (fourstate 1 0))
  (assert_eq y_ne (fourstate 0 0))
  ; An unknown LHS bit at a non-wildcard position in the top chunk makes
  ; both wildcard equality results unknown.
  (modify
    (set a (fourstate rhs_value bit_129))
    (set b (fourstate rhs_value bit_65)))
  (assert_eq y_eq (fourstate 1 1))
  (assert_eq y_ne (fourstate 1 1))
  ; A definite mismatch in another high chunk dominates that unknown.
  (modify
    (set a (fourstate bit_129 bit_129))
    (set b (fourstate rhs_value bit_65)))
  (assert_eq y_eq (fourstate 0 0))
  (assert_eq y_ne (fourstate 1 0)))

(case test_four_state_wide_mul_with_x
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<128>,
            b: input logic<128>,
            y_mul: output logic<128>
        ) {
            assign y_mul = a * b;
        }
    "#)
  (top Top)
  (let all_x_128 (| (<< 0xffffffffffffffff 64) 0xffffffffffffffff))
  ; Both defined: 3 * 7 = 21
  (modify
    (set a (fourstate 3 0))
    (set b (fourstate 7 0)))
  (let v (payload (get y_mul)))
  (let m (xmask (get y_mul)))
  (assert (== v 21) "Wide 3 * 7 = 21")
  (assert (== m 0) "No X when both defined")
  ; One operand has X in upper word → result should be all-X
  (let mask_a (<< 1 64))
  (modify (set a (fourstate 3 mask_a)))
  (let v (payload (get y_mul)))
  (let m (xmask (get y_mul)))
  (assert (== m all_x_128) "Wide MUL with X should yield all-X mask")
  ; Operations produce X (v=1,m=1): all-X means v = all ones
  (assert (== v all_x_128)))

(case test_four_state_wide_div_with_x
