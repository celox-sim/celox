(group four_state (category four_state))

(case test_four_state_and_or
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic,
            b: input logic,
            y_and: output logic,
            y_or: output logic
        ) {
            assign y_and = a & b;
            assign y_or = a | b;
        }
    "#)
  (top Top)
  ; Test: 0 & X = 0, 0 | X = X
  ; a = 0 (Val=0, Mask=0)
  ; b = X (Val=1, Mask=1) — new encoding: X has v=1
  (modify
    (set a (fourstate 0 0))
    (set b (fourstate 1 1)))
  (let v_and (payload (get y_and)))
  (let m_and (xmask (get y_and)))
  (assert (== m_and 0) "0 & X should have mask 0")
  (assert (== v_and 0) "0 & X should have value 0")
  (let v_or (payload (get y_or)))
  (let m_or (xmask (get y_or)))
  (assert (== m_or 1) "0 | X should have mask 1 (X)")
  (assert (== v_or 1) "0 | X should have value 1 (X encoding)"))

(case test_four_state_initial_and_set
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<8>,
            b: input bit<8>
        ) {}
    "#)
  (top Top)
  ; 1. Initial value is X for logic in new encoding
  (let v_init_a (payload (get a)))
  (let m_init_a (xmask (get a)))
  (assert (== v_init_a 0xFF))
  (assert (== m_init_a 0xFF))
  ; `bit` type should be initialized to 0, mask 0
  (let v_init_b (payload (get b)))
  (let m_init_b (xmask (get b)))
  (assert (== v_init_b 0))
  (assert (== m_init_b 0) "bit type should not be initialized to X")
  ; 2. set (2-state API) updates value, leaves mask as 0
  (modify (set a 42))
  (let v_set (payload (get a)))
  (let m_set (xmask (get a)))
  (assert (== v_set 42))
  (assert (== m_set 0))
  ; 3. set_four_state (4-state API) updates both value and mask
  (modify (set a (fourstate 0xA5 0x0F)))
  (let v_four_set (payload (get a)))
  (let m_four_set (xmask (get a)))
  (assert (== v_four_set 0xA5))
  (assert (== m_four_set 0x0F))
  ; Now `set` and `set_wide` should clear the mask bits that might have been
  ; previously set by `set_four_state` or logic.
  (modify (set a 100))
  (let v_set2 (payload (get a)))
  (let m_set2 (xmask (get a)))
  (assert (== v_set2 100))
  (assert (== m_set2 0) "Mask should be cleared by set()"))

(case test_ff_struct_logic_to_bit_coercion_clears_mask
  (four_state)
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            in_logic: input logic<8>,
            out_bit: output bit<8>
        ) {
            struct S {
                x: bit<8>,
            }
            var r: S;
            always_ff (clk) {
                r = S'{x: in_logic};
            }
            assign out_bit = r.x;
        }
    "#)
  (top Top)
  (modify (set in_logic (fourstate 0xA5 0x0F)))
  (tick clk)
  (let _value (payload (get out_bit)))
  (let mask (xmask (get out_bit)))
  (assert (== mask 0) "logic -> bit coercion must clear X/Z mask"))

(case test_four_state_mixing
  (four_state)
  (source "test.veryl" #"
        module Top (
            a_logic: input logic<8>,
            b_bit: input bit<8>,
            y_logic_from_bit: output logic<8>,
            y_bit_from_logic: output bit<8>
        ) {
            // Assigning a logic (4-state) to a bit (2-state) should drop the X state.
            assign y_bit_from_logic = a_logic as u8;
            // Assigning a bit (2-state) to a logic (4-state) should have mask 0.
            assign y_logic_from_bit = b_bit;
        }
    "#)
  (top Top)
  ; Set `a_logic` to all X's
  ; Set `b_bit` to defined value 0xAA
  (modify
    (set a_logic (fourstate 0 0xFF))
    (set b_bit (fourstate 0xAA 0)))
  ; Verify `y_logic_from_bit` is exactly 0xAA with mask 0
  (let v_y_logic (payload (get y_logic_from_bit)))
  (let m_y_logic (xmask (get y_logic_from_bit)))
  (assert (== v_y_logic 0xAA))
  (assert (== m_y_logic 0) "bit to logic assignment should have 0 mask")
  ; Verify `y_bit_from_logic` drops the X mask and becomes a definite value (typically 0)
  (let _v_y_bit (payload (get y_bit_from_logic)))
  (let m_y_bit (xmask (get y_bit_from_logic)))
  (assert (== m_y_bit 0) "logic to bit assignment should drop X mask"))

(case test_four_state_mixing_propagation
  (four_state)
  (source "test.veryl" #"
        module Top (
            a_logic: input logic<8>,
            y_logic: output logic<8>
        ) {
            var temp_bit: bit<8>;
            assign temp_bit = a_logic as u8;
            assign y_logic = temp_bit;
        }
    "#)
  (top Top)
  ; Set `a_logic` to all X's
  (modify (set a_logic (fourstate 0 0xFF)))
  (let m_y_logic (xmask (get y_logic)))
  ; If JIT incorrectly propagates X through 'temp_bit', mask will be 0xFF.
  ; Verilog semantics: 'temp_bit' is 2-state, so it cannot hold X. It becomes 0.
  ; 'y_logic' becomes 0, so mask must be 0.
  (assert (== m_y_logic 0) "X should be stripped when propagating through a bit intermediate variable"))

(case test_read_a
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<8>
        ) {}
    "#)
  (top Top)
  (modify (set a (fourstate 0xA5 0x0F)))
  (let _v (payload (get a)))
  (let m (xmask (get a)))
  (assert (== m 0x0F) "mask of A should be 15, not 255"))

(case test_four_state_arithmetic_ops
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<8>,
            b: input logic<8>,
            y_add: output logic<8>
        ) {
            assign y_add = a + b;
        }
    "#)
  (top Top)
  ; Test: 10 + X = X (Arithmetic operations with ANY X input yields all X's output)
  (modify
    (set a (fourstate 10 0))
    ; b = X at LSB: (v=1, m=1)
    (set b (fourstate 1 1)))
  (let v_add (payload (get y_add)))
  (let m_add (xmask (get y_add)))
  (assert (== m_add 0xFF) "Arithmetic addition with X input should yield all X mask")
  ; All bits are X, so value is normalized: v |= m → 0xFF
  (assert (== v_add 0xFF) "Value is normalized at X positions (v |= m)"))

(case test_four_state_unary_ops
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<8>,
            y_bitnot: output logic<8>,
            y_redor: output logic
        ) {
            assign y_bitnot = ~a;
            assign y_redor = |a;
        }
    "#)
  (top Top)
  ; a = 0xA5 (10100101) with mask 0x0F (00001111) (so lower nibble is X, upper is 1010)
  (modify (set a (fourstate 0xA5 0x0F)))
  (let _v_bitnot (payload (get y_bitnot)))
  (let m_bitnot (xmask (get y_bitnot)))
  ; ~a: Value bits flip, mask bits remain the same.
  (assert (== m_bitnot 0x0F) "Bitwise NOT should preserve mask bits")
  ; Upper nibble of 0xA5 inverted -> 0x50.
  ; Lower nibble is masked (value usually preserved or zeroed).
  ; Veryl Translator currently flips the valid bits and preserves the rest.
  (let _m_redor (xmask (get y_redor))))
  ; Reduction operations with X (and no definite dominant bit) normally yield X.
  ; Since upper nibble contains 1s (1010), |a actually evaluates to 1 deterministically in standard Verilog.
  ; Let's see how the current fallback logic handles reduction.
  ; Many JIT implementations just fallback to X if ANY bit is X for simplification.

(case test_four_state_xor_partial_x
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<8>,
            b: input logic<8>,
            y: output logic<8>
        ) {
            assign y = a ^ b;
        }
    "#)
  (top Top)
  ; a = 0xFF (mask=0x0F → lower nibble X), b = 0x00 (mask=0)
  ; XOR: mask = mask_a | mask_b = 0x0F
  (modify
    (set a (fourstate 0xFF 0x0F))
    (set b (fourstate 0x00 0x00)))
  (let m_y (xmask (get y)))
  (assert (== m_y 0x0F) "XOR mask should be union of input masks"))

(case test_four_state_concat
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<4>,
            b: input logic<4>,
            y: output logic<8>
        ) {
            assign y = {a, b};
        }
    "#)
  (top Top)
  ; a = 0xA (mask=0xF → all X), b = 0x5 (mask=0x0 → defined)
  ; Result: y = {X, 0x5}, mask should have upper nibble X, lower defined
  (modify
    (set a (fourstate 0xA 0xF))
    (set b (fourstate 0x5 0x0)))
  (let v_y (payload (get y)))
  (let m_y (xmask (get y)))
  (assert (== m_y 0xF0) "Concat: upper nibble should be X (from a), lower nibble defined (from b)")
  ; Lower nibble value should be 5
  (assert_eq (& v_y 0x0F) 0x05))

(case test_four_state_shift_by_constant
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<8>,
            y_shr: output logic<8>,
            y_shl: output logic<8>
        ) {
            assign y_shr = a >> 4;
            assign y_shl = a << 4;
        }
    "#)
  (top Top)
  ; a = 0xA5 (mask = 0x0F → lower nibble X)
  (modify (set a (fourstate 0xA5 0x0F)))
  ; a >> 4: value shifts right, mask shifts right too
  ; mask 0x0F >> 4 = 0x00
  (let m_shr (xmask (get y_shr)))
  (assert (== m_shr 0x00) "Right shift by 4 should shift X mask out")
  ; a << 4: mask 0x0F << 4 = 0xF0
  (let m_shl (xmask (get y_shl)))
  (assert (== m_shl 0xF0) "Left shift by 4 should shift X mask to upper nibble"))

(case test_four_state_shift_by_x_amount
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<8>,
            b: input logic<8>,
            y: output logic<8>
        ) {
            assign y = a >> b;
        }
    "#)
  (top Top)
  ; a = 0xFF (defined), b = X (mask=0xFF) → shift amount unknown → all X
  (modify
    (set a (fourstate 0xFF 0x00))
    (set b (fourstate 0x00 0xFF)))
  (let m_y (xmask (get y)))
  (assert (== m_y 0xFF) "Shift by X amount should produce all-X mask"))

(case test_four_state_comparison_with_x
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<8>,
            b: input logic<8>,
            y_eq: output logic,
            y_lt: output logic
        ) {
            assign y_eq = a == b;
            assign y_lt = a <: b;
        }
    "#)
  (top Top)
  ; The known bits agree: a = 0, b = 0000000X. Equality is indeterminate.
  (modify
    (set a (fourstate 0 0))
    (set b (fourstate 1 1)))
  (let m_eq (xmask (get y_eq)))
  (let m_lt (xmask (get y_lt)))
  ; Equality is X when unknown bits can change the result.
  (assert (== m_eq 1) "Equality comparison with X input should yield X")
  (assert (== m_lt 1) "Less-than comparison with X input should yield X"))

(case test_four_state_mux_x_condition
  (four_state)
  (source "test.veryl" #"
        module Top (
            sel: input logic,
            a: input logic<8>,
            b: input logic<8>,
            y: output logic<8>
        ) {
            assign y = if sel ? a : b;
        }
    "#)
  (top Top)
  ; sel = X (v=1,m=1), a = 0xAA, b = 0xBB. Equal branch bits are
  ; preserved; only differing bits become X.
  (modify
    (set sel (fourstate 1 1))
    (set a (fourstate 0xAA 0))
    (set b (fourstate 0xBB 0)))
  (let v_y (payload (get y)))
  (let m_y (xmask (get y)))
  (assert (== v_y 0xBB))
  (assert (== m_y 0x11) "Mux with X condition must merge branch bits"))

(case test_four_state_mux_x_in_branch
  (four_state)
  (source "test.veryl" #"
        module Top (
            sel: input logic,
            a: input logic<8>,
            b: input logic<8>,
            y: output logic<8>
        ) {
            assign y = if sel ? a : b;
        }
    "#)
  (top Top)
  ; sel = 1 (defined), a = X (mask=0xFF), b = 0xBB (defined)
  ; → selects a which is X
  (modify
    (set sel (fourstate 1 0))
    (set a (fourstate 0 0xFF))
    (set b (fourstate 0xBB 0)))
  (let m_y (xmask (get y)))
  (assert (== m_y 0xFF) "Mux sel=1 selecting X branch should propagate X")
  ; sel = 0 (defined), selects b which is defined → mask should be 0
  (modify (set sel (fourstate 0 0)))
  (let v_y (payload (get y)))
  (let m_y (xmask (get y)))
  (assert (== m_y 0) "Mux sel=0 selecting defined branch should have mask=0")
  (assert (== v_y 0xBB)))

(case test_four_state_wide_128bit
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<128>,
            b: input logic<128>,
            y_and: output logic<128>,
            y_or:  output logic<128>
        ) {
            assign y_and = a & b;
            assign y_or  = a | b;
        }
    "#)
  (top Top)
  ; a = all-ones (defined), b = 0 with X in upper 64 bits
  (let val_a (| (<< 0xffffffffffffffff 64) 0xffffffffffffffff))
  (let mask_a 0)
  (let val_b 0)
  (let mask_b (<< 0xffffffffffffffff 64))
  ; upper 64 bits are X
  (modify
    (set a (fourstate val_a mask_a))
    (set b (fourstate val_b mask_b)))
  ; AND: 1 & X = X (upper 64), 1 & 0 = 0 (lower 64)
  (let m_and (xmask (get y_and)))
  (let expected_mask_upper (<< 0xffffffffffffffff 64))
  (assert (== m_and expected_mask_upper) "128-bit AND: upper 64 bits should be X, lower should be 0")
  ; OR: 1 | X → mask=0 (dominant 1 in OR), lower: 1 | 0 = 1
  (let m_or (xmask (get y_or)))
  (assert (== m_or 0) "128-bit OR: 1|X = 1, so mask should be 0"))

(case test_four_state_always_comb_chain
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<8>,
            b: input logic<8>,
            y: output logic<8>
        ) {
            var tmp: logic<8>;
            always_comb {
                tmp = a & b;
                y   = tmp | 8'hF0;
            }
        }
    "#)
  (top Top)
  ; a = 0xFF (defined), b = 0xFF with X in bit 0
  ; tmp = 0xFF & (0xFF, mask=0x01) → AND: mask bit0 from b only (since a[0]=1, b[0]=X → X)
  ; y = tmp | 0xF0 → mask: OR with 1 clears X for bits [7:4]; bit[0] X | 0 = X
  (modify
    (set a (fourstate 0xFF 0x00))
    (set b (fourstate 0xFF 0x01)))
  (let m_y (xmask (get y)))
  ; After AND: mask = 0x01 (bit 0 is X from b because a[0]=1)
  ; After OR with 0xF0: bit 0 was X, OR with 0→still X. Bits 7:4 are OR'd with 1→defined.
  ; So final mask should have only bit 0 as X = 0x01
  (assert (== m_y 0x01) "always_comb chain should propagate X through AND then OR correctly"))

(case test_four_state_ff_capture_and_reset
  (four_state)
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            rst: input reset,
            d: input logic<8>,
            q: output logic<8>
        ) {
            always_ff {
                if_reset {
                    q = 8'd0;
                } else {
                    q = d;
                }
            }
        }
    "#)
  (top Top)
  ; 1. Reset: q should become 0 with mask=0 (AsyncLow: rst=0 means active)
  (modify
    (set rst (fourstate 0 0))
    (set d (fourstate 0 0xFF))
    (set q (fourstate 0 0)))
  (tick clk)
  (let v_q (payload (get q)))
  (let m_q (xmask (get q)))
  (assert (== v_q 0) "After reset, q value should be 0")
  (assert (== m_q 0) "After reset, q mask should be 0 (constant reset value)")
  ; 2. Normal: d = X → q should capture X (deactivate reset: rst=1)
  (modify
    (set rst (fourstate 1 0))
    (set d (fourstate 0xA5 0x0F)))
  (tick clk)
  (let _v_q (payload (get q)))
  (let m_q (xmask (get q)))
  (assert (== m_q 0x0F) "FF should capture X mask from d")
  ; 3. Reset again: should clear X (activate reset: rst=0)
  (modify (set rst (fourstate 0 0)))
  (tick clk)
  (let v_q (payload (get q)))
  (let m_q (xmask (get q)))
  (assert (== v_q 0))
  (assert (== m_q 0) "Reset should clear X mask in FF"))

(case test_four_state_all_defined
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<8>,
            b: input logic<8>,
            y_add: output logic<8>,
            y_and: output logic<8>,
            y_xor: output logic<8>
        ) {
            assign y_add = a + b;
            assign y_and = a & b;
            assign y_xor = a ^ b;
        }
    "#)
  (top Top)
  ; All defined (mask=0)
  (modify
    (set a (fourstate 0xA5 0))
    (set b (fourstate 0x5A 0)))
  (let v_add (payload (get y_add)))
  (let m_add (xmask (get y_add)))
  (assert (== v_add 0xFF))
  (assert (== m_add 0) "All defined: add mask should be 0")
  (let v_and (payload (get y_and)))
  (let m_and (xmask (get y_and)))
  (assert (== v_and 0x00))
  (assert (== m_and 0) "All defined: and mask should be 0")
  (let v_xor (payload (get y_xor)))
  (let m_xor (xmask (get y_xor)))
  (assert (== v_xor 0xFF))
  (assert (== m_xor 0) "All defined: xor mask should be 0"))

(case test_four_state_wide_128bit_simple
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<128>,
            b: input logic<128>,
            y: output logic<128>
        ) {
            assign y = a & b;
        }
    "#)
  (top Top)
  (let val_a (| (<< 0x12345678 64) 0x9abcdef0))
  (let val_b (| (<< 0xFFFFFFFF 64) 0))
  (let mask_zero 0)
  (modify
    (set a (fourstate val_a mask_zero))
    (set b (fourstate val_b mask_zero)))
  (let v_y (payload (get y)))
  (let m_y (xmask (get y)))
  (let expected_v (& val_a val_b))
  (assert (== v_y expected_v) "128-bit simple AND value")
  (assert (== m_y 0) "128-bit simple AND mask should be 0"))

(case test_four_state_wide_shifts
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<128>,
            sh: input logic<8>,
            y_shr: output logic<128>,
            y_shl: output logic<128>
        ) {
            assign y_shr = a >> sh;
            assign y_shl = a << sh;
        }
    "#)
  (top Top)
  ; IEEE 1800-2023 11.4.10: shifts preserve retained X and Z bits.
  ; Case 1: Shift by 0; bits 71:64 contain alternating X/Z.
  (let val_a (| (<< 0xAA 64) 0x55))
  (let mask_a (<< 0xFF 64))
  (modify
    (set a (fourstate val_a mask_a))
    (set sh (fourstate 0 0)))
  (let v_shr (payload (get y_shr)))
  (let m_shr (xmask (get y_shr)))
  (assert (== v_shr val_a))
  (assert (== m_shr mask_a))
  ; Case 2: Shift by 64 (entire word boundary)
  (modify (set sh (fourstate 64 0)))
  (let v_shr (payload (get y_shr)))
  (let m_shr (xmask (get y_shr)))
  (assert (== v_shr 0xAA))
  (assert (== m_shr 0xFF))
  ; Case 3: Shift by amount with X -> Result should be all X
  (modify (set sh (fourstate 1 1)))
  (let v_shr (payload (get y_shr)))
  (let m_shr (xmask (get y_shr)))
  (let all_x (| (<< 0xffffffffffffffff 64) 0xffffffffffffffff))
  (assert (== v_shr all_x) "Shift by X should result in all-X payload")
  (assert (== m_shr all_x) "Shift by X should result in all-X mask"))

(case test_four_state_wide_arith
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<128>,
            b: input logic<128>,
            y_add: output logic<128>,
            y_sub: output logic<128>
        ) {
            assign y_add = a + b;
            assign y_sub = a - b;
        }
    "#)
  (top Top)
  ; partial X in a
  (let val_a 1)
  (let mask_a (<< 0xffffffffffffffff 64))
  (let val_b 1)
  (let mask_b 0)
  (modify
    (set a (fourstate val_a mask_a))
    (set b (fourstate val_b mask_b)))
  (let m_add (xmask (get y_add)))
  (let all_x (| (<< 0xffffffffffffffff 64) 0xffffffffffffffff))
  (assert (== m_add all_x) "Arithmetic with partial X should result in all-X for multi-word"))

(case test_four_state_wide_signed
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input signed logic<128>,
            b: input signed logic<128>,
            y_sar: output signed logic<128>,
            y_lts: output logic
        ) {
            assign y_sar = a >>> 64;
            assign y_lts = a <: b;
        }
    "#)
  (top Top)
  ; a = -1 (all ones) but MSB chunk is X
  (let val_a (| (<< 0xffffffffffffffff 64) 0xffffffffffffffff))
  (let mask_a (<< 0xffffffffffffffff 64))
  (modify (set a (fourstate val_a mask_a)))
  (let m_sar (xmask (get y_sar)))
  (let expected_m_sar (| (<< 0xffffffffffffffff 64) 0xffffffffffffffff))
  (assert (== m_sar expected_m_sar) "SAR sign extension should propagate X")
  ; Signed comparison with X
  (let val_b 0)
  (let mask_b 0)
  (modify (set b (fourstate val_b mask_b)))
  (let m_lts (xmask (get y_lts)))
  (assert (== m_lts 1) "Comparison with X should result in X (conservative)"))

(case test_four_state_wide_concat_mixed
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<64>,
            b: input bit<64>,
            y_concat: output logic<128>
        ) {
            assign y_concat = {a, b}; // a (4-state) high, b (2-state) low
        }
    "#)
  (top Top)
  ; a has X, b is normal bit
  (let val_a 0xAA)
  (let mask_a 0xFF)
  (let val_b 0x55)
  (modify
    (set a (fourstate val_a mask_a))
    (set b val_b))
  (let v_c (payload (get y_concat)))
  (let m_c (xmask (get y_concat)))
  (let expected_m (<< 0xFF 64))
  ; Concat preserves input values at X positions
  (let expected_v (| (<< 0xAA 64) 0x55))
  (assert (== v_c expected_v))
  (assert (== m_c expected_m)))

(case test_four_state_mul_with_x
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<8>,
            b: input logic<8>,
            y_mul: output logic<8>
        ) {
            assign y_mul = a * b;
        }
    "#)
  (top Top)
  ; Both defined: 3 * 7 = 21
  (modify
    (set a (fourstate 3 0))
    (set b (fourstate 7 0)))
  (let v (payload (get y_mul)))
  (let m (xmask (get y_mul)))
  (assert (== v 21) "3 * 7 = 21")
  (assert (== m 0) "No X when both defined")
  ; One operand has X: result should be all-X
  (modify (set b (fourstate 0 1)))
  (let v (payload (get y_mul)))
  (let m (xmask (get y_mul)))
  (assert (== m 0xFF) "MUL with X should yield all-X mask")
  (assert (== v 0xFF) "Value normalized at X positions (v |= m)"))

