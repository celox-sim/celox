(case test_four_state_equality_known_mismatch_with_unknown_bits
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<8>, b: input logic<8>,
            eq: output logic, ne: output logic,
        ) {
            assign eq = a == b;
            assign ne = a != b;
        }
    "#)
  (top Top)
  (for unknown_payload (list 0 1)
    (modify
      (set a (fourstate unknown_payload 1))
      (set b 20))
    (assert_eq eq (fourstate 0 0))
    (assert_eq ne (fourstate 1 0))))

(case test_four_state_ne_with_x
  (four_state)
  (source "test.veryl" #"
        module Top (
            a: input logic<8>,
            b: input logic<8>,
            y_ne: output logic
        ) {
            assign y_ne = a != b;
        }
    "#)
  (top Top)
  ; Both defined: 10 != 20 → 1
  (modify
    (set a (fourstate 10 0))
    (set b (fourstate 20 0)))
  (let v (payload (get y_ne)))
  (let m (xmask (get y_ne)))
  (assert (== v 1) "10 != 20 should be true")
  (assert (== m 0))
  ; The known bits agree: 0001010X != 00010100 is indeterminate.
  (modify (set a (fourstate 21 1)))
  (let m (xmask (get y_ne)))
  (assert (== m 1) "NE with X should yield X result"))

