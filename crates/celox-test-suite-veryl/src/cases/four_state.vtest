  ; Both defined: 20 > 10 → 1
  (modify
    (set a (fourstate 20 0))
    (set b (fourstate 10 0)))
  (let v (payload (get y_gt)))
  (let m (xmask (get y_gt)))
  (assert (== v 1) "20 > 10 should be true")
  (assert (== m 0))
  ; One has X → result X
  (modify (set b (fourstate 0 1)))
