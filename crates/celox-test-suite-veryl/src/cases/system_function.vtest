(group system_function (category functions))

(case test_direct_comb_onehot_system_function
  (source "test.veryl" #"
module Top (
    d: input logic<8>,
    q: output logic,
) {
    always_comb {
        q = $onehot(d);
    }
}
"#)
  (top Top)
  (for value (range 0 256)
    (let value (trunc 8 value))
    (modify (set d value))
    (assert_eq (trunc 8 (get q)) (== (popcount value) 1) "value={value:#010b}")))

(case test_comb_function_body_onehot_system_function
  (source "test.veryl" #"
module Top (
    d: input logic<8>,
    q: output logic,
) {
    function is_onehot (
        x: input logic<8>,
    ) -> logic {
        return $onehot(x);
    }

    always_comb {
        q = is_onehot(d);
    }
}
"#)
  (top Top)
  (for value (range 0 256)
    (let value (trunc 8 value))
    (modify (set d value))
    (assert_eq (trunc 8 (get q)) (== (popcount value) 1) "value={value:#010b}")))

(case test_direct_comb_bits_system_function
  (source "test.veryl" #"
module Top (
    d: input logic<8>,
    q: output logic<32>,
) {
    always_comb {
        q = $bits(d);
    }
}
"#)
  (top Top)
  (assert_eq (trunc 32 (get q)) 8))

(case test_direct_comb_size_system_function
  (source "test.veryl" #"
module Top (
    d: input logic<8>[4],
    q: output logic<32>,
    second: output logic<32>,
) {
    always_comb {
        q = $size(d);
        second = $size(d, 2);
    }
}
"#)
  (top Top)
  (assert_eq (trunc 32 (get q)) 4)
  (assert_eq (trunc 32 (get second)) 8))

(case test_direct_comb_clog2_system_function
  (source "test.veryl" #"
module Top (
    d: input logic<8>,
    q: output logic<32>,
) {
    always_comb {
        q = $clog2(d);
    }
}
"#)
  (top Top)
  (for value (range 0 256)
    (let value (trunc 8 value))
    (modify (set d value))
    (let expected (? (== value 0) 0 (- 32 (- 32 (bitlen (trunc 32 (- value 1)))))))
    (assert_eq (trunc 32 (get q)) expected "value={value}")))

(case test_comb_function_body_clog2_system_function
  (source "test.veryl" #"
module Top (
    d: input logic<8>,
    q: output logic<32>,
) {
    function clog2_value (
        x: input logic<8>,
    ) -> logic<32> {
        return $clog2(x);
    }

    always_comb {
        q = clog2_value(d);
    }
}
"#)
  (top Top)
  (for value (range 0 256)
    (let value (trunc 8 value))
    (modify (set d value))
    (let expected (? (== value 0) 0 (- 32 (- 32 (bitlen (trunc 32 (- value 1)))))))
    (assert_eq (trunc 32 (get q)) expected "value={value}")))

(case test_comb_function_body_bits_size_system_functions
  (source "test.veryl" #"
module Top (
    d: input logic<8>[4],
    bits_q: output logic<32>,
    size_q: output logic<32>,
) {
    function bits_value (
        x: input logic<8>[4],
    ) -> logic<32> {
        return $bits(x);
    }

    function size_value (
        x: input logic<8>[4],
    ) -> logic<32> {
        return $size(x);
    }

    always_comb {
        bits_q = bits_value(d);
        size_q = size_value(d);
    }
}
"#)
  (top Top)
  (assert_eq (trunc 32 (get bits_q)) 32)
  (assert_eq (trunc 32 (get size_q)) 4))

(case test_direct_comb_signed_system_function_sign_extends_to_context
  (source "test.veryl" #"
module Top (
    d: input logic<8>,
    q: output logic<16>,
) {
    always_comb {
        q = $signed(d);
    }
}
"#)
  (top Top)
  (modify (set d 0x80))
  (assert_eq (trunc 16 (get q)) 0xff80))

(case test_direct_comb_unsigned_system_function_zero_extends_to_context
  (source "test.veryl" #"
module Top (
    d: input logic<8>,
    q: output logic<16>,
) {
    always_comb {
        q = $unsigned(d);
    }
}
"#)
  (top Top)
  (modify (set d 0x80))
  (assert_eq (trunc 16 (get q)) 0x0080))

(case test_direct_comb_signed_unsigned_system_functions_affect_comparison
  (source "test.veryl" #"
module Top (
    d: input logic<8>,
    z: input logic<8>,
    signed_lt: output logic,
    unsigned_lt: output logic,
) {
    always_comb {
        signed_lt = $signed(d) <: (z as i8);
        unsigned_lt = $unsigned(d) <: (z as i8);
    }
}
"#)
  (top Top)
  (modify
    (set d 0xff)
    (set z 0x01))
  (assert_eq (trunc 8 (get signed_lt)) 1)
  (assert_eq (trunc 8 (get unsigned_lt)) 0))

(case test_comb_function_body_signed_unsigned_system_functions
  (source "test.veryl" #"
module Top (
    d: input logic<8>,
    signed_q: output logic<16>,
    unsigned_q: output logic<16>,
) {
    function signed_value (
        x: input logic<8>,
    ) -> logic<16> {
        return $signed(x);
    }

    function unsigned_value (
        x: input logic<8>,
    ) -> logic<16> {
        return $unsigned(x);
    }

    always_comb {
        signed_q = signed_value(d);
        unsigned_q = unsigned_value(d);
    }
}
"#)
  (top Top)
  (modify (set d 0x80))
  (assert_eq (trunc 16 (get signed_q)) 0xff80)
  (assert_eq (trunc 16 (get unsigned_q)) 0x0080))

(case test_direct_comb_bits_type_system_function
  (source "test.veryl" #"
module Top (
    q: output logic<32>,
) {
    always_comb {
        q = $bits(logic<8>);
    }
}
"#)
  (top Top)
  (assert_eq (trunc 32 (get q)) 8))

(case test_direct_ff_bits_system_function
  (source "test.veryl" #"
module Top (
    clk: input clock,
    d: input logic<8>,
    q: output logic<32>,
) {
    always_ff (clk) {
        q = $bits(d);
    }
}
"#)
  (top Top)
  (tick clk)
  (assert_eq (trunc 32 (get q)) 8))

(case test_direct_ff_bits_type_system_function
  (source "test.veryl" #"
module Top (
    clk: input clock,
    q: output logic<32>,
) {
    always_ff (clk) {
        q = $bits(logic<8>);
    }
}
"#)
  (top Top)
  (tick clk)
  (assert_eq (trunc 32 (get q)) 8))

