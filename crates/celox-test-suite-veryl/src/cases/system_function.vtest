  (assert_eq (trunc 32 (get q)) 8))

(case test_direct_ff_size_packed_multidimensional_system_function
  (source "test.veryl" #"
module Top (
    clk: input clock,
    d: input logic<10, 20>,
    q: output logic<32>,
    second: output logic<32>,
) {
    const SECOND_DIM: u32 = 2;

    always_ff (clk) {
        q = $size(d);
        second = $size(d, SECOND_DIM);
    }
}
"#)
  (top Top)
  (tick clk)
  (assert_eq (trunc 32 (get q)) 10)
  (assert_eq (trunc 32 (get second)) 20))

(case test_direct_ff_size_packed_multidimensional_type_system_function
  (source "test.veryl" #"
module Top (
    clk: input clock,
    q: output logic<32>,
    second: output logic<32>,
) {
    always_ff (clk) {
        q = $size(logic<10, 20>);
        second = $size(logic<10, 20>, 2);
    }
}
"#)
  (top Top)
  (tick clk)
  (assert_eq (trunc 32 (get q)) 10)
  (assert_eq (trunc 32 (get second)) 20))

