(group self_determination (category types))

(case test_concatenation_self_determination
  (source "test.veryl" #"
module Top (
a: input  logic<8>,
b: input  logic<8>,
o: output logic<16>
) {
// Addition inside {} should be self-determined (8-bit).
// 8'hff + 8'h1 = 8'h00 (overflow truncated)
// {8'h00} is then zero-extended to 16-bit -> 16'h0000
assign o = {a + b};
}
"#)
  (top Top)
  (modify
    (set a 0xFF)
    (set b 0x01))
  (assert_eq o 0 "Concatenation failed to isolate addition width (self-determination)"))

(case test_comparison_self_determination
  (source "test.veryl" #"
module Top (
a: input  logic<8>,
b: input  logic<8>,
c: input  logic<16>,
o: output logic<16>
) {
assign o = (a <: b) + c;
}
"#)
  (top Top)
  (modify
    (set a 10)
    (set b 20)
    (set c 1))
  ; true(1) + 1 = 2
  (assert_eq o 2))

(case test_shift_rhs_self_determination
  (source "test.veryl" #"
module Top (
a: input  logic<16>,
b: input  logic<8>,
c: input  logic<8>,
o: output logic<16>
) {
// b + c should be evaluated at 8-bit.
// 8'hff + 8'h1 = 8'h00.
// 16'h1 << 0 = 16'h1.
assign o = a << (b + c);
}
"#)
  (top Top)
  (modify
    (set a 1)
    (set b 0xFF)
    (set c 0x01))
  (assert_eq o 1 "Shift RHS failed to isolate addition width (self-determination)"))

(case test_shift_rhs_constant_self_determination
  (source "test.veryl" #"
module Top (
o: output logic<16>
) {
// 8'hff + 8'h1 = 8'h00.
// 16'h1 << 0 = 16'h1.
assign o = 16'h1 << (8'hff + 8'h1);
}
"#)
  (top Top)
  (assert_eq o 1 "Constant shift RHS failed self-determination boundary"))

(case test_concatenation_constant_self_determination
  (source "test.veryl" #"
        module Top (
            o: output logic<16>,
            o2: output logic<16>,
            o3: output logic<16>,
        ) {
            // 8'hff + 8'h1 = 8'h00 (self-determined)
            assign o = {8'hff + 8'h1};
            assign o2 = 8'hff + 8'h1;
            assign o3 = {8'hf0, 8'hff + 8'h1};
        }
    "#)
  (top Top)
  (assert_eq o 0 "Concatenation should be self-determined")
  (assert_eq o2 256 "Normal addition should not be self-determined")
  (assert_eq o3 0xf000 "Concatenation should be self-determined"))

(case test_concatenation_constant_self_determination_runtime
  (source "test.veryl" #"
        module Top (
            i: input logic<8>,
            o: output logic<16>
        ) {
            // 8'hff + 8'h1 = 8'h00 (self-determined)
            assign o = {8'hff + i};
        }
    "#)
  (top Top)
  (modify (set i 0x1))
  (assert_eq o 0 "Constant concatenation failed to isolate addition width"))
