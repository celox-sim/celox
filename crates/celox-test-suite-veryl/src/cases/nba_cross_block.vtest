(group nba_cross_block (category sequential))

(case test_nba_separate_blocks_swap
  (source "test.veryl" #"
module Top (clk: input clock, rst: input reset, a: output logic<8>, b: output logic<8>) {
var r1: logic<8>;
var r2: logic<8>;
// Block 1: r1 <= r2 (reads OLD r2)
always_ff (clk, rst) {
if_reset {
r1 = 8'hAA;
} else {
r1 = r2;
}
}
// Block 2: r2 <= r1 (reads OLD r1)
always_ff (clk, rst) {
if_reset {
r2 = 8'h55;
} else {
r2 = r1;
}
}
assign a = r1;
assign b = r2;
}
"#)
  (top Top)
  ; Reset
  (modify (set rst 0))
  (tick clk)
  (assert_eq a 0xAA "r1 should be 0xAA after reset")
  (assert_eq b 0x55 "r2 should be 0x55 after reset")
  ; Deactivate reset and tick once — should swap
  (modify (set rst 1))
  (tick clk)
  (assert_eq a 0x55 "r1 should be 0x55 (old r2) after swap")
  (assert_eq b 0xAA "r2 should be 0xAA (old r1) after swap")
  ; Tick again — should swap back
  (tick clk)
  (assert_eq a 0xAA "r1 should be 0xAA after 2nd swap")
  (assert_eq b 0x55 "r2 should be 0x55 after 2nd swap"))

(case test_nba_separate_blocks_pipeline
  (source "test.veryl" #"
module Top (clk: input clock, d: input logic<8>, q: output logic<8>) {
var stage1: logic<8>;
var stage2: logic<8>;
always_ff (clk) { stage1 = d; }
always_ff (clk) { stage2 = stage1; }
always_ff (clk) { q = stage2; }
}
"#)
  (top Top)
  (modify (set d 0x42))
  ; Tick 1: stage1=0x42, stage2=0, q=0
  (tick clk)
  (assert_eq q 0x0 "q should be 0 after 1st tick")
  ; Tick 2: stage1=0x42, stage2=0x42, q=0
  (tick clk)
  (assert_eq q 0x0 "q should be 0 after 2nd tick")
  ; Tick 3: q=0x42
  (tick clk)
  (assert_eq q 0x42 "q should be 0x42 after 3rd tick"))

(case test_nba_separate_blocks_pipeline_reversed
  (source "test.veryl" #"
module Top (clk: input clock, d: input logic<8>, q: output logic<8>) {
var stage1: logic<8>;
var stage2: logic<8>;
// Intentionally reversed order in source
always_ff (clk) { q = stage2; }
always_ff (clk) { stage2 = stage1; }
always_ff (clk) { stage1 = d; }
}
"#)
  (top Top)
  (modify (set d 0x42))
  ; Tick 1: stage1=0x42, stage2=0, q=0
  (tick clk)
  (assert_eq q 0x0 "q should be 0 after 1st tick")
  ; Tick 2: stage1=0x42, stage2=0x42, q=0
  (tick clk)
  (assert_eq q 0x0 "q should be 0 after 2nd tick")
  ; Tick 3: q=0x42
  (tick clk)
  (assert_eq q 0x42 "q should be 0x42 after 3rd tick"))
