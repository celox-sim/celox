(case test_ff_function_call_tracks_array_view_hidden_in_bound_literal
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            guard: input logic,
            out_q: output logic<8>,
