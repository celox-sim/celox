(case test_ff_nonlocal_source_ternary_preserves_unknown_merge
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (four_state)
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            select: input logic,
            global_value: output logic<8>
        ) {
            function write_selected (select: input logic) {
                global_value = if select ? 8'hf0 : 8'h0f;
            }

            always_ff (clk) {
                write_selected(select);
            }
        }
    "#)
  (top Top)
  (modify (set select (fourstate 0 1)))
  (tick clk)
  (assert_eq global_value (fourstate 0xff 0xff)))

(case test_ff_function_output_index_uses_final_nonlocal_state
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            index: output logic,
            entries: output logic<8>[2]
        ) {
            function set (written: output logic<8>) {
                index = 1'b1;
                written = 8'ha5;
            }

            always_ff (clk) {
                set(entries[index]);
            }
        }
    "#)
  (top Top)
  (tick clk)
  (assert_eq index 1)
  (assert_eq entries 0xa500))

(case test_ff_short_circuit_runtime_write_preserves_later_state_source
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (tags deferred_function_effects)
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            gate: input logic,
            d: input logic<8>,
            state: output logic<8>,
            q: output logic<8>
        ) {
            var ignored: logic;

            function write_state (x: input logic<8>) -> logic {
                state = x;
                return 1'b1;
            }

            always_ff (clk) {
                ignored = gate && write_state(d);
                q = state;
            }
        }
    "#)
  (top Top)
  (modify
    (set gate 1)
    (set d 0x5a))
  (tick clk)
  (assert_eq state 0x5a)
  (assert_eq q 0)
  (modify
    (set gate 0)
    (set d 0xa5))
  (tick clk)
  (assert_eq state 0x5a)
  (assert_eq q 0x5a))

(case test_ff_bits_and_size_operands_do_not_alias_earlier_array_argument
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            q: output logic<8>
        ) {
            var samples: logic<8>[2];

            function update (
                x: input logic<8>,
                written: output logic<8>
            ) -> logic<8> {
                written = x + 8'd1;
                return x;
            }

            function pick (
                values: input logic<8>[2],
                shape: input logic<32>
            ) -> logic<8> {
                return values[0] + shape[0];
            }

            always_ff (clk) {
                samples = '{8'h12, 8'h34};
                q = pick(
                    samples,
                    $bits(update(samples[0], samples[0]))
                        + $size(update(samples[0], samples[0]))
                );
            }
        }
    "#)
  (top Top)
  (tick clk)
  (assert_eq q 0)
  (tick clk)
  (assert_eq q 0x12))

(case test_ff_bits_and_size_array_dependencies_do_not_alias_later_write
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            q: output logic<32>
        ) {
            var samples: logic<8>[2];

            function set_sample (written: output logic<8>) -> logic<32> {
                written = 8'h5a;
                return 0;
            }

            function pick (
                values: input logic<32>[2],
                ignored: input logic<32>
            ) -> logic<32> {
                return values[0];
            }

            always_ff (clk) {
                q = pick(
                    '{$bits(samples), default: 0},
                    set_sample(samples[0])
                );
            }
        }
    "#)
  (top Top)
  (tick clk)
  (assert_eq q 16))

(case test_ff_pure_input_is_snapshotted_before_later_effectful_input
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (tags evaluation_order deferred_function_effects)
  (source "test.veryl" #"
        module Top (clk: input clock, effect: output logic<8>, q: output logic<8>) {
            function update (
                x: input logic<8>,
                written: output logic<8>
            ) -> logic<8> {
                written = x + 8'd1;
                return x + 8'd1;
            }

            function combine (
                first: input logic<8>,
                second: input logic<8>
            ) -> logic<8> {
                return first;
            }

            always_ff (clk) {
                q = combine(effect, update(effect, effect));
            }
        }
    "#)
  (top Top)
  (modify (set effect 5))
  (tick clk)
  (assert_eq effect 6)
  (assert_eq q 5))

(case test_ff_effectful_array_item_output_is_not_a_read_alias
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            effect: output logic<8>,
            q: output logic<8>
        ) {
            function make (written: output logic<8>) -> logic<8> {
                written = 8'h5a;
                return 8'h11;
            }

            function pick (
                values: input logic<8>[1],
                written: output logic<8>
            ) -> logic<8> {
                written = 8'ha5;
                return values[0];
            }

            always_ff (clk) {
                q = pick('{make(effect)}, effect);
            }
        }
    "#)
  (top Top)
  (tick clk)
  (assert_eq effect 0xa5)
  (assert_eq q 0x11))

(case test_ff_runtime_for_bounds
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            count: input logic<8>,
            step_start: input logic<32>,
            q_fwd: output logic<8>,
            q_rev: output logic<8>,
            q_inc: output logic<8>,
            q_step: output logic<8>
        ) {
            always_ff (clk) {
                q_fwd = 8'hee;
                for i in 0..count {
                    q_fwd = i as 8;
                }

                q_rev = 8'hee;
                for i in rev 0..count {
                    q_rev = i as 8;
                }

                q_inc = 8'hee;
                for i in 0..=count {
                    q_inc = i as 8;
                }

                q_step = 8'hee;
                for i in step_start..(count + 4) step *= 2 {
                    q_step = i as 8;
                }
            }
        }
    "#)
  (top Top)
  (modify
    (set count 4)
    (set step_start 1))
  (tick clk)
  (assert_eq q_fwd 3)
  (assert_eq q_rev 0)
  (assert_eq q_inc 4)
  (assert_eq q_step 4)
  (modify (set count 5))
  (tick clk)
  (assert_eq q_fwd 4)
  (assert_eq q_rev 0)
  (assert_eq q_inc 5)
  (assert_eq q_step 8))

(case test_ff_runtime_for_bitwise_steps
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            or_end: input logic<8>,
            xor_end: input logic<8>,
            q_or: output logic<8>,
            q_xor: output logic<8>
        ) {
            always_ff (clk) {
                q_or = 0;
                for i in 3..=or_end step |= 6 {
                    q_or = i as 8;
                    if i == or_end {
                        break;
                    }
                }

                q_xor = 0;
                for i in 3..=xor_end step ^= 6 {
                    q_xor = i as 8;
                    if i == xor_end {
                        break;
                    }
                }
            }
        }
    "#)
  (top Top)
  (modify
    (set or_end 7)
    (set xor_end 5))
  (tick clk)
  (assert_eq q_or 7)
  (assert_eq q_xor 5))

(case test_ff_signed_xor_step_uses_loop_counter_width
  ; The Veryl simulator currently converts the signed dynamic start bound to an
  ; unsigned runtime counter and executes zero iterations.
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            wide_start: input signed logic<32>,
            wide_end: input signed logic<128>,
            q: output signed logic<32>
        ) {
            always_ff (clk) {
                q = 0;
                for i in wide_start..=wide_end step ^= 2147483648 {
                    q = i;
                    if i == 2147483640 {
                        break;
                    }
                }
            }
        }
    "#)
  (top Top)
  (modify
    (set wide_start (trunc 32 -8))
    (set wide_end 2147483640))
  (tick clk)
  (assert_eq q 0x7ffffff8))

(case test_ff_i32_bitwise_steps_discard_bits_above_the_counter_width
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            start: input signed logic<32>,
            or_end: input signed logic<128>,
            xor_end: input signed logic<128>,
            q_or: output signed logic<32>,
            q_xor: output signed logic<32>
        ) {
            always_ff (clk) {
                q_or = 0;
                for i in start..=or_end step |= 4294967302 {
                    q_or = i;
                    if i == 7 {
                        break;
                    }
                }

                q_xor = 0;
                for i in start..=xor_end step ^= 4294967302 {
                    q_xor = i;
                    if i == 5 {
                        break;
                    }
                }
            }
        }
    "#)
  (top Top)
  (modify
    (set start (trunc 32 3))
    (set or_end 7)
    (set xor_end 5))
  (tick clk)
  (assert_eq q_or 7)
  (assert_eq q_xor 5))

(case test_ff_runtime_for_break
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            count: input logic<8>,
            q: output logic<8>
        ) {
            always_ff (clk) {
                q = 8'hee;
                for i in 0..count {
                    if i == 3 {
                        break;
                    }
                    q = i as 8;
                }
            }
        }
    "#)
  (top Top)
  (modify (set count 8))
  (tick clk)
  (assert_eq q 2))

(case test_ff_constant_signed_bounds_in_unrolled_loops
  ; Constant signed reverse bounds are currently broken in the upstream
  ; Veryl analyzer unroller, so this regression is parked until upstream
  ; Veryl is fixed.
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            q_fwd: output logic<32>,
            q_rev_last: output logic<32>
        ) {
            always_ff (clk) {
                q_fwd = 0;
                for i in (0 - 1)..=1 {
                    q_fwd += i as 32;
                }

                q_rev_last = 32'hdead_beef;
                for i in rev (0 - 1)..=1 {
                    q_rev_last = (i + 1) as 32;
                }
            }
        }
    "#)
  (top Top)
  (tick clk)
  (assert_eq q_fwd 0)
  (assert_eq q_rev_last 0))

(case test_ff_runtime_for_zero_iteration_mul_loop_is_allowed
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            q: output logic<8>
        ) {
            always_ff (clk) {
                q = 8'haa;
                for i in 0..0 step *= 2 {
                    q = i;
                }
            }
        }
    "#)
  (top Top)
  (tick clk)
  (assert_eq q 0xaa))

(case test_ff_runtime_reverse_step_matches_emitted_sv_order
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            start: input signed logic<64>,
            end_bound: input signed logic<64>,
            q: output logic<32>
        ) {
            always_ff (clk) {
                q = 0;
                for i in rev start..end_bound step += 2 {
                    q = i as 32;
                }
            }
        }
    "#)
  (top Top)
  (modify
    (set start 0)
    (set end_bound 10))
  (tick clk)
  ; The last iteration is i = 1 for the emitted 9,7,5,3,1 order.
  (assert_eq q 1))

(case test_ff_runtime_reverse_exclusive_i32_upper_sentinel
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            start: input signed logic<64>,
            end_bound: input signed logic<64>,
            q: output logic<32>
        ) {
            always_ff (clk) {
                q = 0;
                for i in rev start..end_bound {
                    q = i as 32;
                }
            }
        }
    "#)
  (top Top)
  (modify
    (set start 2147483640)
    (set end_bound 2147483648))
  (tick clk)
  (assert_eq q 2147483640))

(case test_ff_runtime_reverse_min_i32_end_wraps_before_range_check
  ; veryl-simulator 0.20.2's non-JIT interpreter evaluates `end - 1` as i64
  ; without truncating it to the signed 32-bit loop-counter width. It therefore
  ; gets -2147483649 instead of wrapping to i32::MAX and skips the loop body.
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            start: input signed logic<64>,
            end_bound: input signed logic<64>,
            q: output logic<32>
        ) {
            always_ff (clk) {
                q = 0;
                for i in rev start..end_bound {
                    q = i as 32;
                    break;
                }
            }
        }
    "#)
  (top Top)
  (modify
    (set start (trunc 64 -2147483648))
    (set end_bound (trunc 64 -2147483648)))
  (tick clk)
  (assert_eq q 0x7fffffff))

(case test_ff_runtime_for_reverse_singleton_exits_cleanly
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            start: input logic<8>,
            count: input logic<8>,
            q: output logic<8>
        ) {
            always_ff (clk) {
                q = 8'hee;
                for i in rev start..=count {
                    q = i as 8;
                }
            }
        }
    "#)
  (top Top)
  (modify
    (set start 4)
    (set count 4))
  (tick clk)
  (assert_eq q 4))

(case test_ff_runtime_for_signed_inclusive_range_preserves_negative_bounds
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            start: input signed logic<32>,
            count: input signed logic<32>,
            q_last: output logic<32>
        ) {
            always_ff (clk) {
                q_last = 32'hdead_beef;
                for i in start..=count {
                    q_last = i as 32;
                }
            }
        }
    "#)
  (top Top)
  (modify
    (set start 0xffffffff)
    (set count 1))
  (tick clk)
  (assert_eq q_last 1))

(case test_ff_runtime_for_forward_overshoot_exits_without_wraparound
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            start: input logic<8>,
            q_hits: output logic<8>,
            q_last: output logic<8>
        ) {
            always_ff (clk) {
                q_hits = 0;
                q_last = 8'hee;
                for i in start..255 step += 10 {
                    q_hits += 1;
                    q_last = i;
                }
            }
        }
    "#)
  (top Top)
  (modify (set start 250))
  (tick clk)
  (assert_eq q_hits 1)
  (assert_eq q_last 250))

(case test_ff_runtime_for_unsigned_slice_bound_zero_extends_signed_source
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            start: input signed logic<16>,
            q_last: output logic<8>
        ) {
            always_ff (clk) {
                q_last = 8'hee;
                for i in start[7:0]..=8'hff {
                    q_last = i as 8;
                }
            }
        }
    "#)
  (top Top)
  (modify (set start 0xffff))
  (tick clk)
  (assert_eq q_last 255))

(case test_ff_if_reset_basic
  (source "test.veryl" #"
        module Top (clk: input clock, rst: input reset, d: input logic<8>, q: output logic<8>) {
            always_ff (clk, rst) {
                if_reset {
                    q = 0;
                } else {
                    q = d;
                }
            }
        }
    "#)
  (top Top)
  ; Reset (AsyncLow: active when rst=0)
  (modify
    (set rst 0)
    (set d 0xAA))
  (tick clk)
  (assert_eq q 0x0)
  ; Normal operation (deactivate reset)
  (modify (set rst 1))
  (tick clk)
  (assert_eq q 0xAA))

(case test_async_reset
  (source "test.veryl" #"
        module Top (clk: input clock, rst: input reset_async_high, d: input logic<8>, q: output logic<8>) {
            always_ff (clk, rst) {
                if_reset {
                    q = 8'h55;
                } else {
                    q = d;
                }
            }
        }
    "#)
  (top Top)
  ; Async reset trigger
  (modify (set rst 1))
  (tick rst)
  (assert_eq q 0x55)
  ; Stay reset even if d changes
  (modify (set d 0xFF))
  (assert_eq q 0x55)
  ; Release reset (should stay 0x55 because no clock or active reset edge)
  (modify (set rst 0))
  (assert_eq q 0x55))

(case test_ff_swap_correctness
  (source "test.veryl" #"
        module Top (clk: input clock, rst: input reset, a: output logic<8>, b: output logic<8>) {
            var r1: logic<8>;
            var r2: logic<8>;
            always_ff (clk, rst) {
                if_reset {
                    r1 = 8'hAA;
                    r2 = 8'h55;
                } else {
                    r1 = r2;
                    r2 = r1;
                }
            }
            assign a = r1;
            assign b = r2;
        }
    "#)
  (top Top)
  ; Reset to initialize (AsyncLow: active when rst=0)
  (modify (set rst 0))
  (tick clk)
  (assert_eq a 0xAA)
  (assert_eq b 0x55)
  ; Tick to swap (deactivate reset)
  (modify (set rst 1))
  (tick clk)
  (assert_eq a 0x55)
  (assert_eq b 0xAA))

(case test_multiple_clocks
  (source "test.veryl" #"
        module Top (clk1: input 'a clock, clk2: input 'b clock, d1: input 'a logic<8>, d2: input 'b logic<8>, q1: output 'a logic<8>, q2: output 'b logic<8>) {
            always_ff (clk1) { q1 = d1; }
            always_ff (clk2) { q2 = d2; }
        }
    "#)
  (top Top)
  (modify
    (set d1 0x11)
    (set d2 0x22))
  (tick clk1)
  (assert_eq q1 0x11)
  (assert_eq q2 0x0)
  (tick clk2)
  (assert_eq q2 0x22))

(case test_hierarchical_clocks
  (source "test.veryl" #"
        module Sub (clk: input clock, d: input logic<8>, q: output logic<8>) {
            always_ff (clk) { q = d; }
        }
        module Top (clk: input clock, d: input logic<8>, q: output logic<8>) {
            inst s: Sub (clk, d, q);
        }
    "#)
  (top Top)
  (modify (set d 0xFE))
  (tick clk)
  (assert_eq q 0xFE))

(case test_multiple_async_resets
  (source "test.veryl" #"
        module Top (clk: input clock, rst1: input reset_async_high, rst2: input reset_async_high, d: input logic<8>, q: output logic<8>) {
            var r1: logic<8>;
            var r2: logic<8>;

            always_ff (clk, rst1) {
                if_reset {
                    r1 = 8'h0A;
                } else {
                    r1 = d;
                }
            }
            always_ff (clk, rst2) {
                if_reset {
                    r2 = 8'h0B;
                } else {
                    r2 = d;
                }
            }
            assign q = r1 | r2; // dummy use
        }
    "#)
  (top Top)
  (modify (set rst2 1))
  (tick rst2)
  (assert_eq r2 0x0B)
  (modify (set rst1 1))
  (tick rst1)
  (assert_eq r1 0x0A))

(case test_ff_if_reset_multi_cycle
  (source "test.veryl" #"
        module Top (clk: input clock, rst: input reset, q: output logic<8>) {
            always_ff (clk, rst) {
                if_reset {
                    q = 0;
                } else {
                    q = q + 1;
                }
            }
        }
    "#)
  (top Top)
  ; Deactivate reset first (AsyncLow: rst=1 means inactive)
  (modify (set rst 1))
  (tick clk)
  (assert_eq q 1)
  (tick clk)
  (assert_eq q 2)
  ; Activate reset (AsyncLow: rst=0 means active)
  (modify (set rst 0))
  (tick clk)
  (assert_eq q 0))

(case test_ff_if_reset_with_nested_if
  (source "test.veryl" #"
        module Top (clk: input clock, rst: input reset, en: input logic, q: output logic<8>) {
            always_ff (clk, rst) {
                if_reset {
                    q = 0;
                } else {
                    if en {
                        q = q + 1;
                    }
                }
            }
        }
    "#)
  (top Top)
  ; Deactivate reset (AsyncLow: rst=1 means inactive)
  (modify
    (set rst 1)
    (set en 1))
  (tick clk)
  (assert_eq q 1)
  (modify (set en 0))
  (tick clk)
  (assert_eq q 1))

(case test_ff_struct_constructor_expression
  (source "test.veryl" #"
        module Top (clk: input clock, in_a: input logic<8>, in_b: input logic<8>, out_a: output logic<8>, out_b: output logic<8>) {
            struct S {
                a: logic<8>,
                b: logic<8>,
            }
            var r: S;
            always_ff (clk) {
                r.a = in_a;
                r.b = in_b;
            }
            assign out_a = r.a;
            assign out_b = r.b;
        }
    "#)
  (top Top)
  (modify
    (set in_a 0x12)
    (set in_b 0x34))
  (tick clk)
  (assert_eq out_a 0x12)
  (assert_eq out_b 0x34))

(case test_ff_struct_constructor_expression_literal_order
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            in_a: input logic<8>,
            in_b: input logic<8>,
            out_a: output logic<8>,
            out_b: output logic<8>
        ) {
            struct S {
                a: logic<8>,
                b: logic<8>,
            }
            var r: S;
            always_ff (clk) {
                r = S'{a: in_a, b: in_b};
            }
            assign out_a = r.a;
            assign out_b = r.b;
        }
    "#)
  (top Top)
  (modify
    (set in_a 0x12)
    (set in_b 0x34))
  (tick clk)
  (assert_eq out_a 0x12)
  (assert_eq out_b 0x34))

(case test_ff_struct_constructor_signed_member_extension
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            in_neg: input i8,
            out_pad: output i16
        ) {
            struct S {
                x: i16,
            }
            var r: S;
            always_ff (clk) {
                r = S'{x: in_neg};
            }
            assign out_pad = r.x;
        }
    "#)
  (top Top)
  (modify (set in_neg 0xFF))
  (tick clk)
  (assert_eq out_pad 0xFFFF))

(case test_ff_array_literal_expression_order
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            o0: output logic<8>,
            o1: output logic<8>
        ) {
            var r: logic<8>[2];
            always_ff (clk) {
                r = '{8'h12, 8'h34};
            }
            assign o0 = r[0];
            assign o1 = r[1];
        }
    "#)
  (top Top)
  (tick clk)
  (assert_eq o0 0x12)
  (assert_eq o1 0x34))

(case test_ff_array_literal_default_expression
  (source "test.veryl" #"
        module Top (clk: input clock, in_data: input logic<8>, out_data: output logic<8>[4]) {
            var r: logic<8>[4];
            always_ff (clk) {
                r = '{default: in_data};
            }
            assign out_data = r;
        }
    "#)
  (top Top)
  (modify (set in_data 0x55))
  (tick clk)
  (let q_val (get out_data))
  (for i (range 0 4)
    (let bit_val (& (>> q_val (* i 8)) 0xFF))
    (assert (== bit_val 0x55))))

(case test_ff_array_literal_nested_default_multidim_expression
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            in_data: input logic<8>,
            o00: output logic<8>,
            o01: output logic<8>,
            o10: output logic<8>,
            o11: output logic<8>
        ) {
            var r: logic<8> [2, 2];
            always_ff (clk) {
                r = '{default: '{default: in_data}};
            }
            assign o00 = r[0][0];
            assign o01 = r[0][1];
            assign o10 = r[1][0];
            assign o11 = r[1][1];
        }
    "#)
  (top Top)
  (modify (set in_data 0xAA))
  (tick clk)
  (assert_eq o00 0xAA))

(case test_ff_function_call_expression
  (source "test.veryl" #"
        module Top (clk: input clock, in_a: input logic<8>, out_q: output logic<8>) {
            function f (x: input logic<8>) -> logic<8> {
                return x + 1;
            }
            always_ff (clk) {
                out_q = f(in_a);
            }
        }
    "#)
  (top Top)
  (modify (set in_a 10))
  (tick clk)
  (assert_eq out_q 11))

(case test_ff_function_call_statement_with_output_argument
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (tags deferred_function_effects)
  (source "test.veryl" #"
        module Top (clk: input clock, in_a: input logic<8>, out_q: output logic<8>) {
            function f (x: input logic<8>, y: output logic<8>) {
                y = x + 2;
            }
            var tmp: logic<8>;
            always_ff (clk) {
                f(in_a, tmp);
                out_q = tmp;
            }
        }
    "#)
  (top Top)
  (modify (set in_a 10))
  (tick clk)
  ; 1st tick: tmp becomes (10+2)=12, out_q reads OLD tmp (0)
  (assert_eq out_q 0)
  (tick clk)
  ; 2nd tick: out_q reads 12
  (assert_eq out_q 12))

(case test_ff_function_call_statement_with_output_argument_and_return_value
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (tags deferred_function_effects)
  (source "test.veryl" #"
        module Top (clk: input clock, in_a: input logic<8>, out_q1: output logic<8>, out_q2: output logic<8>) {
            function f (x: input logic<8>, y: output logic<8>) -> logic<8> {
                y = x + 3;
                return x + 4;
            }
            var tmp: logic<8>;
            always_ff (clk) {
                out_q1 = f(in_a, tmp);
                out_q2 = tmp;
            }
        }
    "#)
  (top Top)
  (modify (set in_a 100))
  (tick clk)
  ; After 1st tick: out_q1=104, tmp=103, out_q2=0 (old tmp)
  (assert_eq out_q1 104)
  (assert_eq out_q2 0)
  (tick clk)
  (assert_eq out_q2 103))

(case test_ff_function_call_expression_with_output_argument_and_return_value
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (tags deferred_function_effects)
  (source "test.veryl" #"
        module Top (clk: input clock, in_a: input logic<8>, out_q1: output logic<8>, out_q2: output logic<8>) {
            function f (x: input logic<8>, y: output logic<8>) -> logic<8> {
                y = x + 5;
                return x + 6;
            }
            var tmp: logic<8>;
            always_ff (clk) {
                out_q1 = f(in_a, tmp) + 1;
                out_q2 = tmp + 1;
            }
        }
    "#)
  (top Top)
  (modify (set in_a 50))
  (tick clk)
  ; 1st tick: out_q1 = (50+6)+1 = 57, out_q2 = 0+1 = 1
  (assert_eq out_q1 57)
  (assert_eq out_q2 1)
  (tick clk)
  ; 2nd tick: out_q2 = (50+5)+1 = 56
  (assert_eq out_q2 56))

(case test_ff_function_call_expression_with_if
  (source "test.veryl" #"
        module Top (clk: input clock, in_a: input logic<8>, sel: input logic, out_q: output logic<8>) {
            function f (x: input logic<8>) -> logic<8> {
                return x + 1;
            }
            always_ff (clk) {
                if sel {
                    out_q = f(in_a);
                } else {
                    out_q = 0;
                }
            }
        }
    "#)
  (top Top)
  (modify
    (set in_a 20)
    (set sel 1))
  (tick clk)
  (assert_eq out_q 21)
  (modify (set sel 0))
  (tick clk)
  (assert_eq out_q 0))

(case test_ff_nested_function_call_expression
  (source "test.veryl" #"
        module Top (clk: input clock, in_a: input logic<8>, out_q: output logic<8>) {
            function f (x: input logic<8>) -> logic<8> {
                return x + 1;
            }
            function g (x: input logic<8>) -> logic<8> {
                return f(x) * 2;
            }
            always_ff (clk) {
                out_q = g(in_a);
            }
        }
    "#)
  (top Top)
  (modify (set in_a 5))
  (tick clk)
  ; (5+1)*2 = 12
  (assert_eq out_q 12))

(case test_ff_function_call_multistatement_body
  (source "test.veryl" #"
        module Top (clk: input clock, in_a: input logic<8>, out_q: output logic<8>) {
            function f (x: input logic<8>) -> logic<8> {
                var tmp: logic<8>;
                tmp = x + 1;
                tmp = tmp * 2;
                return tmp;
            }
            always_ff (clk) {
                out_q = f(in_a);
            }
        }
    "#)
  (top Top)
  (modify (set in_a 3))
  (tick clk)
  ; (3+1)*2 = 8
  (assert_eq out_q 8))

(case test_ff_function_call_indexed_argument_access
  (source "test.veryl" #"
        module Top (clk: input clock, in_a: input logic<8>[4], out_q: output logic<8>) {
            function f (x: input logic<8>[4]) -> logic<8> {
                return x[2];
            }
            always_ff (clk) {
                out_q = f(in_a);
            }
        }
    "#)
  (top Top)
  (modify
    (let val 0)
    (set! val (| val (<< 0xBE 16)))
    (set in_a val))
  (tick clk)
  (assert_eq out_q 0xBE))

(case test_ff_function_call_nested_output_statement_in_function_body
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (source "test.veryl" #"
        module Top (clk: input clock, in_a: input logic<8>, out_q: output logic<8>) {
            function f (x: input logic<8>, y: output logic<8>) {
                y = x + 1;
            }
            function g (x: input logic<8>, y: output logic<8>) {
                f(x, y);
            }
            var tmp: logic<8>;
            always_ff (clk) {
                g(in_a, tmp);
                out_q = tmp;
            }
        }
    "#)
  (top Top)
  (modify (set in_a 7))
  (tick clk)
  (assert_eq out_q 0)
  (tick clk)
  (assert_eq out_q 8))

(case test_ff_function_call_indexed_nonvariable_argument_expression
  (source "test.veryl" #"
        module Top (clk: input clock, in_a: input logic<4>, out_q: output logic) {
            function f (x: input logic<4>) -> logic {
                return x[1];
            }
            always_ff (clk) {
                out_q = f(in_a + 4'b0001);
            }
        }
    "#)
  (top Top)
  (modify (set in_a 0b0010))
  (tick clk)
  (assert_eq out_q 1)
  (modify (set in_a 0b0101))
  (tick clk)
  (assert_eq out_q 1))

(case test_ff_function_call_chained_range_access_on_argument
  (source "test.veryl" #"
        module Top (clk: input clock, in_a: input logic<8>, out_q: output logic<4>) {
            function f (x: input logic<8>) -> logic<4> {
                return x[5:2];
            }
            always_ff (clk) {
                out_q = f(in_a[7:0]);
            }
        }
    "#)
  (top Top)
  (modify (set in_a 0b11010110))
  (tick clk)
  (assert_eq out_q 0b0101))

(case test_ff_function_call_step_access_on_nonvariable_argument
  (source "test.veryl" #"
        module Top (clk: input clock, in_a: input logic<8>, out_q: output logic<4>) {
            function f (x: input logic<8>) -> logic<4> {
                return x[1 step 4];
            }
            always_ff (clk) {
                out_q = f(in_a + 8'b0000_0001);
            }
        }
    "#)
  (top Top)
  (modify (set in_a 0b10100100))
  (tick clk)
  (assert_eq out_q 0b1010))

(case test_ff_function_call_nonvariable_argument_uses_formal_width_before_slice
  (source "test.veryl" #"
        module Top (clk: input clock, out_q: output logic) {
            function f (x: input logic<4>) -> logic {
                return x[3];
            }
            always_ff (clk) {
                out_q = f('1);
            }
        }
    "#)
  (top Top)
  (tick clk)
  (assert_eq out_q 1))

(case test_ff_function_call_nonvariable_argument_preserves_self_sized_overflow_before_coercion
  ; Legacy ID retained. IEEE 1800-2023 10.8 and 11.8.2 make the formal an
  ; assignment-like context: widen the operands before adding, yielding 4.
  (source "test.veryl" #"
        module Top (clk: input clock, out_q: output logic) {
            function f (x: input logic<4>) -> logic {
                return x[2];
            }
            always_ff (clk) {
                out_q = f(2'b11 + 2'b01);
            }
        }
    "#)
  (top Top)
  (tick clk)
  (assert_eq out_q 1))

(case test_ff_function_call_part_select_of_signed_formal_is_unsigned
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            in_a: input signed logic<8>,
            out_direct: output signed logic<8>,
            out_expr: output signed logic<8>
        ) {
            function f (x: input signed logic<8>) -> signed logic<8> {
                return x[7:0] >>> 1;
            }
            always_ff (clk) {
                out_direct = f(in_a);
                out_expr = f(in_a + 0);
            }
        }
    "#)
  (top Top)
  (modify (set in_a 0xFE))
  (tick clk)
  ; A packed part-select is unsigned even when its base is signed, so >>>
  ; performs a logical shift here.
  (assert_eq out_direct 0x7F)
  (assert_eq out_expr 0x7F))

(case test_ff_function_call_sign_extends_narrow_signed_actual_before_slice
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            out_q: output signed logic<8>
        ) {
            function f (x: input signed logic<8>) -> signed logic<8> {
                return x >>> 4;
            }
            always_ff (clk) {
                out_q = f(4'shf);
            }
        }
    "#)
  (top Top)
  (tick clk)
  (assert_eq out_q 0xFF))

(case test_ff_function_call_preserves_unsigned_actual_when_widening_to_signed_formal
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            out_q: output logic
        ) {
            function f (x: input signed logic<8>) -> logic {
                return x[7];
            }
            always_ff (clk) {
                out_q = f(4'hf);
            }
        }
    "#)
  (top Top)
  (tick clk)
  (assert_eq out_q 0))

(case test_ff_function_call_preserves_unsigned_formal_signedness_for_nonvariable_actual
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            in_a: input signed logic<8>,
            out_q: output logic<8>
        ) {
            function f (x: input logic<8>) -> logic<8> {
                return x[7:0] >>> 1;
            }
            always_ff (clk) {
                out_q = f(in_a + 0);
            }
        }
    "#)
  (top Top)
  (modify (set in_a 0xFE))
  (tick clk)
  (assert_eq out_q 0x7F))

