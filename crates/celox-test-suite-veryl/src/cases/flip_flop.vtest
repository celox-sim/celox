(group flip_flop (category sequential))

(case test_ff_nonblocking
  (source "test.veryl" #"
        module Top (clk: input clock, a: input logic<32>, q: output logic<32>) {
            var r: logic<32>;
            always_ff (clk) {
                r = a;
                q = r;
            }
        }
    "#)
  (top Top)
  (modify (set a 0x11111111))
  (tick clk)
  ; After 1st tick: r = 0x11111111, q = 0x0
  (assert_eq q 0x0)
  (tick clk)
  ; After 2nd tick: q = 0x11111111
  (assert_eq q 0x11111111))

(case test_ff_statement_after_if_reset_keeps_source_order
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            rst: input reset,
            rearm: input logic,
            o_pending: output logic,
            o_filling: output logic
        ) {
            var pending: logic;
            var filling: logic;
            always_ff (clk, rst) {
                if_reset {
                    pending = 1'b0;
                    filling = 1'b0;
                } else {
                    if filling {
                        filling = 1'b0;
                    } else if pending {
                        filling = 1'b1;
                        pending = 1'b0;
                    }
                }
                if rearm {
                    pending = 1'b1;
                }
            }
            assign o_pending = pending;
            assign o_filling = filling;
        }
    "#)
  (top Top)
  (modify
    (set rst 0)
    (set rearm 0))
  (tick clk)
  (modify
    (set rst 1)
    (set rearm 1))
  (tick clk)
  (assert_eq o_pending 1)
  (assert_eq o_filling 0)
  (tick clk)
  (assert_eq o_pending 1)
  (assert_eq o_filling 1))

(case test_ff_static_and_dynamic_writes_share_sparse_state
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            use_static: input logic,
            index: input logic<2>,
            value: input logic<8>,
            q: output logic<8>
        ) {
            var state: logic<8> [4];
            always_ff (clk) {
                if use_static {
                    state[0] = value;
                } else {
                    state[index] = value;
                }
                q = state[0];
            }
        }
    "#)
  (top Top)
  (modify
    (set use_static 1)
    (set value 0x5a))
  (tick clk)
  (assert_eq q 0)
  (modify
    (set use_static 0)
    (set index 1)
    (set value 0xa5))
  (tick clk)
  (assert_eq q 0x5a))

(case test_ff_assert_message_output_argument_is_eager
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (tags eager_assertion_messages)
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            ok: input logic,
            d: input logic<8>,
            effect: output logic<8>
        ) {
            function message_value (
                x: input logic<8>,
                written: output logic<8>
            ) -> logic<8> {
                written = x + 8'd1;
                return x + 8'd2;
            }

            always_ff (clk) {
                $assert_continue(ok, "value=%0d", message_value(d, effect));
            }
        }
    "#)
  (top Top)
  (modify
    (set ok 1)
    (set d 10))
  (tick clk)
  (assert_eq effect 11)
  (modify
    (set ok 0)
    (set d 20))
  (tick clk)
  (assert_eq effect 21))

(case test_ff_runtime_function_snapshots_input_before_callee_nonlocal_write
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            global_value: output logic<8>,
            q: output logic<8>
        ) {
            function update_global (value: input logic<8>) -> logic<8> {
                global_value = 8'd9;
                if value == 8'd1 {
                    return 8'd7;
                } else {
                    return 8'd8;
                }
            }

            always_ff (clk) {
                q = update_global(global_value);
            }
        }
    "#)
  (top Top)
  (modify (set global_value 1))
  (tick clk)
  (assert_eq global_value 9)
  (assert_eq q 7))

(case test_ff_runtime_function_snapshots_helper_input_before_callee_nonlocal_write
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            global_value: output logic<8>,
            q: output logic<8>
        ) {
            function read_global () -> logic<8> {
                return global_value;
            }

            function update_global (value: input logic<8>) -> logic<8> {
                global_value = 8'd9;
                if value == 8'd1 {
                    return 8'd7;
                } else {
                    return 8'd8;
                }
            }

            always_ff (clk) {
                q = update_global(read_global());
            }
        }
    "#)
  (top Top)
  (modify (set global_value 1))
  (tick clk)
  (assert_eq global_value 9)
  (assert_eq q 7))

(case test_ff_statement_function_direct_nonlocal_assignment_is_observable
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            d: input logic<8>,
            global_value: output logic<8>
        ) {
            function set_global (value: input logic<8>) {
                global_value = value;
            }

            always_ff (clk) {
                set_global(d);
            }
        }
    "#)
  (top Top)
  (modify (set d 0x5a))
  (tick clk)
  (assert_eq global_value 0x5a))

(case test_ff_skipped_conditional_nonlocal_write_preserves_prior_ff_assignment
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            gate: input logic,
            global_value: output logic<8>
        ) {
            function maybe_write (gate: input logic) {
                if gate {
                    global_value = 8'h01;
                }
            }

            always_ff (clk) {
                global_value = 8'h05;
                maybe_write(gate);
            }
        }
    "#)
  (top Top)
  (modify (set gate 0))
  (tick clk)
  (assert_eq global_value 5)
  (modify (set gate 1))
  (tick clk)
  (assert_eq global_value 1))

(case test_ff_nonlocal_write_precedes_aliased_formal_output_copyout
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            global_value: output logic<8>,
            q: output logic
        ) {
            function update (written: output logic<8>) -> logic {
                global_value = 8'h01;
                written = 8'h02;
                return 0;
            }

            always_ff (clk) {
                q = update(global_value);
            }
        }
    "#)
  (top Top)
  (tick clk)
  (assert_eq global_value 2))

(case test_ff_outputless_wrapper_nested_copyout_to_nonlocal_is_observable
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (source "test.veryl" #"
        module Top (clk: input clock, global_value: output logic<8>) {
            function set (written: output logic<8>) {
                written = 8'h5a;
            }

            function outer () {
                set(global_value);
            }

            always_ff (clk) {
                outer();
            }
        }
    "#)
  (top Top)
  (tick clk)
  (assert_eq global_value 0x5a))

(case test_ff_outputless_wrapper_expression_copyout_to_nonlocal_is_observable
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (source "test.veryl" #"
        module Top (clk: input clock, global_value: output logic<8>) {
            function set (
                value: input logic<8>,
                written: output logic<8>
            ) -> logic {
                written = value;
                return 1'b0;
            }

            function outer () {
                var ignored: logic;
                ignored = set(8'h5a, global_value);
            }

            always_ff (clk) {
                outer();
            }
        }
    "#)
  (top Top)
  (tick clk)
  (assert_eq global_value 0x5a))

