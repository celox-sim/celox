(case test_ff_function_call_effectful_array_items_are_eager_before_conditional_access
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            guard: input logic,
            out_q: output logic<8>,
            side0: output logic<8>,
            side1: output logic<8>
        ) {
            function observe (
                x: input logic<8>,
                side: output logic<8>
            ) -> logic<8> {
                side = x;
                return x;
            }
            function static_then_dynamic (
                x: input logic<8>[2],
                index: input logic,
                guard: input logic,
                first: output logic<8>
            ) -> logic<8> {
                first = x[0];
                return if guard ? x[index] : 8'h00;
            }
            var first: logic<8>;
            always_ff (clk) {
                side0 = 0;
                side1 = 0;
                out_q = static_then_dynamic(
                    '{observe(8'h11, side0), observe(8'h22, side1)},
                    1,
                    guard,
                    first
                );
            }
        }
    "#)
  (top Top)
  (modify (set guard 0))
  (tick clk)
  (assert_eq out_q 0)
  (assert_eq side0 0x11)
  (assert_eq side1 0x22)
  (modify (set guard 1))
  (tick clk)
  (assert_eq out_q 0x22)
  (assert_eq side0 0x11)
  (assert_eq side1 0x22))

