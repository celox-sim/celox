(case test_ff_function_call_array_literal_effect_is_eager_in_ternary_arm
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            guard: input logic,
            in0: input logic<8>,
            out_q: output logic<8>,
            side: output logic<8>
        ) {
            function observe (
                x: input logic<8>,
                side: output logic<8>
            ) -> logic<8> {
                side = x;
                return x;
            }
            function pick_if (
                x: input logic<8>[2],
                index: input logic,
                guard: input logic
            ) -> logic<8> {
                return if guard ? x[index] : 8'h00;
            }
            always_ff (clk) {
                out_q = pick_if(
                    '{observe(in0, side), default: 8'h00},
                    0,
                    guard
                );
            }
        }
    "#)
  (top Top)
  (modify
    (set guard 0)
    (set in0 0x5a))
  (tick clk)
  (assert_eq out_q 0)
  (assert_eq side 0x5a)
  (modify (set guard 1))
  (tick clk)
  (assert_eq out_q 0x5a)
  (assert_eq side 0x5a))

(case test_ff_function_call_array_literal_effect_is_eager_in_short_circuit_rhs
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            guard: input logic,
            in0: input logic<8>,
            out_and: output logic,
            out_or: output logic,
            and_side: output logic<8>,
            or_side: output logic<8>
        ) {
            function observe (
                x: input logic<8>,
                side: output logic<8>
            ) -> logic<8> {
                side = x;
                return x;
            }
            function pick_and (
                x: input logic<8>[2],
                index: input logic,
                guard: input logic
            ) -> logic {
                return guard && x[index] != 0;
            }
            function pick_or (
                x: input logic<8>[2],
                index: input logic,
                guard: input logic
            ) -> logic {
                return guard || x[index] != 0;
            }
            always_ff (clk) {
                and_side = 0;
                or_side = 0;
                out_and = pick_and(
                    '{observe(in0, and_side), default: 8'h00},
                    0,
                    guard
                );
                out_or = pick_or(
                    '{observe(in0, or_side), default: 8'h00},
                    0,
                    guard
                );
            }
        }
    "#)
  (top Top)
  (modify
    (set guard 0)
    (set in0 0x5a))
  (tick clk)
  (assert_eq out_and 0)
  (assert_eq and_side 0x5a)
  (assert_eq out_or 1)
  (assert_eq or_side 0x5a)
  (modify (set guard 1))
  (tick clk)
  (assert_eq out_and 1)
  (assert_eq and_side 0x5a)
  (assert_eq out_or 1)
  (assert_eq or_side 0x5a))

(case test_ff_function_call_array_literal_view_preserves_expression_order
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
