(case test_ff_function_call_merges_directly_forwarded_array_cache
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (tags evaluation_order)
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            guard: input logic,
            out_q: output logic<8>,
            side: output logic<8>
        ) {
            function observe (
                x: input logic<8>,
                side: output logic<8>
            ) -> logic<8> {
                side = x;
                return x;
            }
            function inner (
                x: input logic<8>[2],
                guard: input logic
            ) -> logic<8> {
                return if guard ? x[0] : 8'h00;
            }
            function outer (
                y: input logic<8>[2],
                guard: input logic,
                middle: input logic<8>
            ) -> logic<8> {
                return inner(y, guard) + middle + y[0];
            }
            always_ff (clk) {
                out_q = outer(
                    '{observe(8'h11, side), default: 8'h00},
                    guard,
                    observe(8'h55, side)
                );
            }
        }
    "#)
  (top Top)
  (modify (set guard 0))
  (tick clk)
  (assert_eq out_q 0x66)
  (assert_eq side 0x55)
  (modify (set guard 1))
  (tick clk)
  (assert_eq out_q 0x77)
  ; Both arguments are eager effects, so declaration order makes the
  ; later scalar actual supply the final write.
  (assert_eq side 0x55))

(case test_ff_function_call_tracks_array_reads_in_output_indices
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            guard: input logic,
            out_q: output logic<8>,
            side: output logic<8>
        ) {
            var scratch: logic<8>[2];
            function observe (
                x: input logic<8>,
                side: output logic<8>
            ) -> logic<8> {
                side = x;
                return x;
            }
            function write (
                value: input logic<8>,
                dst: output logic<8>
            ) -> logic<8> {
                dst = value;
                return 0;
            }
            function outer (
                x: input logic<8>[2],
                guard: input logic,
                middle: input logic<8>
            ) -> logic<8> {
                return (if guard ? write(0, scratch[x[0]]) : 0) + middle + x[0];
            }
            always_ff (clk) {
                out_q = outer(
                    '{observe(8'h01, side), default: 8'h00},
                    guard,
                    observe(8'h55, side)
                );
            }
        }
    "#)
  (top Top)
  (modify (set guard 0))
  (tick clk)
  (assert_eq out_q 0x56)
  (assert_eq side 0x55)
  (modify (set guard 1))
  (tick clk)
  (assert_eq out_q 0x56)
  (assert_eq side 0x55))

(case test_ff_function_call_tracks_nested_array_reads_in_output_indices
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            guard: input logic,
            out_q: output logic<8>,
            side: output logic<8>
        ) {
            var scratch: logic<8>[2];
            function observe (
                x: input logic<8>,
                side: output logic<8>
            ) -> logic<8> {
                side = x;
                return x;
            }
            function write (
                value: input logic<8>,
                dst: output logic<8>
            ) -> logic<8> {
                dst = value;
                return 0;
            }
            function helper (x: input logic<8>[2]) -> logic<8> {
                return write(0, scratch[x[0]]);
            }
            function outer (
                x: input logic<8>[2],
                guard: input logic,
                middle: input logic<8>
            ) -> logic<8> {
                return (if guard ? helper(x) : 0) + middle + x[0];
            }
            always_ff (clk) {
                out_q = outer(
                    '{observe(8'h01, side), default: 8'h00},
                    guard,
                    observe(8'h55, side)
                );
            }
        }
    "#)
  (top Top)
  (modify (set guard 0))
  (tick clk)
  (assert_eq out_q 0x56)
  (assert_eq side 0x55)
  (modify (set guard 1))
  (tick clk)
  (assert_eq out_q 0x56)
  (assert_eq side 0x55))

(case test_ff_function_call_restores_initialized_forwarded_alias_view
  ; https://github.com/veryl-lang/veryl/pull/3131
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            select: input logic,
            out_q: output logic<8>
        ) {
            function alias_use (
                a: input logic<8>[2],
                b: input logic<8>[2],
                index: input logic,
                select: input logic,
                clobber: input logic<8>
            ) -> logic<8> {
                return (if select ? a[index] : b[index])
                    + clobber
                    + (if select ? a[0] : b[0]);
            }
            function forward (
                x: input logic<8>[2],
                index: input logic,
                select: input logic,
                clobber: input logic<8>
            ) -> logic<8> {
                return alias_use(x, x, index, select, clobber);
            }
            always_ff (clk) {
                out_q = forward(
                    '{8'h11, 8'h22},
                    1,
                    select,
                    forward('{8'haa, 8'hbb}, 1, 0, 0)
                );
            }
        }
    "#)
  (top Top)
  (for select_value (list 0 1)
    (modify (set select select_value))
    (tick clk)
    (assert_eq out_q 0x98)))

(case test_ff_function_call_merges_outer_array_view_across_nested_short_circuit
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            guard: input logic,
            in0: input logic<8>,
            out_q: output logic<8>,
            side: output logic<8>
        ) {
            function observe (
                x: input logic<8>,
                side: output logic<8>
            ) -> logic<8> {
                side = x;
                return x;
            }
            function inner (y: input logic[2], index: input logic) -> logic {
                return y[index];
            }
            function outer (
                x: input logic<8>[2],
                index: input logic,
                guard: input logic
            ) -> logic<8> {
                return inner('{guard && x[index] != 0, default: 0}, 0) + x[0];
            }
            always_ff (clk) {
                side = 0;
                out_q = outer(
                    '{observe(in0, side), default: 8'h00},
                    0,
                    guard
                );
            }
        }
    "#)
  (top Top)
  (modify
    (set guard 0)
    (set in0 0x5a))
  (tick clk)
  (assert_eq out_q 0x5a)
  (assert_eq side 0x5a)
  (modify (set guard 1))
  (tick clk)
  (assert_eq out_q 0x5b)
  (assert_eq side 0x5a))

(case test_ff_function_call_forwards_array_literal_view_to_nested_call
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            index: input logic,
            out_q: output logic<8>
        ) {
            function inner (x: input logic<8>[2], index: input logic) -> logic<8> {
                return x[index];
            }
            function middle (x: input logic<8>[2], index: input logic) -> logic<8> {
                return inner(x, index);
            }
            function outer (x: input logic<8>[2], index: input logic) -> logic<8> {
                return middle(x, index);
            }
            always_ff (clk) {
                out_q = outer('{8'h11, 8'h22}, index);
            }
        }
    "#)
  (top Top)
  (modify (set index 0))
  (tick clk)
  (assert_eq out_q 0x11)
  (modify (set index 1))
  (tick clk)
  (assert_eq out_q 0x22))

(case test_ff_function_call_keeps_array_view_active_for_output_index
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            out_q: output logic<8>
        ) {
            function pick (
                x: input logic<8>[2],
                index: input logic,
                selected: output logic<8>
            ) -> logic<8> {
                selected = x[index];
                return x[0];
            }
            var selected: logic<8>[2];
            var inner_selected: logic<8>;
            always_ff (clk) {
                out_q = pick(
                    '{8'h11, 8'h22},
                    1,
                    selected[pick('{8'h01, 8'h00}, 0, inner_selected)]
                );
            }
        }
    "#)
  (top Top)
  (tick clk)
  (assert_eq out_q 0x11))

(case test_ff_function_call_restores_array_literal_view_after_reentrant_call
  ; https://github.com/veryl-lang/veryl/pull/3131
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            out_q: output logic<8>
        ) {
            function pick (x: input logic<8>[2], index: input logic) -> logic<8> {
                return x[index];
            }
            always_ff (clk) {
                out_q = pick('{8'h11, 8'h22}, pick('{8'h00, 8'h01}, 0));
            }
        }
    "#)
  (top Top)
  (tick clk)
  (assert_eq out_q 0x11))

(case test_ff_function_call_restores_nearest_array_view_after_deep_reentrant_call
  ; https://github.com/veryl-lang/veryl/pull/3131
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            out_q: output logic<8>
        ) {
            function pick (x: input logic<8>[2], index: input logic) -> logic<8> {
                return x[index];
            }
            always_ff (clk) {
                out_q = pick(
                    '{8'h11, 8'h22},
                    pick(
                        '{8'h00, 8'h00},
                        pick('{8'h00, 8'h00}, 0)
                    )
                );
            }
        }
    "#)
  (top Top)
  (tick clk)
  (assert_eq out_q 0x11))

(case test_ff_function_call_bits_and_size_evaluate_effectful_array_argument
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            in0: input logic<8>,
            out_bits: output logic<32>,
            out_size: output logic<32>,
            bits_side: output logic<8>,
            size_side: output logic<8>
        ) {
            function observe (
                x: input logic<8>,
                side: output logic<8>
            ) -> logic<8> {
                side = x;
                return x;
            }
            function array_bits (x: input logic<8>[2]) -> logic<32> {
                return $bits(x);
            }
            function array_size (x: input logic<8>[2]) -> logic<32> {
                return $size(x);
            }
            always_ff (clk) {
                out_bits = array_bits('{observe(in0, bits_side), default: 0});
                out_size = array_size('{observe(in0, size_side), default: 0});
            }
        }
    "#)
  (top Top)
  (modify (set in0 0x5a))
  (tick clk)
  (assert_eq out_bits 16)
  (assert_eq out_size 2)
  (assert_eq bits_side 0x5a)
  (assert_eq size_side 0x5a))

(case test_ff_function_call_nested_bits_evaluates_effectful_array_argument
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            in0: input logic<8>,
            out_q: output logic<32>,
            side: output logic<8>
        ) {
            function observe (
                x: input logic<8>,
                side: output logic<8>
            ) -> logic<8> {
                side = x;
                return x;
            }
            function inner (x: input logic<8>[2]) -> logic<32> {
                return $bits(x);
            }
            function outer (x: input logic<8>[2]) -> logic<32> {
                return inner(x);
            }
            always_ff (clk) {
                out_q = outer('{observe(in0, side), default: 8'h00});
            }
        }
    "#)
  (top Top)
  (modify (set in0 0x5a))
  (tick clk)
  (assert_eq out_q 16)
  (assert_eq side 0x5a))

(case test_ff_function_call_array_literal_view_preserves_source_order
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (tags assignment_pattern_evaluation)
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            index: input logic,
            out_q: output logic<8>,
            side: output logic<8>
        ) {
            function observe (
                x: input logic<8>,
                side: output logic<8>
            ) -> logic<8> {
                side = x;
                return x;
            }
            function pick (x: input logic<8>[2], index: input logic) -> logic<8> {
                return x[index];
            }
            always_ff (clk) {
                out_q = pick(
                    '{default: observe(8'h11, side), observe(8'h22, side)},
                    index
                );
            }
        }
    "#)
  (top Top)
  (modify (set index 0))
  (tick clk)
  (assert_eq side 0x22))

(case test_ff_function_call_snapshots_pure_array_items_before_later_effect
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (tags assignment_pattern_evaluation deferred_function_effects)
  (source "test.veryl" #"
        module Top (clk: input clock, q: output logic<8>, changing: output logic<8>) {
            function update (
                value: input logic<8>,
                written: output logic<8>
            ) -> logic<8> {
                written = value + 1;
                return 0;
            }
            function pick (x: input logic<8>[2]) -> logic<8> {
                return x[0];
            }
            always_ff (clk) {
                q = pick('{changing, update(changing, changing)});
            }
        }
    "#)
  (top Top)
  (tick clk)
  (tick clk)
  (assert_eq q 1)
  (assert_eq changing 2))

(case test_ff_function_call_converts_array_literal_view_for_wider_nested_formal
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            index: input logic,
            out_q: output logic<8>
        ) {
            function inner (x: input logic<8>[2], index: input logic) -> logic<8> {
                return x[index];
            }
            function outer (x: input logic<4>[2], index: input logic) -> logic<8> {
                return inner(x, index);
            }
            always_ff (clk) {
                out_q = outer('{4'ha, 4'h3}, index);
            }
        }
    "#)
  (top Top)
  (modify (set index 0))
  (tick clk)
  (assert_eq out_q 0x0a)
  (modify (set index 1))
  (tick clk)
  (assert_eq out_q 0x03))

(case test_ff_function_call_converts_forwarded_static_array_element
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            out_q: output logic<8>
        ) {
            function inner (x: input logic<8>[2]) -> logic<8> {
                return x[0];
            }
            function outer (x: input logic<4>[2]) -> logic<8> {
                return inner(x);
            }
            always_ff (clk) {
                out_q = outer('{4'ha, 4'h3});
            }
        }
    "#)
  (top Top)
  (tick clk)
  (assert_eq out_q 0x0a))

(case test_ff_function_call_array_literal_element_uses_element_width
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            out_q: output signed logic<4>
        ) {
            function f (x: input signed logic<4>[2]) -> signed logic<4> {
                return x[1] >>> 3;
            }
            always_ff (clk) {
                out_q = f('{4'sh1, 4'sh8});
            }
        }
    "#)
  (top Top)
  (tick clk)
  (assert_eq out_q 0xF))

(case test_ff_function_array_element_assignment_preserves_signedness
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            out_q: output signed logic<8>
        ) {
            function f () -> signed logic<8> {
                var values: signed logic<8>[2];
                values[0] = 4'sh8;
                return values[0] >>> 3;
            }
            always_ff (clk) {
                out_q = f();
            }
        }
    "#)
  (top Top)
  (tick clk)
  (assert_eq out_q 0xff))

