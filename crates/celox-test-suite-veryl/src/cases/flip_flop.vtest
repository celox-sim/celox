  (source "test.veryl" #"
        module Top (
            clk: input clock,
            out_q: output logic<8>,
            side: output logic<8>
        ) {
            function observe (
                x: input logic<8>,
                side: output logic<8>
            ) -> logic<8> {
                side = x;
                return x;
            }
            function ordered (
                x: input logic<8>[2],
                index: input logic,
                left: input logic<8>
            ) -> logic<8> {
                return left + x[index];
            }
            always_ff (clk) {
                out_q = ordered(
                    '{observe(8'h22, side), default: 8'h00},
                    0,
                    observe(8'h11, side)
                );
            }
        }
    "#)
