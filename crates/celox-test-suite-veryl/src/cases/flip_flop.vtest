                x: input logic<8>,
                side: output logic<8>
            ) -> logic<8> {
                side = x;
                return x;
            }
            function middle (
                x: input logic<8>[2],
                index: input logic,
                guard: input logic
            ) -> logic<8> {
                return if guard ? x[index] : 8'h00;
            }
            function outer (
                y: input logic<8>[2],
                index: input logic,
