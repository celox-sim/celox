(case test_ff_outputless_wrapper_dynamic_indexed_copyout_to_nonlocal_is_observable
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            index: input logic,
            global_value: output logic<8>
        ) {
            function set (
                value: input logic,
                written: output logic
            ) -> logic {
                written = value;
                return 1'b0;
            }

            function outer (index: input logic) {
                var ignored: logic;
                ignored = set(1'b1, global_value[index]);
            }

            always_ff (clk) {
                outer(index);
            }
        }
    "#)
  (top Top)
  (modify (set index 1))
  (tick clk)
  (assert_eq global_value 2))

(case test_ff_outputless_wrapper_direct_dynamic_nonlocal_assignment_is_observable
  ; Celox opt-in FF function effects are rejected by the Veryl analyzer.
  (source "test.veryl" #"
        module Top (
            clk: input clock,
            index: input logic<3>,
            value: input logic,
            global_value: output logic<8>
        ) {
            function write_at (
                index: input logic<3>,
                value: input logic
            ) -> logic {
                global_value[index] = value;
                return 1'b0;
            }

            function outer (
                index: input logic<3>,
                value: input logic
            ) {
                var ignored: logic;
                ignored = write_at(index, value);
            }

            always_ff (clk) {
                outer(index, value);
            }
        }
    "#)
  (top Top)
  (modify
    (set index 2)
    (set value 1))
  (tick clk)
  (assert_eq global_value 4))

(case test_ff_dynamic_nonlocal_store_follows_pending_whole_write
