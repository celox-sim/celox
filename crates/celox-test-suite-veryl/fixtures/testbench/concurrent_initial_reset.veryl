module Counter (
    clk: input clock,
    rst: input reset,
    count: output logic<8>,
) {
    always_ff {
        if_reset { count = 0; }
        else { count += 1; }
    }
}
#[test(Top)]
module Top {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen(clk);
    var count: logic<8>;
    inst dut: Counter (clk, rst, count);
    initial {
        clk.next(4);
        $assert(count == 8'd2);
        $finish();
    }
    initial { rst.assert(2); }
}
