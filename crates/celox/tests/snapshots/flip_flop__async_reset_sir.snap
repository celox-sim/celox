=== Evaluation Flip-Flops (eval_apply_ffs) ===
Trigger Group: clk (AbsoluteAddr(inst0, var0))
  Execution Unit 0:
    Entry Block: 0
    Registers:
      r0: logic<1>
      r1: bit<1>
      r2: bit<32>
      r3: bit<8>
      r4: signed bit<8>
      r5: logic<8>
    b0:
      Jump(b1)
    b1:
      r0 = Load(addr=rst (region=0), offset=0, bits=1)
      r1 = ToTwoState r0
      Branch(r1 ? b2 : b3)
    b2:
      r2 = SIRValue(0x0)
      r3 = SIRValue(0xff)
      r4 = r2 And r3
      Store(addr=q (region=1), offset=0, bits=8, src_reg = 4)
      Jump(b4)
    b3:
      r5 = Load(addr=d (region=0), offset=0, bits=8)
      Store(addr=q (region=1), offset=0, bits=8, src_reg = 5)
      Jump(b4)
    b4:
      Jump(b5)
    b5:
      Commit(src=q (region=1), dst=q (region=0), offset=0, bits=8)
      Return
Trigger Group: rst (AbsoluteAddr(inst0, var1))
  Execution Unit 0:
    Entry Block: 0
    Registers:
      r0: logic<1>
      r1: bit<1>
      r2: bit<32>
      r3: bit<8>
      r4: signed bit<8>
      r5: logic<8>
    b0:
      Jump(b1)
    b1:
      r0 = Load(addr=rst (region=0), offset=0, bits=1)
      r1 = ToTwoState r0
      Branch(r1 ? b2 : b3)
    b2:
      r2 = SIRValue(0x0)
      r3 = SIRValue(0xff)
      r4 = r2 And r3
      Store(addr=q (region=1), offset=0, bits=8, src_reg = 4)
      Jump(b4)
    b3:
      r5 = Load(addr=d (region=0), offset=0, bits=8)
      Store(addr=q (region=1), offset=0, bits=8, src_reg = 5)
      Jump(b4)
    b4:
      Jump(b5)
    b5:
      Commit(src=q (region=1), dst=q (region=0), offset=0, bits=8)
      Return

