module Counter (
    clk: input clock,
    rst: input reset,
    count: output logic<8>,
) {
    always_ff {
        if_reset { count = 0; }
        else { count += 1; }
    }
}
#[test(Top)]
module Top {
    inst slow: $tb::clock_gen #(period: 10);
    inst fast: $tb::clock_gen #(period: 2);
    inst rst: $tb::reset_gen (clk: slow);
    var count: logic<8>;
    inst dut: Counter (clk: slow, rst, count);
    initial { slow.next(4); }
    initial {
        rst.assert(1);
        fast.next(1);
        // At time 12, the time-10 edge has incremented the register.
        $assert(count == 8'd1, "before reassert: count=%d", count);
        rst.assert(1);
    }
    initial {
        fast.next(7);
        // At time 14, reset must have acted without the time-20 clock edge.
        $assert(count == 8'd0, "between edges: count=%d", count);
        $finish();
    }
}
