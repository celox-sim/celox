{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "internalChecksFilter": "strict",
  "cloneSubmodules": true,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^rust-toolchain\\.toml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^ ]+) depName=(?<depName>[^ ]+) versioning=(?<versioning>[^\\s]+)\\s+channel = \"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Cargo\\.toml$/"
      ],
      "matchStrings": [
        "rust-version = \"(?<currentValue>[^\"]+)\"\\n"
      ],
      "depNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "nix"
      ],
      "matchDepNames": [
        "!rust-overlay"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "python"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "num-bigint"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "syn",
        "prettyplease"
      ],
      "groupName": "syn ecosystem",
      "separateMajorMinor": false
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "/^veryl-/"
      ],
      "groupName": "veryl crates"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "cranelift",
        "cranelift-frontend",
        "cranelift-jit",
        "cranelift-module",
        "cranelift-native"
      ],
      "groupName": "cranelift crates"
    },
    {
      "matchManagers": [
        "cargo",
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "minimumReleaseAge": "3 days",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "labels": [
        "dependencies"
      ]
    },
    {
      "matchManagers": [
        "npm"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true,
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "minimumReleaseAge": "3 days",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "labels": [
        "dependencies"
      ]
    },
    {
      "matchManagers": [
        "custom.regex",
        "nix"
      ],
      "matchPackageNames": [
        "rust-lang/rust",
        "https://github.com/oxalica/rust-overlay"
      ],
      "groupName": "rust stable toolchain",
      "commitMessageTopic": "Rust toolchain",
      "rangeStrategy": "replace",
      "minimumReleaseAge": "3 days",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "labels": [
        "dependencies",
        "rust"
      ],
      "separateMajorMinor": false,
      "separateMinorPatch": false
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "/^veryl-/"
      ],
      "semanticCommitType": "fix",
      "semanticCommitScope": "veryl",
      "minimumReleaseAge": "3 days",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "matchManagers": [
        "cargo",
        "npm"
      ],
      "matchPackageNames": [
        "napi",
        "napi-build",
        "napi-derive",
        "@napi-rs/cli",
        "@napi-rs/wasm-runtime",
        "emnapi",
        "@emnapi/core",
        "@emnapi/runtime"
      ],
      "groupName": "napi-rs and emnapi compatibility",
      "groupSlug": "napi-rs-emnapi-compatibility",
      "separateMajorMinor": false,
      "rangeStrategy": "pin",
      "automerge": false,
      "labels": [
        "dependencies"
      ]
    },
    {
      "matchManagers": [
        "nix"
      ],
      "matchDepNames": [
        "rust-overlay"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "The Veryl conformance analyzer probe matches the Veryl metadata vendored at the pinned upstream revision in lydite/conformance/veryl/run_ci.sh; update it together with that revision.",
      "matchFileNames": [
        "lydite/conformance/veryl/analyzer-probe/Cargo.toml"
      ],
      "enabled": false
    }
  ],
  "nix": {
    "enabled": true
  }
}
